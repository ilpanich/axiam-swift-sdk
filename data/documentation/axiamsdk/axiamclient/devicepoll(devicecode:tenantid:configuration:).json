":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","text":"OidcConfiguration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK12OidcTokenSetV","kind":"typeIdentifier","text":"OidcTokenSet","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet"}],"platforms":["Linux"]}]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Returns the token set when the user has approved. The five RFC 8628 §3.5 answers all"},{"type":"text","text":" "},{"type":"text","text":"arrive as "},{"code":"400","type":"codeVoice"},{"type":"text","text":" with an "},{"code":"OAuth2ErrorResponse","type":"codeVoice"},{"type":"text","text":", and §14.2 rule 5 requires dispatching on"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"error","type":"codeVoice"},{"type":"text","text":" field rather than the status: this throws an "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","isActive":true},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError\/oauthError","isActive":true},{"type":"text","text":" carries that field, so a caller driving its own loop can tell"},{"type":"text","text":" "},{"code":"authorization_pending","type":"codeVoice"},{"type":"text","text":" and "},{"code":"slow_down","type":"codeVoice"},{"type":"text","text":" (keep going) from "},{"code":"access_denied","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"expired_token","type":"codeVoice"},{"type":"text","text":" and "},{"code":"invalid_grant","type":"codeVoice"},{"type":"text","text":" (stop). The sixth, "},{"code":"401","type":"codeVoice"},{"type":"text","text":" "},{"code":"invalid_client","type":"codeVoice"},{"type":"text","text":" (contract"},{"type":"text","text":" "},{"type":"text","text":"1.62), is dispatched the same way and is terminal: a failed client authentication is not"},{"type":"text","text":" "},{"type":"text","text":"an expired session, so it is not retried and does not enter the §9 refresh guard."},{"type":"text","text":" "},{"type":"text","text":"A "},{"code":"5xx","type":"codeVoice"},{"type":"text","text":" is a transport failure whatever its body (§14.2 rule 6, contract 1.64 amended): it"},{"type":"text","text":" "},{"type":"text","text":"is first retried under §16 inside this call (a "},{"code":"429","type":"codeVoice"},{"type":"text","text":" never is), then throws the §2"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive":true},{"type":"text","text":", and the loop keeps polling. A "},{"code":"429","type":"codeVoice"},{"type":"text","text":" is rule 9’s wait"},{"type":"text","text":" "},{"type":"text","text":"whatever its body names; this call throws it as "},{"code":"rate_limit_exceeded","type":"codeVoice"},{"type":"text","text":" when the body is an"},{"type":"text","text":" "},{"type":"text","text":"OAuth error, and as the §2 "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive"