{"kind":"symbol","abstract":[{"text":"One ","type":"text"},{"code":"POST \/oauth2\/token","type":"codeVoice"},{"text":" with the device-code grant (§14.1) — a single poll.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"devicePoll"},{"kind":"text","text":"("},{"kind":"externalParam","text":"deviceCode"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","text":"Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","text":"OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK12OidcTokenSetV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet","text":"OidcTokenSet"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns the token set when the user has approved. The five RFC 8628 §3.5 answers all"},{"type":"text","text":" "},{"type":"text","text":"arrive as "},{"type":"codeVoice","code":"400"},{"type":"text","text":" with an "},{"type":"codeVoice","code":"OAuth2ErrorResponse"},{"type":"text","text":", and §14.2 rule 5 requires dispatching on"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"error"},{"type":"text","text":" field rather than the status: this throws an "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","isActive":true},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError\/oauthError","isActive":true},{"type":"text","text":" carries that field, so a caller driving its own loop can tell"},{"type":"text","text":" "},{"type":"codeVoice","code":"authorization_pending"},{"type":"text","text":" and "},{"type":"codeVoice","code":"slow_down"},{"type":"text","text":" (keep going) from "},{"type":"codeVoice","code":"access_denied"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"expired_token"},{"type":"text","text":" and "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":" (stop). The sixth, "},{"type":"codeVoice","code":"401"},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_client"},{"type":"text","text":" (contract"},{"type":"text","text":" "},{"type":"text","text":"1.62), is dispatched the same way and is terminal: a failed client authentication is not"},{"type":"text","text":" "},{"type":"text","text":"an expired session, so it is not retried and does not enter the §9 refresh guard."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"codeVoice","code":"5xx"},{"type":"text","text":" is a transport failure whatever its body (§14.2 rule 6, contract 1.64 amended): it"},{"type":"text","text":" "},{"type":"text","text":"is first retried under §16 inside this call (a "},{"type":"codeVoice","code":"429"},{"type":"text","text":" never is), then throws the §2"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive":true},{"type":"text","text":", and the loop keeps polling. A "},{"type":"codeVoice","code":"429"},{"type":"text","text":" is rule 9’s wait"},{"type":"text","text":" "},{"type":"text","text":"whatever its body names; this call throws it as "},{"type":"codeVoice","code":"rate_limit_exceeded"},{"type":"text","text":" when the body is an"},{"type":"text","text":" "},{"type":"text","text":"OAuth error, and as the §2 "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive":true},{"type":"text","text":" when it is not."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Client authentication (§14.1 rules 2 and 3)."}],"type":"strong"},{"text":" Every poll sends ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":". A client","type":"text"},{"text":" ","type":"text"},{"text":"configured with ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/oidcClientSecret","type":"reference","isActive":true},{"text":" also sends it as ","type":"text"},{"code":"client_secret","type":"codeVoice"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"text":"form body — never as ","type":"text"},{"code":"Authorization: Basic","type":"codeVoice"},{"text":", whatever the client is registered for — and a","type":"text"},{"text":" ","type":"text"},{"text":"client with a §6.1 certificate presents it on the connection; a public client sends","type":"text"},{"text":" ","type":"text"},{"text":"neither. This SDK verifies DPoP proofs but does not generate them (§21.9), so a client","type":"text"},{"text":" ","type":"text"},{"text":"registered for DPoP cannot be driven from here: its poll is refused ","type":"text"},{"code":"401 invalid_client","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and surfaces as above. A response whose ","type":"text"},{"code":"token_type","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"DPoP","type":"codeVoice"},{"text":" is surfaced as the server","type":"text"},{"text":" ","type":"text"},{"text":"said it (","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/tokenType","type":"reference","isActive":true},{"text":"), never assumed to be ","type":"text"},{"code":"Bearer","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/deviceLogin(scope:tenantID:configuration:onAuthorization:)","type":"reference","isActive":true},{"text":" is the loop most callers","type":"text"},{"text":" ","type":"text"},{"text":"want; this exists for one that needs its own.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/devicepoll(devicecode:tenantid:configuration:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"devicePoll(deviceCode:tenantID:configuration:)","extendedModule":"AxiamSDK","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"devicePoll","kind":"identifier"},{"text":"(","kind":"text"},{"text":"deviceCode","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"OidcTokenSet","preciseIdentifier":"s:8