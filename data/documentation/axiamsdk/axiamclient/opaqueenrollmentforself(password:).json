{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"abstract":[{"text":"Builds a registration record for the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"caller’s own"}]},{"text":" new password, sealed against the","type":"text"},{"text":" ","type":"text"},{"text":"tenant the caller’s account lives in.","type":"text"}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"opaqueEnrollmentForSelf"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"OpaqueEnrollment","preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"CONTRACT.md §5.2.2 rule 2. "},{"type":"codeVoice","code":"POST \/auth\/password\/change"},{"type":"text","text":" and the record that accompanies"},{"type":"text","text":" "},{"type":"text","text":"it are about the "},{"inlineContent":[{"type":"text","text":"account"}],"type":"emphasis"},{"type":"text","text":", not about whatever tenant the client is currently pointed"},{"type":"text","text":" "},{"type":"text","text":"at, and a record sealed against the acting tenant is refused with "},{"inlineContent":[{"text":"“the OPAQUE session","type":"text"},{"text":" ","type":"text"},{"text":"was issued for a different tenant”","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The distinction only bites for an organization-level principal that has selected another"},{"type":"text","text":" "},{"type":"text","text":"tenant to act on; for everyone else the two tenants are the same value and this behaves"},{"type":"text","text":" "},{"type":"text","text":"identically to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)"},{"type":"text","text":". It is still the method to call for a"},{"type":"text","text":" "},{"type":"text","text":"self-service password change, because which principal is signed in is not something the"},{"type":"text","text":" "},{"type":"text","text":"call site usually knows."}],"type":"paragraph"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","isActive":true,"type":"reference"},{"type":"text","text":" when no login has completed on this client yet —"},{"type":"text","text":" "},{"type":"text","text":"the principal tenant is reported by the login response, so there is nothing to seal"},{"type":"text","text":" "},{"type":"text","text":"against before then — and on the same terms as "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"otherwise."}]}],"type":"aside","style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/opaqueenrollmentforself(password:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollmentForSelf","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"}