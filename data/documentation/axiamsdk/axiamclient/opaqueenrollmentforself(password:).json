{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollmentForSelf","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment","kind":"typeIdentifier","text":"OpaqueEnrollment"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"CONTRACT.md §5.2.2 rule 2. "},{"type":"codeVoice","code":"POST \/auth\/password\/change"},{"type":"text","text":" and the record that accompanies"},{"type":"text","text":" "},{"type":"text","text":"it are about the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"account"}]},{"type":"text","text":", not about whatever tenant the client is currently pointed"},{"type":"text","text":" "},{"type":"text","text":"at, and a record sealed against the acting tenant is refused with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“the OPAQUE session"},{"type":"text","text":" "},{"type":"text","text":"was issued for a different tenant”"}]},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The distinction only bites for an organization-level principal that has selected another"},{"type":"text","text":" "},{"type":"text","text":"tenant to act on; for everyone else the two tenants are the same value and this behaves"},{"type":"text","text":" "},{"type":"text","text":"identically to "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)","isActive":true},{"type":"text","text":". It is still the method to call for a"},{"type":"text","text":" "},{"type":"text","text":"self-service password change, because which principal is signed in is not something the"},{"type":"text","text":" "},{"type":"text","text":"call site usually knows."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},{"type":"text","text":" when no login has completed on this client yet —"},{"type":"text","text":" "},{"type":"text","text":"the principal tenant is reported by the login response, so there is nothing to seal"},{"type":"text","text":" "},{"type":"text","text":"against before then — and on the same terms as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)"},{"type":"text","text":" "},{"type":"text","text":"otherwise."}],"type":"paragraph"}],"name":"Throws","type":"aside"}],"kind":"content"}],"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollmentForSelf(password:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Builds a registration record for the "},{"type":"strong","inlineContent":[{"type":"text","text":"caller’s own"}]},{"type":"text","text":" new password, sealed against the"},{"type":"text","text":" "},{"type":"text","text":"tenant the caller’s account lives in."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/opaqueenrollmentforself(password:)"]}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "