{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"abstract":[{"type":"text","text":"Builds a registration record for the "},{"inlineContent":[{"type":"text","text":"caller’s own"}],"type":"strong"},{"type":"text","text":" new password, sealed against the"},{"type":"text","text":" "},{"type":"text","text":"tenant the caller’s account lives in."}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/opaqueenrollmentforself(password:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollmentForSelf(password:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"opaqueEnrollmentForSelf"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"OpaqueEnrollment","preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"CONTRACT.md §5.2.2 rule 2. ","type":"text"},{"code":"POST \/auth\/password\/change","type":"codeVoice"},{"text":" and the record that accompanies","type":"text"},{"text":" ","type":"text"},{"text":"it are about the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"account"}]},{"text":", not about whatever tenant the client is currently pointed","type":"text"},{"text":" ","type":"text"},{"text":"at, and a record sealed against the acting tenant is refused with ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"“the OPAQUE session"},{"type":"text","text":" "},{"type":"text","text":"was issued for a different tenant”"}]},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The distinction only bites for an organization-level principal that has selected another","type":"text"},{"text":" ","type":"text"},{"text":"tenant to act on; for everyone else the two tenants are the same value and this behaves","type":"text"},{"text":" ","type":"text"},{"text":"identically to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)"},{"text":". It is still the method to call for a","type":"text"},{"text":" ","type":"text"},{"text":"self-service password change, because which principal is signed in is not something the","type":"text"},{"text":" ","type":"text"},{"text":"call site usually knows.","type":"text"}]},{"type":"aside","name":"Throws","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},{"type":"text","text":" when no login has completed on this client yet —"},{"type":"text","text":" "},{"type":"text","text":"the principal tenant is reported by the login response, so there is nothing to seal"},{"type":"text","text":" "},{"type":"text","text":"against before then — and on the same terms as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)"},{"type":"text","text":" "},{"type":"text","text":"otherwise."}],"type":"paragraph"}]}],"kind":"content"}],"sections":[],"kind":"symbol","metadata":{"externalID":"s:8AxiamSDK0A6ClientC23opaqueEnrollmentForSelf8passwordAA