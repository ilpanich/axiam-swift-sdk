xiamSDK\/AxiamClient\/opaqueEnrollment(password:)"},{"text":". It is still the method to call for a","type":"text"},{"text":" ","type":"text"},{"text":"self-service password change, because which principal is signed in is not something the","type":"text"},{"text":" ","type":"text"},{"text":"call site usually knows.","type":"text"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},{"text":" when no login has completed on this client yet —","type":"text"},{"text":" ","type":"text"},{"text":"the principal tenant is reported by the login response, so there is nothing to seal","type":"text"},{"text":" ","type":"text"},{"text":"against before then — and on the same terms as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)"},{"text":" ","type":"text"},{"text":"otherwise.","type":"text"}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Builds a registration record for the "},{"type":"strong","inlineContent":[{"type":"text","text":"caller’s own"}]},{"type":"text","text":" new password, sealed against the"},{"type":"text","text":" "},{"type":"text","text":"tenant the caller’s account lives in."}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/opaqueenrollmentforself(password:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollmentForSelf(password:)"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"symbolKind":"method","title":"opaqueEnrollmentForSelf(password:)","modules":[{"name":"