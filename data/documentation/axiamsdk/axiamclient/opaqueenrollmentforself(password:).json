ponse, so there is nothing to seal","type":"text"},{"text":" ","type":"text"},{"text":"against before then — and on the same terms as ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"otherwise.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollmentForSelf(password:)","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/network(_:)":{"title":"AxiamError.network(_:)","url":"\/documentation\/axiamsdk\/axiamerror\/network(_:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"network"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8AxiamSDK12NetworkErrorV","kind":"typeIdentifier","text":"NetworkError"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Transport-level failure: connection refused, timeout, TLS error, DNS failure,"},{"type":"text","text":" "},{"type":"text","text":"malformed request, server (5xx) error."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/opaqueEnrollmentForSelf(password:)":{"kind":"symbol","title":"opaqueEnrollmentForSelf(password:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Builds a registration record for the "},{"type":"strong","inlineContent":[{"text":"caller’s own","type":"text"}]},{"text":" new password, sealed against the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"tenant the caller’s account lives in."}],"url":"\/documentation\/ax