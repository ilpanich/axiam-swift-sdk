{"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"oidcRefresh"},{"kind":"text","text":"("},{"kind":"externalParam","text":"refreshToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OidcConfiguration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"OidcTokenSet","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet","preciseIdentifier":"s:8AxiamSDK12OidcTokenSetV"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"§12.4 rules 1–5 and 7 apply to any ","type":"text"},{"code":"id_token","type":"codeVoice"},{"text":" in the response; rule 6 (nonce) is skipped,","type":"text"},{"text":" ","type":"text"},{"text":"because OIDC Core §12.2 does not require a nonce in a refresh-issued ID token.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Single-flight (§9, §12.1).","type":"text"}]},{"type":"text","text":" A burst of concurrent calls presenting the same refresh"},{"type":"text","text":" "},{"type":"text","text":"token makes "},{"type":"strong","inlineContent":[{"text":"one","type":"text"}]},{"type":"text","text":" wire call, and that one outcome — the token set or the one error — is"},{"type":"text","text":" "},{"type":"text","text":"delivered to every caller in the burst. The refresh token is single-use and rotating, so"},{"type":"text","text":" "},{"type":"text","text":"“one call per caller” would present it N times, and from contract 1.65 a replayed token"},{"type":"text","text":" "},{"type":"text","text":"ends the whole session on the server. The slot is vacated, identity-checked, only after"},{"type":"text","text":" "},{"type":"text","text":"the outcome has settled; a call that starts after that makes its own request (§9 rule 6)."},{"type":"text","text":" "},{"type":"text","text":"The guard is per client instance: refreshing the same token from two clients, or two"},{"type":"text","text":" "},{"type":"text","text":"processes sharing a token store, defeats it and is a defect."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"code":"invalid_grant","type":"codeVoice"},{"text":" means the session is over","type":"text"}],"type":"strong"},{"text":" (§9, contract 1.65). It surfaces as the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","type":"reference"},{"text":" it is, once; this SDK holds no token of its own to retry with and never","type":"text"},{"text":" ","type":"text"},{"text":"presents the spent one again. Re-authorize.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"code":"POST \/oauth2\/token","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"grant_type=refresh_token","type":"codeVoice"},{"text":" (§12.1).","type":"text"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcRefresh(refreshToken:tenantID:configuration:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/oidcrefresh(refreshtoken:tenantid:configuration:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","roleHeading":"Instance Method","extendedModule":"AxiamSDK","externalID":"s:8AxiamSDK0A6ClientC11oidcRefresh12refreshToken8tenantID13configurationAA04OidcG3SetVAA9SensitiveVySSG_SSSgAA0K13ConfigurationVSgtYaKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oidcRefresh","kind":"identifier"},{"text":"(","kind":"text"},{"text":"refreshToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"OidcTokenSet","preciseIdentifier":"s:8AxiamSDK12OidcTokenSetV","kind":"typeIdentifier"}],"symbolKind":"method","modules":[{"name":"AxiamSDK"}],"title":"oidcRefresh(refreshToken:tenantID:configuration:)"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/oidcRefresh(refreshToken:tenantID:configuration:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcRefresh(refreshToken:tenantID:configuration:)","role":"symbol","fragments":[{"kin