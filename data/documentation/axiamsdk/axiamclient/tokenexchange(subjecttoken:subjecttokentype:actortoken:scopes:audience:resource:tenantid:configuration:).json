/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","title":"AxiamClient","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AxiamClient"}],"abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}],"url":"\/documentation\/axiamsdk\/axiamclient","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamClient"}]},"doc://AxiamSDK/documentation/AxiamSDK/ExchangedToken/scope":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope","url":"\/documentation\/axiamsdk\/exchangedtoken\/scope","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"scope"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"kind":"symbol","title":"scope","abstract":[{"type":"text","text":"The scopes actually granted. Read it: §15.2 requires the server to answer with what the"},{"type":"text","text":" "},{"type":"text","text":"caller got, which may be narrower than what it asked for."}]},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"type":"topic","title":"Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"kind":"symbol","url":"\/documentation\/axiamsdk\/sensitive","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}]}}}