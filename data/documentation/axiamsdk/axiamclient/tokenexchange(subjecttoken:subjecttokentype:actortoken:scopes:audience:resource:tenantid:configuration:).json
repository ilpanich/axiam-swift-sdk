Token"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier","text":"Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]? = nil, "},{"kind":"externalParam","text":"audience"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"resource"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","text":"OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","preciseIdentifier":"s:8AxiamSDK14ExchangedTokenV","kind":"typeIdentifier","text":"ExchangedToken"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"subjectToken","content":[{"inlineContent":[{"text":"The token being exchanged — positional and first, because four","type":"text"},{"text":" ","type":"text"},{"text":"optional strings in positional order is a bug waiting to be written.","type":"text"}],"type":"paragraph"}]},{"name":"subjectTokenType","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What kind of token "},{"type":"codeVoice","code":"subjectToken"},{"type":"text","text":" is. "},{"inlineContent":[{"type":"text","text":"Required"}],"type":"strong"},{"type":"text","text":" (§15.1), with"},{"type":"text","text":" "},{"type":"text","text":"no default: a default would be this SDK choosing which kind of credential the"},{"type":"text","text":" "},{"type":"text","text":"caller holds, which is what §15.7 forbids. Pass "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType","isActive":true},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"same-domain exchange, or "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType","isActive":true},{"type":"text","text":" for a trusted external issuer’s JWT"},{"type":"text","text":" "},{"type":"text","text":"(§15.7). This SDK never reads "},{"type":"codeVoice","code":"subjectToken"},{"type":"text","text":" to decide the value: which kind of"},{"type":"text","text":" "},{"type":"text","text":"token the caller holds is only the caller’s to know, AXIAM refuses refresh and ID"},{"type":"text","text":" "},{"type":"text","text":"token types by name, and a refusal is never retried as a different type."}]}]},{"name":"actorToken","content":[{"inlineContent":[{"text":"","type":"text"},{"inlineContent":[{"text":"its presence selects delegation; its absence selects impersonation.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"Two different operations with different risk, and §15.2 rule 1 forbids papering over","type":"text"},{"text":" ","type":"text"},{"text":"the difference: this SDK supplies no default actor token and never substitutes its","type":"text"},{"text":" ","type":"text"},{"text":"own session for one. Passing nothing here asks for impersonation, and the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses unless this client holds that grant.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"The actor token must have been issued to this client"}],"type":"strong"},{"text":" (§15.2 rule 9, contract","type":"text"},{"text":" ","type":"text"},{"text":"1.60): obtain it with the same client’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginClientCredentials(scope:tenantID:configuration:)"},{"text":" ","type":"text"},{"text":"grant and pass its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/accessToken"},{"text":" here — its ","type":"text"},{"code":"sub","type":"codeVoice"},{"text":" is this client’s","type":"text"},{"text":" ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":". A token issued to another client, a console sign-in or a service","type":"text"},{"text":" ","type":"text"},{"text":"account is answered ","type":"text"},{"code":"400","type":"codeVoice"},{"text":" ","type":"text"},{"code":"invalid_request","type":"codeVoice"},{"text":" (“actor_token was not issued to the","type":"text"},{"text":" ","type":"text"},{"text":"exchanging client”), which surfaces unchanged: not retried, not rewritten into an","type":"text"},{"text":" ","type":"text"},{"text":"impersonation, and not repaired by substituting a token of this SDK’s own.","type":"text"}],"type":"paragraph"}]},{"name":"scopes","content":[{"type":"paragraph","inlineContent":[{"text":"Omit to inherit the subject’s, bounded by this client’s registration. The","type":"text"},{"text":" ","type":"text"},{"text":"response’s ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope","type":"reference","isActive":true},{"text":" is what was actually granted, which may be","type":"text"},{"text":" ","type":"text"},{"text":"narrower than what was asked for even on success (§15.2 rule 7) — read it.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"What this deliberately does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" do:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No retry, downgrade or rewrite on ","type":"text"},{"type":"codeVoice","code":"unauthorized_client"}],"type":"strong"},{"type":"text","text":" (§15.2 rule 2). It means"},{"type":"text","text":" "},{"type":"text","text":"either “this client may not exchange at all” or “this client may not impersonate”;"},{"type":"text","text":" "},{"type":"text","text":"both are registration facts an operator must fix, and reworking the request into a"},{"type":"text","text":" "},{"type":"text","text":"delegation would send one the caller did not write."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No auto-narrowing on "},{"type":"codeVoice","code":"invalid_scope"}],"type":"strong"},{"type":"text","text":" (§15.2 rule 3). The server refuses rather than"},{"type":"text","text":" "},{"type":"text","text":"silently narrowing precisely so the caller finds out here."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No refresh token, ever","type":"text"}],"type":"strong"},{"text":" (§15.2 rule 4). ","type":"text"},{"code":"TokenExchangeResponse","type":"codeVoice"},{"text":" has no such field,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","type":"reference"},{"text":" has nowhere to put one, and this result never enters the §9","type":"text"},{"text":" ","type":"text"},{"text":"single-flight refresh guard. Re-run the exchange to get a fresh token.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No adoption"}]},{"text":" (§15.2 rule 5). The exchanged token is not this client’s session — not","type":"text"},{"text":" ","type":"text"},{"text":"even behind an opt-in flag, which is a MUST NOT here where adoption elsewhere is a MAY.","type":"text"},{"text":" ","type":"text"},{"text":"It is a token to hand onward in one outbound call; adopting it would silently","type":"text"},{"text":" ","type":"text"},{"text":"re-privilege every subsequent call this client makes.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A cross-tenant subject token answers "},{"code":"invalid_grant","type":"codeVoice"},{"type":"text","text":", and this SDK does not try to"},{"type":"text","text":" "},{"type":"text","text":"distinguish “wrong tenant” from “bad token” (§15.3): the server collapses them because"},{"type":"text","text":" "},{"type":"text","text":"telling them apart is a tenant-enumeration signal."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/jwtTokenType":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"jwtTokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"url":"\/documentation\/axiamsdk\/axiamclient\/jwttokentype","title":"jwtTokenType","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A JWT from a trusted external issuer — the cross-domain exchange of §15.7."}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/loginClientCredentials(scope:tenantID:configuration:)":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginClientCredentials(scope:tenantID:configuration:)","url":"\/documentation\/axiamsdk\/axiamclient\/loginclientcredentials(scope:tenantid:configuration:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loginClientCredentials"},{"kind":"text","text":"("},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12OidcTokenSetV","text":"OidcTokenSet"}],"title":"loginClientCredentials(scope:tenantID:configuration:)","role":"symbol","type":"topic","abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"type":"text","text":" with "},{"type":"codeVoice","code":"grant_type=client_credentials"},{"type":"text","text":" (§12.1) — service-account"},{"type":"text","text":" "},{"type":"text","text":"login, and the operation §12.6 itself named as the one an embedded consumer wants."}]},"doc://AxiamSDK/documentation/AxiamSDK/ExchangedToken/scope":{"url":"\/documentation\/axiamsdk\/exchangedtoken\/scope","role":"symbol","abstract":[{"type":"text","text":"The scopes actually granted. Read it: §15.2 requires the server to answer with what the"},{"type":"text","text":" "},{"type":"text","text":"caller got, which may be narrower than what it asked for."}],"kind":"symbol","title":"scope","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/accessTokenType":{"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType","title":"accessTokenType","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessTokenType"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"actor_token_type"},{"text":" this SDK sends, and the ","type":"text"},{"type":"codeVoice","code":"subject_token_type"},{"text":" a caller names for","type":"text"},{"text":" ","type":"text"},{"text":"the same-domain exchange of §15.1. There is no default: the type is a required","type":"text"},{"text":" ","type":"text"},{"text":"parameter of ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"url":"\/documentation\/axiamsdk\/axiamclient\/accesstokentype"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)":{"type":"topic","kind":"symbol","role":"symbol","title":"tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","fragments":[{"kind":"keyword