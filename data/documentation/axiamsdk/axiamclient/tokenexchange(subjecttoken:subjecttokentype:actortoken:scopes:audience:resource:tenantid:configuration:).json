{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","interfaceLanguage":"swift"},"abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"type":"text","text":" with the RFC 8693 grant (§15.1)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tokenExchange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"subjectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"text":"subjectTokenType","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"actorToken","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">? = nil, ","kind":"text"},{"text":"scopes","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]? = nil, ","kind":"text"},{"text":"audience","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"resource","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","text":"OidcConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","text":"ExchangedToken","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK14ExchangedTokenV"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the token being exchanged — positional and first, because four"},{"type":"text","text":" "},{"type":"text","text":"optional strings in positional order is a bug waiting to be written."}]}],"name":"subjectToken"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"what kind of token "},{"type":"codeVoice","code":"subjectToken"},{"type":"text","text":" is. "},{"type":"strong","inlineContent":[{"type":"text","text":"Required"}]},{"type":"text","text":" (§15.1), with"},{"type":"text","text":" "},{"type":"text","text":"no default: a default would be this SDK choosing which kind of credential the"},{"type":"text","text":" "},{"type":"text","text":"caller holds, which is what §15.7 forbids. Pass "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType","isActive":true},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"same-domain exchange, or "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType","isActive":true},{"type":"text","text":" for a trusted external issuer’s JWT"},{"type":"text","text":" "},{"type":"text","text":"(§15.7). This SDK never reads "},{"type":"codeVoice","code":"subjectToken"},{"type":"text","text":" to decide the value: which kind of"},{"type":"text","text":" "},{"type":"text","text":"token the caller holds is only the caller’s to know, AXIAM refuses refresh and ID"},{"type":"text","text":" "},{"type":"text","text":"token types by name, and a refusal is never retried as a different type."}]}],"name":"subjectTokenType"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"inlineContent":[{"type":"text","text":"its presence selects delegation; its absence selects impersonation."}],"type":"strong"},{"text":" ","type":"text"},{"text":"Two different operations with different risk, and §15.2 rule 1 forbids papering over","type":"text"},{"text":" ","type":"text"},{"text":"the difference: this SDK supplies no default actor token and never substitutes its","type":"text"},{"text":" ","type":"text"},{"text":"own session for one. Passing nothing here asks for impersonation, and the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses unless this client holds that grant.","type":"text"}]}],"name":"actorToken"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"omit to inherit the subject’s, bounded by this client’s registration. The"},{"type":"text","text":" "},{"type":"text","text":"response’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope"},{"type":"text","text":" is what was actually granted, which may be"},{"type":"text","text":" "},{"type":"text","text":"narrower than what was asked for even on success (§15.2 rule 7) — read it."}]}],"name":"scopes"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"What this deliberately does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" do:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"No retry, downgrade or rewrite on ","type":"text"},{"type":"codeVoice","code":"unauthorized_client"}],"type":"strong"},{"text":" (§15.2 rule 2). It means","type":"text"},{"text":" ","type":"text"},{"text":"either “this client may not exchange at all” or “this client may not impersonate”;","type":"text"},{"text":" ","type":"text"},{"text":"both are registration facts an operator must fix, and reworking the request into a","type":"text"},{"text":" ","type":"text"},{"text":"delegation would send one the caller did not write.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No auto-narrowing on "},{"type":"codeVoice","code":"invalid_scope"}]},{"type":"text","text":" (§15.2 rule 3). The server refuses rather than"},{"type":"text","text":" "},{"type":"text","text":"silently narrowing precisely so the caller finds out here."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No refresh token, ever"}],"type":"strong"},{"type":"text","text":" (§15.2 rule 4). "},{"code":"TokenExchangeResponse","type":"codeVoice"},{"type":"text","text":" has no such field,"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken"},{"type":"text","text":" has nowhere to put one, and this result never enters the §9"},{"type":"text","text":" "},{"type":"text","text":"single-flight refresh guard. Re-run the exchange to get a fresh token."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No adoption"}]},{"type":"text","text":" (§15.2 rule 5). The exchanged token is not this client’s session — not"},{"type":"text","text":" "},{"type":"text","text":"even behind an opt-in flag, which is a MUST NOT here where adoption elsewhere is a MAY."},{"type":"text","text":" "},{"type":"text","text":"It is a token to hand onward in one outbound call; adopting it would silently"},{"type":"text","text":" "},{"type":"text","text":"re-privilege every subsequent call this client makes."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A cross-tenant subject token answers "},{"code":"invalid_grant","type":"codeVoice"},{"type":"text","text":", and this SDK does not try to"},{"type":"text","text":" "},{"type":"text","text":"distinguish “wrong tenant” from “bad token” (§15.3): the server collapses them because"},{"type":"text","text":" "},{"type":"text","text":"telling them apart is a tenant-enumeration signal."}]}]}],"metadata":{"extendedModule":"AxiamSDK","roleHeading":"Instance Method","symbolKind":"method","role":"symbol","title":"tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","externalID":"s:8AxiamSDK0A6ClientC13tokenExchange12subjectToken0fG4Type05actorG06scopes8audience8resource8tenantID13configurationAA09ExchangedG0VAA9SensitiveVySSG_SSAQSgSaySSGSgSSSgA2uA17OidcConfigurationVSgtYaKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tokenExchange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"subjectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"subjectTokenType","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"actorToken","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":">?, ","kind":"text"},{"text":"scopes","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]?, ","kind":"text"},{"text":"audience","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"resource","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","text":"OidcConfiguration"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK14ExchangedTokenV","kind":"typeIdentifier","text":"ExchangedToken"}],"modules":[{"name":"AxiamSDK"}]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/tokenexchange(subjecttoken:subjecttokentype:actortoken:scopes:audience:resource:tenantid:configuration:)"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/ExchangedToken/scope":{"url":"\/documentation\/axiamsdk\/exchangedtoken\/scope","abstract":[{"text":"The scopes actually granted. Read it: §15.2 requires the server to answer with what the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"caller got, which may be narrower than what it asked for."}],"kind":"symbol","title":"scope","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scope","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"abstract":[{"text":"A wrapper for secret material (§7 of CONTRACT.md).","type":"text"}],"url":"\/documentation\/axiamsdk\/sensitive","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","title":"Sensitive"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}],"kind":"symbol","role":"symbol","title":"AxiamClient","url":"\/documentation\/axiamsdk\/axiamclient","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tokenExchange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"subjectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text"