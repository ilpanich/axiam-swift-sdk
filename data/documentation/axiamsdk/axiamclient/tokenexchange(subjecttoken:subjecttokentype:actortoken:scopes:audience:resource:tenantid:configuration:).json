{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tokenExchange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"subjectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"text":"subjectTokenType","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"actorToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">? = nil, ","kind":"text"},{"text":"scopes","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]? = nil, ","kind":"text"},{"text":"audience","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"resource","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcConfiguration","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"ExchangedToken","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","preciseIdentifier":"s:8AxiamSDK14ExchangedTokenV"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the token being exchanged — positional and first, because four","type":"text"},{"text":" ","type":"text"},{"text":"optional strings in positional order is a bug waiting to be written.","type":"text"}]}],"name":"subjectToken"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"what kind of token "},{"type":"codeVoice","code":"subjectToken"},{"type":"text","text":" is. "},{"inlineContent":[{"text":"Required","type":"text"}],"type":"strong"},{"type":"text","text":" (§15.1), with"},{"type":"text","text":" "},{"type":"text","text":"no default: a default would be this SDK choosing which kind of credential the"},{"type":"text","text":" "},{"type":"text","text":"caller holds, which is what §15.7 forbids. Pass "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"same-domain exchange, or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType"},{"type":"text","text":" for a trusted external issuer’s JWT"},{"type":"text","text":" "},{"type":"text","text":"(§15.7). This SDK never reads "},{"type":"codeVoice","code":"subjectToken"},{"type":"text","text":" to decide the value: which kind of"},{"type":"text","text":" "},{"type":"text","text":"token the caller holds is only the caller’s to know, AXIAM refuses refresh and ID"},{"type":"text","text":" "},{"type":"text","text":"token types by name, and a refusal is never retried as a different type."}]}],"name":"subjectTokenType"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"inlineContent":[{"text":"its presence selects delegation; its absence selects impersonation.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"Two different operations with different risk, and §15.2 rule 1 forbids papering over","type":"text"},{"text":" ","type":"text"},{"text":"the difference: this SDK supplies no default actor token and never substitutes its","type":"text"},{"text":" ","type":"text"},{"text":"own session for one. Passing nothing here asks for impersonation, and the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses unless this client holds that grant.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The actor token must have been issued to this client","type":"text"}],"type":"strong"},{"text":" (§15.2 rule 9, contract","type":"text"},{"text":" ","type":"text"},{"text":"1.60): obtain it with the same client’s ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginClientCredentials(scope:tenantID:configuration:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"grant and pass its ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/accessToken","isActive":true,"type":"reference"},{"text":" here — its ","type":"text"},{"type":"codeVoice","code":"sub"},{"text":" is this client’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":". A token issued to another client, a console sign-in or a service","type":"text"},{"text":" ","type":"text"},{"text":"account is answered ","type":"text"},{"type":"codeVoice","code":"400"},{"text":" ","type":"text"},{"type":"codeVoice","code":"invalid_request"},{"text":" (“actor_token was not issued to the","type":"text"},{"text":" ","type":"text"},{"text":"exchanging client”), which surfaces unchanged: not retried, not rewritten into an","type":"text"},{"text":" ","type":"text"},{"text":"impersonation, and not repaired by substituting a token of this SDK’s own.","type":"text"}]}],"name":"actorToken"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"omit to inherit the subject’s, bounded by this client’s registration. The"},{"type":"text","text":" "},{"type":"text","text":"response’s "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope","isActive":true},{"type":"text","text":" is what was actually granted, which may be"},{"type":"text","text":" "},{"type":"text","text":"narrower than what was asked for even on success (§15.2 rule 7) — read it."}]}],"name":"scopes"}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"What this deliberately does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" do:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No retry, downgrade or rewrite on "},{"type":"codeVoice","code":"unauthorized_client"}]},{"text":" (§15.2 rule 2). It means","type":"text"},{"text":" ","type":"text"},{"text":"either “this client may not exchange at all” or “this client may not impersonate”;","type":"text"},{"text":" ","type":"text"},{"text":"both are registration facts an operator must fix, and reworking the request into a","type":"text"},{"text":" ","type":"text"},{"text":"delegation would send one the caller did not write.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No auto-narrowing on "},{"code":"invalid_scope","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (§15.2 rule 3). The server refuses rather than"},{"type":"text","text":" "},{"type":"text","text":"silently narrowing precisely so the caller finds out here."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No refresh token, ever"}]},{"type":"text","text":" (§15.2 rule 4). "},{"type":"codeVoice","code":"TokenExchangeResponse"},{"type":"text","text":" has no such field,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","isActive":true},{"type":"text","text":" has nowhere to put one, and this result never enters the §9"},{"type":"text","text":" "},{"type":"text","text":"single-flight refresh guard. Re-run the exchange to get a fresh token."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No adoption","type":"text"}],"type":"strong"},{"text":" (§15.2 rule 5). The exchanged token is not this client’s session — not","type":"text"},{"text":" ","type":"text"},{"text":"even behind an opt-in flag, which is a MUST NOT here where adoption elsewhere is a MAY.","type":"text"},{"text":" ","type":"text"},{"text":"It is a token to hand onward in one outbound call; adopting it would silently","type":"text"},{"text":" ","type":"text"},{"text":"re-privilege every subsequent call this client makes.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A cross-tenant subject token answers "},{"code":"invalid_grant","type":"codeVoice"},{"type":"text","text":", and this SDK does not try to"},{"type":"text","text":" "},{"type":"text","text":"distinguish “wrong tenant” from “bad token” (§15.3): the server collapses them because"},{"type":"text","text":" "},{"type":"text","text":"telling them apart is a tenant-enumeration signal."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","role":"symbol","modules":[{"name":"AxiamSDK"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tokenExchange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subjectToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"subjectTokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"actorToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"audience"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"resource"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"ExchangedToken","preciseIdentifier":"s:8AxiamSDK14ExchangedTokenV"}],"roleHeading":"Instance Method","extendedModule":"AxiamSDK","externalID":"s:8AxiamSDK0A6ClientC13tokenExchange12subjectToken0fG4Type05actorG06scopes8audience8resource8tenantID13configurationAA09ExchangedG0VAA9SensitiveVySSG_SSAQSgSaySSGSgSSSgA2uA17OidcConfigurationVSgtYaKF","symbolKind":"method"},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/tokenexchange(subjecttoken:subjecttokentype:actortoken:scopes:audience:resource:tenantid:configuration:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"code":"POST \/oauth2\/token","type":"codeVoice"},{"type":"text","text":" with the RFC 8693 grant (§15.1)."}],"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/OidcTokenSet/accessToken":{"abstract":[],"role":"symbol","url":"\/documentation\/axiamsdk\/oidctokenset\/accesstoken","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/accessToken","title":"accessToken","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"accessToken"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/accessTokenType":{"kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType","url":"\/documentation\/axiamsdk\/axiamclient\/accesstokentype","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"actor_token_type"},{"text":" this SDK sends, and the ","type":"text"},{"code":"subject_token_type","type":"codeVoice"},{"text":" a caller names for","type":"text"},{"text":" ","type":"text"},{"text":"the same-domain exchange of §15.1. There is no default: the type is a required","type":"text"},{"text":" ","type":"text"},{"text":"parameter of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)"},{"text":".","type":"text"}],"role":"symbol","title":"accessTokenType","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessTokenType","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/OidcConfiguration":{"title":"OidcConfiguration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","abstract":[{"text":"The OIDC discovery document (§12.1), read from ","type":"text"},{"type":"codeVoice","code":"\/.well-known\/openid-configuration"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"OidcConfiguration"}],"type":"topic","url":"\/documentation\/axiamsdk\/oidcconfiguration","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OidcConfiguration"}]},"doc://AxiamSDK/document