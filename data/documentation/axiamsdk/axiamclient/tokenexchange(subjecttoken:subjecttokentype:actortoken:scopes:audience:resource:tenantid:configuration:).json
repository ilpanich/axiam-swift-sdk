han what it asked for.","type":"text"}],"title":"scope","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"role":"symbol","url":"\/documentation\/axiamsdk\/exchangedtoken\/scope"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/jwtTokenType":{"kind":"symbol","title":"jwtTokenType","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A JWT from a trusted external issuer — the cross-domain exchange of §15.7."}],"url":"\/documentation\/axiamsdk\/axiamclient\/jwttokentype","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"jwtTokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcConfiguration":{"type":"topic","kind":"symbol","title":"OidcConfiguration","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OidcConfiguration","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/oidcconfiguration","navigatorTitle":[{"text":"OidcConfiguration","kind":"identifier"}],"abstract":[{"text":"The OIDC discovery document (§12.1), read from ","type":"text"},{"code":"\/.well-known\/openid-configuration","type":"codeVoice"},{"text":".","type":"text"}]}}}