{"kind":"symbol","abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"type":"text","text":" with the RFC 8693 grant (§15.1)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tokenExchange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"subjectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"subjectTokenType","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"actorToken","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":">? = nil, ","kind":"text"},{"text":"scopes","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]? = nil, ","kind":"text"},{"text":"audience","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"resource","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","preciseIdentifier":"s:8AxiamSDK14ExchangedTokenV","text":"ExchangedToken","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The token being exchanged — positional and first, because four","type":"text"},{"text":" ","type":"text"},{"text":"optional strings in positional order is a bug waiting to be written.","type":"text"}]}],"name":"subjectToken"},{"content":[{"type":"paragraph","inlineContent":[{"text":"What kind of token ","type":"text"},{"type":"codeVoice","code":"subjectToken"},{"text":" is. ","type":"text"},{"inlineContent":[{"text":"Required","type":"text"}],"type":"strong"},{"text":" (§15.1), with","type":"text"},{"text":" ","type":"text"},{"text":"no default: a default would be this SDK choosing which kind of credential the","type":"text"},{"text":" ","type":"text"},{"text":"caller holds, which is what §15.7 forbids. Pass ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType","isActive":true},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"same-domain exchange, or ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType","isActive":true},{"text":" for a trusted external issuer’s JWT","type":"text"},{"text":" ","type":"text"},{"text":"(§15.7). This SDK never reads ","type":"text"},{"type":"codeVoice","code":"subjectToken"},{"text":" to decide the value: which kind of","type":"text"},{"text":" ","type":"text"},{"text":"token the caller holds is only the caller’s to know, AXIAM refuses refresh and ID","type":"text"},{"text":" ","type":"text"},{"text":"token types by name, and a refusal is never retried as a different type.","type":"text"}]}],"name":"subjectTokenType"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"strong","inlineContent":[{"type":"text","text":"its presence selects delegation; its absence selects impersonation."}]},{"type":"text","text":" "},{"type":"text","text":"Two different operations with different risk, and §15.2 rule 1 forbids papering over"},{"type":"text","text":" "},{"type":"text","text":"the difference: this SDK supplies no default actor token and never substitutes its"},{"type":"text","text":" "},{"type":"text","text":"own session for one. Passing nothing here asks for impersonation, and the server"},{"type":"text","text":" "},{"type":"text","text":"refuses unless this client holds that grant."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"The actor token must have been issued to this client","type":"text"}]},{"text":" (§15.2 rule 9, contract","type":"text"},{"text":" ","type":"text"},{"text":"1.60): obtain it with the same client’s ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginClientCredentials(scope:tenantID:configuration:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"grant and pass its ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/accessToken","isActive":true,"type":"reference"},{"text":" here — its ","type":"text"},{"type":"codeVoice","code":"sub"},{"text":" is this client’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":". A token issued to another client, a console sign-in or a service","type":"text"},{"text":" ","type":"text"},{"text":"account is answered ","type":"text"},{"type":"codeVoice","code":"400"},{"text":" ","type":"text"},{"type":"codeVoice","code":"invalid_request"},{"text":" (“actor_token was not issued to the","type":"text"},{"text":" ","type":"text"},{"text":"exchanging client”), which surfaces unchanged: not retried, not rewritten into an","type":"text"},{"text":" ","type":"text"},{"text":"impersonation, and not repaired by substituting a token of this SDK’s own.","type":"text"}]}],"name":"actorToken"},{"content":[{"inlineContent":[{"text":"Omit to inherit the subject’s, bounded by this client’s registration. The","type":"text"},{"text":" ","type":"text"},{"text":"response’s ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope"},{"text":" is what was actually granted, which may be","type":"text"},{"text":" ","type":"text"},{"text":"narrower than what was asked for even on success (§15.2 rule 7) — read it.","type":"text"}],"type":"paragraph"}],"name":"scopes"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"What this deliberately does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" do:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No retry, downgrade or rewrite on "},{"type":"codeVoice","code":"unauthorized_client"}],"type":"strong"},{"type":"text","text":" (§15.2 rule 2). It means"},{"type":"text","text":" "},{"type":"text","text":"either “this client may not exchange at all” or “this client may not impersonate”;"},{"type":"text","text":" "},{"type":"text","text":"both are registration facts an operator must fix, and reworking the request into a"},{"type":"text","text":" "},{"type":"text","text":"delegation would send one the caller did not write."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No auto-narrowing on ","type":"text"},{"code":"invalid_scope","type":"codeVoice"}]},{"type":"text","text":" (§15.2 rule 3). The server refuses rather than"},{"type":"text","text":" "},{"type":"text","text":"silently narrowing precisely so the caller finds out here."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No refresh token, ever","type":"text"}],"type":"strong"},{"text":" (§15.2 rule 4). ","type":"text"},{"code":"TokenExchangeResponse","type":"codeVoice"},{"text":" has no such field,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken"},{"text":" has nowhere to put one, and this result never enters the §9","type":"text"},{"text":" ","type":"text"},{"text":"single-flight refresh guard. Re-run the exchange to get a fresh token.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No adoption"}]},{"text":" (§15.2 rule 5). The exchanged token is not this client’s session — not","type":"text"},{"text":" ","type":"text"},{"text":"even behind an opt-in flag, which is a MUST NOT here where adoption elsewhere is a MAY.","type":"text"},{"text":" ","type":"text"},{"text":"It is a token to hand onward in one outbound call; adopting it would silently","type":"text"},{"text":" ","type":"text"},{"text":"re-privilege every subsequent call this client makes.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A cross-tenant subject token answers "},{"code":"invalid_grant","type":"codeVoice"},{"type":"text","text":", and this SDK does not try to"},{"type":"text","text":" "},{"type":"text","text":"distinguish “wrong tenant” from “bad token” (§15.3): the server collapses them because"},{"type":"text","text":" "},{"type":"text","text":"telling them apart is a tenant-enumeration signal."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/tokenexchange(subjecttoken:subjecttokentype:actortoken:scopes:audience:resource:tenantid:configuration:)"]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Instance Method","extendedModule":"AxiamSDK","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tokenExchange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subjectToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"subjectTokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"actorToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"audience"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"resource"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"configuration"},{"kind":"tex