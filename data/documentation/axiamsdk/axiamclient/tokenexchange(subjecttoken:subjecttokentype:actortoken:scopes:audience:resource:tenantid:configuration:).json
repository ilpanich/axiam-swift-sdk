{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tokenExchange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subjectToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"subjectTokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"actorToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]? = nil, "},{"kind":"externalParam","text":"audience"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"resource"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OidcConfiguration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"ExchangedToken","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","preciseIdentifier":"s:8AxiamSDK14ExchangedTokenV"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the token being exchanged — positional and first, because four","type":"text"},{"text":" ","type":"text"},{"text":"optional strings in positional order is a bug waiting to be written.","type":"text"}]}],"name":"subjectToken"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"what kind of token "},{"code":"subjectToken","type":"codeVoice"},{"type":"text","text":" is. "},{"inlineContent":[{"type":"text","text":"Required"}],"type":"strong"},{"type":"text","text":" (§15.1), with"},{"type":"text","text":" "},{"type":"text","text":"no default: a default would be this SDK choosing which kind of credential the"},{"type":"text","text":" "},{"type":"text","text":"caller holds, which is what §15.7 forbids. Pass "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType","type":"reference","isActive":true},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"same-domain exchange, or "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType","type":"reference","isActive":true},{"type":"text","text":" for a trusted external issuer’s JWT"},{"type":"text","text":" "},{"type":"text","text":"(§15.7). This SDK never reads "},{"code":"subjectToken","type":"codeVoice"},{"type":"text","text":" to decide the value: which kind of"},{"type":"text","text":" "},{"type":"text","text":"token the caller holds is only the caller’s to know, AXIAM refuses refresh and ID"},{"type":"text","text":" "},{"type":"text","text":"token types by name, and a refusal is never retried as a different type."}]}],"name":"subjectTokenType"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"strong","inlineContent":[{"text":"its presence selects delegation; its absence selects impersonation.","type":"text"}]},{"text":" ","type":"text"},{"text":"Two different operations with different risk, and §15.2 rule 1 forbids papering over","type":"text"},{"text":" ","type":"text"},{"text":"the difference: this SDK supplies no default actor token and never substitutes its","type":"text"},{"text":" ","type":"text"},{"text":"own session for one. Passing nothing here asks for impersonation, and the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses unless this client holds that grant.","type":"text"}]}],"name":"actorToken"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"omit to inherit the subject’s, bounded by this client’s registration. The"},{"type":"text","text":" "},{"type":"text","text":"response’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope"},{"type":"text","text":" is what was actually granted, which may be"},{"type":"text","text":" "},{"type":"text","text":"narrower than what was asked for even on success (§15.2 rule 7) — read it."}]}],"name":"scopes"}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"What this deliberately does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" do:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No retry, downgrade or rewrite on ","type":"text"},{"type":"codeVoice","code":"unauthorized_client"}]},{"type":"text","text":" (§15.2 rule 2). It means"},{"type":"text","text":" "},{"type":"text","text":"either “this client may not exchange at all” or “this client may not impersonate”;"},{"type":"text","text":" "},{"type":"text","text":"both are registration facts an operator must fix, and reworking the request into a"},{"type":"text","text":" "},{"type":"text","text":"delegation would send one the caller did not write."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No auto-narrowing on "},{"type":"codeVoice","code":"invalid_scope"}]},{"type":"text","text":" (§15.2 rule 3). The server refuses rather than"},{"type":"text","text":" "},{"type":"text","text":"silently narrowing precisely so the caller finds out here."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"No refresh token, ever","type":"text"}]},{"text":" (§15.2 rule 4). ","type":"text"},{"code":"TokenExchangeResponse","type":"codeVoice"},{"text":" has no such field,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","type":"reference"},{"text":" has nowhere to put one, and this result never enters the §9","type":"text"},{"text":" ","type":"text"},{"text":"single-flight refresh guard. Re-run the exchange to get a fresh token.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No adoption","type":"text"}],"type":"strong"},{"text":" (§15.2 rule 5). The exchanged token is not this client’s session — not","type":"text"},{"text":" ","type":"text"},{"text":"even behind an opt-in flag, which is a MUST NOT here where adoption elsewhere is a MAY.","type":"text"},{"text":" ","type":"text"},{"text":"It is a token to hand onward in one outbound call; adopting it would silently","type":"text"},{"text":" ","type":"text"},{"text":"re-privilege every subsequent call this client makes.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"A cross-tenant subject token answers "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":", and this SDK does not try to"},{"type":"text","text":" "},{"type":"text","text":"distinguish “wrong tenant” from “bad token” (§15.3): the server collapses them because"},{"type":"text","text":" "},{"type":"text","text":"telling them apart is a tenant-enumeration signal."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/tokenexchange(subjecttoken:subjecttokentype:actortoken:scopes:audience:resource:tenantid:configuration:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method","role":"symbol","externalID":"s:8AxiamSDK0A6ClientC13tokenExchange12subjectToken0fG4Type05actorG06scopes8audience8resource8tenantID13configurationAA09ExchangedG0VAA9SensitiveVySSG_SSAQSgSaySSGSgSSSgA2uA17OidcConfigurationVSgtYaKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tokenExchange","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subjectToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"subjectTokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"actorToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"ki