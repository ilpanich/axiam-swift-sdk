ype":"codeVoice","code":"actor_token_type"},{"type":"text","text":" this SDK sends, and the "},{"type":"codeVoice","code":"subject_token_type"},{"type":"text","text":" a caller names for"},{"type":"text","text":" "},{"type":"text","text":"the same-domain exchange of §15.1. There is no default: the type is a required"},{"type":"text","text":" "},{"type":"text","text":"parameter of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)"},{"type":"text","text":"."}],"title":"accessTokenType","role":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\/accesstokentype","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessTokenType","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/sensitive","role":"symbol","title":"Sensitive"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/loginClientCredentials(scope:tenantID:configuration:)":{"title":"loginClientCredentials(scope:tenantID:configuration:)","abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"type":"text","text":" with "},{"type":"codeVoice","code":"grant_type=client_credentials"},{"type":"text","text":" (§12.1) — service-account"},{"type":"text","text":" "},{"type":"text","text":"login, and the operation §12.6 itself named as