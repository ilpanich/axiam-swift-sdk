{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tokenExchange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subjectToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"subjectTokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"actorToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]? = nil, "},{"kind":"externalParam","text":"audience"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"resource"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK14ExchangedTokenV","text":"ExchangedToken","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"subjectToken","content":[{"inlineContent":[{"text":"the token being exchanged — positional and first, because four","type":"text"},{"text":" ","type":"text"},{"text":"optional strings in positional order is a bug waiting to be written.","type":"text"}],"type":"paragraph"}]},{"name":"subjectTokenType","content":[{"type":"paragraph","inlineContent":[{"text":"what kind of token ","type":"text"},{"code":"subjectToken","type":"codeVoice"},{"text":" is. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Required","type":"text"}]},{"text":" (§15.1), with","type":"text"},{"text":" ","type":"text"},{"text":"no default: a default would be this SDK choosing which kind of credential the","type":"text"},{"text":" ","type":"text"},{"text":"caller holds, which is what §15.7 forbids. Pass ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType","isActive":true,"type":"reference"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"same-domain exchange, or ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType","isActive":true,"type":"reference"},{"text":" for a trusted external issuer’s JWT","type":"text"},{"text":" ","type":"text"},{"text":"(§15.7). This SDK never reads ","type":"text"},{"code":"subjectToken","type":"codeVoice"},{"text":" to decide the value: which kind of","type":"text"},{"text":" ","type":"text"},{"text":"token the caller holds is only the caller’s to know, AXIAM refuses refresh and ID","type":"text"},{"text":" ","type":"text"},{"text":"token types by name, and a refusal is never retried as a different type.","type":"text"}]}]},{"name":"actorToken","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"strong","inlineContent":[{"type":"text","text":"its presence selects delegation; its absence selects impersonation."}]},{"type":"text","text":" "},{"type":"text","text":"Two different operations with different risk, and §15.2 rule 1 forbids papering over"},{"type":"text","text":" "},{"type":"text","text":"the difference: this SDK supplies no default actor token and never substitutes its"},{"type":"text","text":" "},{"type":"text","text":"own session for one. Passing nothing here asks for impersonation, and the server"},{"type":"text","text":" "},{"type":"text","text":"refuses unless this client holds that grant."}]}]},{"name":"scopes","content":[{"inlineContent":[{"text":"omit to inherit the subject’s, bounded by this client’s registration. The","type":"text"},{"text":" ","type":"text"},{"text":"response’s ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope","type":"reference","isActive":true},{"text":" is what was actually granted, which may be","type":"text"},{"text":" ","type":"text"},{"text":"narrower than what was asked for even on success (§15.2 rule 7) — read it.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"What this deliberately does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" do:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No retry, downgrade or rewrite on "},{"type":"codeVoice","code":"unauthorized_client"}]},{"type":"text","text":" (§15.2 rule 2). It means"},{"type":"text","text":" "},{"type":"text","text":"either “this client may not exchange at all” or “this client may not impersonate”;"},{"type":"text","text":" "},{"type":"text","text":"both are registration facts an operator must fix, and reworking the request into a"},{"type":"text","text":" "},{"type":"text","text":"delegation would send one the caller did not write."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No auto-narrowing on "},{"code":"invalid_scope","type":"codeVoice"}],"type":"strong"},{"text":" (§15.2 rule 3). The server refuses rather than","type":"text"},{"text":" ","type":"text"},{"text":"silently narrowing precisely so the caller finds out here.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No refresh token, ever","type":"text"}]},{"text":" (§15.2 rule 4). ","type":"text"},{"code":"TokenExchangeResponse","type":"codeVoice"},{"text":" has no such field,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","type":"reference","isActive":true},{"text":" has nowhere to put one, and this result never enters the §9","type":"text"},{"text":" ","type":"text"},{"text":"single-flight refresh guard. Re-run the exchange to get a fresh token.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No adoption","type":"text"}],"type":"strong"},{"text":" (§15.2 rule 5). The exchanged token is not this client’s session — not","type":"text"},{"text":" ","type":"text"},{"text":"even behind an opt-in flag, which is a MUST NOT here where adoption elsewhere is a MAY.","type":"text"},{"text":" ","type":"text"},{"text":"It is a token to hand onward in one outbound call; adopting it would silently","type":"text"},{"text":" ","type":"text"},{"text":"re-privilege every subsequent call this client makes.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A cross-tenant subject token answers "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":", and this SDK does not try to"},{"type":"text","text":" "},{"type":"text","text":"distinguish “wrong tenant” from “bad token” (§15.3): the server collapses them because"},{"type":"text","text":" "},{"type":"text","text":"telling them apart is a tenant-enumeration signal."}]}],"kind":"content"}],"metadata":{"roleHeading":"Instance Method","role":"symbol","title":"tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","externalID":"s:8AxiamSDK0A6ClientC13tokenExchange12subjectToken0fG4Type05actorG06scopes8audience8resource8tenantID13configurationAA09ExchangedG0VAA9SensitiveVySSG_SSAQSgSaySSGSgSSSgA2uA17OidcConfigurationVSgtYaKF","symbolKind":"method","modules":[{"name":"AxiamSDK"}],"extendedModule":"AxiamSDK","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tokenExchange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subjectToken"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier","text":"Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"subjectTokenType"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"actorToken"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier","text":"Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":