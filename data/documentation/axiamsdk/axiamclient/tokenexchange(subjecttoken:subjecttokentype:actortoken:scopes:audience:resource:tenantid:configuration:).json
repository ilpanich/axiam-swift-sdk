Identifier","preciseIdentifier":"s:SS"},{"text":">? = nil, ","kind":"text"},{"text":"scopes","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]? = nil, ","kind":"text"},{"text":"audience","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"resource","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","text":"OidcConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","text":"ExchangedToken","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK14ExchangedTokenV"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"the token being exchanged — positional and first, because four"},{"type":"text","text":" "},{"type":"text","text":"optional strings in positional order is a bug waiting to be written."}],"type":"paragraph"}],"name":"subjectToken"},{"content":[{"type":"paragraph","inlineContent":[{"text":"what kind of token ","type":"text"},{"code":"subjectToken","type":"codeVoice"},{"text":" is. ","type":"text"},{"inlineContent":[{"type":"text","text":"Required"}],"type":"strong"},{"text":" (§15.1), with","type":"text"},{"text":" ","type":"text"},{"text":"no default: a default would be this SDK choosing which kind of credential the","type":"text"},{"text":" ","type":"text"},{"text":"caller holds, which is what §15.7 forbids. Pass ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType","type":"reference"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"same-domain exchange, or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType","type":"reference"},{"text":" for a trusted external issuer’s JWT","type":"text"},{"text":" ","type":"text"},{"text":"(§15.7). This SDK never reads ","type":"text"},{"code":"subjectToken","type":"codeVoice"},{"text":" to decide the value: which kind of","type":"text"},{"text":" ","type":"text"},{"text":"token the caller holds is only the caller’s to know, AXIAM refuses refresh and ID","type":"text"},{"text":" ","type":"text"},{"text":"token types by name, and a refusal is never retried as a different type.","type":"text"}]}],"name":"subjectTokenType"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"strong","inlineContent":[{"text":"its presence selects delegation; its absence selects impersonation.","type":"text"}]},{"text":" ","type":"text"},{"text":"Two different operations with different risk, and §15.2 rule 1 forbids papering over","type":"text"},{"text":" ","type":"text"},{"text":"the difference: this SDK supplies no default actor token and never substitutes its","type":"text"},{"text":" ","type":"text"},{"text":"own session for one. Passing nothing here asks for impersonation, and the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses unless this client holds that grant.","type":"text"}]}],"name":"actorToken"},{"content":[{"inlineContent":[{"type":"text","text":"omit to inherit the subject’s, bounded by this client’s registration. The"},{"type":"text","text":" "},{"type":"text","text":"response’s "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope","type":"reference","isActive":true},{"type":"text","text":" is what was actually granted, which may be"},{"type":"text","text":" "},{"type":"text","text":"narrower than what was asked for even on success (§15.2 rule 7) — read it."}],"type":"paragraph"}],"name":"scopes"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"What this deliberately does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" do:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No retry, downgrade or rewrite on "},{"code":"unauthorized_client","type":"codeVoice"}]},{"type":"text","text":" (§15.2 rule 2). It means"},{"type":"text","text":" "},{"type":"text","text":"either “this client may not exchange at all” or “this client may not impersonate”;"},{"type":"text","text":" "},{"type":"text","text":"both are registration facts an operator must fix, and reworking the request into a"},{"type":"text","text":" "},{"type":"text","text":"delegation would send one the caller did not write."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No auto-narrowing on "},{"code":"invalid_scope","type":"codeVoice"}]},{"text":" (§15.2 rule 3). The server refuses rather than","type":"text"},{"text":" ","type":"text"},{"text":"silently narrowing precisely so the caller finds out here.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No refresh token, ever","type":"text"}],"type":"strong"},{"type":"text","text":" (§15.2 rule 4). "},{"type":"codeVoice","code":"TokenExchangeResponse"},{"type":"text","text":" has no such field,"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","type":"reference"},{"type":"text","text":" has nowhere to put one, and this result never enters the §9"},{"type":"text","text":" "},{"type":"text","text":"single-flight refresh guard. Re-run the exchange to get a fresh token."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No adoption"}]},{"type":"text","text":" (§15.2 rule 5). The exchanged token is not this client’s session — not"},{"type":"text","text":" "},{"type":"text","text":"even behind an opt-in flag, which is a MUST NOT here where adoption elsewhere is a MAY."},{"type":"text","text":" "},{"type":"text","text":"It is a token to hand onward in one outbound call; adopting it would silently"},{"type":"text","text":" "},{"type":"text","text":"re-privilege every subsequent call this client makes."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A cross-tenant subject token answers ","type":"text"},{"code":"invalid_grant","type":"codeVoice"},{"text":", and this SDK does not try to","type":"text"},{"text":" ","type":"text"},{"text":"distinguish “wrong tenant” from “bad token” (§15.3): the server collapses them because","type":"text"},{"text":" ","type":"text"},{"text":"telling them apart is a tenant-enumeration signal.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"code":"POST \/oauth2\/token","type":"codeVoice"},{"type":"text","text":" with the RFC 8693 grant (§15.1)."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"title":"Sensitive","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/ExchangedToken/scope":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/axiamsdk\/exchangedtoken\/scope","role":"symbol","title":"scope","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope","abstract":[{"type":"text","text":"The scopes actually granted. Read it: §15.2 requires the server to answer with what the"},{"type":"text","text":" "},{"type":"text","text":"caller got, which may be narrower than what it asked for."}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamclient","type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/accessTokenType":{"title":"accessTokenType","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"actor_token_type"},{"type":"text","text":" this SDK sends, and the "},{"type":"co