{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tokenExchange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subjectToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"subjectTokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"actorToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]? = nil, "},{"kind":"externalParam","text":"audience"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"resource"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK14ExchangedTokenV","text":"ExchangedToken","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The token being exchanged — positional and first, because four","type":"text"},{"text":" ","type":"text"},{"text":"optional strings in positional order is a bug waiting to be written.","type":"text"}]}],"name":"subjectToken"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What kind of token "},{"type":"codeVoice","code":"subjectToken"},{"type":"text","text":" is. "},{"inlineContent":[{"type":"text","text":"Required"}],"type":"strong"},{"type":"text","text":" (§15.1), with"},{"type":"text","text":" "},{"type":"text","text":"no default: a default would be this SDK choosing which kind of credential the"},{"type":"text","text":" "},{"type":"text","text":"caller holds, which is what §15.7 forbids. Pass "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"same-domain exchange, or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType"},{"type":"text","text":" for a trusted external issuer’s JWT"},{"type":"text","text":" "},{"type":"text","text":"(§15.7). This SDK never reads "},{"type":"codeVoice","code":"subjectToken"},{"type":"text","text":" to decide the value: which kind of"},{"type":"text","text":" "},{"type":"text","text":"token the caller holds is only the caller’s to know, AXIAM refuses refresh and ID"},{"type":"text","text":" "},{"type":"text","text":"token types by name, and a refusal is never retried as a different type."}]}],"name":"subjectTokenType"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"inlineContent":[{"type":"text","text":"its presence selects delegation; its absence selects impersonation."}],"type":"strong"},{"text":" ","type":"text"},{"text":"Two different operations with different risk, and §15.2 rule 1 forbids papering over","type":"text"},{"text":" ","type":"text"},{"text":"the difference: this SDK supplies no default actor token and never substitutes its","type":"text"},{"text":" ","type":"text"},{"text":"own session for one. Passing nothing here asks for impersonation, and the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses unless this client holds that grant.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The actor token must have been issued to this client"}]},{"type":"text","text":" (§15.2 rule 9, contract"},{"type":"text","text":" "},{"type":"text","text":"1.60): obtain it with the same client’s "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginClientCredentials(scope:tenantID:configuration:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"grant and pass its "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/accessToken","isActive":true},{"type":"text","text":" here — its "},{"type":"codeVoice","code":"sub"},{"type":"text","text":" is this client’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":". A token issued to another client, a console sign-in or a service"},{"type":"text","text":" "},{"type":"text","text":"account is answered "},{"type":"codeVoice","code":"400"},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_request"},{"type":"text","text":" (“actor_token was not issued to the"},{"type":"text","text":" "},{"type":"text","text":"exchanging client”), which surfaces unchanged: not retried, not rewritten into an"},{"type":"text","text":" "},{"type":"text","text":"impersonation, and not repaired by substituting a token of this SDK’s own."}]}],"name":"actorToken"},{"content":[{"inlineContent":[{"type":"text","text":"Omit to inherit the subject’s, bounded by this client’s registration. The"},{"type":"text","text":" "},{"type":"text","text":"response’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope"},{"type":"text","text":" is what was actually granted, which may be"},{"type":"text","text":" "},{"type":"text","text":"narrower than what was asked for even on success (§15.2 rule 7) — read it."}],"type":"paragraph"}],"name":"scopes"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"What this deliberately does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" do:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No retry, downgrade or rewrite on ","type":"text"},{"code":"unauthorized_client","type":"codeVoice"}]},{"type":"text","text":" (§15.2 rule 2). It means"},{"type":"text","text":" "},{"type":"text","text":"either “this client may not exchange at all” or “this client may not impersonate”;"},{"type":"text","text":" "},{"type":"text","text":"both are registration facts an operator must fix, and reworking the request into a"},{"type":"text","text":" "},{"type":"text","text":"delegation would send one the caller did not write."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No auto-narrowing on "},{"type":"codeVoice","code":"invalid_scope"}]},{"type":"text","text":" (§15.2 rule 3). The server refuses rather than"},{"type":"text","text":" "},{"type":"text","text":"silently narrowing precisely so the caller finds out here."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No refresh token, ever"}],"type":"strong"},{"text":" (§15.2 rule 4). ","type":"text"},{"code":"TokenExchangeResponse","type":"codeVoice"},{"text":" has no such field,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","type":"reference"},{"text":" has nowhere to put one, and this result never enters the §9","type":"text"},{"text":" ","type":"text"},{"text":"single-flight refresh guard. Re-run the exchange to get a fresh token.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No adoption"}]},{"type":"text","text":" (§15.2 rule 5). The exchanged token is not this client’s session — not"},{"type":"text","text":" "},{"type":"text","text":"even behind an opt-in flag, which is a MUST NOT here where adoption elsewhere is a MAY."},{"type":"text","text":" "},{"type":"text","text":"It is a token to hand onward in one outbound call; adopting it would silently"},{"type":"text","text":" "},{"type":"text","text":"re-privilege every subsequent call this client makes."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A cross-tenant subject token answers ","type":"text"},{"type":"codeVoice","code":"invalid_grant"},{"text":", and this SDK does not try to","type":"text"},{"text":" ","type":"text"},{"text":"distinguish “wrong tenant” from “bad token” (§15.3): the server collapses them because","type":"text"},{"text":" ","type":"text"},{"text":"telling them apart is a tenant-enumeration signal.","type":"text"}]}]}],"abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"type":"text","text":" with the RFC 8693 grant (§15.1)."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/tokenexchange(subjecttoken:subjecttokentype:actortoken:scopes:audience:resource:tenantid:configuration:)"]}],"kind":"symbol","metadata":{"externalID":"s:8AxiamSDK0A6ClientC13tokenExchange12subjectToken0fG4Type05actorG06scopes8audience8resource8tenantID13configurationAA09ExchangedG0VAA9SensitiveVySSG_SSAQSgSaySSGSgSSSgA2uA17OidcConfigurationVSgtYaKF","extendedModule":"AxiamSDK","modules":[{"name":"AxiamSDK"}],"title":"tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tokenExchange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subjectToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"subjectTokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"actorToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"audience"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"resource"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK14ExchangedTokenV","text":"ExchangedToken"}],"role":"symbol"},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/accessTokenType":{"role":"symbol","kind":"symbol","type":"topic","title":"accessTokenType","url":"\/documentation\/axiamsdk\/axiamclient\/accesstokentype","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType","abstract":[{"text":"The ","type":"text"},{"code":"actor_token_type","type":"codeVoice"},{"text":" this SDK sends, and the ","type":"text"},{"code":"subject_token_type","type":"codeVoice"},{"text":" a caller names for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the same-domain exchange of §15.1. There is no default: the type is a required"},{"type":"text","text":" "},{"type":"text","text":"parameter of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/tokenExchange(subjectToken:subjectTokenType:actorToken:sco