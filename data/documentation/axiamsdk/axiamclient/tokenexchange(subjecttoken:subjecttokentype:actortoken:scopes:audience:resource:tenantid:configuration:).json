er"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","url":"\/documentation\/axiamsdk\/oidcconfiguration","role":"symbol","navigatorTitle":[{"text":"OidcConfiguration","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/accessTokenType":{"type":"topic","url":"\/documentation\/axiamsdk\/axiamclient\/accesstokentype","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"accessTokenType","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"title":"accessTokenType","kind":"symbol","abstract":[{"type":"text","text":"The "},{"code":"actor_token_type","type":"codeVoice"},{"text":" this SDK sends, and the ","type":"text"},{"code":"subject_token_type","type":"codeVoice"},{"text":" a caller names for","type":"text"},{"type":"text","text":" "},{"text":"the same-domain exchange of §15.1. There is no default: the type is a required","type":"text"},{"type":"text","text":" "},{"text":"parameter of ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/tokenExchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/jwtTokenType":{"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType","abstract":[{"text":"A JWT from a trusted external issuer — the cross-domain exchange of §15.7.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"jwtTokenType","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"title":"jwtTokenType","role":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\/jwttokentype"},"doc://AxiamSDK/documentation/AxiamSDK/OidcTokenSet/accessToken":{"url":"\/documentation\/axiamsdk\/oidctokenset\/accesstoken","abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/accessToken","title":"accessToken","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessToken","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamclient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ExchangedToken":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExchangedToken"}],"url":"\/documentation\/axiamsdk\/exchangedtoken","kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken","abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"type":"text","text":" with the RFC 8693 grant (§15.1) — a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"narrower"}]},{"text":" token.","type":"text"}],"type":"topic","title":"ExchangedToken","navigatorTitle":[{"kind":"identifier","text":"ExchangedToken"}]},"doc://AxiamSDK/documentation/AxiamSDK/ExchangedToken/scope":{"role":"symbol","title":"scope","url":"\/documentation\/axiamsdk\/exchangedtoken\/scope","kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope","abstract":[{"type":"text","text":"The scopes actually granted. Read it: §15.2 requires the server to answer with what the"},{"text":" ","type":"text"},{"text":"caller got, which may be narrower than what it asked for.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"scope"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"title":"Sensitive","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"url":"\/documentation\/axiamsdk\/sensitive","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"}}}