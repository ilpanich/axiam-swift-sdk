 Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/OidcTokenSet/accessToken":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/accessToken","title":"accessToken","role":"symbol","url":"\/documentation\/axiamsdk\/oidctokenset\/accesstoken","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessToken","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/ExchangedToken/scope":{"type":"topic","url":"\/documentation\/axiamsdk\/exchangedtoken\/scope","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scope","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"scope","abstract":[{"type":"text","text":"The scopes actually granted. Read it: §15.2 requires the server to answer with what the"},{"type":"text","text":" "},{"type":"text","text":"caller got, which may be narrower than what it asked for."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"navigatorTitle":[{"kind":"identifier","text":"AxiamClient"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamClient"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CON