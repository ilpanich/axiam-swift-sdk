Exchange(subjectToken:subjectTokenType:actorToken:scopes:audience:resource:tenantID:configuration:)","type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/accessTokenType","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessTokenType","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"title":"accessTokenType","url":"\/documentation\/axiamsdk\/axiamclient\/accesstokentype"},"doc://AxiamSDK/documentation/AxiamSDK/ExchangedToken/scope":{"type":"topic","url":"\/documentation\/axiamsdk\/exchangedtoken\/scope","title":"scope","kind":"symbol","role":"symbol","abstract":[{"text":"The scopes actually granted. Read it: §15.2 requires the server to answer with what the","type":"text"},{"text":" ","type":"text"},{"text":"caller got, which may be narrower than what it asked for.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ExchangedToken\/scope","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"scope","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/jwtTokenType":{"type":"topic","url":"\/documentation\/axiamsdk\/axiamclient\/jwttokentype","title":"jwtTokenType","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A JWT from a trusted external issuer — the cross-domain exchange of §15.7."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/jwtTokenType","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"jwtTokenType","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":