{"type":"text","text":"whose SHA-256 you gave the provider’s SDK. Sent byte for byte: not hashed, not"},{"type":"text","text":" "},{"type":"text","text":"replaced by the token’s "},{"type":"codeVoice","code":"nonce"},{"type":"text","text":" claim, and this call never generates one of its own."}]}],"name":"nonce"},{"content":[{"inlineContent":[{"type":"text","text":"Sent space-joined "},{"type":"strong","inlineContent":[{"text":"only","type":"text"}]},{"type":"text","text":" when you pass some. This SDK adds none — no"},{"type":"text","text":" "},{"type":"codeVoice","code":"openid"},{"type":"text","text":" — and an omitted "},{"type":"codeVoice","code":"scope"},{"type":"text","text":" means the empty set, so no ID token comes back."},{"type":"text","text":" "},{"type":"text","text":"Pass "},{"type":"codeVoice","code":"[\"openid\"]"},{"type":"text","text":" to receive one."}],"type":"paragraph"}],"name":"scopes"},{"content":[{"type":"paragraph","inlineContent":[{"text":"An RFC 8707 resource indicator, sent only when given.","type":"text"}]}],"name":"resource"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A tenant UUID overriding the client’s own."}]}],"name":"tenantID"},{"content":[{"inlineContent":[{"type":"text","text":"The discovery document, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to discover. Needed only to find the"},{"type":"text","text":" "},{"type":"text","text":"token endpoint; no support check is made against it (§37.8)."}],"type":"paragraph"}],"name":"configuration"}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ordinary "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet"},{"type":"text","text":". Its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/tokenType"},{"type":"text","text":" is read from the"},{"type":"text","text":" "},{"type":"text","text":"response, not assumed; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/refreshToken"},{"type":"text","text":" is present only when the client"},{"type":"text","text":" "},{"type":"text","text":"also holds "},{"code":"refresh_token","type":"codeVoice"},{"type":"text","text":"; an "},{"code":"id_token","type":"codeVoice"},{"type":"text","text":" only when "},{"code":"openid","type":"codeVoice"},{"type":"text","text":" was granted, and then it is"},{"type":"text","text":" "},{"type":"text","text":"validated under §12.4 with the "},{"inlineContent":[{"text":"raw","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"nonce","type":"codeVoice"},{"type":"text","text":" as the expected nonce. It is "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"adopted as this client’s credential — the posture of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginClientCredentials(scope:tenantID:configuration:)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/deviceLogin(scope:tenantID:configuration:onAuthorization:)"},{"type":"text","text":"."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"The form carries exactly ","type":"text"},{"type":"codeVoice","code":"grant_type"},{"text":", ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":", ","type":"text"},{"type":"codeVoice","code":"provider"},{"text":", ","type":"text"},{"type":"codeVoice","code":"id_token"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nonce"},{"text":", plus","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"scope"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"resource"},{"text":" when you pass them, plus the client’s credential when it has one","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"client_secret"},{"text":" in the body — never an ","type":"text"},{"type":"codeVoice","code":"Authorization"},{"text":" header). A public client — the","type":"text"},{"text":" ","type":"text"},{"text":"usual mobile app — sends ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":" alone and is not refused for lacking a secret.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"tenant_id"},{"text":" is the query parameter, as for every ","type":"text"},{"type":"codeVoice","code":"\/oauth2"},{"text":" call; a slug-only client is","type":"text"},{"text":" ","type":"text"},{"text":"refused here with no request (§12.3 rule 4).","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""}]},{"items":[{"content":[{"inlineContent":[{"text":"a validation ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError"},{"text":" (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError\/isValidation"},{"text":") for an empty ","type":"text"},{"code":"provider","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"idToken","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"nonce","type":"codeVoice"},{"text":" — no request sent;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"type":"text","text":" with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError\/oauthError"},{"type":"text","