:"text"},{"text":" ","type":"text"},{"text":"does not trim, fold, resolve or look it up.","type":"text"}]}]},{"name":"idToken","content":[{"inlineContent":[{"text":"The provider’s ID token. Single-use across the deployment. Never logged or","type":"text"},{"text":" ","type":"text"},{"text":"kept by this SDK.","type":"text"}],"type":"paragraph"}]},{"name":"nonce","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"text":"raw","type":"text"}]},{"type":"text","text":" nonce — what "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/nativeNonce()","type":"reference","isActive":true},{"type":"text","text":" returned in "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ProviderNonce\/raw","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose SHA-256 you gave the provider’s SDK. Sent byte for byte: not hashed, not"},{"type":"text","text":" "},{"type":"text","text":"replaced by the token’s "},{"type":"codeVoice","code":"nonce"},{"type":"text","text":" claim, and this call never generates one of its own."}]}]},{"name":"scopes","content":[{"inlineContent":[{"text":"Sent space-joined ","type":"text"},{"inlineContent":[{"text":"only","type":"text"}],"type":"strong"},{"text":" when you pass some. This SDK adds none — no","type":"text"},{"text":" ","type":"text"},{"code":"openid","type":"codeVoice"},{"text":" — and an omitted ","type":"text"},{"code":"scope","type":"codeVoice"},{"text":" means the empty set, so no ID token comes back.","type":"text"},{"text":" ","type":"text"},{"text":"Pass ","type":"text"},{"code":"[\"openid\"]","type":"codeVoice"},{"text":" to receive one.","type":"text"}],"type":"paragraph"}]},{"name":"resource","content":[{"type":"paragraph","inlineContent":[{"text":"An RFC 8707 resource indicator, sent only when given.","type":"text"}]}]},{"name":"tenantID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A tenant UUID overriding the client’s own."}]}]},{"name":"configuration","content":[{"type":"paragraph","inlineContent":[{"text":"The discovery document, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" to discover. Needed only to find the","type":"text"},{"text":" ","type":"text"},{"text":"token endpoint; no support check is made against it (§37.8).","type":"text"}]}]}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"The ordinary "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet","type":"reference","isActive":true},{"type":"text","text":". Its "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/tokenType","type":"reference","isActive":true},{"type":"text","text":" is read from the"},{"type":"text","text":" "},{"type":"text","text":"response, not assumed; "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet\/refreshToken","type":"reference","isActive":true},{"type":"text","text":" is present only when the client"},{"type":"text","text":" "},{"type":"text","text":"also holds "},{"type":"codeVoice","code":"refresh_token"},{"type":"text","text":"; an "},{"type":"codeVoice","code":"id_token"},{"type":"text","text":" only when "},{"type":"codeVoice","code":"openid"},{"type":"text","text":" was granted, and then it is"},{"type":"text","text":" "},{"type":"text","text":"validated under §12.4 with the "},{"type":"strong","inlineContent":[{"text":"raw","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"nonce"},{"type":"text","text":" as the expected nonce. It is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" "},{"type":"text","text":"adopted as this client’s credential — the posture of "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginClientCredentials(scope:tenantID:configuration:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/deviceLogin(scope:tenantID:configuration:onAuthorization:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The form carries exactly "},{"type":"codeVoice","code":"grant_type"},{"type":"text","text":", "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":", "},{"type":"codeVoice","code":"provider"},{"type":"text","text":", "},{"type":"codeVoice","code":"id_token"},{"type":"text","text":", "},{"type":"codeVoice","code":"nonce"},{"type":"text","text":", plus"},{"type":"text","text":" "},{"type":"codeVoice","code":"scope"},{"type":"text","text":" and "},{"type":"codeVoice","code":"resource"},{"type":"text","text":" when you pass them, plus the client’s credential when it has one"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"client_secret"},{"type":"text","text":" in the body — never an "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":" header). A public client — the"},{"type":"text","text":" "},{"type":"text","text":"usual mobile app — sends "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" alone and is not refused for lacking a secret."},{"type":"text","text":" "},{"type":"codeVoice","code":"tenant_id"},{"type":"text","text":" is the query parameter, as for every "},{"type":"codeVoice","code":"\/oauth2"},{"type":"text","text":" call; a slug-only client is"},{"type":"text","text":" "},{"type":"text","text":"refused here with no request (§12.3 rule 4)."}]},{"type":"aside","name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text"