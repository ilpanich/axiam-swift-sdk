ext":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV","text":"VerifiedLogoutToken"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"This is the half that carries security weight: the input arrives unsolicited, from the","type":"text"},{"text":" ","type":"text"},{"text":"network, and instructs the RP to terminate a session. Every check below is required, and","type":"text"},{"text":" ","type":"text"},{"text":"each exists because skipping it has a name:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Signature against the OP’s JWKS, through the same §12.4 verifier — no second","type":"text"},{"text":" ","type":"text"},{"text":"key-fetching path.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"iss","type":"codeVoice"},{"type":"text","text":" matches the discovery issuer; "},{"code":"aud","type":"codeVoice"},{"type":"text","text":" contains this client’s "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":". A token"},{"type":"text","text":" "},{"type":"text","text":"minted for another RP is not accepted here."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"events","type":"codeVoice"},{"type":"text","text":" contains the back-channel logout key with an object value. This is what"},{"type":"text","text":" "},{"type":"text","text":"distinguishes a logout token from an ID token; skipping it accepts a replayed ID token"},{"type":"text","text":" "},{"type":"text","text":"as a logout instruction."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"nonce"},{"text":" is ","type":"text"},{"type":"strong","inlineContent":[{"text":"absent","type":"text"}]},{"text":". Back-Channel Logout 1.0 §2.4 forbids it, and its presence is","type":"text"},{"text":" ","type":"text"},{"text":"the documented signature of an ID token being replayed — rejected, not ignored.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"At least one of ","type":"text"},{"type":"codeVoice","code":"sid"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"sub"},{"text":" is present. A token naming neither identifies nothing.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"exp"},{"type":"text","text":" is in the future and "},{"type":"codeVoice","code":"iat"},{"type":"text","text":" recent."}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"When ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/sid"},{"text":" is present, end that session only.","type":"text"}],"type":"strong"},{"text":" Falling back to","type":"text"},{"text":" ","type":"text"},{"text":"“every session for ","type":"text"},{"code":"sub","type":"codeVoice"},{"text":"” when a ","type":"text"},{"code":"sid","type":"codeVoice"},{"text":" was supplied is the same over-reach the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses to make.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/jwtID"},{"type":"text","text":" is surfaced so the caller can deduplicate; this SDK does"},{"type":"text","text":" "},{"type":"text","text":"not dedup internally (§12.7.3 rule 7) — delivery is at-least-once, and a library with no"},{"type":"text","text":" "},{"type":"text","text":"durable store would silently drop a real second logout after a restart."}]}]}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/verifyLogoutToken(_:configuration:)":{"title":"verifyLogoutToken(_:configuration:)","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"verifyLogoutToken"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","text":"OidcConfiguration"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV","kind":"typeIdentifier","text":"VerifiedLogoutToken"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/verifyLogoutToken(_:configuration:)","url":"\/documentation\/axiamsdk\/axiamclient\/verifylogouttoken(_:configuration:)","role":"symbol","kind":"symbol","abstract":[{"text":"Verify a back-channel logout token the OP POSTed to this relying party’s own endpoint","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(§12.7.3)."}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","role":"collection","type":"topic","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/Axia