{"abstract":[{"type":"text","text":"Verify a back-channel logout token the OP POSTed to this relying party’s own endpoint"},{"type":"text","text":" "},{"type":"text","text":"(§12.7.3)."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"verifyLogoutToken"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"token"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","text":"OidcConfiguration"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken","text":"VerifiedLogoutToken"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"This is the half that carries security weight: the input arrives unsolicited, from the","type":"text"},{"text":" ","type":"text"},{"text":"network, and instructs the RP to terminate a session. Every check below is required, and","type":"text"},{"text":" ","type":"text"},{"text":"each exists because skipping it has a name:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Signature against the OP’s JWKS, through the same §12.4 verifier — no second","type":"text"},{"text":" ","type":"text"},{"text":"key-fetching path.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iss"},{"type":"text","text":" matches the discovery issuer; "},{"type":"codeVoice","code":"aud"},{"type":"text","text":" contains this client’s "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":". A token"},{"type":"text","text":" "},{"type":"text","text":"minted for another RP is not accepted here."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"events"},{"text":" contains the back-channel logout key with an object value. This is what","type":"text"},{"text":" ","type":"text"},{"text":"distinguishes a logout token from an ID token; skipping it accepts a replayed ID token","type":"text"},{"text":" ","type":"text"},{"text":"as a logout instruction.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"nonce","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"absent"}]},{"text":". Back-Channel Logout 1.0 §2.4 forbids it, and its presence is","type":"text"},{"text":" ","type":"text"},{"text":"the documented signature of an ID token being replayed — rejected, not ignored.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"At least one of ","type":"text"},{"code":"sid","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sub","type":"codeVoice"},{"text":" is present. A token naming neither identifies nothing.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"exp"},{"type":"text","text":" is in the future and "},{"type":"codeVoice","code":"iat"},{"type":"text","text":" recent."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"When "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/sid"},{"type":"text","text":" is present, end that session only."}]},{"type":"text","text":" Falling back to"},{"type":"text","text":" "},{"type":"text","text":"“every session for "},{"type":"codeVoice","code":"sub"},{"type":"text","text":"” when a "},{"type":"codeVoice","code":"sid"},{"type":"text","text":" was supplied is the same over-reach the server"},{"type":"text","text":" "},{"type":"text","text":"refuses to make."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/jwtID","type":"reference"},{"text":" is surfaced so the caller can deduplicate; this SDK does","type":"text"},{"text":" ","type":"text"},{"text":"not dedup internally (§12.7.3 rule 7) — delivery is at-least-once, and a library with no","type":"text"},{"text":" ","type":"text"},{"text":"durable store would silently drop a real second logout after a restart.","type":"text"}],"type":"paragraph"}]}],"sections":[],"metadata":{"roleHeading":"Instance Method","role":"symbol","externalID":"s:8AxiamSDK0A6ClientC17verifyLogoutToken_13configurationAA08VerifiedeF0VSS_AA17OidcConfigurationVtYaKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifyLogoutToken","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV","text":"VerifiedLogoutToken","kind":"typeIdentifier"}],"symbolKind":"method","modules":[{"name":"AxiamSDK"}],"extendedModu