{"metadata":{"extendedModule":"AxiamSDK","externalID":"s:8AxiamSDK0A6ClientC17verifyLogoutToken_13configurationAA08VerifiedeF0VSS_AA17OidcConfigurationVtYaKF","title":"verifyLogoutToken(_:configuration:)","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifyLogoutToken","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","text":"OidcConfiguration"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV","kind":"typeIdentifier","text":"VerifiedLogoutToken"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifyLogoutToken","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"token","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV","text":"VerifiedLogoutToken","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"This is the half that carries security weight: the input arrives unsolicited, from the","type":"text"},{"text":" ","type":"text"},{"text":"network, and instructs the RP to terminate a session. Every check below is required, and","type":"text"},{"text":" ","type":"text"},{"text":"each exists because skipping it has a name:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Signature against the OP’s JWKS, through the same §12.4 verifier — no second","type":"text"},{"text":" ","type":"text"},{"text":"key-fetching path.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"iss"},{"type":"text","text":" matches the discovery issuer; "},{"type":"codeVoice","code":"aud"},{"type":"text","text":" contains this client’s "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":". A token"},{"type":"text","text":" "},{"type":"text","text":"minted for another RP is not accepted here."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"events"},{"type":"text","text":" contains the back-channel logout key with an object value. This is what"},{"type":"text","text":" "},{"type":"text","text":"distinguishes a logout token from an ID token; skipping it accepts a replayed ID token"},{"type":"text","text":" "},{"type":"text","text":"as a logout instruction."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"nonce"},{"text":" is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"absent"}]},{"text":". Back-Channel Logout 1.0 §2.4 forbids it, and its presence is","type":"text"},{"text":" ","type":"text"},{"text":"the documented signature of an ID token being replayed — rejected, not ignored.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"At least one of ","type":"text"},{"type":"codeVoice","code":"sid"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"sub"},{"text":" is present. A token naming neither identifies nothing.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"exp"},{"type":"text","text":" is in the future and "},{"type":"codeVoice","code":"iat"},{"type":"text","text":" recent."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"When ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/sid","isActive":true,"type":"reference"},{"text":" is present, end that session only.","type":"text"}],"type":"strong"},{"text":" Falling back to","type":"text"},{"text":" ","type":"text"},{"text":"“every session for ","type":"text"},{"type":"codeVoice","code":"sub"},{"text":"” when a ","type":"text"},{"type":"codeVoice","code":"sid"},{"text":" was supplied is the same over-reach the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses to make.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/jwtID","isActive":true},{"text":" is surfaced so the caller can deduplicate; this SDK does","type":"text"},{"text":" ","type":"text"},{"text":"not dedup internally (§12.7.3 rule 7) — delivery is at-least-once, and a library with no","type":"text"},{"text":" ","type":"text"},{"text":"durable store would silently drop a real second logout after a restart.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/verifylogouttoken(_:configuration:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Verify a back-channel logout token the OP POSTed to this relying party’s own endpoint"}