{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/verifylogouttoken(_:configuration:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifyLogoutToken","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"token","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","text":"OidcConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken","text":"VerifiedLogoutToken","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This is the half that carries security weight: the input arrives unsolicited, from the","type":"text"},{"text":" ","type":"text"},{"text":"network, and instructs the RP to terminate a session. Every check below is required, and","type":"text"},{"text":" ","type":"text"},{"text":"each exists because skipping it has a name:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Signature against the OP’s JWKS, through the same §12.4 verifier — no second","type":"text"},{"text":" ","type":"text"},{"text":"key-fetching path.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"iss","type":"codeVoice"},{"text":" matches the discovery issuer; ","type":"text"},{"code":"aud","type":"codeVoice"},{"text":" contains this client’s ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":". A token","type":"text"},{"text":" ","type":"text"},{"text":"minted for another RP is not accepted here.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"events","type":"codeVoice"},{"text":" contains the back-channel logout key with an object value. This is what","type":"text"},{"text":" ","type":"text"},{"text":"distinguishes a logout token from an ID token; skipping it accepts a replayed ID token","type":"text"},{"text":" ","type":"text"},{"text":"as a logout instruction.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"nonce","type":"codeVoice"},{"type":"text","text":" is "},{"inlineContent":[{"type":"text","text":"absent"}],"type":"strong"},{"type":"text","text":". Back-Channel Logout 1.0 §2.4 forbids it, and its presence is"},{"type":"text","text":" "},{"type":"text","text":"the documented signature of an ID token being replayed — rejected, not ignored."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"At least one of ","type":"text"},{"code":"sid","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sub","type":"codeVoice"},{"text":" is present. A token naming neither identifies nothing.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"exp"},{"type":"text","text":" is in the future and "},{"type":"codeVoice","code":"iat"},{"type":"text","text":" recent."}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"When "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/sid","isActive":true},{"type":"text","text":" is present, end that session only."}],"type":"strong"},{"text":" Falling back to","type":"text"},{"text":" ","type":"text"},{"text":"“every session for ","type":"text"},{"type":"codeVoice","code":"sub"},{"text":"” when a ","type":"text"},{"type":"codeVoice","code":"sid"},{"text":" was supplied is the same over-reach the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses to make.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/jwtID","isActive":true},{"type":"text","text":" is surfaced so the caller can deduplicate; this SDK does"},{"type":"text","text":" "},{"type":"text","text":"not dedup internally (§12.7.3 rule 7) — delivery is at-least-once, and a library with no"},{"type":"text","text":" "},{"type":"text","text":"durable store would silently drop a real second logout after a restart."}]}]}],"kind":"symbol","abstract":[{"text":"Verify a back-channel logout token the OP POSTed to this relying party’s own endpoint","type":"text"},{"text":" ","type":"text"},{"text":"(§12.7.3).","type":"text"}],"metadata":{"externalID":"s:8AxiamSDK0A6ClientC17verifyLogoutToken_13configurationAA08VerifiedeF0VSS_AA17OidcConfigurationVtYaKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifyLogoutToken","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"VerifiedLogoutToken","preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV","kind":"typeIdentifier"}],"roleHeading":"Instance Method","extendedModule":"AxiamSDK","title":"verifyLogoutT