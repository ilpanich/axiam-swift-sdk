{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"sections":[],"abstract":[{"text":"Verify a back-channel logout token the OP POSTed to this relying party’s own endpoint","type":"text"},{"text":" ","type":"text"},{"text":"(§12.7.3).","type":"text"}],"metadata":{"externalID":"s:8AxiamSDK0A6ClientC17verifyLogoutToken_13configurationAA08VerifiedeF0VSS_AA17OidcConfigurationVtYaKF","role":"symbol","extendedModule":"AxiamSDK","symbolKind":"method","title":"verifyLogoutToken(_:configuration:)","roleHeading":"Instance Method","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifyLogoutToken","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"VerifiedLogoutToken","preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"verifyLogoutToken"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"token"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","text":"OidcConfiguration"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken","text":"VerifiedLogoutToken"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"text":"This is the half that carries security weight: the input arrives unsolicited, from the","type":"text"},{"text":" ","type":"text"},{"text":"network, and instructs the RP to terminate a session. Every check below is required, and","type":"text"},{"text":" ","type":"text"},{"text":"each exists because skipping it has a name:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Signature against the OP’s JWKS, through the same §12.4 verifier — no second","type":"text"},{"text":" ","type":"text"},{"text":"key-fetching path.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"iss","type":"codeVoice"},{"text":" matches the discovery issuer; ","type":"text"},{"code":"aud","type":"codeVoice"},{"text":" contains this client’s ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":". A token","type":"text"},{"text":" ","type":"text"},{"text":"minted for another RP is not accepted here.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"events"},{"type":"text","text":" contains the back-channel logout key with an object value. This is what"},{"type":"text","text":" "},{"type":"text","text":"distinguishes a logout token from an ID token; skipping it accepts a replayed ID token"},{"type":"text","text":" "},{"type":"text","text":"as a logout instruction."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nonce"},{"text":" is ","type":"text"},{"inlineContent":[{"text":"absent","type":"text"}],"type":"strong"},{"text":". Back-Channel Logout 1.0 §2.4 forbids it, and its presence is","type":"text"},{"text":" ","type":"text"},{"text":"the documented signature of an ID token being replayed — rejected, not ignored.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"At least one of "},{"code":"sid","type":"codeVoice"},{"type":"text","text":" and "},{"code":"sub","type":"codeVoice"},{"type":"text","text":" is present. A token naming neither identifies nothing."}]}]},{"content":[{"inlineContent":[{"code":"exp","type":"codeVoice"},{"text":" is in the future and ","type":"text"},{"code":"iat","type":"codeVoice"},{"text":" recent.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"When ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/sid","isActive":true,"type":"reference"},{"text":" is present, end that session only.","type":"text"}]},{"type":"text","text":" Falling back to"},{"type":"text","text":" "},{"type":"text","text":"“every session for "},{"type":"codeVoice","code":"sub"},{"type":"text","text":"” when a "},{"type":"codeVoice","code":"sid"},{"type":"text","text":" was supplied is the same over-reach the server"},{"type":"text","text":" "},{"type":"text","text":"refuses to make."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/jwtID"},{"type":"text","text":" is surfaced so the caller can deduplicate; this SDK does"},{"type":"text","text":" "},{"type":"text","text":"not dedup internally (§12.7.3 rule 7) — delivery is at-least-once, and a library with no"},{"type":"text","text":" "},{"type":"text","text":"durable store would silently drop a real second logout after a restart."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/verifylogouttoken(_:configuration:)"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/verifyLogoutToken(_:configuration:)","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/VerifiedLogoutToken/jwtID":{"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"jwtID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"abstract":[],"url":"\/documentation\/axiamsdk\/verifiedlogouttoken\/jwtid","type":"topic","title":"jwtID","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/jwtID","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/VerifiedLogoutToken/sid":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/sid","kind":"symbol","abstract":[],"url":"\/documentation\/axiamsdk\/verifiedlogouttoken\/sid","title":"sid","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"sid"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/verifyLogoutToken(_:configuration:)":{"url":"\/documentation\/axiamsdk\/axiamclient\/verifylogouttoken(_:configuration:)","abstract":[{"type":"text","text":"Verify a back-channel logout token the OP POSTed to this relying party’s own endpoint"},{"type":"text","text":" "},{"type":"text","text":"(§12.7.3)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/verifyLogoutToken(_:configuration:)","role":"symbol","type":"topic","title":"verifyLogoutToken(_:configuration:)","fragments":[{"text