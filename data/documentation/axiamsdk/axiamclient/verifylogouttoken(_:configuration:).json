{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/verifylogouttoken(_:configuration:)"]}],"kind":"symbol","metadata":{"symbolKind":"method","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifyLogoutToken","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"VerifiedLogoutToken","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV"}],"role":"symbol","externalID":"s:8AxiamSDK0A6ClientC17verifyLogoutToken_13configurationAA08VerifiedeF0VSS_AA17OidcConfigurationVtYaKF","extendedModule":"AxiamSDK","title":"verifyLogoutToken(_:configuration:)"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/verifyLogoutToken(_:configuration:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Verify a back-channel logout token the OP POSTed to this relying party’s own endpoint"},{"type":"text","text":" "},{"type":"text","text":"(§12.7.3)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifyLogoutToken","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"token","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV","text":"VerifiedLogoutToken","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the half that carries security weight: the input arrives unsolicited, from the"},{"type":"text","text":" "},{"type":"text","text":"network, and instructs the RP to terminate a session. Every check below is required, and"},{"type":"text","text":" "},{"type":"text","text":"each exists because skipping it has a name:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Signature against the OP’s JWKS, through the same §12.4 verifier — no second"},{"type":"text","text":" "},{"type":"text","text":"key-fetching path."}]}]},{"content":[{"inlineContent":[{"code":"iss","type":"codeVoice"},{"type":"text","text":" matches the discovery issuer; "},{"code":"aud","type":"codeVoice"},{"type":"text","text":" contains this client’s "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":". A token"},{"type":"text","text":" "},{"type":"text","text":"minted for another RP is not accepted here."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"events"},{"type":"text","text":" contains the back-channel logout key with an object value. This is what"},{"type":"text","text":" "},{"type":"text","text":"distinguishes a logout token from an ID token; skipping it accepts a replayed ID token"},{"type":"text","text":" "},{"type":"text","text":"as a logout instruction."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"nonce","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"text":"absent","type":"text"}],"type":"strong"},{"text":". Back-Channel Logout 1.0 §2.4 forbids it, and its presence is","type":"text"},{"text":" ","type":"text"},{"text":"the documented signature of an ID token being replayed — rejected, not ignored.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"At least one of ","type":"text"},{"type":"codeVoice","code":"sid"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"sub"},{"text":" is present. A token naming neither identifies nothing.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"exp","type":"codeVoice"},{"text":" is in the future and ","type":"text"},{"code":"iat","type":"codeVoice"},{"text":" recent.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"When "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/sid","isActive":true},{"type":"text","text":" is present, end that session only."}],"type":"strong"},{"text":" Falling back to","type":"text"},{"text":" ","type":"text"},{"text":"“every session for ","type":"text"},{"code":"sub","type":"codeVoice"},{"text":"” when a ","type":"text"},{"code":"sid","type":"codeVoice"},{"text":" was supplied is the same over-reach the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses to make.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/jwtID"},{"type":"text","text":" is surfaced so the caller can deduplicate; this SDK does"},{"type":"text","text":" "},{"type":"text","text":"not dedup internally (§12.7.3 rule 7) — delivery is at-least-once, and a library with no"},{"type":"text","text":" "},{"type":"text","text":"durable store would silently drop a real second logout after a restart."}]}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/VerifiedLogoutToken/jwtID":{"type":"topic","role":"symbol","abstract":[],"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"jwtID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/jwtID","title":"jwtID","url":"\/documentation\/axiamsdk\/verifiedlogouttoken\/jwtid"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"url":"\/documentation\/axiamsdk\/axiamclient","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamClient"}],"navigatorTitle":[{"kind":"identifier","text":"AxiamClient"}]},"doc://AxiamSDK/documentation/AxiamSDK/VerifiedLogoutToken":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VerifiedLogoutToken","kind":"identifier"}],"type":"topic","title":"VerifiedLogoutToken","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken","kind":"symbol","navigatorTitle":[{"text":"VerifiedLogoutToken","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/verifiedlogouttoken","abstract":[{"type":"text","text":"A verified back-channel logout token (§12.7.3)."}],"role":"symbol"},"doc://AxiamSDK/documentation/Ax