{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Verify a back-channel logout token the OP POSTed to this relying party’s own endpoint","type":"text"},{"text":" ","type":"text"},{"text":"(§12.7.3).","type":"text"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/verifyLogoutToken(_:configuration:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Method","modules":[{"name":"AxiamSDK"}],"symbolKind":"method","externalID":"s:8AxiamSDK0A6ClientC17verifyLogoutToken_13configurationAA08VerifiedeF0VSS_AA17OidcConfigurationVtYaKF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"verifyLogoutToken"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","text":"OidcConfiguration"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV","kind":"typeIdentifier","text":"VerifiedLogoutToken"}],"extendedModule":"AxiamSDK","role":"symbol","title":"verifyLogoutToken(_:configuration:)"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"verifyLogoutToken"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"token"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","kind":"typeIdentifier","text":"OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken","kind":"typeIdentifier","text":"VerifiedLogoutToken","preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"This is the half that carries security weight: the input arrives unsolicited, from the"},{"type":"text","text":" "},{"type":"text","text":"network, and instructs the RP to terminate a session. Every check below is required, and"},{"type":"text","text":" "},{"type":"text","text":"each exists because skipping it has a name:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Signature against the OP’s JWKS, through the same §12.4 verifier — no second","type":"text"},{"text":" ","type":"text"},{"text":"key-fetching path.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iss"},{"type":"text","text":" matches the discovery issuer; "},{"type":"codeVoice","code":"aud"},{"type":"text","text":" contains this client’s "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":". A token"},{"type":"text","text":" "},{"type":"text","text":"minted for another RP is not accepted here."}]}]},{"content":[{"inlineContent":[{"code":"events","type":"codeVoice"},{"text":" contains the back-channel logout key with an object value. This is what","type":"text"},{"text":" ","type":"text"},{"text":"distinguishes a logout token from an ID token; skipping it accepts a replayed ID token","type":"text"},{"text":" ","type":"text"},{"text":"as a logout instruction.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"nonce"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"type":"text","text":"absent"}]},{"type":"text","text":". Back-Channel Logout 1.0 §2.4 forbids it, and its presence is"},{"type":"text","text":" "},{"type":"text","text":"the documented signature of an ID token being replayed — rejected, not ignored."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"At least one of "},{"code":"sid","type":"codeVoice"},{"type":"text","text":" and "},{"code":"sub","type":"codeVoice"},{"type":"text","text":" is present. A token naming neither identifies nothing."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"exp"},{"type":"text","text":" is in the future and "},{"type":"codeVoice","code":"iat"},{"type":"text","text":" recent."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"When ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/sid","isActive":true,"type":"reference"},{"text":" is present, end that session only.","type":"text"}]},{"text":" Falling back to","type":"text"},{"text":" ","type":"text"},{"text":"“every session for ","type":"text"},{"code":"sub","type":"codeVoice"},{"text":"” when a ","type":"text"},{"code":"sid","type":"codeVoice"},{"text":" was supplied is the same over-reach the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses to make.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/jwtID","type":"reference","isActive":true},{"text":" is surfaced so the caller can deduplicate; this SDK does","type":"text"},{"text":" ","type":"text"},{"text":"not dedup internally (§12.7.3 rule 7) — delivery is at-least-once, and a library with no","type":"text"},{"text":" ","type":"text"},{"text":"durable store would silently drop a real second logout after a restart.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/verifylogouttoken(_:configuration:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/verifyLogoutToken(_:configuration:)":{"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/axiamclient\/verifylogouttoken(_:configuration:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifyLogoutToken","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"text":"VerifiedLogoutToken","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/verifyLogoutToken(_:configuration:)","abstract":[{"text":"Verify a back-channel logout token the OP POSTed to this relying party’s own endpoint","type":"text"},{"text":" ","type":"text"},{"text":"(§12.7.3).","type":"text"}],"title":"verifyLogoutToken(_:configuration:)","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/VerifiedLogoutToken/jwtID":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"jwtID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"role":"symbol","title":"jwtID","abstract":[],"url":"\/documentation\/axiamsdk\/verifiedlogouttoken\/jwtid","kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/jwtID"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamclient","type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcConfiguration":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OidcConfiguration","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","url":"\/documentation\/axiamsdk\/oidcconfiguration","kind":"symbol","type":"topic","title":"OidcConfiguration","abstract":[{"type":"text","text":"The OIDC discovery document (§12.1), read from "},{"type":"codeVoice","code":"\/.well-known\/openid-configuration"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"OidcConfiguration","kind":"identifier"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/VerifiedLogoutToken/sid":{"fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"sid","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"url":"\/documentation\/axiamsdk\/verifiedlogouttoken\/sid","role":