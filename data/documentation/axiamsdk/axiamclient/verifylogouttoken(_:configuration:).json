ext"},{"code":"aud","type":"codeVoice"},{"text":" contains this client’s ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":". A token","type":"text"},{"text":" ","type":"text"},{"text":"minted for another RP is not accepted here.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"events","type":"codeVoice"},{"text":" contains the back-channel logout key with an object value. This is what","type":"text"},{"text":" ","type":"text"},{"text":"distinguishes a logout token from an ID token; skipping it accepts a replayed ID token","type":"text"},{"text":" ","type":"text"},{"text":"as a logout instruction.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"nonce","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"text":"absent","type":"text"}],"type":"strong"},{"text":". Back-Channel Logout 1.0 §2.4 forbids it, and its presence is","type":"text"},{"text":" ","type":"text"},{"text":"the documented signature of an ID token being replayed — rejected, not ignored.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"At least one of ","type":"text"},{"code":"sid","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sub","type":"codeVoice"},{"text":" is present. A token naming neither identifies nothing.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"exp"},{"type":"text","text":" is in the future and "},{"type":"codeVoice","code":"iat"},{"type":"text","text":" recent."}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"When "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/sid","isActive":true,"type":"reference"},{"type":"text","text":" is present, end that session only."}],"type":"strong"},{"text":" Falling back to","type":"text"},{"text":" ","type":"text"},{"text":"“every session for ","type":"text"},{"code":"sub","type":"codeVoice"},{"text":"” when a ","type":"text"},{"code":"sid","type":"codeVoice"},{"text":" was supplied is the same over-reach the server","type":"text"},{"text":" ","type":"text"},{"text":"refuses to make.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/jwtID"},{"type":"text","text":" is surfaced so the caller can deduplicate; this SDK does"},{"type":"text","text":" "},{"type":"text","text":"not dedup internally (§12.7.3 rule 7) — delivery is at-least-once, and a library with no"},{"type":"text","text":" "},{"type":"text","text":"durable store would silently drop a real second logout after a restart."}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/verifyLogoutToken(_:configuration:)"},"abstract":[{"text":"Verify a back-channel logout token the OP POSTed to this relying party’s own endpoint","type":"text"},{"text":" ","type":"text"},{"text":"(§12.7.3).","type":"text"}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifyLogoutToken","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"VerifiedLogoutToken","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK19VerifiedLogoutTokenV"}],"extendedModule":"AxiamSDK","title":"verifyLogoutToken(_:configuration:)",