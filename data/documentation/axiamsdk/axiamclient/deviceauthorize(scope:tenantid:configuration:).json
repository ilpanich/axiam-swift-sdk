{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deviceAuthorize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"DeviceAuthorization","preciseIdentifier":"s:8AxiamSDK19DeviceAuthorizationV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeviceAuthorization"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Authenticates the client by what it was configured with"}],"type":"strong"},{"text":" (§14.1 rule 2, contract 1.62):","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"public"}]},{"text":" client — the usual device, which cannot hold a secret — is constructed","type":"text"},{"text":" ","type":"text"},{"text":"without ","type":"text"},{"type":"codeVoice","code":"oidcClientSecret"},{"text":" and without a client certificate. Only ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":" goes out,","type":"text"},{"text":" ","type":"text"},{"text":"and this call is never refused client-side for lacking a credential (§14.1 rule 1).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A client with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/oidcClientSecret"},{"type":"text","text":" sends it as "},{"type":"codeVoice","code":"client_secret"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"in the"},{"type":"text","text":" "},{"type":"text","text":"form body"}],"type":"strong"},{"type":"text","text":", exactly as at "},{"type":"codeVoice","code":"\/oauth2\/token"},{"type":"text","text":", whichever of "},{"type":"codeVoice","code":"client_secret_post"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_secret_basic"},{"type":"text","text":" it is registered for. "},{"inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"Authorization: Basic"},{"type":"text","text":" header is ever"},{"type":"text","text":" "},{"type":"text","text":"sent"}],"type":"strong"},{"type":"text","text":" (§12.1 rule 3 stands for this route; the server accepts either form)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A client with a §6.1 client certificate presents it on the connection, and the request","type":"text"},{"text":" ","type":"text"},{"text":"goes to the ","type":"text"},{"type":"codeVoice","code":"mtls_endpoint_aliases"},{"text":" entry when the document publishes one (§21.3 rule 2).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A credential goes out only when the caller configured one: this never borrows a secret"},{"type":"text","text":" "},{"type":"text","text":"from another configuration and never invents one. A "},{"code":"401","type":"codeVoice"},{"type":"text","text":" "},{"code":"invalid_client","type":"codeVoice"},{"type":"text","text":" — an unknown"},{"type":"text","text":" "},{"type":"text","text":"client, a failed or missing credential, a credential sent by a public client — throws an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","isActive":true},{"type":"text","text":" whose "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError\/oauthError","isActive":true},{"type":"text","text":" is "},{"code":"invalid_client","type":"codeVoice"},{"type":"text","text":", after exactly one"},{"type":"text","text":" "},{"type":"text","text":"request, and never enters the §9 refresh guard (§14.2 rule 5). This SDK does not"},{"type":"text","text":" "},{"type":"text","text":"generate "},{"code":"private_key_jwt","type":"codeVoice"},{"type":"text","text":" assertions (§21.8), so there is no assertion form to send."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:8AxiamSDK0A6ClientC15deviceAuthorize5scope8tenantID13configurationAA19DeviceAuthorizationVSSSg_AjA17OidcConfigurationVSgtYaKF","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deviceAuthorize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfiguratio