:"invalid_client"},{"type":"text","text":" — an unknown"},{"type":"text","text":" "},{"type":"text","text":"client, a failed or missing credential, a credential sent by a public client — throws an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","isActive":true},{"type":"text","text":" whose "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError\/oauthError","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"invalid_client"},{"type":"text","text":", after exactly one"},{"type":"text","text":" "},{"type":"text","text":"request, and never enters the §9 refresh guard (§14.2 rule 5). This SDK does not"},{"type":"text","text":" "},{"type":"text","text":"generate "},{"type":"codeVoice","code":"private_key_jwt"},{"type":"text","text":" assertions (§21.8), so there is no assertion form to send."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/deviceAuthorize(scope:tenantID:configuration:)"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"code":"POST \/oauth2\/device_authorization","type":"codeVoice"},{"text":" (§14.1) — start the grant.","type":"text"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/deviceauthorize(scope:tenantid:configuration:)"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"metadata":{"externalID":"s:8AxiamSDK0A6ClientC15deviceAuthorize5scope8tenantID13configurationAA19DeviceAuthorizationVSSSg_AjA17OidcConfigurationVSgtYaKF","roleHeading":"Instance Method","role":"symbol","symbolKind":"method","modules":[{"name":"AxiamSDK"}],"extendedModule":"AxiamSDK","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deviceAuthorize","kind":"identifier"},{"text":"(","kind