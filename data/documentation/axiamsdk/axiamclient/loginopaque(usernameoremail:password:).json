{"kind":"symbol","metadata":{"modules":[{"name":"AxiamSDK"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loginOpaque"},{"kind":"text","text":"("},{"kind":"externalParam","text":"usernameOrEmail"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"LoginResult","preciseIdentifier":"s:8AxiamSDK11LoginResultO"}],"externalID":"s:8AxiamSDK0A6ClientC11loginOpaque15usernameOrEmail8passwordAA11LoginResultOSS_SStYaKF","symbolKind":"method","role":"symbol","title":"loginOpaque(usernameOrEmail:password:)","roleHeading":"Instance Method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loginOpaque"},{"kind":"text","text":"("},{"kind":"externalParam","text":"usernameOrEmail"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK11LoginResultO","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult","text":"LoginResult"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"A sibling of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)"},{"text":", not a replacement. It takes the same arguments and","type":"text"},{"text":" ","type":"text"},{"text":"returns the same ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult"},{"text":", MFA branch included, so an application can switch a","type":"text"},{"text":" ","type":"text"},{"text":"tenant to OPAQUE without touching its own code.","type":"text"}]},{"level":2,"anchor":"What-this-does-that-login-does-not","text":"What this does that `login` does not","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The password never leaves this process. What crosses the wire is a blinded group element"},{"type":"text","text":" "},{"type":"text","text":"and a MAC, neither useful without the account’s registration record "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" the tenant’s OPRF"},{"type":"text","text":" "},{"type":"text","text":"seed — so a TLS-terminating proxy, an accidentally verbose request log, or a heap dump on"},{"type":"text","text":" "},{"type":"text","text":"the server cannot capture a plaintext password, because the server never has one. It also"},{"type":"text","text":" "},{"type":"text","text":"means a stolen record database is not offline-crackable on its own, which is the"},{"type":"text","text":" "},{"type":"text","text":"pre-computation resistance SRP could not offer. It does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" protect against a"},{"type":"text","text":" "},{"type":"text","text":"compromised AXIAM server."}]},{"level":2,"anchor":"Swift-no-longer-needs-a-pbkdf2sha256-tenant","text":"Swift no longer needs a `pbkdf2_sha256` tenant","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SRP client this replaces refused an "},{"type":"codeVoice","code":"argon2id"},{"type":"text","text":" tenant outright — Swift has no Argon2"},{"type":"text","text":" "},{"type":"text","text":"that ships on every supported platform, and substituting PBKDF2 would have derived a"},{"type":"text","text":" "},{"type":"text","text":"different "},{"type":"codeVoice","code":"x"},{"type":"text","text":" and surfaced as “invalid password”. AXIAM’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":" KDF was, for Swift,"},{"type":"text","text":" "},{"type":"text","text":"unreachable. The key stretching now happens inside "},{"type":"codeVoice","code":"libaxiam_opaque_ffi"},{"type":"text","text":", so the only"},{"type":"text","text":" "},{"type":"text","text":"remaining condition is having that library, which "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueAvailable()","isActive":true},{"type":"text","text":" reports."}]},{"level":2,"anchor":"One-round-trip-and-no-server-proof-step","text":"One round trip, and no server-proof step","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"SRP had to guess a group before the server named one and restart the exchange if it guessed","type":"text"},{"text":" ","type":"text"},{"text":"wrong; ","type":"text"},{"type":"codeVoice","code":"KE1"},{"text":" does not depend on the key-stretching function. And where the old §23.3 rule 6","type":"text"},{"text":" ","type":"text"},{"text":"had to mandate an ","type":"text"},{"type":"codeVoice","code":"M2"},{"text":" check in capitals — because skipping it kept only half the protocol","type":"text"},{"text":" ","type":"text"},{"text":"— RFC 9807’s AKE authenticates the server during the handshake, so opening ","type":"text"},{"type":"codeVoice","code":"KE2"},{"text":" ","type":"text"},{"inlineContent":[{"text":"is","type":"text"}],"type":"emphasis"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"proof that it holds the record.","type":"text"}]},{"level":2,"anchor":"Cost","text":"Cost","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Runs the tenant’s key-stretching function: Argon2id at 19 MiB and t=2 by default, tens to"},{"type":"text","text":" "},{"type":"text","text":"hundreds of milliseconds of CPU plus that memory. That cost is the point — it is what makes"},{"type":"text","text":" "},{"type":"text","text":"a stolen record expensive to attack even by someone holding the OPRF seed. It runs on the"},{"type":"text","text":" "},{"type":"text","text":"calling task rather than a shared executor."}]},{"level":2,"anchor":"When-KE2-does-not-open-mode-decides-what-happens-next","text":"When `KE2` does not open, `mode` decides what happens next","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"login\/start"},{"text":" response carries the tenant’s ","type":"text"},{"type":"codeVoice","code":"opaque_mode"},{"text":", and §23.4 rule 7 branches on","type":"text"},{"text":" ","type":"text"},{"text":"it and on nothing else:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optional"},{"type":"text","text":" — this method "},{"type":"strong","inlineContent":[{"text":"retries over ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","isActive":true}]},{"type":"text","text":" with the same"},{"type":"text","text":" "},{"type":"text","text":"credentials and returns that call’s outcome, before reporting any failure. "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"the mid-migration state: every account has no OPAQUE record the moment an operator"},{"type":"text","text":" "},{"type":"text","text":"enables it, and acquires one only when its password is next set, so treating the failed"},{"type":"text","text":" "},{"type":"text","text":"exchange as final would lock out every user of the tenant."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"required"},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"type":"text","text":"and a response with no "},{"type":"codeVoice","code":"mode"},{"type":"text","text":" field at all"}]},{"type":"text","text":" (a server older than the"},{"type":"text","text":" "},{"type":"text","text":"field), and any value this SDK does not recognise — "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true},{"type":"text","text":", the exchange"},{"type":"text","text":" "},{"type":"text","text":"is over, and nothing is retried. Failing closed is the default."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"mode"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" downgrade protection: a hostile server that wanted the plaintext could"},{"type":"text","text":" "},{"type":"text","text":"answer "},{"type":"codeVoice","code":"404"},{"type":"text","text":" and get a caller’s fallback whatever it puts here. What closes that is"},{"type":"text","text":" "},{"type":"codeVoice","code":"required"},{"type":"text","text":" server-side, which refuses "},{"type":"codeVoice","code":"\/auth\/login"},{"type":"text","text":" for every principal before examining"},{"type":"text","text":" "},{"type":"text","text":"any credential."}]},{"content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","type":"reference","isActive":true},{"text":" when the tenant has OPAQUE disabled (the endpoint","type":"text"},{"text":" ","type":"text"},{"text":"answers ","type":"text"},{"code":"404","type":"codeVoice"},{"text":" — a property of the tenant, not of any user), when ","type":"text"},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"not installed, and when the server names a key-stretching function this SDK cannot ask","type":"text"},{"text":" ","type":"text"},{"text":"for. Deliberately not ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"text":": reporting a configuration gap as a","type":"text"},{"text":" ","type":"text"},{"text":"credential failure would send a user off to reset a password that works, and would stop a","type":"text"},{"text":" ","type":"text"},{"text":"caller falling back to ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","name":"Throws","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"text":" for a wrong password, an account that does not exist, an","type":"text"},{"text":" ","type":"text"},{"text":"account with no registration record, and a server that does not hold the record —","type":"text"},{"text":" ","type":"text"},{"text":"indistinguishable by design. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Nothing is sent to "},{"type":"codeVoice","code":"login\/finish"},{"type":"text","text":" in that case"}]},{"text":" ","type":"text"},{"text":"(§23.4 rule 7). A caller must not retry it over ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","type":"reference","isActive":true},{"text":" by hand: under","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"optional"},{"text":" this method has already done so (see above), and under ","type":"text"},{"type":"codeVoice","code":"required"},{"text":" the retry is","type":"text"},{"text":" ","type":"text"},{"text":"refused anyway and would put a plaintext password on the wire for nothing.","type":"text"}]}],"style":"note","name":"Throws","type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/loginopaque(usernameoremail:password:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginOpaque(usernameOrEmail:password:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/auth\/opaque\/login\/start"},{"text":" then ","type":"text"},{"code":"\/finish","type":"codeVoice"},{"text":" — OPAQUE login, RFC 9807","type":"text"},{"text":" ","type":"text"},{"text":"(CONTRACT.md §23).","type":"text"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/loginOpaque(usernameOrEmail:password:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"loginOpaque"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"usernameOrEmail"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"kind":"text","text":") "},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK11LoginResultO","text":"LoginResult","kind":"typeIdentifier"}],"url":"\/documentation\/axiamsdk\/axiamclient\/loginopaque(usernameoremail:password:)","title":"loginOpaque(usernameOrEmail:password:)","kind":"symbol","abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/auth\/opaque\/login\/start"},{"type":"text","text":" then "},{"type":"codeVoice","code":"\/finish"},{"text":" — OPAQUE login, RFC 9807","type":"text"},{"type":"text","text":" "},{"text":"(CONTRACT.md §23).","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginOpaque(usernameOrEmail:password:)","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/login(email:password:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"login","kind":"identifier"},{"text":"(","kind":"text"},{"text":"email","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"LoginResult","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK11LoginResultO"}],"type":"topic","url":"\/documentation\/axiamsdk\/axiamclient\/login(email:password:)","role":"symbol","title":"login(email:password:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","abstract":[{"text":"Authenticate with email\/username + password (§1 ","type":"text"},{"code":"login","type":"codeVoice"},{"text":").","type":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/auth(_:)":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","title":"AxiamError.auth(_:)","abstract":[{"text":"Authentication failure: wrong credentials, expired session, MFA failure,","type":"text"},{"text":" ","type":"text"},{"text":"or a 401 on the refresh call itself.","type":"text"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/axiamerror\/auth(_:)","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"auth","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AuthError","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9AuthErrorV"},{"text":")","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamclient","type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/LoginResult":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult","kind":"symbol","url":"\/documentation\/axiamsdk\/loginresult","title":"LoginResult","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoginResult","kind":"identifier"}],"navigatorTitle":[{"text":"LoginResult","kind":"identifier"}],"abstract":[{"type":"text","text":"Outcome of "},{"type":"codeVoice","code":"login"},{"text":" (§1). Tokens are delivered out-of-band via ","type":"text"},{"type":"codeVoice","code":"httpOnly"},{"text":" cookies, so no","type":"text"},{"text":" ","type":"text"},{"text":"token material appears here.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/opaqueAvailable()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueAvailable","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"url":"\/documentation\/axiamsdk\/axiamclient\/opaqueavailable()","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueAvailable()","title":"opaqueAvailable()","abstract":[{"type":"text","text":"Whether this installation can perform OPAQUE (§23.2)."}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/network(_:)":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","title":"AxiamError.network(_:)","abstract":[{"text":"Transport-level failure: connection refused, timeout, TLS error, DNS failure,","type":"text"},{"text":" ","type":"text"},{"text":"malformed request, server (5xx) error.","type":"text"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/axiamerror\/network(_:)","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"network","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NetworkError","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12NetworkErrorV"},{"text":")","kind":"text"}]}}}