{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginOpaque(usernameOrEmail:password:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/loginopaque(usernameoremail:password:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/auth\/opaque\/login\/start"},{"type":"text","text":" then "},{"type":"codeVoice","code":"\/finish"},{"type":"text","text":" — OPAQUE login, RFC 9807"},{"type":"text","text":" "},{"type":"text","text":"(CONTRACT.md §23)."}],"metadata":{"externalID":"s:8AxiamSDK0A6ClientC11loginOpaque15usernameOrEmail8passwordAA11LoginResultOSS_SStYaKF","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loginOpaque","kind":"identifier"},{"text":"(","kind":"text"},{"text":"usernameOrEmail","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"LoginResult","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK11LoginResultO"}],"title":"loginOpaque(usernameOrEmail:password:)","modules":[{"name":"AxiamSDK"}],"role":"symbol"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loginOpaque"},{"kind":"text","text":"("},{"kind":"externalParam","text":"usernameOrEmail"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult","kind":"typeIdentifier","text":"LoginResult","preciseIdentifier":"s:8AxiamSDK11LoginResultO"}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A sibling of "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","type":"reference","isActive":true},{"type":"text","text":", not a replacement. It takes the same arguments and"},{"type":"text","text":" "},{"type":"text","text":"returns the same "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult","type":"reference","isActive":true},{"type":"text","text":", MFA branch included, so an application can switch a"},{"type":"text","text":" "},{"type":"text","text":"tenant to OPAQUE without touching its own code."}],"type":"paragraph"},{"level":2,"type":"heading","text":"What this does that `login` does not","anchor":"What-this-does-that-login-does-not"},{"inlineContent":[{"text":"The password never leaves this process. What crosses the wire is a blinded group element","type":"text"},{"text":" ","type":"text"},{"text":"and a MAC, neither useful without the account’s registration record ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" the tenant’s OPRF","type":"text"},{"text":" ","type":"text"},{"text":"seed — so a TLS-terminating proxy, an accidentally verbose request log, or a heap dump on","type":"text"},{"text":" ","type":"text"},{"text":"the server cannot capture a plaintext password, because the server never has one. It also","type":"text"},{"text":" ","type":"text"},{"text":"means a stolen record database is not offline-crackable on its own, which is the","type":"text"},{"text":" ","type":"text"},{"text":"pre-computation resistance SRP could not offer. It does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" protect against a","type":"text"},{"text":" ","type":"text"},{"text":"compromised AXIAM server.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Swift no longer needs a `pbkdf2_sha256` tenant","anchor":"Swift-no-longer-needs-a-pbkdf2sha256-tenant"},{"inlineContent":[{"text":"The SRP client this replaces refused an ","type":"text"},{"code":"argon2id","type":"codeVoice"},{"text":" tenant outright — Swift has no Argon2","type":"text"},{"text":" ","type":"text"},{"text":"that ships on every supported platform, and substituting PBKDF2 would have derived a","type":"text"},{"text":" ","type":"text"},{"text":"different ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" and surfaced as “invalid password”. AXIAM’s ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"text":" KDF was, for Swift,","type":"text"},{"text":" ","type":"text"},{"text":"unreachable. The key stretching now happens inside ","type":"text"},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"text":", so the only","type":"text"},{"text":" ","type":"text"},{"text":"remaining condition is having that library, which ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueAvailable()","isActive":true,"type":"reference"},{"text":" reports.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"One round trip, and no server-proof step","anchor":"One-round-trip-and-no-server-proof-step"},{"inlineContent":[{"type":"text","text":"SRP had to guess a group before the server named one and restart the exchange if it guessed"},{"type":"text","text":" "},{"type":"text","text":"wrong; "},{"code":"KE1","type":"codeVoice"},{"type":"text","text":" does not depend on the key-stretching function. And where the old §23.3 rule 6"},{"type":"text","text":" "},{"type":"text","text":"had to mandate an "},{"code":"M2","type":"codeVoice"},{"type":"text","text":" check in capitals — because skipping it kept only half the protocol"},{"type":"text","text":" "},{"type":"text","text":"— RFC 9807’s AKE authenticates the server during the handshake, so opening "},{"code":"KE2","type":"codeVoice"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"is","type":"text"}]},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"proof that it holds the record."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Cost","anchor":"Cost"},{"inlineContent":[{"text":"Runs the tenant’s key-stretching function: Argon2id at 19 MiB and t=2 by default, tens to","type":"text"},{"text":" ","type":"text"},{"text":"hundreds of milliseconds of CPU plus that memory. That cost is the point — it is what makes","type":"text"},{"text":" ","type":"text"},{"text":"a stolen record expensive to attack even by someone holding the OPRF seed. It runs on the","type":"text"},{"text":" ","type":"text"},{"text":"calling task rather than a shared executor.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"When `KE2` does not open, `mode` decides what happens next","anchor":"When-KE2-does-not-open-mode-decides-what-happens-next"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"login\/start"},{"type":"text","text":" response carries the tenant’s "},{"type":"codeVoice","code":"opaque_mode"},{"type":"text","text":", and §23.4 rule 7 branches on"},{"type":"text","text":" "},{"type":"text","text":"it and on nothing else:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optional"},{"text":" — this method ","type":"text"},{"inlineContent":[{"text":"retries over ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)"}],"type":"strong"},{"text":" with the same","type":"text"},{"text":" ","type":"text"},{"text":"credentials and returns that call’s outcome, before reporting any failure. ","type":"text"},{"type":"codeVoice","code":"optional"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"the mid-migration state: every account has no OPAQUE record the moment an operator","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"enables it, and acquires one only when its password is next set, so treating the failed"},{"type":"text","text":" "},{"type":"text","text":"exchange as final would lock out every user of the tenant."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"required"},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"text":"and a response with no ","type":"text"},{"code":"mode","type":"codeVoice"},{"text":" field at all","type":"text"}]},{"type":"text","text":" (a server older than the"},{"type":"text","text":" "},{"type":"text","text":"field), and any value this SDK does not recognise — "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true},{"type":"text","text":", the exchange"},{"type":"text","text":" "},{"type":"text","text":"is over, and nothing is retried. Failing closed is the default."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"mode"},{"text":" is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" downgrade protection: a hostile server that wanted the plaintext could","type":"text"},{"text":" ","type":"text"},{"text":"answer ","type":"text"},{"type":"codeVoice","code":"404"},{"text":" and get a caller’s fallback whatever it puts here. What closes that is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"required"},{"text":" server-side, which refuses ","type":"text"},{"type":"codeVoice","code":"\/auth\/login"},{"text":" for every principal before examining","type":"text"},{"text":" ","type":"text"},{"text":"any credential.","type":"text"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},{"text":" when the tenant has OPAQUE disabled (the endpoint","type":"text"},{"text":" ","type":"text"},{"text":"answers ","type":"text"},{"code":"404","type":"codeVoice"},{"text":" — a property of the tenant, not of any user), when ","type":"text"},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"not installed, and when the server names a key-stretching function this SDK cannot ask","type":"text"},{"text":" ","type":"text"},{"text":"for. Deliberately not ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"text":": reporting a configuration gap as a","type":"text"},{"text":" ","type":"text"},{"text":"credential failure would send a user off to reset a password that works, and would stop a","type":"text"},{"text":" ","type":"text"},{"text":"caller falling back to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)"},{"text":".","type":"text"}]}]},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"text":" for a wrong password, an account that does not exist, an","type":"text"},{"text":" ","type":"text"},{"text":"account with no registration record, and a server that does not hold the record —","type":"text"},{"text":" ","type":"text"},{"text":"indistinguishable by design. ","type":"text"},{"inlineContent":[{"text":"Nothing is sent to ","type":"text"},{"code":"login\/finish","type":"codeVoice"},{"text":" in that case","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"(§23.4 rule 7). A caller must not retry it over ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)"},{"text":" by hand: under","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"optional"},{"text":" this method has already done so (see above), and under ","type":"text"},{"type":"codeVoice","code":"required"},{"text":" the retry is","type":"text"},{"text":" ","type":"text"},{"text":"refused anyway and would put a plaintext password on the wire for nothing.","type":"text"}]}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/loginOpaque(usernameOrEmail:password:)":{"type":"topic","title":"loginOpaque(usernameOrEmail:password:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loginOpaque","kind":"identifier"},{"text":"(","kind":"text"},{"text":"usernameOrEmail","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK11LoginResultO","kind":"typeIdentifier","text":"LoginResult"}],"url":"\/documentation\/axiamsdk\/axiamclient\/loginopaque(usernameoremail:password:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginOpaque(usernameOrEmail:password:)","kind":"symbol","abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/auth\/opaque\/login\/start"},{"text":" then ","type":"text"},{"type":"codeVoice","code":"\/finish"},{"text":" — OPAQUE login, RFC 9807","type":"text"},{"text":" ","type":"text"},{"text":"(CONTRACT.md §23).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"type":"topic","title":"AxiamClient","abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}],"url":"\/documentation\/axiamsdk\/axiamclient","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/network(_:)":{"title":"AxiamError.network(_:)","url":"\/documentation\/axiamsdk\/axiamerror\/network(_:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"network"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8AxiamSDK12NetworkErrorV","kind":"typeIdentifier","text":"NetworkError"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Transport-level failure: connection refused, timeout, TLS error, DNS failure,"},{"type":"text","text":" "},{"type":"text","text":"malformed request, server (5xx) error."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/opaqueAvailable()":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueAvailable()","kind":"symbol","abstract":[{"text":"Whether this installation can perform OPAQUE (§23.2).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"opaqueAvailable"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"url":"\/documentation\/axiamsdk\/axiamclient\/opaqueavailable()","role":"symbol","title":"opaqueAvailable()"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/auth(_:)":{"kind":"symbol","abstract":[{"text":"Authentication failure: wrong credentials, expired session, MFA failure,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"or a 401 on the refresh call itself."}],"type":"topic","url":"\/documentation\/axiamsdk\/axiamerror\/auth(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"auth"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8AxiamSDK9AuthErrorV","kind":"typeIdentifier","text":"AuthError"},{"kind":"text","text":")"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","role":"symbol","title":"AxiamError.auth(_:)"},"doc://AxiamSDK/documentation/AxiamSDK/LoginResult":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult","title":"LoginResult","type":"topic","url":"\/documentation\/axiamsdk\/loginresult","navigatorTitle":[{"text":"LoginResult","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"text":"Outcome of ","type":"text"},{"code":"login","type":"codeVoice"},{"text":" (§1). Tokens are delivered out-of-band via ","type":"text"},{"code":"httpOnly","type":"codeVoice"},{"text":" cookies, so no","type":"text"},{"text":" ","type":"text"},{"text":"token material appears here.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoginResult","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/login(email:password:)":{"abstract":[{"text":"Authenticate with email\/username + password (§1 ","type":"text"},{"code":"login","type":"codeVoice"},{"type":"text","text":")."}],"title":"login(email:password:)","kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"login"},{"kind":"text","text":"("},{"text":"email","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"password"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"text":"LoginResult","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK11LoginResultO"}],"url":"\/documentation\/axiamsdk\/axiamclient\/login(email:password:)","role":"symbol"}}}