{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/loginopaque(usernameoremail:password:)"]}],"abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/auth\/opaque\/login\/start"},{"type":"text","text":" then "},{"type":"codeVoice","code":"\/finish"},{"type":"text","text":" — OPAQUE login, RFC 9807"},{"type":"text","text":" "},{"type":"text","text":"(CONTRACT.md §23)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loginOpaque"},{"kind":"text","text":"("},{"kind":"externalParam","text":"usernameOrEmail"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult","text":"LoginResult","preciseIdentifier":"s:8AxiamSDK11LoginResultO"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sibling of "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","type":"reference","isActive":true},{"type":"text","text":", not a replacement. It takes the same arguments and"},{"type":"text","text":" "},{"type":"text","text":"returns the same "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult","type":"reference","isActive":true},{"type":"text","text":", MFA branch included, so an application can switch a"},{"type":"text","text":" "},{"type":"text","text":"tenant to OPAQUE without touching its own code."}]},{"anchor":"What-this-does-that-login-does-not","type":"heading","text":"What this does that `login` does not","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The password never leaves this process. What crosses the wire is a blinded group element"},{"type":"text","text":" "},{"type":"text","text":"and a MAC, neither useful without the account’s registration record "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" the tenant’s OPRF"},{"type":"text","text":" "},{"type":"text","text":"seed — so a TLS-terminating proxy, an accidentally verbose request log, or a heap dump on"},{"type":"text","text":" "},{"type":"text","text":"the server cannot capture a plaintext password, because the server never has one. It also"},{"type":"text","text":" "},{"type":"text","text":"means a stolen record database is not offline-crackable on its own, which is the"},{"type":"text","text":" "},{"type":"text","text":"pre-computation resistance SRP could not offer. It does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" protect against a"},{"type":"text","text":" "},{"type":"text","text":"compromised AXIAM server."}]},{"anchor":"Swift-no-longer-needs-a-pbkdf2sha256-tenant","type":"heading","text":"Swift no longer needs a `pbkdf2_sha256` tenant","level":2},{"type":"paragraph","inlineContent":[{"text":"The SRP client this replaces refused an ","type":"text"},{"code":"argon2id","type":"codeVoice"},{"text":" tenant outright — Swift has no Argon2","type":"text"},{"text":" ","type":"text"},{"text":"that ships on every supported platform, and substituting PBKDF2 would have derived a","type":"text"},{"text":" ","type":"text"},{"text":"different ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" and surfaced as “invalid password”. AXIAM’s ","type":"text"},{"inlineContent":[{"text":"default","type":"text"}],"type":"emphasis"},{"text":" KDF was, for Swift,","type":"text"},{"text":" ","type":"text"},{"text":"unreachable. The key stretching now happens inside ","type":"text"},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"text":", so the only","type":"text"},{"text":" ","type":"text"},{"text":"remaining condition is having that library, which ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueAvailable()"},{"text":" reports.","type":"text"}]},{"anchor":"One-round-trip-and-no-server-proof-step","type":"heading","text":"One round trip, and no server-proof step","level":2},{"type":"paragraph","inlineContent":[{"text":"SRP had to guess a group before the server named one and restart the exchange if it guessed","type":"text"},{"text":" ","type":"text"},{"text":"wrong; ","type":"text"},{"type":"codeVoice","code":"KE1"},{"text":" does not depend on the key-stretching function. And where the old §23.3 rule 6","type":"text"},{"text":" ","type":"text"},{"text":"had to mandate an ","type":"text"},{"type":"codeVoice","code":"M2"},{"text":" check in capitals — because skipping it kept only half the protocol","type":"text"},{"text":" ","type":"text"},{"text":"— RFC 9807’s AKE authenticates the server during the handshake, so opening ","type":"text"},{"type":"codeVoice","code":"KE2"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"is"}],"type":"emphasis"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"proof that it holds the record.","type":"text"}]},{"anchor":"Cost","type":"heading","text":"Cost","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Runs the tenant’s key-stretching function: Argon2id at 19 MiB and t=2 by default, tens to"},{"type":"text","text":" "},{"type":"text","text":"hundreds of milliseconds of CPU plus that memory. That cost is the point — it is what makes"},{"type":"text","text":" "},{"type":"text","text":"a stolen record expensive to attack even by someone holding the OPRF seed. It runs on the"},{"type":"text","text":" "},{"type":"text","text":"calling task rather than a shared executor."}]},{"anchor":"When-KE2-does-not-open-mode-decides-what-happens-next","type":"heading","text":"When `KE2` does not open, `mode` decides what happens next","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"login\/start"},{"text":" response carries the tenant’s ","type":"text"},{"type":"codeVoice","code":"opaque_mode"},{"text":", and §23.4 rule 7 branches on","type":"text"},{"text":" ","type":"text"},{"text":"it and on nothing else:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"optional"},{"type":"text","text":" — this method "},{"inlineContent":[{"type":"text","text":"retries over "},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","type":"reference"}],"type":"strong"},{"type":"text","text":" with the same"},{"type":"text","text":" "},{"type":"text","text":"credentials and returns that call’s outcome, before reporting any failure. "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"the mid-migration state: every account has no OPAQUE record the moment an operator"},{"type":"text","text":" "},{"type":"text","text":"enables it, and acquires one only when its password is next set, so treating the failed"},{"type":"text","text":" "},{"type":"text","text":"exchange as final would lock out every user of the tenant."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"required","type":"codeVoice"},{"type":"text","text":", "},{"inlineContent":[{"text":"and a response with no ","type":"text"},{"type":"codeVoice","code":"mode"},{"text":" field at all","type":"text"}],"type":"strong"},{"type":"text","text":" (a server older than the"},{"type":"text","text":" "},{"type":"text","text":"field), and any value this SDK does not recognise — "},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference"},{"type":"text","text":", the exchange"},{"type":"text","text":" "},{"type":"text","text":"is over, and nothing is retried. Failing closed is the default."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"mode","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"text":" downgrade protection: a hostile server that wanted the plaintext could","type":"text"},{"text":" ","type":"text"},{"text":"answer ","type":"text"},{"code":"404","type":"codeVoice"},{"text":" and get a caller’s fallback whatever it puts here. What closes that is","type":"text"},{"text":" ","type":"text"},{"code":"required","type":"codeVoice"},{"text":" server-side, which refuses ","type":"text"},{"code":"\/auth\/login","type":"codeVoice"},{"text":" for every principal before examining","type":"text"},{"text":" ","type":"text"},{"text":"any credential.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","type":"reference","isActive":true},{"type":"text","text":" when the tenant has OPAQUE disabled (the endpoint"},{"type":"text","text":" "},{"type":"text","text":"answers "},{"type":"codeVoice","code":"404"},{"type":"text","text":" — a property of the tenant, not of any user), when "},{"type":"codeVoice","code":"libaxiam_opaque_ffi"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"not installed, and when the server names a key-stretching function this SDK cannot ask"},{"type":"text","text":" "},{"type":"text","text":"for. Deliberately not "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"type":"text","text":": reporting a configuration gap as a"},{"type":"text","text":" "},{"type":"text","text":"credential failure would send a user off to reset a password that works, and would stop a"},{"type":"text","text":" "},{"type":"text","text":"caller falling back to "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note","name":"Throws","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"type":"text","text":" for a wrong password, an account that does not exist, an"},{"type":"text","text":" "},{"type":"text","text":"account with no registration record, and a server that does not hold the record —"},{"type":"text","text":" "},{"type":"text","text":"indistinguishable by design. "},{"inlineContent":[{"text":"Nothing is sent to ","type":"text"},{"code":"login\/finish","type":"codeVoice"},{"text":" in that case","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"(§23.4 rule 7). A caller must not retry it over "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)"},{"type":"text","text":" by hand: under"},{"type":"text","text":" "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" this method has already done so (see above), and under "},{"type":"codeVoice","code":"required"},{"type":"text","text":" the retry is"},{"type":"text","text":" "},{"type":"text","text":"refused anyway and would put a plaintext password on the wire for nothing."}],"type":"paragraph"}],"style":"note","name":"Throws","type":"aside"}]}],"metadata":{"title":"loginOpaque(usernameOrEmail:password:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loginOpaque","kind":"identifier"},{"text":"(","kind":"text"},{"text":"usernameOrEmail","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK11LoginResultO","text":"LoginResult","kind":"typeIdentifier"}],"modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method","role":"symbol","symbolKind":"method","externalID":"s:8AxiamSDK0A6ClientC11loginOpaque15usernameOrEmail8passwordAA11LoginResultOSS_SStYaKF"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginOpaque(usernameOrEmail:password:)","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/LoginResult":{"url":"\/documentation\/axiamsdk\/loginresult","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoginResult","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult","title":"LoginResult","role":"symbol","abstract":[{"type":"text","text":"Outcome of "},{"type":"codeVoice","code":"login"},{"type":"text","text":" (§1). Tokens are delivered out-of-band via "},{"type":"codeVoice","code":"httpOnly"},{"type":"text","text":" cookies, so no"},{"type":"text","text":" "},{"type":"text","text":"token material appears here."}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"LoginResult","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/network(_:)":{"type":"topic","title":"AxiamError.network(_:)","abstract":[{"type":"text","text":"Transport-level failure: connection refused, timeout, TLS error, DNS failure,"},{"text":" ","type":"text"},{"type":"text","text":"malformed request, server (5xx) error."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","url":"\/documentation\/axiamsdk\/axiamerror\/network(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"network","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NetworkError","preciseIdentifier":"s:8AxiamSDK12NetworkErrorV","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","url":"\/documentation\/axiamsdk\/axiamclient","title":"AxiamClient","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/login(email:password:)":{"abstract":[{"type":"text","text":"Authenticate with email\/username + password (§1 "},{"code":"login","type":"codeVoice"},{"type":"text","text":")."}],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"login"},{"kind":"text","text":"("},{"kind":"externalParam","text":"email"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"LoginResult","preciseIdentifier":"s:8AxiamSDK11LoginResultO"}],"title":"login(email:password:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","url":"\/documentation\/axiamsdk\/axiamclient\/login(email:password:)"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/opaqueAvailable()":{"type":"topic","title":"opaqueAvailable()","role":"symbol","abstract":[{"type":"text","text":"Whether this installation can perform OPAQUE (§23.2)."}],"kind":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\/opaqueavailable()","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueAvailable()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"opaqueAvailable"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/loginOpaque(usernameOrEmail:password:)":{"url":"\/documentation\/axiamsdk\/axiamclient\/loginopaque(usernameoremail:password:)","kind":"symbol","abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/auth\/opaque\/login\/start"},{"type":"text","text":" then "},{"type":"codeVoice","code":"\/finish"},{"type":"text","text":" — OPAQUE login, RFC 9807"},{"type":"text","text":" "},{"type":"text","text":"(CONTRACT.md §23)."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loginOpaque","kind":"identifier"},{"text":"(","kind":"text"},{"text":"usernameOrEmail","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"LoginResult","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK11LoginResultO"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginOpaque(usernameOrEmail:password:)","title":"loginOpaque(usernameOrEmail:password:)","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/auth(_:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"topic","title":"AxiamError.auth(_:)","role":"symbol","url":"\/documentation\/axiamsdk\/axiamerror\/auth(_:)","kind":"symbol","abstract":[{"type":"text","text":"Authentication failure: wrong credentials, expired session, MFA failure,"},{"type":"text","text":" "},{"type":"text","text":"or a 401 on the refresh call itself."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"auth"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8AxiamSDK9AuthErrorV","kind":"typeIdentifier","text":"AuthError"},{"kind":"text","text":")"}]}}}