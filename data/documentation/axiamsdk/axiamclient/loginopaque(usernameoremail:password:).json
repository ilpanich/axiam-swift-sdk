{"metadata":{"roleHeading":"Instance Method","externalID":"s:8AxiamSDK0A6ClientC11loginOpaque15usernameOrEmail8passwordAA11LoginResultOSS_SStYaKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loginOpaque","kind":"identifier"},{"text":"(","kind":"text"},{"text":"usernameOrEmail","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"LoginResult","preciseIdentifier":"s:8AxiamSDK11LoginResultO","kind":"typeIdentifier"}],"role":"symbol","title":"loginOpaque(usernameOrEmail:password:)","symbolKind":"method","modules":[{"name":"AxiamSDK"}]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginOpaque(usernameOrEmail:password:)","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loginOpaque","kind":"identifier"},{"text":"(","kind":"text"},{"text":"usernameOrEmail","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"LoginResult","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult","preciseIdentifier":"s:8AxiamSDK11LoginResultO"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"A sibling of ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","type":"reference","isActive":true},{"text":", not a replacement. It takes the same arguments and","type":"text"},{"text":" ","type":"text"},{"text":"returns the same ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult","type":"reference","isActive":true},{"text":", MFA branch included, so an application can switch a","type":"text"},{"text":" ","type":"text"},{"text":"tenant to OPAQUE without touching its own code.","type":"text"}],"type":"paragraph"},{"level":2,"text":"What this does that `login` does not","anchor":"What-this-does-that-login-does-not","type":"heading"},{"inlineContent":[{"type":"text","text":"The password never leaves this process. What crosses the wire is a blinded group element"},{"type":"text","text":" "},{"type":"text","text":"and a MAC, neither useful without the account’s registration record "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" the tenant’s OPRF"},{"type":"text","text":" "},{"type":"text","text":"seed — so a TLS-terminating proxy, an accidentally verbose request log, or a heap dump on"},{"type":"text","text":" "},{"type":"text","text":"the server cannot capture a plaintext password, because the server never has one. It also"},{"type":"text","text":" "},{"type":"text","text":"means a stolen record database is not offline-crackable on its own, which is the"},{"type":"text","text":" "},{"type":"text","text":"pre-computation resistance SRP could not offer. It does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" protect against a"},{"type":"text","text":" "},{"type":"text","text":"compromised AXIAM server."}],"type":"paragraph"},{"level":2,"text":"Swift no longer needs a `pbkdf2_sha256` tenant","anchor":"Swift-no-longer-needs-a-pbkdf2sha256-tenant","type":"heading"},{"inlineContent":[{"type":"text","text":"The SRP client this replaces refused an "},{"type":"codeVoice","code":"argon2id"},{"type":"text","text":" tenant outright — Swift has no Argon2"},{"type":"text","text":" "},{"type":"text","text":"that ships on every supported platform, and substituting PBKDF2 would have derived a"},{"type":"text","text":" "},{"type":"text","text":"different "},{"type":"codeVoice","code":"x"},{"type":"text","text":" and surfaced as “invalid password”. AXIAM’s "},{"type":"emphasis","inlineContent":[{"text":"default","type":"text"}]},{"type":"text","text":" KDF was, for Swift,"},{"type":"text","text":" "},{"type":"text","text":"unreachable. The key stretching now happens inside "},{"type":"codeVoice","code":"libaxiam_opaque_ffi"},{"type":"text","text":", so the only"},{"type":"text","text":" "},{"type":"text","text":"remaining condition is having that library, which "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueAvailable()","isActive":true},{"type":"text","text":" reports."}],"type":"paragraph"},{"level":2,"text":"One round trip, and no server-proof step","anchor":"One-round-trip-and-no-server-proof-step","type":"heading"},{"inlineContent":[{"type":"text","text":"SRP had to guess a group before the server named one and restart the exchange if it guessed"},{"type":"text","text":" "},{"type":"text","text":"wrong; "},{"code":"KE1","type":"codeVoice"},{"type":"text","text":" does not depend on the key-stretching function. And where the old §23.3 rule 6"},{"type":"text","text":" "},{"type":"text","text":"had to mandate an "},{"code":"M2","type":"codeVoice"},{"type":"text","text":" check in capitals — because skipping it kept only half the protocol"},{"type":"text","text":" "},{"type":"text","text":"— RFC 9807’s AKE authenticates the server during the handshake, so opening "},{"code":"KE2","type":"codeVoice"},{"type":"text","text":" "},{"inlineContent":[{"text":"is","type":"text"}],"type":"emphasis"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"proof that it holds the record."}],"type":"paragraph"},{"level":2,"text":"Cost","anchor":"Cost","type":"heading"},{"inlineContent":[{"text":"Runs the tenant’s key-stretching function: Argon2id at 19 MiB and t=2 by default, tens to","type":"text"},{"text":" ","type":"text"},{"text":"hundreds of milliseconds of CPU plus that memory. That cost is the point — it is what makes","type":"text"},{"text":" ","type":"text"},{"text":"a stolen record expensive to attack even by someone holding the OPRF seed. It runs on the","type":"text"},{"text":" ","type":"text"},{"text":"calling task rather than a shared executor.","type":"text"}],"type":"paragraph"},{"level":2,"text":"When `KE2` does not open, `mode` decides what happens next","anchor":"When-KE2-does-not-open-mode-decides-what-happens-next","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"login\/start"},{"type":"text","text":" response carries the tenant’s "},{"type":"codeVoice","code":"opaque_mode"},{"type":"text","text":", and §23.4 rule 7 branches on"},{"type":"text","text":" "},{"type":"text","text":"it and on nothing else:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"optional"},{"type":"text","text":" — this method "},{"type":"strong","inlineContent":[{"text":"retries over ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","type":"reference","isActive":true}]},{"type":"text","text":" with the same"},{"type":"text","text":" "},{"type":"text","text":"credentials and returns that call’s outcome, before reporting any failure. "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"the mid-migration state: every account has no OPAQUE record the moment an operator"},{"type":"text","text":" "},{"type":"text","text":"enables it, and acquires one only when its password is next set, so treating the failed"},{"type":"text","text":" "},{"type":"text","text":"exchange as final would lock out every user of the tenant."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"required"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"and a response with no "},{"code":"mode","type":"codeVoice"},{"type":"text","text":" field at all"}],"type":"strong"},{"type":"text","text":" (a server older than the"},{"type":"text","text":" "},{"type":"text","text":"field), and any value this SDK does not recognise — "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"type":"text","text":", the exchange"},{"type":"text","text":" "},{"type":"text","text":"is over, and nothing is retried. Failing closed is the default."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"code":"mode","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" downgrade protection: a hostile server that wanted the plaintext could","type":"text"},{"text":" ","type":"text"},{"text":"answer ","type":"text"},{"code":"404","type":"codeVoice"},{"text":" and get a caller’s fallback whatever it puts here. What closes that is","type":"text"},{"text":" ","type":"text"},{"code":"required","type":"codeVoice"},{"text":" server-side, which refuses ","type":"text"},{"code":"\/auth\/login","type":"codeVoice"},{"text":" for every principal before examining","type":"text"},{"text":" ","type":"text"},{"text":"any credential.","type":"text"}],"type":"paragraph"},{"name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},{"text":" when the tenant has OPAQUE disabled (the endpoint","type":"text"},{"text":" ","type":"text"},{"text":"answers ","type":"text"},{"type":"codeVoice","code":"404"},{"text":" — a property of the tenant, not of any user), when ","type":"text"},{"type":"codeVoice","code":"libaxiam_opaque_ffi"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"not installed, and when the server names a key-stretching function this SDK cannot ask","type":"text"},{"text":" ","type":"text"},{"text":"for. Deliberately not ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"text":": reporting a configuration gap as a","type":"text"},{"text":" ","type":"text"},{"text":"credential failure would send a user off to reset a password that works, and would stop a","type":"text"},{"text":" ","type":"text"},{"text":"caller falling back to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)"},{"text":".","type":"text"}]}],"type":"aside"},{"name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"type":"text","text":" for a wrong password, an account that does not exist, an"},{"type":"text","text":" "},{"type":"text","text":"account with no registration record, and a server that does not hold the record —"},{"type":"text","text":" "},{"type":"text","text":"indistinguishable by design. "},{"inlineContent":[{"type":"text","text":"Nothing is sent to "},{"code":"login\/finish","type":"codeVoice"},{"type":"text","text":" in that case"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"(§23.4 rule 7). A caller must not retry it over "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)"},{"type":"text","text":" by hand: under"},{"type":"text","text":" "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" this method has already done so (see above), and under "},{"type":"codeVoice","code":"required"},{"type":"text","text":" the retry is"},{"type":"text","text":" "},{"type":"text","text":"refused anyway and would put a plaintext password on the wire for nothing."}]}],"type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/loginopaque(usernameoremail:password:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"code":"POST \/api\/v1\/auth\/opaque\/login\/start","type":"codeVoice"},{"text":" then ","type":"text"},{"code":"\/finish","type":"codeVoice"},{"text":" — OPAQUE login, RFC 9807","type":"text"},{"text":" ","type":"text"},{"text":"(CONTRACT.md §23).","type":"text"}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/auth(_:)":{"url":"\/documentation\/axiamsdk\/axiamerror\/auth(_:)","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"topic","title":"AxiamError.auth(_:)","abstract":[{"text":"Authentication failure: wrong credentials, expired session, MFA failure,","type":"text"},{"type":"text","text":" "},{"text":"or a 401 on the refresh call itself.","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"auth"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"AuthError","preciseIdentifier":"s:8AxiamSDK9AuthErrorV"},{"kind":"text","text":")"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/loginOpaque(usernameOrEmail:password:)":{"type":"topic","abstract":[{"code":"POST \/api\/v1\/auth\/opaque\/login\/start","type":"codeVoice"},{"type":"text","text":" then "},{"code":"\/finish","type":"codeVoice"},{"type":"text","text":" — OPAQUE login, RFC 9807"},{"type":"text","text":" "},{"type":"text","text":"(CONTRACT.md §23)."}],"role":"symbol","title":"loginOpaque(usernameOrEmail:password:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loginOpaque"},{"kind":"text","text":"("},{"kind":"externalParam","text":"usernameOrEmail"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK11LoginResultO","kind":"typeIdentifier","text":"LoginResult"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/loginOpaque(usernameOrEmail:password:)","url":"\/documentation\/axiamsdk\/axiamclient\/loginopaque(usernameoremail:password:)","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/login(email:password:)":{"role":"symbol","title":"login(email:password:)","url":"\/documentation\/axiamsdk\/axiamclient\/login(email:password:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"login","kind":"identifier"},{"text":"(","kind":"text"},{"text":"email","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"LoginResult","preciseIdentifier":"s:8AxiamSDK11LoginResultO"}],"abstract":[{"text":"Authenticate with email\/username + password (§1 ","type":"text"},{"code":"login","type":"codeVoice"},{"text":").","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/login(email:password:)","kind":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"title":"AxiamClient","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamclient","abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/network(_:)":{"abstract":[{"type":"text","text":"Transport-level failure: connection refused, timeout, TLS error, DNS failure,"},{"text":" ","type":"text"},{"text":"malformed request, server (5xx) error.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/axiamerror\/network(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"network","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12NetworkErrorV","text":"NetworkError"},{"kind":"text","text":")"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","title":"AxiamError.network(_:)"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/opaqueAvailable()":{"kind":"symbol","abstract":[{"type":"text","text":"Whether this installation can perform OPAQUE (§23.2)."}],"title":"opaqueAvailable()","type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueAvailable()","url":"\/documentation\/axiamsdk\/axiamclient\/opaqueavailable()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"opaqueAvailable"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]},"doc://AxiamSDK/documentation/AxiamSDK/LoginResult":{"abstract":[{"text":"Outcome of ","type":"text"},{"code":"login","type":"codeVoice"},{"text":" (§1). Tokens are delivered out-of-band via ","type":"text"},{"code":"httpOnly","type":"codeVoice"},{"text":" cookies, so no","type":"text"},{"text":" ","type":"text"},{"text":"token material appears here.","type":"text"}],"role":"symbol","url":"\/documentation\/axiamsdk\/loginresult","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginResult","title":"LoginResult","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoginResult","kind":"identifier"}],"navigatorTitle":[{"text":"LoginResult","kind":"identifier"}],"kind":"symbol"}}}