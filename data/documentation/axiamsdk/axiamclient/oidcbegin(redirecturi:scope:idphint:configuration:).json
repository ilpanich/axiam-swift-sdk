{"abstract":[{"type":"text","text":"Build the authorization-code + PKCE redirect (§12.1) — "},{"type":"strong","inlineContent":[{"type":"text","text":"pure local computation, no"},{"type":"text","text":" "},{"type":"text","text":"network I\/O"}]},{"type":"text","text":" beyond the discovery fetch this client would cache anyway."}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:idpHint:configuration:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oidcBegin","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirectURI","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = \"openid profile email\", ","kind":"text"},{"text":"idpHint","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","text":"OidcConfiguration","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthorizationRequest","text":"AuthorizationRequest","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Must be replayed byte-identically to "},{"code":"oidcExchange","type":"codeVoice"},{"type":"text","text":"; the server compares"},{"type":"text","text":" "},{"type":"text","text":"them exactly."}]}],"name":"redirectURI"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"openid profile email"},{"type":"text","text":". The "},{"type":"codeVoice","code":"openid"},{"type":"text","text":" scope is what makes the"},{"type":"text","text":" "},{"type":"text","text":"server issue an ID token, and §12.4 rule 6 relies on it."}]}],"name":"scope"},{"content":[{"inlineContent":[{"type":"text","text":"Contract 1.65, §12.1 — choose the sign-in provider up front. A provider’s"},{"type":"text","text":" "},{"type":"text","text":"UUID, its "},{"type":"codeVoice","code":"provider_slug"},{"type":"text","text":" or a branded kind name ("},{"type":"codeVoice","code":"google"},{"type":"text","text":", "},{"type":"codeVoice","code":"github"},{"type":"text","text":", "},{"type":"codeVoice","code":"facebook"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"apple"},{"type":"text","text":", "},{"type":"codeVoice","code":"microsoft"},{"type":"text","text":"). Emitted as the one query parameter "},{"type":"codeVoice","code":"axiam_idp_hint"},{"type":"text","text":", exactly"},{"type":"text","text":" "},{"type":"text","text":"once, and only when set. Validated for emptiness and length (256 bytes of UTF-8)"},{"type":"text","text":" "},{"type":"text","text":"and for nothing else: it is not trimmed, case-folded, parsed as a UUID or looked up,"},{"type":"text","text":" "},{"type":"text","text":"because the server resolves it and ignores one that names nothing. There is no"},{"type":"text","text":" "},{"type":"codeVoice","code":"kc_idp_hint"},{"type":"text","text":" alias. If the discovery document’s "},{"type":"codeVoice","code":"authorization_endpoint"},{"type":"text","text":" already"},{"type":"text","text":" "},{"type":"text","text":"carries an "},{"type":"codeVoice","code":"axiam_idp_hint"},{"type":"text","text":" of its own, this argument replaces it rather than"},{"type":"text","text":" "},{"type":"text","text":"adding a second, which the server would refuse."}],"type":"paragraph"}],"name":"idpHint"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"The caller owns the returned ","type":"text"},{"code":"state","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nonce","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"codeVerifier","type":"codeVoice"}]},{"type":"text","text":" (§12.3 rule 1). This"},{"type":"text","text":" "},{"type":"text","text":"SDK stores none of them: not on the client, not in a global, not in an implicit cache."},{"type":"text","text":" "},{"type":"text","text":"Persist them in your own session and pass the last two back into"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcExchange(code:redirectURI:codeVerifier:nonce:tenantID:configuration:)"},{"type":"text","text":"."}]},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A validation "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive":true},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError\/isValidation","isActive":true},{"type":"text","text":"), with no URL"},{"type":"text","text":" "},{"type":"text","text":"built, when "},{"type":"codeVoice","code":"idpHint"},{"type":"text","text":" is empty or longer than 256 bytes."}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axia