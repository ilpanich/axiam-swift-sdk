:"text","text":"?, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","text":"OidcConfiguration"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","kind":"typeIdentifier","text":"PushedAuthorizationRequest"}],"roleHeading":"Instance Method","modules":[{"name":"AxiamSDK"}],"symbolKind":"method","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/oidcpar(request:redirecturi:scope:dpopjkt:idphint:tenantid:configuration:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"oidcPar"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthorizationRequest","preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV","kind":"typeIdentifier","text":"AuthorizationRequest"},{"kind":"text","text":", "},{"kind":"externalParam","text":"redirectURI"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":" = \"openid profile email\", "},{"kind":"externalParam","text":"dpopJkt"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"idpHint"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","text":"OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizationRequest","preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","kind":"typeIdentifier","text":"PushedAuthorizationRequest"}]}],"kind":"declarations"},{"parameters":[{"name":"request","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:idpHint:configuration:)"},{"type":"text","text":" returned. Its"},{"type":"text","text":" "},{"type":"codeVoice","code":"state"},{"type":"text","text":", "},{"type":"codeVoice","code":"nonce"},{"type":"text","text":" and PKCE verifier are pushed as-is — §26.2 rule 1 forbids a"},{"type":"text","text":" "},{"type":"text","text":"second generator."}]}]},{"name":"redirectURI","content":[{"type":"paragraph","inlineContent":[{"text":"The same redirect URI that will be sent at exchange time.","type":"text"}]}]},{"name":"scope","content":[{"inlineContent":[{"type":"text","text":"The requested scope. Must match what was pushed at "},{"code":"oidcBegin","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"dpopJkt","content":[{"type":"paragraph","inlineContent":[{"text":"RFC 9449 §10.1 — the JWK SHA-256 thumbprint of the key the client will","type":"text"},{"text":" ","type":"text"},{"text":"prove possession of at the token endpoint, binding the authorization code to that","type":"text"},{"text":" ","type":"text"},{"text":"key from the moment it is issued rather than from first use. Sent ","type":"text"},{"inlineContent":[{"text":"only when","type":"text"},{"text":" ","type":"text"},{"text":"given","type":"text"}],"type":"strong"},{"text":"; omitting it is the unbound behaviour every release before contract 1.42","type":"text"},{"text":" ","type":"text"},{"text":"had. ","type":"text"},{"inlineContent":[{"text":"Caller-supplied, and it has to be","type":"text"}],"type":"strong"},{"text":": CONTRACT.md §21.9 records this SDK as","type":"text"},{"text":" ","type":"text"},{"text":"verifying DPoP proofs but not generating them, so it holds no client key and has","type":"text"},{"text":" ","type":"text"},{"text":"no thumbprint of its own to offer. An application doing DPoP computes the","type":"text"},{"text":" ","type":"text"},{"text":"thumbprint over its own key (RFC 7638) and passes it here.","type":"text"}]}]},{"name":"idpHint","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Contract 1.65, §26.2 rule 8 — the provider to start the sign-in page with"},{"type":"text","text":" "},{"type":"text","text":"(a UUID, a "},{"code":"provider_slug","type":"codeVoice"},{"type":"text","text":" or a branded kind name), pushed as "},{"code":"axiam_idp_hint","type":"codeVoice"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"form body"}],"type":"strong"},{"type":"text","text":", exactly once, and only when set. It never reaches the redirect URL,"},{"type":"text","text":" "},{"type":"text","text":"which stays exactly "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":" and "},{"code":"request_uri","type":"codeVoice"},{"type":"text","text":" (plus the routing "},{"code":"tenant_id","type":"codeVoice"},{"type":"text","text":"): the"},{"type":"text","text":" "},{"type":"text","text":"server reads the pushed copy and ignores one beside a "},{"code":"request_uri","type":"codeVoice"},{"type":"text","text":". Validated as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:idpHint:configuration:)","isActive":true},{"type":"text","text":" does — emptiness and 256"},{"type":"text","text":" "},{"type":"text","text":"bytes, nothing else — before any request is sent. When this is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the "},{"code":"axiam_idp_hint","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"that "},{"code":"request.url","type":"codeVoice"},{"type":"text","text":" carries (from "},{"code":"oidcBegin(idpHint:)","type":"codeVoice"},{"type":"text","text":") is pushed instead; when both"},{"type":"text","text":" "},{"type":"text","text":"are set this argument wins and exactly one value is pushed."}]}]},{"name":"tenantID","content":[{"type":"paragraph","inlineContent":[{"text":"A tenant override for the ","type":"text"},{"code":"?tenant_id=","type":"codeVoice"},{"text":" query parameter.","type":"text"}]}]},{"name":"configuration","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The discovery document, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to discover."}]}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"PAR moves the authorization request off the browser. Instead of putting ","type":"text"},{"code":"scope","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"redirect_uri","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" and the PKCE challenge into a URL the user agent carries,","type":"text"},{"text":" ","type":"text"},{"text":"the client POSTs them straight to AXIAM over an authenticated channel and puts an","type":"text"},{"text":" ","type":"text"},{"text":"opaque ","type":"text"},{"code":"request_uri","type":"codeVoice"},{"text":" in the redirect. What travels through the browser is then a","type":"text"},{"text":" ","type":"text"},{"text":"random string that cannot be edited into meaning something else.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Required for a FAPI 2.0 client","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"profile: \"fapi2\""},{"type":"text","text":" refuses a registration that"},{"type":"text","text":" "},{"type":"text","text":"does not set "},{"type":"codeVoice","code":"require_par"},{"type":"text","text":", so such a client cannot authorize any other way (§21.1)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Not retried on a "},{"type":"codeVoice","code":"5xx"},{"type":"text","text":" or a transport failure — it is a POST that creates server"},{"type":"text","text":" "},{"type":"text","text":"state, so it falls outside §16.2’s read-only eligibility exactly as "},{"type":"codeVoice","code":"oidcExchange"},{"type":"text","text":" "},{"type":"text","text":"does. The safe recovery is a fresh push, which costs one round trip and cannot"},{"type":"text","text":" "},{"type":"text","text":"double-consume anything (§26.2 rule 4)."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"A validation ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError"},{"text":" when ","type":"text"},{"code":"idpHint","type":"codeVoice"},{"text":" is empty or over 256 bytes;","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"text":" client-side, with ","type":"text"},{"inlineContent":[{"type":"text","text":"no wire call"}],"type":"strong"},{"text":", when the","type":"text"},{"text":" ","type":"text"},{"text":"discovery document advertises no PAR endpoint — §12.7.2 rule 1’s discipline: never","type":"text"},{"text":" ","type":"text"},{"text":"synthesise the URL from the issuer.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Throws","type":"aside"}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/PushedAuthorizationRequest":{"navigatorTitle":[{"kind":"identifier","text":"PushedAuthorizationRequest"}],"title":"PushedAuthorizationRequest","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PushedAuthorizationRequest"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizationRequest","type":"topic","url":"\/documentation\/axiamsdk\/pushedauthorizationrequest","kind":"symbol","abstract":[{"type":"text","text":"The result of "},{"type":"codeVoice","code":"oidcPar"},{"type":"text","text":" (CONTRACT.md §26.1)."}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/oidcPar(request:redirectURI:scope:dpopJkt:idpHint:tenantID:configuration:)":{"kind":"symbol","type":"topic","role":"symbol","title":"oidcPar(request:redirectURI:scope:dpopJkt:idpHint:tenantID:configuration:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcPar(request:redirectURI:scope:dpopJkt:idpHint:tenantID:configuration:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oidcPar","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": 