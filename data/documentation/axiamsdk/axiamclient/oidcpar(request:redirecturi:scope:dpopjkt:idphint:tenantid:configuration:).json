{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/oidcpar(request:redirecturi:scope:dpopjkt:idphint:tenantid:configuration:)"]}],"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"oidcPar"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthorizationRequest","preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV","kind":"typeIdentifier","text":"AuthorizationRequest"},{"kind":"text","text":", "},{"kind":"externalParam","text":"redirectURI"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":" = \"openid profile email\", "},{"kind":"externalParam","text":"dpopJkt"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"idpHint"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier","text":"OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizationRequest","preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","kind":"typeIdentifier","text":"PushedAuthorizationRequest"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"request","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:idpHint:configuration:)","isActive":true},{"type":"text","text":" returned. Its"},{"type":"text","text":" "},{"type":"codeVoice","code":"state"},{"type":"text","text":", "},{"type":"codeVoice","code":"nonce"},{"type":"text","text":" and PKCE verifier are pushed as-is — §26.2 rule 1 forbids a"},{"type":"text","text":" "},{"type":"text","text":"second generator."}]}]},{"name":"redirectURI","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The same redirect URI that will be sent at exchange time."}]}]},{"name":"scope","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The requested scope. Must match what was pushed at "},{"type":"codeVoice","code":"oidcBegin"},{"type":"text","text":"."}]}]},{"name":"dpopJkt","content":[{"inlineContent":[{"text":"RFC 9449 §10.1 — the JWK SHA-256 thumbprint of the key the client will","type":"text"},{"text":" ","type":"text"},{"text":"prove possession of at the token endpoint, binding the authorization code to that","type":"text"},{"text":" ","type":"text"},{"text":"key from the moment it is issued rather than from first use. Sent ","type":"text"},{"inlineContent":[{"type":"text","text":"only when"},{"type":"text","text":" "},{"type":"text","text":"given"}],"type":"strong"},{"text":"; omitting it is the unbound behaviour every release before contract 1.42","type":"text"},{"text":" ","type":"text"},{"text":"had. ","type":"text"},{"inlineContent":[{"text":"Caller-supplied, and it has to be","type":"text"}],"type":"strong"},{"text":": CONTRACT.md §21.9 records this SDK as","type":"text"},{"text":" ","type":"text"},{"text":"verifying DPoP proofs but not generating them, so it holds no client key and has","type":"text"},{"text":" ","type":"text"},{"text":"no thumbprint of its own to offer. An application doing DPoP computes the","type":"text"},{"text":" ","type":"text"},{"text":"thumbprint over its own key (RFC 7638) and passes it here.","type":"text"}],"type":"paragraph"}]},{"name":"idpHint","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Contract 1.65, §26.2 rule 8 — the provider to start the sign-in page with"},{"type":"text","text":" "},{"type":"text","text":"(a UUID, a "},{"code":"provider_slug","type":"codeVoice"},{"type":"text","text":" or a branded kind name), pushed as "},{"code":"axiam_idp_hint","type":"codeVoice"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"form body"}]},{"type":"text","text":", exactly once, and only when set. It never reaches the redirect URL,"},{"type":"text","text":" "},{"type":"text","text":"which stays exactly "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":" and "},{"code":"request_uri","type":"codeVoice"},{"type":"text","text":" (plus the routing "},{"code":"tenant_id","type":"codeVoice"},{"type":"text","text":"): the"},{"type":"text","text":" "},{"type":"text","text":"server reads the pushed copy and ignores one beside a "},{"code":"request_uri","type":"codeVoice"},{"type":"text","text":". Validated as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:idpHint:configuration:)"},{"type":"text","text":" does — emptiness and 256"},{"type":"text","text":" "},{"type":"text","text":"bytes, nothing else — before any request is sent. When this is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the "},{"code":"axiam_idp_hint","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"that "},{"code":"request.url","type":"codeVoice"},{"type":"text","text":" carries (from "},{"code":"oidcBegin(idpHint:)","type":"codeVoice"},{"type":"text","text":") is pushed instead; when both"},{"type":"text","text":" "},{"type":"text","text":"are set this argument wins and exactly one value is pushed."}]}]},{"name":"tenantID","content":[{"inlineContent":[{"type":"text","text":"A tenant override for the "},{"type":"codeVoice","code":"?tenant_id="},{"type":"text","text":" query parameter."}],"type":"paragraph"}]},{"name":"configuration","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The discovery document, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to discover."}]}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"PAR moves the authorization request off the browser. Instead of putting ","type":"text"},{"type":"codeVoice","code":"scope"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"redirect_uri"},{"text":", ","type":"text"},{"type":"codeVoice","code":"state"},{"text":" and the PKCE challenge into a URL the user agent carries,","type":"text"},{"text":" ","type":"text"},{"text":"the client POSTs them straight to AXIAM over an authenticated channel and puts an","type":"text"},{"text":" ","type":"text"},{"text":"opaque ","type":"text"},{"type":"codeVoice","code":"request_uri"},{"text":" in the redirect. What travels through the browser is then a","type":"text"},{"text":" ","type":"text"},{"text":"random string that cannot be edited into meaning something else.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Required for a FAPI 2.0 client"}],"type":"strong"},{"text":": ","type":"text"},{"code":"profile: \"fapi2\"","type":"codeVoice"},{"text":" refuses a registration that","type":"text"},{"text":" ","type":"text"},{"text":"does not set ","type":"text"},{"code":"require_par","type":"codeVoice"},{"text":", so such a client cannot authorize any other way (§21.1).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not retried on a "},{"code":"5xx","type":"codeVoice"},{"type":"text","text":" or a transport failure — it is a POST that creates server"},{"type":"text","text":" "},{"type":"text","text":"state, so it falls outside §16.2’s read-only eligibility exactly as "},{"code":"oidcExchange","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"does. The safe recovery is a fresh push, which costs one round trip and cannot"},{"type":"text","text":" "},{"type":"text","text":"double-consume anything (§26.2 rule 4)."}]},{"name":"Throws","content":[{"inlineContent":[{"type":"text","text":"A validation "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive":true,"type":"reference"},{"type":"text","text":" when "},{"code":"idpHint","type":"codeVoice"},{"type":"text","text":" is empty or over 256 bytes;"},{"type":"text","text":" "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true,"type":"reference"},{"type":"text","text":" client-side, with "},{"inlineContent":[{"text":"no wire call","type":"text"}],"type":"strong"},{"type":"text","text":", when the"},{"type":"text","text":" "},{"type":"text","text":"discovery document advertises no PAR endpoint — §12.7.2 rule 1’s discipline: never"},{"type":"text","text":" "},{"type":"text","text":"synthesise the URL from the issuer."}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"method","title":"oidcPar(request:redirectURI:scope:dpopJkt:idpHint:tenantID:configuration:)","role":"symbol","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","