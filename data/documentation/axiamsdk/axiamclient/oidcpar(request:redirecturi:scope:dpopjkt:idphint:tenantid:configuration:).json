{"kind":"symbol","abstract":[{"type":"codeVoice","code":"POST \/oauth2\/par"},{"type":"text","text":" (CONTRACT.md §26.1) — push the authorization request over the"},{"type":"text","text":" "},{"type":"text","text":"back channel and get an opaque handle to redirect with."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oidcPar","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AuthorizationRequest","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthorizationRequest","preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"redirectURI","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":" = \"openid profile email\", ","kind":"text"},{"text":"dpopJkt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"idpHint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcConfiguration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"PushedAuthorizationRequest","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizationRequest","preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"request","content":[{"type":"paragraph","inlineContent":[{"text":"What ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:idpHint:configuration:)","isActive":true,"type":"reference"},{"text":" returned. Its","type":"text"},{"text":" ","type":"text"},{"code":"state","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nonce","type":"codeVoice"},{"text":" and PKCE verifier are pushed as-is — §26.2 rule 1 forbids a","type":"text"},{"text":" ","type":"text"},{"text":"second generator.","type":"text"}]}]},{"name":"redirectURI","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The same redirect URI that will be sent at exchange time."}]}]},{"name":"scope","content":[{"inlineContent":[{"type":"text","text":"The requested scope. Must match what was pushed at "},{"type":"codeVoice","code":"oidcBegin"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"dpopJkt","content":[{"inlineContent":[{"type":"text","text":"RFC 9449 §10.1 — the JWK SHA-256 thumbprint of the key the client will"},{"type":"text","text":" "},{"type":"text","text":"prove possession of at the token endpoint, binding the authorization code to that"},{"type":"text","text":" "},{"type":"text","text":"key from the moment it is issued rather than from first use. Sent "},{"inlineContent":[{"text":"only when","type":"text"},{"text":" ","type":"text"},{"text":"given","type":"text"}],"type":"strong"},{"type":"text","text":"; omitting it is the unbound behaviour every release before contract 1.42"},{"type":"text","text":" "},{"type":"text","text":"had. "},{"inlineContent":[{"type":"text","text":"Caller-supplied, and it has to be"}],"type":"strong"},{"type":"text","text":": CONTRACT.md §21.9 records this SDK as"},{"type":"text","text":" "},{"type":"text","text":"verifying DPoP proofs but not generating them, so it holds no client key and has"},{"type":"text","text":" "},{"type":"text","text":"no thumbprint of its own to offer. An application doing DPoP computes the"},{"type":"text","text":" "},{"type":"text","text":"thumbprint over its own key (RFC 7638) and passes it here."}],"type":"paragraph"}]},{"name":"idpHint","content":[{"type":"paragraph","inlineContent":[{"text":"Contract 1.65, §26.2 rule 8 — the provider to start the sign-in page with","type":"text"},{"text":" ","type":"text"},{"text":"(a UUID, a ","type":"text"},{"type":"codeVoice","code":"provider_slug"},{"text":" or a branded kind name), pushed as ","type":"text"},{"type":"codeVoice","code":"axiam_idp_hint"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"form body","type":"text"}],"type":"strong"},{"text":", exactly once, and only when set. It never reaches the redirect URL,","type":"text"},{"text":" ","type":"text"},{"text":"which stays exactly ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"request_uri"},{"text":" (plus the routing ","type":"text"},{"type":"codeVoice","code":"tenant_id"},{"text":"): the","type":"text"},{"text":" ","type":"text"},{"text":"server reads the pushed copy and ignores one beside a ","type":"text"},{"type":"codeVoice","code":"request_uri"},{"text":". Validated as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:idpHint:configuration:)"},{"text":" does — emptiness and 256","type":"text"},{"text":" ","type":"text"},{"text":"bytes, nothing else — before any request is sent. When this is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", the ","type":"text"},{"type":"codeVoice","code":"axiam_idp_hint"},{"text":" ","type":"text"},{"text":"that ","type":"text"},{"type":"codeVoice","code":"request.url"},{"text":" carries (from ","type":"text"},{"type":"codeVoice","code":"oidcBegin(idpHint:)"},{"text":") is pushed instead; when both","type":"text"},{"text":" ","type":"text"},{"text":"are set this argument wins and exactly one value is pushed.","type":"text"}]}]},{"name":"tenantID","content":[{"type":"paragraph","inlineContent":[{"text":"A tenant override for the ","type":"text"},{"code":"?tenant_id=","type":"codeVoice"},{"text":" query parameter.","type":"text"}]}]},{"name":"configuration","content":[{"type":"paragraph","inlineContent":[{"text":"The discovery document, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" to discover.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"PAR moves the authorization request off the browser. Instead of putting "},{"code":"scope","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"redirect_uri","type":"codeVoice"},{"type":"text","text":", "},{"code":"state","type":"codeVoice"},{"type":"text","text":" and the PKCE challenge into a URL the user agent carries,"},{"type":"text","text":" "},{"type":"text","text":"the client POSTs them straight to AXIAM over an authenticated channel and puts an"},{"type":"text","text":" "},{"type":"text","text":"opaque "},{"code":"request_uri","type":"codeVoice"},{"type":"text","text":" in the redirect. What travels through the browser is then a"},{"type":"text","text":" "},{"type":"text","text":"random string that cannot be edited into meaning something else."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Required for a FAPI 2.0 client","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"code":"profile: \"fapi2\"","type":"codeVoice"},{"type":"text","text":" refuses a registration that"},{"type":"text","text":" "},{"type":"text","text":"does not set "},{"code":"require_par","type":"codeVoice"},{"type":"text","text":", so such a client cannot authorize any other way (§21.1)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not retried on a "},{"type":"codeVoice","code":"5xx"},{"type":"text","text":" or a transport failure — it is a POST that creates server"},{"type":"text","text":" "},{"type":"text","text":"state, so it falls outside §16.2’s read-only eligibility exactly as "},{"type":"codeVoice","code":"oidcExchange"},{"type":"text","text":" "},{"type":"text","text":"does. The safe recovery is a fresh push, which costs one round trip and cannot"},{"type":"text","text":" "},{"type":"text","text":"double-consume anything (§26.2 rule 4)."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A validation "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive":true},{"type":"text","text":" when "},{"type":"codeVoice","code":"idpHint"},{"type":"text","text":" is empty or over 256 bytes;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true},{"type":"text","text":" client-side, with "},{"inlineContent":[{"type":"text","text":"no wire call"}],"type":"strong"},{"type":"text","text":", when the"},{"type":"text","text":" "},{"type":"text","text":"discovery document advertises no PAR endpoint — §12.7.2 rule 1’s discipline: never"},{"type":"text","text":" "},{"type":"text","text":"synthesise the URL from the issuer."}]}],"name":"Throws","style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/oidcpar(request:redirecturi:scope:dpopjkt:idphint:tenantid:configuration:)"]}],"sections":[],"schemaVersion":{"m