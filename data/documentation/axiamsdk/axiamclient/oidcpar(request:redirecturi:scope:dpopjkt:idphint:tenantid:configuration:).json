,"text":"Authentication failure: wrong credentials, expired session, MFA failure,"},{"type":"text","text":" "},{"type":"text","text":"or a 401 on the refresh call itself."}],"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"auth"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8AxiamSDK9AuthErrorV","kind":"typeIdentifier","text":"AuthError"},{"kind":"text","text":")"}],"title":"AxiamError.auth(_:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamerror\/auth(_:)","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/oidcBegin(redirectURI:scope:idpHint:configuration:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:idpHint:configuration:)","abstract":[{"type":"text","text":"Build the authorization-code + PKCE redirect (§12.1) — "},{"inlineContent":[{"type":"text","text":"pure local computation, no"},{"type":"text","text":" "},{"type":"text","text":"network I\/O"}],"type":"strong"},{"type":"text","text":" beyond the discovery fetch this client would cache anyway."}],"kind":"symbol","title":"oidcBegin(redirectURI:scope:idpHint:configuration:)","role":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\/oidcbegin(redirecturi:scope:idphint:configuration:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oidcBegin","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirectURI","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"idpHint","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeId