url":"\/documentation\/axiamsdk\/axiamclient","abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/resendVerification(email:tenantID:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resendVerification","kind":"identifier"},{"text":"(","kind":"text"},{"text":"email","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"type":"topic","url":"\/documentation\/axiamsdk\/axiamclient\/resendverification(email:tenantid:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendVerification(email:tenantID:)","title":"resendVerification(email:tenantID:)","abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/auth\/resend-verification"},{"text":" (CONTRACT.md §25.1) — the","type":"text"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"unauthenticated"}],"type":"strong"},{"text":" resend, for a caller with no session.","type":"text"}],"kind":"symbol","role":"symbol"}}}