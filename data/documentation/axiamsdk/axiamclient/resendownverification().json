{"metadata":{"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resendOwnVerification"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"symbolKind":"method","modules":[{"name":"AxiamSDK"}],"role":"symbol","extendedModule":"AxiamSDK","title":"resendOwnVerification()","externalID":"s:8AxiamSDK0A6ClientC21resendOwnVerificationyyYaKF"},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendOwnVerification()","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"kind":"symbol","abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/users\/me\/resend-verification"},{"type":"text","text":" (CONTRACT.md §25.1, §25.7) — resend the"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"signed-in caller’s own"}]},{"type":"text","text":" verification mail, and say what happened."}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/resendownverification()"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resendOwnVerification","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Takes no address. The server reads it off the caller’s own record, and this signature","type":"text"},{"text":" ","type":"text"},{"text":"deliberately offers no way to name a different one: a parameter here would let an","type":"text"},{"text":" ","type":"text"},{"text":"authenticated session mail an arbitrary address.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Unlike ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendVerification(email:tenantID:)","isActive":true},{"text":" this reports the outcome, because the","type":"text"},{"text":" ","type":"text"},{"text":"caller is signed in to the account it is asking about and none of the outcomes tells","type":"text"},{"text":" ","type":"text"},{"text":"it anything it did not already bring with it:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"returns — a token was minted and the mail ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"enqueued"}]},{"text":". Delivery is asynchronous","type":"text"},{"text":" ","type":"text"},{"text":"and can still fail at the provider; a queue that accepts everything in front of a","type":"text"},{"text":" ","type":"text"},{"text":"provider that rejects it looks exactly like this succeeding (§25.7 rule 3).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AxiamError.authz"},{"type":"text","text":" (from "},{"type":"codeVoice","code":"409"},{"type":"text","text":") — already verified, or an account state that must"},{"type":"text","text":" "},{"type":"text","text":"not be sent a live token."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"AxiamError.network"},{"type":"text","text":" (from "},{"type":"codeVoice","code":"429"},{"type":"text","text":") — the daily resend limit."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"§25.7 rule 2 forbids falling back to the unauthenticated endpoint on either failure,","type":"text"},{"text":" ","type":"text"},{"text":"and this SDK does not: that fallback turns both back into a silent success and","type":"text"},{"text":" ","type":"text"},{"text":"restores the bug this operation exists to fix, with an extra round trip.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Refused client-side with ","type":"text"},{"inlineContent":[{"text":"no wire call","type":"text"}],"type":"strong"},{"text":" when there is no session.","type":"text"}]}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"url":"\/documentation\/axiamsdk\/axiamclient","kind":"symbol","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"title":"AxiamClient","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/resendOwnVerification()":{"role":"symbol","abstract":[{"code":"POST \/api\/v1\/users\/me\/resend-verification","type":"codeVoice"},{"text":" (CONTRACT.md §25.1, §25.7) — resend the","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"signed-in caller’s own"}]},{"text":" verification mail, and say what happened.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendOwnVerification()","url":"\/documentation\/axiamsdk\/axiamclient\/resendownverification()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resendOwnVerification","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"asy