{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resendOwnVerification"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Takes no address. The server reads it off the caller’s own record, and this signature"},{"type":"text","text":" "},{"type":"text","text":"deliberately offers no way to name a different one: a parameter here would let an"},{"type":"text","text":" "},{"type":"text","text":"authenticated session mail an arbitrary address."}],"type":"paragraph"},{"inlineContent":[{"text":"Unlike ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendVerification(email:tenantID:)"},{"text":" this reports the outcome, because the","type":"text"},{"text":" ","type":"text"},{"text":"caller is signed in to the account it is asking about and none of the outcomes tells","type":"text"},{"text":" ","type":"text"},{"text":"it anything it did not already bring with it:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"returns — a token was minted and the mail "},{"inlineContent":[{"type":"text","text":"enqueued"}],"type":"strong"},{"type":"text","text":". Delivery is asynchronous"},{"type":"text","text":" "},{"type":"text","text":"and can still fail at the provider; a queue that accepts everything in front of a"},{"type":"text","text":" "},{"type":"text","text":"provider that rejects it looks exactly like this succeeding (§25.7 rule 3)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"AxiamError.authz","type":"codeVoice"},{"text":" (from ","type":"text"},{"code":"409","type":"codeVoice"},{"text":") — already verified, or an account state that must","type":"text"},{"text":" ","type":"text"},{"text":"not be sent a live token.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"AxiamError.network","type":"codeVoice"},{"type":"text","text":" (from "},{"code":"429","type":"codeVoice"},{"type":"text","text":") — the daily resend limit."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"§25.7 rule 2 forbids falling back to the unauthenticated endpoint on either failure,","type":"text"},{"text":" ","type":"text"},{"text":"and this SDK does not: that fallback turns both back into a silent success and","type":"text"},{"text":" ","type":"text"},{"text":"restores the bug this operation exists to fix, with an extra round trip.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Refused client-side with "},{"type":"strong","inlineContent":[{"text":"no wire call","type":"text"}]},{"type":"text","text":" when there is no session."}],"type":"paragraph"}]}],"abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/users\/me\/resend-verification"},{"type":"text","text":" (CONTRACT.md §25.1, §25.7) — resend the"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"signed-in caller’s own"}]},{"type":"text","text":" verification mail, and say what happened."}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/resendownverification()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Method","title":"resendOwnVerification()","modules":[{"name":"AxiamSDK"}],"extendedModule":"AxiamSDK","symbolKind":"method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resendOwnVerification"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"externalID":"s:8AxiamSDK0A6Client