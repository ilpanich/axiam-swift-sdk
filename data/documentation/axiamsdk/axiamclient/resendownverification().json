{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resendOwnVerification"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Takes no address. The server reads it off the caller’s own record, and this signature"},{"type":"text","text":" "},{"type":"text","text":"deliberately offers no way to name a different one: a parameter here would let an"},{"type":"text","text":" "},{"type":"text","text":"authenticated session mail an arbitrary address."}]},{"type":"paragraph","inlineContent":[{"text":"Unlike ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendVerification(email:tenantID:)","type":"reference","isActive":true},{"text":" this reports the outcome, because the","type":"text"},{"text":" ","type":"text"},{"text":"caller is signed in to the account it is asking about and none of the outcomes tells","type":"text"},{"text":" ","type":"text"},{"text":"it anything it did not already bring with it:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"returns — a token was minted and the mail "},{"type":"strong","inlineContent":[{"type":"text","text":"enqueued"}]},{"type":"text","text":". Delivery is asynchronous"},{"type":"text","text":" "},{"type":"text","text":"and can still fail at the provider; a queue that accepts everything in front of a"},{"type":"text","text":" "},{"type":"text","text":"provider that rejects it looks exactly like this succeeding (§25.7 rule 3)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AxiamError.authz"},{"type":"text","text":" (from "},{"type":"codeVoice","code":"409"},{"type":"text","text":") — already verified, or an account state that must"},{"type":"text","text":" "},{"type":"text","text":"not be sent a live token."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AxiamError.network"},{"text":" (from ","type":"text"},{"type":"codeVoice","code":"429"},{"text":") — the daily resend limit.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"§25.7 rule 2 forbids falling back to the unauthenticated endpoint on either failure,"},{"type":"text","text":" "},{"type":"text","text":"and this SDK does not: that fallback turns both back into a silent success and"},{"type":"text","text":" "},{"type":"text","text":"restores the bug this operation exists to fix, with an extra round trip."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Refused client-side with "},{"type":"strong","inlineContent":[{"type":"text","text":"no wire call"}]},{"type":"text","text":" when there is no session."}]}]}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/resendownverification()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"code":"POST \/api\/v1\/users\/me\/resend-verification","type":"codeVoice"},{"text":" (CONTRACT.md §25.1, §25.7) — resend the","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"signed-in caller’s own","type":"text"}]},{"text":" verification mail, and say what happened.","type":"text"}],"metadata":{"roleHeading":"Instance Method","externalID":"s:8AxiamSDK0A6ClientC21resendOwnVerificationyyYaKF","role":"symbol","modules":[{"name":"AxiamSDK"}],"symbolKind":"method","title":"resendOwnVerification()","extendedModule":"AxiamSDK","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"ki