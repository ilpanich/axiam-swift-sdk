"code":"POST \/api\/v1\/auth\/resend-verification"},{"text":" (CONTRACT.md §25.1) — the","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"unauthenticated","type":"text"}]},{"text":" resend, for a caller with no session.","type":"text"}],"url":"\/documentation\/axiamsdk\/axiamclient\/resendverification(email:tenantid:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendVerification(email:tenantID:)","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/resendOwnVerification()":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendOwnVerification()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resendOwnVerification"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"title":"resendOwnVerification()","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\/resendownverification()","abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/users\/me\/resend-verification"},{"type":"text","text":" (CONTRACT.md §25.1, §25.7) — resend the"},{"type":"text","text":" "},{"inlineContent":[{"text":"signed-in caller’s own","type":"text"}],"type":"strong"},{"type":"text","text":" verification mail, and say what happened."}],"role":"symbol","type":"topic"}}}