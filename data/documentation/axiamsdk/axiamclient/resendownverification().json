{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resendOwnVerification","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Takes no address. The server reads it off the caller’s own record, and this signature"},{"type":"text","text":" "},{"type":"text","text":"deliberately offers no way to name a different one: a parameter here would let an"},{"type":"text","text":" "},{"type":"text","text":"authenticated session mail an arbitrary address."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendVerification(email:tenantID:)","type":"reference","isActive":true},{"type":"text","text":" this reports the outcome, because the"},{"type":"text","text":" "},{"type":"text","text":"caller is signed in to the account it is asking about and none of the outcomes tells"},{"type":"text","text":" "},{"type":"text","text":"it anything it did not already bring with it:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"returns — a token was minted and the mail "},{"inlineContent":[{"text":"enqueued","type":"text"}],"type":"strong"},{"type":"text","text":". Delivery is asynchronous"},{"type":"text","text":" "},{"type":"text","text":"and can still fail at the provider; a queue that accepts everything in front of a"},{"type":"text","text":" "},{"type":"text","text":"provider that rejects it looks exactly like this succeeding (§25.7 rule 3)."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"AxiamError.authz"},{"type":"text","text":" (from "},{"type":"codeVoice","code":"409"},{"type":"text","text":") — already verified, or an account state that must"},{"type":"text","text":" "},{"type":"text","text":"not be sent a live token."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AxiamError.network"},{"type":"text","text":" (from "},{"type":"codeVoice","code":"429"},{"type":"text","text":") — the daily resend limit."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"§25.7 rule 2 forbids falling back to the unauthenticated endpoint on either failure,","type":"text"},{"text":" ","type":"text"},{"text":"and this SDK does not: that fallback turns both back into a silent success and","type":"text"},{"text":" ","type":"text"},{"text":"restores the bug this operation exists to fix, with an extra round trip.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Refused client-side with "},{"inlineContent":[{"type":"text","text":"no wire call"}],"type":"strong"},{"type":"text","text":" when there is no session."}]}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/resendownverification()"]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","roleHeading":"Instance Method","extendedModule":"AxiamSDK","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resendOwnVerification","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"title":"resendOwnVerification()","externalID":"s:8AxiamSDK0A6ClientC21resendOwnVerificationyyYaKF","symbolKind":"method","modules":[{"name":"AxiamSDK"}]},"abstract":[{"code":"POST \/api\/v1\/users\/me\/resend-verification","type":"codeVoice"},{"text":" (CONTRACT.md §25.1, §25.7) — resend the","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"signed-in caller’s own"}]},{"text":" verification mail, and say what happened.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendOwnVerification()"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamclient","type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/resendVerification(email:tenantID:)":{"url":"\/documentation\/axiamsdk\/axiamclient\/resendverification(email:tenantid:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendVerification(email:tenantID:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resendVerification","kind":"identifier"},{"text":"(","kind":"text"},{"text":"email","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol","type":"topic","title":"resendVerification(email:tenantID:)","abstract":[{"code":"POST \/api\/v1\/auth\/resend-verification","type":"codeVoice"},{"text":" (CONTRACT.md §25.1) — the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"unauthenticated","type":"text"}],"type":"strong"},{"text":" resend, for a caller with no session.","type":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/resendOwnVerification()":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendOwnVerification()","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\/resendownverification()","title":"resendOwnVerification()","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resendOwnVerification","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"abstract":[{"code":"POST \/api\/v1\/users\/me\/resend-verification","type":"codeVoice"},{"text":" (CONTRACT.md §25.1, §25.7) — resend the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"signed-in caller’s own","type":"text"}],"type":"strong"},{"text":" verification mail, and say what happened.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]}}}