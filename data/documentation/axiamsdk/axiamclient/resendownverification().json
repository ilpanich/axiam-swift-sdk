{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/users\/me\/resend-verification"},{"type":"text","text":" (CONTRACT.md §25.1, §25.7) — resend the"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"signed-in caller’s own"}]},{"type":"text","text":" verification mail, and say what happened."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resendOwnVerification","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"text":"Takes no address. The server reads it off the caller’s own record, and this signature","type":"text"},{"text":" ","type":"text"},{"text":"deliberately offers no way to name a different one: a parameter here would let an","type":"text"},{"text":" ","type":"text"},{"text":"authenticated session mail an arbitrary address.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Unlike "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/resendVerification(email:tenantID:)"},{"type":"text","text":" this reports the outcome, because the"},{"type":"text","text":" "},{"type":"text","text":"caller is signed in to the account it is asking about and none of the outcomes tells"},{"type":"text","text":" "},{"type":"text","text":"it anything it did not already bring with it:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"returns — a token was minted and the mail ","type":"text"},{"type":"strong","inlineContent":[{"text":"enqueued","type":"text"}]},{"text":". Delivery is asynchronous","type":"text"},{"text":" ","type":"text"},{"text":"and can still fail at the provider; a queue that accepts everything in front of a","type":"text"},{"text":" ","type":"text"},{"text":"provider that rejects it looks exactly like this succeeding (§25.7 rule 3).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"AxiamError.authz","type":"codeVoice"},{"type":"text","text":" (from "},{"code":"409","type":"codeVoice"},{"type":"text","text":") — already verified, or an account state that must"},{"type":"text","text":" "},{"type":"text","text":"not be sent a live token."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"AxiamError.network","type":"codeVoice"},{"text":" (from ","type":"text"},{"code":"429","type":"codeVoice"},{"text":") — the daily resend limit.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"§25.7 rule 2 forbids falling back to the unauthenticated endpoint on either failure,"},{"type":"text","text":" "},{"type":"text","text":"and this SDK does not: that fallback turns both back into a silent success and"},{"type":"text","text":" "},{"type":"text","text":"restores the bug this operation exists to fix, with an extra round trip."}],"type":"paragraph"},{"inlineContent":[{"text":"Refused client-side with ","type":"text"},{"inlineContent":[{"text":"no wire call","type":"text"}],"type":"strong"},{"text":" when there is no session.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/resendownverification()"]}],"metadata":{"externalID":"s:8AxiamSDK0A6ClientC21resendOwnVerificationyyYaKF","extendedModule":"AxiamSDK","roleHeading":"Instance Method","role":"symbol","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"