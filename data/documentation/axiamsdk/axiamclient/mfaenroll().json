{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"code":"POST \/api\/v1\/auth\/mfa\/enroll","type":"codeVoice"},{"type":"text","text":" (CONTRACT.md §25.1) — start voluntary TOTP enrolment"},{"type":"text","text":" "},{"type":"text","text":"for the signed-in user."}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/mfaenroll()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mfaEnroll"},{"kind":"text","text":"() "},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"MfaEnrollment","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MfaEnrollment","preciseIdentifier":"s:8AxiamSDK13MfaEnrollmentV"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Changes nothing about the current session. In particular it does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" clear the"},{"type":"text","text":" "},{"type":"text","text":"§17 decision memo: the subject has not changed, and discarding a warm memo on an"},{"type":"text","text":" "},{"type":"text","text":"unrelated profile action costs a round trip on every check that follows"},{"type":"text","text":" "},{"type":"text","text":"(§25.2 rule 3)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Enrolment is two calls and this is only the first: the factor is not active until"},{"type":"text","text":" "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/mfaConfirm(_:)","isActive":true,"type":"reference"},{"type":"text","text":" accepts a code derived from the returned secret. §25.2 rule 4"},{"type":"text","text":" "},{"type":"text","text":"forbids a composed one-call helper here, because the human step in the middle —"},{"type":"text","text":" "},{"type":"text","text":"scanning the URI, reading a code — is not something a helper can wait for."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/mfaEnroll()"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"metadata":{"roleHeading":"Instance Method","extendedModule":"AxiamSDK","externalID":"s:8AxiamSDK0A6ClientC9mfaEnrollAA13MfaEnrollmentVyYaKF","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mfaEnroll","kind":"identifier"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"MfaEnrollment","preciseIdentifier":"s:8AxiamSDK13MfaEnrollmentV"}],"modules":[{"name":"AxiamSDK"}],"symbolKind":"method","title":"mfaEnroll()"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"title":"AxiamClient","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamclient","abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/mfaEnroll()":{"kind":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\/mfaenroll()","type":"topic","title":"mfaEnroll()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mfaEnroll"},{"kind":"text","text":"() "},{"kind":"keyword","text