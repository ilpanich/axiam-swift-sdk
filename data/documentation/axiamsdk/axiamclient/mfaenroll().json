{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mfaEnroll","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"MfaEnrollment","preciseIdentifier":"s:8AxiamSDK13MfaEnrollmentV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MfaEnrollment","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Changes nothing about the current session. In particular it does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" clear the"},{"type":"text","text":" "},{"type":"text","text":"§17 decision memo: the subject has not changed, and discarding a warm memo on an"},{"type":"text","text":" "},{"type":"text","text":"unrelated profile action costs a round trip on every check that follows"},{"type":"text","text":" "},{"type":"text","text":"(§25.2 rule 3)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enrolment is two calls and this is only the first: the factor is not active until"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/mfaConfirm(_:)"},{"type":"text","text":" accepts a code derived from the returned secret. §25.2 rule 4"},{"type":"text","text":" "},{"type":"text","text":"forbids a composed one-call helper here, because the human step in the middle —"},{"type":"text","text":" "},{"type":"text","text":"scanning the URI, reading a code — is not something a helper can wait for."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamcl