yword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","text":"RequestingPartyToken","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"Unlike the Protection API above, this is a token-endpoint grant: the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"client"}]},{"text":" authenticates","type":"text"},{"text":" ","type":"text"},{"text":"through the form body (","type":"text"},{"type":"codeVoice","code":"client_secret_post"},{"text":"), so ","type":"text"},{"type":"codeVoice","code":"credentials"},{"text":" is required.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What this method deliberately does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" do:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No retry, ever"}],"type":"strong"},{"text":" (§20.2 rule 6) — not on ","type":"text"},{"code":"5xx","type":"codeVoice"},{"text":", not on a timeout, not on","type":"text"},{"text":" ","type":"text"},{"code":"invalid_grant","type":"codeVoice"},{"text":". This is the one documented exception to §16, and a security rule rather","type":"text"},{"text":" ","type":"text"},{"text":"than a performance one: the ticket is consumed ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"text":" the request is evaluated, so a","type":"text"},{"text":" ","type":"text"},{"text":"failed exchange has already spent it, and a retry is a second redemption — exactly the","type":"text"},{"text":" ","type":"text"},{"text":"concurrent redemption a server whose storage engine this SDK cannot attest may admit","type":"text"},{"text":" ","type":"text"},{"text":"twice (","type":"text"},{"code":"ilpanich\/axiam#302","type":"codeVoice"},{"text":"). The property","type":"text"},{"text":" ","type":"text"},{"text":"holds structurally here: this call goes through ","type":"text"},{"code":"AxiamClient\/rawSend(method:path:body:)","type":"codeVoice"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"text":"absolute-URL sibling and never enters ","type":"text"},{"code":"retryingPOST(operation:path:body:)","type":"codeVoice"},{"text":"’s budget.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No defaulted ","type":"text"},{"code":"claimToken","type":"codeVoice"}],"type":"strong"},{"text":" (rule 2). It is the only channel that names the requesting","type":"text"},{"text":" ","type":"text"},{"text":"party; defaulting it to the resource server’s own PAT would mint an RPT for the resource","type":"text"},{"text":" ","type":"text"},{"text":"server rather than for the user. An empty one is refused client-side, with no wire call,","type":"text"},{"text":" ","type":"text"},{"text":"so a request that could not have succeeded never spends a ticket.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"No auto-narrowing on ","type":"text"},{"code":"access_denied","type":"codeVoice"}]},{"type":"text","text":" (rule 3). A partial grant is refused whole, and"},{"type":"text","text":" "},{"type":"text","text":"whether two-of-three permissions is useful is the calling application’s judgement."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No adoption"}],"type":"strong"},{"text":" (rule 4). The RPT is the ","type":"text"},{"inlineContent":[{"type":"text","text":"requesting party’s"}],"type":"emphasis"},{"text":" token; adopting it would","type":"text"},{"text":" ","type":"text"},{"text":"re-privilege every later call this resource server makes as that user. This client has no","type":"text"},{"text":" ","type":"text"},{"text":"bearer-credential slot to adopt into at all — its session lives in ","type":"text"},{"code":"httpOnly","type":"codeVoice"},{"text":" cookies —","type":"text"},{"text":" ","type":"text"},{"text":"so the rule holds by construction.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No refresh token"}],"type":"strong"},{"type":"text","text":" (rule 5) — the grant issues none, and "},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","type":"reference"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"nowhere to put one."}]}]}]},{"inlineContent":[{"text":"The four ticket refusals — unknown, expired, already used, minted by another client — all","type":"text"},{"text":" ","type":"text"},{"text":"arrive as one ","type":"text"},{"code":"invalid_grant","type":"codeVoice"},{"text":", and this SDK does not guess which (§20.4): the server","type":"text"},{"text":" ","type":"text"},{"text":"collapses them because telling them apart lets a caller probe for live ticket handles.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/RequestingPartyToken":{"type":"topic","role":"symbol","url":"\/documentation\/axiamsdk\/requestingpartytoken","title":"RequestingPartyToken","abstract":[{"type":"text","text":"The result of the UMA ticket grant (§20.1)."}],"navigatorTitle":[{"kind":"identifier","text":"RequestingPartyToken"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RequestingPartyToken"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift S