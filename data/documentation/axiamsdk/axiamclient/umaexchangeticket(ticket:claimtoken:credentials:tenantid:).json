{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"umaExchangeTicket"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ticket"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"claimToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"credentials"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","text":"UmaClientCredentials","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaClientCredentials"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV","text":"RequestingPartyToken","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken"}]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Unlike the Protection API above, this is a token-endpoint grant: the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"client"}]},{"text":" authenticates","type":"text"},{"text":" ","type":"text"},{"text":"through the form body (","type":"text"},{"code":"client_secret_post","type":"codeVoice"},{"text":"), so ","type":"text"},{"code":"credentials","type":"codeVoice"},{"text":" is required.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"What this method deliberately does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" do:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No retry, ever","type":"text"}]},{"type":"text","text":" (§20.2 rule 6) — not on "},{"code":"5xx","type":"codeVoice"},{"type":"text","text":", not on a timeout, not on"},{"type":"text","text":" "},{"code":"invalid_grant","type":"codeVoice"},{"type":"text","text":". This is the one documented exception to §16, and a security rule rather"},{"type":"text","text":" "},{"type":"text","text":"than a performance one: the ticket is consumed "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the request is evaluated, so a"},{"type":"text","text":" "},{"type":"text","text":"failed exchange has already spent it, and a retry is a second redemption — exactly the"},{"type":"text","text":" "},{"type":"text","text":"concurrent redemption a server whose storage engine this SDK cannot attest may admit"},{"type":"text","text":" "},{"type":"text","text":"twice ("},{"code":"ilpanich\/axiam#302","type":"codeVoice"},{"type":"text","text":"). The property"},{"type":"text","text":" "},{"type":"text","text":"holds structurally here: this call goes through "},{"code":"AxiamClient\/rawSend(method:path:body:)","type":"codeVoice"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"text","text":"absolute-URL sibling and never enters "},{"code":"retryingPOST(operation:path:body:)","type":"codeVoice"},{"type":"text","text":"’s budget."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No defaulted ","type":"text"},{"type":"codeVoice","code":"claimToken"}]},{"type":"text","text":" (rule 2). It is the only channel that names the requesting"},{"type":"text","text":" "},{"type":"text","text":"party; defaulting it to the resource server’s own PAT would mint an RPT for the resource"},{"type":"text","text":" "},{"type":"text","text":"server rather than for the user. An empty one is refused client-side, with no wire call,"},{"type":"text","text":" "},{"type":"text","text":"so a request that could not have succeeded never spends a ticket."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No auto-narrowing on "},{"type":"codeVoice","code":"access_denied"}]},{"type":"text","text":" (rule 3). A partial grant is refused whole, and"},{"type":"text","text":" "},{"type":"text","text":"whether two-of-three permissions is useful is the calling application’s judgement."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No adoption"}],"type":"strong"},{"type":"text","text":" (rule 4). The RPT is the "},{"inlineContent":[{"type":"text","text":"requesting party’s"}],"type":"emphasis"},{"type":"text","text":" token; adopting it would"},{"type":"text","text":" "},{"type":"text","text":"re-privilege every later call this resource server makes as that user. This client has no"},{"type":"text","text":" "},{"type":"text","text":"bearer-credential slot to adopt into at all — its session lives in "},{"code":"httpOnly","type":"codeVoice"},{"type":"text","text":" cookies —"},{"type":"text","text":" "},{"type":"text","text":"so the rule holds by construction."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No refresh token"}],"type":"strong"},{"text":" (rule 5) — the grant issues none, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","type":"reference"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"nowhere to put one.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The four ticket refusals — unknown, expired, already used, minted by another client — all","type":"text"},{"text":" ","type":"text"},{"text":"arrive as one ","type":"text"},{"type":"codeVoice","code":"invalid_grant"},{"text":", and this SDK does not guess which (§20.4): the server","type":"text"},{"text":" ","type":"text"},{"text":"collapses them because telling them apart lets a caller probe for live ticket handles.","type":"text"}]}],"kind":"content"}],"sections":[],"metadata":{"symbolKind":"method","externalID":"s:8AxiamSDK0A6ClientC17umaExchangeTicket6ticket10claimToken11credentials8tenantIDAA015RequestingPartyI0VAA9SensitiveVySSG_AmA03UmaC11CredentialsVSSSgtYaKF","roleHeading":"Instance Method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"umaExchangeTicket"},{"text":"(","kind":"text"},{"text":"ticket","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"text":"claimToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"text":"credentials","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UmaClientCredentials","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"RequestingPartyToken","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV"}],"title":"umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","modules":[{"name":"AxiamSDK"}],"extendedModule":"AxiamSDK"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"kind":"symbol","abstract":[{"code":"POST \/oauth2\/token","type":"codeVoice"},{"text":" with the UMA ticket grant (§20.1) — redeem a permission ticket for a","type":"text"},{"text":" ","type":"text"},{"text":"Requesting Party Token.","type":"text"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/umaexchangeticket(ticket:claimtoken:credentials:tenantid:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/UmaClientCredentials":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaClientCredentials","kind":"symbol","url":"\/documentation\/axiamsdk\/umaclientcredentials","abstract":[{"type":"text","text":"The confidential-client credentials the ticket grant authenticates with (§20.1)."}],"role":"symbol","type":"topic","title":"UmaClientCredentials","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UmaClientCredentials"}],"navigatorTitle":[{"kind":"identifier","text":"UmaClientCredentials"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"url":"\/documentation\/axiamsdk\/axiamclient","kind":"symbol","abstract":[{"type":"text","text":"The AXIAM RE