{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"code":"POST \/oauth2\/token","type":"codeVoice"},{"text":" with the UMA ticket grant (§20.1) — redeem a permission ticket for a","type":"text"},{"text":" ","type":"text"},{"text":"Requesting Party Token.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"umaExchangeTicket"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ticket"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","text":"Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"claimToken"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","text":"Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"credentials"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaClientCredentials","text":"UmaClientCredentials"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","text":"RequestingPartyToken"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Unlike the Protection API above, this is a token-endpoint grant: the ","type":"text"},{"inlineContent":[{"text":"client","type":"text"}],"type":"emphasis"},{"text":" authenticates","type":"text"},{"text":" ","type":"text"},{"text":"through the form body (","type":"text"},{"type":"codeVoice","code":"client_secret_post"},{"text":"), so ","type":"text"},{"type":"codeVoice","code":"credentials"},{"text":" is required.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"What this method deliberately does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" do:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No retry, ever"}]},{"type":"text","text":" (§20.2 rule 6) — not on "},{"type":"codeVoice","code":"5xx"},{"type":"text","text":", not on a timeout, not on"},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":". This is the one documented exception to §16, and a security rule rather"},{"type":"text","text":" "},{"type":"text","text":"than a performance one: the ticket is consumed "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the request is evaluated, so a"},{"type":"text","text":" "},{"type":"text","text":"failed exchange has already spent it, and a retry is a second redemption — exactly the"},{"type":"text","text":" "},{"type":"text","text":"concurrent redemption a server whose storage engine this SDK cannot attest may admit"},{"type":"text","text":" "},{"type":"text","text":"twice ("},{"type":"codeVoice","code":"ilpanich\/axiam#302"},{"type":"text","text":"). The property"},{"type":"text","text":" "},{"type":"text","text":"holds structurally here: this call goes through "},{"type":"codeVoice","code":"AxiamClient\/rawSend(method:path:body:)"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"text","text":"absolute-URL sibling and never enters "},{"type":"codeVoice","code":"retryingPOST(operation:path:body:)"},{"type":"text","text":"’s budget."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No defaulted "},{"code":"claimToken","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (rule 2). It is the only channel that names the requesting"},{"type":"text","text":" "},{"type":"text","text":"party; defaulting it to the resource server’s own PAT would mint an RPT for the resource"},{"type":"text","text":" "},{"type":"text","text":"server rather than for the user. An empty one is refused client-side, with no wire call,"},{"type":"text","text":" "},{"type":"text","text":"so a request that could not have succeeded never spends a ticket."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No auto-narrowing on ","type":"text"},{"code":"access_denied","type":"codeVoice"}],"type":"strong"},{"text":" (rule 3). A partial grant is refused whole, and","type":"text"},{"text":" ","type":"text"},{"text":"whether two-of-three permissions is useful is the calling application’s judgement.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No adoption"}]},{"type":"text","text":" (rule 4). The RPT is the "},{"type":"emphasis","inlineContent":[{"text":"requesting party’s","type":"text"}]},{"type":"text","text":" token; adopting it would"},{"type":"text","text":" "},{"type":"text","text":"re-privilege every later call this resource server makes as that user. This client has no"},{"type":"text","text":" "},{"type":"text","text":"bearer-credential slot to adopt into at all — its session lives in "},{"type":"codeVoice","code":"httpOnly"},{"type":"text","text":" cookies —"},{"type":"text","text":" "},{"type":"text","text":"so the rule holds by construction."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"No refresh token","type":"text"}],"type":"strong"},{"text":" (rule 5) — the grant issues none, and ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","isActive":true,"type":"reference"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"nowhere to put one.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The four ticket refusals — unknown, expired, already used, minted by another client — all","type":"text"},{"text":" ","type":"text"},{"text":"arrive as one ","type":"text"},{"code":"invalid_grant","type":"codeVoice"},{"text":", and this SDK does not guess which (§20.4): the server","type":"text"},{"text":" ","type":"text"},{"text":"collapses them because telling them apart lets a caller probe for live ticket handles.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/umaexchangeticket(ticket:claimtoken:credentials:tenantid:)"]}],"metadata":{"title":"umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","extendedModule":"AxiamSDK","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"umaExchangeTicket"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ticket"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier","text":"Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"claimToken"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier","text":"Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"credentials"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","kind":"typeIdentifier","text":"UmaClientCredentials"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV","kind":"typeIdentifier","text":"RequestingPartyToken"}],"role":"symbol","externalID":"s:8AxiamSDK0A6ClientC17umaExchangeTicket6ticket10claimToken11credentials8tenantIDAA015RequestingPartyI0VAA9SensitiveVySSG_AmA03UmaC11CredentialsVSSSgtYaKF","modules":[{"name":"AxiamSDK"}]},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)"},"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","title":"AxiamSDK","role":"collection","kind":"symbol","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/UmaClientCredentials":{"url":"\/documentation\/axiamsdk\/umaclientcredentials","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UmaClientCredentials","kind":"identifier"}],"abstract":[{"text":"The confidential-client credentials the ticket grant authenticates with (§20.1).","type":"text"}],"type":"topic","navigatorTitle":[{"text":"UmaClientCredential