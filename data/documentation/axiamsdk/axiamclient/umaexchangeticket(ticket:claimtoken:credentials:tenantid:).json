{"abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"type":"text","text":" with the UMA ticket grant (§20.1) — redeem a permission ticket for a"},{"type":"text","text":" "},{"type":"text","text":"Requesting Party Token."}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"umaExchangeTicket"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ticket"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"claimToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"credentials"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","text":"UmaClientCredentials"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV","text":"RequestingPartyToken"}],"title":"umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","modules":[{"name":"AxiamSDK"}],"extendedModule":"AxiamSDK","externalID":"s:8AxiamSDK0A6ClientC17umaExchangeTicket6ticket10claimToken11credentials8tenantIDAA015RequestingPartyI0VAA9SensitiveVySSG_AmA03UmaC11CredentialsVSSSgtYaKF","role":"symbol","symbolKind":"method","roleHeading":"Instance Method"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/umaexchangeticket(ticket:claimtoken:credentials:tenantid:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"umaExchangeTicket","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ticket","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"claimToken","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"credentials","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaClientCredentials","text":"UmaClientCredentials","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","text":"RequestingPartyToken","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the Protection API above, this is a token-endpoint grant: the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"client"}]},{"type":"text","text":" authenticates"},{"type":"text","text":" "},{"type":"text","text":"through the form body ("},{"type":"codeVoice","code":"client_secret_post"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"credentials"},{"type":"text","text":" is required."}]},{"type":"paragraph","inlineContent":[{"text":"What this method deliberately does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" do:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No retry, ever"}],"type":"strong"},{"type":"text","text":" (§20.2 rule 6) — not on "},{"type":"codeVoice","code":"5xx"},{"type":"text","text":", not on a timeout, not on"},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":". This is the one documented exception to §16, and a security rule rather"},{"type":"text","text":" "},{"type":"text","text":"than a performance one: the ticket is consumed "},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"type":"text","text":" the request is evaluated, so a"},{"type":"text","text":" "},{"type":"text","text":"failed exchange has already spent it, and a retry is a second redemption — exactly the"},{"type":"text","text":" "},{"type":"text","text":"concurrent redemption a server whose storage engine this SDK cannot attest may admit"},{"type":"text","text":" "},{"type":"text","text":"twice ("},{"type":"codeVoice","code":"ilpanich\/axiam#302"},{"type":"text","text":"). The property"},{"type":"text","text":" "},{"type":"text","text":"holds structurally here: this call goes through "},{"type":"codeVoice","code":"AxiamClient\/rawSend(method:path:body:)"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"text","text":"absolute-URL sibling and never enters "},{"type":"codeVoice","code":"retryingPOST(operation:path:body:)"},{"type":"text","text":"’s budget."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No defaulted "},{"type":"codeVoice","code":"claimToken"}],"type":"strong"},{"text":" (rule 2). It is the only channel that names the requesting","type":"text"},{"text":" ","type":"text"},{"text":"party; defaulting it to the resource server’s own PAT would mint an RPT for the resource","type":"text"},{"text":" ","type":"text"},{"text":"server rather than for the user. An empty one is refused client-side, with no wire call,","type":"text"},{"text":" ","type":"text"},{"text":"so a request that could not have succeeded never spends a ticket.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No auto-narrowing on "},{"type":"codeVoice","code":"access_denied"}]},{"type":"text","text":" (rule 3). A partial grant is refused whole, and"},{"type":"text","text":" "},{"type":"text","text":"whether two-of-three permissions is useful is the calling application’s judgement."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No adoption"}],"type":"strong"},{"type":"text","text":" (rule 4). The RPT is the "},{"inlineContent":[{"type":"text","text":"requesting party’s"}],"type":"emphasis"},{"type":"text","text":" token; adopting it would"},{"type":"text","text":" "},{"type":"text","text":"re-privilege every later call this resource server makes as that user. This client has no"},{"type":"text","text":" "},{"type":"text","text":"bearer-credential slot to adopt into at all — its session lives in "},{"type":"codeVoice","code":"httpOnly"},{"type":"text","text":" cookies —"},{"type":"text","text":" "},{"type":"text","text":"so the rule holds by construction."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"No refresh token","type":"text"}],"type":"strong"},{"text":" (rule 5) — the grant issues none, and ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","isActive":true,"type":"reference"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"nowhere to put one.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The four ticket refusals — unknown, expired, already used, minted by another client — all"},{"type":"text","text":" "},{"type":"text","text":"arrive as one "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":", and this SDK does not guess which (§20.4): the server"},{"type":"text","text":" "},{"type":"text","text":"collapses them because telling them apart lets a caller probe for live ticket handles."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/sensitive","role":"symbol","title":"Sensitive"},"doc://AxiamSDK/documentation/AxiamSDK/UmaClientCredentials":{"title":"UmaClientCredentials","url":"\/documentation\/axiamsdk\/umaclientcredentials","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The confidential-client credentials the ticket grant authenticates with (§20.1)."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UmaClientCredentials"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaClientCredentials","navigatorTitle":[{"kind":"identifier","text":"UmaClientCredentials"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/RequestingPartyToken":{"navigatorTitle":[{"kind":"identifier","text":"RequestingPartyToken"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","url":"\/documentation\/axiamsdk\/requestingpartytoken","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RequestingPartyToken"}],"title":"RequestingPartyToken","abstract":[{"text":"The result of the UMA ticket grant (§20.1).","type":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","url":"\/documentation\/axiamsdk\/axiamclient\/umaexchangeticket(ticket:claimtoken:credentials:tenantid:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"umaExchangeTicket","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ticket","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdenti