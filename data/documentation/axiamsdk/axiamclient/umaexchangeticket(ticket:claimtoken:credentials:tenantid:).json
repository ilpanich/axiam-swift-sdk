{"abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"type":"text","text":" with the UMA ticket grant (§20.1) — redeem a permission ticket for a"},{"type":"text","text":" "},{"type":"text","text":"Requesting Party Token."}],"kind":"symbol","metadata":{"extendedModule":"AxiamSDK","symbolKind":"method","role":"symbol","roleHeading":"Instance Method","title":"umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","externalID":"s:8AxiamSDK0A6ClientC17umaExchangeTicket6ticket10claimToken11credentials8tenantIDAA015RequestingPartyI0VAA9SensitiveVySSG_AmA03UmaC11CredentialsVSSSgtYaKF","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"umaExchangeTicket","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ticket","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"text":"claimToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"text":"credentials","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UmaClientCredentials","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"RequestingPartyToken","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/umaexchangeticket(ticket:claimtoken:credentials:tenantid:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"umaExchangeTicket","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ticket","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"text":"claimToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"text":"credentials","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UmaClientCredentials","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaClientCredentials","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"RequestingPartyToken","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the Protection API above, this is a token-endpoint grant: the "},{"type":"emphasis","inlineContent":[{"text":"client","type":"text"}]},{"type":"text","text":" authenticates"},{"type":"text","text":" "},{"type":"text","text":"through the form body ("},{"type":"codeVoice","code":"client_secret_post"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"credentials"},{"type":"text","text":" is required."}]},{"type":"paragraph","inlineContent":[{"text":"What this method deliberately does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" do:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No retry, ever"}],"type":"strong"},{"type":"text","text":" (§20.2 rule 6) — not on "},{"type":"codeVoice","code":"5xx"},{"type":"text","text":", not on a timeout, not on"},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":". This is the one documented exception to §16, and a security rule rather"},{"type":"text","text":" "},{"type":"text","text":"than a performance one: the ticket is consumed "},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"type":"text","text":" the request is evaluated, so a"},{"type":"text","text":" "},{"type":"text","text":"failed exchange has already spent it, and a retry is a second redemption — exactly the"},{"type":"text","text":" "},{"type":"text","text":"concurrent redemption a server whose storage engine this SDK cannot attest may admit"},{"type":"text","text":" "},{"type":"text","text":"twice ("},{"type":"codeVoice","code":"ilpanich\/axiam#302"},{"type":"text","text":"). The property"},{"type":"text","text":" "},{"type":"text","text":"holds structurally here: this call goes through "},{"type":"codeVoice","code":"AxiamClient\/rawSend(method:path:body:)"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"text","text":"absolute-URL sibling and never enters "},{"type":"codeVoice","code":"retryingPOST(operation:path:body:)"},{"type":"text","text":"’s budget."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No defaulted ","type":"text"},{"code":"claimToken","type":"codeVoice"}]},{"type":"text","text":" (rule 2). It is the only channel that names the requesting"},{"type":"text","text":" "},{"type":"text","text":"party; defaulting it to the resource server’s own PAT would mint an RPT for the resource"},{"type":"text","text":" "},{"type":"text","text":"server rather than for the user. An empty one is refused client-side, with no wire call,"},{"type":"text","text":" "},{"type":"text","text":"so a request that could not have succeeded never spends a ticket."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No auto-narrowing on "},{"type":"codeVoice","code":"access_denied"}],"type":"strong"},{"type":"text","text":" (rule 3). A partial grant is refused whole, and"},{"type":"text","text":" "},{"type":"text","text":"whether two-of-three permissions is useful is the calling application’s judgement."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"No adoption","type":"text"}]},{"type":"text","text":" (rule 4). The RPT is the "},{"type":"emphasis","inlineContent":[{"text":"requesting party’s","type":"text"}]},{"type":"text","text":" token; adopting it would"},{"type":"text","text":" "},{"type":"text","text":"re-privilege every later call this resource server makes as that user. This client has no"},{"type":"text","text":" "},{"type":"text","text":"bearer-credential slot to adopt into at all — its session lives in "},{"type":"codeVoice","code":"httpOnly"},{"type":"text","text":" cookies —"},{"type":"text","text":" "},{"type":"text","text":"so the rule holds by construction."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"No refresh token","type":"text"}]},{"type":"text","text":" (rule 5) — the grant issues none, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"nowhere to put one."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The four ticket refusals — unknown, expired, already used, minted by another client — all","type":"text"},{"text":" ","type":"text"},{"text":"arrive as one ","type":"text"},{"code":"invalid_grant","type":"codeVoice"},{"text":", and this SDK does not guess which (§20.4): the server","type":"text"},{"text":" ","type":"text"},{"text":"collapses them because telling them apart lets a caller probe for live ticket handles.","type":"text"}]}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/UmaClientCredentials":{"navigatorTitle":[{"kind":"identifier","text":"UmaClientCredentials"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaClientCredentials","kind":"symbol","abstract":[{"type":"text","text":"The confidential-client credentials the ticket grant authenticates with (§20.1)."}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"UmaClientCredentials"}],"url":"\/documentation\/axiamsdk\/umaclientcredentials","role":"symbol","title":"UmaClientCredentials"},"doc://AxiamSDK/documentation/AxiamSDK/RequestingPartyToken":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"RequestingPartyToken"}],"type":"topic","url":"\/documentation\/axiamsdk\/requestingpartytoken","navigatorTitle":[{"kind":"identifier","text":"RequestingPartyToken"}],"abstract":[{"text":"The result of the UMA ticket grant (§20.1).","type":"text"}],"title":"RequestingPartyToken","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"type":"topic","title":"AxiamClient","abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}],"url":"\/documentation\/axiamsdk\/axiamclient","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)":{"url":"\/documentation\/axiamsdk\/axiamclient\/umaexchangeticket(ticket:claimtoken:credentials:tenantid:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"umaExchangeTicket","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ticket","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"claimToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"credentials","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UmaClientCredentials","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"RequestingPartyToken","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV"}],"kind":"symbol","abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"text":" with the UMA ticket grant (§20.1) — redeem a permission ticket for a","type":"text"},{"type":"text","text":" "},{"text":"Requesting Party Token.","type":"text"}],"role":"symbol","title":"umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)"},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"type":"topic","title":"Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"url":"\/documentation\/axiamsdk\/sensitive"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}