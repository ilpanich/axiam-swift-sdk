{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"umaExchangeTicket","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ticket","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"claimToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"credentials","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UmaClientCredentials","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaClientCredentials","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"RequestingPartyToken","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the Protection API above, this is a token-endpoint grant: the "},{"type":"emphasis","inlineContent":[{"text":"client","type":"text"}]},{"type":"text","text":" authenticates"},{"type":"text","text":" "},{"type":"text","text":"through the form body ("},{"code":"client_secret_post","type":"codeVoice"},{"type":"text","text":"), so "},{"code":"credentials","type":"codeVoice"},{"type":"text","text":" is required."}]},{"type":"paragraph","inlineContent":[{"text":"What this method deliberately does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" do:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No retry, ever"}]},{"type":"text","text":" (§20.2 rule 6) — not on "},{"type":"codeVoice","code":"5xx"},{"type":"text","text":", not on a timeout, not on"},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":". This is the one documented exception to §16, and a security rule rather"},{"type":"text","text":" "},{"type":"text","text":"than a performance one: the ticket is consumed "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the request is evaluated, so a"},{"type":"text","text":" "},{"type":"text","text":"failed exchange has already spent it, and a retry is a second redemption — exactly the"},{"type":"text","text":" "},{"type":"text","text":"concurrent redemption a server whose storage engine this SDK cannot attest may admit"},{"type":"text","text":" "},{"type":"text","text":"twice ("},{"type":"codeVoice","code":"ilpanich\/axiam#302"},{"type":"text","text":"). The property"},{"type":"text","text":" "},{"type":"text","text":"holds structurally here: this call goes through "},{"type":"codeVoice","code":"AxiamClient\/rawSend(method:path:body:)"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"text","text":"absolute-URL sibling and never enters "},{"type":"codeVoice","code":"retryingPOST(operation:path:body:)"},{"type":"text","text":"’s budget."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"No defaulted ","type":"text"},{"code":"claimToken","type":"codeVoice"}],"type":"strong"},{"text":" (rule 2). It is the only channel that names the requesting","type":"text"},{"text":" ","type":"text"},{"text":"party; defaulting it to the resource server’s own PAT would mint an RPT for the resource","type":"text"},{"text":" ","type":"text"},{"text":"server rather than for the user. An empty one is refused client-side, with no wire call,","type":"text"},{"text":" ","type":"text"},{"text":"so a request that could not have succeeded never spends a ticket.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No auto-narrowing on ","type":"text"},{"code":"access_denied","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (rule 3). A partial grant is refused whole, and"},{"type":"text","text":" "},{"type":"text","text":"whether two-of-three permissions is useful is the calling application’s judgement."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No adoption"}],"type":"strong"},{"text":" (rule 4). The RPT is the ","type":"text"},{"inlineContent":[{"text":"requesting party’s","type":"text"}],"type":"emphasis"},{"text":" token; adopting it would","type":"text"},{"text":" ","type":"text"},{"text":"re-privilege every later call this resource server makes as that user. This client has no","type":"text"},{"text":" ","type":"text"},{"text":"bearer-credential slot to adopt into at all — its session lives in ","type":"text"},{"code":"httpOnly","type":"codeVoice"},{"text":" cookies —","type":"text"},{"text":" ","type":"text"},{"text":"so the rule holds by construction.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No refresh token","type":"text"}],"type":"strong"},{"text":" (rule 5) — the grant issues none, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"nowhere to put one.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The four ticket refusals — unknown, expired, already used, minted by another client — all"},{"type":"text","text":" "},{"type":"text","text":"arrive as one "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":", and this SDK does not guess which (§20.4): the server"},{"type":"text","text":" "},{"type":"text","text":"collapses them because telling them apart lets a caller probe for live ticket handles."}]}]}],"metadata":{"title":"umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"umaExchangeTicket","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ticket","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"claimToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"credentials","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UmaClientCredentials","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text