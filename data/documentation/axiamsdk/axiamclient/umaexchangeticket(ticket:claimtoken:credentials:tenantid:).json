{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"title":"umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","externalID":"s:8AxiamSDK0A6ClientC17umaExchangeTicket6ticket10claimToken11credentials8tenantIDAA015RequestingPartyI0VAA9SensitiveVySSG_AmA03UmaC11CredentialsVSSSgtYaKF","extendedModule":"AxiamSDK","symbolKind":"method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"umaExchangeTicket"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ticket"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"claimToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"credentials"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","text":"UmaClientCredentials"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV","text":"RequestingPartyToken"}],"modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"text":" with the UMA ticket grant (§20.1) — redeem a permission ticket for a","type":"text"},{"text":" ","type":"text"},{"text":"Requesting Party Token.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/umaexchangeticket(ticket:claimtoken:credentials:tenantid:)"]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"umaExchangeTicket"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ticket"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"claimToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"credentials"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","text":"UmaClientCredentials","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaClientCredentials"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV","text":"RequestingPartyToken","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken"}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Unlike the Protection API above, this is a token-endpoint grant: the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"client"}]},{"text":" authenticates","type":"text"},{"text":" ","type":"text"},{"text":"through the form body (","type":"text"},{"type":"codeVoice","code":"client_secret_post"},{"text":"), so ","type":"text"},{"type":"codeVoice","code":"credentials"},{"text":" is required.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"What this method deliberately does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" do:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No retry, ever"}]},{"text":" (§20.2 rule 6) — not on ","type":"text"},{"type":"codeVoice","code":"5xx"},{"text":", not on a timeout, not on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"invalid_grant"},{"text":". This is the one documented exception to §16, and a security rule rather","type":"text"},{"text":" ","type":"text"},{"text":"than a performance one: the ticket is consumed ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" the request is evaluated, so a","type":"text"},{"text":" ","type":"text"},{"text":"failed exchange has already spent it, and a retry is a second redemption — exactly the","type":"text"},{"text":" ","type":"text"},{"text":"concurrent redemption a server whose storage engine this SDK cannot attest may admit","type":"text"},{"text":" ","type":"text"},{"text":"twice (","type":"text"},{"type":"codeVoice","code":"ilpanich\/axiam#302"},{"text":"). The property","type":"text"},{"text":" ","type":"text"},{"text":"holds structurally here: this call goes through ","type":"text"},{"type":"codeVoice","code":"AxiamClient\/rawSend(method:path:body:)"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"text":"absolute-URL sibling and never enters ","type":"text"},{"type":"codeVoice","code":"retryingPOST(operation:path:body:)"},{"text":"’s budget.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No defaulted "},{"type":"codeVoice","code":"claimToken"}],"type":"strong"},{"type":"text","text":" (rule 2). It is the only channel that names the requesting"},{"type":"text","text":" "},{"type":"text","text":"party; defaulting it to the resource server’s own PAT would mint an RPT for the resource"},{"type":"text","text":" "},{"type":"text","text":"server rather than for the user. An empty one is refused client-side, with no wire call,"},{"type":"text","text":" "},{"type":"text","text":"so a request that could not have succeeded never spends a ticket."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"No auto-narrowing on ","type":"text"},{"type":"codeVoice","code":"access_denied"}],"type":"strong"},{"text":" (rule 3). A partial grant is refused whole, and","type":"text"},{"text":" ","type":"text"},{"text":"whether two-of-three permissions is useful is the calling application’s judgement.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"No adoption","type":"text"}]},{"type":"text","text":" (rule 4). The RPT is the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"requesting party’s"}]},{"type":"text","text":" token; adopting it would"},{"type":"text","text":" "},{"type":"text","text":"re-privilege every later call this resource server makes as that user. This client has no"},{"type":"text","text":" "},{"type":"text","text":"bearer-credential slot to adopt into at all — its session lives in "},{"type":"codeVoice","code":"httpOnly"},{"type":"text","text":" cookies —"},{"type":"text","text":" "},{"type":"text","text":"so the rule holds by construction."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"No refresh token","type":"text"}]},{"type":"text","text":" (rule 5) — the grant issues none, and "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","type":"reference","isActive":true},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"nowhere to put one."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The four ticket refusals — unknown, expired, already used, minted by another client — all"},{"type":"text","text":" "},{"type":"text","text":"arrive as one "},{"code":"invalid_grant","type":"codeVoice"},{"type":"text","text":", and this SDK does not guess which (§20.4): the server"},{"type":"text","text":" "},{"type":"text","text":"collapses them because telling them apart lets a caller probe for live ticket handles."}],"type":"paragraph"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"title":"AxiamClient","kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"url":"\/documentation\/axiamsdk\/axiamclient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)":{"type":"topic","url":"\/documentation\/axiamsdk\/axiamclient\/umaexchangeticket(ticket:claimtoken:credentials:tenantid:)","abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"type":"text","text":" with the UMA ticket grant (§20.1) — redeem a permission ticket for a"},{"type":"text","text":" "},{"type":"text","text":"Requesting Party Token."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"umaExchangeTicket","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ticket","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"claimToken","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"credentials","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","text":"UmaClientCredentials","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV","kind":"typeIdentifier","text":"RequestingPartyToken"}],"kind":"symbol","title":"umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","role":"symbol","id