{"abstract":[{"type":"codeVoice","code":"POST \/oauth2\/token"},{"type":"text","text":" with the UMA ticket grant (§20.1) — redeem a permission ticket for a"},{"type":"text","text":" "},{"type":"text","text":"Requesting Party Token."}],"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"metadata":{"extendedModule":"AxiamSDK","symbolKind":"method","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method","externalID":"s:8AxiamSDK0A6ClientC17umaExchangeTicket6ticket10claimToken11credentials8tenantIDAA015RequestingPartyI0VAA9SensitiveVySSG_AmA03UmaC11CredentialsVSSSgtYaKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"umaExchangeTicket","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ticket","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"text":"claimToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"text":"credentials","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UmaClientCredentials","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"RequestingPartyToken","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV"}],"role":"symbol","title":"umaExchangeTicket(ticket:claimToken:credentials:tenantID:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"umaExchangeTicket"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ticket"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","kind":"typeIdentifier","text":"Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"claimToken"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","kind":"typeIdentifier","text":"Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"credentials"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaClientCredentials","kind":"typeIdentifier","text":"UmaClientCredentials"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","kind":"typeIdentifier","text":"RequestingPartyToken"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the Protection API above, this is a token-endpoint grant: the "},{"type":"emphasis","inlineContent":[{"text":"client","type":"text"}]},{"type":"text","text":" authenticates"},{"type":"text","text":" "},{"type":"text","text":"through the form body ("},{"code":"client_secret_post","type":"codeVoice"},{"type":"text","text":"), so "},{"code":"credentials","type":"codeVoice"},{"type":"text","text":" is required."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What this method deliberately does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" do:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"No retry, ever","type":"text"}],"type":"strong"},{"text":" (§20.2 rule 6) — not on ","type":"text"},{"code":"5xx","type":"codeVoice"},{"text":", not on a timeout, not on","type":"text"},{"text":" ","type":"text"},{"code":"invalid_grant","type":"codeVoice"},{"text":". This is the one documented exception to §16, and a security rule rather","type":"text"},{"text":" ","type":"text"},{"text":"than a performance one: the ticket is consumed ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"text":" the request is evaluated, so a","type":"text"},{"text":" ","type":"text"},{"text":"failed exchange has already spent it, and a retry is a second redemption — exactly the","type":"text"},{"text":" ","type":"text"},{"text":"concurrent redemption a server whose storage engine this SDK cannot attest may admit","type":"text"},{"text":" ","type":"text"},{"text":"twice (","type":"text"},{"code":"ilpanich\/axiam#302","type":"codeVoice"},{"text":"). The property","type":"text"},{"text":" ","type":"text"},{"text":"holds structurally here: this call goes through ","type":"text"},{"code":"AxiamClient\/rawSend(method:path:body:)","type":"codeVoice"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"text":"absolute-URL sibling and never enters ","type":"text"},{"code":"retryingPOST(operation:path:body:)","type":"codeVoice"},{"text":"’s budget.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No defaulted "},{"code":"claimToken","type":"codeVoice"}]},{"text":" (rule 2). It is the only channel that names the requesting","type":"text"},{"text":" ","type":"text"},{"text":"party; defaulting it to the resource server’s own PAT would mint an RPT for the resource","type":"text"},{"text":" ","type":"text"},{"text":"server rather than for the user. An empty one is refused client-side, with no wire call,","type":"text"},{"text":" ","type":"text"},{"text":"so a request that could not have succeeded never spends a ticket.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No auto-narrowing on "},{"type":"codeVoice","code":"access_denied"}],"type":"strong"},{"text":" (rule 3). A partial grant is refused whole, and","type":"text"},{"text":" ","type":"text"},{"text":"whether two-of-three permissions is useful is the calling application’s judgement.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"No adoption","type":"text"}],"type":"strong"},{"type":"text","text":" (rule 4). The RPT is the "},{"inlineContent":[{"type":"text","text":"requesting party’s"}],"type":"emphasis"},{"type":"text","text":" token; adopting it would"},{"type":"text","text":" "},{"type":"text","text":"re-privilege every later call this resource server makes as that user. This client has no"},{"type":"text","text":" "},{"type":"text","text":"bearer-credential slot to adopt into at all — its session lives in "},{"code":"httpOnly","type":"codeVoice"},{"type":"text","text":" cookies —"},{"type":"text","text":" "},{"type":"text","text":"so the rule holds by construction."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No refresh token","type":"text"}]},{"type":"text","text":" (rule 5) — the grant issues none, and "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","isActive":true},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"nowhere to put one."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The four ticket refusals — unknown, expired, already used, minted by another client — all"},{"type":"text","text":" "},{"type":"text","text":"arrive as one "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":", and this SDK does not guess which (§20.4): the server"},{"type":"text","text":" "},{"type":"text","text":"collapses them because telling them apart lets a caller probe for live ticket handles."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/umaexchangeticket(ticket:claimtoken:credentials:tenantid:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"navigatorTitle":[{"kind":"identifier","text":"AxiamClient"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamClient"}],"url":"\/documentation\/axiamsdk\/axiamclient","abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","title":"AxiamClient","role":"symbol","kind":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"umaExchangeTicket","kind":"identifier"},{"text":"(","ki