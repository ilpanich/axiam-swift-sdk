{"sections":[],"metadata":{"extendedModule":"AxiamSDK","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"umaExchangeTicket"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ticket"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"claimToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"credentials"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UmaClientCredentials","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"RequestingPartyToken","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV"}],"modules":[{"name":"AxiamSDK"}],"title":"umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","externalID":"s:8AxiamSDK0A6ClientC17umaExchangeTicket6ticket10claimToken11credentials8tenantIDAA015RequestingPartyI0VAA9SensitiveVySSG_AmA03UmaC11CredentialsVSSSgtYaKF","role":"symbol"},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/umaexchangeticket(ticket:claimtoken:credentials:tenantid:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaExchangeTicket(ticket:claimToken:credentials:tenantID:)","interfaceLanguage":"swift"},"abstract":[{"code":"POST \/oauth2\/token","type":"codeVoice"},{"type":"text","text":" with the UMA ticket grant (§20.1) — redeem a permission ticket for a"},{"type":"text","text":" "},{"text":"Requesting Party Token.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"umaExchangeTicket"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ticket"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"claimToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"credentials"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UmaClientCredentials","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaClientCredentials","preciseIdentifier":"s:8AxiamSDK20UmaClientCredentialsV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"RequestingPartyToken","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","preciseIdentifier":"s:8AxiamSDK20RequestingPartyTokenV"}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Unlike the Protection API above, this is a token-endpoint grant: the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"client"}]},{"text":" authenticates","type":"text"},{"text":" ","type":"text"},{"text":"through the form body (","type":"text"},{"type":"codeVoice","code":"client_secret_post"},{"text":"), so ","type":"text"},{"type":"codeVoice","code":"credentials"},{"text":" is required.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"What this method deliberately does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" do:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No retry, ever"}],"type":"strong"},{"type":"text","text":" (§20.2 rule 6) — not on "},{"code":"5xx","type":"codeVoice"},{"text":", not on a timeout, not on","type":"text"},{"text":" ","type":"text"},{"code":"invalid_grant","type":"codeVoice"},{"text":". This is the one documented exception to §16, and a security rule rather","type":"text"},{"text":" ","type":"text"},{"text":"than a performance one: the ticket is consumed ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" the request is evaluated, so a","type":"text"},{"text":" ","type":"text"},{"text":"failed exchange has already spent it, and a retry is a second redemption — exactly the","type":"text"},{"text":" ","type":"text"},{"text":"concurrent redemption a server whose storage engine this SDK cannot attest may admit","type":"text"},{"text":" ","type":"text"},{"text":"twice (","type":"text"},{"code":"ilpanich\/axiam#302","type":"codeVoice"},{"text":"). The property","type":"text"},{"text":" ","type":"text"},{"text":"holds structurally here: this call goes through ","type":"text"},{"code":"AxiamClient\/rawSend(method:path:body:)","type":"codeVoice"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"text":"absolute-URL sibling and never enters ","type":"text"},{"code":"retryingPOST(operation:path:body:)","type":"codeVoice"},{"text":"’s budget.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No defaulted "},{"type":"codeVoice","code":"claimToken"}],"type":"strong"},{"type":"text","text":" (rule 2). It is the only channel that names the requesting"},{"type":"text","text":" "},{"type":"text","text":"party; defaulting it to the resource server’s own PAT would mint an RPT for the resource"},{"type":"text","text":" "},{"type":"text","text":"server rather than for the user. An empty one is refused client-side, with no wire call,"},{"type":"text","text":" "},{"type":"text","text":"so a request that could not have succeeded never spends a ticket."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No auto-narrowing on ","type":"text"},{"code":"access_denied","type":"codeVoice"}]},{"type":"text","text":" (rule 3). A partial grant is refused whole, and"},{"type":"text","text":" "},{"type":"text","text":"whether two-of-three permissions is useful is the calling application’s judgement."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No adoption"}]},{"type":"text","text":" (rule 4). The RPT is the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"requesting party’s"}]},{"type":"text","text":" token; adopting it would"},{"type":"text","text":" "},{"type":"text","text":"re-privilege every later call this resource server makes as that user. This client has no"},{"type":"text","text":" "},{"type":"text","text":"bearer-credential slot to adopt into at all — its session lives in "},{"code":"httpOnly","type":"codeVoice"},{"type":"text","text":" cookies —"},{"type":"text","text":" "},{"type":"text","text":"so the rule holds by construction."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"No refresh token","type":"text"}]},{"type":"text","text":" (rule 5) — the grant issues none, and "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RequestingPartyToken","isActive":true},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"nowhere to put one."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The four ticket refusals — unknown, expired, already used, minted by another client — all"},{"type":"text","text":" "},{"type":"text","text":"arrive as one "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":", and this SDK does not guess which (§20.4): the server"},{"type":"text","text":" "},{"type":"text","text":"collapses them because telling them apart lets a caller probe for live ticket handles."}]}]}],"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"url":"\/documentation\/axiamsdk\/sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","title":"Sensitive","role":"symbol","abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}]},"doc://AxiamSDK/documentation/AxiamSDK/UmaClientCredentials":{"navigatorTitle":[{"text":"UmaClientCredentials","kind":"identifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/umaclientcredentials","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK