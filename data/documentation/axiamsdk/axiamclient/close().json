{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/close()"]}],"abstract":[{"type":"text","text":"Deterministic shutdown (CONTRACT.md §18)."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Releases the HTTP client and its connection pool, and clears the cookie jar, the CSRF token"},{"type":"text","text":" "},{"type":"text","text":"and any retained "},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","type":"reference"},{"type":"text","text":" challenge token (§18.1 rule 6)."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Idempotent","type":"text"}],"type":"strong"},{"text":" (rule 2): calling it twice is a no-op the second time. Cleanup code runs","type":"text"},{"text":" ","type":"text"},{"text":"from error paths, and an error path that itself throws hides the original failure.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Does not log out","type":"text"}]},{"type":"text","text":" (rule 5): it issues no request. The server-side session deliberately"},{"type":"text","text":" "},{"type":"text","text":"outlives the client object — that is what lets a process restart and resume — so a"},{"type":"text","text":" "},{"type":"codeVoice","code":"close()"},{"type":"text","text":" that logged out would silently end every user’s session on each deploy."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Use after close is an error, not undefined"}],"type":"strong"},{"text":" (rule 4): every operation afterwards","type":"text"},{"text":" ","type":"text"},{"text":"throws ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","type":"reference","isActive":true},{"text":" naming the cause rather than silently reopening.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift’s "},{"code":"deinit","type":"codeVoice"},{"type":"text","text":" cannot "},{"code":"await","type":"codeVoice"},{"type":"text","text":", and releasing an "},{"code":"AsyncHTTPClient","type":"codeVoice"},{"type":"text","text":" is async, so"},{"type":"text","text":" "},{"type":"text","text":"this SDK cannot make deallocation a complete shutdown the way §18.1 rule 1’s “a "},{"code":"deinit","type":"codeVoice"},{"type":"text","text":" "},{"text":"plus explicit ","type":"text"},{"type":"codeVoice","code":"close()"},{"text":"” suggests. ","type":"text"},{"type":"codeVoice","code":"close()"},{"text":" is therefore the only complete form, and is","type":"text"},{"text":" ","type":"text"},{"text":"stated as required rather than implied.","type":"text"}]}],"style":"note","name":"Note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/close()"},"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"title":"close()","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method","symbolKind":"method","role":"symbol","externalID":"s:8AxiamSDK0A6Cli