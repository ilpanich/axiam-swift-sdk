{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/close()","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"close"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Releases the HTTP client and its connection pool, and clears the cookie jar, the CSRF token"},{"type":"text","text":" "},{"type":"text","text":"and any retained "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","isActive":true},{"type":"text","text":" challenge token (§18.1 rule 6)."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Idempotent"}],"type":"strong"},{"text":" (rule 2): calling it twice is a no-op the second time. Cleanup code runs","type":"text"},{"text":" ","type":"text"},{"text":"from error paths, and an error path that itself throws hides the original failure.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Does not log out"}],"type":"strong"},{"text":" (rule 5): it issues no request. The server-side session deliberately","type":"text"},{"text":" ","type":"text"},{"text":"outlives the client object — that is what lets a process restart and resume — so a","type":"text"},{"text":" ","type":"text"},{"code":"close()","type":"codeVoice"},{"text":" that logged out would silently end every user’s session on each deploy.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Use after close is an error, not undefined"}],"type":"strong"},{"text":" (rule 4): every operation afterwards","type":"text"},{"text":" ","type":"text"},{"text":"throws ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive":true,"type":"reference"},{"text":" naming the cause rather than silently reopening.","type":"text"}]}]}],"type":"unorderedList"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift’s "},{"code":"deinit","type":"codeVoice"},{"type":"text","text":" cannot "},{"code":"await","type":"codeVoice"},{"type":"text","text":", and releasing an "},{"code":"AsyncHTTPClient","type":"codeVoice"},{"type":"text","text":" is async, so"},{"type":"text","text":" "},{"type":"text","text":"this SDK cannot make deallocation a complete shutdown the way §18.1 rule 1’s “a "},{"code":"deinit","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"plus explicit "},{"code":"close()","type":"codeVoice"},{"type":"text","text":"” suggests. "},{"code":"close()","type":"codeVoice"},{"type":"text","text":" is therefore the only complete form, and is"},{"type":"text","text":" "},{"type":"text","text":"stated as required rather than implied."}]}]}]}],"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/close()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:8AxiamSDK0A6ClientC5closeyyYaKF","roleHeading":"Instance Method","role":"symbol","title":"close()","modules":[{"name":"AxiamSDK"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"symbolKind":"method"},"abstract":[{"type":"text","text":"Determinis