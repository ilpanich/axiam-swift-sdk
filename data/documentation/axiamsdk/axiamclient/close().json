{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/close()"]}],"metadata":{"role":"symbol","symbolKind":"method","externalID":"s:8AxiamSDK0A6ClientC5closeyyYaKF","roleHeading":"Instance Method","title":"close()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"modules":[{"name":"AxiamSDK"}]},"abstract":[{"type":"text","text":"Deterministic shutdown (CONTRACT.md §18)."}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/close()","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"platforms":["Linux"]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Releases the HTTP client and its connection pool, and clears the cookie jar, the CSRF token"},{"type":"text","text":" "},{"type":"text","text":"and any retained "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},{"type":"text","text":" challenge token (§18.1 rule 6)."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Idempotent"}]},{"type":"text","text":" (rule 2): calling it twice is a no-op the second time. Cleanup code runs"},{"type":"text","text":" "},{"type":"text","text":"from error paths, and an error path that itself throws hides the original failure."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Does not log out"}]},{"text":" (rule 5): it issues no request. The server-side session deliberately","type":"text"},{"type":"text","text":" "},{"type":"text","text":"outlives the client object — that is what lets a process restart and resume — so a"},{"type":"text","text":" "},{"code":"close()","type":"codeVoice"},{"type":"text","text":" that logged out would silently end every user’s session on each deploy."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Use after close is an error, not undefined","type":"text"}],"type":"strong"},{"type":"text","text":" (rule 4): every operation afterwards"},{"type":"text","text":" "},{"type":"text","text":"throws "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive":true},{"type":"text","text":" naming the cause rather than silently reopening."}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"text":"Swift’s ","type":"text"},{"type":"codeVoice","code":"deinit"},{"text":" cannot ","type":"text"},{"type":"codeVoice","code":"await"},{"text":", and releasing an ","type":"text"},{"type":"codeVoice","code":"AsyncHTTPClient"},{"text":" is async, so","type":"text"},{"text":" ","type":"text"},{"text":"this SDK cannot make deallocation a complete shutdown the way §18.1 rule 1’s “a ","type":"text"},{"type":"codeVoice","code":"deinit"},{"text":" ","type":"text"},{"text":"plus explicit ","type":"text"},{"type":"codeVoice","code":"close()"},{"text":"” suggests. ","type":"text"},{"type":"codeVoice","code":"close()"},{"text":" is therefore the only complete form, and is","type":"text"},{"text":" ","type":"text"},{"text":"stated as required rather than implied.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"}],"kind":"content"}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/NetworkError":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NetworkError","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"NetworkError","kind":"identifier"}],"title":"NetworkError","url":"\/documentation\/axiamsdk\/networkerror","abstract":[{"type":"text","text":"Transport-level failure (§2). Carries the underlying transport error as "},{"type":"codeVoice","code":"cause"},{"type":"text","text":" "},{"type":"text","text":"where one exists (connection refused, timeout, TLS handshake failure, DNS)."}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"abstract":[{"text":"A wrapper for secret material (§7 of CONTRACT.md).","type":"text"}],"url":"\/documentation\/axiamsdk\/sensitive","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","title":"Sensitive"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/close()":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/close()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"type":"topic","title":"close()","url":"\/documentation\/axiamsdk\/axiamclient\/close()","abstract":[{"type":"text","text":"Deterministic shutdown (CONTRACT.md §18)."}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","role":"collection","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization