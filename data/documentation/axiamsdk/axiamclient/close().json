{"kind":"symbol","abstract":[{"text":"Deterministic shutdown (CONTRACT.md §18).","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"metadata":{"title":"close()","role":"symbol","externalID":"s:8AxiamSDK0A6ClientC5closeyyYaKF","modules":[{"name":"AxiamSDK"}],"symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/close()","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Releases the HTTP client and its connection pool, and clears the cookie jar, the CSRF token"},{"type":"text","text":" "},{"type":"text","text":"and any retained "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},{"type":"text","text":" challenge token (§18.1 rule 6)."}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Idempotent","type":"text"}]},{"type":"text","text":" (rule 2): calling it twice is a no-op the second time. Cleanup code runs"},{"type":"text","text":" "},{"type":"text","text":"from error paths, and an error path that itself throws hides the original failure."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Does not log out","type":"text"}],"type":"strong"},{"text":" (rule 5): it issues no request. The server-side session deliberately","type":"text"},{"text":" ","type":"text"},{"text":"outlives the client object — that is what lets a process restart and resume — so a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"close()"},{"text":" that logged out would silently end every user’s session on each deploy.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Use after close is an error, not undefined","type":"text"}]},{"type":"text","text":" (rule 4): every operation afterwards"},{"type":"text","text":" "},{"type":"text","text":"throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError"},{"type":"text","text":" naming the cause rather than silently reopening."}],"type":"paragraph"}]}],"type":"unorderedList"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift’s "},{"code":"deinit","type":"codeVoice"},{"type":"text","text":" cannot "},{"code":"await","type":"codeVoice"},{"type":"text","text":", and releasing an "},{"code":"AsyncHTTPClient","type":"codeVoice"},{"type":"text","text":" is async, so"},{"type":"text","text":" "},{"type":"text","text":"this SDK cannot make deallocation a complete shutdown the way §18.1 rule 1’s “a "},{"code":"deinit","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"plus explicit "},{"code":"close()","type":"codeVoice"},{"type":"text","text":"” suggests. "},{"code":"close()","type":"codeVoice"},{"type":"text","text":" is therefore the only complete form, and is"},{"type":"text","text":" "},{"type":"text","text":"stated as required rather than implied."}]}]}]}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/close()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"type":"topic","title":"Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"kind":"symbol","url":"\/documentation\/axiamsdk\/sensitive","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}]},"doc://AxiamSDK/documentation/AxiamSDK/NetworkError":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","url":"\/documentation\/axiamsdk\/networkerror","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NetworkError"}],"abstract":[{"text":"Transport-level failure (§2). Carries the underlying transport error as ","type":"text"},{"code":"cause","type":"codeVoice"},{"text":" ","type":"text"},{"text":"where one exists (connection refused, timeout, TLS handshake failure, DNS).","type":"text"}],"type":"topic","title":"NetworkError","navigatorTitle":[{"kind":"identifier","text":"NetworkError"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/close()":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"close"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"title":"close()","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\/close()","abstract":[{"text":"Deterministic shutdown (CONTRACT.md §18).","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/close()"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","title":"AxiamClient","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AxiamClient"}],"abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}],"url":"\/documentation\/axiamsdk\/axiamclient","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamClient"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}