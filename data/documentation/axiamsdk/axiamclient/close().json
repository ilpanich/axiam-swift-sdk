{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Deterministic shutdown (CONTRACT.md §18)."}],"metadata":{"externalID":"s:8AxiamSDK0A6ClientC5closeyyYaKF","modules":[{"name":"AxiamSDK"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"close"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"title":"close()","roleHeading":"Instance Method","role":"symbol"},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/close()","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"close"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Releases the HTTP client and its connection pool, and clears the cookie jar, the CSRF token","type":"text"},{"text":" ","type":"text"},{"text":"and any retained ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","type":"reference","isActive":true},{"text":" challenge token (§18.1 rule 6).","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Idempotent"}]},{"type":"text","text":" (rule 2): calling it twice is a no-op the second time. Cleanup code runs"},{"type":"text","text":" "},{"type":"text","text":"from error paths, and an error path that itself throws hides the original failure."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Does not log out"}],"type":"strong"},{"type":"text","text":" (rule 5): it issues no request. The server-side session deliberately"},{"type":"text","text":" "},{"type":"text","text":"outlives the client object — that is what lets a process restart and resume — so a"},{"type":"text","text":" "},{"type":"codeVoice","code":"close()"},{"type":"text","text":" that logged out would silently end every user’s session on each deploy."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Use after close is an error, not undefined"}],"type":"strong"},{"text":" (rule 4): every operation afterwards","type":"text"},{"text":" ","type":"text"},{"text":"throws ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive":true,"type":"reference"},{"text":" naming the cause rather than silently reopening.","type":"text"}]}]}],"type":"unorderedList"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift’s "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" cannot "},{"type":"codeVoice","code":"await"},{"type":"text","text":", and releasing an "},{"type":"codeVoice","code":"AsyncHTTPClient"},{"type":"text","text":" is async, so"},{"type":"text","text":" "},{"type":"text","text":"this SDK cannot make deallocation a complete shutdown the way §18.1 rule 1’s “a "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" "},{"type":"text","text":"plus explicit "},{"type":"codeVoice","code":"close()"},{"type":"text","text":"” suggests. "},{"type":"codeVoice","code":"close()"},{"type":"text","text":" is therefore the only complete form, and is"},{"type":"text","text":" "},{"type":"text","text":"stated as required rather than implied."}]}],"name":"Note","type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/close()"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/close()":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/close()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"kind":"keyword","text":"async"},{"text":" ","kind":"text"},{"kind":"keyword","text":"throws"}],"url":"\/documentation\/axiamsdk\/axiamclient\/close()","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Deterministic shutdown (CONTRACT.md §18)."}],"title":"close()","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamclient","type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/NetworkError":{"abstract":[{"type":"text","text":"Transport-level failure (§2). Carries the underlying transport error as "},{"type":"codeVoice","code":"cause"},{"text":" ","type":"text"},{"text":"where one exists (connection refused, timeout, TLS handshake failure, DNS).","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"NetworkError"}],"title":"NetworkError","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","url":"\/documentation\/axiamsdk\/networkerror","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NetworkError"}]},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"title":"Sensitive","kind":"symbol"}}}