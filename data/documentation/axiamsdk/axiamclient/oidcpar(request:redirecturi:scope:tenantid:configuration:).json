{"content":[{"inlineContent":[{"type":"text","text":"the same redirect URI that will be sent at exchange time."}],"type":"paragraph"}],"name":"redirectURI"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the requested scope. Must match what was pushed at "},{"type":"codeVoice","code":"oidcBegin"},{"type":"text","text":"."}]}],"name":"scope"},{"content":[{"inlineContent":[{"text":"a tenant override for the ","type":"text"},{"code":"?tenant_id=","type":"codeVoice"},{"text":" query parameter.","type":"text"}],"type":"paragraph"}],"name":"tenantID"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the discovery document, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to discover."}]}],"name":"configuration"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"PAR moves the authorization request off the browser. Instead of putting "},{"type":"codeVoice","code":"scope"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"redirect_uri"},{"type":"text","text":", "},{"type":"codeVoice","code":"state"},{"type":"text","text":" and the PKCE challenge into a URL the user agent carries,"},{"type":"text","text":" "},{"type":"text","text":"the client POSTs them straight to AXIAM over an authenticated channel and puts an"},{"type":"text","text":" "},{"type":"text","text":"opaque "},{"type":"codeVoice","code":"request_uri"},{"type":"text","text":" in the redirect. What travels through the browser is then a"},{"type":"text","text":" "},{"type":"text","text":"random string that cannot be edited into meaning something else."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Required for a FAPI 2.0 client"}],"type":"strong"},{"text":": ","type":"text"},{"code":"profile: \"fapi2\"","type":"codeVoice"},{"text":" refuses a registration that","type":"text"},{