" "},{"type":"text","text":"and verification URI are surfaced. §14.3 rule 2 is explicit that an SDK must not print"},{"type":"text","text":" "},{"type":"text","text":"them to stdout on the caller’s behalf — a device shows them however it can: a screen, a"},{"type":"text","text":" "},{"type":"text","text":"QR code, an e-ink panel."}],"type":"paragraph"},{"inlineContent":[{"text":"The returned token set is ","type":"text"},{"inlineContent":[{"type":"text","text":"not adopted"}],"type":"strong"},{"text":" as this client’s credential. Adoption is the","type":"text"},{"text":" ","type":"text"},{"text":"same MAY as ","type":"text"},{"code":"loginClientCredentials","type":"codeVoice"},{"text":" (§14.3 rule 4), and this SDK takes one posture","type":"text"},{"text":" ","type":"text"},{"text":"everywhere: return the tokens, install nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Polling follows §14.2 exactly: the interval starts at the server’s, "},{"type":"codeVoice","code":"slow_down"},{"type":"text","text":" adds 5 s"},{"type":"text","text":" "},{"type":"text","text":"permanently, and the loop stops at "},{"type":"codeVoice","code":"expires_in"},{"type":"text","text":" even if the server has not yet said so."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/devicelogin(scope:tenantid:configuration:onauthorization:)"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OidcConfiguration":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OidcConfiguration"}],"navigatorTitle":[{"kind":"identifier","text":"OidcConfiguration"}],"url":"\/documentation\/axiamsdk\/oidcconfiguration","title":"OidcConfiguration","abstract":