aKF","title":"deviceLogin(scope:tenantID:configuration:onAuthorization:)","extendedModule":"AxiamSDK"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"The composed helper (§14.3): authorize, hand the caller the codes, poll to completion."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deviceLogin"},{"kind":"text","text":"("},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OidcConfiguration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"onAuthorization"},{"kind":"text","text":": "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","text":"DeviceAuthorization","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeviceAuthorization","preciseIdentifier":"s:8AxiamSDK19DeviceAuthorizationV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"OidcTokenSet","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet","preciseIdentifier":"s:8AxiamSDK12OidcTokenSetV"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"onAuthorization"},{"type":"text","text":" is called "},{"inlineContent":[{"text":"before polling begins","type":"text"}],"type":"strong"},{"type":"text","text":" and is the only place the user code"},{"type":"text","text":" "},{"type":"text","text":"and verification URI are surfaced. §14.3 rule 2 is explicit that an SDK must not print"},{"type":"text","text":" "},{"type":"text","text":"them to stdout on the caller’s behalf — a device shows them however it can: a screen, a"},{"type":"text","text":" "},{"type":"text","text":"QR code, an e-ink panel."}],"type":"paragraph"},{"inlineContent":[{"text":"The returned token set is ","type":"text"},{"type":"strong","inlineContent":[{"text":"not adopted","type":"text"}]},{"text":" as this client’s credential. Adoption is the","type":"text"},{"text":" ","type":"text"},{"text":"same MAY as ","type":"text"},{"type":"codeVoice","code":"loginClientCredentials"},{"text":" (§14.3 rule 4), and this SDK takes one posture","type":"text"},{"text":" ","type":"text"},{"text":"everywhere: return the tokens, install nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Polling follows §14.2 exactly: the interval starts at the server’s, "},{"code":"slow_down","type":"codeVoice"},{"type":"text","text":" adds 5 s"},{"type":"text","text":" "},{"type":"text","text":"permanently, and the loop stops at "},{"code":"expires_in","type":"codeVoice"},{"type":"text","text":" even if the server has not yet said so."},{"type":"text","text":" "},{"type":"text","text":"A "},{"code":"429 rate_limit_exceeded","type":"codeVoice"},{"type":"text","text":" (contract 1.64, rule 9) is not terminal and is not a"},{"type":"text","text":" "},{"code":"slow_down","type":"codeVoice"},{"type":"text","text":": the next wait is the longer of the interval and "},{"code":"Retry-After","type":"codeVoice"},{"type":"text","text":", it stands in"},{"type":"text","text":" "},{"type":"text","text":"for that one interval, the interval itself is unchanged, and when the wait would pass the"},{"type":"text","text":" "},{"type":"text","text":"deadline the loop raises "},{"code":"expired_token","type":"codeVoice"},{"type":"text","text":" at once and sends nothing after it."}],"type":"paragraph"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/DeviceAuthorization":{"kind":"symbol","url":"\/documentation\/axiamsdk\/deviceauthorization","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DeviceAuthorization"}],"abstract":[{"type":"codeVoice","code":"POST \/oauth2\/device_authorization"},{"type":"text","text":" (§14.1) — the codes a device shows its user."}],"title":"DeviceAuthorization","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DeviceAuthorization"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeviceAuthorization"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"url":"\/documentation\/axiamsdk\/axiamclient","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamClient"}],"navigatorTitle":[{"kind":"identifier","text":"AxiamClient"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcTokenSet":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet","title":"OidcTokenSet","url":"\/documentation\/axiamsdk\/oidctokenset","kind":"symbol","abstract":[{"type":"text","text":"The result of every §12 token-endpoint grant (§12.1)."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OidcTokenSet","kind":"identifier"}],"navigatorTitle":[{"text":"OidcTokenSet","kind":"identifier"}],"type":"topic"},"doc://AxiamSDK