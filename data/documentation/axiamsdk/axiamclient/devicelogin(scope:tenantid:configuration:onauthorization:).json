rfaced. §14.3 rule 2 is explicit that an SDK must not print","type":"text"},{"text":" ","type":"text"},{"text":"them to stdout on the caller’s behalf — a device shows them however it can: a screen, a","type":"text"},{"text":" ","type":"text"},{"text":"QR code, an e-ink panel.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned token set is "},{"type":"strong","inlineContent":[{"type":"text","text":"not adopted"}]},{"type":"text","text":" as this client’s credential. Adoption is the"},{"type":"text","text":" "},{"type":"text","text":"same MAY as "},{"type":"codeVoice","code":"loginClientCredentials"},{"type":"text","text":" (§14.3 rule 4), and this SDK takes one posture"},{"type":"text","text":" "},{"type":"text","text":"everywhere: return the tokens, install nothing."}]},{"type":"paragraph","inlineContent":[{"text":"Polling follows §14.2 exactly: the interval starts at the server’s, ","type":"text"},{"code":"slow_down","type":"codeVoice"},{"text":" adds 5 s","type":"text"},{"text":" ","type":"text"},{"text":"permanently, and the loop stops at ","type":"text"},{"code":"expires_in","type":"codeVoice"},{"text":" even if the server has not yet said so.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/devicelogin(scope:tenantid:configuration:onauthorization:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"role":"symbol","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK0A6ClientC11deviceLogin5scope8tenantID13configuration15onAuthorizationAA12OidcTokenSetVSSSg_AkA0L13ConfigurationVSgyAA06DeviceK0VYbXEtYaKF","extendedModule":"AxiamSDK","title":"deviceLogin(scope:tenantID:configuration:onAuthorization:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deviceLogin","kind":"identifier"},{"text":"(","kind":"text"},{"text":"scope","kind":"externalParam"},{"text