"},{"kind":"text","text":"("},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration"},{"text":"? = nil, ","kind":"text"},{"text":"onAuthorization","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"DeviceAuthorization","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK19DeviceAuthorizationV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeviceAuthorization"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"OidcTokenSet","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12OidcTokenSetV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"code":"onAuthorization","type":"codeVoice"},{"text":" is called ","type":"text"},{"inlineContent":[{"text":"before polling begins","type":"text"}],"type":"strong"},{"text":" and is the only place the user code","type":"text"},{"text":" ","type":"text"},{"text":"and verification URI are surfaced. §14.3 rule 2 is explicit that an SDK must not print","type":"text"},{"text":" ","type":"text"},{"text":"them to stdout on the caller’s behalf — a device shows them however it can: a screen, a","type":"text"},{"text":" ","type":"text"},{"text":"QR code, an e-ink panel.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned token set is "},{"inlineContent":[{"text":"not adopted","type":"text"}],"type":"strong"},{"type":"text","text":" as this client’s credential. Adoption is the"},{"type":"text","text":" "},{"type":"text","text":"same MAY as "},{"code":"loginClientCredentials","type":"codeVoice"},{"type":"text","text":" (§14.3 rule 4), and this SDK takes one posture"},{"type":"text","text":" "},{"type":"text","text":"everywhere: return the tokens, install nothing."}]},{"type":"paragraph","inlineContent":[{"text":"Polling follows §14.2 exactly: the interval starts at the server’s, ","type":"text"},{"type":"codeVoice","code":"slow_down"},{"text":" adds 5 s","type":"text"},{"text":" ","type":"text"},{"text":"permanently, and the loop stops at ","type":"text"},{"type":"codeVoice","code":"expires_in"},{"text":" even if the server has not yet said so.","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"type":"codeVoice","code":"429 rate_limit_exceeded"},{"text":" (contract 1.64, rule 9) is not terminal and is not a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"slow_down"},{"text":": the next wait is the longer of the interval and ","type":"text"},{"type":"codeVoice","code":"Retry-After"},{"text":", it stands in","type":"text"},{"text":" ","type":"text"},{"text":"for that one interval, the interval itself is unchanged, and when the wait would pass the","type":"text"},{"text":" ","type":"text"},{"text":"deadline the loop raises ","type":"text"},{"type":"codeVoice","code":"expired_token"},{"text":" at once and sends nothing after it.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/devicelogin(scope:tenantid:configuration:onauthorization:)"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documen