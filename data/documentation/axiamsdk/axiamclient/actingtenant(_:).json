{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"actingTenant"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier","text":"UUID"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to clear: the next request sends no "},{"type":"codeVoice","code":"X-Axiam-Tenant"},{"type":"text","text":" header at all,"},{"type":"text","text":" "},{"type":"text","text":"which is what “the header is sent only when set” requires and what every client"},{"type":"text","text":" "},{"type":"text","text":"that never calls this method already does."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Gated on what this client knows, and nothing more","type":"text"}]},{"type":"text","text":" (§5.2 rule 1’s own words)."},{"type":"text","text":" "},{"type":"text","text":"A client holding a login result ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser"},{"type":"text","text":" from "},{"type":"codeVoice","code":"login"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"verifyMfa"},{"type":"text","text":"\/OPAQUE\/an"},{"type":"text","text":" "},{"type":"text","text":"MFA or WebAuthn setup completion) is refused client-side, with "},{"type":"strong","inlineContent":[{"type":"text","text":"zero wire"},{"type":"text","text":" "},{"type":"text","text":"calls"}]},{"type":"text","text":", unless that principal is "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel"},{"type":"text","text":" — an ordinary"},{"type":"text","text":" "},{"type":"text","text":"tenant principal gets a "},{"type":"codeVoice","code":"403"},{"type":"text","text":" from the server for the same header change, and"},{"type":"text","text":" "},{"type":"text","text":"offering the switch anyway would turn a type-level distinction into a runtime"},{"type":"text","text":" "},{"type":"text","text":"failure the caller has to discover by trying. When"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/reachableTenantIDs"},{"type":"text","text":" narrows that reach (§5.2.3), a tenant outside it"},{"type":"text","text":" "},{"type":"text","text":"is refused the same way (rule 4)."}]},{"type":"paragraph","inlineContent":[{"text":"A client holding ","type":"text"},{"type":"strong","inlineContent":[{"text":"no","type":"text"}]},{"text":" login result — a service account from client credentials","type":"text"},{"text":" ","type":"text"},{"text":"or the mTLS device login, or a token injected directly — has nothing to gate on.","type":"text"},{"text":" ","type":"text"},{"text":"It sends the header as asked and lets the server’s ","type":"text"},{"code":"403","type":"codeVoice"},{"text":" answer: an","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"organization-level service account is a supported design"}]},{"text":" (§27.13 S-9 note 2),","type":"text"},{"text":" ","type":"text"},{"text":"and this client cannot tell the difference from here.","type":"text"}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"type":"text","text":" — client-side, no request sent — when this"},{"type":"text","text":" "},{"type":"text","text":"client holds a login result that is not organization-level, or whose"},{"type":"text","text":" "},{"code":"reachableTenantIDs","type":"codeVoice"},{"type":"text","text":" does not contain "},{"code":"tenantID","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Throws"}]}],"abstract":[{"type":"text","text":"Act on a different tenant (or clear it), CONTRACT.md §5.2 rule 1, contract 1.51."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/actingTenant(_:)"},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/actingtenant(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"role":"symbol","symbolKind":"method","roleHeading":"Instance Method","externalID":"s:8AxiamSDK0A6ClientC12actingTenantyy10Foundation4UUIDVSgKF","title":"actingTenant(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"actingTenant"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"}],"modules":[{"name":"AxiamSDK"}]},"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamclient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/actingTenant