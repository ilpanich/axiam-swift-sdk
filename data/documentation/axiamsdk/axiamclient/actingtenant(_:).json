},{"text":" ","type":"text"},{"text":"client holds a login result that is not organization-level, or whose","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"reachableTenantIDs"},{"text":" does not contain ","type":"text"},{"type":"codeVoice","code":"tenantID"},{"text":".","type":"text"}]}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/actingTenant(_:)"},"abstract":[{"text":"Act on a different tenant (or clear it), CONTRACT.md §5.2 rule 1, contract 1.51.","type":"text"}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/actingtenant(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"roleHeading":"Instance Method","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actingTenant","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UUID","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4UUIDV"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"}],"symbolKind":"method","externalID":"s:8AxiamSDK0A6ClientC12actingTenantyy10Foundation4UUIDVSgKF","role":"symbol","title":"actingTenant(_:)"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser/organizationLevel":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel","abstract":[{"type":"text","text":"Whether this is an "},{"type":"strong","inlineContent":[{"text":"organization-level","type":"text"}]},{"type":"text","text":" principal (CONTRACT.md §5.2)."}],"url":"\/documentation\/axiamsdk\/axiamuser\/organizationlevel","title":"organizationLevel","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"i