{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actingTenant","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"tenantID","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4UUIDV","text":"UUID","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"}]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to clear: the next request sends no "},{"type":"codeVoice","code":"X-Axiam-Tenant"},{"type":"text","text":" header at all,"},{"type":"text","text":" "},{"type":"text","text":"which is what “the header is sent only when set” requires and what every client"},{"type":"text","text":" "},{"type":"text","text":"that never calls this method already does."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Gated on what this client knows, and nothing more","type":"text"}],"type":"strong"},{"text":" (§5.2 rule 1’s own words).","type":"text"},{"text":" ","type":"text"},{"text":"A client holding a login result (","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","isActive":true},{"text":" from ","type":"text"},{"type":"codeVoice","code":"login"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"verifyMfa"},{"text":"\/OPAQUE\/an","type":"text"},{"text":" ","type":"text"},{"text":"MFA or WebAuthn setup completion) is refused client-side, with ","type":"text"},{"inlineContent":[{"text":"zero wire","type":"text"},{"text":" ","type":"text"},{"text":"calls","type":"text"}],"type":"strong"},{"text":", unless that principal is ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel","isActive":true},{"text":" — an ordinary","type":"text"},{"text":" ","type":"text"},{"text":"tenant principal gets a ","type":"text"},{"type":"codeVoice","code":"403"},{"text":" from the server for the same header change, and","type":"text"},{"text":" ","type":"text"},{"text":"offering the switch anyway would turn a type-level distinction into a runtime","type":"text"},{"text":" ","type":"text"},{"text":"failure the caller has to discover by trying. When","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/reachableTenantIDs","isActive":true},{"text":" narrows that reach (§5.2.3), a tenant outside it","type":"text"},{"text":" ","type":"text"},{"text":"is refused the same way (rule 4).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A client holding ","type":"text"},{"inlineContent":[{"type":"text","text":"no"}],"type":"strong"},{"text":" login result — a service account from client credentials","type":"text"},{"text":" ","type":"text"},{"text":"or the mTLS device login, or a token injected directly — has nothing to gate on.","type":"text"},{"text":" ","type":"text"},{"text":"It sends the header as asked and lets the server’s ","type":"text"},{"code":"403","type":"codeVoice"},{"text":" answer: an","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"organization-level service account is a supported design"}],"type":"strong"},{"text":" (§27.13 S-9 note 2),","type":"text"},{"text":" ","type":"text"},{"text":"and this client cannot tell the difference from here.","type":"text"}]},{"name":"Throws","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"type":"text","text":" — client-side, no request sent — when this"},{"type":"text","text":" "},{"type":"text","text":"client holds a login result that is not organization-level, or whose"},{"type":"text","text":" "},{"type":"codeVoice","code":"reachableTenantIDs"},{"type":"text","text":" does not contain "},{"type":"codeVoice","code":"tenantID"},{"type":"text","text":"."}]}]}],"kind":"content"}],"abstract":[{"text":"Act on a different tenant (or clear it), CONTRACT.md §5.2 rule 1, contract 1.51.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/actingtenant(_:)"]}],"metadata":{"symbolKind":"method","externalID":"s:8AxiamSDK0A6ClientC12actingTenantyy20FoundationEssentials4UUIDVSgKF","modules":[{"name":"AxiamSDK"}],"role":"symbol","roleHeading":"Instance Method","title":"actingTenant(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"actingTenant"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:20FoundationEssentials4UUIDV"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"}]},"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/actingTenant(_:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser/organizationLevel":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel","url":"\/documentation\/axiamsdk\/axiamuser\/organizationlevel","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"organizationLevel","abstract":[{"type":"text","text":"Whether th