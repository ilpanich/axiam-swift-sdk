{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Act on a different tenant (or clear it), CONTRACT.md §5.2 rule 1, contract 1.51.","type":"text"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/actingTenant(_:)","interfaceLanguage":"swift"},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actingTenant","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UUID","preciseIdentifier":"s:20FoundationEssentials4UUIDV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"}],"roleHeading":"Instance Method","modules":[{"name":"AxiamSDK"}],"symbolKind":"method","role":"symbol","externalID":"s:8AxiamSDK0A6ClientC12actingTenantyy20FoundationEssentials4UUIDVSgKF","title":"actingTenant(_:)"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/actingtenant(_:)"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actingTenant","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"tenantID","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"UUID","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4UUIDV"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Pass ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to clear: the next request sends no ","type":"text"},{"code":"X-Axiam-Tenant","type":"codeVoice"},{"text":" header at all,","type":"text"},{"text":" ","type":"text"},{"text":"which is what “the header is sent only when set” requires and what every client","type":"text"},{"text":" ","type":"text"},{"text":"that never calls this method already does.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Gated on what this client knows, and nothing more"}]},{"type":"text","text":" (§5.2 rule 1’s own words)."},{"type":"text","text":" "},{"type":"text","text":"A client holding a login result ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser"},{"type":"text","text":" from "},{"type":"codeVoice","code":"login"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"verifyMfa"},{"type":"text","text":"\/OPAQUE\/an"},{"type":"text","text":" "},{"type":"text","text":"MFA or WebAuthn setup completion) is refused client-side, with "},{"type":"strong","inlineContent":[{"text":"zero wire","type":"text"},{"text":" ","type":"text"},{"text":"calls","type":"text"}]},{"type":"text","text":", unless that principal is "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel"},{"type":"text","text":" — an ordinary"},{"type":"text","text":" "},{"type":"text","text":"tenant principal gets a "},{"type":"codeVoice","code":"403"},{"type":"text","text":" from the server for the same header change, and"},{"type":"text","text":" "},{"type":"text","text":"offering the switch anyway would turn a type-level distinction into a runtime"},{"type":"text","text":" "},{"type":"text","text":"failure the caller has to discover by trying. When"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/reachableTenantIDs"},{"type":"text","text":" narrows that reach (§5.2.3), a tenant outside it"},{"type":"text","text":" "},{"type":"text","text":"is refused the same way (rule 4)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A client holding "},{"type":"strong","inlineContent":[{"type":"text","text":"no"}]},{"type":"text","text":" login result — a service account from client credentials"},{"type":"text","text":" "},{"type":"text","text":"or the mTLS device login, or a token injected directly — has nothing to gate on."},{"type":"text","text":" "},{"type":"text","text":"It sends the header as asked and lets the server’s "},{"code":"403","type":"codeVoice"},{"type":"text","text":" answer: an"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"organization-level service account is a supported design"}]},{"type":"text","text":" (§27.13 S-9 note 2),"},{"type":"text","text":" "},{"type":"text","text":"and this client cannot tell the difference from here."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true},{"type":"text","text":" — client-side, no request sent — when this"},{"type":"text","text":" "},{"type":"text","text":"client holds a login result that is not organization-level, or whose"},{"type":"text","text":" "},{"type":"codeVoice","code":"reachableTenantIDs"},{"type":"text","text":" does not contain "},{"type":"codeVoice","code":"tenantID"},{"type":"text","text":"."}]}],"style":"note","name":"Throws","type":"aside"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser/organizationLevel":{"type":"topic","url":"\/documentation\/axiamsdk\/axiamuser\/organizationlevel","abstract":[{"type":"text","text":"Whether this is an "},{"type":"strong","inlineContent":[{"type":"text","text":"organization-level"}]},{"type":"text","text":" principal (CONTRACT.md §5.2)."}],"title":"organizationLevel","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"