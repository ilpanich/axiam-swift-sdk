{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"actingTenant"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to clear: the next request sends no "},{"code":"X-Axiam-Tenant","type":"codeVoice"},{"type":"text","text":" header at all,"},{"type":"text","text":" "},{"type":"text","text":"which is what “the header is sent only when set” requires and what every client"},{"type":"text","text":" "},{"type":"text","text":"that never calls this method already does."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Gated on what this client knows, and nothing more"}]},{"type":"text","text":" (§5.2 rule 1’s own words)."},{"type":"text","text":" "},{"type":"text","text":"A client holding a login result ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser"},{"type":"text","text":" from "},{"type":"codeVoice","code":"login"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"verifyMfa"},{"type":"text","text":"\/OPAQUE\/an"},{"type":"text","text":" "},{"type":"text","text":"MFA or WebAuthn setup completion) is refused client-side, with "},{"type":"strong","inlineContent":[{"text":"zero wire","type":"text"},{"text":" ","type":"text"},{"text":"calls","type":"text"}]},{"type":"text","text":", unless that principal is "},{"type":"reference","isActive":true,