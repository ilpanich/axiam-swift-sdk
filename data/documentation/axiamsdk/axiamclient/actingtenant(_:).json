":"text","text":"A client holding "},{"inlineContent":[{"text":"no","type":"text"}],"type":"strong"},{"type":"text","text":" login result — a service account from client credentials"},{"type":"text","text":" "},{"type":"text","text":"or the mTLS device login, or a token injected directly — has nothing to gate on."},{"type":"text","text":" "},{"type":"text","text":"It sends the header as asked and lets the server’s "},{"code":"403","type":"codeVoice"},{"type":"text","text":" answer: an"},{"type":"text","text":" "},{"inlineContent":[{"text":"organization-level service account is a supported design","type":"text"}],"type":"strong"},{"type":"text","text":" (§27.13 S-9 note 2),"},{"type":"text","text":" "},{"type":"text","text":"and this client cannot tell the difference from here."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true,"type":"reference"},{"text":" — client-side, no request sent — when this","type":"text"},{"text":" ","type":"text"},{"text":"client holds a login result that is not organization-level, or whose","type":"text"},{"text":" ","type":"text"},{"code":"reachableTenantIDs","type":"codeVoice"},{"text":" does not contain ","type":"text"},{"code":"tenantID","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"aside","name":"Throws"}],"kind":"content"}],"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser/organizationLevel":{"url":"\/documentation\/axiamsdk\/axiamuser\/organizationlevel","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","abstract":[{"type":"text","text":"Whether this is an "},