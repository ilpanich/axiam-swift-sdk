":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/auth(_:)":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","abstract":[{"type":"text","text":"Authentication failure: wrong credentials, expired session, MFA failure,"},{"text":" ","type":"text"},{"text":"or a 401 on the refresh call itself.","type":"text"}],"title":"AxiamError.auth(_:)","type":"topic","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamerror\/auth(_:)","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"auth"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"AuthError","preciseIdentifier":"s:8AxiamSDK9AuthErrorV"},{"kind":"text","text":")"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser":{"title":"AxiamUser","type":"topic","navigatorTitle":[{"text":"AxiamUser","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamuser","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamUser","kind":"identifier"}],"abstract":[{"text":"An authenticated AXIAM identity.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser"}}}