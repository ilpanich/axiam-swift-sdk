{"abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/auth\/federation\/handoff"},{"type":"text","text":" (§12.1) — redeem a handoff code for a session."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"ssoCompleteHandoff"},{"kind":"text","text":"("},{"kind":"externalParam","text":"code"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK17SsoCompleteResultV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsoCompleteResult","kind":"typeIdentifier","text":"SsoCompleteResult"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"SAML and Apple’s "},{"type":"codeVoice","code":"response_mode=form_post"},{"type":"text","text":" return cross-site, so the server cannot set"},{"type":"text","text":" "},{"type":"codeVoice","code":"SameSite=Strict"},{"type":"text","text":" cookies on that response. It redirects the browser to the SPA callback"},{"type":"text","text":" "},{"type":"text","text":"with the code in the "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/FederationHandoff\/queryParameter","isActive":true},{"type":"text","text":" query parameter; "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"same-origin POST is the one that carries "},{"type":"codeVoice","code":"Set-Cookie"},{"type":"text","text":" (§12.1 note 12)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The code is single-use and lives "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/F