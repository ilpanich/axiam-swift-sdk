ext"},{"code":"receivedAt + expiresIn","type":"codeVoice"},{"text":", even if the server has not said","type":"text"},{"text":" ","type":"text"},{"code":"expired_token","type":"codeVoice"},{"text":"; the same ","type":"text"},{"code":"expired_token","type":"codeVoice"},{"text":" outcome is then raised locally.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns the token set "},{"type":"strong","inlineContent":[{"text":"without adopting it","type":"text"}]},{"type":"text","text":" as this client’s credential — the"},{"type":"text","text":" "},{"type":"text","text":"posture of "},{"code":"deviceLogin","type":"codeVoice"},{"type":"text","text":" and "},{"code":"loginClientCredentials","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ping mode"}]},{"text":" does not loop: call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/cibaPoll(authReqID:tenantID:configuration:)","type":"reference"},{"text":" once","type":"text"},{"text":" ","type":"text"},{"text":"from the handler that received the ping (","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/cibaHandlePing(headers:body:expectedToken:)","type":"reference"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"and fall back to this loop only once half of ","type":"text"},{"type":"codeVoice","code":"expiresIn"},{"text":" has passed without a ping","type":"text"},{"text":" ","type":"text"},{"text":"(§33.7 rule 6).","type":"text"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/OidcConfiguration":{"title":"OidcConfiguration","abstract":[{"type":"text","text":"The OIDC discovery document (§12.1), read from "},{"code":"\/.well-known\/openid-config