{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Poll for "},{"code":"initiated","type":"codeVoice"},{"type":"text","text":"’s outcome until it is decided or expires (§33.1, §33.7). Surfaces"},{"type":"text","text":" "},{"type":"text","text":"nothing to the user — AXIAM notified them."}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/cibaawait(_:tenantid:configuration:clock:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cibaAwait"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"initiated"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20CibaInitiateResponseV","text":"CibaInitiateResponse","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaInitiateResponse"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9CibaClockP","text":"CibaClock","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaClock"},{"kind":"text","text":" = SystemCibaClock()) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12OidcTokenSetV","text":"OidcTokenSet","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The first poll waits one "},{"code":"interval","type":"codeVoice"},{"type":"text","text":"; polling earlier only earns "},{"code":"slow_down","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"slow_down","type":"codeVoice"},{"text":" adds 5 s to the interval, cumulatively and permanently;","type":"text"},{"text":" ","type":"text"},{"code":"authorization_pending","type":"codeVoice"},{"text":" never lowers it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A transport failure, "},{"type":"codeVoice","code":"408"},{"type":"text","text":", "},{"type":"codeVoice","code":"429"},{"type":"text","text":" or "},{"type":"codeVoice","code":"5xx"},{"type":"text","text":" (with or without an "},{"type":"codeVoice","code":"error"},{"type":"text","text":" member) that"},{"type":"text","text":" "},{"type":"text","text":"outlived §16 is not terminal: the loop waits the interval or the answer’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"Retry-After"},{"type":"text","text":", whichever is longer, and polls again. A §16 wait or a loop wait that"},{"type":"text","text":" "},{"type":"text","text":"would reach "},{"type":"codeVoice","code":"receivedAt + expiresIn"},{"type":"text","text":" is not taken: nothing more is sent and"},{"type":"text","text":" "},{"type":"codeVoice","code":"expired_token"},{"type":"text","text":" is raised at once (§34.2 P10). A "},{"type":"codeVoice","code":"4xx"},{"type":"text","text":" without an "},{"type":"codeVoice","code":"error"},{"type":"text","text":" member is"},{"type":"text","text":" "},{"type":"text","text":"decisive and ends the loop."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Anything that fails after a ","type":"text"},{"code":"2xx","type":"codeVoice"}]},{"type":"text","text":" — a body that does not decode, an ID token that"},{"type":"text","text":" "},{"type":"text","text":"does not validate, the key fetch validation needs — ends the loop with that failure:"},{"type":"text","text":" "},{"type":"text","text":"the request is already redeemed, and polling again could only earn "},{"code":"invalid_grant","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(§33.7 rule 7, CONTRACT.md §34.2 P9). The tokens of such a redemption are not"},{"type":"text","text":" "},{"type":"text","text":"returned; start a new request."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Polling stops at "},{"type":"codeVoice","code":"receivedAt + expiresIn"},{"type":"text","text":", even if the server has not said"},{"type":"text","text":" "},{"type":"codeVoice","code":"expired_token"},{"type":"text","text":"; the same "},{"type":"codeVoice","code":"expired_token"},{"type":"text","text":" outcome is then raised locally."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns the token set "},{"inlineContent":[{"text":"without adopting it","type":"text"}],"type":"strong"},{"type":"text","text":" as this client’s credential — the"},{"type":"text","text":" "},{"type":"text","text":"posture of "},{"code":"deviceLogin","type":"codeVoice"},{"type":"text","text":" and "},{"code":"loginClientCredentials","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Ping mode","type":"text"}]},{"text":" does not loop: call ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/cibaPoll(authReqID:tenantID:configuration:)"},{"text":" once","type":"text"},{"text":" ","type":"