{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/cibaAwait(_:tenantID:configuration:clock:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cibaAwait","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"initiated","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK20CibaInitiateResponseV","text":"CibaInitiateResponse","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaInitiateResponse","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK9CibaClockP","text":"CibaClock","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaClock","kind":"typeIdentifier"},{"text":" = SystemCibaClock()) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK12OidcTokenSetV","text":"OidcTokenSet","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcTokenSet","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The first poll waits one "},{"type":"codeVoice","code":"interval"},{"type":"text","text":"; polling earlier only earns "},{"type":"codeVoice","code":"slow_down"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"code":"slow_down","type":"codeVoice"},{"type":"text","text":" adds 5 s to the interval, cumulatively and permanently;"},{"type":"text","text":" "},{"code":"authorization_pending","type":"codeVoice"},{"type":"text","text":" never lowers it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A transport failure, "},{"type":"codeVoice","code":"408"},{"type":"text","text":", "},{"type":"codeVoice","code":"429"},{"type":"text","text":" or "},{"type":"codeVoice","code":"5xx"},{"type":"text","text":" (with or without an "},{"type":"codeVoice","code":"error"},{"type":"text","text":" member) that"},{"type":"text","text":" "},{"type":"text","text":"outlived §16 is not terminal: the loop waits the interval or the answer’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"Retry-After"},{"type":"text","text":", whichever is longer, and polls again. A §16 wait or a loop wait that"},{"type":"text","text":" "},{"type":"text","text":"would reach "},{"type":"codeVoice","code":"receivedAt + expiresIn"},{"type":"text","text":" is not taken: nothing more is sent and"},{"type":"text","text":" "},{"type":"codeVoice","code":"expired_token"},{"type":"text","text":" is raised at once (§34.2 P10). A "},{"type":"codeVoice","code":"4xx"},{"type":"text","text":" without an "},{"type":"codeVoice","code":"error"},{"type":"text","text":" member is"},{"type":"text","text":" "},{"type":"text","text":"decisive and ends the loop."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Anything that fails after a "},{"type":"codeVoice","code":"2xx"}]},{"type":"text","text":" — a body that does not decode, an ID token that"},{"type":"text","text":" "},{"type":"text","text":"does not validate, the key fetch validation needs — ends the loop with that failure:"},{"type":"text","text":" "},{"type":"text","text":"the request is already redeemed, and polling again could only earn "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":" "},{"type":"text","text":"(§33.7 rule 7, CONTRACT.md §34.2 P9). The tokens of such a redemption are not"},{"type":"text","text":" "},{"type":"text","text":"returned; start a new request."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Polling stops at ","type":"text"},{"type":"codeVoice","code":"receivedAt + expiresIn"},{"text":", even if the server has not said","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"expired_token"},{"text":"; the same ","type":"text"},{"type":"codeVoice","code":"expired_token"},{"text":" outcome is then raised locally.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Returns the token set "},{"type":"strong","inlineContent":[{"type":"text","text":"without adopting it"}]},{"type":"text","text":" as this client’s credential — the"},{"type":"text","text":" "},{"type":"text","text":"posture of "},{"type":"codeVoice","code":"deviceLogin"},{"type":"text","text":" and "},{"type":"codeVoice","code":"loginClientCredentials"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ping mode"}]},{"type":"text","text":" does not loop: call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/cibaPoll(authReqID:tenantID:configuration:)"},{"type":"text","text":" once"},{"type":"text","text":" "},{"type":"text","text":"from the handler that received the ping ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/cibaHandlePing(headers:body:expectedToken:)"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and fall back to this loop only once half of "},{"type":"codeVoice","code":"expiresIn"},{"type":"text","text":" has passed without a ping"},{"type":"text","text":" "},{"type":"text","text":"(§33.7 rule 6)."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"metadata":{"title":"cibaAwait(_:tenantID:configuration:clock:)","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"AxiamSDK"}],"role":"symbol","externalID":"s:8AxiamSDK0A6ClientC9cibaAwait_8tenantID13configuration5clockAA12OidcTokenSetVAA20CibaInitiateResponseV_SSSgAA0J13ConfigurationVSgAA0M5Clock_ptYaKF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cibaAwait"},{"text":"(","kind":"text"},{"text":"CibaInitiateResponse","preciseIdentifier":"s:8AxiamSDK20CibaInitiateResponseV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK9CibaClockP","text":"CibaClock","kind":"typeIdentifier"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12OidcTokenSetV","text":"OidcTokenSet"}],"extendedModule":"AxiamSDK"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/cibaawait(_:tenantid:configuration:clock:)"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]