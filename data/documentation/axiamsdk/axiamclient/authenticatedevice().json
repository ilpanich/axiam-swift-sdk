e":"text"},{"text":" ","type":"text"},{"text":"CLIENT-SIDE with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"text":" and ","type":"text"},{"type":"strong","inlineContent":[{"text":"zero wire calls","type":"text"}]},{"text":": without a","type":"text"},{"text":" ","type":"text"},{"text":"certificate the server would answer ","type":"text"},{"type":"codeVoice","code":"401"},{"text":" regardless, so going to the wire would","type":"text"},{"text":" ","type":"text"},{"text":"only turn a configuration mistake into an authentication failure.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On success the returned token is "},{"inlineContent":[{"type":"text","text":"adopted as this client’s credential"}],"type":"strong"},{"type":"text","text":", exactly"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"code":"login()","type":"codeVoice"},{"type":"text","text":" result is (rule 6): every subsequent REST call this client sends —"},{"type":"text","text":" "},{"type":"text","text":"including every "},{"code":"management()","type":"codeVoice"},{"type":"text","text":" operation — carries it as "},{"code":"Authorization: Bearer <token>","type":"codeVoice"},{"type":"text","text":" and withholds this client’s own cookie jar, so a session cookie from an"},{"type":"text","text":" "},{"type":"text","text":"earlier "},{"code":"login()","type":"codeVoice"},{"type":"text","text":" can never ride alongside it. The server reads the"},{"type":"text","text":" "},{"code":"axiam_access","type":"codeVoice"},{"type":"text","text":" cookie before "},{"code":"Authorization","type":"codeVoice"},{"text":", so keeping a stale one would","type":"text"},{"text":" ","type":"text"},{"text":"silently run every later request as the ","type":"text"},{"inlineContent":[{"type":"text","text":"previous"}],"type":"emphasis"},{"text":" session’s principal, defeating","type":"text"},{"text":" ","type":"text"},{"text":"the point of authenticating fresh.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"There is no refresh token","type":"text"}],"type":"strong"},{"text":" for this credential (rule 6, D-6 of the dogfooding","type":"text"},{"text":" ","type":"text"},{"text":"plan): the §9 single-flight guard has nothing to spend on it, so a later ","type":"text"},{"code":"401","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"on this call, or on any request this client sends afterward — is surfaced as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","type":"reference"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"no refresh attempt"}],"type":"strong"},{"text":". The caller recovers by calling","type":"text"},{"text":" ","type":"text"},{"code":"authenticateDevice()","type":"codeVoice"},{"text":" again, which costs one TLS handshake.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Every refusal is a ","type":"text"},{"code":"401","type":"codeVoice"}],"type":"strong"},{"text":" (rule 8, server T22.4): an unknown, untrusted,","type":"text"},{"text":" ","type":"text"},{"text":"expired, revoked or unbound certificate, and a ","type":"text"},{"type":"codeVoice","code":"Server"},{"text":"-type certificate, all map","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","isActive":true},{"text":". A ","type":"text"},{"type":"codeVoice","code":"429"},{"text":" from the route’s per-IP rate limiter maps to","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive":true},{"text":" (§2), never ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","isActive":true},{"text":" — ","type":"text"},{"type":"codeVoice","code":"mapError"},{"text":" already keeps the two","type":"text"},{"text":" ","type":"text"},{"text":"apart, so this method adds no special-casing for it, and it is never retried","type":"text"},{"text":" ","type":"text"},{"text":"here.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The token is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"certificate-bound"}]},{"text":" (","type":"text"},{"code":"cnf.x5t#S256","type":"codeVoice"},{"text":") when AXIAM itself terminated","type":"text"},{"text":" ","type":"text"},{"text":"the TLS handshake (rule 9); ","type":"text"},{"code":"DeviceLoginResult.tokenType","type":"codeVoice"},{"text":" stays ","type":"text"},{"code":"\"Bearer\"","type":"codeVoice"},{"text":" either","type":"text"},{"text":" ","type":"text"},{"text":"way. A resource server verifying it locally MUST use","type":"text"},{"text":" ","type":"text"},{"code":"AxiamRequestAuthenticator.authenticateSenderConstrained(_:presentedThumbprint:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(or thread ","type":"text"},{"code":"PresentedProofs","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"authenticate(_:presentedProofs:)","type":"codeVoice"},{"text":") rather","type":"text"},{"text":" ","type":"text"},{"text":"than the plain ","type":"text"},{"code":"authenticate(_:)","type":"codeVoice"},{"text":", which — after this SDK’s own §10.1 rule 9 fix","type":"text"},{"text":" ","type":"text"},{"text":"— refuses a bound token with no evidence.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true,"type":"reference"},{"text":" client-side (no certificate configured, zero","type":"text"},{"text":" ","type":"text"},{"text":"wire calls) or from the server’s ","type":