{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"symbolKind":"method","roleHeading":"Instance Method","title":"authenticateDevice()","role":"symbol","externalID":"s:8AxiamSDK0A6ClientC18authenticateDeviceAC0E11LoginResultVyYaKF","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticateDevice","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamClient","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A6ClientC"},{"text":".","kind":"text"},{"text":"DeviceLoginResult","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A6ClientC17DeviceLoginResultV"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"abstract":[{"type":"codeVoice","code":"authenticateDevice()"},{"type":"text","text":" — the mTLS device login (CONTRACT.md §6.1 rules 6-10)."}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/authenticateDevice()","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticateDevice","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK0A6ClientC","text":"AxiamClient","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK0A6ClientC17DeviceLoginResultV","text":"DeviceLoginResult","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/DeviceLoginResult","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Issues ","type":"text"},{"code":"POST \/api\/v1\/auth\/device","type":"codeVoice"},{"text":" with no request body.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reachable only on a client configured with a client certificate"}]},{"type":"text","text":" (rule 7,"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/clientCertificate"},{"type":"text","text":"). On any other client this refuses"},{"type":"text","text":" "},{"type":"text","text":"CLIENT-SIDE with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"text":"zero wire calls","type":"text"}]},{"type":"text","text":": without a"},{"type":"text","text":" "},{"type":"text","text":"certificate the server would answer "},{"type":"codeVoice","code":"401"},{"type":"text","text":" regardless, so going to the wire would"},{"type":"text","text":" "},{"type":"text","text":"only turn a configuration mistake into an authentication failure."}],"type":"paragraph"},{"inlineContent":[{"text":"On success the returned token is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"adopted as this client’s credential"}]},{"text":", exactly","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"type":"codeVoice","code":"login()"},{"text":" result is (rule 6): every subsequent REST call this client sends —","type":"text"},{"text":" ","type":"text"},{"text":"including every ","type":"text"},{"type":"codeVoice","code":"management()"},{"text":" operation — carries it as ","type":"text"},{"type":"codeVoice","code":"Authorization: Bearer <token>"},{"text":" and withholds this client’s own cookie jar, so a session cookie from an","type":"text"},{"text":" ","type":"text"},{"text":"earlier ","type":"text"},{"type":"codeVoice","code":"login()"},{"text":" can never ride alongside it. The server reads the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"axiam_access"},{"text":" cookie before ","type":"text"},{"type":"codeVoice","code":"Authorization"},{"text":", so keeping a stale one would","type":"text"},{"text":" ","type":"text"},{"text":"silently run every later request as the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"previous","type":"text"}]},{"text":" session’s principal, defeating","type":"text"},{"text":" ","type":"text"},{"text":"the point of authenticating fresh.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"There is no refresh token","type":"text"}]},{"type":"text","text":" for this credential (rule 6, D-6 of the dogfooding"},{"type":"text","text":" "},{"type":"text","text":"plan): the §9 single-flight guard has nothing to spend on it, so a later "},{"type":"codeVoice","code":"401"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"on this call, or on any request this client sends afterward — is surfaced as"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","type":"reference"},{"type":"text","text":" with "},{"type":"strong","inlineContent":[{"text":"no refresh attempt","type":"text"}]},{"type":"text","text":". The caller recovers by calling"},{"type":"text","text":" "},{"type":"codeVoice","code":"authenticateDevice()"},{"type":"text","text":" again, which costs one TLS handshake."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Every refusal is a "},{"type":"codeVoice","code":"401"}],"type":"strong"},{"text":" (rule 8, server T22.4): an unknown, untrusted,","type":"text"},{"text":" ","type":"text"},{"text":"expired, revoked or unbound certificate, and a ","type":"text"},{"code":"Server","type":"codeVoice"},{"text":"-type certificate, all map","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","isActive":true,"type":"reference"},{"text":". A ","type":"text"},{"code":"429","type":"codeVoice"},{"text":" from the route’s per-IP rate limiter maps to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","isActive":true,"type":"reference"},{"text":" (§2), never ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","isActive":true,"type":"reference"},{"text":" — ","type":"text"},{"code":"mapError","type":"codeVoice"},{"text":" already keeps the two","type":"text"},{"text":" ","type":"text"},{"text":"apart, so this method adds no special-casing for it, and it is never retried","type":"text"},{"text":" ","type":"text"},{"text":"here.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The token is "},{"inlineContent":[{"type":"text","text":"certificate-bound"}],"type":"strong"},{"type":"text","text":" ("},{"code":"cnf.x5t#S256","type":"codeVoice"},{"type":"text","text":") when AXIAM itself terminated"},{"type":"text","text":" "},{"type":"text","text":"the TLS handshake (rule 9); "},{"code":"DeviceLoginResult.tokenType","type":"codeVoice"},{"type":"text","text":" stays "},{"code":"\"Bearer\"","type":"codeVoice"},{"type":"text","text":" either"},{"type":"text","text":" "},{"type":"text","text":"way. A resource server verifying it locally MUST use"},{"type":"text","text":" "},{"code":"AxiamRequestAuthenticator.authenticateSenderConstrained(_:presentedThumbprint:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(or thread "},{"code":"PresentedProofs","type":"codeVoice"},{"type":"text","text":" through "},{"code":"authenticate(_:presentedProofs:)","type":"codeVoice"},{"type":"text","text":") rather"},{"type":"text","text":" "},{"type":"text","text":"than the plain "},{"code":"authenticate(_:)","type":"codeVoice"},{"type":"text","text":", which — after this SDK’s own §10.1 rule 9 fix"},{"type":"text","text":" "},{"type":"text","text":"— refuses a bound token with no evidence."}],"type":"paragraph"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true,"type":"reference"},{"text":" client-side (no certificate configured, zero","type":"text"},{"text":" ","type":"text"},{"text":"wire calls) or from the server’s ","type":"text"},{"code":"401","type":"codeVoice"},{"text":"; ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","isActive":true,"type":"reference"},{"text":" for a ","type":"text"},{"code":"429","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or any other non-","type":"text"},{"code":"200","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"aside","style":"note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/authenticatedevice()"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/network(_:)":{"title":"AxiamError.network(_:)","type":"topic","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamerror\/network(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"network"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8AxiamSDK12NetworkErrorV","text":"NetworkError","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","abstract":[{"type":"text","text":"Transport-level failure: connection refused, timeout, TLS error, DNS failure,"},{"type":"text",