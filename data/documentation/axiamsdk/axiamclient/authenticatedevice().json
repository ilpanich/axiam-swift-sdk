{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticateDevice"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","text":"AxiamClient","preciseIdentifier":"s:8AxiamSDK0A6ClientC"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/DeviceLoginResult","text":"DeviceLoginResult","preciseIdentifier":"s:8AxiamSDK0A6ClientC17DeviceLoginResultV"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Issues "},{"type":"codeVoice","code":"POST \/api\/v1\/auth\/device"},{"type":"text","text":" with no request body."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Reachable only on a client configured with a client certificate","type":"text"}]},{"type":"text","text":" (rule 7,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/clientCertificate","isActive":true},{"type":"text","text":"). On any other client this refuses"},{"type":"text","text":" "},{"type":"text","text":"CLIENT-SIDE with "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"zero wire calls"}]},{"type":"text","text":": without a"},{"type":"text","text":" "},{"type":"text","text":"certificate the server would answer "},{"type":"codeVoice","code":"401"},{"type":"text","text":" regardless, so going to the wire would"},{"type":"text","text":" "},{"type":"text","text":"only turn a configuration mistake into an authentication failure."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On success the returned token is "},{"inlineContent":[{"type":"text","text":"adopted as this client’s credential"}],"type":"strong"},{"type":"text","text":", exactly"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"code":"login()","type":"codeVoice"},{"type":"text","text":" result is (rule 6): every subsequent REST call this client sends —"},{"type":"text","text":" "},{"type":"text","text":"including every "},{"code":"management()","type":"codeVoice"},{"type":"text","text":" operation — carries it as "},{"code":"Authorization: Bearer <token>","type":"codeVoice"},{"type":"text","text":" and withholds this client’s own cookie jar, so a session cookie from an"},{"type":"text","text":" "},{"type":"text","text":"earlier "},{"code":"login()","type":"codeVoice"},{"type":"text","text":" can never ride alongside it. The server reads the"},{"type":"text","text":" "},{"code":"axiam_access","type":"codeVoice"},{"type":"text","text":" cookie before "},{"code":"Authorization","type":"codeVoice"},{"type":"text","text":", so keeping a stale one would"},{"type":"text","text":" "},{"type":"text","text":"silently run every later request as the "},{"inlineContent":[{"type":"text","text":"previous"}],"type":"emphasis"},{"type":"text","text":" session’s principal, defeating"},{"type":"text","text":" "},{"type":"text","text":"the point of authenticating fresh."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"There is no refresh token"}]},{"text":" for this credential (rule 6, D-6 of the dogfooding","type":"text"},{"text":" ","type":"text"},{"text":"plan): the §9 single-flight guard has nothing to spend on it, so a later ","type":"text"},{"code":"401","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"on this call, or on any request this client sends afterward — is surfaced as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","type":"reference","isActive":true},{"text":" with ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"no refresh attempt"}]},{"text":". The caller recovers by calling","type":"text"},{"text":" ","type":"text"},{"code":"authenticateDevice()","type":"codeVoice"},{"text":" again, which costs one TLS handshake.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Every refusal is a ","type":"text"},{"type":"codeVoice","code":"401"}]},{"text":" (rule 8, server T22.4): an unknown, untrusted,","type":"text"},{"text":" ","type":"text"},{"text":"expired, revoked or unbound certificate, and a ","type":"text"},{"type":"codeVoice","code":"Server"},{"text":"-type certificate, all map","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","type":"reference"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"429"},{"text":" from the route’s per-IP rate limiter maps to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","type":"reference"},{"text":" (§2), never ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","type":"reference"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"mapError"},{"text":" already keeps the two","type":"text"},{"text":" ","type":"text"},{"text":"apart, so this method adds no special-casing for it, and it is never retried","type":"text"},{"text":" ","type":"text"},{"text":"here.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The token is "},{"inlineContent":[{"type":"text","text":"certificate-bound"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"cnf.x5t#S256"},{"type":"text","text":") when AXIAM itself terminated"},{"type":"text","text":" "},{"type":"text","text":"the TLS handshake (rule 9); "},{"type":"codeVoice","code":"DeviceLoginResult.tokenType"},{"type":"text","text":" stays "},{"type":"codeVoice","code":"\"Bearer\""},{"type":"text","text":" either"},{"type":"text","text":" "},{"type":"text","text":"way. A resource server verifying it locally MUST use"},{"type":"text","text":" "},{"type":"codeVoice","code":"AxiamRequestAuthenticator.authenticateSenderConstrained(_:presentedThumbprint:)"},{"type":"text","text":" "},{"type":"text","text":"(or thread "},{"type":"codeVoice","code":"PresentedProofs"},{"type":"text","text":" through "},{"type":"codeVoice","code":"authenticate(_:presentedProofs:)"},{"type":"text","text":") rather"},{"type":"text","text":" "},{"type":"text","text":"than the plain "},{"type":"codeVoice","code":"authenticate(_:)"},{"type":"text","text":", which — after this SDK’s own §10.1 rule 9 fix"},{"type":"text","text":" "},{"type":"text","text":"— refuses a bound token with no evidence."}],"type":"paragraph"},{"style":"note","name":"Throws","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference"},{"text":" client-side (no certificate configured, zero","type":"text"},{"text":" ","type":"text"},{"text":"wire calls) or from the server’s ","type":"text"},{"code":"401","type":"codeVoice"},{"text":"; ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","type":"reference"},{"text":" for a ","type":"text"},{"code":"429","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or any other non-","type":"text"},{"code":"200","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/authenticatedevice()"]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/authenticateDevice()","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"codeVoice","code":"authenticateDevice()"},{"text":" — the mTLS device login (CONTRACT.md §6.1 rules 6-10).","type":"text"}],"metadata":{"externalID":"s:8AxiamSDK0A6ClientC18authenticateDeviceAC0E11LoginResultVyYaKF","symbolKind":"method","roleHeading":"Instance Method","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticateDevice","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamClient","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A6ClientC"},{"text":".","kind":"text"},{"text":"DeviceLoginResult","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A6ClientC17DeviceLoginResultV"}],"modules":[{"name":"AxiamSDK"}],"title":"authenticateDevice()"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamclient","type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT