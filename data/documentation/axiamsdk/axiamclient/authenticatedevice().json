{"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticateDevice"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A6ClientC","text":"AxiamClient"},{"kind":"text","text":"."},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/DeviceLoginResult","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A6ClientC17DeviceLoginResultV","text":"DeviceLoginResult"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Issues "},{"code":"POST \/api\/v1\/auth\/device","type":"codeVoice"},{"type":"text","text":" with no request body."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Reachable only on a client configured with a client certificate"}],"type":"strong"},{"type":"text","text":" (rule 7,"},{"type":"text","text":" "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/clientCertificate","isActive":true,"type":"reference"},{"type":"text","text":"). On any other client this refuses"},{"type":"text","text":" "},{"type":"text","text":"CLIENT-SIDE with "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"zero wire calls"}],"type":"strong"},{"type":"text","text":": without a"},{"type":"text","text":" "},{"type":"text","text":"certificate the server would answer "},{"code":"401","type":"codeVoice"},{"type":"text","text":" regardless, so going to the wire would"},{"type":"text","text":" "},{"type":"text","text":"only turn a configuration mistake into an authentication failure."}],"type":"paragraph"},{"inlineContent":[{"text":"On success the returned token is ","type":"text"},{"inlineContent":[{"text":"adopted as this client’s credential","type":"text"}],"type":"strong"},{"text":", exactly","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"type":"codeVoice","code":"login()"},{"text":" result is (rule 6): every subsequent REST call this client sends —","type":"text"},{"text":" ","type":"text"},{"text":"including every ","type":"text"},{"type":"codeVoice","code":"management()"},{"text":" operation — carries it as ","type":"text"},{"type":"codeVoice","code":"Authorization: Bearer <token>"},{"text":" and withholds this client’s own cookie jar, so a session cookie from an","type":"text"},{"text":" ","type":"text"},{"text":"earlier ","type":"text"},{"type":"codeVoice","code":"login()"},{"text":" can never ride alongside it. The server reads the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"axiam_access"},{"text":" cookie before ","type":"text"},{"type":"codeVoice","code":"Authorization"},{"text":", so keeping a stale one would","type":"text"},{"text":" ","type":"text"},{"text":"silently run every later request as the ","type":"text"},{"inlineContent":[{"type":"text","text":"previous"}],"type":"emphasis"},{"text":" session’s principal, defeating","type":"text"},{"text":" ","type":"text"},{"text":"the point of authenticating fresh.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"There is no refresh token"}]},{"type":"text","text":" for this credential (rule 6, D-6 of the dogfooding"},{"type":"text","text":" "},{"type":"text","text":"plan): the §9 single-flight guard has nothing to spend on it, so a later "},{"type":"codeVoice","code":"401"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"on this call, or on any request this client sends afterward — is surfaced as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","isActive":true},{"type":"text","text":" with "},{"type":"strong","inlineContent":[{"type":"text","text":"no refresh attempt"}]},{"type":"text","text":". The caller recovers by calling"},{"type":"text","text":" "},{"type":"codeVoice","code":"authenticateDevice()"},{"type":"text","text":" again, which costs one TLS handshake."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Every refusal is a ","type":"text"},{"code":"401","type":"codeVoice"}]},{"type":"text","text":" (rule 8, server T22.4): an unknown, untrusted,"},{"type":"text","text":" "},{"type":"text","text":"expired, revoked or unbound certificate, and a "},{"type":"codeVoice","code":"Server"},{"type":"text","text":"-type certificate, all map"},{"type":"text","text":" "},{"type":"text","text":"to "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","type":"reference","isActive":true},{"type":"text","text":". A "},{"type":"codeVoice","code":"429"},{"type":"text","text":" from the route’s per-IP rate limiter maps to"},{"type":"text","text":" "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","type":"reference","isActive":true},{"type":"text","text":" (§2), never "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","type":"reference","isActive":true},{"type":"text","text":" — "},{"type":"codeVoice","code":"mapError"},{"type":"text","text":" already keeps the two"},{"type":"text","text":" "},{"type":"text","text":"apart, so this method adds no special-casing for it, and it is never retried"},{"type":"text","text":" "},{"type":"text","text":"here."}],"type":"paragraph"},{"inlineContent":[{"text":"The token is ","type":"text"},{"inlineContent":[{"text":"certificate-bound","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"cnf.x5t#S256","type":"codeVoice"},{"text":") when AXIAM itself terminated","type":"text"},{"text":" ","type":"text"},{"text":"the TLS handshake (rule 9); ","type":"text"},{"code":"DeviceLoginResult.tokenType","type":"codeVoice"},{"text":" stays ","type":"text"},{"code":"\"Bearer\"","type":"codeVoice"},{"text":" either","type":"text"},{"text":" ","type":"text"},{"text":"way. A resource server verifying it locally MUST use","type":"text"},{"text":" ","type":"text"},{"code":"AxiamRequestAuthenticator.authenticateSenderConstrained(_:presentedThumbprint:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(or thread ","type":"text"},{"code":"PresentedProofs","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"authenticate(_:presentedProofs:)","type":"codeVoice"},{"text":") rather","type":"text"},{"text":" ","type":"text"},{"text":"than the plain ","type":"text"},{"code":"authenticate(_:)","type":"codeVoice"},{"text":", which — after this SDK’s own §10.1 rule 9 fix","type":"text"},{"text":" ","type":"text"},{"text":"— refuses a bound token with no evidence.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"type":"text","text":" client-side (no certificate configured, zero"},{"type":"text","text":" "},{"type":"text","text":"wire calls) or from the server’s "},{"code":"401","type":"codeVoice"},{"type":"text","text":"; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},{"type":"text","text":" for a "},{"code":"429","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or any other non-"},{"code":"200","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"Throws","type":"aside","style":"note"}]}],"identifier":{"interface