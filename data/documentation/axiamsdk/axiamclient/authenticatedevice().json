{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/authenticateDevice()"},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/authenticatedevice()"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"authenticateDevice()","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","externalID":"s:8AxiamSDK0A6ClientC18authenticateDeviceAC0E11LoginResultVyYaKF","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticateDevice","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamClient","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A6ClientC"},{"text":".","kind":"text"},{"text":"DeviceLoginResult","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A6ClientC17DeviceLoginResultV"}]},"abstract":[{"type":"codeVoice","code":"authenticateDevice()"},{"type":"text","text":" — the mTLS device login (CONTRACT.md §6.1 rules 6-10)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticateDevice","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamClient","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","preciseIdentifier":"s:8AxiamSDK0A6ClientC"},{"text":".","kind":"text"},{"text":"DeviceLoginResult","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/DeviceLoginResult","preciseIdentifier":"s:8AxiamSDK0A6ClientC17DeviceLoginResultV"}]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Issues "},{"type":"codeVoice","code":"POST \/api\/v1\/auth\/device"},{"type":"text","text":" with no request body."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Reachable only on a client configured with a client certificate","type":"text"}]},{"type":"text","text":" (rule 7,"},{"type":"text","text":" "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/clientCertificate","type":"reference","isActive":true},{"type":"text","text":"). On any other client this refuses"},{"type":"text","text":" "},{"type":"text","text":"CLIENT-SIDE with "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"zero wire calls"}]},{"type":"text","text":": without a"},{"type":"text","text":" "},{"type":"text","text":"certificate the server would answer "},{"type":"codeVoice","code":"401"},{"type":"text","text":" regardless, so going to the wire would"},{"type":"text","text":" "},{"type":"text","text":"only turn a configuration mistake into an authentication failure."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On success the returned token is "},{"inlineContent":[{"type":"text","text":"adopted as this client’s credential"}],"type":"strong"},{"type":"text","text":", exactly"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"login()"},{"type":"text","text":" result is (rule 6): every subsequent REST call this client sends —"},{"type":"text","text":" "},{"type":"text","text":"including every "},{"type":"codeVoice","code":"management()"},{"type":"text","text":" operation — carries it as "},{"type":"codeVoice","code":"Authorization: Bearer <token>"},{"type":"text","text":" and withholds this client’s own cookie jar, so a session cookie from an"},{"type":"text","text":" "},{"type":"text","text":"earlier "},{"type":"codeVoice","code":"login()"},{"type":"text","text":" can never ride alongside it. The server reads the"},{"type":"text","text":" "},{"type":"codeVoice","code":"axiam_access"},{"type":"text","text":" cookie before "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":", so keeping a stale one would"},{"type":"text","text":" "},{"type":"text","text":"silently run every later request as the "},{"inlineContent":[{"text":"previous","type":"text"}],"type":"emphasis"},{"type":"text","text":" session’s principal, defeating"},{"type":"text","text":" "},{"type":"text","text":"the point of authenticating fresh."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"There is no refresh token","type":"text"}],"type":"strong"},{"text":" for this credential (rule 6, D-6 of the dogfooding","type":"text"},{"text":" ","type":"text"},{"text":"plan): the §9 single-flight guard has nothing to spend on it, so a later ","type":"text"},{"code":"401","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"on this call, or on any request this client sends afterward — is surfaced as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","isActive":true,"type":"reference"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"no refresh attempt"}],"type":"strong"},{"text":". The caller recovers by calling","type":"text"},{"text":" ","type":"text"},{"code":"authenticateDevice()","type":"codeVoice"},{"text":" again, which costs one TLS handshake.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Every refusal is a "},{"type":"codeVoice","code":"401"}]},{"type":"text","text":" (rule 8, server T22.4): an unknown, untrusted,"},{"type":"text","text":" "},{"type":"text","text":"expired, revoked or unbound certificate, and a "},{"code":"Server","type":"codeVoice"},{"type":"text","text":"-type certificate, all map"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError"},{"type":"text","text":". A "},{"code":"429","type":"codeVoice"},{"type":"text","text":" from the route’s per-IP rate limiter maps to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError"},{"type":"text","text":" (§2), never "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError"},{"type":"text","text":" — "},{"code":"mapError","type":"codeVoice"},{"type":"text","text":" already keeps the two"},{"type":"text","text":" "},{"type":"text","text":"apart, so this method adds no special-casing for it, and it is never retried"},{"type":"text","text":" "},{"type":"text","text":"here."}],"type":"paragraph"},{"inlineContent":[{"text":"The token is ","type":"text"},{"inlineContent":[{"text":"certificate-bound","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"cnf.x5t#S256","type":"codeVoice"},{"text":") when AXIAM itself terminated","type":"text"},{"text":" ","type":"text"},{"text":"the TLS handshake (rule 9); ","type":"text"},{"code":"DeviceLoginResult.tokenType","type":"codeVoice"},{"text":" stays ","type":"text"},{"code":"\"Bearer\"","type":"codeVoice"},{"text":" either","type":"text"},{"text":" ","type":"text"},{"text":"way. A resource server verifying it locally MUST use","type":"text"},{"text":" ","type":"text"},{"code":"AxiamRequestAuthenticator.authenticateSenderConstrained(_:presentedThumbprint:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(or thread ","type":"text"},{"code":"PresentedProofs","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"authenticate(_:presentedProofs:)","type":"codeVoice"},{"text":") rather","type":"text"},{"text":" ","type":"text"},{"text":"than the plain ","type":"text"},{"code":"authenticate(_:)","type":"codeVoice"},{"text":", which — after this SDK’s own §10.1 rule 9 fix","type":"text"},{"text":" ","type":"text"},{"text":"— refuses a bound token with no evidence.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"type":"text","text":" client-side (no certificate configured, zero"},{"type":"text","text":" "},{"type":"text","text":"wire calls) or from the server’s "},{"code":"401","type":"codeVoice"},{"type":"text","text":"; "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","type":"reference","isActive":true},{"type":"text","text":" for a "},{"code":"429","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or any other non-"},{"code":"200","type":"codeVoice"},{"type":"text","text":"."}]}]}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"navigatorTitle":[{"kind":"identifier","text":"AxiamClient"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamClient"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"title":"AxiamClient","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamclient"},"doc://AxiamSDK/documentation/AxiamSDK/AuthError":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","type":"topic","url":"\/documentation\/axiamsdk\/autherror","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthError"}],"abstract":[{"type":"text","text":"Authentication failure (§2). Carries a human-readable "},{"type":"codeVoice","code":"message"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"AuthError"}],"role":"symbol","title":"AuthError"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/auth(_:)":{"abstract":[{"type":"text","text":"Authentication failure: wrong credentials, expired session, MFA failure,"},{"type":"text","text":" "},{"type":"text","text":"or a 401 on the refresh call itself."}],"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"auth"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8AxiamSDK9AuthErrorV","kind":"typeIdentifier","text":"AuthError"},{"kind":"text","text":")"}],"title":"AxiamError.auth(_:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamerror\/auth(_:)","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/NetworkError":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkError","abstract":[{"type":"text","text":"Transport-level failure (§2). Carries the underlying transport error as "},{"type":"codeVoice","code":"cause"},{"type":"text","text":" "},{"type":"text","text":"where one exists (connection refused, timeout, TLS handshake failure, DNS)."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NetworkError","kind":"identifier"}],"navigatorTitle":[{"text":"NetworkError","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/networkerror","role":"symbol","title":"NetworkError"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/authenticateDevice()":{"abstract":[{"type":"codeVoice","code":"authenticateDevice()"},{"type":"text","text":" — the mTLS de