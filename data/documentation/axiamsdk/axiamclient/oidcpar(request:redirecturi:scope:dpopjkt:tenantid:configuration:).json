{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"codeVoice","code":"POST \/oauth2\/par"},{"text":" (CONTRACT.md §26.1) — push the authorization request over the","type":"text"},{"text":" ","type":"text"},{"text":"back channel and get an opaque handle to redirect with.","type":"text"}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/oidcpar(request:redirecturi:scope:dpopjkt:tenantid:configuration:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oidcPar","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthorizationRequest","text":"AuthorizationRequest","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV"},{"text":", ","kind":"text"},{"text":"redirectURI","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = \"openid profile email\", ","kind":"text"},{"text":"dpopJkt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","text":"OidcConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizationRequest","text":"PushedAuthorizationRequest","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"request","content":[{"inlineContent":[{"type":"text","text":"what "},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:configuration:)","type":"reference"},{"type":"text","text":" returned. Its"},{"type":"text","text":" "},{"type":"codeVoice","code":"state"},{"type":"text","text":", "},{"type":"codeVoice","code":"nonce"},{"type":"text","text":" and PKCE verifier are pushed as-is — §26.2 rule 1 forbids a"},{"type":"text","text":" "},{"type":"text","text":"second generator."}],"type":"paragraph"}]},{"name":"redirectURI","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the same redirect URI that will be sent at exchange time."}]}]},{"name":"scope","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the requested scope. Must match what was pushed at "},{"code":"oidcBegin","type":"codeVoice"},{"type":"text","text":"."}]}]},{"name":"dpopJkt","content":[{"inlineContent":[{"text":"RFC 9449 §10.1 — the JWK SHA-256 thumbprint of the key the client will","type":"text"},{"text":" ","type":"text"},{"text":"prove possession of at the token endpoint, binding the authorization code to that","type":"text"},{"text":" ","type":"text"},{"text":"key from the moment it is issued rather than from first use. Sent ","type":"text"},{"type":"strong","inlineContent":[{"text":"only when","type":"text"},{"text":" ","type":"text"},{"text":"given","type":"text"}]},{"text":"; omitting it is the unbound behaviour every release before contract 1.42","type":"text"},{"text":" ","type":"text"},{"text":"had. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Caller-supplied, and it has to be"}]},{"text":": CONTRACT.md §21.9 records this SDK as","type":"text"},{"text":" ","type":"text"},{"text":"verifying DPoP proofs but not generating them, so it holds no client key and has","type":"text"},{"text":" ","type":"text"},{"text":"no thumbprint of its own to offer. An application doing DPoP computes the","type":"text"},{"text":" ","type":"text"},{"text":"thumbprint over its own key (RFC 7638) and passes it here.","type":"text"}],"type":"paragraph"}]},{"name":"tenantID","content":[{"inlineContent":[{"type":"text","text":"a tenant override for the "},{"type":"codeVoice","code":"?tenant_id="},{"type":"text","text":" query parameter."}],"type":"paragraph"}]},{"name":"configuration","content":[{"inlineContent":[{"text":"the discovery document, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to discover.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"PAR moves the authorization request off the browser. Instead of putting ","type":"text"},{"type":"codeVoice","code":"scope"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"redirect_uri"},{"text":", ","type":"text"},{"type":"codeVoice","code":"state"},{"text":" and the PKCE challenge into a URL the user agent carries,","type":"text"},{"text":" ","type":"text"},{"text":"the client POSTs them straight to AXIAM over an authenticated channel and puts an","type":"text"},{"text":" ","type":"text"},{"text":"opaque ","type":"text"},{"type":"codeVoice","code":"request_uri"},{"text":" in the redirect. What travels through the browser is then a","type":"text"},{"text":" ","type":"text"},{"text":"random string that cannot be edited into meaning something else.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Required for a FAPI 2.0 client","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"profile: \"fapi2\""},{"type":"text","text":" refuses a registration that"},{"type":"text","text":" "},{"type":"text","text":"does not set "},{"type":"codeVoice","code":"require_par"},{"type":"text","text":", so such a client cannot authorize any other way (§21.1)."}],"type":"paragraph"},{"inlineContent":[{"text":"Not retried on a ","type":"text"},{"code":"5xx","type":"codeVoice"},{"text":" or a transport failure — it is a POST that creates server","type":"text"},{"text":" ","type":"text"},{"text":"state, so it falls outside §16.2’s read-only eligibility exactly as ","type":"text"},{"code":"oidcExchange","type":"codeVoice"},{"text":" ","type":"text"},{"text":"does. The safe recovery is a fresh push, which costs one round trip and cannot","type":"text"},{"text":" ","type":"text"},{"text":"double-consume anything (§26.2 rule 4).","type":"text"}],"type":"paragraph"},{"name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"type":"text","text":" client-side, with "},{"inlineContent":[{"type":"text","text":"no wire call"}],"type":"strong"},{"type":"text","text":", when the"},{"type":"text","text":" "},{"type":"text","text":"discovery document advertises no PAR endpoint — §12.7.2 rule 1’s discipline: never"},{"type":"text","text":" "},{"type":"text","text":"synthesise the URL from the issuer."}]}],"type":"aside"}],"kind":"content"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcPar(request:redirectURI:scope:dpopJkt:tenantID:configuration:)","interfaceLanguage":"swift"},"metadata":{"title":"oidcPar(request:redirectURI:scope:dpopJkt:tenantID:co