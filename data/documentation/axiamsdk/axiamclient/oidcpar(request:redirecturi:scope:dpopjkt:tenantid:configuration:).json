nd":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","kind":"typeIdentifier","text":"PushedAuthorizationRequest"}],"roleHeading":"Instance Method","externalID":"s:8AxiamSDK0A6ClientC7oidcPar7request11redirectURI5scope7dpopJkt8tenantID13configurationAA26PushedAuthorizationRequestVAA0pQ0V_S3SSgAoA17OidcConfigurationVSgtYaKF"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"oidcPar"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthorizationRequest","preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV","text":"AuthorizationRequest"},{"kind":"text","text":", "},{"kind":"externalParam","text":"redirectURI"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" = \"openid profile email\", "},{"kind":"externalParam","text":"dpopJkt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizationRequest","preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","text":"PushedAuthorizationRequest"}],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"What "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:configuration:)","isActive":true,"type":"reference"},{"type":"text","text":" returned. Its"},{"type":"text","text":" "},{"code":"state","type":"codeVoice"},{"type":"text","text":", "},{"code":"nonce","type":"codeVoice"},{"type":"text","text":" and PKCE verifier are pushed as-is — §26.2 rule 1 forbids a"},{"type":"text","text":" "},{"type":"text","text":"second generator."}],"type":"paragraph"}],"name":"request"},{"content":[{"inlineContent":[{"text":"The same redirect URI that will be sent at exchange time.","type":"text"}],"type":"paragraph"}],"name":"redirectURI"},{"content":[{"inlineContent":[{"text":"The requested scope. Must match what was pushed at ","type":"text"},{"type":"codeVoice","code":"oidcBegin"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"scope"},{"content":[{"inlineContent":[{"type":"text","text":"RFC 9449 §10.1 — the JWK SHA-256 thumbprint of the key the client will"},{"type":"text","text":" "},{"type":"text","text":"prove possession of at the token endpoint, binding the authorization code to that"},{"type":"text","text":" "},{"type":"text","text":"key from the moment it is issued rather than from first use. Sent "},{"type":"strong","inlineContent":[{"text":"only when","type":"text"},{"text":" ","type":"text"},{"text":"given","type":"text"}]},{"type":"text","text":"; omitting it is the unbound behaviour every release before contract 1.42"},{"type":"text","text":" "},{"type":"text","text":"had. "},{"type":"strong","inlineContent":[{"text":"Caller-supplied, and it has to be","type":"text"}]},{"type":"text","text":": CONTRACT.md §21.9 records this SDK as"},{"type":"text","text":" "},{"type":"text","text":"verifying DPoP proofs but not generating them, so it holds no client key and has"},{"type":"text","text":" "},{"type":"text","text":"no thumbprint of its own to offer. An application doing DPoP computes the"},{"type":"text","text":" "},{"type":"text","text":"thumbprint over its own key (RFC 7638) and passes it here."}],"type":"paragraph"}],"name":"dpopJkt"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A tenant override for the ","type":"text"},{"type":"codeVoice","code":"?tenant_id="},{"text":" query parameter.","type":"text"}]}],"name":"tenantID"},{"content":[{"inlineContent":[{"text":"The discovery document, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to discover.","type":"text"}],"type":"paragraph"}],"name":"configuration"}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"PAR moves the authorization request off the browser. Instead of putting ","type":"text"},{"code":"scope","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"redirect_uri","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" and the PKCE challenge into a URL the user agent carries,","type":"text"},{"text":" ","type":"text"},{"text":"the client POSTs them straight to AXIAM over an authenticated channel and puts an","type":"text"},{"text":" ","type":"text"},{"text":"opaque ","type":"text"},{"code":"request_uri","type":"codeVoice"},{"text":" in the redirect. What travels through the browser is then a","type":"text"},{"text":" ","type":"text"},{"text":"random string that cannot be edited into meaning something else.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Required for a FAPI 2.0 client"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"profile: \"fapi2\""},{"type":"text","text":" refuses a registration that"},{"type":"text","text":" "},{"type":"text","text":"does not set "},{"type":"codeVoice","code":"require_par"},{"type":"text","text":", so such a client cannot authorize any other way (§21.1)."}]},{"type":"paragraph","inlineContent":[{"text":"Not retried on a ","type":"text"},{"type":"codeVoice","code":"5xx"},{"text":" or a transport failure — it is a POST that creates server","type":"text"},{"text":" ","type":"text"},{"text":"state, so it falls outside §16.2’s read-only eligibility exactly as ","type":"text"},{"type":"codeVoice","code":"oidcExchange"},{"text":" ","type":"text"},{"text":"does. The safe recovery is a fresh push, which costs one round trip and cannot","type":"text"},{"text":" ","type":"text"},{"text":"double-consume anything (§26.2 rule 4).","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"text":" client-side, with ","type":"text"},{"inlineContent":[{"text":"no wire call","type":"text"}],"type":"strong"},{"text":", when the","type":"text"},{"text":" ","type":"text"},{"text":"discovery document advertises no PAR endpoint — §12.7.2 rule 1’s discipline: never","type":"text"},{"text":" ","type":"text"},{"text":"synthesise the URL from the issuer.","type":"text"}]}],"type":"aside","style":"note","name":"Throws"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/oidcpar(request:redirecturi:scope:dpopjkt:tenantid:configuration:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PushedAuthorizationRequest":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizatio