{"metadata":{"externalID":"s:8AxiamSDK0A6ClientC7oidcPar7request11redirectURI5scope7dpopJkt8tenantID13configurationAA26PushedAuthorizationRequestVAA0pQ0V_S3SSgAoA17OidcConfigurationVSgtYaKF","extendedModule":"AxiamSDK","modules":[{"name":"AxiamSDK"}],"title":"oidcPar(request:redirectURI:scope:dpopJkt:tenantID:configuration:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oidcPar","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV","text":"AuthorizationRequest","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"redirectURI","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"dpopJkt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","text":"PushedAuthorizationRequest","kind":"typeIdentifier"}],"symbolKind":"method","roleHeading":"Instance Method"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oidcPar","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AuthorizationRequest","preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthorizationRequest","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"redirectURI","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":" = \"openid profile email\", ","kind":"text"},{"text":"dpopJkt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"tenantID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcConfiguration","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"PushedAuthorizationRequest","preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizationRequest","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"what "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:configuration:)","isActive":true},{"type":"text","text":" returned. Its"},{"type":"text","text":" "},{"type":"codeVoice","code":"state"},{"type":"text","text":", "},{"type":"codeVoice","code":"nonce"},{"type":"text","text":" and PKCE verifier are pushed as-is — §26.2 rule 1 forbids a"},{"type":"text","text":" "},{"type":"text","text":"second generator."}]}],"name":"request"},{"content":[{"inlineContent":[{"type":"text","text":"the same redirect URI that will be sent at exchange time."}],"type":"paragraph"}],"name":"redirectURI"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the requested scope. Must match what was pushed at "},{"code":"oidcBegin","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"scope"},{"content":[{"type":"paragraph","inlineContent":[{"text":"RFC 9449 §10.1 — the JWK SHA-256 thumbprint of the key the client will","type":"text"},{"text":" ","type":"text"},{"text":"prove possession of at the token endpoint, binding the authorization code to that","type":"text"},{"text":" ","type":"text"},{"text":"key from the moment it is issued rather than from first use. Sent ","type":"text"},{"type":"strong","inlineContent":[{"text":"only when","type":"text"},{"text":" ","type":"text"},{"text":"given","type":"text"}]},{"text":"; omitting it is the unbound behaviour every release before contract 1.42","type":"text"},{"text":" ","type":"text"},{"text":"had. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Caller-supplied, and it has to be","type":"text"}]},{"text":": CONTRACT.md §21.9 records this SDK as","type":"text"},{"text":" ","type":"text"},{"text":"verifying DPoP proofs but not generating them, so it holds no client key and has","type":"text"},{"text":" ","type":"text"},{"text":"no thumbprint of its own to offer. An application doing DPoP computes the","type":"text"},{"text":" ","type":"text"},{"text":"thumbprint over its own key (RFC 7638) and passes it here.","type":"text"}]}],"name":"dpopJkt"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a tenant override for the "},{"type":"codeVoice","code":"?tenant_id="},{"type":"text","text":" query parameter."}]}],"name":"tenantID"},{"content":[{"inlineContent":[{"type":"text","text":"the discovery document, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to discover."}],"type":"paragraph"}],"name":"configuration"}],"kind":"parameters"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"PAR moves the authorization request off the browser. Instead of putting ","type":"text"},{"type":"codeVoice","code":"scope"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"redirect_uri"},{"text":", ","type":"text"},{"type":"codeVoice","code":"state"},{"text":" and the PKCE challenge into a URL the user agent carries,","type":"text"},{"text":" ","type":"text"},{"text":"the client POSTs them straight to AXIAM over an authenticated channel and puts an","type":"text"},{"text":" ","type":"text"},{"text":"opaque ","type":"text"},{"type":"codeVoice","code":"request_uri"},{"text":" in the redirect. What travels through the browser is then a","type":"text"},{"text":" ","type":"text"},{"text":"random string that cannot be edited into meaning something else.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Required for a FAPI 2.0 client"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"profile: \"fapi2\""},{"type":"text","text":" refuses a registration that"},{"type":"text","text":" "},{"type":"text","text":"does not set "},{"type":"codeVoice","code":"require_par"},{"type":"text","text":", so such a client cannot authorize any other way (§21.1)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not retried on a "},{"type":"codeVoice","code":"5xx"},{"type":"text","text":" or a transport failure — it is a POST that creates server"},{"type":"text","text":" "},{"type":"text","text":"state, so it falls outside §16.2’s read-only eligibility exactly as "},{"type":"codeVoice","code":"oidcExchange"},{"type":"text","text":" "},{"type":"text","text":"does. The safe recovery is a fresh push, which costs one round trip and cannot"},{"type":"text","text":" "},{"type":"text","text":"double-consume anything (§26.2 rule 4)."}]},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"type":"text","text":" client-side, with "},{"type":"strong","inlineContent":[{"type":"text","text":"no wire call"}]},{"type":"text","text":", when the"},{"type":"text","text":" "},{"type":"text","text":"discovery document advertises no PAR endpoint — §12.7.2 rule 1’s discipline: never"},{"type":"text","text":" "},{"type":"text","text":"synthesise the URL from the issuer."}]}],"style":"note","type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/oidcpar(request:redirecturi:scope:dpopjkt:tenantid:configuration:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcPar(request:redirectURI:scope:dpopJkt:tenantID:configuration:)"},"kind":"symbol","abstract":[{"type":"codeVoice","code":"POST \/oauth2\/par"},{"text":" (CONTRACT.md §26.1) — push the authorization request over the","type":"text"},{"text":" ","type":"text"},{"text":"back channel and get an opaque handle to redirect with.","type":"text"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AuthorizationRequest":{"title":"AuthorizationRequest","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"t