{"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/oidcpar(request:redirecturi:scope:dpopjkt:tenantid:configuration:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oidcPar","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV","text":"AuthorizationRequest","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"redirectURI","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"dpopJkt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","text":"PushedAuthorizationRequest"}],"externalID":"s:8AxiamSDK0A6ClientC7oidcPar7request11redirectURI5scope7dpopJkt8tenantID13configurationAA26PushedAuthorizationRequestVAA0pQ0V_S3SSgAoA17OidcConfigurationVSgtYaKF","roleHeading":"Instance Method","title":"oidcPar(request:redirectURI:scope:dpopJkt:tenantID:configuration:)","role":"symbol","extendedModule":"AxiamSDK","modules":[{"name":"AxiamSDK"}],"symbolKind":"method"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"oidcPar"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthorizationRequest","kind":"typeIdentifier","text":"AuthorizationRequest"},{"kind":"text","text":", "},{"kind":"externalParam","text":"redirectURI"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":" = \"openid profile email\", "},{"kind":"externalParam","text":"dpopJkt"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","kind":"typeIdentifier","text":"OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizationRequest","kind":"typeIdentifier","text":"PushedAuthorizationRequest"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"request","content":[{"inlineContent":[{"type":"text","text":"what "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:configuration:)"},{"type":"text","text":" returned. Its"},{"type":"text","text":" "},{"type":"codeVoice","code":"state"},{"type":"text","text":", "},{"type":"codeVoice","code":"nonce"},{"type":"text","text":" and PKCE verifier are pushed as-is — §26.2 rule 1 forbids a"},{"type":"text","text":" "},{"type":"text","text":"second generator."}],"type":"paragraph"}]},{"name":"redirectURI","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the same redirect URI that will be sent at exchange time."}]}]},{"name":"scope","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the requested scope. Must match what was pushed at "},{"code":"oidcBegin","type":"codeVoice"},{"type":"text","text":"."}]}]},{"name":"dpopJkt","content":[{"inlineContent":[{"type":"text","text":"RFC 9449 §10.1 — the JWK SHA-256 thumbprint of the key the client will"},{"type":"text","text":" "},{"type":"text","text":"prove possession of at the token endpoint, binding the authorization code to that"},{"type":"text","text":" "},{"type":"text","text":"key from the moment it is issued rather than from first use. Sent "},{"inlineContent":[{"text":"only when","type":"text"},{"text":" ","type":"text"},{"text":"given","type":"text"}],"type":"strong"},{"type":"text","text":"; omitting it is the unbound behaviour every release before contract 1.42"},{"type":"text","text":" "},{"type":"text","text":"had. "},{"inlineContent":[{"text":"Caller-supplied, and it has to be","type":"text"}],"type":"strong"},{"type":"text","text":": CONTRACT.md §21.9 records this SDK as"},{"type":"text","text":" "},{"type":"text","text":"verifying DPoP proofs but not generating them, so it holds no client key and has"},{"type":"text","text":" "},{"type":"text","text":"no thumbprint of its own to offer. An application doing DPoP computes the"},{"type":"text","text":" "},{"type":"text","text":"thumbprint over its own key (RFC 7638) and passes it here."}],"type":"paragraph"}]},{"name":"tenantID","content":[{"inlineContent":[{"type":"text","text":"a tenant override for the "},{"type":"codeVoice","code":"?tenant_id="},{"type":"text","text":" query parameter."}],"type":"paragraph"}]},{"name":"configuration","content":[{"type":"paragraph","inlineContent":[{"text":"the discovery document, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" to discover.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"PAR moves the authorization request off the browser. Instead of putting ","type":"text"},{"code":"scope","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"redirect_uri","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" and the PKCE challenge into a URL the user agent carries,","type":"text"},{"text":" ","type":"text"},{"text":"the client POSTs them straight to AXIAM over an authenticated channel and puts an","type":"text"},{"text":" ","type":"text"},{"text":"opaque ","type":"text"},{"code":"request_uri","type":"codeVoice"},{"text":" in the redirect. What travels through the browser is then a","type":"text"},{"text":" ","type":"text"},{"text":"random string that cannot be edited into meaning something else.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Required for a FAPI 2.0 client","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"profile: \"fapi2\""},{"type":"text","text":" refuses a registration that"},{"type":"text","text":" "},{"type":"text","text":"does not set "},{"type":"codeVoice","code":"require_par"},{"type":"text","text":", so such a client cannot authorize any other way (§21.1)."}],"type":"paragraph"},{"inlineContent":[{"text":"Not retried on a ","type":"text"},{"type":"codeVoice","code":"5xx"},{"text":" or a transport failure — it is a POST that creates server","type":"text"},{"text":" ","type":"text"},{"text":"state, so it falls outside §16.2’s read-only eligibility exactly as ","type":"text"},{"type":"codeVoice","code":"oidcExchange"},{"text":" ","type":"text"},{"text":"does. The safe recovery is a fresh push, which costs one round trip and cannot","type":"text"},{"text":" ","type":"text"},{"text":"double-consume anything (§26.2 rule 4).","type":"text"}],"type":"paragraph"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"text":" client-side, with ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"no wire call"}]},{"text":", when the","type":"text"},{"text":" ","type":"text"},{"text":"discovery document advertises no PAR endpoint — §12.7.2 rule 1’s discipline: never","type":"text"},{"text":" ","type":"text"},{"text":"synthesise the URL from the issuer.","type":"text"}]}],"type":"aside","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcPar(request:redirectURI:scope:dpopJkt:tenantID:configuration:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"codeVoice","code":"POST \/oauth2\/par"},{"type":"text","text":" (CONTRACT.md §26.1) — push the authorization request over the"},{"type":"text","text":" "},{"type":"text","text":"back channel and get an opaque handle to redirect with."}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/oidcBegin(redirectURI:scope:configuration:)":{"role":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\