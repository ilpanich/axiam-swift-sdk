the authorization request over the","type":"text"},{"text":" ","type":"text"},{"text":"back channel and get an opaque handle to redirect with.","type":"text"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcPar(request:redirectURI:scope:dpopJkt:tenantID:configuration:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"oidcPar"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthorizationRequest","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV","text":"AuthorizationRequest"},{"kind":"text","text":", "},{"kind":"externalParam","text":"redirectURI"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" = \"openid profile email\", "},{"kind":"externalParam","text":"dpopJkt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","text":"OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizationRequest","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","text":"PushedAuthorizationRequest"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"request","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"what "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:configuration:)","type":"reference","isActive":true},{"type":"text","text":" returned. Its"},{"type":"text","text":" "},{"code":"state","type":"codeVoice"},{"type":"text","text":", "},{"code":"nonce","type":"codeVoice"},{"type":"text","text":" and PKCE verifier are pushed as-is — §26.2 rule 1 forbids a"},{"type":"text","text":" "},{"type":"text","text":"second generator."}]}]},{"name":"redirectURI","content":[{"inlineContent":[{"text":"the same redirect URI that will be sent at exchange time.","type":"text"}],"type":"paragraph"}]},{"name":"scope","content":[{"inlineContent":[{"type":"text","text":"the requested scope. Must match what was pushed at "},{"type":"codeVoice","code":"oidcBegin"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"dpopJkt","content":[{"inlineContent":[{"text":"RFC 9449 §10.1 — the JWK SHA-256 thumbprint of the key the client will","type":"text"},{"text":" ","type":"text"},{"text":"prove possession of at the token endpoint, binding the authorization code to that","type":"text"},{"text":" ","type":"text"},{"text":"key from the moment it is issued rather than from first use. Sent ","type":"text"},{"type":"strong","inlineContent":[{"text":"only when","type":"text"},{"text":" ","type":"text"},{"text":"given","type":"text"}]},{"text":"; omitting it is the unbound behaviour every release before contract 1.42","type":"text"},{"text":" ","type":"text"},{"text":"had. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Caller-supplied, and it has to be"}]},{"text":": CONTRACT.md §21.9 records this SDK as","type":"text"},{"text":" ","type":"text"},{"text":"verifying DPoP proofs but not generating them, so it holds no client key and has","type":"text"},{"text":" ","type":"text"},{"text":"no thumbprint of its own to offer. An application doing DPoP computes the","type":"text"},{"text":" ","type":"text"},{"text":"thumbprint over its own key (RFC 7638) and passes it here.","type":"text"}],"type":"paragraph"}]},{"name":"tenantID","content":[{"inlineContent":[{"type":"text","text":"a tenant override for the "},{"code":"?tenant_id=","type":"codeVoice"},{"type":"text","text":" query parameter."}],"type":"paragraph"}]},{"name":"configuration","content":[{"inlineContent":[{"text":"the discovery document, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to discover.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"PAR moves the authorization request off the browser. Instead of putting "},{"code":"scope","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"redirect_uri","type":"codeVoice"},{"type":"text","text":", "},{"code":"state","type":"codeVoice"},{"type":"text","text":" and the PKCE challenge into a URL the user agent carries,"},{"type":"text","text":" "},{"type":"text","text":"the client POSTs them straight to AXIAM over an authenticated channel and puts an"},{"type":"text","text":" "},{"type":"text","text":"opaque "},{"code":"request_uri","type":"codeVoice"},{"type":"text","text":" in the redirect. What travels through the browser is then a"},{"type":"text","text":" "},{"type":"text","text":"random string that cannot be edited into meaning something else."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Required for a FAPI 2.0 client","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"code":"profile: \"fapi2\"","type":"codeVoice"},{"type":"text","text":" refuses a registration that"},{"type":"text","text":" "},{"type":"text","text":"does not set "},{"code":"require_par","type":"codeVoice"},{"type":"text","text":", so such a client cannot authorize any other way (§21.1)."}]},{"type":"paragraph","inlineContent":[{"text":"Not retried on a ","type":"text"},{"code":"5xx","type":"codeVoice"},{"text":" or a transport failure — it is a POST that creates server","type":"text"},{"text":" ","type":"text"},{"text":"state, so it falls outside §16.2’s read-only eligibility exactly as ","type":"text"},{"code":"oidcExchange","type":"codeVoice"},{"text":" ","type":"text"},{"text":"does. The safe recovery is a fresh push, which costs one round trip and cannot","type":"text"},{"text":" ","type":"text"},{"text":"double-consume anything (§26.2 rule 4).","type":"text"}]},{"content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"text":" client-side, with ","type":"text"},{"type":"strong","inlineContent":[{"text":"no wire call","type":"text"}]},{"text":", when the","type":"text"},{"text":" ","type":"text"},{"text":"discovery document advertises no PAR endpoint — §12.7.2 rule 1’s discipline: never","type":"text"},{"text":" ","type":"text"},{"text":"synthesise the URL from the issuer.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/oidcpar(request:redirecturi:scope:dpopjkt:tenantid:configuration:)"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Autho