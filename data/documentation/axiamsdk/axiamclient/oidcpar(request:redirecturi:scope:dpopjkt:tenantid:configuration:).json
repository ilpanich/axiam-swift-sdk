text":"PushedAuthorizationRequest","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV"}]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcPar(request:redirectURI:scope:dpopJkt:tenantID:configuration:)"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"abstract":[{"type":"codeVoice","code":"POST \/oauth2\/par"},{"type":"text","text":" (CONTRACT.md §26.1) — push the authorization request over the"},{"type":"text","text":" "},{"type":"text","text":"back channel and get an opaque handle to redirect with."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oidcPar","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AuthorizationRequest","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthorizationRequest","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"redirectURI"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" = \"openid profile email\", "},{"kind":"externalParam","text":"dpopJkt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"configuration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","text":"OidcConfiguration"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK26PushedAuthorizationRequestV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizationRequest","text":"PushedAuthorizationRequest"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"what "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:configuration:)"},{"type":"text","text":" returned. Its"},{"type":"text","text":" "},{"type":"codeVoice","code":"state"},{"type":"text","text":", "},{"type":"codeVoice","code":"nonce"},{"type":"text","text":" and PKCE verifier are pushed as-is — §26.2 rule 1 forbids a"},{"type":"text","text":" "},{"type":"text","text":"second generator."}]}],"name":"request"},{"content":[{"inlineContent":[{"type":"text","text":"the same redirect URI that will be sent at exchange time."}],"type":"paragraph"}],"name":"redirectURI"},{"content":[{"inlineContent":[{"text":"the requested scope. Must match what was pushed at ","type":"text"},{"code":"oidcBegin","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"scope"},{"content":[{"inlineContent":[{"text":"RFC 9449 §10.1 — the JWK SHA-256 thumbprint of the key the client will","type":"text"},{"text":" ","type":"text"},{"text":"prove possession of at the token endpoint, binding the authorization code to that","type":"text"},{"text":" ","type":"text"},{"text":"key from the moment it is issued rather than from first use. Sent ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"only when"},{"type":"text","text":" "},{"type":"text","text":"given"}]},{"text":"; omitting it is the unbound behaviour every release before contract 1.42","type":"text"},{"text":" ","type":"text"},{"text":"had. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Caller-supplied, and it has to be","type":"text"}]},{"text":": CONTRACT.md §21.9 records this SDK as","type":"text"},{"text":" ","type":"text"},{"text":"verifying DPoP proofs but not generating them, so it holds no client key and has","type":"text"},{"text":" ","type":"text"},{"text":"no thumbprint of its own to offer. An application doing DPoP computes the","type":"text"},{"text":" ","type":"text"},{"text":"thumbprint over its own key (RFC 7638) and passes it here.","type":"text"}],"type":"paragraph"}],"name":"dpopJkt"},{"content":[{"type":"paragraph","inlineContent":[{"text":"a tenant override for the ","type":"text"},{"code":"?tenant_id=","type":"codeVoice"},{"text":" query parameter.","type":"text"}]}],"name":"tenantID"},{"content":[{"type":"paragraph","inlineContent":[{"text":"the discovery document, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to discover.","type":"text"}]}],"name":"configuration"}],"kind":"parameters"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"PAR moves the authorization request off the browser. Instead of putting "},{"type":"codeVoice","code":"scope"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"redirect_uri"},{"type":"text","text":", "},{"type":"codeVoice","code":"state"},{"type":"text","text":" and the PKCE challenge into a URL the user agent carries,"},{"type":"text","text":" "},{"type":"text","text":"the client POSTs them straight to AXIAM over an authenticated channel and puts an"},{"type":"text","text":" "},{"type":"text","text":"opaque "},{"type":"codeVoice","code":"request_uri"},{"type":"text","text":" in the redirect. What travels through the browser is then a"},{"type":"text","text":" "},{"type":"text","text":"random string that cannot be edited into meaning something else."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Required for a FAPI 2.0 client","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"profile: \"fapi2\"","type":"codeVoice"},{"text":" refuses a registration that","type":"text"},{"text":" ","type":"text"},{"text":"does not set ","type":"text"},{"code":"require_par","type":"codeVoice"},{"text":", so such a client cannot authorize any other way (§21.1).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Not retried on a ","type":"text"},{"code":"5xx","type":"codeVoice"},{"text":" or a transport failure — it is a POST that creates server","type":"text"},{"text":" ","type":"text"},{"text":"state, so it falls outside §16.2’s read-only eligibility exactly as ","type":"text"},{"code":"oidcExchange","type":"codeVoice"},{"text":" ","type":"text"},{"text":"does. The safe recovery is a fresh push, which costs one round trip and cannot","type":"text"},{"text":" ","type":"text"},{"text":"double-consume anything (§26.2 rule 4).","type":"text"}]},{"style":"note","type":"aside","name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"text":" client-side, with ","type":"text"},{"inlineContent":[{"text":"no wire call","type":"text"}],"type":"strong"},{"text":", when the","type":"text"},{"text":" ","type":"text"},{"text":"discovery document advertises no PAR endpoint — §12.7.2 rule 1’s discipline: never","type":"text"},{"text":" ","type":"text"},{"text":"synthesise the URL from the issuer.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AuthorizationRequest":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AuthorizationRequest","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/authorizationrequest","abstract":[{"type":"text","text":"What "},{"type":"codeVoice","code":"oidcBegin"},{"type":"text","text":" returns (§12.1): everything the caller needs to start the redirect and,"},{"type":"text","text":" "},{"type":"text","text":"later, to finish it."}],"type":"topic","title":"AuthorizationRequest","navigatorTitle":[{"text":"AuthorizationRequest","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthorizationRequest"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","url":"\/documentation\/axiamsdk\/axiamclient","title":"AxiamClient","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/oidcBegin(redirectURI:scope:configuration:)":{"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"oidcBegin","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirectURI","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"configuration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17OidcConfigurationV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AuthorizationRequest","preciseIdentifier":"s:8AxiamSDK20AuthorizationRequestV","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Build the authorization-code + PKCE redirect (§12.1) — "},{"type":"strong","inlineContent":[{"text":"pure local computation, no","type":"text"},{"type":"text","text":" "},{"text":"network I\/O","type":"text"}]},{"type":"text","text":" beyond the discovery fetch this client would cache anyway."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/oidcBegin(redirectURI:scope:configuration:)","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\/oidcbegin(redirecturi:scope:configuration:)","type":"topic","title":"oidcBegin(redirectURI:scope:configuration:)"},"doc://AxiamSDK/documentation/AxiamSDK/OidcConfiguration":{"navigatorTitle":[{"text":"OidcConfiguration","kind":"identifier"}],"type":"topic","title":"OidcConfiguration","abstract":[{"text":"The OIDC discovery document (§12.1), read from ","type":"text"},{"code":"\/.well-known\/openid-configuration","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcConfiguration","url":"\/documentation\/axiamsdk\/oidcconfiguration","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OidcConfiguration","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/PushedAuthorizationRequest":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PushedAuthorizationRequest","abstract":[{"type":"text","text":"The result of "},{"code":"oidcPar","type":"codeVoice"},{"type":"text","text":" (CONTRACT.md §26.1)."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PushedAuthorizationRequest"}],"navigatorTitle":[{"text":"PushedAuthorizationRequest","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/pushedauthorizationrequest","type":"topic","title":"PushedAuthorizationRequest"},"doc://AxiamSDK/documentation/A