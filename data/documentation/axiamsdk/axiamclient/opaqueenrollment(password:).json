{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)","interfaceLanguage":"swift"},"abstract":[{"text":"Builds a registration record for ","type":"text"},{"type":"codeVoice","code":"password"},{"text":", to send with any request that sets one:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"POST \/api\/v1\/users"},{"text":", ","type":"text"},{"type":"codeVoice","code":"\/auth\/password\/change"},{"text":", ","type":"text"},{"type":"codeVoice","code":"\/auth\/reset\/confirm"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\/admin\/bootstrap"},{"text":".","type":"text"}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"opaqueEnrollment"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"OpaqueEnrollment","preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV"}],"role":"symbol","externalID":"s:8AxiamSDK0A6ClientC16opaqueEnrollment8passwordAA06OpaqueE0VSS_tYaKF","title":"opaqueEnrollment(password:)","symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"AxiamSDK"}]},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollment","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment","text":"OpaqueEnrollment","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The server cannot build this — it never sees the plaintext — so it has to arrive with the","type":"text"},{"text":" ","type":"text"},{"text":"request or not at all.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Unlike the ","type":"text"},{"code":"srpEnrollment","type":"codeVoice"},{"text":" it replaces this performs I\/O: one ","type":"text"},{"code":"register\/start","type":"codeVoice"},{"text":" round trip.","type":"text"},{"text":" ","type":"text"},{"text":"OPAQUE’s envelope is sealed under the server’s oblivious PRF, so there is no offline","type":"text"},{"text":" ","type":"text"},{"text":"computation that produces a valid record.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note the parameters that are gone. There is no "},{"type":"codeVoice","code":"identity"},{"type":"text","text":": the SRP version required the"},{"type":"text","text":" "},{"type":"text","text":"account’s "},{"type":"strong","inlineContent":[{"type":"text","text":"username"}]},{"type":"text","text":", and an email there produced a verifier no login could ever satisfy,"},{"type":"text","text":" "},{"type":"text","text":"whereas a record binds to a credential identifier the server chooses. And there is no"},{"type":"text","text":" "},{"type":"codeVoice","code":"group"},{"type":"text","text":" or "},{"type":"codeVoice","code":"params"},{"type":"text","text":", because those come from the "},{"type":"codeVoice","code":"register\/start"},{"type":"text","text":" response — a caller"},{"type":"text","text":" "},{"type":"text","text":"cannot pick a cost the server will not honour."}]},{"type":"aside","style":"note","name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","type":"reference","isActive":true},{"type":"text","text":" when the tenant has OPAQUE disabled, when"},{"type":"text","text":" "},{"type":"codeVoice","code":"libaxiam_opaque_ffi"},{"type":"text","text":" is not installed, or when the server names a key-stretching"},{"type":"text","text":" "},{"type":"text","text":"function this SDK cannot ask for."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/opaqueenrollment(password:)"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OpaqueEnrollment":{"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"opaque"},{"type":"text","text":" object CONTRACT.md §23 defines: a registration record and the server-issued"},{"type":"text","text":" "},{"type":"text","text":"session handle that identifies the exchange it came from."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment","title":"OpaqueEnrollment","type":"topic","url":"\/documentation\/axiamsdk\/opaqueenrollment","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpaqueEnrollment","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"OpaqueEnrollment","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/opaqueEnrollment(password:)":{"abstract":[{"text":"Builds a registration record for ","type":"text"},{"type":"codeVoice","code":"password"},{"text":", to send with any request that sets one:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"POST \/api\/v1\/users"},{"text":", ","t