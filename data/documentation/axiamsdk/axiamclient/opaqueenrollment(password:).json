{"sections":[],"metadata":{"externalID":"s:8AxiamSDK0A6ClientC16opaqueEnrollment8passwordAA06OpaqueE0VSS_tYaKF","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollment","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"OpaqueEnrollment","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV"}],"role":"symbol","symbolKind":"method","modules":[{"name":"AxiamSDK"}],"title":"opaqueEnrollment(password:)"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"opaqueEnrollment"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment","kind":"typeIdentifier","text":"OpaqueEnrollment"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The server cannot build this — it never sees the plaintext — so it has to arrive with the"},{"type":"text","text":" "},{"type":"text","text":"request or not at all."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Unlike the "},{"code":"srpEnrollment","type":"codeVoice"},{"type":"text","text":" it replaces this performs I\/O: one "},{"code":"register\/start","type":"codeVoice"},{"type":"text","text":" round trip."},{"type":"text","text":" "},{"type":"text","text":"OPAQUE’s envelope is sealed under the server’s oblivious PRF, so there is no offline"},{"type":"text","text":" "},{"type":"text","text":"computation that produces a valid record."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note the parameters that are gone. There is no "},{"code":"identity","type":"codeVoice"},{"type":"text","text":": the SRP version required the"},{"type":"text","text":" "},{"type":"text","text":"account’s "},{"type":"strong","inlineContent":[{"type":"text","text":"username"}]},{"type":"text","text":", and an email there produced a verifier no login could ever satisfy,"},{"type":"text","text":" "},{"type":"text","text":"whereas a record binds to a credential identifier the server chooses. And there is no"},{"type":"text","text":" "},{"code":"group","type":"codeVoice"},{"type":"text","text":" or "},{"code":"params","type":"codeVoice"},{"type":"text","text":", because those come from the "},{"code":"register\/start","type":"codeVoice"},{"type":"text","text":" response — a caller"},{"type":"text","text":" "},{"type":"text","text":"cannot pick a cost the server will not honour."}],"type":"paragraph"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},{"type":"text","text":" when the tenant has OPAQUE disabled, when"},{"type":"text","text":" "},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"type":"text","text":" is not installed, or when the server names a key-stretching"},{"type":"text","text":" "},{"type":"text","text":"function this SDK cannot ask for."}]}],"name":"Throws","style":"note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/opaqueenrollment(password:)"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"abstract":[{"text":"Builds a registration record for ","type":"text"},{"code":"password","type":"codeVoice"},{"text":", to send with any request that sets one:","type":"text"},{"text":" ","type":"text"},{"code":"POST \/api\/v1\/users","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\/auth\/password\/change","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\/auth\/reset\/confirm","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"\/admin\/bootstrap","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","url":"\/documentation\/axiamsdk\/axiamclient","title":"AxiamClient","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/opaqueEnrollment(password:)":{"title":"opaqueEnrollment(password:)","url":"\/documentation\/axiamsdk\/axiamclient\/opaqueenrollment(password:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollment","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws