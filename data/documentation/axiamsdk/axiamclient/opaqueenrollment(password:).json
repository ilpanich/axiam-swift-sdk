a verifier no login could ever satisfy,"},{"type":"text","text":" "},{"type":"text","text":"whereas a record binds to a credential identifier the server chooses. And there is no"},{"type":"text","text":" "},{"type":"codeVoice","code":"group"},{"type":"text","text":" or "},{"type":"codeVoice","code":"params"},{"type":"text","text":", because those come from the "},{"type":"codeVoice","code":"register\/start"},{"type":"text","text":" response — a caller"},{"type":"text","text":" "},{"type":"text","text":"cannot pick a cost the server will not honour."}]},{"type":"aside","name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},{"type":"text","text":" when the tenant has OPAQUE disabled, when"},{"type":"text","text":" "},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"type":"text","text":" is not installed, or when the server names a key-stretching"},{"type":"text","text":" "},{"type":"text","text":"function this SDK cannot ask for."}]}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)"},"metadata":{"symbolKind":"method","roleHeading":"Instance Method","externalID":"s:8AxiamSDK0A6ClientC16opaqueEnrollment8passwordAA06OpaqueE0VSS_tYaKF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"opaqueEnrollment"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV","text":"OpaqueEnrollment"}],"title":"opaqueEnrollment(password:)","role