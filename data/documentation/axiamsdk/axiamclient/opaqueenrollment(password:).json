{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)"},"metadata":{"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollment","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV","kind":"typeIdentifier","text":"OpaqueEnrollment"}],"role":"symbol","externalID":"s:8AxiamSDK0A6ClientC16opaqueEnrollment8passwordAA06OpaqueE0VSS_tYaKF","title":"opaqueEnrollment(password:)","modules":[{"name":"AxiamSDK"}]},"abstract":[{"type":"text","text":"Builds a registration record for "},{"type":"codeVoice","code":"password"},{"text":", to send with any request that sets one:","type":"text"},{"text":" ","type":"text"},{"code":"POST \/api\/v1\/users","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\/auth\/password\/change","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\/auth\/reset\/confirm","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"\/admin\/bootstrap","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/opaqueenrollment(password:)"]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollment","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"OpaqueEnrollment","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment"}],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The server cannot build this — it never sees the plaintext — so it has to arrive with the"},{"type":"text","text":" "},{"type":"text","text":"request or not at all."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the "},{"type":"codeVoice","code":"srpEnrollment"},{"type":"text","text":" it replaces this performs I\/O: one "},{"type":"codeVoice","code":"register\/start"},{"type":"text","text":" round trip."},{"type":"text","text":" "},{"type":"text","text":"OPAQUE’s envelope is sealed under the server’s oblivious PRF, so there is no offline"},{"type":"text","text":" "},{"type":"text","text":"computation that produces a valid record."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note the parameters that are gone. There is no "},{"type":"codeVoice","code":"identity"},{"type":"text","text":": the SRP version required the"},{"type":"text","text":" "},{"type":"text","text":"account’s "},{"type":"strong","inlineContent":[{"type":"text","text":"username"}]},{"type":"text","text":", and an email there produced a verifier no login could ever satisfy,"},{"type":"text","text":" "},{"type":"text","text":"whereas a record binds to a credential identifier the server chooses. And there is no"},{"type":"text","text":" "},{"type":"codeVoice","code":"group"},{"type":"text","text":" or "},{"type":"codeVoice","code":"params"},{"type":"text","text":", because those come from the "},{"type":"codeVoice","code":"register\/start"},{"type":"text","text":" response — a caller"},{"type":"text","text":" "},{"type":"text","text":"cannot pick a cost the server will not honour."}]},{"name":"Throws","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},{"type":"text","text":" when the tenant has OPAQUE disabled, when"},{"type":"text","text":" "},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"type":"text","text":" is not installed, or when the server names a key-stretching"},{"type":"text","text":" "},{"type":"text","text":"function this SDK cannot ask for."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/opaqueEnrollment(password:)":{"title":"opaqueEnrollment(password:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)","abstract":[{"text":"Builds a registration record for ","type":"text"},{"code":"password","type":"codeVoice"},{"text":", to send with any request that sets one:","type":"text"},{"text":" ","type":"text"},{"code":"POST \/api\/v1\/users","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\/auth\/password\/change","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\/auth\/reset\/confirm","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"\/admin\/bootstrap","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"opaqueEnrollment"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"te