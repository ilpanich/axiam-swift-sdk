r\/start"},{"type":"text","text":" response — a caller"},{"type":"text","text":" "},{"type":"text","text":"cannot pick a cost the server will not honour."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","isActive":true,"type":"reference"},{"text":" when the tenant has OPAQUE disabled, when","type":"text"},{"text":" ","type":"text"},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"text":" is not installed, or when the server names a key-stretching","type":"text"},{"text":" ","type":"text"},{"text":"function this SDK cannot ask for.","type":"text"}]}]}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/opaqueenrollment(password:)"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/opaqueEnrollment(password:)":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)","title":"opaqueEnrollment(password:)","type":"topic","role":"symbol","abstract":[{"text":"Builds a registration record for ","type":"text"},{"type":"codeVoice","code":"password"},{"text":", to send with any request that sets one:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"POST \/api\/v1\/users"},{"text":", ","type":"text"},{"code":"\/auth\/password\/change","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\/auth\/reset\/confirm","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"\/admin\/bootstrap","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollment","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifi