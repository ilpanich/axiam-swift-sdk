{"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"AxiamSDK"}],"role":"symbol","title":"opaqueEnrollment(password:)","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollment","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV","text":"OpaqueEnrollment","kind":"typeIdentifier"}],"externalID":"s:8AxiamSDK0A6ClientC16opaqueEnrollment8passwordAA06OpaqueE0VSS_tYaKF"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollment","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment","text":"OpaqueEnrollment","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The server cannot build this — it never sees the plaintext — so it has to arrive with the"},{"type":"text","text":" "},{"type":"text","text":"request or not at all."}],"type":"paragraph"},{"inlineContent":[{"text":"Unlike the ","type":"text"},{"type":"codeVoice","code":"srpEnrollment"},{"text":" it replaces this performs I\/O: one ","type":"text"},{"type":"codeVoice","code":"register\/start"},{"text":" round trip.","type":"text"},{"text":" ","type":"text"},{"text":"OPAQUE’s envelope is sealed under the server’s oblivious PRF, so there is no offline","type":"text"},{"text":" ","type":"text"},{"text":"computation that produces a valid record.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note the parameters that are gone. There is no "},{"code":"identity","type":"codeVoice"},{"type":"text","text":": the SRP version required the"},{"type":"text","text":" "},{"type":"text","text":"account’s "},{"type":"strong","inlineContent":[{"type":"text","text":"username"}]},{"type":"text","text":", and an email there produced a verifier no login could ever satisfy,"},{"type":"text","text":" "},{"type":"text","text":"whereas a record binds to a credential identifier the server chooses. And there is no"},{"type":"text","text":" "},{"code":"group","type":"codeVoice"},{"type":"text","text":" or "},{"code":"params","type":"codeVoice"},{"type":"text","text":", because those come from the "},{"code":"register\/start","type":"codeVoice"},{"type":"text","text":" response — a caller"},{"type":"text","text":" "},{"type":"text","text":"cannot pick a cost the server will not honour."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","isActive":true},{"type":"text","text":" when the tenant has OPAQUE disabled, when"},{"type":"text","text":" "},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"type":"text","text":" is not installed, or when the server names a key-stretching"},{"type":"text","text":" "},{"type":"text","text":"function this SDK cannot ask for."}]}],"style":"note","type":"aside","name":"Throws"}],"kind":"content"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamclient\/opaqueenrollment(password:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Builds a registration record for "},{"type":"codeVoice","code":"password"},{"type":"text","text":", to send with any request that sets one:"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/api\/v1\/users"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/auth\/password\/change"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/auth\/reset\/confirm"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/admin\/bootstrap"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/opaqueEnrollment(password:)":{"url":"\/documentation\/axiamsdk\/axiamclient\/opaqueenrollment(password:)","title":"opaqueEnrollment(password:)","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Builds a registration record for "},{"code":"password","type":"codeVoice"},{"type":"text","text":", to send with any request that sets one:"},{"type":"text","text":" "},{"code":"POST \/api\/v1\/users","type":"codeVoice"},{"type":"text","text":", "},{"code":"\/auth\/password\/change","type":"codeVoice"},{"type":"text","text":", "},{"code":"\/auth\/reset\/confirm","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"\/admin\/bootstrap","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollment","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") 