:" response — a caller"},{"type":"text","text":" "},{"type":"text","text":"cannot pick a cost the server will not honour."}]},{"type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","isActive":true,"type":"reference"},{"text":" when the tenant has OPAQUE disabled, when","type":"text"},{"text":" ","type":"text"},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"text":" is not installed, or when the server names a key-stretching","type":"text"},{"text":" ","type":"text"},{"text":"function this SDK cannot ask for.","type":"text"}]}],"style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamclient\/opaqueenrollment(password:)"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"url":"\/documentation\/axiamsdk\/axiamclient","kind":"symbol","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"title":"AxiamClient","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/opaqueEnrollment(password:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\/opaqueenrollm