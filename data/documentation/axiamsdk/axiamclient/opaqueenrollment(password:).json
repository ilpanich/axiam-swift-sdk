{"abstract":[{"type":"text","text":"Builds a registration record for "},{"type":"codeVoice","code":"password"},{"type":"text","text":", to send with any request that sets one:"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/api\/v1\/users"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/auth\/password\/change"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/auth\/reset\/confirm"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/admin\/bootstrap"},{"type":"text","text":"."}],"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"opaqueEnrollment"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK16OpaqueEnrollmentV","kind":"typeIdentifier","text":"OpaqueEnrollment"}],"title":"opaqueEnrollment(password:)","modules":[{"name":"AxiamSDK"}],"symbolKind":"method","roleHeading":"Instance Method","externalID":"s:8AxiamSDK0A6ClientC16opaqueEnrollment8passwordAA06OpaqueE0VSS_tYaKF"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/opaqueEnrollment(password:)"},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"opaqueEnrollment","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":