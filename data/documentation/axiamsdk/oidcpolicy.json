type":"text"},{"inlineContent":[{"type":"text","text":"never sweep"}],"type":"emphasis"},{"text":", which is the longest window of all and","type":"text"},{"text":" ","type":"text"},{"text":"is handled by [","type":"text"},{"code":"dcr_ttl_strictness","type":"codeVoice"},{"text":"]. ","type":"text"},{"inlineContent":[{"text":"Not ordered","type":"text"}],"type":"strong"},{"text":", therefore never validated against the","type":"text"},{"text":" ","type":"text"},{"text":"baseline and never clamped: * [","type":"text"},{"code":"Self::default_locale","type":"codeVoice"},{"text":"]. A language is a presentation","type":"text"},{"text":" ","type":"text"},{"text":"preference; there is no sense in which Italian is stricter than French. *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_allowed_scopes","type":"codeVoice"},{"text":"], [","type":"text"},{"code":"Self::dcr_allowed_redirect_hosts","type":"codeVoice"},{"text":"] and","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::external_client_allowed_resources","type":"codeVoice"},{"text":"]. Each names per-tenant resources — ","type":"text"},{"inlineContent":[{"text":"this","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"tenant’s MCP servers, ","type":"text"},{"inlineContent":[{"text":"this","type":"text"}],"type":"emphasis"},{"text":" tenant’s callback hosts — and there is no sense in which one","type":"text"},{"text":" ","type":"text"},{"text":"such list is stricter than another. A subset rule would force an organization to enumerate","type":"text"},{"text":" ","type":"text"},{"text":"every tenant’s resource servers in its own baseline before any tenant could name one. The","type":"text"},{"text":" ","type":"text"},{"text":"model’s rule is “a tenant may only be more restrictive”, which binds every field that ","type":"text"},{"inlineContent":[{"text":"has","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"a restrictiveness; a field that has none cannot violate it. One cross-field interlock spans","type":"text"},{"text":" ","type":"text"},{"text":"both groups and is checked on the resolved policy rather than on either input: see","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"validate_dcr_policy","type":"codeVoice"},{"text":"].","type":"text"}],"type":"topic","title":"OidcPolicy"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrAllowedScopes":{"abstract":[{"type":"text","text":"T21.4 — the scopes a self-registered client may ask for. A "},{"code":"scope","type":"codeVoice"},{"type":"text","text":" a registration names"},{"type":"text","text":" "},{"type":"text","text":"that is not on this list is "},{"code":"invalid_client_metadata","type":"codeVoice"},{"type":"text","text":"; an empty list means a"},{"type":"text","text":" "},{"type":"text","text":"self-registered client gets no scopes at all, which is the honest default for a tenant"},{"type":"text","text":" "},{"type":"text","text":"that has turned registration on without deciding what it grants. May not contain"},{"type":"text","text":" "},{"code":"address","type":"codeVoice"},{"type":"text","text":" or "},{"code":"phone","type":"codeVoice"},{"type":"text","text":" — see this module’s ["},{"code":"sensitive_scope_in_dcr_list","type":"codeVoice"},{"type":"text","text":"]."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrAllowedScopes","kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrallowedscopes","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dcrAllowedScopes"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]?"}],"title":"dcrAllowedScopes"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/sensitiveScopesEnabled":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveScopesEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"abstract":[{"text":"Whether ","type":"text"},{"code":"address","type":"codeVoice"},{"type":"text","text":" and "},{"code":"phone","type":"codeVoice"},{"type":"text","text":" may be registered on a client, requested at the"},{"text":" ","type":"text"},{"type":"text","text":"authorization endpoint, and released at UserInfo (X7 G8). "},{"inlineContent":[{"text":"Off unless an organization","type":"text"},{"type":"text","text":" "},{"text":"turns it on.","type":"text"}],"type":"strong"},{"text":" The two scopes release a postal address and a telephone number —","type":"text"},{"type":"text","text":" "},{"text":"categories of personal data AXIAM has no other use for — so the deployment that has","type":"text"},{"type":"text","text":" "},{"type":"text","text":"never thought about them releases nothing, and the operator who has thought about them"},{"text":" ","type":"text"},{"type":"text","text":"says so once, at the organization level, where the lawful basis for holding the data was"},{"text":" ","type":"text"},{"text":"decided. The switch is a ","type":"text"},{"inlineContent":[{"text":"capability","type":"text"}],"type":"emphasis"},{"text":", not a grant: with it on, a client still has to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"register the scope, the request still has to ask for it, and the user still has to have"},{"text":" ","type":"text"},{"text":"consented. It is the first of four gates, and it is the only one an operator can close","type":"text"},{"type":"text","text":" "},{"text":"for everybody at once.","type":"text"}],"title":"sensitiveScopesEnabled","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/sensitiveScopesEnabled","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/sensitivescopesenabled"},"doc://AxiamSDK/documen