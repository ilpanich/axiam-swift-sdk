text":" ","type":"text"},{"text":"which Italian is stricter than French. * [","type":"text"},{"code":"Self::dcr_allowed_scopes","type":"codeVoice"},{"text":"],","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_allowed_redirect_hosts","type":"codeVoice"},{"text":"] and [","type":"text"},{"code":"Self::external_client_allowed_resources","type":"codeVoice"},{"text":"]. Each","type":"text"},{"text":" ","type":"text"},{"text":"names per-tenant resources — ","type":"text"},{"inlineContent":[{"type":"text","text":"this"}],"type":"emphasis"},{"text":" tenant’s MCP servers, ","type":"text"},{"inlineContent":[{"type":"text","text":"this"}],"type":"emphasis"},{"text":" tenant’s callback hosts —","type":"text"},{"text":" ","type":"text"},{"text":"and there is no sense in which one such list is stricter than another. A subset rule would","type":"text"},{"text":" ","type":"text"},{"text":"force an organization to enumerate every tenant’s resource servers in its own baseline","type":"text"},{"text":" ","type":"text"},{"text":"before any tenant could name one. The model’s rule is “a tenant may only be more","type":"text"},{"text":" ","type":"text"},{"text":"restrictive”, which binds every field that ","type":"text"},{"inlineContent":[{"type":"text","text":"has"}],"type":"emphasis"},{"text":" a restrictiveness; a field that has none","type":"text"},{"text":" ","type":"text"},{"text":"cannot violate it. One cross-field interlock spans both groups and is checked on the","type":"text"},{"text":" ","type":"text"},{"text":"resolved policy rather than on either input: see [","type":"text"},{"code":"validate_dcr_policy","type":"codeVoice"},{"text":"].","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy"},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text