trong","inlineContent":[{"type":"text","text":"Two sweeps read it, over"},{"type":"text","text":" "},{"type":"text","text":"different clocks"}]},{"text":" (T21.8). A ","type":"text"},{"type":"codeVoice","code":"managed_by: dcr"},{"text":" row is measured from its last","type":"text"},{"text":" ","type":"text"},{"text":"authorization, falling back to when it was registered. A ","type":"text"},{"type":"codeVoice","code":"managed_by: cimd"},{"text":" row is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the last time its document was ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"presented"}]},{"text":", which every authorize, token","type":"text"},{"text":" ","type":"text"},{"text":"and PAR request moves — so a document in daily use is never swept however old its","type":"text"},{"text":" ","type":"text"},{"text":"registration is, and one nobody has presented since the window is, and re-materialises","type":"text"},{"text":" ","type":"text"},{"text":"on the next request if it is still published. Like the ceiling, it keeps its ","type":"text"},{"type":"codeVoice","code":"dcr_"},{"text":" ","type":"text"},{"text":"name.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dcrUnusedClientTTLDays"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dynamicRegistration":{"role":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/dynamicregistration","abstract":[{"text":"T21.4 — whether a client may register itself (RFC 7591), and on what terms. ","type":"text"},{"code":"disabled","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"unless somebody says otherwise (I1)."}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dynamicRegistration","title":"dynamicRegistration","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dynamicRegistration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/encode(to:)":{"title":"encode(to:)","kind":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/encode(to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Encoder","preciseIdentifier":"s:s7EncoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/encode(to:)","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrAllowedRedirectHosts":{"role":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrallowedredirecthosts","abstract":[{"text":"T21.4 — hosts a self-registered client’s ","type":"text"},{"code":"redirect_uris","type":"codeVoice"},{"text":" may point at, as globs","type":"text"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"*.example.com"},{"type":"text","text":", or "},{"type":"codeVoice","code":"*"},{"type":"text","text":" for any). The loopback hosts ("},{"type":"codeVoice","code":"127.0.0.1"},{"type":"text","text":", "},{"type":"codeVoice","code":"[::1]"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":") are always allowed whatever this says, because RFC 8252 §7.3 is how every"},{"type":"text","text":" "},{"type":"text","text":"desktop MCP client receives its callback and a tenant that forbade them would have"},{"type":"text","text":" "},{"type":"text","text":"turned registration on for nobody."}],"type":"topic","identifier