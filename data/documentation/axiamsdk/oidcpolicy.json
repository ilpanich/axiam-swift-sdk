rAllowedRedirectHosts":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"T21.4 — hosts a self-registered client’s "},{"type":"codeVoice","code":"redirect_uris"},{"text":" may point at, as globs","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"*.example.com"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"*"},{"text":" for any). The loopback hosts (","type":"text"},{"type":"codeVoice","code":"127.0.0.1"},{"text":", ","type":"text"},{"type":"codeVoice","code":"[::1]"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"localhost"},{"text":") are always allowed whatever this says, because RFC 8252 §7.3 is how every","type":"text"},{"text":" ","type":"text"},{"text":"desktop MCP client receives its callback and a tenant that forbade them would have","type":"text"},{"text":" ","type":"text"},{"text":"turned registration on for nobody.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrAllowedRedirectHosts","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dcrAllowedRedirectHosts","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]?","kind":"text"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrallowedredirecthosts","title":"dcrAllowedRedirectHosts"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrUnusedClientTTLDays":{"abstract":[{"type":"text","text":"T21.4 — how long an externally registered client survives without being used. See"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"DEFAULT_DCR_UNUSED_CLIENT_TTL_DAYS"},{"type":"text","text":"]. "},{"type":"codeVoice","code":"0"},{"type":"text","text":" disables the sweep for this tenant, which an"},{"type":"text","text":" "},{"type":"text","text":"operator who prunes out of band may legitimately want. "},{"type":"strong","inlineContent":[{"type":"text","text":"Two sweeps read it, over"},{"type":"text","text":" "},{"type":"text","text":"different clocks"}]},{"type":"text","text":" (T21.8). A "},{"type":"codeVoice","code":"managed_by: dcr"},{"type":"text","text":" row is measured from its last"},{"type":"text","text":" "},{"type":"text","text":"authorization, falling back to when it was registered. A "},{"code":"managed_by: cimd","type":"codeVoice"},{"text":" row is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the last time its document was ","type":"text"},{"inlineContent":[{"type":"text","text":"presented"}],"type":"emphasis"},{"text":", which every authorize, token","type":"text"},{"text":" ","type":"text"},{"text":"and PAR request moves — so a document in daily use is never swept however old its","type":"text"},{"text":" ","type":"text"},{"text":"registration is, and one nobody has presented since the window is, and re-materialises","type":"text"},{"text":" ","type":"text"},{"text":"on the next request if it is still published. Like the ceiling, it keeps its ","type":"text"},{"type":"codeVoice","code":"dcr_"},{"text":" ","type":"text"},{"text":"name.","type":"text"}],"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dcrUnusedClientTTLDays","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrunusedclientttldays","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrUnusedClientTTLDays","title":"dcrUnusedClientTTLDays","role":"symbol","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrMaxClients":{"type":"topic","title":"dcrMaxClients","abstract":[{"type":"text","text":"T21.4 — how many externally registered clients this tenant may hold. See"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"DEFAULT_DCR_MAX_CLIENTS"},{"type":"text","text":"]. "},{"type":"strong","inlineContent":[{"type":"text","text":"Counted once per mechanism, against the same number"}]},{"type":"text","text":" "},{"type":"text","text":"(T21.8): "},{"type":"codeVoice","code":"managed_by: dcr"},{"type":"text","text":" rows and "},{"type":"codeVoice","code":"managed_by: cimd"},{"type":"text","text":" rows each have this many. So a"},{"type":"text","text":" "},{"type":"text","text":"tenant running both cannot have shadow rows materialised from documents exhaust the"},{"type":"text","text":" "},{"type":"text","text":"allowance for self-registration, or the reverse. The CIMD count is checked "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"document is fetched, so a tenant at its ceiling is not an outbound amplifier either. It"},{"type":"text","text":" "},{"type":"text","text":"keeps its "},{"type":"codeVoice","code":"dcr_"},{"type":"text","text":" name because dynamic registration defined it, on the same precedent as"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::dcr_allowed_scopes"},{"type":"text","text":"]."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrMaxClients","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrmaxclients","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dcrMaxClients","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/samlIdpEnabled":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"G-2 \/ D-20 — whether this tenant may act as a SAML 2.0 identity provider: publish IdP"},{"text":" ","type":"text"},{"text":"metadata and accept ","type":"text"},{"type":"codeVoice","code":"AuthnRequest"},{"text":"s on ","type":"text"},{"type":"codeVoice","code":"\/saml\/v2\/{tenant}\/{metadata,sso,slo}"},{"text":". ","type":"text"},{"type":"strong","inlineContent":[{"text":"Off","type":"text"},{"text":" ","type":"text"},{"text":"unless an organization turns it on.","type":"text"}]},{"text":" A SAML IdP issues assertions that other systems","type":"text"},{"text":" ","type":"text"},{"text":"accept as proof of identity, so a deployment that has never decided to be one issues","type":"text"},{"text":" ","type":"text"},{"text":"none, and the three endpoints answer ","type":"text"},{"type":"codeVoice","code":"404"},{"text":" as if they did not exist. The switch lives on","type":"text"},{"text":" ","type":"text"},{"text":"this policy, beside the other OpenID Provider surface controls, because the SSO endpoint","type":"text"},{"text":" ","type":"text"},{"text":"is the same browser login hop and OP session with a different wire format.","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Disable-only"}]},{"text":", with the shape of [","type":"text"},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"text":"]: a tenant may","type":"text"},{"text":" ","type":"text"},{"text":"turn its organization’s ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" off but never its ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" on, because the decision to","type":"text"},{"text":" ","type":"text"},{"text":"issue identity assertions on behalf of the organization’s tenants is the organization’s.","type":"text"},{"text":" ","type":"text"},{"text":"A deployment built without the ","type":"text"},{"type":"codeVoice","code":"saml"},{"text":" feature answers ","type":"text"},{"code":"404","type":"codeVoice"},{"type":"text","text":" whatever this says; the"},{"type":"text","text":" "},{"type":"text","text":"setting is a capability, not a grant (each SP must still be registered, and"},{"type":"text","text":" "},{"code":"allow_idp_initiated","type":"codeVoice"},{"type":"text","text":" is its own opt-in)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/samlIdpEnabled","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"samlIdpEnabled"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/samlidpenabled","title":"samlIdpEnabled"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/defaultLocale":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The BCP 47 tag the sign-in page falls back to when the relying party’s "},{"type":"codeVoice","code":"ui_locales"},{"text":" ","type":"text"},{"text":"selects nothing (W5’s chain, plan §4.6). ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" means “no tenant preference”, which","type":"text"},{"text":" ","type":"text"},{"text":"lands on the deployment default (","type":"text"},{"type":"codeVoice","code":"en"},{"text":") — the behaviour every deployment had before this","type":"text"},{"text":" ","type":"text"},{"text":"field existed. A tag this build does not ship also lands there: the parse is exact","type":"text"},{"text":" ","type":"text"},{"text":"rather than a language lookup, so a stored ","type":"text"},{"type":"codeVoice","code":"fr-CA"},{"text":" reads as “somebody wrote something","type":"text"},{"text":" ","type":"text"},{"text":"this binary does not ship” rather than as a guess at French. Stored as a string rather","type":"text"},{"text":" ","type":"text"},{"text":"than as the ","type":"text"},{"type":"codeVoice","code":"Locale"},{"text":" enum because that enum lives in ","type":"text"},{"type":"codeVoice","code":"axiam-oauth2"},{"text":", four layers above","type":"text"},{"text":" ","type":"text"},{"text":"this crate, and the crate layering points inward.","type":"text"}],"kind":"symbol","identifier"