s own baseline","type":"text"},{"text":" ","type":"text"},{"text":"before any tenant could name one. The model’s rule is “a tenant may only be more","type":"text"},{"text":" ","type":"text"},{"text":"restrictive”, which binds every field that ","type":"text"},{"inlineContent":[{"type":"text","text":"has"}],"type":"emphasis"},{"text":" a restrictiveness; a field that has none","type":"text"},{"text":" ","type":"text"},{"text":"cannot violate it. One cross-field interlock spans both groups and is checked on the","type":"text"},{"text":" ","type":"text"},{"text":"resolved policy rather than on either input: see [","type":"text"},{"code":"validate_dcr_policy","type":"codeVoice"},{"text":"].","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrAllowedRedirectHosts":{"title":"dcrAllowedRedirectHosts","type":"topic","kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrallowedredirecthosts","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dcrAllowedRedirectHosts","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]?","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrAllowedRedirectHosts","abstract":[{"text":"T21.4 — hosts a self-registered client’s ","type":"text"},{"type":"codeVoice","code":"redirect_uris"},{"text":" may point at, as globs","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"*.example.com"},{"type":"text","text":", or "},{"type":"codeVoice","code":"*"},{"type":"text","text":" for any). The loopback hosts ("},{"type":"codeVoice","code":"127.0.0.1"},{"type":"text","text":", "},{"type":"codeVoice","code":"[::1]"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":") are always allowed whatever this says, because RFC 8252 §7.3 is how every"},{"type":"text","text":" "},{"type":"text","text":"desktop MCP client receives its callback and a tenant that forbade them would have"},{"type":"text","text":" "},{"type":"text","text":"turned registration on for nobody."}]},"doc://AxiamSDK/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://AxiamSDK/s8SendableP":{"identifier":"doc:\/\/AxiamSDK\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/samlIdpEnabled":{"url":"\/documentation\/axiamsdk\/oidcpolicy\/samlidpenabled","title":"samlIdpEnabled","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samlIdpEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"G-2 \/ D-20 — whether this tenant may act as a SAML 2.0 identity provider: publish IdP"},{"type":"text","text":" "},{"type":"text","text":"metadata and accept "},{"code":"AuthnRequest","type":"codeVoice"},{"type":"text","text":"s on "},{"code":"\/saml\/v2\/{tenant}\/{metadata,sso,slo}","type":"codeVoice"},{"type":"text","text":". "},{"type":"strong","inlineContent":[{"type":"text","text":"Off"},{"type":"text","text":" "},{"type":"text","text":"unless an organization turns it on."}]},{"type":"text","text":" A SAML IdP issues assertions that other systems"},{"type":"text","text":" "},{"text":"accept as proof of identity, so a deployment that has never decided to be one issues","type":"text"},{"text":" ","type":"text"},{"text":"none, and the three endpoints answer ","type":"text"},{"type":"codeVoice","code":"404"},{"text":" as if they did not exist. The switch lives on","type":"text"},{"text":" ","type":"text"},{"text":"this policy, beside the other OpenID Provider surface controls, because the SSO endpoint","type":"text"},{"text":" ","type":"text"},{"text":"is the same browser login hop and OP session with a different wire format.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Disable-only"}],"type":"strong"},{"text":", with the shape of [","type":"text"},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"text":"]: a tenant may","type":"text"},{"text":" ","type":"text"},{"text":"turn its organization’s ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" off but never its ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" on, because the decision to","type":"text"},{"text":" ","type":"text"},{"text":"issue identity assertions on behalf of the organization’s tenants is the organization’s.","type":"text"},{"text":" ","type":"text"},{"text":"A deployment built without the ","type":"text"},{"type":"codeVoice","code":"saml"},{"text":" feature answers ","type":"text"},{"type":"codeVoice","code":"404"},{"text":" whatever this says; the","type":"text"},{"text":" ","type":"text"},{"text":"setting is a capability, not a grant (each SP must still be registered, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"allow_idp_initiated"},{"text":" is its own opt-in).","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/samlIdpEnabled"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrAllowedScopes":{"url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrallowedscopes","title":"dcrAllowedScopes","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dcrAllowedScopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrAllowedScopes","type":"topic","abstract":[{"text":"T21.4 — the scopes a self-registered client may ask for. A ","type":"text"},{"code":"scope","type":"codeVoice"},{"text":" a registration names","type":"text"},{"text":" ","type":"text"},{"text":"that is not on this list is ","type":"text"},{"code":"invalid_client_metadata","type":"codeVoice"},{"text":"; an empty list means a","type":"text"},{"text":" ","type":"text"},{"text":"self-registered client gets no scopes at all, which is the honest default for a tenant","type":"text"},{"text":" ","type":"text"},{"text":"that has turned registration on without deciding what it grants. May not contain","type":"text"},{"text":" ","type":"text"},{"code":"address","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"phone","type":"codeVoice"},{"text":" — see this module’s [","type":"text"},{"code":"sensitive_scope_in_dcr_list","type":"codeVoice"},{"text":"].","type":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/cimd":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/cimd","abstract":[{"type":"text","text":"T21.5 — whether a URL-shaped "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" is resolved by fetching the document it names,"},{"type":"text","text":" "},{"type":"text","text":"and on what terms. See ["},{"type":"codeVoice","code":"CimdPolicy"},{"type":"text","text":"]; off unless somebody turns it on (I1). Nested, and"},{"type":"text","text":" "},{"type":"text","text":"therefore inherited or overridden "},{"type":"strong","inlineContent":[{"text":"whole","type":"text"}]},{"type":"text","text":": the fields are terms of one decision, and a"},{"type":"text","text":" "},{"type":"text","text":"half-merged posture is one neither the organization nor the tenant wrote."}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/cimd","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cimd","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CimdPolicy","preciseIdentifier":"s:8AxiamSDK10CimdPolicyV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","role":"symbol","type":"topic","title":"cimd"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/externalClientAllowedResources":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/externalClientAllowedResources","abstract":[{"type":"strong","inlineContent":[{"type":"text","text":"D3"}]},{"type":"text","text":" — the audiences an externally registered client may address. The single most"},{"type":"text","text":" "},{"type":"text","text":"important field on this policy, and the reason the settings handler refuses"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration: anonymous"},{"type":"text","text":" while it is empty. A client an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"registered cannot declare its own "},{"type":"codeVoice","code":"allowed_resources"},{"type":"text","text":"; it inherits this list verbatim,"},{"type":"text","text":" "},{"type":"text","text":"so what a stranger can mint a token "},{"inlineContent":[{"text":"for","type":"text"}],"type":"emphasis"},{"type":"text","text":" is a decision the tenant took in advance"},{"type":"text","text":" "},{"type":"text","text":"rather than one the registration request makes. Empty means an externally registered"},{"type":"text","text":" "},{"type":"text","text":"client can obtain only today’s "},{"type":"codeVoice","code":"axiam:user"},{"type":"text","text":" tokens — which AXIAM’s own APIs accept. That"},{"type":"text","text":" "},{"type":"text","text":"is why the interlock exists: the empty list is not a safe default for an "},{"type":"emphasis","inlineContent":[{"text":"open","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"registration endpoint, it is the most dangerous one. Shared with T5 (CIMD), which"},{"type":"text","text":" "},{"type":"text","text":"inherits the same list for the same reason."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"externalClientAllowedResources"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]?"}],"title":"externalClientAllowedResources","url":"\/documentation\/axiamsdk\/oidcpolicy\/externalclientallowedresources","kind":"symbol","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/init(cimd:dcrAllowedRedirectHosts:dcrAllowedScopes:dcrMaxClients:dcrUnusedClientTTLDays:defaultLocale:dynamicRegistration:externalClientAllowedResources:samlIdpEnabled:sensitiveScopesEnabled:ssfEnabled:ssfInactiveReason:)":{"type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"cimd"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK10CimdPolicyV","text":"CimdPolicy"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dcrAllowedRedirectHosts"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"dcrAllowedScopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"dcrMaxClients"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dcrUnusedClientTTLDays"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"defaultLocale"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dynamicRegistration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"externalClientAllowedResources"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"samlIdpEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"sensitiveScopesEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ssfEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"ssfInactiveReason"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?)"}],"role":"symbol","abstract":[],"url":"\/documentation\/axiamsdk\/oidcpolicy\/init(cimd:dcrallowedredirecthosts:dcrallowedscopes:dcrmaxclients:dcrunusedclientttldays:defaultlocale:dynamicregistration:externalclientallowedresources:samlidpenabled:sensitivescopesenabled:ssfenabled:ssfinactivereason:)","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/init(cimd:dcrAllowedRedirectHosts:dcrAllowedScopes:dcrMaxClients:dcrUnusedClientTTLDays:defaultLocale:dynamicRegistration:externalClientAllowedResources:samlIdpEnabled:sensitiveScopesEnabled:ssfEnabled:ssfInactiveReason:)","title":"init(cimd:dcrAllowedRedirectHosts:dcrAllowedScopes:dcrMaxClients:dcrUnusedClientTTLDays:defaultLocale:dynamicRegistration:externalClientAllowedResources:samlIdpEnabled:sensitiveScopesEnabled:ssfEnabled:ssfInactiveReason:)"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/sensitiveScopesEnabled":{"title":"sensitiveScopesEnabled","url":"\/documentation\/axiamsdk\/oidcpolicy\/sensitivescopesenabled","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/sensitiveScopesEnabled","abstract":[{"text":"Whether ","type":"text"},{"code":"address","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"phone","type":"codeVoice"},{"text":" may be registered on a client, requested at the","type":"text"},{"text":" ","type":"text"},{"text":"authorization endpoint, and released at UserInfo (X7 G8). ","type":"text"},{"inlineContent":[{"type":"text","text":"Off unless an organization"},{"type":"text","text":" "},{"type":"text","text":"turns it on."}],"type":"strong"},{"text":" The two scopes release a postal address and a telephone number —","type":"text"},{"text":" ","type":"text"},{"text":"categories of personal data AXIAM has no other use for — so the deployment that has","type":"text"},{"text":" ","type":"text"},{"text":"never thought about them releases nothing, and the operator who has thought about them","type":"text"},{"text":" ","type":"text"},{"text":"says so once, at the organization level, where the lawful basis for holding the data was","type":"text"},{"text":" ","type":"text"},{"text":"decided. The switch is a ","type":"text"},{"inlineContent":[{"text":"capability","type":"text"}],"type":"emphasis"},{"text":", not a grant: with it on, a client still has to","type":"text"},{"text":" ","type":"text"},{"text":"register the scope, the request still has to ask for it, and the user still has to have","type":"text"},{"text":" ","type":"text"},{"text":"consented. It is the first of four gates, and it is the only one an operator can close","type":"text"},{"text":" ","type":"text"},{"text":"for everybody at once.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"sensitiveScopesEnabled"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://AxiamSDK/Se":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/Se","title":"Swift.Decodable"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dynamicRegistration":{"url":"\/documentation\/axiamsdk\/oidcpolicy\/dynamicregistration","title":"dynamicRegistration","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dynamicRegistration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"abstract":[{"text":"T21.4 — whether a client may register itself (RFC 7591), and on what terms. ","type":"text"},{"type":"codeVoice","code":"disabled"},{"text":" ","type":"text"},{"text":"unless somebody says otherwise (I1).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dynamicRegistration"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/ssfInactiveReason":{"title":"ssfInactiveReason","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ssfInactiveReason","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/ssfinactivereason","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/ssfInactiveReason","abstract":[{"type":"strong","inlineContent":[{"text":"Read-only","type":"text"}]},{"type":"text","text":", D-55: set on a settings response when "},{"type":"codeVoice","code":"ssf_enabled"},{"type":"text","text":" is on but the"},{"type":"text","text":" "},{"type":"text","text":"transmitter is inactive anyway, saying why — the deployment holds more than one tenant"},{"type":"text","text":" "},{"type":"text","text":"and serves no per-tenant issuers. Never stored."}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/encode(to:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"encode"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Encoder","preciseIdentifier":"s:s7EncoderP"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/encode(to:)","title":"encode(to:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/encode(to:)","abstract":[],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrUnusedClientTTLDays":{"title":"dcrUnusedClientTTLDays","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrUnusedClientTTLDays","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrunusedclientttldays","kind":"symbol","abstract":[{"type":"text","text":"T21.4 — how long an externally registered client survives without being used. See"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"DEFAULT_DCR_UNUSED_CLIENT_TTL_DAYS","type":"codeVoice"},{"type":"text","text":"]. "},{"code":"0","type":"codeVoice"},{"type":"text","text":" disables the sweep for this tenant, which an"},{"type":"text","text":" "},{"type":"text","text":"operator who prunes out of band may legitimately want. "},{"type":"strong","inlineContent":[{"type":"text","text":"Two sweeps read it, over"},{"type":"text","text":" "},{"type":"text","text":"different clocks"}]},{"type":"text","text":" (T21.8). A "},{"code":"managed_by: dcr","type":"codeVoice"},{"type":"text","text":" row is measured from its last"},{"type":"text","text":" "},{"type":"text","text":"authorization, falling back to when it was registered. A "},{"code":"managed_by: cimd","type":"codeVoice"},{"type":"text","text":" row is"},{"type":"text","text":" "},{"type":"text","text":"measured from the last time its document was "},{"type":"emphasis","inlineContent":[{"type":"text","text":"presented"}]},{"type":"text","text":", which every authorize, token"},{"type":"text","text":" "},{"type":"text","text":"and PAR request moves — so a document in daily use is never swept however old its"},{"type":"text","text":" "},{"type":"text","text":"registration is, and one nobody has presented since the window is, and re-materialises"},{"type":"text","text":" "},{"type":"text","text":"on the next request if it is still published. Like the ceiling, it keeps its "},{"code":"dcr_","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"name."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dcrUnusedClientTTLDays"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrMaxClients":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dcrMaxClients","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","title":"dcrMaxClients","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrMaxClients","kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrmaxclients","abstract":[{"text":"T21.4 — how many externally registered clients this tenant may hold. See","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"DEFAULT_DCR_MAX_CLIENTS","type":"codeVoice"},{"text":"]. ","type":"text"},{"inlineContent":[{"text":"Counted once per mechanism, against the same number","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"(T21.8): ","type":"text"},{"code":"managed_by: dcr","type":"codeVoice"},{"text":" rows and ","type":"text"},{"code":"managed_by: cimd","type":"codeVoice"},{"text":" rows each have this many. So a","type":"text"},{"text":" ","type":"text"},{"text":"tenant running both cannot have shadow rows materialised from documents exhaust the","type":"text"},{"text":" ","type":"text"},{"text":"allowance for self-registration, or the reverse. The CIMD count is checked ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"document is fetched, so a tenant at its ceiling is not an outbound amplifier either. It","type":"text"},{"text":" ","type":"text"},{"text":"keeps its ","type":"text"},{"code":"dcr_","type":"codeVoice"},{"text":" name because dynamic registration defined it, on the same precedent as","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_allowed_scopes","type":"codeVoice"},{"text":"].","type":"text"}]}}}