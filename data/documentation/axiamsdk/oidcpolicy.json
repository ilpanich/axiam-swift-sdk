 "},{"kind":"externalParam","text":"dcrAllowedScopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"dcrMaxClients"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dcrUnusedClientTTLDays"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"defaultLocale"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"text":"dynamicRegistration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"externalClientAllowedResources","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]?, ","kind":"text"},{"text":"sensitiveScopesEnabled","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrMaxClients":{"role":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrmaxclients","abstract":[{"text":"T21.4 — how many externally registered clients this tenant may hold. See","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"DEFAULT_DCR_MAX_CLIENTS","type":"codeVoice"},{"type":"text","text":"]. "},{"type":"strong","inlineContent":[{"type":"text","text":"Counted once per mechanism, against the same number"}]},{"type":"text","text":" "},{"type":"text","text":"(T21.8): "},{"type":"codeVoice","code":"managed_by: dcr"},{"type":"text","text":" rows and "},{"type":"codeVoice","code":"managed_by: cimd"},{"type":"text","text":" rows each have this many. So a"},{"type":"text","text":" "},{"type":"text","text":"tenant running both cannot have shadow rows materialised from documents exhaust the"},{"type":"text","text":" "},{"type":"text","text":"allowance for self-registration, or the reverse. The CIMD count is checked "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"document is fetched, so a tenant at its ceiling is not an outbound amplifier either. It"},{"type":"text","text":" "},{"type":"text","text":"keeps its "},{"type":"codeVoice","code":"dcr_"},{"type":"text","text":" name because dynamic registration defined it, on the same precedent as"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::dcr_allowed_scopes"},{"type":"text","text":"]."}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrMaxClients","title":"dcrMaxClients","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dcrMaxClients","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://AxiamSDK/SE":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/SE","title":"Swift.Encodable"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/defaultLocale":{"role":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/defaultlocale","abstract":[{"text":"The BCP 47 tag the sign-in page falls back to when the relying party’s ","type":"text"},{"code":"ui_locales","type":"codeVoice"},{"text":" ","type":"text"},{"text":"selects nothing (W5’s chain, plan §4.6). ","type":"text"},{"code":"None","type":"codeVoice"},{"text":" means “no tenant preference”, which","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"lands on the deployment default ("},{"type":"codeVoice","code":"en"},{"type":"text","text":") — the behaviour every deployment had before this"},{"type":"text","text":" "},{"type":"text","text":"field existed. A tag this build does not ship also lands there: the parse is exact"},{"type":"text","text":" "},{"type":"text","text":"rather than a language lookup, so a stored "},{"type":"codeVoice","code":"fr-CA"},{"type":"text","text":" reads as “somebody wrote something"},{"type":"text","text":" "},{"type":"text","text":"this binary does not ship” rather than as a guess at French. Stored as a string rather"},{"type":"text","text":" "},{"type":"text","text":"than as the "},{"type":"codeVoice","code":"Locale"},{"type":"text","text":" enum because that enum lives in "},{"type":"codeVoice","code":"axiam-oauth2"},{"type":"text","text":", four layers above"},{"type":"text","text":" "},{"type":"text","text":"this crate, and the crate layering points inward."}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/defaultLocale","title":"defaultLocale","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLocale"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/externalClientAllowedResources":{"type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/externalClientAllowedResources","kind":"symbol","title":"externalClientAllowedResources","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"externalClientAllowedResources","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]?","kind":"text"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/externalclientallowedresources","abstract":[{"type":"strong","inlineContent":[{"text":"D3","type":"text"}]},{"text":" — the audiences an externally registered client may address. The single most","type":"text"},{"text":" ","type":"text"},{"text":"important field on this policy, and the reason the settings handler refuses","type":"text"},{"text":" ","type":"text"},{"code":"dynamic_registration: anonymous","type":"codeVoice"},{"text":" while it is empty. A client an unrelated party","type":"text"},{"text":" ","type":"text"},{"text":"registered cannot declare its own ","type":"text"},{"code":"allowed_resources","type":"codeVoice"},{"text":"; it inherits this list verbatim,","type":"text"},{"text":" ","type":"text"},{"text":"so what a stranger can mint a token ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"for","type":"text"}]},{"text":" is a decision the tenant took in advance","type":"text"},{"text":" ","type":"text"},{"text":"rather than one the registration request makes. Empty means an externally registered","type":"text"},{"text":" ","type":"text"},{"text":"client can obtain only today’s ","type":"text"},{"code":"axiam:user","type":"codeVoice"},{"text":" tokens — which AXIAM’s own APIs accept. That","type":"text"},{"text":" ","type":"text"},{"text":"is why the interlock exists: the empty list is not a safe default for an ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"open"}]},{"text":" ","type":"text"},{"text":"registration endpoint, it is the most dangerous one. Shared with T5 (CIMD), which","type":"text"},{"text":" ","type":"text"},{"text":"inherits the same list for the same reason.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/init(from:)":{"title":"init(from:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/init(from:)","kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/init(from:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"type":"topic","role":"symbol","abstract":[]},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}