d ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"document is fetched, so a tenant at its ceiling is not an outbound amplifier either. It","type":"text"},{"text":" ","type":"text"},{"text":"keeps its ","type":"text"},{"code":"dcr_","type":"codeVoice"},{"text":" name because dynamic registration defined it, on the same precedent as","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_allowed_scopes","type":"codeVoice"},{"text":"].","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dcrMaxClients","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/ssfEnabled":{"kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/ssfenabled","role":"symbol","abstract":[{"text":"G-5 \/ D-45 — whether the tenant is a Shared Signals Framework transmitter: its","type":"text"},{"text":" ","type":"text"},{"code":"\/.well-known\/ssf-configuration","type":"codeVoice"},{"text":" is served, its receivers can use the stream management","type":"text"},{"text":" ","type":"text"},{"text":"API, and events are signed and transmitted on its streams. Default ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"false"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Disable-only"}]},{"text":", with the shape of [","type":"text"},{"type":"codeVoice","code":"Self::saml_idp_enabled"},{"text":"]: sending security events","type":"text"},{"text":" ","type":"text"},{"text":"about the organization’s users to third parties is the organization’s decision. Streams","type":"text"},{"text":" ","type":"text"},{"text":"can be registered while it is off; they carry nothing until it is on.","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/ssfEnabled","title":"ssfEnabled","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ssfEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dynamicRegistration":{"kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/dynamicregistration","title":"dynamicRegistration","abstract":[{"text":"T21.4 — whether a client may register itself (RFC 7591), and on what terms. ","type":"text"},{"code":"disabled","type":"codeVoice"},{"text":" ","type":"text"},{"text":"unless somebody says otherwise (I1).","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dynamicRegistration","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dynamicRegistration","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/samlIdpEnabled":{"type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy\/samlidpenabled","title":"samlIdpEnabled","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samlIdpEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","abstract":[{"text":"G-2 \/ D-20 — whether this tenant may act as a SAML 2.0 identity provider: publish IdP","type":"text"},{"text":" ","type":"text"},{"text":"metadata and accept ","type":"text"},{"type":"codeVoice","code":"AuthnRequest"},{"text":"s on ","type":"text"},{"type":"codeVoice","code":"\/saml\/v2\/{tenant}\/{metadata,sso,slo}"},{"text":". ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Off"},{"type":"text","text":" "},{"type":"text","text":"unless an organization turns it on."}]},{"text":" A SAML IdP issues assertions that other systems","type":"text"},{"text":" ","type":"text"},{"text":"accept as proof of identity, so a deployment that has never decided to be one issues","type":"text"},{"text":" ","type":"text"},{"text":"none, and the three endpoints answer ","type":"text"},{"type":"codeVoice","code":"404"},{"text":" as if they did not exist. The switch lives on","type":"text"},{"text":" ","type":"text"},{"text":"this policy, beside the other OpenID Provider surface controls, because the SSO endpoint","type":"text"},{"text":" ","type":"text"},{"text":"is the same browser login hop and OP session with a different wire format.","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Disable-only"}]},{"text":", with the shape of [","type":"text"},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"text":"]: a tenant may","type":"text"},{"text":" ","type":"text"},{"text":"turn its organization’s ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" off but never its ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" on, because the decision to","type":"text"},{"text":" ","type":"text"},{"text":"issue identity assertions on behalf of the organization’s tenants is the organization’s.","type":"text"},{"text":" ","type":"text"},{"text":"A deployment built without the ","type":"text"},{"type":"codeVoice","code":"saml"},{"text":" feature answers ","type":"text"},{"type":"codeVoice","code":"404"},{"text":" whatever this says; the","type":"text"},{"text":" ","type":"text"},{"text":"setting is a capability, not a grant (each SP must still be registered, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"allow_idp_initiated"},{"text":" is its own opt-in).","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPo