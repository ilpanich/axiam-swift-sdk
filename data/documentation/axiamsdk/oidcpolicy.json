{"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OidcPolicy","kind":"identifier"}]}],"kind":"declarations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"abstract":[{"type":"text","text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8). Two settings that are not password"},{"type":"text","text":" "},{"type":"text","text":"rules, and are here because this is the org-baseline-plus-tenant-override surface every"},{"type":"text","text":" "},{"type":"text","text":"other per-tenant control lives on. They are also the two settings in this model that are"},{"type":"text","text":" "},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"type":"text","text":" of the same kind as each other, so it is worth saying which is which: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"Self::sensitive_scopes_enabled","type":"codeVoice"},{"type":"text","text":"] "},{"inlineContent":[{"text":"is","type":"text"}],"type":"strong"},{"type":"text","text":" ordered. Releasing personal data is the"},{"type":"text","text":" "},{"type":"text","text":"less-restrictive direction, so it is validated disable-only — the mirror image of"},{"type":"text","text":" "},{"code":"mfa_enforced","type":"codeVoice"},{"type":"text","text":" — and a tenant can turn its organization’s decision off but never on. *"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"Self::default_locale","type":"codeVoice"},{"type":"text","text":"] is "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" ordered, and no ordering is invented for it. A language"},{"type":"text","text":" "},{"type":"text","text":"is a presentation preference; there is no sense in which Italian is stricter than French."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"validate_tenant_override","type":"codeVoice"},{"type":"text","text":"] therefore does not check it and ["},{"code":"clamp_overrides_to_org","type":"codeVoice"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"never clears it. The model’s rule is “a tenant may only be more restrictive”, which binds"},{"type":"text","text":" "},{"type":"text","text":"every field that "},{"inlineContent":[{"type":"text","text":"has"}],"type":"emphasis"},{"type":"text","text":" a restrictiveness; a field that has none cannot violate it."}],"kind":"symbol","topicSections":[{"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/init(defaultLocale:sensitiveScopesEnabled:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/init(from:)"]},{"title":"Instance Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/defaultLocale","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/sensitiveScopesEnabled"]},{"title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/encode(to:)"]}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/s8SendableP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/oidcpolicy"]}],"metadata":{"modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"kind":"identifier","text":"OidcPolicy"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OidcPolicy"}],"symbolKind":"struct","role":"symbol","title":"OidcPolicy","roleHeading":"Structure","externalID":"s:8AxiamSDK10OidcPolicyV"},"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/init(from:)":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/init(from:)","title":"init(from:)","abstract":[],"kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/init(from:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/encode(to:)":{"title":"encode(to:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7EncoderP","text":"Encoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/encode(to:)","url":"\/documentation\/axiamsdk\/oidcpolicy\/encode(to:)","type":"topic","kind":"symbol","abstract":[]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/defaultLocale":{"title":"defaultLocale","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLocale"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/defaultLocale","kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/defaultlocale","abstract":[{"type":"text","text":"The BCP 47 tag the sign-in page falls back to when the relying party’s "},{"code":"ui_locales","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"selects nothing (W5’s chain, plan §4.6). "},{"code":"None","type":"codeVoice"},{"type":"text","text":" means “no tenant preference”, which"},{"type":"text","text":" "},{"type":"text","text":"lands on the deployment default ("},{"code":"en","type":"codeVoice"},{"type":"text","text":") — the behaviour every deployment had before this"},{"type":"text","text":" "},{"type":"text","text":"field existed. A tag this build does not ship also lands there: the parse is exact"},{"type":"text","text":" "},{"type":"text","text":"rather than a language lookup, so a stored "},{"code":"fr-CA","type":"codeVoice"},{"type":"text","text":" reads as “somebody wrote something"},{"type":"text","text":" "},{"type":"text","text":"this binary does not ship” rather than as a guess at French. Stored as a string rather"},{"type":"text","text":" "},{"type":"text","text":"than as the "},{"code":"Locale","type":"codeVoice"},{"type":"text","text":" enum because that enum lives in "},{"code":"axiam-oauth2","type":"codeVoice"},{"type":"text","text":", four layers above"},{"type":"text","text":" "},{"type":"text","text":"this crate, and the crate layering points inward."}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OidcPolicy"}],"type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","url":"\/documentation\/axiamsdk\/oidcpolicy","title":"OidcPolicy","abstract":[{"type":"text","text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8). Two settings that are not password"},{"type":"text","text":" "},{"type":"text","text":"rules, and are here because this is the org-baseline-plus-tenant-override surface every"},{"type":"text","text":" "},{"type":"text","text":"other per-tenant control lives on. They are also the two settings in this model that are"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" of the same kind as each other, so it is worth saying which is which: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"Self::sensitive_scopes_enabled","type":"codeVoice"},{"type":"text","text":"] "},{"type":"strong","inlineContent":[{"text":"is","type":"text"}]},{"type":"text","text":" ordered. Releasing personal data is the"},{"type":"text","text":" "},{"type":"text","text":"less-restrictive direction, so it is validated disable-only — the mirror image of"},{"text":" ","type":"text"},{"code":"mfa_enforced","type":"codeVoice"},{"text":" — and a tenant can turn its organization’s decision off but never on. *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::default_locale","type":"codeVoice"},{"text":"] is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" ordered, and no ordering is invented for it. A language","type":"text"},{"text":" ","type":"text"},{"text":"is a presentation preference; there is no sense in which Italian is stricter than French.","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"validate_tenant_override","type":"codeVoice"},{"text":"] therefore does not check it and [","type":"text"},{"code":"clamp_overrides_to_org","type":"codeVoice"},{"text":"]","type":"text"},{"text":" ","type":"text"},{"text":"never clears it. The model’s rule is “a tenant may only be more restrictive”, which binds","type":"text"},{"text":" ","type":"text"},{"text":"every field that ","type":"text"},{"inlineContent":[{"type":"text","text":"has"}],"type":"emphasis"},{"text":" a restrictiveness; a field that has none cannot violate it.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OidcPolicy"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/sensitiveScopesEnabled":{"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveScopesEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/sensitiveScopesEnabled","url":"\/documentation\/axiamsdk\/oidcpolicy\/sensitivescopesenabled","title":"sensitiveScopesEnabled","abstract":[{"type":"text","text":"Whether "},{"code":"address","type":"codeVoice"},{"type":"text","text":" and "},{"code":"phone","type":"codeVoice"},{"type":"text","text":" may be registered on a client, requested at the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint, and released at UserInfo (X7 G8). "},{"type":"strong","inlineContent":[{"type":"text","text":"Off unless an organization"},{"type":"text","text":" "},{"type":"text","text":"turns it on."}]},{"type":"text","text":" The two scopes release a postal address and a telephone number —"},{"type":"text","text":" "},{"type":"text","text":"categories of personal data AXIAM has no other use for — so the deployment that has"},{"type":"text","text":" "},{"type":"text","text":"never thought about them releases nothing, and the operator who has thought about them"},{"type":"text","text":" "},{"type":"text","text":"says so once, at the organization level, where the lawful basis for holding the data was"},{"type":"text","text":" "},{"type":"text","text":"decided. The switch is a "},{"type":"emphasis","inlineContent":[{"text":"capability","type":"text"}]},{"type":"text","text":", not a grant: with it on, a client still has to"},{"type":"text","text":" "},{"type":"text","text":"register the scope, the request still has to ask for it, and the user still has to have"},{"type":"text","text":" "},{"type":"text","text":"consented. It is the first of four gates, and it is the only one an operator can close"},{"type":"text","text":" "},{"type":"text","text":"for everybody at once."}]},"doc://AxiamSDK/Se":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/Se","title":"Swift.Decodable"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/init(defaultLocale:sensitiveScopesEnabled:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/init(defaultLocale:sensitiveScopesEnabled:)","url":"\/documentation\/axiamsdk\/oidcpolicy\/init(defaultlocale:sensitivescopesenabled:)","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"defaultLocale","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"sensitiveScopesEnabled","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"role":"symbol","abstract":[],"title":"init(defaultLocale:sensitiveScopesEnabled:)","type":"topic"},"doc://AxiamSDK/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/s8SendableP","title":"Swift.Sendable"},"doc://AxiamSDK/SE":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/SE","title":"Swift.Encodable"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"}}}