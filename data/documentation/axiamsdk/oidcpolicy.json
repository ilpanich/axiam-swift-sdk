ctivereason:)","abstract":[],"role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/init(cimd:dcrAllowedRedirectHosts:dcrAllowedScopes:dcrMaxClients:dcrUnusedClientTTLDays:defaultLocale:dynamicRegistration:externalClientAllowedResources:samlIdpEnabled:sensitiveScopesEnabled:ssfEnabled:ssfInactiveReason:)","title":"init(cimd:dcrAllowedRedirectHosts:dcrAllowedScopes:dcrMaxClients:dcrUnusedClientTTLDays:defaultLocale:dynamicRegistration:externalClientAllowedResources:samlIdpEnabled:sensitiveScopesEnabled:ssfEnabled:ssfInactiveReason:)","kind":"symbol"},"doc://AxiamSDK/Se":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/Se","title":"Swift.Decodable"},"doc://AxiamSDK/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/s8SendableP","title":"Swift.Sendable"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/externalClientAllowedResources":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"externalClientAllowedResources"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/externalclientallowedresources","abstract":[{"type":"strong","inlineContent":[{"text":"D3","type":"text"}]},{"type":"text","text":" — the audiences an externally registered client may address. The single most"},{"type":"text","text":" "},{"type":"text","text":"important field on this policy, and the reason the settings handler refuses"},{"type":"text","text":" "},{"code":"dynamic_registration: anonymous","type":"codeVoice"},{"type":"text","text":" while it is empty. A client an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"registered cannot declare its own "},{"code":"allowed_resources","type":"codeVoice"},{"type":"text","text":"; it inherits this list verbatim,"},{"type":"text","text":" "},{"type":"text","text":"so what a stranger can mint a token "},{"type":"emphasis","inlineContent":[{"type":"text","text":"for"}]},{"type":"text","text":" is a decision the tenant took in advance"},{"type":"text","text":" "},{"type":"text","text":"rather than one the registration request makes. Empty means an externally registered"},{"type":"text","text":" "},{"type":"text","text":"client can obtain only today’s "},{"code":"axiam:user","type":"codeVoice"},{"type":"text","text":" tokens — which AXIAM’s own APIs accept. That"},{"type":"text","text":" "},{"type":"text","text":"is why the interlock exists: the empty list is not a safe default for an "},{"type":"emphasis","inlineContent":[{"text":"open","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"registration endpoint, it is the most dangerous one. Shared with T5 (CIMD), which"},{"type":"text","text":" "},{"type":"text","text":"inherits the same list for the same reason."}],"role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/externalClientAllowedResources","title":"externalClientAllowedResources","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrAllowedScopes":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dcrAllowedScopes","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrallowedscopes","abstract":[{"text":"T21.4 — the scopes a self-registered client may ask for. A ","type":"text"},{"code":"scope","type":"codeVoice"},{"text":" a registration names","type":"text"},{"text":" ","type":"text"},{"text":"that is not on this list is ","type":"text"},{"code":"invalid_client_metadata","type":"codeVoice"},{"text":"; an empty list means a","type":"text"},{"text":" ","type":"text"},{"text":"self-registered client gets no scopes at all, which is the honest default for a tenant","type":"text"},{"text":" ","type":"text"},{"text":"that has turned registration on without deciding what it grants. May not contain","type":"text"},{"text":" ","type":"text"},{"code":"address","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"phone","type":"codeVoice"},{"text":" — see this module’s [","type":"text"},{"code":"sensitive_scope_in_dcr_list","type":"codeVoice"},{"text":"].","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrAllowedScopes","title":"dcrAllowedScopes","kind":"symbol"}}}