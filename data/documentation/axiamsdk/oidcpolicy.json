le":"symbol","modules":[{"name":"AxiamSDK"}],"roleHeading":"Structure","externalID":"s:8AxiamSDK10OidcPolicyV","symbolKind":"struct","title":"OidcPolicy","navigatorTitle":[{"kind":"identifier","text":"OidcPolicy"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OidcPolicy"}]},"abstract":[{"type":"text","text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8; T21.4). Settings that are not"},{"type":"text","text":" "},{"text":"password rules, here because this is the org-baseline-plus-tenant-override surface every","type":"text"},{"text":" ","type":"text"},{"text":"other per-tenant control lives on. They are not all of the same kind as each other, and","type":"text"},{"text":" ","type":"text"},{"text":"which is which is the whole of what [","type":"text"},{"code":"validate_tenant_override","type":"codeVoice"},{"text":"] and","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"clamp_overrides_to_org","type":"codeVoice"},{"text":"] read, so it is set out rather than inferred. ","type":"text"},{"inlineContent":[{"text":"Ordered","type":"text"}],"type":"strong"},{"text":" — a","type":"text"},{"text":" ","type":"text"},{"text":"tenant may be stricter than its organization and never more permissive: *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::sensitive_scopes_enabled","type":"codeVoice"},{"text":"], validated ","type":"text"},{"inlineContent":[{"type":"text","text":"disable-only"}],"type":"strong"},{"text":" — the mirror image of","type":"text"},{"text":" ","type":"text"},{"code":"mfa_enforced","type":"codeVoice"},{"text":", because releasing personal data is the less-restrictive direction, so a","type":"text"},{"text":" ","type":"text"},{"text":"tenant can turn its organization’s decision off but never on. *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dynamic_registration","type":"codeVoice"},{"text":"], on the ladder ","type":"text"},{"code":"disabled","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"initial_access_token","type":"codeVoice"},{"text":" →","type":"text"},{"text":" ","type":"text"},{"code":"anonymous","type":"codeVoice"},{"text":": a tenant may move down it and never up. * [","type":"text"},{"code":"Self::dcr_max_clients","type":"codeVoice"},{"text":"] and","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_unused_client_ttl_days","type":"codeVoice"},{"text":"], on the ordinary ","type":"text"},{"code":"tenant <= org","type":"codeVoice"},{"text":" rule — with the","type":"text"},{"text":" ","type":"text"},{"text":"wrinkle that ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" on the second means ","type":"text"},{"inlineContent":[{"text":"never sweep","type":"text"}],"type":"emphasis"},{"text":", which is the longest window of all and","type":"text"},{"text":" ","type":"text"},{"text":"is handled by [","type":"text"},{"code":"dcr_ttl_strictness","type":"codeVoice"},{"text":"]. ","type":"text"},{"inlineContent":[{"type":"text","text":"Not ordered"}],"type":"strong"},{"text":", therefore never validated against the","type":"text"},{"text":" ","type":"text"},{"text":"baseline and never clamped: * [","type":"text"},{"code":"Self::default_locale","type":"codeVoice"},{"text":"]. A language is a presentation","type":"text"},{"text":" ","type":"text"},{"text":"preference; there is no sense in which Italian is stricter than French. *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_allowed_scopes","type":"codeVoice"},{"text":"], [","type":"text"},{"code":"Self::dcr_allowed_redirect_hosts","type":"codeVoice"},{"text":"] and","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::external_client_allowed_resources","type":"codeVoice"},{"text":"]. Each names per-tenant resources — ","type":"text"},{"inlineContent":[{"type":"text","text":"this"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"tenant’s MCP servers, ","type":"text"},{"inlineContent":[{"type":"text","text":"this"}],"type":"emphasis"},{"text":" tenant’s callback hosts — and there is no sense in which one","type":"text"},{"text":" ","type":"text"},{"text":"such list is stricter than another. A subset rule would force an organization to enumerate","type":"text"},{"text":" ","type":"text"},{"text":"every tenant’s resource servers in its own baseline before any tenant could name one. The","type":"text"},{"text":" ","type":"text"},{"text":"model’s rule is “a tenant may only be more restrictive”, which binds every field that ","type":"text"},{"inlineContent":[{"text":"has","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"a restrictiveness; a field that has none cannot violate it. One cross-field interlock spans","type":"text"},{"text":" ","type":"text"},{"text":"both groups and is checked on the resolved policy rather than on either input: see","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"validate_dcr_policy","type":"codeVoice"},{"text":"].","type":"text"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/defaultLocale":{"kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/defaultLocale","url":"\/documentation\/axiamsdk\/oidcpolicy\/defaultlocale","title":"defaultLocale","role":"symbol","abstract":[{"type":"text","text":"The BCP 47 tag the sign-in page falls back to when the relying party’s "},{"type":"codeVoice","code":"ui_locales"},{"type":"text","text":" "},{"type":"text","text":"selects nothing (W5’s chain, plan §4.6). "},{"type":"codeVoice","code":"None"},{"type":"text","text":" means “no tenant preference”, which"},{"type":"text","text":" "},{"type":"text","text":"lands on the deployment default ("},{"type":"codeVoice","code":"en"},{"type":"text","text":") — the behaviour every deployment had before this"},{"type":"text","text":" "},{"text":"field existed. A tag this build does not ship also lands there: the parse is exact","type":"text"},{"text":" ","type":"text"},{"text":"rather than a language lookup, so a stored ","type":"text"},{"code":"fr-CA","type":"codeVoice"},{"text":" reads as “somebody wrote something","type":"text"},{"text":" ","type":"text"},{"text":"this binary does not ship” rather than as a guess at French. Stored as a string rather","type":"text"},{"text":" ","type":"text"},{"text":"than as the ","type":"text"},{"code":"Locale","type":"codeVoice"},{"text":" enum because that enum lives in ","type":"text"},{"code":"axiam-oauth2","type":"codeVoice"},{"text":", four layers above","type":"text"},{"text":" ","type":"text"},{"text":"this crate, and the crate layering points inward.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLocale"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrAllowedScopes":{"kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrAllowedScopes","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrallowedscopes","title":"dcrAllowedScopes","role":"symbol","abstract":[{"type":"text","text":"T21.4 — the scopes a self-registered client may ask for. A "},{"type":"codeVoice","code":"scope"},{"type":"text","text":" a registration names"},{"type":"text","text":" "},{"type":"text","text":"that is not on this list is "},{"type":"codeVoice","code":"invalid_client_metadata"},{"type":"text","text":"; an empty list means a"},{"type":"text","text":" "},{"type":"text","text":"self-registered client gets no scopes at all, which is the honest default for a tenant"},{"type":"text","text":" "},{"type":"text","text":"that has turned registration on without deciding what it grants. May not contain"},{"text":" ","typ