never on. * ["},{"type":"codeVoice","code":"Self::saml_idp_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"type":"strong","inlineContent":[{"type":"text","text":"disable-only"}]},{"type":"text","text":" exactly like ["},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"type":"text","text":"] (D-20): a tenant"},{"type":"text","text":" "},{"type":"text","text":"may turn its organization’s "},{"type":"codeVoice","code":"true"},{"type":"text","text":" off and never its "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on. * ["},{"type":"codeVoice","code":"Self::ssf_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"type":"strong","inlineContent":[{"type":"text","text":"disable-only"}]},{"type":"text","text":" the same way (D-45). * ["},{"type":"codeVoice","code":"Self::dynamic_registration"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ladder "},{"type":"codeVoice","code":"disabled"},{"type":"text","text":" → "},{"type":"codeVoice","code":"initial_access_token"},{"type":"text","text":" → "},{"type":"codeVoice","code":"anonymous"},{"type":"text","text":": a tenant may move down it and"},{"type":"text","text":" "},{"type":"text","text":"never up. * ["},{"type":"codeVoice","code":"Self::dcr_max_clients"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::dcr_unused_client_ttl_days"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ordinary "},{"type":"codeVoice","code":"tenant <= org"},{"type":"text","text":" rule — with the wrinkle that "},{"type":"codeVoice","code":"0"},{"type":"text","text":" on the second means "},{"type":"emphasis","inlineContent":[{"text":"never sweep","type":"text"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which is the longest window of all and is handled by ["},{"type":"codeVoice","code":"dcr_ttl_strictness"},{"type":"text","text":"]. "},{"type":"strong","inlineContent":[{"text":"Not","type":"text"},{"text":" ","type":"text"},{"text":"ordered","type":"text"}]},{"type":"text","text":", therefore never validated against the baseline and never clamped: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::default_locale"},{"type":"text","text":"]. A language is a presentation preference; there is no sense in"},{"type":"text","text":" "},{"type":"text","text":"which Italian is stricter than French. * ["},{"type":"codeVoice","code":"Self::dcr_allowed_scopes"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::dcr_allowed_redirect_hosts"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::external_client_allowed_resources"},{"type":"text","text":"]. Each"},{"type":"text","text":" "},{"type":"text","text":"names per-tenant resources — "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" tenant’s MCP servers, "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" tenant’s callback hosts —"},{"type":"text","text":" "},{"type":"text","text":"and there is no sense in which one such list is stricter than another. A subset rule would"},{"type":"text","text":" "},{"type":"text","text":"force an organization to enumerate every tenant’s resource servers in its own baseline"},{"type":"text","text":" "},{"type":"text","text":"before any tenant could name one. The model’s rule is “a tenant may only be more"},{"type":"text","text":" "},{"type":"text","text":"restrictive”, which binds every field that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"has"}]},{"type":"text","text":" a restrictiveness; a field that has none"},{"type":"text","text":" "},{"type":"text","text":"cannot violate it. One cross-field interlock spans both groups and is checked on the"},{"type":"text","text":" "},{"type":"text","text":"resolved policy rather than on either input: see ["},{"type":"codeVoice","code":"validate_dcr_policy"},{"type":"text","text":"]."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","url":"\/documentation\/axiamsdk\/oidcpolicy","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OidcPolicy","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrAllowedScopes":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"T21.4 — the scopes a self-registered client may ask for. A "},{"code":"scope","type":"codeVoice"},{"type":"text","text":" a registration names"},{"type":"text","text":" "},{"type":"text","text":"that is not on this list is "},{"code":"invalid_client_metadata","type":"codeVoice"},{"type":"text","text":"; an empty list means a"},{"type":"text","text":" "},{"type":"text","text":"self-registered client gets no scopes at all, which is the honest default for a tenant"},{"type":"text","text":" "},{"type":"text","text":"that has turned registration on without deciding what it grants. May not contain"},{"type":"text","text":" "},{"code":"address","type":"codeVoice"},{"type":"text","text":" or "},{"code":"phone","type":"codeVoice"},{"type":"text","text":" — see this module’s ["},{"type":"codeVoice","code":"sensitive_scope_in_dcr_list"},{"type":"text","text":"]."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrAllowedScopes","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dcrAllowedScopes","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrallowedscopes","title":"dcrAllowedScopes"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dynamicRegistration":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dynamicRegistration","title":"dynamicRegistration","abstract":[{"type":"text","text":"T21.4 — whether a client may register itself (RFC 7591), and on what terms. "},{"type":"codeVoice","code":"disabled"},{"type":"text","text":" "},{"type":"text","text":"unless somebody says otherwise (I1)."}],"role":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/dynamicregistration","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dynamicRegistration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/sensitiveScopesEnabled":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Whether "},{"code":"address","type":"codeVoice"},{"type":"text","text":" and "},{"code":"phone","type":"codeVoice"},{"type":"text","text":" may be registered on a client, requested at the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint, and released at UserInfo (X7 G8). "},{"type":"strong","inlineContent":[{"type":"text","text":"Off unless an organization"},{"type":"text","text":" "},{"type":"text","text":"turns it on."}]},{"type":"text","text":" The two scopes release a postal address and a telephone number —"},{"type":"text","text":" "},{"type":"text","text":"categories of personal data AXIAM has no other use for — so the deployment that has"},{"type":"text","text":" "},{"type":"text","text":"never thought about them releases nothing, and the operator who has thought about them"},{"type":"text","text":" "},{"type":"text","text":"says so once, at the organization level, where the lawful basis for holding the data was"},{"type":"text","text":" "},{"type":"text","text":"decided. The switch is a "},{"type":"emphasis","inlineContent":[{"text":"capability","type":"text"}]},{"type":"text","text":", not a grant: with it on, a client still has to"},{"type":"text","text":" "},{"type":"text","text":"register the scope, the request still has to ask for it, and the user still has to have"},{"type":"text","text":" "},{"type":"text","text":"consented. It is the first of four gates, and it is the only one an operator can close"},{"type":"text","text":" "},{"type":"text","text":"for everybody at once."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/sensitiveScopesEnabled","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveScopesEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/sensitivescopesenabled","title":"sensitiveScopesEnabled"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/externalClientAllowedResources":{"role":"symbol","type":"topic","abstract":[{"type":"strong","inlineContent":[{"text":"D3","type":"text"}]},{"type":"text","text":" — the audiences an externally registered client may address. The single most"},{"type":"text","text":" "},{"type":"text","text":"important field on this policy, and the reason the settings handler refuses"},{"type":"text","text":" "},{"code":"dynamic_registration: anonymous","type":"codeVoice"},{"type":"text","text":" while it is empty. A client an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"registered cannot declare its own "},{"code":"allowed_resources","type":"codeVoice"},{"type":"text","text":"; it inherits this list verbatim,"},{"type":"text","text":" "},{"type":"text","text":"so what a stranger can mint a token "},{"type":"emphasis","inlineContent":[{"type":"text","text":"for"}]},{"type":"text","text":" is a decision the tenant took in advance"},{"type":"text","text":" "},{"type":"text","text":"rather than one the registration request makes. Empty means an externally registered"},{"type":"text","text":" "},{"type":"text","text":"client can obtain only today’s "},{"code":"axiam:user","type":"codeVoice"},{"type":"text","text":" tokens — which AXIAM’s own APIs accept. That"},{"type":"text","text":" "},{"type":"text","text":"is why the interlock exists: the empty list is not a safe default for an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"open"}]},{"type":"text","text":" "},{"type":"text","text":"registration endpoint, it is the most dangerous one. Shared with T5 (CIMD), which"},{"type":"text","text":" "},{"type":"text","text":"inherits the same list for the same reason."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/externalClientAllowedResources","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"externalClientAllowedResources"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]?"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/externalclientallowedresources","title":"externalClientAllowedResources"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/ssfEnabled":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"ssfEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?"}],"abstract":[{"text":"G-5 \/ D-45 — whether the tenant is a Shared Signals Framework transmitter: its","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/.well-known\/ssf-configuration"},{"type":"text","text":" is served, its receivers can use the stream management"},{"text":" ","type":"text"},{"type":"text","text":"API, and events are signed and transmitted on its streams. Default "},{"inlineContent":[{"code":"false","type":"codeVoice"}],"type":"strong"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Disable-only"}]},{"type":"text","text":", with the shape of ["},{"code":"Self::saml_idp_enabled","type":"codeVoice"},{"text":"]: sending security events","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"about the organization’s users to third parties is the organization’s decision. Streams"},{"type":"text","text":" "},{"text":"can be registered while it is off; they carry nothing until it is on.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/ssfEnabled","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/ssfenabled","type":"topic","title":"ssfEnabled"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/init(cimd:dcrAllowedRedirectHosts:dcrAllowedScopes:dcrMaxClients:dcrUnusedClientTTLDays:defaultLocale:dynamicRegistration:externalClientAllowedResources:samlIdpEnabled:sensitiveScopesEnabled:ssfEnabled:ssfInactiveReason:)":{"role":"symbol","type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/init(cimd:dcrAllowedRedirectHosts:dcrAllowedScopes:dcrMaxClients:dcrUnusedClientTTLDays:defaultLocale:dynamicRegistration:externalClientAllowedResources:samlIdpEnabled:sensitiveScopesEnabled:ssfEnabled:ssfInactiveReason:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"cimd"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CimdPolicy","preciseIdentifier":"s:8AxiamSDK10CimdPolicyV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dcrAllowedRedirectHosts"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"dcrAllowedScopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"dcrMaxClients"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?