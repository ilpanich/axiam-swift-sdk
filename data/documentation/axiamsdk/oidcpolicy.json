xt","text":"has"}]},{"type":"text","text":" a restrictiveness; a field that has none"},{"type":"text","text":" "},{"type":"text","text":"cannot violate it. One cross-field interlock spans both groups and is checked on the"},{"type":"text","text":" "},{"type":"text","text":"resolved policy rather than on either input: see ["},{"type":"codeVoice","code":"validate_dcr_policy"},{"type":"text","text":"]."}],"navigatorTitle":[{"kind":"identifier","text":"OidcPolicy"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","kind":"symbol","type":"topic","title":"OidcPolicy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OidcPolicy"}],"role":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrAllowedRedirectHosts":{"type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrallowedredirecthosts","title":"dcrAllowedRedirectHosts","role":"symbol","kind":"symbol","abstract":[{"text":"T21.4 — hosts a self-registered client’s ","type":"text"},{"code":"redirect_uris","type":"codeVoice"},{"text":" may point at, as globs","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"*.example.com","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" for any). The loopback hosts (","type":"text"},{"code":"127.0.0.1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"[::1]","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":") are always allowed whatever this says, because RFC 8252 §7.3 is how every","type":"text"},{"text":" ","type":"text"},{"text":"desktop MCP client receives its callback and a tenant that forbade them would have","type":"text"},{"text":" ","type":"text"},{"text":"turned registration on for nobody.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrAllowedRedirectHosts","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dcrAllowedRedirectHosts"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/ssfEnabled":{"type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy\/ssfenabled","title":"ssfEnabled","role":"symbol","kind":"symbol","abstract":[{"text":"G-5 \/ D-45 — whether the tenant is a Shared Signals Framework transmitter: its","type":"text"},{"text":" ","type":"text"},{"code":"\/.well-known\/ssf-configuration","type":"codeVoice"},{"text":" is served, its receivers can use the stream management","type":"text"},{"text":" ","type":"text"},{"text":"API, and events are signed and transmitted on its streams. Default ","type":"text"},{"inlineContent":[{"code":"false","type":"codeVoice"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Disable-only","type":"text"}],"type":"strong"},{"text":", with the shape of [","type":"text"},{"type":"codeVoice","code":"Self::saml_idp_enabled"},{"text":"]: sending security events","type":"text"},{"text":" ","type":"text"},{"text":"about the organization’s users to third parties is the organization’s decision. Streams","type":"text"},{"text":" ","type":"text"},{"text":"can be registered while it is off; they carry nothing until it is on.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/ssfEnabled","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"ssfEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/externalClientAllowedResources":{"url":"\/documentation\/axiamsdk\/oidcpolicy\/externalclientallowedresources","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/externalClientAllowedResources","role":"symbol","abstract":[{"type":"strong","inlineContent":[{"text":"D3","type":"text"}]},{"type":"text","text":" — the audiences an externally registered client may address. The single most"},{"type":"text","text":" "},{"type":"text","text":"important field on this policy, and the reason the settings handler refuses"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration: anonymous"},{"type":"text","text":" while it is empty. A client an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"registered cannot declare its own "},{"type":"codeVoice","code":"allowed_resources"},{"type":"text","text":"; it inherits this list verbatim,"},{"type":"text","text":" "},{"type":"text","text":"so what a stranger can mint a token "},{"type":"emphasis","inlineContent":[{"text":"for","type":"text"}]},{"type":"text","text":" is a decision the tenant took in advance"},{"type":"text","text":" "},{"type":"text","text":"rather than one the registration request makes. Empty means an externally registered"},{"type":"text","text":" "},{"type":"text","text":"client can obtain only today’s "},{"type":"codeVoice","code":"axiam:user"},{"type":"text","text":" tokens — which AXIAM’s own APIs accept. That"},{"type":"text","text":" "},{"type":"text","text":"is why the interlock exists: the empty list is not a safe default for an "},{"type":"emphasis","inlineContent":[{"text":"open","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"registration endpoint, it is the most dangerous one. Shared with T5 (CIMD), which"},{"type":"text","text":" "},{"type":"text","text":"inherits the same list for the same reason."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"externalClientAllowedResources"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?"}],"kind":"symbol","type":"topic","title":"externalClientAllowedResources"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrUnusedClientTTLDays":{"type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrunusedclientttldays","title":"dcrUnusedClientTTLDays","abstract":[{"text":"T21.4 — how long an externally registered client survives without being used. See","type":"text"},{"type":"text","text":" "},{"text":"[","type":"text"},{"code":"DEFAULT_DCR_UNUSED_CLIENT_TTL_DAYS","type":"codeVoice"},{"text":"]. ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" disables the sweep for this tenant, which an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"operator who prunes out of band may legitimately want. "},{"type":"strong","inlineContent":[{"text":"Two sweeps read it, over","type":"text"},{"text":" ","type":"text"},{"text":"different clocks","type":"text"}]},{"type":"text","text":" (T21.8). A "},{"type":"codeVoice","code":"managed_by: dcr"},{"text":" row is measured from its last","type":"text"},{"text":" ","type":"text"},{"text":"authorization, falling back to when it was registered. A ","type":"text"},{"code":"managed_by: cimd","type":"codeVoice"},{"type":"text","text":" row is"},{"text":" ","type":"text"},{"type":"text","text":"measured from the last time its document was "},{"type":"emphasis","inlineContent":[{"text":"presented","type":"text"}]},{"text":", which every authorize, token","type":"text"},{"text":" ","type":"text"},{"text":"and PAR request moves — so a document in daily use is never swept however old its","type":"text"},{"text":" ","type":"text"},{"text":"registration is, and one nobody has presented since the window is, and re-materialises","type":"text"},{"text":" ","type":"text"},{"text":"on the next request if it is still published. Like the ceiling, it keeps its ","type":"text"},{"code":"dcr_","type":"codeVoice"},{"text":" ","type":"text"},{"text":"name.","type":"text"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrUnusedClientTTLDays","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dcrUnusedClientTTLDays"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/sensitiveScopesEnabled":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"sensitiveScopesEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/sensitiveScopesEnabled","title":"sensitiveScopesEnabled","kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/sensitivescopesenabled","abstract":[{"type":"text","text":"Whether "},{"code":"address","type":"codeVoice"},{"type":"text","text":" and "},{"code":"phone","type":"codeVoice"},{"type":"text","text":" may be registered on a client, requested at the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint, and released at UserInfo (X7 G8). "},{"inlineContent":[{"type":"text","text":"Off unless an organization"},{"type":"text","text":" "},{"type":"text","text":"turns it on."}],"type":"strong"},{"type":"text","text":" The two scopes release a postal address and a telephone number —"},{"type":"text","text":" "},{"text":"categories of personal data AXIAM has no other use for — so the deployment that has","type":"text"},{"text":" ","type":"text"},{"text":"never thought about them releases nothing, and the operator who has thought about them","type":"text"},{"text":" ","type":"text"},{"text":"says so once, at the organization level, where the lawful basis for holding the data was","type":"text"},{"text":" ","type":"text"},{"text":"decided. The switch is a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"capability","type":"text"}]},{"text":", not a grant: with it on, a client still has to","type":"text"},{"text":" ","type":"text"},{"text":"register the scope, the request still has to ask for it, and the user still has to have","type":"text"},{"text":" ","type":"text"},{"text":"consented. It is the first of four gates, and it is the only one an operator can close","type":"text"},{"text":" ","type":"text"},{"text":"for everybody at once.","type":"text"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/ssfInactiveReason":{"type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy\/ssfinactivereason","title":"ssfInactiveReason","role":"symbol","kind":"symbol","abstract":[{"inlineContent":[{"text":"Read-only","type":"text"}],"type":"strong"},{"type":"text","text":", D-55: set on a settings response when "},{"code":"ssf_enabled","type":"codeVoice"},{"text":" is on but the","type":"text"},{"text":" ","type":"text"},{"text":"transmitter is inactive anyway, saying why — the deployment holds more than one tenant","type":"text"},{"text":" ","type":"text"},{"text":"and serves no per-tenant issuers. Never stored.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/ssfInactiveReason","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"ssfInactiveReason"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/defaultLocale":{"type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy\/defaultlocale","title":"defaultLocale","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The BCP 47 tag the sign-in page falls back to when the relying party’s "},{"type":"codeVoice","code":"ui_locales"},{"type":"text","text":" "},{"text":"selects nothing (W5’s chain, plan §4.6). ","type":"text"},{"code":"None","type":"codeVoice"},{"text":" means “no tenant preference”, which","type":"text"},{"text":" ","type":"text"},{"text":"lands on the deployment default (","type":"text"},{"code":"en","type":"codeVoice"},{"text":") — the behaviour every deployment had before this","type":"text"},{"text":" ","type":"text"},{"text":"field existed. A tag this build does not ship also lands there: the parse is exact","type":"text"},{"text":" ","type":"text"},{"text":"rather than a language lookup, so a stored ","type":"text"},{"code":"fr-CA","type":"codeVoice"},{"text":" reads as “somebody wrote something","type":"text"},{"text":" ","type":"text"},{"text":"this binary does not ship” rather than as a guess at French. Stored as a string rather","type":"text"},{"text":" ","type":"text"},{"text":"than as the ","type":"text"},{"type":"codeVoice","code":"Locale"},{"text":" enum because that enum lives in ","type":"text"},{"type":"codeVoice","code":"axiam-oauth2"},{"text":", four layers above","type":"text"},{"text":" ","type":"text"},{"text":"this crate, and the crate layering points inward.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/defaultLocale","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLocale"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrAllowedScopes":{"type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrallowedscopes","title":"dcrAllowedScopes","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"T21.4 — the scopes a self-registered client may ask for. A "},{"type":"codeVoice","code":"scope"},{"type":"text","text":" a registration names"},{"text":" ","type":"text"},{"text":"that is not on this list is ","type":"text"},{"code":"invalid_client_metadata","type":"codeVoice"},{"text":"; an empty list means a","type":"text"},{"text":" ","type":"text"},{"text":"self-registered client gets no scopes at all, which is the honest default for a tenant","type":"text"},{"text":" ","type":"text"},{"text":"that has turned registration on without deciding what it grants. May not contain","type":"text"},{"text":" ","type":"text"},{"code":"address","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"phone","type":"codeVoice"},{"text":" — see this module’s [","type":"text"},{"type":"codeVoice","code":"sensitive_scope_in_dcr_list"},{"text":"].","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrAllowedScopes","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dcrAllowedScopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]?"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dynamicRegistration":{"title":"dynamicRegistration","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dynamicRegistration","role":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/dynamicregistration","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"T21.4 — whether a client may register itself (RFC 7591), and on what terms. "},{"type":"codeVoice","code":"disabled"},{"type":"text","text":" "},{"text":"unless somebody says otherwise (I1).","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dynamicRegistration","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/cimd":{"type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy\/cimd","title":"cimd","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"T21.5 — whether a URL-shaped "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" is resolved by fetching the document it names,"},{"text":" ","type":"text"},{"text":"and on what terms. See [","type":"text"},{"code":"CimdPolicy","type":"codeVoice"},{"text":"]; off unless somebody turns it on (I1). Nested, and","type":"text"},{"text":" ","type":"text"},{"text":"therefore inherited or overridden ","type":"text"},{"inlineContent":[{"type":"text","text":"whole"}],"type":"strong"},{"text":": the fields are terms of one decision, and a","type":"text"},{"text":" ","type":"text"},{"text":"half-merged posture is one neither the organization nor the tenant wrote.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/cimd","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"cimd"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK10CimdPolicyV","kind":"typeIdentifier","text":"CimdPolicy"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/Se":{"type":"unresolvable","title":"Swift.Decodable","identifier":"doc:\/\/AxiamSDK\/Se"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/dcrMaxClients":{"title":"dcrMaxClients","kind":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/dcrmaxclients","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/dcrMaxClients","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dcrMaxClients"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?"}],"type":"topic","abstract":[{"type":"text","text":"T21.4 — how many externally registered clients this tenant may hold. See"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"DEFAULT_DCR_MAX_CLIENTS"},{"type":"text","text":"]. "},{"type":"strong","inlineContent":[{"type":"text","text":"Counted once per mechanism, against the same number"}]},{"type":"text","text":" "},{"type":"text","text":"(T21.8): "},{"type":"codeVoice","code":"managed_by: dcr"},{"type":"text","text":" rows and "},{"type":"codeVoice","code":"managed_by: cimd"},{"type":"text","text":" rows each have this many. So a"},{"type":"text","text":" "},{"type":"text","text":"tenant running both cannot have shadow rows materialised from documents exhaust the"},{"type":"text","text":" "},{"text":"allowance for self-registration, or the reverse. The CIMD count is checked ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"document is fetched, so a tenant at its ceiling is not an outbound amplifier either. It","type":"text"},{"text":" ","type":"text"},{"text":"keeps its ","type":"text"},{"code":"dcr_","type":"codeVoice"},{"text":" name because dynamic registration defined it, on the same precedent as","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_allowed_scopes","type":"codeVoice"},{"text":"].","type":"text"}]},"doc://AxiamSDK/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/AxiamSDK\/s8SendableP"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/init(from:)":{"type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/init(from:)","abstract":[],"url":"\/documentation\/axiamsdk\/oidcpolicy\/init(from:)","title":"init(from:)","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/encode(to:)":{"type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy\/encode(to:)","title":"encode(to:)","role":"symbol","kind":"symbol","abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/encode(to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7EncoderP","kind":"typeIdentifier","text":"Encoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}]}}}