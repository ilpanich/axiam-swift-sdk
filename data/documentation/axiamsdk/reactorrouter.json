{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter"},"sections":[],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/init()"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/boundEvents"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/fallback(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/handler()","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/on(_:_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/on(eventNamed:_:)"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ReactorRouter","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"§22.10’s handler is ONE function from an event to one answer, which is the","type":"text"},{"text":" ","type":"text"},{"text":"right shape for the wire and the wrong shape for the code. A reactor","type":"text"},{"text":" ","type":"text"},{"text":"registered for three events opens with a ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"event.event","type":"codeVoice"},{"text":", and that","type":"text"},{"text":" ","type":"text"},{"text":"switch is where two defects live. The first is cheap: a misspelled event name","type":"text"},{"text":" ","type":"text"},{"text":"binds nothing and is discovered as an event that never fires. The second is","type":"text"},{"text":" ","type":"text"},{"text":"not — it is the ","type":"text"},{"code":"default:","type":"codeVoice"},{"text":" arm that returns ","type":"text"},{"code":".allow","type":"codeVoice"},{"text":" on behalf of code that","type":"text"},{"text":" ","type":"text"},{"text":"never ran, which is §22.10 rule 2’s defect relocated into user code where the","type":"text"},{"text":" ","type":"text"},{"text":"rule does not reach it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"A BUILDER RATHER THAN AN ATTRIBUTE","type":"text"}],"type":"strong"},{"type":"text","text":", and §22.14 records why: a Swift"},{"type":"text","text":" "},{"type":"text","text":"reactor handler is an "},{"code":"async","type":"codeVoice"},{"type":"text","text":" closure, and collecting "},{"code":"async","type":"codeVoice"},{"type":"text","text":" members by"},{"type":"text","text":" "},{"type":"text","text":"reflection costs a runtime dependency an SDK should not add to hand out an"},{"type":"text","text":" "},{"type":"text","text":"attribute. A builder type-checks the closure against"},{"type":"text","text":" "},{"code":"(ReactorEvent) async throws -> ReactorAnswer","type":"codeVoice"},{"type":"text","text":" at compile time, which is"},{"type":"text","text":" "},{"type":"text","text":"stricter than what the reflection would have bought. Kotlin made the same"},{"type":"text","text":" "},{"type":"text","text":"trade for the same reason."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"PURE SUGAR."}],"type":"strong"},{"type":"text","text":" It opens no connection, consumes no queue, verifies no event,"},{"type":"text","text":" "},{"type":"text","text":"signs no reply and interprets no "},{"code":"timeout_ms","type":"codeVoice"},{"type":"text","text":"; its output is exactly the"},{"type":"text","text":" "},{"type":"text","text":"handler the runtime accepts (rule 1)."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/reactorrouter"]}],"hierarchy":{"paths":[["doc:\/\/