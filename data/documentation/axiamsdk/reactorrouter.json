e":"text","text":"right shape for the wire and the wrong shape for the code. A reactor"},{"type":"text","text":" "},{"type":"text","text":"registered for three events opens with a "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" on "},{"type":"codeVoice","code":"event.event"},{"type":"text","text":", and that"},{"type":"text","text":" "},{"type":"text","text":"switch is where two defects live. The first is cheap: a misspelled event name"},{"type":"text","text":" "},{"type":"text","text":"binds nothing and is discovered as an event that never fires. The second is"},{"type":"text","text":" "},{"type":"text","text":"not — it is the "},{"type":"codeVoice","code":"default:"},{"type":"text","text":" arm that returns "},{"type":"codeVoice","code":".allow"},{"type":"text","text":" on behalf of code that"},{"type":"text","text":" "},{"type":"text","text":"never ran, which is §22.10 rule 2’s defect relocated into user code where the"},{"type":"text","text":" "},{"type":"text","text":"rule does not reach it."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"A BUILDER RATHER THAN AN ATTRIBUTE","type":"text"}],"type":"strong"},{"text":", and §22.14 records why: a Swift","type":"text"},{"text":" ","type":"text"},{"text":"reactor handler is an ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" closure, and collecting ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" members by","type":"text"},{"text":" ","type":"text"},{"text":"reflection costs a runtime dependency an SDK should not add to hand out an","type":"text"},{"text":" ","type":"text"},{"text":"attribute. A builder type-checks the closure against","type":"text"},{"text":" ","type":"text"},{"code":"(ReactorEvent) async throws -> ReactorAnswer","type":"codeVoice"},{"text":" at compile time, which is","type":"text"},{"text":" ","type":"text"},{"text":"stricter than what the reflection would have bought. Kotlin made the same","type":"text"},{"text":" ","type":"text"},{"text":"trade for the same reason.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"PURE SUGAR."}],"type":"strong"},{"text":" It opens no connection, consumes no queue, verifies no event,","type":"text"},{"text":" ","type":"text"},{"text":"signs no reply and interprets no ","type":"text"},{"code":"timeout_ms","type":"codeVoice"},{"text":"; its output is exactly the","type":"text"},{"text":" ","type":"text"},{"text":"handler the runtime accepts (rule 1).","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"struct","navigatorTitle":[{"text":"ReactorRouter","kind":"identifier"}],"roleHeading":"Structure","title":"ReactorRouter","role":"symbol","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ReactorRouter","kind":"identifier"}],"externalID":"s:8AxiamSDK13ReactorRouterV"},"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/ReactorRouter/boundEvents":{"abstract":[{"type":"text","text":"The bound event names, so a reactor author can compute §22.8’s"},{"type":"text","text":" "},{"type":"text","text":"strictest-wins default from the code that actually handles the events"},{"type":"text","text":" "},{"type":"text","text":"rather than from a restatement of the registration."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/boundEvents","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"boundEvents"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"ReactorEventName","preciseIdentifier":"s:8AxiamSDK16ReactorEventNameO"},{"kind":"text","text":"]"}],"url":"\/documentation\/axiamsdk\/reactorrouter\/boundevents","type":"topic","role":"symbol","kind":"symbol","title":"boundEvents"},"doc://AxiamSDK/documentation/AxiamSDK/ReactorRouter/on(eventNamed:_:)":{"url":"\/documentation\/axiamsdk\/reactor