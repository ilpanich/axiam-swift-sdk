{"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/init()"],"title":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/boundEvents"],"title":"Instance Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/fallback(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/handler()","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/on(_:_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/on(eventNamed:_:)"],"title":"Instance Methods"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"abstract":[{"text":"Bind one handler per event and let the SDK compose them into the single","type":"text"},{"text":" ","type":"text"},{"text":"handler ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/reactorServe(config:transport:handler:)","type":"reference"},{"text":" takes.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReactorRouter"}],"platforms":["Linux"]}]},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"text":"§22.10’s handler is ONE function from an event to one answer, which is the","type":"text"},{"text":" ","type":"text"},{"text":"right shape for the wire and the wrong shape for the code. A reactor","type":"text"},{"text":" ","type":"text"},{"text":"registered for three events opens with a ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"event.event","type":"codeVoice"},{"text":", and that","type":"text"},{"text":" ","type":"text"},{"text":"switch is where two defects live. The first is cheap: a misspelled event name","type":"text"},{"text":" ","type":"text"},{"text":"binds nothing and is discovered as an event that never fires. The second is","type":"text"},{"text":" ","type":"text"},{"text":"not — it is the ","type":"text"},{"code":"default:","type":"codeVoice"},{"text":" arm that returns ","type":"text"},{"code":".allow","type":"codeVoice"},{"text":" on behalf of code that","type":"text"},{"text":" ","type":"text"},{"text":"never ran, which is §22.10 rule 2’s defect relocated into user code where the","type":"text"},{"text":" ","type":"text"},{"text":"rule does not reach it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"A BUILDER RATHER THAN AN ATTRIBUTE"}],"type":"strong"},{"text":", and §22.14 records why: a Swift","type":"text"},{"text":" ","type":"text"},{"text":"reactor handler is an ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" closure, and collecting ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" members by","type":"text"},{"text":" ","type":"text"},{"text":"reflection costs a runtime dependency an SDK should not add to hand out an","type":"text"},{"text":" ","type":"text"},{"text":"attribute. A builder type-checks the closure against","type":"text"},{"text":" ","type":"text"},{"code":"(ReactorEvent) async throws -> ReactorAnswer","type":"codeVoice"},{"text":" at compile time, which is","type":"text"},{"text":" ","type":"text"},{"text":"stricter than what the reflection would have bought. Kotlin made the same","type":"text"},{"text":" ","type":"text"},{"text":"trade for the same reason.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"PURE SUGAR."}]},{"type":"text","text":" It opens no connection, consumes no queue, verifies no event,"},{"type":"text","text":" "},{"type":"text","text":"signs no reply and interprets no "},{"type":"codeVoice","code":"timeout_ms"},{"type":"text","text":"; its output is exactly the"},{"type":"text","text":" "},{"type":"text","text":"handler the runtime accepts (rule 1)."}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/s8SendableP"],"title":"Conforms To","type":"conformsTo"}],"metadata":{"externalID":"s:8AxiamSDK13ReactorRouterV","roleHeading":"Structure","symbolKind":"struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReactorRouter"}],"modules":[{"name":"AxiamSDK"}],"title":"ReactorRouter","navigatorTitle":[{"kind":"identifier","text":"ReactorRouter"}]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/axiamsdk\/reactorrouter"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/ReactorRouter/init()":{"kind":"symbol","abstract":[],"title":"init()","fragments":[{"kind":"identifier","text":"init"},{"text":"()","kind":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/reactorrouter\/init()","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/init()"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/reactorServe(config:transport:handler:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/reactorServe(config:transport:handler:)","role":"symbol","url":"\/documentation\/axiamsdk\/reactorserve(config:transport:handler:)","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"reactorServe"},{"text":"(","kind":"text"},{"text":"config","kind":"externalParam"},{"kind":"text","text":": "},{"text"