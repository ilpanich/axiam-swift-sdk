cess. "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" is never written: "},{"code":"encode(to:)","type":"codeVoice"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"code":"\"\"","type":"codeVoice"},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" over these cases needs an "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" arm."}]}]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"topicSections":[{"generated":true,"title":"Enumeration Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttestationMode\/directRequired","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttestationMode\/indirect","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttestationMode\/none","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttestationMode\/unknown"],"anchor":"Enumeration-Cases"},{"generated":true,"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttestationMode\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttestationMode\/init(rawValue:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttestationMode\/encode(to:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Default Implementations","identifiers"