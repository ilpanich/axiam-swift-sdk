{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"decoder"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"The synthesised "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":" initializer stays strict — "},{"type":"codeVoice","code":"init(rawValue:)"},{"type":"text","text":" is still"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for a value that is not a case — so code that deliberately parses a raw string"},{"type":"text","text":" "},{"type":"text","text":"keeps its check. Only DECODING, where the alternative is failing a whole response, is"},{"type":"text","text":" "},{"type":"text","text":"lenient."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TenantKind"]]},"kind":"symbol","metadata":{"roleHeading":"Initializer","role":"symbol","externalID":"s:8AxiamSDK10TenantKindO4fromACs7Decoder_p_tKcfc","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Decoder","preciseIdentifier":"s:s7DecoderP"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"title":"init(from:)","symbolKind":"init","modules":[{"name":"AxiamSDK"}]},"abstract":[{"type":"text","text":"Decodes an unrecognised value to "},{"type":"codeVoice","code":".unknown"},{"type":"text","tex