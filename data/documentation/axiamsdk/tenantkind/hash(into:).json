d","type":"topic","navigatorTitle":[{"text":"TenantKind","kind":"identifier"}],"abstract":[{"text":"What a tenant ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"is","type":"text"}]},{"text":", as distinct from what state it is in. Reserved rather than inferred: an","type":"text"},{"text":" ","type":"text"},{"text":"organization has exactly one tenant of kind [","type":"text"},{"type":"codeVoice","code":"Self::Organization"},{"text":"], enforced by a unique","type":"text"},{"text":" ","type":"text"},{"text":"index rather than by convention. Deriving it from a magic slug or from “the oldest tenant”","type":"text"},{"text":" ","type":"text"},{"text":"would make the organization scope something an operator could rename or delete by accident,","type":"text"},{"text":" ","type":"text"},{"text":"and it is the scope the super-admin lives in.","type":"text"}],"kind":"symbol"}}}