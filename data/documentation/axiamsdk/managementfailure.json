ode":"ValidationError","type":"codeVoice"},{"type":"text","text":" as a sub-type of "},{"code":"NetworkError","type":"codeVoice"},{"type":"text","text":". Swift’s error taxonomy here is an"},{"type":"text","text":" "},{"type":"text","text":"enum with exactly three cases over three "},{"type":"emphasis","inlineContent":[{"text":"structs","type":"text"}]},{"type":"text","text":", and a struct cannot be subclassed —"},{"type":"text","text":" "},{"type":"text","text":"so this SDK renders the sub-type as a discriminator ON the existing struct, exactly as it"},{"type":"text","text":" "},{"type":"text","text":"already renders "},{"code":"OAuthProtocolError","type":"codeVoice"},{"type":"text","text":" as an "},{"code":"AuthError","type":"codeVoice"},{"type":"text","text":" carrying "},{"code":"oauthError","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The property rule 7 actually asks for is preserved either way: a","type":"text"},{"text":" ","type":"text"},{"code":"catch AxiamError.authz","type":"codeVoice"},{"text":" written before §27 existed still catches a 404 and a 409, and a","type":"text"},{"text":" ","type":"text"},{"code":"catch AxiamError.network","type":"codeVoice"},{"text":" still catches a 422.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Why a management call failed, beyond the §2 taxonomy’s three cases."}],"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/managementfailure"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableMetatypeP"],"kind":"relationships"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure/conflict":{"kind":"symbol","abstract":[{"type":"codeVoice","code":"409"},{"type":"text","text":". Also under "},{"type":"codeVoice","code":"AuthzError"},{"type":"text","text":" — §2 already mapped "},{"type":"codeVoice","code":"409"},{"type":"text","text":" there as a resource-level"},{"text":" ","type":"text"},{"text":"refusal, and rule 7 KEEPS that mapping rather than moving it.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"conflict"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/conflict","url":"\/documentation\/axiamsdk\/managementfailure\/conflict","title":"ManagementFailure.conflict"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure/notFound":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/notFound","abstract":[{"code":"404","type":"codeVoice"},{"type":"text","text":". Under "},{"code":"AuthzError","type":"codeVoice"},{"type":"text","text":", which is the surprising part and the deliberate part:"},{"type":"text","text":" "},{"type":"text","text":"AXIAM answers "},{"code":"404","type":"codeVoice"},{"type":"text","text":" for an object in another tenant PRECISELY SO a probing caller"},{"type":"text","text":" "},{"type":"text","text":"cannot tell “does not exist” from “exists, not yours”. Classifying it as an"},{"type":"text","text":" "},{"type":"text","text":"authorization outcome keeps the SDK from re-drawing a line the server deliberately"},{"type":"text","text":" "},{"type":"text","text":"refused to draw."}],"title":"ManagementFailure.notFound","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notFound","kind":"identifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/managementfailure\/notfound","role":"symbol"},"doc://AxiamSDK/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/AxiamSDK\/s16SendableMetatypeP"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure":{"url":"\/documentation\/axiamsdk\/manag