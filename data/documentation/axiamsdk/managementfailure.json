{"sections":[],"metadata":{"externalID":"s:8AxiamSDK17ManagementFailureO","symbolKind":"enum","roleHeading":"Enumeration","modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"text":"ManagementFailure","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagementFailure"}],"role":"symbol","title":"ManagementFailure"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagementFailure","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"text":"§27.4 rule 7 describes ","type":"text"},{"type":"codeVoice","code":"NotFoundError"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ConflictError"},{"text":" as SUB-TYPES of ","type":"text"},{"type":"codeVoice","code":"AuthzError"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"ValidationError"},{"text":" as a sub-type of ","type":"text"},{"type":"codeVoice","code":"NetworkError"},{"text":". Swift’s error taxonomy here is an","type":"text"},{"text":" ","type":"text"},{"text":"enum with exactly three cases over three ","type":"text"},{"inlineContent":[{"type":"text","text":"structs"}],"type":"emphasis"},{"text":", and a struct cannot be subclassed —","type":"text"},{"text":" ","type":"text"},{"text":"so this SDK renders the sub-type as a discriminator ON the existing struct, exactly as it","type":"text"},{"text":" ","type":"text"},{"text":"already renders ","type":"text"},{"type":"codeVoice","code":"OAuthProtocolError"},{"text":" as an ","type":"text"},{"type":"codeVoice","code":"AuthError"},{"text":" carrying ","type":"text"},{"type":"codeVoice","code":"oauthError"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The property rule 7 actually asks for is preserved either way: a"},{"type":"text","text":" "},{"type":"codeVoice","code":"catch AxiamError.authz"},{"type":"text","text":" written before §27 existed still catches a 404 and a 409, and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"catch AxiamError.network"},{"type":"text","text":" still catches a 422."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure"},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"topicSections":[{"anchor":"Enumeration-Cases","generated":true,"title":"Enumeration Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/conflict","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/notFound"]},{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/init(rawValue:)"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/RawRepresentable-Implementations"]}],"variants":[{"paths":["\/documentation\/axiamsdk\/managementfailure"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"abstract":[{"text":"Why a management call failed, beyond the §2 taxonomy’s three cases.","type":"text"}],"references":{"doc://AxiamSDK/SY":{"identifier":"doc:\/\/AxiamSDK\/SY","type":"unresolvable","title":"Swift.RawRepresentable"},"doc://AxiamSDK/s8SendableP":{"title":"Swift.Sendable","type":"u