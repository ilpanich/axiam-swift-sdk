text","text":" as a sub-type of "},{"type":"codeVoice","code":"NetworkError"},{"type":"text","text":". Swift’s error taxonomy here is an"},{"type":"text","text":" "},{"type":"text","text":"enum with exactly three cases over three "},{"type":"emphasis","inlineContent":[{"text":"structs","type":"text"}]},{"type":"text","text":", and a struct cannot be subclassed —"},{"type":"text","text":" "},{"type":"text","text":"so this SDK renders the sub-type as a discriminator ON the existing struct, exactly as it"},{"type":"text","text":" "},{"type":"text","text":"already renders "},{"type":"codeVoice","code":"OAuthProtocolError"},{"type":"text","text":" as an "},{"type":"codeVoice","code":"AuthError"},{"type":"text","text":" carrying "},{"type":"codeVoice","code":"oauthError"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The property rule 7 actually asks for is preserved either way: a","type":"text"},{"text":" ","type":"text"},{"code":"catch AxiamError.authz","type":"codeVoice"},{"text":" written before §27 existed still catches a 404 and a 409, and a","type":"text"},{"text":" ","type":"text"},{"code":"catch AxiamError.network","type":"codeVoice"},{"text":" still catches a 422.","type":"text"}]}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure/Equatable-Implementations":{"abstract":[],"role":"collectionGroup","title":"Equatable Implementations","url":"\/documentation\/axiamsdk\/managementfailure\/equatable-implementations","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/Equatable