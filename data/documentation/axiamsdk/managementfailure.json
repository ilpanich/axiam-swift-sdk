:[{"type":"text","text":"§27.4 rule 7 describes "},{"code":"NotFoundError","type":"codeVoice"},{"type":"text","text":" and "},{"code":"ConflictError","type":"codeVoice"},{"type":"text","text":" as SUB-TYPES of "},{"code":"AuthzError","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"ValidationError","type":"codeVoice"},{"type":"text","text":" as a sub-type of "},{"code":"NetworkError","type":"codeVoice"},{"type":"text","text":". Swift’s error taxonomy here is an"},{"type":"text","text":" "},{"type":"text","text":"enum with exactly three cases over three "},{"type":"emphasis","inlineContent":[{"text":"structs","type":"text"}]},{"type":"text","text":", and a struct cannot be subclassed —"},{"type":"text","text":" "},{"type":"text","text":"so this SDK renders the sub-type as a discriminator ON the existing struct, exactly as it"},{"type":"text","text":" "},{"type":"text","text":"already renders "},{"code":"OAuthProtocolError","type":"codeVoice"},{"type":"text","text":" as an "},{"code":"AuthError","type":"codeVoice"},{"type":"text","text":" carrying "},{"code":"oauthError","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The property rule 7 actually asks for is preserved either way: a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"catch AxiamError.authz"},{"text":" written before §27 existed still catches a 404 and a 409, and a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"catch AxiamError.network"},{"text":" still catches a 422.","type":"text"}]}]}],"kind":"symbol","references":{"doc://AxiamSDK/SY":{"identifier":"doc:\/\/AxiamSDK\/SY","type":"unresolvable","title":"Swift.RawRepresentable"},"doc://AxiamSDK/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/SQ"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure/RawRepresentable-Implementations":{"type":"topic","title":"RawRe