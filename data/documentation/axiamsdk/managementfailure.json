":"text","text":" as SUB-TYPES of "},{"code":"AuthzError","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"ValidationError","type":"codeVoice"},{"type":"text","text":" as a sub-type of "},{"code":"NetworkError","type":"codeVoice"},{"type":"text","text":". Swift’s error taxonomy here is an"},{"type":"text","text":" "},{"type":"text","text":"enum with exactly three cases over three "},{"inlineContent":[{"type":"text","text":"structs"}],"type":"emphasis"},{"type":"text","text":", and a struct cannot be subclassed —"},{"type":"text","text":" "},{"type":"text","text":"so this SDK renders the sub-type as a discriminator ON the existing struct, exactly as it"},{"type":"text","text":" "},{"type":"text","text":"already renders "},{"code":"OAuthProtocolError","type":"codeVoice"},{"type":"text","text":" as an "},{"code":"AuthError","type":"codeVoice"},{"type":"text","text":" carrying "},{"code":"oauthError","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The property rule 7 actually asks for is preserved either way: a","type":"text"},{"text":" ","type":"text"},{"code":"catch AxiamError.authz","type":"codeVoice"},{"text":" written before §27 existed still catches a 404 and a 409, and a","type":"text"},{"text":" ","type":"text"},{"code":"catch AxiamError.network","type":"codeVoice"},{"text":" still catches a 422.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/axiamsdk\/managementfailure"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://AxiamSDK/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/SH"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure/Equatable-Implementations":{"type":"topic","title":"Equatable Implementations","url":"\/documentation\/axiamsdk\/managementfailure\/equatable-implementations","abstract":[],"role