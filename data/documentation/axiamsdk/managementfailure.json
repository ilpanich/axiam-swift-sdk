{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagementFailure","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"§27.4 rule 7 describes "},{"type":"codeVoice","code":"NotFoundError"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ConflictError"},{"type":"text","text":" as SUB-TYPES of "},{"type":"codeVoice","code":"AuthzError"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"ValidationError"},{"type":"text","text":" as a sub-type of "},{"type":"codeVoice","code":"NetworkError"},{"type":"text","text":". Swift’s error taxonomy here is an"},{"type":"text","text":" "},{"type":"text","text":"enum with exactly three cases over three "},{"type":"emphasis","inlineContent":[{"text":"structs","type":"text"}]},{"type":"text","text":", and a struct cannot be subclassed —"},{"type":"text","text":" "},{"type":"text","text":"so this SDK renders the sub-type as a discriminator ON the existing struct, exactly as it"},{"type":"text","text":" "},{"type":"text","text":"already renders "},{"type":"codeVoice","code":"OAuthProtocolError"},{"type":"text","text":" as an "},{"type":"codeVoice","code":"AuthError"},{"type":"text","text":" carrying "},{"type":"codeVoice","code":"oauthError"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The property rule 7 actually asks for is preserved either way: a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"catch AxiamError.authz"},{"text":" written before §27 existed still catches a 404 and a 409, and a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"catch AxiamError.network"},{"text":" still catches a 422.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"Why a management call failed, beyond the §2 taxonomy’s three cases.","type":"text"}],"variants":[{"paths":["\/documentation\/axiamsdk\/managementfailure"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"enum","externalID":"s:8AxiamSDK17ManagementFailureO","modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"kind":"identifier","text":"ManagementFailure"}],"role":"symbol","roleHeading":"Enumeration","title":"ManagementFailure","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagementFailure","kind":"identifier"}]},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/conflict","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/notFound"],"title":"Enumeration Cases","generated":true,"anchor":"Enumeration-Cases"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/init(rawValue:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/RawRepresentable-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure"},"relationshipsSections":[{"identifiers":["doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure/conflict":{"kind":"symbol","url":"\/documentation\/axiamsdk\/managementfailure\/conflict","abstract":[{"type":"codeVoice","code":"409"},{"type":"text","text":". Also under "},{"type":"codeVoice","code":"AuthzError"},{"type":"text","text":" — §2 already mapped "},{"type":"codeVoice","code":"409"},{"type":"text","text":" there as a resource-level"},{"text":" ","type":"text"},{"text":"refusal, and rule 7 KEEPS that mapping rather than moving it.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/conflict","type":"topic","role":"symbol","title":"ManagementFailure.conflict","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"conflict"}]},"doc://AxiamSDK/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/AxiamSDK\/SQ"},"doc://AxiamSDK/SY":{"type":"unresolvable","title":"Swift.RawRepresentable","identifier":"doc:\/\/AxiamSDK\/SY"},"doc://AxiamSDK/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/AxiamSDK\/s16SendableMetatypeP"},"doc://AxiamSDK/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/AxiamSDK\/s8SendableP"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure/init(rawValue:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"rawValue","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"url":"\/documentation\/axiamsdk\/managementfailure\/init(rawvalue:)","type":"topic","title":"init(rawValue:)","abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/init(rawValue:)"},"doc://AxiamSDK/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/AxiamSDK\/SH"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure":{"title":"ManagementFailure","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagementFailure","kind":"identifier"}],"abstract"