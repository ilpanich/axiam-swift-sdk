hError","type":"codeVoice"},{"type":"text","text":" carrying "},{"code":"oauthError","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The property rule 7 actually asks for is preserved either way: a"},{"type":"text","text":" "},{"code":"catch AxiamError.authz","type":"codeVoice"},{"type":"text","text":" written before §27 existed still catches a 404 and a 409, and a"},{"type":"text","text":" "},{"code":"catch AxiamError.network","type":"codeVoice"},{"type":"text","text":" still catches a 422."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Why a management call failed, beyond the §2 taxonomy’s three cases."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/managementfailure"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure","interfaceLanguage":"swift"},"metadata":{"role":"symbol","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagementFailure","kind":"identifier"}],"navigatorTitle":[{"text":"ManagementFailure","kind":"identifier"}],"title":"ManagementFailure","externalID":"s:8AxiamSDK17ManagementFailureO","roleHeading":"Enumeration","symbolKind":"enum"},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP"],"title":"Conforms To","kind":"relationships"}],"references":{"doc://AxiamSDK/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/AxiamSDK\/SH"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure","navigatorTitle":[{"kind":"identifier","text":"ManagementFailure"}],"abstract":[{"typ