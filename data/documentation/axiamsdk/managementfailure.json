es."}]},"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure/notFound":{"role":"symbol","abstract":[{"type":"codeVoice","code":"404"},{"text":". Under ","type":"text"},{"code":"AuthzError","type":"codeVoice"},{"text":", which is the surprising part and the deliberate part:","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"AXIAM answers "},{"code":"404","type":"codeVoice"},{"text":" for an object in another tenant PRECISELY SO a probing caller","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"cannot tell “does not exist” from “exists, not yours”. Classifying it as an"},{"type":"text","text":" "},{"type":"text","text":"authorization outcome keeps the SDK from re-drawing a line the server deliberately"},{"text":" ","type":"text"},{"text":"refused to draw.","type":"text"}],"kind":"symbol","title":"ManagementFailure.notFound","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/notFound","url":"\/documentation\/axiamsdk\/managementfailure\/notfound","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"notFound","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/ManagementFailure/conflict":{"title":"ManagementFailure.conflict","type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementFailure\/conflict","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"conflict"}],"abstract":[{"type":"codeVoice","code":"409"},{"type":"text","text":". Also under "},{"type":"codeVoice","code":"AuthzError"},{"text":" — §2 already mapped ","type":"text"},{"code":"409","type":"codeVoice"},{"text":" there as a resource-level","type":"text"},{"text":" ","type":"text"},{"text":"refusal, and rule 7 KEEPS that mapping rather than moving it.","type":"text"}],"url":"\/documentation\/axiamsdk\/managementfailure\/conflict","kind":"symbol"},"doc://AxiamSDK/SQ":{"title":"Swift.Equatable","type":"unresol