",","type":"text"},{"text":" ","type":"text"},{"code":"display","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ui_locales","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"claims_locales","type":"codeVoice"},{"text":". It is ","type":"text"},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"type":"text","text":" field rather than nine booleans"},{"type":"text","text":" "},{"type":"text","text":"for the same reason ["},{"type":"codeVoice","code":"ClientProfile"},{"type":"text","text":"] is one field rather than a dozen: a client that"},{"type":"text","text":" "},{"type":"text","text":"honours "},{"type":"codeVoice","code":"max_age"},{"type":"text","text":" but ignores "},{"type":"codeVoice","code":"prompt=none"},{"type":"text","text":" is not “mostly conformant”, it is a client a"},{"type":"text","text":" "},{"type":"text","text":"relying party cannot reason about. "},{"type":"reference","identifier":"Self::Ignore","isActive":true},{"type":"text","text":" is the serde default and is"},{"type":"text","text":" "},{"type":"text","text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by"},{"type":"text","text":" "},{"type":"text","text":"the query deserialiser and never reach a decision. Every row written before schema v54"},{"type":"text","text":" "},{"type":"text","text":"therefore decodes to the behaviour it already had."}],"type":"topic","kind":"symbol","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthnRequestParamsMode"}],"navigatorTitle":[{"kind":"identifier","text":"AuthnRequestParamsMode"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Man