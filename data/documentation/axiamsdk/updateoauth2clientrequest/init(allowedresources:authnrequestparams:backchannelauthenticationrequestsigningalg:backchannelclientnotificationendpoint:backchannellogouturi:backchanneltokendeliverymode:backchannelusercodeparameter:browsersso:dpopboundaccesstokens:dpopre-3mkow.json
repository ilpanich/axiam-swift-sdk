uthSubjectDn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"tlsClientCertificateBoundAccessTokens","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?, ","kind":"text"},{"text":"tokenEndpointAuthMethod","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClientAuthMethod","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16ClientAuthMethodO"},{"text":"?)","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode":{"abstract":[{"type":"text","text":"Whether this client’s authorization requests may carry OpenID Connect’s"},{"type":"text","text":" "},{"type":"text","text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this"},{"type":"text","text":" "},{"type":"text","text":"governs is "},{"code":"prompt","type":"codeVoice"},{"type":"text","text":", "},{"code":"max_age","type":"codeVoice"},{"type":"text","text":", "},{"code":"acr_values","type":"codeVoice"},{"type":"text","text":", "},{"code":"claims","type":"codeVoice"},{"type":"text","text":", "},{"code":"id_token_hint","type":"codeVoice"},{"text":", ","type":"text"},{"code":"login_hint","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"display","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ui_locales","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"claims_locales","type":"codeVoice"},{"text":". It is ","type":"text"},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"text":" field rather than nine booleans","type":"text"},{"text":" ","type":"text"},{"text":"for the same reason [","type":"text"},{"code":"ClientProfile","type":"codeVoice"},{"text":"] is one field rather than a dozen: a client that","type":"text"},{"text":" ","type":"text"},{"text":"honours ","type":"text"},{"code":"max_age","type":"codeVoice"},{"text":" but ignores ","type":"text"},{"code":"prompt=none","type":"codeVoice"},{"text":" is not “mostly conformant”, it is a client a","type":"text"},{"text":" ","type":"text"},{"text":"relying party cannot reason about. ","type":"text"},{"identifier":"Self::Ignore","type":"reference","isActive":true},{"text":" is the serde default and is","type":"text"},{"text":" ","type":"text"},{"text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by","type":"text"},{"text":" ","type":"text"},{"text":"the query deserialiser and never reach a decision. Every row written before schema v54","type":"text"},{"text":" ","type":"text"},{"text":"therefore decodes to the behaviour it already had.","type":"text"}],"url":"\/documentation\/axiamsdk\/authnrequestparamsmode","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","title":"AuthnRequestParamsMode","role":"symbol","navigatorTitle":[{"text":"AuthnRequestParamsMode","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AuthnRequestParamsMode","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/UpdateOAuth2ClientRequest":{"title":"UpdateOAuth2ClientRequest","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateOAuth2ClientRequest","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"UpdateOAuth2ClientRequest"},{"type":"text","text":" schema."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UpdateOAuth2ClientRequest"}],"type":"topic","url":"\/documentation\/axiamsdk\/updateoauth2clientrequest","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"UpdateOAuth2ClientRequest"}]},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","url":"\/documentation\/axiamsdk\/clientprofile","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nearly"}]},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"type":"reference","identifier":"Self::Standard","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"kind":"symbol","type":"topic","title":"ClientProfile"},"Self::Ignore":{"titleInlineContent":[{"code":"Ignore","type":"codeVoice"}],"identifier":"Self::Ignore","url":"Self::Ignore","type":"link","title":"Ignore"},"Self::Standard":{"titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"identifier":"Self::Standard","url":"Self::Standard","type":"link","title":"Standard"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","url":"\/documentation\/axiamsdk\/clientauthmethod","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientAuthMethod"}],"navigatorTitle":[{"kind":"identifier","text":"ClientAuthMethod"}],"abstract":[{"text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming).","type":"text"},{"text":" ","type":"text"},{"text":"Only the methods AXIAM actually implements are representable. ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" — the public-client","type":"text"},{"text":" ","type":"text"},{"text":"value — was deliberately absent until T21.2: adding it before the rest of the server","type":"text"},{"text":" ","type":"text"},{"text":"understood one would have let an operator register a client whose authentication is silently","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The server understands one now (","type":"text"},{"type":"codeVoice","code":"token.rs"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"authenticate_client_credential"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"an arm that accepts ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"no","type":"text"}]},{"text":" credential and refuses a presented one, the authorization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"kind":"symbol","type":"topic","title":"ClientAuthMethod"}}}