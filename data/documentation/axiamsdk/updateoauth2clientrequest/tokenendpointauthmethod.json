":"None"},{"text":" — the public-client","type":"text"},{"text":" ","type":"text"},{"text":"value — was deliberately absent until T21.2: adding it before the rest of the server","type":"text"},{"text":" ","type":"text"},{"text":"understood one would have let an operator register a client whose authentication is silently","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The server understands one now (","type":"text"},{"type":"codeVoice","code":"token.rs"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"authenticate_client_credential"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"an arm that accepts ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"no","type":"text"}]},{"text":" credential and refuses a presented one, the authorization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"type":"topic","title":"ClientAuthMethod","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","url":"\/documentation\/axiamsdk\/clientauthmethod","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ClientAuthMethod"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientAuthMethod"}]},"doc://AxiamSDK/documentation/AxiamSDK/UpdateOAuth2ClientRequest/tokenEndpointAuthMethod":{"title":"tokenEndpointAuthMethod","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tokenEndpointAuthMethod","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ClientAuthMethod","preciseIdentifier":"s:8AxiamSDK16ClientAuthMethodO","kind":"typeIdentifier"},{"text":"?","kind":