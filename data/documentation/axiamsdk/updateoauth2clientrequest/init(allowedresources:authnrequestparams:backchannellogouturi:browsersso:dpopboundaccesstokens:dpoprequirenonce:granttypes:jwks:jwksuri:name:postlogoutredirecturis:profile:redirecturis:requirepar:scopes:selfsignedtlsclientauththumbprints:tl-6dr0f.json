ding one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"type":"topic","title":"ClientProfile","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/clientprofile","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"},"Self::Standard":{"url":"Self::Standard","title":"Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"type":"link","identifier":"Self::Standard"},"Self::Ignore":{"url":"Self::Ignore","title":"Ignore","titleInlineContent":[{"code":"Ignore","type":"codeVoice"}],"type":"link","identifier":"Self::Ignore"}}}