,"type":"topic","url":"\/documentation\/axiamsdk\/updateoauth2clientrequest","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"UpdateOAuth2ClientRequest"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","url":"\/documentation\/axiamsdk\/clientprofile","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nearly"}]},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"type":"reference","identifier":"Self::Standard","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"kind":"symbol","type":"topic","title":"ClientProfile"},"Self::Standard":{"titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"title":"Standard","identifier":"Self::Standard","type":"link","url":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK/UpdateOAuth2ClientRequest/profile":{"title":"profile","kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/updateoauth2clientrequest\/profile","abstract":[{"text":"The server’s ","type":"text"},{"code":"profile","type":"codeVoice"},{"text":" field.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateOAuth2ClientRequest\/profile","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"profile"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ClientProfile","preciseIdentifier":"s:8AxiamSDK13ClientProfileO"},{"kind":"text","text":"?"}]}}}