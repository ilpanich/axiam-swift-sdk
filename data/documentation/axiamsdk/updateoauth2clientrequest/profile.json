"role":"symbol","url":"\/documentation\/axiamsdk\/updateoauth2clientrequest\/profile","abstract":[{"text":"The server’s ","type":"text"},{"code":"profile","type":"codeVoice"},{"text":" field.","type":"text"}],"type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"kind":"symbol","url":"\/documentation\/axiamsdk\/clientprofile","type":"topic","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"title":"ClientProfile","abstract":[{"type":"text","text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”."},{"type":"text","text":" "},{"type":"text","text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"S256"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"nearly"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"isActive":true,"type":"reference","identifier":"Self::Standard"},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"},"doc://AxiamSDK/documentation/AxiamSDK/UpdateOAuth2ClientRequest":{"title":"UpdateOAuth2ClientRequest","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateOAuth2ClientRequest","abstract":[{"text":"The ","type":"text"},{"code":"UpdateOAuth2ClientRequest","type":"codeVoice"},{"text":" schema.","type":"text"}],"url":"\/documentation\/axiamsdk\/updateoauth2clientrequest","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateOAuth2ClientRequest","kind":"identifier"}],"navigatorTitle":[{"text":"UpdateOAuth2ClientRequest","kind":"identifier"}]},"Self::Standard":{"type":"link","identifier":"Self::Standard","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"title":"Standard","url":"Self::Standard"}}}