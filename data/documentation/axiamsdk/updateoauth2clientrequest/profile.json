xt":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"title":"ClientProfile","type":"topic","url":"\/documentation\/axiamsdk\/clientprofile"},"doc://AxiamSDK/documentation/AxiamSDK/UpdateOAuth2ClientRequest/profile":{"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"profile","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ClientProfile","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13ClientProfileO"},{"text":"?","kind":"text"}],"url":"\/documentation\/axiamsdk\/updateoauth2clientrequest\/profile","type":"topic","role":"symbol","abstract":[{"text":"The server’s ","type":"text"},{"type":"codeVoice","code":"profile"},{"text":" field.","type":"text"}],"kind":"symbol","title":"profile","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateOAuth2ClientRequest\/profile"}}}