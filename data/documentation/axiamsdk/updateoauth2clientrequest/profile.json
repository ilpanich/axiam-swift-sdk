datory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"type":"text","text":", mandatory strong client authentication, mandatory sender-constrained tokens,"},{"type":"text","text":" "},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"text":"written before schema v38 decodes to it.","type":"text"}],"title":"ClientProfile","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"Self::Standard":{"title":"Standard","identifier":"Self::Standard","type":"link","url":"Self::Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}]},"doc://AxiamSDK/documentation/AxiamSDK/UpdateOAuth2ClientRequest/profile":{"title":"profile","kind":"symbol","identifier":"doc:\