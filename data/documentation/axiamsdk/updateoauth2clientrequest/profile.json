ctive":true,"identifier":"Self::Standard","type":"reference"},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/UpdateOAuth2ClientRequest":{"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateOAuth2ClientRequest","navigatorTitle":[{"kind":"identifier","text":"UpdateOAuth2ClientRequest"}],"abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"UpdateOAuth2ClientRequest"},{"text":" schema.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UpdateOAuth2ClientRequest"}],"title":"UpdateOAuth2ClientRequest","url":"\/documentation\/axiamsdk\/updateoauth2clientrequest"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}