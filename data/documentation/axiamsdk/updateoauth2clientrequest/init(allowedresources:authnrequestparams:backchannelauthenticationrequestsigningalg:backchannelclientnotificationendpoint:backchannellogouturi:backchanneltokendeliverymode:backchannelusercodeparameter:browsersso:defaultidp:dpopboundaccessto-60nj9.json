ation endpoint"},{"type":"text","text":" "},{"type":"text","text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside"},{"type":"text","text":" "},{"type":"text","text":"any grant or binding that contradicts it), so the variant exists — and only that arm may"},{"type":"text","text":" "},{"type":"text","text":"ever treat a missing credential as success."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod"},"Self::Standard":{"type":"link","url":"Self::Standard","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"identifier":"Self::Standard","title":"Standard"},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthnRequestParamsMode"}],"abstract":[{"text":"Whether this client’s authorization requests may carry OpenID Connect’s","type":"text"},{"text":" ","type":"text"},{"text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this","type":"text"},{"text":" ","type":"text"},{"text":"governs is ","type":"text"},{"code":"prompt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"max_age","type":"codeVoice"},{"text":", ","type":"text"},{"code":"acr_values","type":"codeVoice"},{"text":", ","type":"text"},{"code":"claims","type":"codeVoice"},{"text":", ","type":"text"},{"code":"id_token_hint","type":"codeVoice"},{"text":", ","type":"text"},{"code":"login_hint","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"display","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ui_locales","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"claims_locales","type":"codeVoice"},{"text":". It is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"one"}]},{"text":" field rather than nine booleans","type":"text"},{"text":" ","type":"text"},{"text":"for the same reason [","type":"text"},{"code":"ClientProfile","type":"codeVoice"},{"text":"] is one field rather than a dozen: a client that","type":"text"},{"text":" ","type":"text"},{"text":"honours ","type":"text"},{"code":"max_age","type":"codeVoice"},{"text":" but ignores ","type":"text"},{"code":"prompt=none","type":"codeVoice"},{"text":" is not “mostly conformant”, it is a client a","type":"text"},{"text":" ","type":"text"},{"text":"relying party cannot reason about. ","type":"text"},{"isActive":true,"identifier":"Self::Ignore","type":"reference"},{"text":" is the serde default and is","type":"text"},{"text":" ","type":"text"},{"text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by","type":"text"},{"text":" ","type":"text"},{"text":"the query deserialiser and never reach a decision. Every row written before schema v54","type":"text"},{"text":" ","type":"text"},{"text":"therefore decodes to the behaviour it already had.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","type":"topic","title":"AuthnRequestParamsMode","navigatorTitle":[{"kind":"identifier","text":"AuthnRequestParamsMode"}]},"doc://AxiamSDK/documentation/AxiamSDK/UpdateOAuth2ClientRequest":{"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateOAuth2ClientRequest","navigatorTitle":[{"kind":"identifier","text":"UpdateOAuth2ClientRequest"}],"abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"UpdateOAuth2ClientRequest"},{"text":" schema.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UpdateOAuth2ClientRequest"}],"title":"UpdateOAuth2ClientRequest","url":"\/documentation\/axiamsdk\/updateoauth2clientrequest"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"url":"\/documentation\/axiamsdk\/clientprofile","title":