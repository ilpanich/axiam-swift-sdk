ese cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","sections":[],"metadata":{"roleHeading":"Enumeration","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectoryKind"}],"role":"symbol","externalID":"s:8AxiamSDK13DirectoryKindO","modules":[{"name":"AxiamSDK"}],"title":"DirectoryKind","navigatorTitle":[{"kind":"identifier","text":"DirectoryKind"}],"symbolKind":"enum"},"abstract":[{"text":"Which kind of directory server a configuration points at. It drives ","type":"text"},{"type":"strong","inlineContent":[{"text":"defaults only","type":"text"}]},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"external-id attribute, the group-membership strategy and the change attribute the sync job","type":"text"},{"text":" ","type":"text"},{"text":"reads. Every one of them is still an explicit, editable field of the configuration (or, for","type":"text"},{"text":" ","type":"text"},{"text":"the strategy and change attribute, derived from this value at the point of use); nothing","type":"text"},{"text":" ","type":"text"},{"text":"about the kind changes what is ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"allowed"}]},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP"],"kind":"relationships","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/axiamsdk\/directorykind"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind\/activeDirectory