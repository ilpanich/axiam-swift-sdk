{"kind":"symbol","abstract":[{"text":"What to do with an AAGUID that has no MDS entry (i.e. FIDO Alliance has no metadata for it —","type":"text"},{"text":" ","type":"text"},{"text":"not necessarily malicious, MDS coverage is incomplete for some legitimate authenticators).","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction"},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction\/allow","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction\/deny","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction\/unknown"]},{"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction\/init(from:)-8qi3f","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction\/init(rawValue:)"]},{"title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction\/encode(to:)"]},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction\/RawRepresentable-Implementations"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP"]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/unknownaaguidaction"]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"UnknownAaguidAction"}],"roleHeading":"Enumeration","title":"UnknownAaguidAction","modules":[{"name":"AxiamSDK"}],"symbolKind":"enum","role":"symbol","fragments":[{"kind":"ke