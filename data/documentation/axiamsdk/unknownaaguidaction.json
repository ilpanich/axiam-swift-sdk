{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnknownAaguidAction"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"inlineContent":[{"text":"open","type":"text"}],"type":"strong"},{"text":" enum. A value this SDK’s copy of the spec does not list decodes to ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there","type":"text"},{"text":" ","type":"text"},{"text":"fails the WHOLE response, so one field of one record would take down the page it was on,","type":"text"},{"text":" ","type":"text"},{"text":"including the records the caller did ask for.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to","type":"text"},{"text":" ","type":"text"},{"text":"be first turns a new server state into a wrong one, and on this surface these values gate","type":"text"},{"text":" ","type":"text"},{"text":"access. ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":"’s own raw value is the empty string, which no server value is, so","type":"text"},{"text":" ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" is never written: ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":" refuses it locally, before any request, as a","type":"text"},{"text":" ","type":"text"},{"text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as ","type":"text"},{"code":"\"\"","type":"codeVoice"},{"text":", never left","type":"text"},{"text":" ","type":"text"},{"text":"to the server to refuse. 