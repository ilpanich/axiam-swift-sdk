},{"type":"codeVoice","code":"\"\""},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}]}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/UnknownAaguidAction/allow":{"type":"topic","title":"UnknownAaguidAction.allow","abstract":[],"kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction\/allow","url":"\/documentation\/axiamsdk\/unknownaaguidaction\/allow","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"allow","kind":"identifier"}]},"doc://AxiamSDK/SH":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/SH","title":"Swift.Hashable"},"doc://AxiamSDK/documentation/AxiamSDK/UnknownAaguidAction/init(rawValue:)":{"title":"init(rawValue:)","url":"\/documentation\/axiamsdk\/unknownaaguidaction\/init(rawvalue:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"rawValue"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"text":")","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction\/init(rawValue:)","role":"symbol","type":"topic","abstract":[],"kind":"symbol"},"doc://AxiamSDK/s12CaseIterableP":{"type":"unresolvable","title":"Swift.CaseIterable","identifier":"doc:\/\/AxiamSDK\/s12CaseIterableP"},"doc://AxiamSDK/documentation/AxiamSDK/UnknownAaguidAction/RawRepresentable-Implementations":{"title":"RawRepresentable Implementations","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction\/RawRepresentable-Implementations","abstract":[],"kind":"article","type":"topic","url":"\/documentation\/axiamsdk\/unknownaaguidaction\/rawrepresentable-implementations","role":"collectionGroup