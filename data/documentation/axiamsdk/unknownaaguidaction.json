":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"text":"An ","type":"text"},{"inlineContent":[{"type":"text","text":"open"}],"type":"strong"},{"text":" enum. A value this SDK’s copy of the spec does not list decodes to ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there","type":"text"},{"text":" ","type":"text"},{"text":"fails the WHOLE response, so one field of one record would take down the page it was on,","type":"text"},{"text":" ","type":"text"},{"text":"including the records the caller did ask for.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to","type":"text"},{"text":" ","type":"text"},{"text":"be first turns a new server state into a wrong one, and on this surface these values gate","type":"text"},{"text":" ","type":"text"},{"text":"access. ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":"’s own raw value is the empty string, which no server value is, so","type":"text"},{"text":" ","type":"text"},{"text":"carrying an unrecognised value back into an update is refused by the server rather than","type":"text"},{"text":" ","type":"text"},{"text":"written as a spelling it never used. A ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over these cases needs an ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" arm.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"What to do with an AAGUID that has no MDS entry (i.e. FIDO Alliance has no metadata for it —"},{"type":"text","text":" "},{"type":"text","text":"not necessarily malicious, MDS coverage is incomplete for some legitimate authenticators)."}],"references":{"doc://AxiamSDK/SQ":{"type":"unresolvable","