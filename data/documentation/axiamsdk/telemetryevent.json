{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryEvent"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"An "},{"code":"enum","type":"codeVoice"},{"type":"text","text":" rather than a protocol hierarchy, which is what makes §19.2 rule 3’s “no event"},{"type":"text","text":" "},{"type":"text","text":"payload may carry a secret” checkable rather than aspirational: the case list is closed, each"},{"type":"text","text":" "},{"type":"text","text":"case has a fixed associated-value list, and none of them is a dictionary. There is nowhere to"},{"type":"text","text":" "},{"type":"text","text":"put a token in a payload bound for a metrics backend — the type, not a review comment, is what"},{"type":"text","text":" "},{"type":"text","text":"keeps them out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Hooks are invoked on the calling task, so a sink must not block: §19.2 rule 4 makes buffering"},{"type":"text","text":" "},{"type":"text","text":"the caller’s job so they can pick the policy. Every mature metrics library already buffers."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"TelemetryEvent"}],"externalID":"s:8AxiamSDK14TelemetryEventO","title":"TelemetryEvent","modules":[{"name":"AxiamSDK"}],"roleHeading":"Enumeration","role":"symbol","symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryEvent"}]},"abstract":[{"text":"A telemetry event (CONTRACT.md §19).","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent\/configClamped(setting:requested:effective:contractReference:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/T