n\/AxiamSDK\/CaCertificate\/keyLocator"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/chainPEM":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/chainPEM","title":"chainPEM","abstract":[{"type":"text","text":"The issuers above ["},{"code":"Self::public_cert_pem","type":"codeVoice"},{"type":"text","text":"], concatenated PEM, nearest issuer first and"},{"type":"text","text":" "},{"type":"text","text":"the root last. "},{"code":"None","type":"codeVoice"},{"type":"text","text":" for a CA that is its own root, which is every CA AXIAM generated"},{"type":"text","text":" "},{"type":"text","text":"before Vault’s PKI engine was an option. Present for a "},{"code":"vault_pki","type":"codeVoice"},{"type":"text","text":" CA, where it is the"},{"type":"text","text":" "},{"type":"text","text":"only copy of the root certificate anything outside Vault will ever see — a relying party"},{"type":"text","text":" "},{"type":"text","text":"cannot validate an AXIAM-issued leaf without it, and "},{"code":"root\/generate\/internal","type":"codeVoice"},{"type":"text","text":" returns it"},{"type":"text","text":" "},{"type":"text","text":"exactly once."}],"role":"symbol","url":"\/documentation\/axiamsdk\/cacertificate\/chainpem","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chainPEM","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/init(chainPEM:createdAt:fingerprint:id:keyAlgorithm:keyCustody:keyLocator:mtlsTrustAnchor:notAfter:notBefore:organizationID:parentCAID:publicCertPEM:status:subject:tenantID:)":{"url":"\/documentation\/axiamsdk\/cacertificate\/init(chainpem:createdat:fingerprint:id:keyalgorithm:keycustody:keylocator:mtlstrustanchor:notafter:notbefore:organizationid:parentcaid:publiccertpem:status:subject:tenantid:)","role":"symbol","abst