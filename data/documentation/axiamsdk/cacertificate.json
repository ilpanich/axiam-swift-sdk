truction: it is what the server hands every client during the","type":"text"},{"text":" ","type":"text"},{"text":"TLS handshake, and every device that has to validate the chain already holds a copy. #","type":"text"},{"text":" ","type":"text"},{"text":"Why a restart rustls builds its ","type":"text"},{"code":"RootCertStore","type":"codeVoice"},{"text":" once, when the listener is constructed,","type":"text"},{"text":" ","type":"text"},{"text":"and actix-web binds that config for the process’s life. Toggling this changes what the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"next","type":"text"}],"type":"emphasis"},{"text":" boot trusts, and the API says so in its response rather than pretending the","type":"text"},{"text":" ","type":"text"},{"text":"change took effect. Defaults to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", so a deployment that never touches this keeps","type":"text"},{"text":" ","type":"text"},{"text":"exactly the TLS posture it has today.","type":"text"}],"url":"\/documentation\/axiamsdk\/cacertificate\/mtlstrustanchor","title":"mtlsTrustAnchor","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mtlsTrustAnchor","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/mtlsTrustAnchor"},"doc://AxiamSDK/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/s8SendableP"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/createdAt":{"url":"\/documentation\/axiamsdk\/cacertificate\/createdat","title":"createdAt","abstract":[{"type":"text","text":"The server’s "},{"type":"codeVoice","code":"created_at"},{"type":"text","text":" field."}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/createdAt","kind":"symbol","role":"symbol","fr