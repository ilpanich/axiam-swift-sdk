","type":"text"}],"type":"strong"},{"type":"text","text":" certificate to the bundle named by"},{"type":"text","text":" "},{"type":"codeVoice","code":"AXIAM__SERVER__TLS__CLIENT_CA_BUNDLE_PATH"},{"type":"text","text":" at startup and turns client-certificate"},{"type":"text","text":" "},{"type":"text","text":"authentication on ("},{"type":"codeVoice","code":"optional"},{"type":"text","text":") if the operator has not configured it explicitly. A"},{"type":"text","text":" "},{"type":"text","text":"client presenting a certificate that chains to this CA is then verified by the TLS layer"},{"type":"text","text":" "},{"type":"text","text":"itself, which is what "},{"type":"codeVoice","code":"axiam_pki::mtls"},{"type":"text","text":" needs to authenticate an IoT device or a service"},{"type":"text","text":" "},{"type":"text","text":"account by certificate rather than by secret. # What is and is not copied Only"},{"type":"text","text":" "},{"type":"codeVoice","code":"public_cert_pem"},{"type":"text","text":" — the certificate. The "},{"inlineContent":[{"text":"private key stays where its custodian put","type":"text"},{"text":" ","type":"text"},{"text":"it","type":"text"}],"type":"strong"},{"type":"text","text":" (Vault, or sealed into the row) and is never written to the server volume. A trust"},{"type":"text","text":" "},{"type":"text","text":"anchor is public by construction: it is what the server hands every client during the"},{"type":"text","text":" "},{"type":"text","text":"TLS handshake, and every device that has to validate the chain already holds a copy. #"},{"type":"text","text":" "},{"type":"text","text":"Why a restart rustls builds its "},{"type":"codeVoice","code":"RootCertStore"},{"type":"text","text":" once, when the listener is constructed,"},{"type":"text","text":" "},{"type":"text","text":"and actix-web binds that config for the process’s life. Toggling this changes what the"},{"type":"text","text":" "},{"inlineContent":[{"text":"next","type":"text"}],"typ