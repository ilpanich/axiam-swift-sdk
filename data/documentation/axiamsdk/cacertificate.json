":"text"},{"text":" ","type":"text"},{"text":"only copy of the root certificate anything outside Vault will ever see — a relying party","type":"text"},{"text":" ","type":"text"},{"text":"cannot validate an AXIAM-issued leaf without it, and ","type":"text"},{"code":"root\/generate\/internal","type":"codeVoice"},{"type":"text","text":" returns it"},{"type":"text","text":" "},{"type":"text","text":"exactly once."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"chainPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"type":"topic","role":"symbol","title":"chainPEM","url":"\/documentation\/axiamsdk\/cacertificate\/chainpem","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/chainPEM"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/notAfter":{"title":"notAfter","url":"\/documentation\/axiamsdk\/cacertificate\/notafter","role":"symbol","abstract":[{"type":"text","text":"Validity end."}],"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notAfter","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/notAfter","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/mtlsTrustAnchor":{"abstract":[{"text":"Whether this CA is offered as a trust anchor for mutual TLS. When set, the server","type":"text"},{"text":" ","type":"text"},{"text":"exports this CA’s ","type":"text"},{"inlineContent":[{"text":"public","type":"text"}],"type":"strong"},{"text":" certificate to the bundle named by","type":"text"},{"text":" ","type":"text"},{"code":"AXIAM__SERVER__TLS__CLIENT_CA_BUNDLE_PATH","type":"codeVoice"},{"text":" at startup and turns client-certificate","type":"text"},{"text":" ","type":"text"},{"text":"authentication on (","type":"text"},{"code":"optional","type":"codeVoice"},{"text":") if the operator has not configured it explicitly. A","type":"text"},{"text":" ","type":"text"},{"text":"client presenting a certificate that chains to this CA is then verified by the TLS layer","type":"text"},{"text":" ","type":"text"},{"text":"itself, which is what ","type":"text"},{"code":"axiam_pki::mtls","type":"codeVoice"},{"text":" needs to authenticate an IoT device or a service","type":"text"},{"text":" ","type":"text"},{"text":"account by certificate rather than by secret. # What is and is not copied Only","type":"text"},{"text":" ","type":"text"},{"code":"public_cert_pem","type":"codeVoice"},{"text":" — the certificate. The ","type":"text"},{"inlineContent":[{"text":"private key stays where its custodian put","type":"text"},{"text":" ","type":"text"},{"text":"it","type":"text"}],"type":"strong"},{"text":" (Vault, or sealed into the row) and is never written to the server volume. A trust","type":"text"},{"type":"text","text":" "},{"type":"text","text":"anchor is public by construction: it is what the server hands every client during the"},{"type":"text","text":" "},{"type":"text","text":"TLS handshake, and every device that has to validate the chain already holds a copy. #"},{"type":"text","text":" "},{"type":"text","text":"Why a restart rustls builds its "},{"code":"RootCertStore","type":"codeVoice"},{"type":"text","text":" once, when the listener is constructed,"},{"type":"text","text":" "},{"type":"text","text":"and actix-web binds that config for the process’s life. Toggling this changes what the"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"next","type":"text"}]},{"type":"text","text":" boot trusts, and the API says so in its response rather than pretending the"},{"type":"text","text":" "},{"type":"text","text":"change took effect. Defaults to "},{"code":"false","type":"codeVoice"},{"type":"text","text":", so a deployment that never touches this keeps"},