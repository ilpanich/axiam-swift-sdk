ty) certificate at the organization level. CA certificates are the"},{"type":"text","text":" "},{"type":"text","text":"root of trust for all tenant certificates within the organization. Private keys for signing"},{"type":"text","text":" "},{"type":"text","text":"CAs are encrypted with AES-256-GCM and stored separately; non-signing CAs only store the"},{"type":"text","text":" "},{"type":"text","text":"public certificate."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate"},"sections":[],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/s8SendableP"],"kind":"relationships","type":"conformsTo"}],"metadata":{"role":"symbol","title":"CaCertificate","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CaCertificate","kind":"identifier"}],"navigatorTitle":[{"text":"CaCertificate","kind":"identifier"}],"modules":[{"name":"AxiamSDK"}],"symbolKind":"struct","externalID":"s:8AxiamSDK13CaCertificateV"},"variants":[{"paths":["\/documentation\/axiamsdk\/cacertificate"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/chainPEM":{"url":"\/documentation\/axiamsdk\/cacertificate\/chainpem","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chainPEM","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/chainPEM","type":"topic","title":"chainPEM","kind":"symbol","abstract":[{"type":"text","text":"The issuers above ["},{"type":"codeVoice","code":"Self::public_cert_pem"},{"type":"text","text":"], concatenated PEM, nearest issuer first and"},{"type":"text","text":" "},{"type":"text","text":"the root last. "},{"type":"codeVoice","code":"None"},{"type":"text","text":" for a CA that is its own root, which is every CA AXIAM generated"},{"text":" ","type":"text"},{"text":"before Vault’s PKI engine was an option. Present for a ","type":"text"},{"type":"codeVoice","code":"vault_pki"},{"text":" CA, where it is the","type":"text"},{"text":" ","type":"text"},{"text":"only copy of the root certificate anything outside Vault will ever see — a relying party","type":"text"},{"text":" ","type":"text"},{"text":"cannot validate an AXIAM-issued leaf without it, and ","type":"text"},{"type":"codeVoice","code":"root\/generate\/internal"},{"type":"text","text":" returns it"},{"type":"text","text":" "},{"type":"text","text":"exactly once."}],"role":"symbol"},"doc://AxiamSDK/s8SendableP":{"identifier":"doc:\/\/AxiamSDK\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://AxiamSDK/SE":{"identifier":"doc:\/\/AxiamSDK\/SE","type":"unresolvable","title":"Swift.Encodable"},"doc://AxiamSDK/Se":{"identifier":"doc:\/\/AxiamSDK\/Se","type":"unresolvable","title":"Swift.Decodable"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/keyAlgorithm":{"kind":"symbol","title":"keyAlgorithm","type":"topic","role":"symbol","abstract":[{"text":"The server’s ","type":"text"},{"type":"codeVoice","code":"key_algorithm"},{"type":"text","text":" field."}],"url":"\/documentation\/axiamsdk\/cacertificate\/keyalgorithm","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/keyAlgorithm","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyAlgorithm","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK12KeyAlgorithmO","text":"KeyAlgorithm","kind":"typeIdentifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/id":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/id","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"url":"\/documentation\/axiamsdk\/cacertificate\/id","type":"topic","abstract":[{"text":"The server’s ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" field.","type":"text"}],"role":"symbol","title":"id"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/tenantID":{"type":"topic","url":"\/documentation\/axiamsdk\/cacertificate\/tenantid","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"abstract":[{"text":"The tenant this CA signs for, when it is a tenant signing CA. ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" for an","type":"text"},{"text":" ","type":"text"},{"text":"organization-level CA — the trust anchor, and the only kind that existed before tenant","type":"text"},{"type":"text","text":" "},{"type":"text","text":"signing CAs. "},{"code":"Some","type":"codeVoice"},{"type":"text","text":" for an intermediate created under one, which exists so a tenant’s"},{"type":"text","text":" "},{"type":"text","text":"user, service and device certificates chain through a CA that can be revoked and"},{"type":"text","text":" "},{"type":"text","text":"replaced without touching the anchor the rest of the estate trusts."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/tenantID","role":"symbol","title":"tenantID","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/mtlsTrustAnchor":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/mtlsTrustAnchor","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mtlsTrustAnchor","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/axiamsdk\/cacertificate\/mtlstrustanchor","type":"topic","abstract":[{"text":"Whether this CA is offered as a trust anchor for mutual TLS. When set, the server","type":"text"},{"text":" ","type":"text"},{"text":"exports this CA’s ","type":"text"},{"inlineContent":[{"text":"public","type":"text"}],"type":"strong"},{"type":"text","text":" certificate to the bundle named by"},{"type":"text","text":" "},{"code":"AXIAM__SERVER__TLS__CLIENT_CA_BUNDLE_PATH","type":"codeVoice"},{"type":"text","text":" at startup and turns client-certificate"},{"type":"text","text":" "},{"type":"text","text":"authentication on ("},{"code":"optional","type":"codeVoice"},{"type":"text","text":") if the operator has not configured it explicitly. A"},{"type":"text","text":" "},{"type":"text","text":"client presenting a certificate that chains to this CA is then verified by the TLS layer"},{"type":"text","text":" "},{"type":"text","text":"itself, which is what "},{"code":"axiam_pki::mtls","type":"codeVoice"},{"type":"text","text":" needs to authenticate an IoT device or a service"},{"type":"text","text":" "},{"type":"text","text":"account by certificate rather than by secret. # What is and is not copied Only"},{"type":"text","text":" "},{"code":"public_cert_pem","type":"codeVoice"},{"type":"text","text":" — the certificate. The "},{"inlineContent":[{"type":"text","text":"private key stays where its custodian put"},{"type":"text","text":" "},{"type":"text","text":"it"}],"type":"strong"},{"type":"text","text":" (Vault, or sealed into the row) and is never written to the server volume. A trust"},{"type":"text","text":" "},{"type":"text","text":"anchor is public by construction: it is what the server hands every client during the"},{"type":"text","text":" "},{"type":"text","text":"TLS handshake, and every device that has to validate the chain already holds a copy. #"},{"type":"text","text":" "},{"type":"text","text":"Why a restart rustls builds its "},{"type":"codeVoice","code":"RootCertStore"},{"type":"text","text":" once, when the listener is constructed,"},{"type":"text","text":" "},{"type":"text","text":"and actix-web binds that config for the process’s life. Toggling this changes what the"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"next"}]},{"type":"text","text":" boot trusts, and the API says so in its response rather than pretending the"},{"type":"text","text":" "},{"type":"text","text":"change took effect. Defaults to "},{"type":"codeVoice","code":"false"},{"type":"text","text":", so a deployment that never touches this keeps"},{"type":"text","text":" "},{"type":"text","text":"exactly the TLS posture it has today."}],"role":"symbol","title":"mtlsTrustAnchor"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/fingerprint":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/fingerprint","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"fingerprint","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"url":"\/documentation\/axiamsdk\/cacertificate\/fingerprint","type":"topic","abstract":[{"text":"SHA-256 fingerprint of the certificate.","type":"text"}],"role":"symbol","title":"fingerprint"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/organizationID":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/organizationID","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"organizationID","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"url":"\/documentation\/axiamsdk\/cacertificate\/organizationid","type":"topic","abstract":[{"text":"The organization this CA belongs to.","type":"text"}],"role":"symbol","title":"organizationID"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/in