,"text":"The issuers above ["},{"type":"codeVoice","code":"Self::public_cert_pem"},{"type":"text","text":"], concatenated PEM, nearest issuer first and"},{"text":" ","type":"text"},{"text":"the root last. ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" for a CA that is its own root, which is every CA AXIAM generated","type":"text"},{"text":" ","type":"text"},{"text":"before Vault’s PKI engine was an option. Present for a ","type":"text"},{"type":"codeVoice","code":"vault_pki"},{"text":" CA, where it is the","type":"text"},{"text":" ","type":"text"},{"text":"only copy of the root certificate anything outside Vault will ever see — a relying party","type":"text"},{"text":" ","type":"text"},{"text":"cannot validate an AXIAM-issued leaf without it, and ","type":"text"},{"type":"codeVoice","code":"root\/generate\/internal"},{"text":" returns it","type":"text"},{"text":" ","type":"text"},{"text":"exactly once.","type":"text"}],"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chainPEM","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/status":{"abstract":[{"text":"The server’s ","type":"text"},{"code":"status","type":"codeVoice"},{"text":" field.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/status","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"status","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CertificateStatus","preciseIdentifier":"s:8AxiamSDK17CertificateStatusO","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/cacertificate\/status","title":"status"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/tenantID":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/tenantID","abstract":[{"text":"The tenant this CA signs for, when it is a tenant signing CA. ","type":"text"},{"code":"None","type":"codeVoice"},{"text":" for an","type":"text"},{"text":" ","type":"text"},{"text":"organization-level CA — the trust anchor, and the only kind that existed before tenant","type":"text"},{"text":" ","type":"text"},{"text":"signing CAs. ","type":"text"},{"type":"codeVoice","code":"Some"},{"text":" for an intermediate created under one, which exists so a tenant’s","type":"text"},{"text":" ","type":"text"},{"text":"user, service and device certificates chain through a CA that can be revoked and","type":"text"},{"text":" ","type":"text"},{"text":"replaced without touching the anchor the rest of the estate trusts.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tenantID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","role":"symbol","title":"tenantID","url":"\/documentation\/axiamsdk\/cacertificate\/tenantid","kind":"symbol"},"doc://AxiamSDK/SE":{"title":"Swift.Encodable","identifier":"doc:\/\/AxiamSDK\/SE","type":"unresolvable"},"doc://AxiamSDK/Se":{"title":"Swift.Decodable","identifier":"doc:\/\/AxiamSDK\/Se","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/publicCertPEM":{"role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/cacertificate\/publiccertpem","title":"publicCertPEM","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/publicCertPEM","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"publicCertPEM","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"type":"topic","abstract":[{"text":"PEM-encoded public certificate. The certificate that ","type":"text"},{"inlineContent":[{"type":"text","text":"signs"}],"type":"emphasis"},{"text":", which under ","type":"text"},{"type":"codeVoice","code":"vault_pki"},{"text":" ","type":"text"},{"text":"custody is the intermediate rather than the root beneath which it was created.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/encode(to:)":{"role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/cacertificate\/encode(to:)","title":"encode(to:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/encode(to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Encoder","preciseIdentifier":"s:s7EncoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"type":"topic","abstract":[]},"doc://AxiamSDK/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/AxiamSDK\/s8SendableP","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate","title":"CaCertificate","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CaCertificate"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CaCertificate"}],"type":"topic","kind":"symbol","abstract":[{"text":"A CA (Certificate Authority) certificate at the organization level. CA certificates are the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"root of trust for all tenant certificates within the organization. Private keys for signing"},{"text":" ","type":"text"},{"text":"CAs are encrypted with AES-256-GCM and stored separately; non-signing CAs only store the","type":"text"},{"type":"text","text":" "},{"text":"public certificate.","type":"text"}],"url":"\/documentation\/axiamsdk\/cacertificate"},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/mtlsTrustAnchor":{"role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/cacertificate\/mtlstrustanchor","title":"mtlsTrustAnchor","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/mtlsTrustAnchor","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mtlsTrustAnchor","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"text":"Whether this CA is offered as a trust anchor for mutual TLS. When set, the server","type":"text"},{"text":" ","type":"text"},{"text":"exports this CA’s ","type":"text"},{"inlineContent":[{"type":"text","text":"public"}],"type":"strong"},{"text":" certificate to the bundle named by","type":"text"},{"text":" ","type":"text"},{"code":"AXIAM__SERVER__TLS__CLIENT_CA_BUNDLE_PATH","type":"codeVoice"},{"text":" at startup and turns client-certificate","type":"text"},{"text":" ","type":"text"},{"text":"authentication on (","type":"text"},{"code":"optional","type":"codeVoice"},{"text":") if the operator has not configured it explicitly. A","type":"text"},{"text":" ","type":"text"},{"text":"client presenting a certificate that chains to this CA is then verified by the TLS layer","type":"text"},{"text":" ","type":"text"},{"text":"itself, which is what ","type":"text"},{"code":"axiam_pki::mtls","type":"codeVoice"},{"text":" needs to authenticate an IoT device or a service","type":"text"},{"text":" ","type":"text"},{"text":"account by certificate rather than by secret. # What is and is not copied Only","type":"text"},{"text":" ","type":"text"},{"code":"public_cert_pem","type":"codeVoice"},{"text":" — the certificate. The ","type":"text"},{"inlineContent":[{"text":"private key stays where its custodian put","type":"text"},{"text":" ","type":"text"},{"text":"it","type":"text"}],"type":"strong"},{"text":" (Vault, or sealed into the row) and is never written to the server volume. A trust","type":"text"},{"text":" ","type":"text"},{"text":"anchor is public by construction: it is what the server hands every client during the","type":"text"},{"text":" ","type":"text"},{"text":"TLS handshake, and every device that has to validate the chain already holds a copy. #","type":"text"},{"text":" ","type":"text"},{"text":"Why a restart rustls builds its ","type":"text"},{"code":"RootCertStore","type":"codeVoice"},{"text":" once, when the listener is constructed,","type":"text"},{"text":" ","type":"text"},{"text":"and actix-web binds that config for the process’s life. Toggling this changes what the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"next","type":"text"}],"type":"emphasis"},{"text":" boot trusts, and the API says so in its response rather than pretending the","type":"text"},{"text":" ","type":"text"},{"text":"change took effect. Defaults to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", so a deployment that never touches this keeps","type":"text"},{"text":" ","type":"text"},{"text":"exactly the TLS posture it has today.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CaCertificate/createdAt":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"createdAt","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CaCertificate\/createdAt","url":"\/documentation\/axiamsdk\/cacertificate\/createdat","abstract":[{"text":"The server’s ","type":"text"},{"code":"created_at","type":"codeVoice"},{"text":" field.","type":"text"}],"kind":"symbol","title":"createdAt","type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSD