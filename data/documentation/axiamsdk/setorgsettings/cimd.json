{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"cimd"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK10CimdPolicyV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy","text":"CimdPolicy"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["Linux"]}]}],"abstract":[{"text":"T21.5 — defaulted, so an API client written before this task lands on ","type":"text"},{"code":"enabled: false","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which is what every deployment did before client ID metadata documents existed (I1).","type":"text"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/setorgsettings\/cimd"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetOrgSettings"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetOrgSettings\/cimd","interfaceLanguage":"swift"},"metadata":{"role":"symbol","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cimd","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CimdPolicy","preciseIdentifier":"s:8AxiamSDK10CimdPolicyV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"modules":[{"name":"AxiamSDK"}],"title":"cimd","externalID":"s:8AxiamSDK14SetOrgSettingsV4cimdAA10CimdPolicyVSgvp"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/SetOrgSettings":{"title":"SetOrgSettings","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SetOrgSettings"}],"url":"\/documentation\/axiamsdk\/setorgsettings","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SetOrgSettings"}],"abstract":[{"type":"text","text":"Input for setting organization-level security settings."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetOrgSettings"},"doc://AxiamSDK/documentation/AxiamSDK/SetOrgSettings/cimd":{"kind":"symbol","abstract":[{"text":"T21.5 — defaulted, so an API client written before this task lands on ","type":"text"},{"code":"enabled: false","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which is what every deployment did before client ID metadata documents existed (I1).","type":"text"}],"url":"\/documentation\/axiamsdk\/setorgsettings\/cimd","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cimd","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK10CimdPolicyV","text":"CimdPolicy","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"cimd","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetOrgSettings\/cimd"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"CimdPolicy"}],"abstract":[{"text":"Whether, and on what terms, a ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" that is a URL is resolved by fetching the document","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it names (T21.5, "},{"type":"codeVoice","code":"draft-ietf-oauth-client-id-metadata-document"},{"type":"text","text":"). # Why this is one nested"},{"type":"text","text":" "},{"type":"text","text":"policy rather than nine fields Every field here is a term of a single decision — "},{"inlineContent":[{"type":"text","text":"do we"},{"type":"text","text":" "},{"type":"text","text":"fetch a stranger’s URL and make a client out of what comes back"}],"type":"emphasis"},{"type":"text","text":" — and none of them means"},{"type":"text","text":" "},{"type":"text","text":"anything without ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"]. A tenant that states a CIMD posture states all of it; a"},{"type":"text","text":" "},{"type":"text","text":"tenant that states none inherits its organization’s whole posture rather than half of one,"},{"type":"text","text":" "},{"type":"text","text":"which is the only merge that cannot produce a combination neither party wrote. # The two"},{"type":"text","text":" "},{"type":"text","text":"fields that can widen, and the seven that cannot ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::allow_http"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"are "},{"inlineContent":[{"type":"text","text":"ordered"}],"type":"strong"},{"type":"text","text":": a tenant may turn either off but never on, exactly as"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"inlineContent":[{"type":"text","text":"this tenant’s"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"domains or "},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"type":"text","text":" bounds, and there is no sense in which one tenant’s list of"},{"type":"text","text":" "},{"type":"text","text":"trusted publishers is stricter than another’s — the same argument ["},{"type":"codeVoice","code":"OidcPolicy"},{"type":"text","text":"] already"},{"type":"text","text":" "},{"type":"text","text":"makes for "},{"type":"codeVoice","code":"dcr_allowed_redirect_hosts"},{"type":"text","text":". # Every bound here is a security control"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::max_metadata_bytes"},{"type":"text","text":"], ["},{"type":"codeVoice","code":"Self::min_cache_secs"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::max_cache_secs"},{"type":"text","text":"] are not"},{"type":"text","text":" "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CimdPolicy"}],"kind":"symbol","title":"CimdPolicy","url":"\/documentation\/axiamsdk\/cimdpolicy","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy"}}}