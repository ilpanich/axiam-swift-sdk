ype":"text"},{"type":"codeVoice","code":"Self::max_cache_secs"},{"text":"] are not","type":"text"},{"text":" ","type":"text"},{"text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the","type":"text"},{"text":" ","type":"text"},{"text":"floor under how often that read may be repeated, and the ceiling on how long its result may","type":"text"},{"text":" ","type":"text"},{"text":"be trusted. Each is clamped again in code against the three constants above, so a settings","type":"text"},{"text":" ","type":"text"},{"text":"row written by hand cannot lift them.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/SetOrgSettings":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetOrgSettings","url":"\/documentation\/axiamsdk\/setorgsettings","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SetOrgSettings","kind":"identifier"}],"navigatorTitle":[{"text":"SetOrgSettings","kind":"identifier"}],"abstract":[{"text":"Input for setting organization-level security settings.","type":"text"}],"kind":"symbol","type":"topic","title":"SetOrgSettings"}}}