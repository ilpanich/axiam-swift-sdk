","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"next"}]},{"type":"text","text":" boot trusts, and the API says so in its response rather than pretending the"},{"type":"text","text":" "},{"type":"text","text":"change took effect. Defaults to "},{"type":"codeVoice","code":"false"},{"type":"text","text":", so a deployment that never touches this keeps"},{"type":"text","text":" "},{"type":"text","text":"exactly the TLS posture it has today."}],"kind":"symbol","role":"symbol","title":"mtlsTrustAnchor"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/chainPEM":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/chainPEM","abstract":[{"type":"text","text":"The issuers above ["},{"type":"codeVoice","code":"Self::public_cert_pem"},{"type":"text","text":"], concatenated PEM, nearest issuer first and"},{"type":"text","text":" "},{"type":"text","text":"the root last. "},{"type":"codeVoice","code":"None"},{"type":"text","text":" for a CA that is its own root, which is every CA AXIAM generated"},{"type":"text","text":" "},{"type":"text","text":"before Vault’s PKI engine was an option. Present for a "},{"code":"vault_pki","type":"codeVoice"},{"type":"text","text":" CA, where it is the"},{"type":"text","text":" "},{"type":"text","text":"only copy of the root certificate anything outside Vault will ever see — a relying party"},{"type":"text","text":" "},{"type":"text","text":"cannot validate an AXIAM-issued leaf without it, and "},{"code":"root\/generate\/internal","type":"codeVoice"},{"type":"text","text":" returns it"},{"type":"text","text":" "},{"type":"text","text":"exactly once."}],"ro