 CA’s common name, e.g. "},{"code":"ACME Corp Root CA","type":"codeVoice"},{"type":"text","text":". The normalised value: a "},{"code":"CN=","type":"codeVoice"},{"type":"text","text":" prefix in"},{"type":"text","text":" "},{"type":"text","text":"the request is understood and stripped, so this always says what the certificate’s"},{"type":"text","text":" "},{"type":"text","text":"subject DN says (DF-023)."}],"title":"subject"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/notBefore":{"abstract":[{"type":"text","text":"Validity start."}],"role":"symbol","title":"notBefore","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/notBefore","kind":"symbol","url":"\/documentation\/axiamsdk\/generatedcacertificate\/notbefore","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"notBefore"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}]},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/init(from:)":{"role":"symbol","url":"\/documentation\/axiamsdk\/generatedcacertificate\/init(from:)","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"title":"init(from:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/init(from:)","abstract":[],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/keyLocator":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyLocator"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"title":"keyLocator","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamS