nID:parentCAID:publicCertPEM:status:subject:tenantID:privateKeyPEM:)","abstract":[],"role":"symbol","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/parentCAID":{"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"parentCAID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/parentCAID","title":"parentCAID","url":"\/documentation\/axiamsdk\/generatedcacertificate\/parentcaid","abstract":[{"text":"The CA in this organization that signed this one. ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" for an organization-level CA,","type":"text"},{"text":" ","type":"text"},{"text":"which is either self-signed or imported and has no parent inside AXIAM.","type":"text"}],"role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/mtlsTrustAnchor":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/mtlsTrustAnchor","url":"\/documentation\/axiamsdk\/generatedcacertificate\/mtlstrustanchor","type":"topic","title":"mtlsTrustAnchor","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mtlsTrustAnchor","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"abstract":[{"text":"Whether this CA is offered as a trust anchor for mutual TLS. When set, the server","type":"text"},{"text":" ","type":"text"},{"text":"exports this CA’s ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"public"}]},{"text":" certificate to the bundle named by","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AXIAM__SERVER__TLS__CLIENT_CA_BUNDLE_PATH"},{"text":" at startup and turns client-certificate","type":"text"},{"text":" ","type":"text"},{"text":"authentication on (","type":"text"},{"type":"codeVoice","code":"optional"},{"text":") if the operator has not configured it explicitly. A","type":"text"},{"text":" ","type":"text"},{"text":"client presenting a certificate that chains to this CA is then verified by the TLS layer","type":"text"},{"text":" ","type":"text"},{"text":"itself, which is what ","type":"text"},{"type":"codeVoice","code":"axiam_pki::mtls"},{"text":" needs to authenticate an IoT device or a service","type":"text"},{"text":" ","type":"text"},{"text":"account by certificate rather than by secret. # What is and is not copied Only","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"public_cert_pem"},{"text":" — the certificate. The ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"private key stays where its custodian put"},{"type":"text","text":" "},{"type":"text","text":"it"}]},{"text":" (Vault, or sealed into the row) and is never written to the server volume. A trust","type":"text"},{"text":" ","type":"text"},{"text":"anchor is public by construction: it is what the server hands every client during the","type":"text"},{"text":" ","type":"text"},{"text":"TLS handshake, and every device that has to validate the chain already holds a copy. #","type":"text"},{"text":" ","type":"text"},{"text":"Why a restart rustls builds its ","type":"text"},{"type":"codeVoice","code":"RootCertStore"},{"text":" once, when the listener is constructed,","type":"text"},{"text":" ","type":"text"},{"text":"and actix-web binds that config for the process’s life. Toggling this changes what the","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"next"}]},{"text":" boot trusts, and the API says so in its response rather than pretending the","type":"text"},{"text":" ","type":"text"},{"text":"change took effect. Defaults to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", so a deployment that never touches this keeps","type":"text"},{"text":" ","type":"text"},{"text":"exactly the TLS posture it has today.","type":"text"}],"role":"symbol","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/keyAlgorithm":{"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyAlgorithm"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"KeyAlgorithm","preciseIdentifier":"s:8AxiamSDK12KeyAlgorithmO"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/keyAlgorithm","title":"keyAlgorithm","url":"\/documentation\/axiamsdk\/generatedcacertificate\/keyalgorithm","abstract":[{"text":"The server’s ","type":"text"},{"type":"codeVoice","code":"key_algorithm"},{"text":" field.","type":"text"}],"role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/keyLocator":{"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyLocator"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/keyLocator","title":"keyLocator","url":"\/documentation\/axiamsdk\/generatedcacertificate\/keylocator","abstract":[{"text":"Where the custodian put the key. A Vault path under its mount; ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" for database","type":"text"},{"text":" ","type":"text"},{"text":"custody, whose locator is the row itself.","type":"text"}],"role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/privateKeyPEM":{"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"privateKeyPEM"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier","text":"Sensitive"},{"kind":