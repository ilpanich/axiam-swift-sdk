usual PKCS#8 "},{"type":"codeVoice","code":"RSAPrivateKey"},{"type":"text","text":". Absent under "},{"type":"codeVoice","code":"vault_pki"},{"type":"text","text":" "},{"type":"text","text":"custody, where the key was generated inside Vault and no API exports it. The field is"},{"type":"text","text":" "},{"type":"text","text":"omitted rather than sent as "},{"type":"codeVoice","code":"null"},{"type":"text","text":" so a client that has always read it keeps working"},{"type":"text","text":" "},{"type":"text","text":"unchanged for every custodian that does produce a key."}]},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/subject":{"url":"\/documentation\/axiamsdk\/generatedcacertificate\/subject","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/subject","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subject","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"title":"subject","abstract":[{"text":"The CA’s common name, e.g. ","type":"text"},{"code":"ACME Corp Root CA","type":"codeVoice"},{"text":". The normalised value: a ","type":"text"},{"code":"CN=","type":"codeVoice"},{"text":" prefix in","type":"text"},{"text":" ","type":"text"},{"text":"the request is understood and stripped, so this always says what the certificate’s","type":"text"},{"text":" ","type":"text"},{"text":"subject DN says (DF-023).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/keyLocator":{"url":"\/documentation\/axiamsdk\/generatedcacertificate\/keylocator","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/keyLocator","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyLocator","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"keyLocator","abstract":[{"text":"Where the custodian put the key. A Vault path under its mount; ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" for database","type":"text"},{"text":" ","type":"text"},{"text":"custody, whose locator is the row itself.","type":"text"}]},"doc://AxiamSDK/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/s8SendableP","title":"Swift.Sendable"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/fingerprint":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/fingerprint","abstract":[{"text":"SHA-256 fingerprint of the certificate.","type":"text"}],"title":"fingerprint","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"fingerprint"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"url":"\/documentation\/axiamsdk\/generatedcacertificate\/fingerprint","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/keyCustody":{"url":"\/documentation\/axiamsdk\/generatedcacertificate\/keycustody","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/keyCustody","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyCustody","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"keyCustody","abstract":[{"text":"Which custodian holds this CA’s signing key. Recorded per CA rather than read from","type":"text"},{"text":" ","type":"text"},{"text":"configuration, so adopting a new custodian does not strand the CAs that already exist.","type":"text"},{"text":" ","type":"text"},{"text":"Not secret — an operator needs to see it, and it discloses only where a key is kept.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/publicCertPEM":{"url":"\/documentation\/axiamsdk\/generatedcacertificate\/publiccertpem","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/publicCertPEM","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"publicCertPEM","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"title":"publicCertPEM","abstract":[{"text":"PEM-encoded public certificate. The certificate that ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"signs","type":"text"}]},{"text":", which under ","type":"text"},{"type":"codeVoice","code":"vault_pki"},{"text":" ","type":"text"},{"text":"custody is the intermediate rather than the root beneath which it was created.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/tenantID":{"title":"tenantID","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/tenantID","abstract":[{"text":"The tenant this CA signs for, when it is a tenant signing CA. ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" for an","type":"text"},{"text":" ","type":"text"},{"text":"organization-level CA — the trust anchor, and the only kind that existed before tenant","type":"text"},{"text":" ","type":"text"},{"text":"signing CAs. ","type":"text"},{"type":"codeVoice","code":"Some"},{"text":" for an intermediate created under one, which exists so a tenant’s","type":"text"},{"text":" ","type":"text"},{"text":"user, service and device certificates chain through a CA that can be revoked and","type":"text"},{"text":" ","type":"text"},{"text":"replaced without touching the anchor the rest of the estate trusts.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/axiamsdk\/generatedcacertificate\/tenantid","kind":"symbol","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/keyAlgorithm":{"url":"\/documentation\/axiamsdk\/generatedcacertificate\/keyalgorithm","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/keyAlgorithm","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyAlgorithm","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK12KeyAlgorithmO","text":"KeyAlgorithm","kind":"typeIdentifier"}],"title":"keyAlgorithm","abstract":[{"text":"The server’s ","type":"text"},{"type":"codeVoice","code":"key_algorithm"},{"text":" field.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/encode(to:)":{"url":"\/documentation\/axiamsdk\/generatedcacertificate\/encode(to:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/encode(to:)","abstract":[],"role":"symbol","kind":"symbol","title":"encode(to:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"encode"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7EncoderP","kind":"typeIdentifier","text":"Encoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}]},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/status":{"url":"\/documentation\/axiamsdk\/generatedcacertificate\/status","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/status","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"status","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK17CertificateStatusO","text":"CertificateStatus","kind":"typeIdentifier"}],"title":"status","abstract":[{"text":"The server’s ","type":"text"},{"type":"codeVoice","code":"status"},{"text":" field.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/mtlsTrustAnchor":{"url":"\/documentation\/axiamsdk\/generatedcacertificate\/mtlstrustanchor","type":"topic","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mtlsTrustAnchor","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/mtlsTrustAnchor","abstract":[{"text":"Whether this CA is offered as a trust anchor for mutual TLS. When set, the server","type":"text"},{"text":" ","type":"text"},{"text":"exports this CA’s ","type":"text"},{"inlineContent":[{"text":"public","type":"text"}],"type":"strong"},{"text":" certificate to the bundle named by","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AXIAM__SERVER__TLS__CLIENT_CA_BUNDLE_PATH"},{"text":" at startup and turns client-certificate","type":"text"},{"text":" ","type":"text"},{"text":"authentication on (","type":"text"},{"type":"codeVoice","code":"optional"},{"text":") if the operator has not configured it explicitly. A","type":"text"},{"text":" ","type":"text"},{"text":"client presenting a certificate that chains to this CA is then verified by the TLS layer","type":"text"},{"text":" ","type":"text"},{"text":"itself, which is what ","type":"text"},{"code":"axiam_pki::mtls","type":"codeVoice"},{"text":" needs to authenticate an IoT device or a service","type":"text"},{"text":" ","type":"text"},{"text":"account by certificate rather than by secret. # What is and is not copied Only","type":"text"},{"text":" ","type":"text"},{"code":"public_cert_pem","type":"codeVoice"},{"text":" — the certificate. The ","type":"text"},{"type":"strong","inlineContent":[{"text":"private key stays where its custodian put","type":"text"},{"text":" ","type":"text"},{"text":"it","type":"text"}]},{"text":" (Vault, or sealed into the row) and is never written to the server volume. A trust","type":"text"},{"text":" ","type":"text"},{"text":"anchor is public by construction: it is what the server hands every client during the","type":"text"},{"text":" ","type":"text"},{"text":"TLS handshake, and every device that has to validate the chain already holds a copy. #","type":"text"},{"text":" ","type":"text"},{"text":"Why a restart rustls builds its ","type":"text"},{"code":"RootCertStore","type":"codeVoice"},{"text":" once, when the listener is constructed,","type":"text"},{"text":" ","type":"text"},{"text":"and actix-web binds that config for the process’s life. Toggling this changes what the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"next","type":"text"}],"type":"emphasis"},{"text":" boot trusts, and the API says so in its response rather than pretending the","type":"text"},{"text":" ","type":"text"},{"text":"change took effect. Defaults to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", so a deployment that never touches this keeps","type":"text"},{"text":" ","type":"text"},{"text":"exactly the TLS posture it has today.","type":"text"}],"role":"symbol","title":"mtlsTrustAnchor"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/createdAt":{"url":"\/documentation\/axiamsdk\/generatedcacertificate\/createdat","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/createdAt","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"createdAt","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"title":"createdAt","abstract":[{"text":"The server’s ","type":"text"},{"type":"codeVoice","code":"created_at"},{"text":" field.","type":"text"}]}}}