pe":"text","text":" CA, where it is the"},{"type":"text","text":" "},{"text":"only copy of the root certificate anything outside Vault will ever see — a relying party","type":"text"},{"text":" ","type":"text"},{"text":"cannot validate an AXIAM-issued leaf without it, and ","type":"text"},{"code":"root\/generate\/internal","type":"codeVoice"},{"text":" returns it","type":"text"},{"text":" ","type":"text"},{"text":"exactly once.","type":"text"}],"title":"chainPEM","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chainPEM","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GeneratedCaCertificate"}],"abstract":[{"type":"text","text":"Response returned when a CA certificate is generated. Includes the private key PEM, which is"},{"type":"text","text":" "},{"type":"text","text":"returned "},{"inlineContent":[{"text":"once","type":"text"}],"type":"strong"},{"type":"text","text":" and never stored or retrievable again — when the custodian produced one at"},{"type":"text","text":" "},{"type":"text","text":"all. Under "},{"code":"vault_pki","type":"codeVoice"},{"type":"text","text":" custody the key was born inside Vault and there is nothing to return,"},{"type":"text","text":" "},{"type":"text","text":"which is the point of that custodian rather than a shortcoming of this response."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate","type":"topic","title":"GeneratedCaCertificate","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GeneratedCaCertificate"}],"url":"\/documentation\/axiamsdk\/generatedcacertificate"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/tenantID":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"tenantID","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The tenant this CA signs for, when it is a tenant signing CA. "},{"code":"None","type":"codeVoice"},{"type":"text","text":" for an"},{"type":"text","text":" "},{"type":"text","text":"organization-level CA — the trust anchor, and the only kind that existed before tenant"},{"text":" ","type":"text"},{"type":"text","text":"signing CAs. "},{"code":"Some","type":"codeVoice"},{"text":" for an intermediate created under one, which exists so a tenant’s","type":"text"},{"text":" ","type":"text"},{"text":"user, service and device certificates chain through a CA that can be revoked and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"replaced without touching the anchor the rest of the estate trusts."}],"title":"tenantID","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/tenantID","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/generatedcacertificate\/tenantid"},"doc://AxiamSDK/Se":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/Se","title":"Swift.Decodable"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/mtlsTrustAnchor":{"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/generatedcacertificate\/mtlstrustanchor","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"mtlsTrustAnchor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"Whether this CA is offered as a trust anchor for mutual TLS. When set, the server"},{"type":"text","text":" "},{"type":"text","text":"exports this CA’s "},{"inlineContent":[{"type":"text","text":"public"}],"type":"strong"},{"type":"text","text":" certificate to the bundle named by"},{"type":"text","text":" "},{"type":"codeVoice","code":"AXIAM__SERVER__TLS__CLIENT_CA_BUNDLE_PATH"},{"type":"text","text":" at startup and turns client-certificate"},{"type":"text","text":" "},{"type":"text","text":"authentication on ("},{"type":"codeVoice","code":"optional"},{"type":"text","text":") if the operator has not configured it explicitly. A"},{"type":"text","text":" "},{"type":"text","text":"client presenting a certificate that chains to this CA is then verified by the TLS layer"},{"type":"text","text":" "},{"type":"text","text":"itself, which is what "},{"type":"codeVoice","code":"axiam_pki::mtls"},{"type":"text","text":" needs to authenticate an IoT device or a service"},{"type":"text","text":" "},{"type":"text","text":"account by certificate rather than by secret. # What is and is not copied Only"},{"type":"text","text":" "},{"type":"codeVoice","code":"public_cert_pem"},{"type":"text","text":" — the certificate. The "},{"inlineContent":[{"type":"text","text":"private key stays where its custodian put"},{"type":"text","text":" "},{"type":"text","text":"it"}],"type":"strong"},{"type":"text","text":" (Vault, or sealed into the row) and is never written to the server volume. A trust"},{"type":"text","text":" "},{"type":"text","text":"anchor is public by construction: it is what the server hands every client during the"},{"type":"text","text":" "},{"type":"text","text":"TLS handshake, and every device that has to validate the chain already holds a copy. #"},{"type":"text","text":" "},{"type":"text","text":"Why a restart rustls builds its "},{"type":"codeVoice","code":"RootCertStore"},{"type":"text","text":" once, when the listener is constructed,"},{"type":"text","text":" "},{"type":"text","text":"and actix-web binds that config for the process’s life. Toggling this changes what the"},{"type":"text","text":" "},{"inlineContent":[{"text":"next","type":"text"}],"type":"emphasis"},{"type":"text","text":