rd"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The server’s "},{"type":"codeVoice","code":"id"},{"type":"text","text":" field."}],"title":"id","kind":"symbol","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/tenantID":{"abstract":[{"type":"text","text":"The tenant this CA signs for, when it is a tenant signing CA. "},{"type":"codeVoice","code":"None"},{"type":"text","text":" for an"},{"type":"text","text":" "},{"type":"text","text":"organization-level CA — the trust anchor, and the only kind that existed before tenant"},{"type":"text","text":" "},{"type":"text","text":"signing CAs. "},{"type":"codeVoice","code":"Some"},{"type":"text","text":" for an intermediate created under one, which exists so a tenant’s"},{"type":"text","text":" "},{"type":"text","text":"user, service and device certificates chain through a CA that can be revoked and"},{"type":"text","text":" "},{"type":"text","text":"replaced without touching the anchor the rest of the estate trusts."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/tenantID","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tenantID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","title":"tenantID","url":"\/documentation\/axiamsdk\/generatedcacertificate\/tenantid","type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/parentCAID":{"title":"parentCAID","abstract":[{"text":"The CA in this organization that signed this one. ","type":"text"},{"code":"None","type":"codeVoice"},{"text":" for an organization-level CA,","type":"text"},{"text":" ","type":"text"},{"text":"which is either self-signed or imported and has no parent inside AXIAM.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"parentCAID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/parentCAID","kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/generatedcacertificate\/parentcaid","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/privateKeyPEM":{"type":"topic","abstract":[{"text":"PEM-encoded private key — returned only on generation, and only when there is one to","type":"text"},{"text":" ","type":"text"},{"text":"return. Absent under ","type":"text"},{"code":"vault_pki","type":"codeVoice"},{"text":" custody, where the key was generated inside Vault and","type":"text"},{"text":" ","type":"text"},{"text":"no API exports it. The field is omitted rather than sent as ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" so a client that has","type":"text"},{"text":" ","type":"text"},{"text":"always read it keeps working unchanged for every custodian that does produce a key.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"privateKeyPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV","text":"Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">?"}],"url":"\/documentation\/axiamsdk\/generatedcacertificate\/privatekeypem","title":"privateKeyPEM","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/privateKeyPEM"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/encode(to:)":{"abstract":[],"url":"\/documentation\/axiamsdk\/generatedcacertificate\/encode(to:)","title":"encode(to:)","role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"encode"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Encoder","preciseIdentifier":"s:s7EncoderP"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/encode(to:)"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/notAfter":{"abstract":[{"text":"Validity end.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/notAfter","title":"notAfter","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notAfter","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"url":"\/documentation\/axiamsdk\/generatedcacertificate\/notafter"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/organizationID":{"title":"organizationID","kind":"symbol","abstract":[{"text":"The organization this CA belongs to.","type":"text"}],"role":"symbol","url":"\/documentation\/axiamsdk\/generatedcacertificate\/organizationid","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/organizationID","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/keyCustody":{"title":"keyCustody","kind":"symbol","abstract":[{"text":"Which custodian holds this CA’s signing key. Recorded per CA rather than read from","type":"text"},{"text":" ","type":"text"},{"text":"configuration, so adopting a new custodian does not strand the CAs that already exist.","type":"text"},{"text":" ","type":"text"},{"text":"Not secret — an operator needs to see it, and it discloses only where a key is kept.","type":"text"}],"role":"symbol","url":"\/documentation\/axiamsdk\/generatedcacertificate\/keycustody","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyCustody","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/keyCustody","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/publicCertPEM":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/publicCertPEM","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"publicCertPEM","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"abstract":[{"text":"PEM-encoded public certificate. The certificate that ","type":"text"},{"inlineContent":[{"type":"text","text":"signs"}],"type":"emphasis"},{"text":", which under ","type":"text"},{"code":"vault_pki","type":"codeVoice"},{"text":" ","type":"text"},{"text":"custody is the intermediate rather than the root beneath which it was created.","type":"text"}],"title":"publicCertPEM","kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/generatedcacertificate\/publiccertpem"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/mtlsTrustAnchor":{"type":"topic","url":"\/documentation\/axiamsdk\/generatedcacertificate\/mtlstrustanchor","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/mtlsTrustAnchor","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"mtlsTrustAnchor"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"abstract":[{"text":"Whether this CA is offered as a trust anchor for mutual TLS. When set, the server","type":"text"},{"text":" ","type":"text"},{"text":"exports this CA’s ","type":"text"},{"inlineContent":[{"text":"public","type":"text"}],"type":"strong"},{"text":" certificate to the bundle named by","type":"text"},{"text":" ","type":"text"},{"code":"AXIAM__SERVER__TLS__CLIENT_CA_BUNDLE_PATH","type":"codeVoice"},{"text":" at startup and turns client-certificate","type":"text"},{"text":" ","type":"text"},{"text":"authentication on (","type":"text"},{"code":"optional","type":"codeVoice"},{"text":") if the operator has not configured it explicitly. A","type":"text"},{"text":" ","type":"text"},{"text":"client presenting a certificate that chains to this CA is then verified by the TLS layer","type":"text"},{"text":" ","type":"text"},{"text":"itself, which is what ","type":"text"},{"code":"axiam_pki::mtls","type":"codeVoice"},{"text":" needs to authenticate an IoT device or a service","type":"text"},{"text":" ","type":"text"},{"text":"account by certificate rather than by secret. # What is and is not copied Only","type":"text"},{"text":" ","type":"text"},{"code":"public_cert_pem","type":"codeVoice"},{"text":" — the certificate. The ","type":"text"},{"inlineContent":[{"text":"private key stays where its custodian put","type":"text"},{"text":" ","type":"text"},{"text":"it","type":"text"}],"type":"strong"},{"text":" (Vault, or sealed into the row) and is never written to the server volume. A trust","type":"text"},{"text":" ","type":"text"},{"text":"anchor is public by construction: it is what the server hands every client during the","type":"text"},{"text":" ","type":"text"},{"text":"TLS handshake, and every device that has to validate the chain already holds a copy. #","type":"text"},{"text":" ","type":"text"},{"text":"Why a restart rustls builds its ","type":"text"},{"code":"RootCertStore","type":"codeVoice"},{"text":" once, when the listener is constructed,","type":"text"},{"text":" ","type":"text"},{"text":"and actix-web binds that config for the process’s life. Toggling this changes what the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"next"}],"type":"emphasis"},{"text":" boot trusts, and the API says so in its response rather than pretending the","type":"text"},{"text":" ","type":"text"},{"text":"change took effect. Defaults to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", so a deployment that never touches this keeps","type":"text"},{"text":" ","type":"text"},{"text":"exactly the TLS posture it has today.","type":"text"}],"title":"mtlsTrustAnchor","kind":"symbol","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","title":"AxiamSDK","role":"collection","kind":"symbol","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/SE":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/SE","title":"Swift.Encodable"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/fingerprint":{"title":"fingerprint","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/fingerprint","url":"\/documentation\/axiamsdk\/generatedcacertificate\/fingerprint","abstract":[{"text":"SHA-256 fingerprint of the certificate.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fingerprint","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/createdAt":{"type":"topic","url":"\/documentation\/axiamsdk\/generatedcacertificate\/createdat","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/createdAt","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"createdAt"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"abstract":[{"text":"The server’s ","type":"text"},{"code":"created_at","type":"codeVoice"},{"text":" field.","type":"text"}],"title":"createdAt","kind":"symbol","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/chainPEM":{"title":"chainPEM","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chainPEM","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","url":"\/documentation\/axiamsdk\/generatedcacertificate\/chainpem","abstract":[{"type":"text","text":"The issuers above ["},{"type":"codeVoice","code":"Self::public_cert_pem"},{"type":"text","text":"], concatenated PEM, nearest issuer first and"},{"type":"text","text":" "},{"type":"text","text":"the root last. "},{"type":"codeVoice","code":"None"},{"type":"text","text":" for a CA that is its own root, which is every CA AXIAM generated"},{"type":"text","text":" "},{"type":"text","text":"before Vault’s PKI engine was an option. Present for a "},{"type":"codeVoice","code":"vault_pki"},{"type":"text","text":" CA, where it is the"},{"type":"text","text":" "},{"type":"text","text":"only copy of the root certificate anything outside Vault will ever see — a relying party"},{"type":"text","text":" "},{"type":"text","text":"cannot validate an AXIAM-issued leaf without it, and "},{"type":"codeVoice","code":"root\/generate\/internal"},{"type":"text","text":" returns it"},{"type":"text","text":" "},{"type":"text","text":"exactly once."}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/chainPEM"}}}