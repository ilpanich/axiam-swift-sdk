r CA rather than read from"},{"type":"text","text":" "},{"type":"text","text":"configuration, so adopting a new custodian does not strand the CAs that already exist."},{"type":"text","text":" "},{"type":"text","text":"Not secret — an operator needs to see it, and it discloses only where a key is kept."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/keyCustody","title":"keyCustody","role":"symbol","type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/subject":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"subject"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"url":"\/documentation\/axiamsdk\/generatedcacertificate\/subject","abstract":[{"type":"text","text":"The certificate subject (e.g., "},{"type":"codeVoice","code":"CN=ACME Corp Root CA"},{"type":"text","text":")."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GeneratedCaCertificate\/subject","title":"subject","role":"symbol","type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GeneratedCaCertificate/mtlsTrustAnchor":{"url":"\/documentation\/axiamsdk\/generatedcacertificate\/mtlstrustanchor","type":"topic","title":"mtlsTrustAnchor","kind":"symbol","role":"symbol","abstract":[{"text":"Whether this CA is offered as a trust anchor for mutual TLS. When set, the server","type":"text"},{"text":" ","type":"text"},{"text":"exports this CA’s ","type":"text"},{"inlineContent":[{"type":"text","text":"public"}],"type":"strong"},{"text":" certificate to the bundle named by","type":"text"},{"text":" ","type":"text"},{"code":"AXIAM__SERVER__TLS__CLIENT_CA_BUNDLE_PATH","type":"codeVoice"},{"text":" at startup and turns client-certificate","type":"text"},{"text":" ","type":"text"},{"text":"authentication on (","type":"text"},{"code":"optional","type":"codeVoice"},{"text":") if the operator has not configured it explici