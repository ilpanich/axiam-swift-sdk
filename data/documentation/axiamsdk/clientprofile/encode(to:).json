 ","type":"text"},{"identifier":"Self::Standard","isActive":true,"type":"reference"},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}]},"Self::Standard":{"type":"link","title":"Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"url":"Self::Standard","identifier":"Self::Standard"}}}