ow"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"title":"ClientProfile","type":"topic","url":"\/documentation\/axiamsdk\/clientprofile"},"Self::Standard":{"identifier":"Self::Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"title":"Standard","type":"link","url":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/encode(to:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/encode(to:)","abstract":[{"type":"text","text":"Refuses "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":": a value this SDK could not name is never sent."}],"kind":"symbol","title":"encode(to:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"encode"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7EncoderP","text":"Encoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"url":"\/documentation\/axiamsdk\/clientprofile\/encode(to:)"}}}