pe":"text"}]},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"kind":"symbol","type":"topic","title":"ClientProfile"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"Self::Standard":{"title":"Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"url":"Self::Standard","type":"link","identifier":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/fapi2":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fapi2","kind":"identifier"}],"abstract":[],"title":"ClientProfile.fapi2","role":"symbol","url":"\/documentation\/axiamsdk\/clientprofile\/fapi2","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/fapi2","kind":"symbol"}}}