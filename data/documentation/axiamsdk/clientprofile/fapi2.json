{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fapi2","kind":"identifier"}],"languages":["swift"]}]}],"sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/fapi2","interfaceLanguage":"swift"},"metadata":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fapi2","kind":"identifier"}],"roleHeading":"Case","title":"ClientProfile.fapi2","symbolKind":"case","role":"symbol","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK13ClientProfileO5fapi2yA2CmF"},"variants":[{"paths":["\/documentation\/axiamsdk\/clientprofile\/fapi2"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/fapi2":{"role":"symbol","url":"\/documentation\/axiamsdk\/clientprofile\/fapi2","type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/fapi2","title":"ClientProfile.fapi2","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fapi2","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","title":"ClientProfile","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}],"role":"symbol","url":"\/documentation\/axiamsdk\/clientprofile","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"S256","type":"codeVoice"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"nearly","type":"text"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","isActive":true,"type":"reference"},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}]},"Self::Standard":{"titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"type":"link","identifier":"Self::Standard","url":"Self::Standard","title":"Standard"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]}}}