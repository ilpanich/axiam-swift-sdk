{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/clientprofile\/fapi2"]}],"metadata":{"symbolKind":"case","modules":[{"name":"AxiamSDK"}],"role":"symbol","externalID":"s:8AxiamSDK13ClientProfileO5fapi2yA2CmF","roleHeading":"Case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"fapi2"}],"title":"ClientProfile.fapi2"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fapi2","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/fapi2"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"url":"\/documentation\/axiamsdk\/clientprofile","kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"type":"text","text":", mandatory strong client authentication, mandatory sender-constrained tokens,"},{"type":"text","text":" "},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"text":"written before schema v38 decodes to it.","type":"text"}],"title":"ClientProfile","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}]},"Self::Standard":{"type":"link","url":"Self::Standard","identifier":"Self::Standard","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"title":"Standard"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/fapi2":{"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/clientprofile\/fapi2","abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/fapi2","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"fapi2"}],"title":"ClientProfile.fapi2"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"}}}