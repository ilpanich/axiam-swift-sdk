{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/clientprofile\/fapi2"]}],"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"fapi2"}],"title":"ClientProfile.fapi2","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK13ClientProfileO5fapi2yA2CmF","symbolKind":"case","roleHeading":"Case"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fapi2","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/fapi2"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/fapi2":{"abstract":[],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"fapi2"}],"title":"ClientProfile.fapi2","url":"\/documentation\/axiamsdk\/clientprofile\/fapi2","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/fapi2"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"Self::Standard":{"url":"Self::Standard","type":"link","title":"Standard","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"identifier":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"url":"\/documentation\/axiamsdk\/clientprofile","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"type":"topic","title":"ClientProfile","role":"symbol","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"S256","type":"codeVoice"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"nearly"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","isActive":true,"type":"reference"},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}]}}}