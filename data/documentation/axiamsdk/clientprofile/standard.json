"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"text":" ","type":"text"},{"inlineContent":[{"text":"nearly","type":"text"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"type":"topic","title":"ClientProfile","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/clientprofile","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"},"Self::Standard":{"titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"url":"Self::Standard","title":"Standard","identifier":"Self::Standard","type":"link"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/standard":{"url":"\/documentation\/axiamsdk\/clientprofile\/standard","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"standard","kind":"identifier"}],"abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/standard","role":"symbol","title":"ClientProfile.standard"}}}