e":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"kind":"symbol","type":"topic","title":"ClientProfile"},"Self::Standard":{"url":"Self::Standard","identifier":"Self::Standard","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"title":"Standard","type":"link"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/standard":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/standard","type":"topic","abstract":[],"role":"symbol","title":"ClientProfile.standard","url":"\/documentation\/axiamsdk\/clientprofile\/standard","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"standard","kind":"identifier"}]}}}