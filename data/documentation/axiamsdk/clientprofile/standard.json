{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/clientprofile\/standard"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"standard"}],"platforms":["Linux"]}]}],"kind":"symbol","metadata":{"role":"symbol","title":"ClientProfile.standard","symbolKind":"case","modules":[{"name":"AxiamSDK"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"standard"}],"roleHeading":"Case","externalID":"s:8AxiamSDK13ClientProfileO8standardyA2CmF"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/standard","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}],"url":"\/documentation\/axiamsdk\/clientprofile","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"S256","type":"codeVoice"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"nearly"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"change at all, because "},{"isActive":true,"identifier":"Self::Standard","type":"reference"},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","title":"ClientProfile","role":"symbol","kind":"symbol","type":"topic"},"Self::Standard":{"title":"Standard","url":"Self::Standard","identifier":"Self::Standard","type":"link","titleInlineContent":[{"code":"Standard","type":"codeVoice"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","role":"collection","type":"topic","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/standard":{"kind":"symbol","url":"\/documentation\/axiamsdk\/clientprofile\/standard","role":"symbol","type":"topic","title":"ClientProfile.standard","abstract":[],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"standard","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/standard"}}}