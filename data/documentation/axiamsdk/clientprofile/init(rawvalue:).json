d tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"url":"\/documentation\/axiamsdk\/clientprofile","title":"ClientProfile","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}],"role":"symbol"},"Self::Standard":{"title":"Standard","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"url":"Self::Standard","identifier":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/init(rawValue:)":{"title":"init(rawValue:)","url":"\/documentation\/axiamsdk\/clientprofile\/init(rawvalue:)","fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"rawValue","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","abstract":[],"role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/init(rawValue:)"},"doc://AxiamSDK/documentation/Axiam