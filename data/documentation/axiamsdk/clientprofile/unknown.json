},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"type":"topic","title":"ClientProfile","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/clientprofile","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"},"Self::Standard":{"titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"identifier":"Self::Standard","type":"link","url":"Self::Standard","title":"Standard"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/unknown":{"title":"ClientProfile.unknown","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/unknown","abstract":[{"text":"A value this SDK’s copy of the spec does not list; see the type’s summary.","type":"text"}],"role":"symbol","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknown","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/clientprofile\/unknown"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","title":"AxiamSDK","role":"collection","kind":"symbol","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}