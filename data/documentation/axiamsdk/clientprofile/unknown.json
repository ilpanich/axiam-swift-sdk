{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/unknown","interfaceLanguage":"swift"},"metadata":{"role":"symbol","symbolKind":"case","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknown","kind":"identifier"}],"roleHeading":"Case","title":"ClientProfile.unknown","externalID":"s:8AxiamSDK13ClientProfileO7unknownyA2CmF"},"abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}]}]}],"variants":[{"paths":["\/documentation\/axiamsdk\/clientprofile\/unknown"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"]]},"references":{"Self::Standard":{"url":"Self::Standard","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"title":"Standard","type":"link","identifier":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/unknown":{"url":"\/documentation\/axiamsdk\/clientprofile\/unknown","title":"ClientProfile.unknown","abstract":[{"text":"A value this SDK’s copy of the spec does not list; see the type’s summary.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/unknown"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","url":"\/documentation\/axiamsdk\/clientprofile","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}],"abstract":[{"type":"text","text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”."},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"type":"text","text":" "},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"type":"text","text":", mandatory strong client authentication, mandatory sender-constrained tokens,"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"type":"text","text":" "},{"text":"change at all, because ","type":"text"},{"isActive":true,"type":"reference","identifier":"Self::Standard"},{"text":" is the serde default and every row","type":"text"},{"type":"text","text":" "},{"text":"written before schema v38 decodes to it.","type":"text"}],"type":"topic","title":"ClientProfile","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}