{"abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/unknown"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/axiamsdk\/clientprofile\/unknown"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK13ClientProfileO7unknownyA2CmF","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknown","kind":"identifier"}],"role":"symbol","symbolKind":"case","title":"ClientProfile.unknown","roleHeading":"Case"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/unknown":{"type":"topic","url":"\/documentation\/axiamsdk\/clientprofile\/unknown","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknown","kind":"identifier"}],"title":"ClientProfile.unknown","abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/unknown"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"url":"\/documentation\/axiamsdk\/clientprofile","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"type":"topic","title":"ClientProfile","role":"symbol","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"S256","type":"codeVoice"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"nearly"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","isActive":true,"type":"reference"},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"Self::Standard":{"type":"link","identifier":"Self::Standard","url":"Self::Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"title":"Standard"}}}