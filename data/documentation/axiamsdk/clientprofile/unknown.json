ndatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"kind":"symbol","type":"topic","title":"ClientProfile"},"Self::Standard":{"type":"link","title":"Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"identifier":"Self::Standard","url":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/unknown":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/unknown","type":"topic","abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."}],"role":"symbol","title":"ClientProfile.unknown","url":"\/documentation\/axiamsdk\/clientprofile\/unknown","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknown","kind":"identifier"}]}}}