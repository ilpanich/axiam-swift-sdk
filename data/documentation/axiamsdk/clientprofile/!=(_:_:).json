"declarations"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/Equatable-Implementations":{"abstract":[],"kind":"article","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/Equatable-Implementations","title":"Equatable Implementations","type":"topic","role":"collectionGroup","url":"\/documentation\/axiamsdk\/clientprofile\/equatable-implementations"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/!=(_:_:)":{"title":"!=(_:_:)","kind":"symbol","url":"\/documentation\/axiamsdk\/clientprofile\/!=(_:_:)","abstract":[],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/!=(_:_:)"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","kind":"symbol","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"abstract":[{"type":"text","text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”."},{"type":"text","text":" "},{"type":"text","text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"S256","type":"codeVoice"},{"type":"text","text":", mandatory strong client authentication, mandatory sender-constrained tokens,"},{"type":"text","text":" "},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nearly"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"title":"ClientProfile","type":"topic","url":"\/documentation\/axiamsdk\/clientprofile"},"Self::Standard":{"identifier":"Self::Standard","title":"Standard","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"url":"Self::Standard"}}}