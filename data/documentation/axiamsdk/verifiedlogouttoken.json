{"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/s8SendableP"],"title":"Conforms To"}],"metadata":{"roleHeading":"Structure","title":"VerifiedLogoutToken","modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"text":"VerifiedLogoutToken","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VerifiedLogoutToken","kind":"identifier"}],"symbolKind":"struct","externalID":"s:8AxiamSDK19VerifiedLogoutTokenV"},"variants":[{"paths":["\/documentation\/axiamsdk\/verifiedlogouttoken"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VerifiedLogoutToken"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Never collapsed to a bare boolean","type":"text"}]},{"type":"text","text":", per §12.7.3: the relying party has to know "},{"type":"emphasis","inlineContent":[{"type":"text","text":"which"}]},{"type":"text","text":" "},{"type":"text","text":"session to end. When "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/VerifiedLogoutToken\/sid"},{"type":"text","text":" is present the RP MUST end that session only — falling back to"},{"type":"text","text":" "},{"type":"text","text":"“every session for "},{"type":"codeVoice","code":"sub"},{"type":"text","text":"” is an over-reach the server itself refuses to make."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"jti"},{"type":"text","text":" is surfaced so the RP can deduplicate. This SDK deliberately does not dedup"},{"type":"text","text":" "},{"type":"text","text":"internally: