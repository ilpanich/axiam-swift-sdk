{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"]]},"sections":[],"abstract":[{"type":"text","text":"Returns the protected value — this SDK’s single explicit accessor (§7 rule 3)."}],"metadata":{"externalID":"s:8AxiamSDK9SensitiveV6exposexyF","role":"symbol","symbolKind":"method","title":"expose()","roleHeading":"Instance Method","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"expose"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"T"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expose","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Public because §20 hands the "},{"inlineContent":[{"type":"text","text":"requesting party’s"}],"type":"strong"},{"type":"text","text":" token to the calling application: an"},{"type":"text","text":" "},{"type":"text","text":"RPT exists to be sent onward on the retried request, and a "},{"code":"UmaRequestingPartyToken","type":"codeVoice"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessToken"},{"type":"text","text":" could never be read would make the whole ticket grant unusable. The same"},{"type":"text","text":" "},{"type":"text","text":"applies to a PAT an application obtained elsewhere and now has to hand to the Protection"},{"type":"text","text":" "},{"type":"text","text":"API. Widening from module-internal is additive and breaks no existing caller."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Call this only at the point of actually using the value","type":"text"}]},{"type":"text","text":" — attaching it to an"},{"type":"text","text":" "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":" header, writing it to your own encrypted store — and never pass the result"},{"type":"text","text":" "},{"type":"text","text":"to a log, trace, or serialisation sink. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/description"},{"type":"text","text":"\/"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/debugDescription"},{"type":"text","text":" on "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"text","text":"itself still always redact, but that protection does not follow the raw value once this"},{"type":"text","text":" "},{"type":"text","text":"method returns it."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/sensitive\/expose()"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/expose()","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"url":"\/documentation\/axiamsdk\/sensitive","kind":"symbol","abstract":[{"text":"A wrapper for secret material (§7 of CONTRACT.md).","type":"text"}],"title":"Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"identifier":"doc:\/\/Axiam