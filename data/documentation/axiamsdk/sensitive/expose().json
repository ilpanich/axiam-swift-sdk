{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expose","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Public because §20 hands the "},{"type":"strong","inlineContent":[{"text":"requesting party’s","type":"text"}]},{"type":"text","text":" token to the calling application: an"},{"type":"text","text":" "},{"type":"text","text":"RPT exists to be sent onward on the retried request, and a "},{"code":"UmaRequestingPartyToken","type":"codeVoice"},{"text":" whose","type":"text"},{"text":" ","type":"text"},{"code":"accessToken","type":"codeVoice"},{"text":" could never be read would make the whole ticket grant unusable. The same","type":"text"},{"text":" ","type":"text"},{"text":"applies to a PAT an application obtained elsewhere and now has to hand to the Protection","type":"text"},{"text":" ","type":"text"},{"text":"API. Widening from module-internal is additive and breaks no existing caller.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Call this only at the point of actually using the value","type":"text"}]},{"text":" — attaching it to an","type":"text"},{"text":" ","type":"text"},{"code":"Authorization","type":"codeVoice"},{"text":" header, writing it to your own encrypted store — and never pass the result","type":"text"},{"text":" ","type":"text"},{"text":"to a log, trace, or serialisation sink. ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/description","type":"reference",