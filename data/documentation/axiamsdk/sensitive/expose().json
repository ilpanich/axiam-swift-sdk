{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/sensitive\/expose()"]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/expose()","interfaceLanguage":"swift"},"abstract":[{"text":"Returns the protected value — this SDK’s single explicit accessor (§7 rule 3).","type":"text"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expose"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"T"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Public because §20 hands the "},{"type":"strong","inlineContent":[{"type":"text","text":"requesting party’s"}]},{"type":"text","text":" token to the calling application: an"},{"type":"text","text":" "},{"type":"text","text":"RPT exists to be sent onward on the retried request, and a "},{"type":"codeVoice","code":"UmaRequestingPartyToken"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessToken"},{"type":"text","text":" could never be read would make the whole ticket grant unusable. The same"},{"type":"text","text":" "},{"type":"text","text":"applies to a PAT an application obtained elsewhere and now has to hand to the Protection"},{"type":"text","text":" "},{"type":"text","text":"API. Widening from module-internal is additive and breaks no existing caller."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Call this only at the point of actually using the value"}],"type":"strong"},{"text":" — attaching it to an","type":"text"},{"text":" ","type":"text"},{"code":"Authorization","type":"codeVoice"},{"text":" header, writing it to your own encrypted store — and never pass the result","type":"text"},{"text":" ","type":"text"},{"text":"to a log, trace, or serialisation sink. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/description","type":"reference"},{"text":"\/","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/debugDescription","type":"reference"},{"text":" on ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"itself still always redact, but that protection does not follow the raw value once this","type":"text"},{"text":" ","type":"text"},{"text":"method returns it.","type":"text"}]}]}],"metadata":{"role":"symbol","title":"expose()","externalID":"s:8AxiamSDK9SensitiveV6exposexyF","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expose"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"T"}]},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/Sensitive/debugDescription":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/debugDescription","url":"\/documentation\/axiamsdk\/sensitive\/debugdescription","type":"topic","abstract":[],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"debugDescription"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"title":"debugDescription","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","r