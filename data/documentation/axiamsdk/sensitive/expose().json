d breaks no existing caller.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Call this only at the point of actually using the value","type":"text"}]},{"type":"text","text":" — attaching it to an"},{"type":"text","text":" "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":" header, writing it to your own encrypted store — and never pass the result"},{"type":"text","text":" "},{"type":"text","text":"to a log, trace, or serialisation sink. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/description"},{"type":"text","text":"\/"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/debugDescription"},{"type":"text","text":" on "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"text","text":"itself still always redact, but that protection does not follow the raw value once this"},{"type":"text","text":" "},{"type":"text","text":"method returns it."}]}]}],"sections":[],"abstract":[{"type":"text","text":"Returns the protected value — this SDK’s single explicit accessor (§7 rule 3)."}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/Sensitive/expose()":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expose"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"T"}],"abstract":[{"text":"Returns the protected value — this SDK’s single explicit accessor (§7 rule 3).","type":"text"}],"url":"\/documentation\/axiamsdk\/sensitive\/expose()","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/expose()","title":"expose()"},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive/description":{"url":"\/documentation\/axiamsdk\/sensitive\/description","abstract":[],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"