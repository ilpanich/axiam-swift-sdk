{"abstract":[{"type":"text","text":"Returns the protected value — this SDK’s single explicit accessor (§7 rule 3)."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/sensitive\/expose()"]}],"metadata":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expose","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"}],"title":"expose()","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK9SensitiveV6exposexyF","symbolKind":"method","roleHeading":"Instance Method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expose"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"T"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Public because §20 hands the ","type":"text"},{"inlineContent":[{"type":"text","text":"requesting party’s"}],"type":"strong"},{"text":" token to the calling application: an","type":"text"},{"text":" ","type":"text"},{"text":"RPT exists to be sent onward on the retried request, and a ","type":"text"},{"code":"UmaRequestingPartyToken","type":"codeVoice"},{"text":" whose","type":"text"},{"text":" ","type":"text"},{"code":"accessToken","type":"codeVoice"},{"text":" could never be read would make the whole ticket grant unusable. The same","type":"text"},{"text":" ","type":"text"},{"text":"applies to a PAT an application obtained elsewhere and now has to hand to the Protection","type":"text"},{"text":" ","type":"text"},{"text":"API. Widening from module-internal is additive and breaks no existing caller.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Call this only at the point of actually using the value"}],"type":"strong"},{"text":" — attaching it to an","type":"text"},{"text":" ","type":"text"},{"code":"Authorization","type":"codeVoice"},{"text":" header, writing it to your own encrypted store — and never pass the result","type":"text"},{"text":" ","type":"text"},{"text":"to a log, trace, or serialisation sink. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/description","type":"reference"},{"text":"\/","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/debugDescription","type":"reference"},{"text":" on ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"itself still always redact, but that protection does not follow the raw value once this","type":"text"},{"text":" ","type":"text"},{"text":"method returns it.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/expose()","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/Sensitive/debugDescription":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"debugDescription","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"url":"\/documentation\/axiamsdk\/sensitive\/debugdescription","abstract":[],"title":"debugDescription","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/debugDescription"},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive/description":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive\/description","url":"\/documentation\/axiamsdk\/sensitive\/description","type":"topic","role":"symbol","fragments":[{"kind":"keyword"