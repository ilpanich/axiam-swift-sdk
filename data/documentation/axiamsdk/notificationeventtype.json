ess. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"text","text":"carrying an unrecognised value back into an update is refused by the server rather than"},{"type":"text","text":" "},{"type":"text","text":"written as a spelling it never used. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"symbol","symbolKind":"enum","modules":[{"name":"AxiamSDK"}],"title":"NotificationEventType","externalID":"s:8AxiamSDK21NotificationEventTypeO","roleHeading":"Enumeration","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NotificationEventType"}],"navigatorTitle":[{"kind":"identifier","text":"NotificationEventType"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NotificationEventType"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/NotificationEventType/mfaEnrollmentChanged":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mfaEnrollmentChanged","kind":"identifier"}],"kind":"symbol","abstract":[],"url":"\/documentation\/axiamsdk\/notificationeventtype\/mfaenrollmentchanged","title":"NotificationEventType.mfaEnrollmentChanged","role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NotificationEventType\/mfaEnrollmentChanged"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/NotificationEventType/permissio