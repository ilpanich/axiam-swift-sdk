type":"text"},{"text":" ","type":"text"},{"code":"private_key_jwt","type":"codeVoice"},{"text":"), and at least one sender-constraining mechanism","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"tls_client_certificate_bound_access_tokens","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"dpop_bound_access_tokens","type":"codeVoice"},{"text":"). See the","type":"text"},{"text":" ","type":"text"},{"text":"FAPI operator guide.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/profile","title":"profile","url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/profile","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/dpopRequireNonce":{"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"dpopRequireNonce"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"title":"dpopRequireNonce","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"RFC 9449 §8 — require this client’s DPoP proofs to carry a server-issued nonce. "},{"inlineContent":[{"text":"Not","type":"text"},{"type":"text","text":" "},{"text":"implemented in this build (SEC-097).","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":" is refused with "},{"code":"400","type":"codeVoice"},{"text":"; only ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" (the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"default) is accepted. Nothing reads the stored value, so accepting "},{"code":"true","type":"codeVoice"},{"text":" would persist","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and echo back a security switch that does nothing. DPoP proofs are made single-use at"},{"text":" ","type":"text"},{"text":"the token endpoint by ","type":"text"},{"type":"codeVoice","code":"jti"},{"text":" replay detection instead — see ","type":"text"},{"type":"codeVoice","code":"docs\/security-profiles.md"},{"text":".","type":"text"}],"url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/dpoprequirenonce","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/dpopRequireNonce"},"doc://AxiamSDK/SE":{"title":"Swift.Encodable","identifier":"doc:\/\/AxiamSDK\/SE","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/browserSSO":{"abstract":[{"text":"X7.3 — whether an unauthenticated authorization request from this client may be answered","type":"text"},{"text":" ","type":"text"},{"text":"with a redirect to the login page rather than the ","type":"text"},{"type":"codeVoice","code":"401"},{"text":" AXIAM answers today. Accepted","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and stored, but "},{"type":"strong","inlineContent":[{"type":"text","text":"nothing reads it yet"}]},{"type":"text","text":": the login hop it gates is a later wave. Unlike"},{"type":"text","text":" "},{"type":"codeVoice","code":"authn_request_params"},{"type":"text","text":" it is permitted on a "},{"type":"codeVoice","code":"fapi2"},{"type":"text","text":" client, because it relaxes nothing —"},{"type":"text","text":" "},{"type":"text","text":"it decides only how an anonymous browser is answered."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/browserSSO","title":"browserSSO","type":"topic","url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/browsersso","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"browserSSO"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"kind":"symbol"}}}