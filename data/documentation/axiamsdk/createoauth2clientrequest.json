"text"},{"text":" ","type":"text"},{"text":"prefix","type":"text"}]},{"text":". Empty (the default) means the client may name no resource, so every token it","type":"text"},{"text":" ","type":"text"},{"text":"obtains carries ","type":"text"},{"type":"codeVoice","code":"axiam:user"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"axiam:m2m"},{"text":" exactly as before RFC 8707 support existed.","type":"text"},{"text":" ","type":"text"},{"text":"This is also the list the RFC 8693 token exchange consults for its ","type":"text"},{"type":"codeVoice","code":"audience"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"resource"},{"text":" ","type":"text"},{"text":"target.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allowedResources","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]?","kind":"text"}],"title":"allowedResources","role":"symbol","url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/allowedresources"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/tokenEndpointAuthMethod":{"type":"topic","role":"symbol","url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/tokenendpointauthmethod","title":"tokenEndpointAuthMethod","abstract":[{"type":"text","text":"X5.1 — how this client authenticates at the token endpoint (RFC 8705 §2). Defaults to"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_secret_post"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tokenEndpointAuthMethod","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK16ClientAuthMethodO","text":"ClientAuthMethod","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/tokenEndpointAuthMethod"},"doc://AxiamSDK/documentation/AxiamSD