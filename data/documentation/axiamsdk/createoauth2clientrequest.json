DK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/init(from:)","role":"symbol","abstract":[],"title":"init(from:)"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/defaultIdp":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultIdp"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/defaultidp","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/defaultIdp","abstract":[{"text":"G-B (#817) — the federation provider (a federation config ","type":"text"},{"code":"id","type":"codeVoice"},{"text":") this client’s sign-in","type":"text"},{"text":" ","type":"text"},{"text":"page starts with when an authorization request carries no ","type":"text"},{"code":"axiam_idp_hint","type":"codeVoice"},{"text":"; a hint that","type":"text"},{"text":" ","type":"text"},{"text":"names a provider overrides it. Must name a provider this tenant can sign in with — its","type":"text"},{"text":" ","type":"text"},{"text":"own enabled configs, or the organization’s enabled ones it inherits — or the","type":"text"},{"text":" ","type":"text"},{"text":"registration is refused with ","type":"text"},{"code":"400","type":"codeVoice"},{"text":". If that provider is later disabled or deleted the","type":"text"},{"text":" ","type":"text"},{"text":"default is ignored at the authorization endpoint (the provider chooser is shown), never","type":"text"},{"text":" ","type":"text"},{"text":"an error. Omit for none.","type":"text"}],"title":"defaultIdp","type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/backchannelUserCodeParameter":{"url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/backchannelusercodeparameter","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bac