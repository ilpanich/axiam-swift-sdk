mentation\/AxiamSDK\/CreateOAuth2ClientRequest\/browserSSO","role":"symbol","abstract":[{"text":"X7.3 — whether an unauthenticated authorization request from this client may be answered","type":"text"},{"text":" ","type":"text"},{"text":"with a redirect to the login page rather than the ","type":"text"},{"code":"401","type":"codeVoice"},{"text":" AXIAM answers today. Accepted","type":"text"},{"text":" ","type":"text"},{"text":"and stored, but ","type":"text"},{"inlineContent":[{"type":"text","text":"nothing reads it yet"}],"type":"strong"},{"text":": the login hop it gates is a later wave. Unlike","type":"text"},{"text":" ","type":"text"},{"code":"authn_request_params","type":"codeVoice"},{"text":" it is permitted on a ","type":"text"},{"code":"fapi2","type":"codeVoice"},{"text":" client, because it relaxes nothing —","type":"text"},{"text":" ","type":"text"},{"text":"it decides only how an anonymous browser is answered.","type":"text"}],"title":"browserSSO"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/dpopBoundAccessTokens":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dpopBoundAccessTokens"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/dpopBoundAccessTokens","url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/dpopboundaccesstokens","kind":"symbol","abstract":[{"type":"text","text":"RFC 9449 §5.2 — issue DPoP-bound (sender-constrained) access tokens to this client."},{"type":"text","text":" "},{"type":"text","text":"Independent of both the authentication method and"},{"type":"text","text":" "},{"type":"codeVoice","code":"tls_client_certificate_bound_access_tokens"},{"type":"text","text":"; a client may ask for both constraints, and"},{"type":"text","text":" "},{"type":"text","text":"a token carrying both must satisfy both."}],"type":"topic","title":"dpopBoundAccessTokens","role":"symbol"}}}