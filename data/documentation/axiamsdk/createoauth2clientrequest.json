}],"type":"topic","title":"backchannelAuthenticationRequestSigningAlg","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/grantTypes":{"title":"grantTypes","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"grantTypes","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/grantTypes","role":"symbol","abstract":[{"text":"Grant types this client is authorized to use.","type":"text"}],"type":"topic","url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/granttypes","kind":"symbol"},"doc://AxiamSDK/s16SendableMetatypeP":{"identifier":"doc:\/\/AxiamSDK\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/s8SendableP","title":"Swift.Sendable"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/dpopRequireNonce":{"url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/dpoprequirenonce","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dpopRequireNonce"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/dpopRequireNonce","role":"symbol","abstract":[{"type":"text","text":"RFC 9449 §8 — require this client’s DPoP proofs to carry a server-issued nonce. "},{"type":"strong","inlineContent":[{"type":"text","text":"Not"},{"type":"text","text":" "},{"type":"text","text":"implemented in this build (SEC-097)."}]},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":" is refused with "},{"code":"400","type":"codeVoice"},{"type":"text","text":"; only "},{"code":"false","type":"codeVoice"},{"type":"text","text":" (the"},{"type":"text","text":" "},{"type":"text","text":"default) is accepted. Nothing reads the stored value, so accepting "},{"code":"true","type":"codeVoice"},{"type":"text","text":" would persist"},{"type":"text","text":" "},{"type":"text","text":"and echo back a security switch that does nothing. DPoP proofs are made single-use at"},{"type":"text","text":" "},{"type":"text","text":"the token endpoint by "},{"code":"jti","type":"codeVoice"},{"type":"text","text":" replay detection instead — see "},{"code":"docs\/security-profiles.md","type":"codeVoice"},{"type":"text","text":"."}],"title":"dpopRequireNonce"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/authnRequestParams":{"url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/authnrequestparams","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"authnRequestParams"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK22AuthnRequestParamsModeO","kind":"typeIdentifier","text":"AuthnRequestParamsMode"},{"kind":"text","text":"?"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/authnRequestParams","title":"authnRequestParams","abstract":[{"type":"text","text":"X7.1 — whether this client’s authorization requests may carry the OpenID Connect"},{"type":"text","text":" "},{"type":"text","text":"authentication-request parameters ("},{"type":"codeVoice","code":"prompt"},{"type":"text","text":", "},{"type":"codeVoice","code":"max_age"},{"text":", ","type":"text"},{"code":"acr_values","type":"codeVoice"},{"text":", ","type":"text"},{"code":"claims","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"id_token_hint","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"login_hint"},{"text":", ","type":"text"},{"type":"codeVoice","code":"display"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ui_locales"},{"text":", ","type":"text"},{"type":"codeVoice","code":"claims_locales"},{"text":"). ","type":"text"},{"type":"codeVoice","code":"\"ignore\""},{"text":" ","type":"text"},{"text":"(the default) is what every AXIAM client has always done: they are dropped and reach no","type":"text"},{"text":" ","type":"text"},{"text":"decision. ","type":"text"},{"type":"codeVoice","code":"\"honour\""},{"text":" opts in, and is ","type":"text"},{"inlineContent":[{"text":"refused on a ","type":"text"},{"code":"fapi2","type":"codeVoice"},{"text":" client","type":"text"}],"type":"strong"},{"text":" at both this gate","type":"text"},{"text":" ","type":"text"},{"text":"and the authorization endpoint — the two are different answers to the same question","type":"text"},{"text":" ","type":"text"},{"text":"about what a request from this client means.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/tlsClientAuthSanURI":{"url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/tlsclientauthsanuri","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"tlsClientAuthSanURI"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/tlsClientAuthSanURI","role":"symbol","abstract":[{"text":"RFC 8705 §2.1.2 — expected ","type":"text"},{"type":"codeVoice","code":"uniformResourceIdentifier"},{"text":" SAN.","type":"text"}],"title":"tlsClientAuthSanURI"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/tlsClientAuthSubjectDn":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tlsClientAuthSubjectDn","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/tlsClientAuthSubjectDn","url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/tlsclientauthsubjectdn","kind":"symbol","abstract":[{"type":"text","text":"RFC 8705 §2.1.2 — expected certificate subject DN, RFC 4514 form. Exactly one of the"},{"type":"text","text":" "},{"type":"text","text":"three "},{"type":"codeVoice","code":"tls_client_auth_*"},{"type":"text","text":" parameters may be set."}],"title":"tlsClientAuthSubjectDn","type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/allowedResources":{"url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/allowedresources","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"allowedResources"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/allowedResources","role":"symbol","abstract":[{"type":"text","text":"T21.3 \/ RFC 8707 — the target services this client may name in a "},{"type":"codeVoice","code":"resource"},{"type":"text","text":" parameter,"},{"type":"text","text":" "},{"type":"text","text":"at "},{"type":"codeVoice","code":"\/oauth2\/authorize"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/oauth2\/par"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/oauth2\/device_authorization"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/oauth2\/token"},{"type":"text","text":". Each entry must be an absolute URI without a fragment (RFC 8707 §2)."},{"type":"text","text":" "},{"type":"text","text":"Entries are stored in their RFC 3986 §6.2.2 normalised form, which is what the read-back"},{"type":"text","text":" "},{"type":"text","text":"shows and what every comparison uses; matching is by equivalence and "},{"inlineContent":[{"text":"never by","type":"text"},{"text":" ","type":"text"},{"text":"prefix","type":"text"}],"type":"strong"},{"type":"text","text":". Empty (the default) means the client may name no resource, so every token it"},{"type":"text","text":" "},{"type":"text","text":"obtains carries "},{"type":"codeVoice","code":"axiam:user"},{"type":"text","text":" or "},{"type":"codeVoice","code":"axiam:m2m"},{"type":"text","text":" exactly as before RFC 8707 support existed."},{"type":"text","text":" "},{"type":"text","text":"This is also the list the RFC 8693 token exchange consults for its "},{"type":"codeVoice","code":"audience"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"resource"},{"type":"text","text":" "},{"type":"text","text":"target."}],"title":"allowedResources"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/encode(to:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"encode"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7EncoderP","kind":"typeIdentifier","text":"Encoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/encode(to:)","url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/encode(to:)","kind":"symbol","abstract":[],"type":"topic","title":"encode(to:)","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/scopes":{"url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/scopes","fragments"