{"kind":"symbol","relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientAuthMethod"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"An "},{"inlineContent":[{"text":"open","type":"text"}],"type":"strong"},{"type":"text","text":" enum. A value this SDK’s copy of the spec does not list decodes to "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" "},{"type":"text","text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there"},{"type":"text","text":" "},{"type":"text","text":"fails the WHOLE response, so one field of one record would take down the page it was on,"},{"type":"text","text":" "},{"type":"text","text":"including the records the caller did ask for."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" is never written: "},{"code":"encode(to:)","type":"codeVoice"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"code":"\"\"","type":"codeVoice"},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" over these cases needs an "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"metadata":{"title":"ClientAuthMethod","roleHeading":"Enumeration","role":"symbol","symbolKind":"enum","navigatorTitle":[{"kind":"identifier","text":"ClientAuthMethod"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientAuthMethod"}],"externalID":"s:8AxiamSDK16ClientAuthMethodO","modules":[{"name":"AxiamSDK"}]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming)."},{"type":"text","text":" "},{"type":"text","text":"Only the methods AXIAM actually implements are representable. "},{"code":"None","type":"codeVoice"},{"type":"text","text":" — the public-client"},{"type":"text","text":" "},{"type":"text","text":"value — was deliberately absent until T21.2: adding it before the rest of the server"},{"type":"text","text":" "},{"type":"text","text":"understood one would have let an operator register a client whose authentication is silently"},{"type":"text","text":" "},{"type":"text","text":"skipped. The server understands one now ("},{"code":"token.rs","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"authenticate_client_credential","type":"codeVoice"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"an arm that accepts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"no"}]},{"type":"text","text":" credential and refuses a presented one, the authorization endpoint"},{"type":"text","text":" "},{"type":"text","text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside"},{"type":"text","text":" "},{"type":"text","text":"any grant or binding that contradicts it), so the variant exists — and only that arm may"},{"type":"text","text":" "},{"type":"text","text":"ever treat a missing credential as success."}],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/clientSecretBasic","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/clientSecretPost","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/none","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/privateKeyJWT","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/selfSignedTLSClientAuth","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/tlsClientAuth","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/unknown"],"anchor":"Enumeration-Cases","title":"Enumeration Cases","generated":true},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/init(rawValue:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/encode(to:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/RawRepresentable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/clientauthmethod"],"traits":[{"inter