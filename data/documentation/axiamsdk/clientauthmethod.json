{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"An "},{"type":"strong","inlineContent":[{"text":"open","type":"text"}]},{"type":"text","text":" enum. A value this SDK’s copy of the spec does not list decodes to "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there"},{"type":"text","text":" "},{"type":"text","text":"fails the WHOLE response, so one field of one record would take down the page it was on,"},{"type":"text","text":" "},{"type":"text","text":"including the records the caller did ask for."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is never written: "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"type":"codeVoice","code":"\"\""},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/clientauthmethod"]}],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/clientSecretBasic","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/clientSecretPost","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/none","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/privateKeyJWT","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/selfSignedTLSClientAuth","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/tlsClientAuth","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/unknown"],"generated":true,"anchor":"Enumeration-Cases","title":"Enumeration Cases"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/init(rawValue:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/encode(to:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/RawRepresentable-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableM