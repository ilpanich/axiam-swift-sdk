"topic","abstract":[{"text":"Per-tenant attestation policy governing the §24 ceremonies, and the compliance report over","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"url":"\/documentation\/axiamsdk\/webauthnpolicyapi","kind":"symbol","navigatorTitle":[{"text":"WebauthnPolicyApi","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse":{"type":"topic","title":"PolicyResponse","navigatorTitle":[{"text":"PolicyResponse","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse","url":"\/documentation\/axiamsdk\/policyresponse","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PolicyResponse","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"codeVoice","code":"GET"},{"type":"text","text":" response: the stored policy plus the unknown-AAGUID action it currently "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resolves to"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"unknown_aaguid"},{"type":"text","text":" is nullable, where "},{"type":"codeVoice","code":"null"},{"type":"text","text":" means “use this mode’s default” (deny under"},{"type":"text","text":" "},{"type":"codeVoice","code":"direct_required"},{"type":"text","text":", allow otherwise). A client that only saw the stored "},{"type":"codeVoice","code":"null"},{"type":"text","text":" would have to"},{"type":"text","text":" "},{"type":"text","text":"re-derive that rule itself to display what the policy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}]},"doc://AxiamSDK/documentation/AxiamSDK/WebauthnPolicyApi/get()":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/WebauthnPolicyApi\/get()","abstract":[{"type":"codeVoice","code":"GET \/api\/v1\/tenants\/{tenant_id}\/webauthn\/attestation-policy"}],"kind":"symbol","title":"get()","role":"symbol","url":"\/documentation\/axiamsdk\/webauthnpolicyapi\/get()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"get"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK14PolicyResponseV","text":"PolicyResponse"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"}}}