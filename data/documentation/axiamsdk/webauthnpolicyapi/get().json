olicy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}]},"doc://AxiamSDK/documentation/AxiamSDK/WebauthnPolicyApi":{"abstract":[{"type":"text","text":"Per-tenant attestation policy governing the §24 ceremonies, and the compliance report over"},{"type":"text","text":" "},{"type":"text","text":"it."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WebauthnPolicyApi","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/WebauthnPolicyApi","type":"topic","url":"\/documentation\/axiamsdk\/webauthnpolicyapi","title":"WebauthnPolicyApi","role":"symbol","navigatorTitle":[{"text":"WebauthnPolicyApi","kind":"identifier"}]}}}