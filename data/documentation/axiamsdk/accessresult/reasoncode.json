{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reasonCode","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"The two refusals mean opposite things to the person on the other end."}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"no_grant"},{"type":"text","text":" says "},{"inlineContent":[{"type":"text","text":"ask an admin for access"}],"type":"emphasis"},{"type":"text","text":"; "},{"type":"codeVoice","code":"denied_by_rule"},{"type":"text","text":" says "},{"inlineContent":[{"text":"an admin has","type":"text"},{"text":" ","type":"text"},{"text":"already decided","type":"text"}],"type":"emphasis"},{"type":"text","text":". An application that cannot tell them apart sends users to raise"},{"type":"text","text":" "},{"type":"text","text":"tickets that will be refused — which is why the contract forbids collapsing them"},{"type":"text","text":" "},{"type":"text","text":"into a bare "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the server omits the field: a newer SDK against an older server treats"},{"type":"text","text":" "},{"type":"text","text":"it as absent, never as an error. An unrecognised value is surfaced verbatim and"},{"type":"text","text":" "},{"type":"text","text":"never changes "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AccessResult\/allowed","isActive":true,"type":"reference"},{"type":"text","text":" — which is why this is a "},{"code":"String","type":"codeVoice"},{"ty