e","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}]}]}],"metadata":{"role":"symbol","title":"SsfStatusActor","modules":[{"name":"AxiamSDK"}],"roleHeading":"Enumeration","symbolKind":"enum","externalID":"s:8AxiamSDK14SsfStatusActorO","navigatorTitle":[{"text":"SsfStatusActor","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SsfStatusActor","kind":"identifier"}]},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP"]}],"abstract":[{"type":"text","text":"Who set a stream’s current status. A status an administrator set to anything but "},{"type":"codeVoice","code":"enabled"},{"type":"text","text":" "},{"type":"text","text":"cannot be changed by the receiver (D-51)."}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStatusActor","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/ssfstatusactor"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStatusActor\/admin","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStatusActor\/receiver","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStatusActor\/unknown"]},{"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStatusActor\/init(from:)-4k19x","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStatusActor\/init(rawValue:)"]},{"title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStatusActor\/encode(to:)"]},{"title