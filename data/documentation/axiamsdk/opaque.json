{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Opaque\/available()","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Opaque\/startLogin(password:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Opaque\/startRegistration(password:)"],"title":"Type Methods"}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Opaque"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"There is no cryptography in this enum, or anywhere in this package. That is deliberate and is","type":"text"},{"text":" ","type":"text"},{"text":"what §23.1 requires: OPAQUE needs an oblivious PRF, ","type":"text"},{"type":"codeVoice","code":"hash_to_curve"},{"text":", ","type":"text"},{"type":"codeVoice","code":"expand_message_xmd"},{"text":", an","type":"text"},{"text":" ","type":"text"},{"text":"envelope construction and a three-message AKE, and eleven independent implementations of that","type":"text"},{"text":" ","type":"text"},{"text":"is eleven chances to be subtly and silently wrong. The SRP-6a this replaces was arithmetic","type":"text"},{"text":" ","type":"text"},{"text":"every language can express — which here meant a hand-written big-integer modular exponentiation","type":"text"},{"text":" ","type":"text"},{"text":"and a ","type":"text"},{"type":"codeVoice","code":"pbkdf2_sha256"},{"text":"-only limitation on top, because Swift has no Argon2 that ships on every","type":"text"},{"text":" ","type":"text"},{"text":"supported platform.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/opaque"]}],"abstract":[{"type":"te