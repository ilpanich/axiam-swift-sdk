{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/opaque"]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Opaque","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"There is no cryptography in this enum, or anywhere in this package. That is deliberate and is","type":"text"},{"text":" ","type":"text"},{"text":"what §23.1 requires: OPAQUE needs an oblivious PRF, ","type":"text"},{"type":"codeVoice","code":"hash_to_curve"},{"text":", ","type":"text"},{"type":"codeVoice","code":"expand_message_xmd"},{"text":", an","type":"text"},{"text":" ","type":"text"},{"text":"envelope construction and a three-message AKE, and eleven independent implementations of that","type":"text"},{"text":" ","type":"text"},{"text":"is eleven chances to be subtly and silently wrong. The SRP-6a this replaces was arithmetic","type":"text"},{"text":" ","type":"text"},{"text":"every language can express — which here meant a hand-written big-integer modular exponentiation","type":"text"},{"text":" ","type":"text"},{"text":"and a ","type":"text"},{"type":"codeVoice","code":"pbkdf2_sha256"},{"text":"-only limitation on top, because Swift has no Argon2 that ships on every","type":"text"},{"text":" ","type":"text"},{"text":"supported platform.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Opaque"},"metadata":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Opaque","kind":"identifier"}],"modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK6OpaqueO","role":"symbol","navigatorTitle":[{"text":"Opaque","kind":"identifier"}],"roleHeading":"Enumeration","symbolKind":"enum","title":"Opaque"},"topi