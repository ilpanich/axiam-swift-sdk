{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","abstract":[{"text":"Entry points into ","type":"text"},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"text":" (CONTRACT.md §23).","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Opaque","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"text":"There is no cryptography in this enum, or anywhere in this package. That is deliberate and is","type":"text"},{"text":" ","type":"text"},{"text":"what §23.1 requires: OPAQUE needs an oblivious PRF, ","type":"text"},{"code":"hash_to_curve","type":"codeVoice"},{"text":", ","type":"text"},{"code":"expand_message_xmd","type":"codeVoice"},{"text":", an","type":"text"},{"text":" ","type":"text"},{"text":"envelope construction and a three-message AKE, and eleven independent implementations of that","type":"text"},{"text":" ","type":"text"},{"text":"is eleven chances to be subtly and silently wrong. The SRP-6a this replaces was arithmetic","type":"text"},{"text":" ","type":"text"},{"text":"every language can express — which here meant a hand-written big-integer modular exponentiation","type":"text"},{"text":" ","type":"text"},{"text":"and a ","type":"text"},{"code":"pbkdf2_sha256","type":"codeVoice"},{"text":"-only limitation on top, because Swift has no Argon2 that ships on every","type":"text"},{"text":" ","type":"text"},{"text":"supported platform.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Opaque"},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Opaque\/available()","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Opaque\/startLogin(password:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Opaque\/startRegistr