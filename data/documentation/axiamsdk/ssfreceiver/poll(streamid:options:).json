en no SET of the batch was accepted, nothing is recorded and the failure is thrown"},{"type":"text","text":" "},{"type":"text","text":"instead. A SET refused "},{"type":"codeVoice","code":"replayed"},{"type":"text","text":" was accepted by this receiver earlier: acknowledge it"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"ack"},{"type":"text","text":" rather than reporting it in "},{"type":"codeVoice","code":"setErrs"},{"type":"text","text":" (§34.2 P2). A "},{"type":"codeVoice","code":"poll"},{"type":"text","text":" that returns leaving"},{"type":"text","text":" "},{"type":"text","text":"SETs unjudged emits "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent\/ssfUnjudged(operation:count:category:)"},{"type":"text","text":" (§19.1)."}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"type":"text","text":"A local "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError"},{"type":"text","text":" when no access-token provider is configured."}],"type":"paragraph"}],"type":"aside"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/SsfPollOptions":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfPollOptions","url":"\/documentation\/axiamsdk\/ssfpolloptions","type":"topic","abstract":[{"type":"text","text":"Arguments to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfReceiver\/poll(streamID:options:)"},{"type":"text","text":". Every member is passed through as"},{"type":"text","text":" "},{"type":"text","text":"given; an unset one is not sent."}],"navigatorTitle":[{"text":"SsfPollOptions","kind":"identifier"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"SsfPollOptions","kind":"identifier"}],"title":"SsfPollOptions"},"doc://AxiamSDK/documentation/AxiamSDK/N