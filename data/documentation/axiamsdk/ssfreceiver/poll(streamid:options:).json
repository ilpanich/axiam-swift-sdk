":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"ack"},{"type":"text","text":" rather than reporting it in "},{"type":"codeVoice","code":"setErrs"},{"type":"text","text":" (§34.2 P2). A "},{"type":"codeVoice","code":"poll"},{"type":"text","text":" that returns leaving"},{"type":"text","text":" "},{"type":"text","text":"SETs unjudged emits "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent\/ssfUnjudged(operation:count:category:)"},{"type":"text","text":" (§19.1)."}]},{"type":"aside","name":"Throws","content":[{"inlineContent":[{"text":"A local ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError"},{"text":" when no access-token provider is configured.","type":"text"}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfReceiver"]]},"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfReceiver\/poll(streamID:options:)","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/SsfPollResult/events":{"kind":"symbol","abstract":[{"type":"text","text":"The SETs that verified — each one recorded in the replay store."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfPollResult\/events","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"events","kind":"identifier"},{"text":": [","kind":"text"},{"text":"SecurityEvent","preciseIdentifier":"s:8AxiamSDK13SecurityEventV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/axiamsdk\/ssfpollresult\/events","role":"symbol","title":"events"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"