{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"s:8AxiamSDK19MtlsEndpointAliasesV","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"MtlsEndpointAliases"}],"modules":[{"name":"AxiamSDK"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MtlsEndpointAliases"}],"title":"MtlsEndpointAliases","symbolKind":"struct","role":"symbol"},"relationshipsSections":[{"identifiers":["doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/s8SendableP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MtlsEndpointAliases","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A TLS listener decides whether to request a client certificate during the handshake,","type":"text"},{"text":" ","type":"text"},{"text":"before it has seen any HTTP, so “ask for a certificate on ","type":"text"},{"type":"codeVoice","code":"\/oauth2\/token"},{"text":" but not on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\/oauth2\/authorize"},{"text":"” is not something one listener can do. A deployment wanting both runs","type":"text"},{"text":" ","type":"text"},{"text":"two, and this object names the second.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Only these six are ever aliased. ","type":"text"},{"code":"authorization_endpoint","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"end_session_endpoint","type":"codeVoice"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"front-channel and ","type":"text"},{"code":"jwks_uri","type":"codeVoice"},{"text":" is public key material, so §21.3 rule 2 forbids synthesising","type":"text"},{"text":" ","type":"text"},{"text":"an alias for any of them — sending a browser to an mTLS host raises a native","type":"text"},{"text":" ","type":"text"},{"text":"certificate-chooser dialog most users cannot answer. ","type":"text"},{"code":"issuer","type":"codeVoice"},{"text":" is not an endpoint and does","type":"text"},{"text":" ","type":"text"},{"text":"not move either: §12.4 rule 3 still compares ","type":"text"},{"code":"iss","type":"codeVoice"},{"text":" against it by exact string.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Every property is optional","type":"text"}]},{"type":"text","text":", though the server’s schema marks all six required. AXIAM"},{"type":"text","text":" "},{"type":"text","text":"builds them from one path through a shared macro and so always publishes the complete set,"},{"type":"text","text":" "},{"type":"text","text":"but RFC 8705 §5 permits an OP to alias fewer, and the shape of this member must never be"},{"type":"text","text":" "},{"type":"text","text":"why a client stops working — the same principle rule 2 point 1 states for the object as a"},{"type":"text","text":" "},{"type":"text","text":"whole, one level in. A "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" entry falls back to the top-level endpoint of the same name,"},{"type":"text","text":" "},{"type":"text","text":"exactly as an absent object does."}]}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MtlsEndpointAliases\/init(from:)"],"title":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MtlsEndpointAliases\/deviceAuthorizationEndpoint","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MtlsEndpointAliases\/introspectionEndpoint","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MtlsEndpointAliases\/pushedAuthorizationRequestEndpoint","doc:\/\/AxiamSDK\/docu