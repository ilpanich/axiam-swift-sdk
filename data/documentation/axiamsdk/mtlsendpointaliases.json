e","code":"nil"},{"type":"text","text":" entry falls back to the top-level endpoint of the same name,"},{"type":"text","text":" "},{"type":"text","text":"exactly as an absent object does."}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/mtlsendpointaliases"]}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MtlsEndpointAliases","kind":"identifier"}],"role":"symbol","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK19MtlsEndpointAliasesV","title":"MtlsEndpointAliases","roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"text":"MtlsEndpointAliases","kind":"identifier"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MtlsEndpointAliases"},"sections":[],"abstract":[{"type":"text","text":"RFC 8705 §5 "},{"type":"codeVoice","code":"mtls_endpoint_aliases"},{"type":"text","text":" — the seven endpoints re-based on the host that"},{"type":"text","text":" "},{"type":"text","text":"performs the mutual-TLS handshake (wire schema "},{"type":"codeVoice","code":"MtlsEndpointAliases"},{"type":"text","text":", contract 1.40; the"},{"type":"text","text":" "},{"type":"text","text":"seventh, CIBA’s "},{"type":"codeVoice","code":"backchannel_authentication_endpoint"},{"type":"text","text":", joined in contract 1.58)."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"references":{"doc://AxiamSDK/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/s8SendableP","title":"Swift.Sendable"},"doc://AxiamSDK/documentation/AxiamSDK/MtlsEndpointAliases/revocationEndpoint":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"revocationEndpoint","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"RFC 7009 §2.1 