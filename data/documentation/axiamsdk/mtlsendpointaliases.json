,"doc:\/\/AxiamSDK\/s8SendableP"],"kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MtlsEndpointAliases","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A TLS listener decides whether to request a client certificate during the handshake,"},{"type":"text","text":" "},{"type":"text","text":"before it has seen any HTTP, so “ask for a certificate on "},{"type":"codeVoice","code":"\/oauth2\/token"},{"type":"text","text":" but not on"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/oauth2\/authorize"},{"type":"text","text":"” is not something one listener can do. A deployment wanting both runs"},{"type":"text","text":" "},{"type":"text","text":"two, and this object names the second."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only these six are ever aliased. "},{"code":"authorization_endpoint","type":"codeVoice"},{"type":"text","text":" and "},{"code":"end_session_endpoint","type":"codeVoice"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"front-channel and "},{"code":"jwks_uri","type":"codeVoice"},{"type":"text","text":" is public key material, so §21.3 rule 2 forbids synthesising"},{"type":"text","text":" "},{"type":"text","text":"an alias for any of them — sending a browser to an mTLS host raises a native"},{"type":"text","text":" "},{"type":"text","text":"certificate-chooser dialog most users cannot answer. "},{"code":"issuer","type":"codeVoice"},{"type":"text","text":" is not an endpoint and does"},{"type":"text","text":" "},{"type":"text","text":"not move either: §12.4 rule 3 still compares "},{"code":"iss","type":"codeVoice"},{"type":"text","text":" against it by exact string."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Every property is optional"}],"type":"strong"},{"text":", though the server’s schema marks all six required. AXIAM","type":"text"},{"text":" ","type":"text"},{"text":"builds them from one path through a shared macro and so always publishes the complete set,","type":"text"},{"text":" ","type":"text"},{"text":"but RFC 8705 §5 permits an OP to alias fewer, and the shape of this member must never be","type":"text"},{"text":" ","type":"text"},{"text":"why a client stops working — the same principle rule 2 point 1 states for the object as a","type":"text"},{"text":" ","type":"text"},{"text":"whole, one level in. A ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" entry falls back to the top-level endpoint of the same name,","type":"text"},{"text":" ","type":"text"},{"text":"exactly as an absent object does.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MtlsEndpointAliases"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","title":"AxiamSDK","role":"collection","kind":"symbol","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/MtlsEndpointAliases/pushedAuthorizationRequestEndpoint":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MtlsEndpointAliases\/pushedAuthorizationRequestEndpoint","abstract":[{"text":"RFC 9126 §2 — authenticates the client.","type":"text"}],"title":"pushedAuthorizationRequestEndpoint","url":"\/documentation\/axiamsdk\/mtlsendpointaliases\/pushedauthorizationrequestendpoint","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pushedAuthorizationRequestEndpoint","kind":"identifier"},{"text":": ","ki