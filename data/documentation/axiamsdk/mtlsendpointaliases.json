:"text"},{"text":"MtlsEndpointAliases","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A TLS listener decides whether to request a client certificate during the handshake,"},{"type":"text","text":" "},{"type":"text","text":"before it has seen any HTTP, so “ask for a certificate on "},{"type":"codeVoice","code":"\/oauth2\/token"},{"type":"text","text":" but not on"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/oauth2\/authorize"},{"type":"text","text":"” is not something one listener can do. A deployment wanting both runs"},{"type":"text","text":" "},{"type":"text","text":"two, and this object names the second."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only these seven are ever aliased. "},{"type":"codeVoice","code":"authorization_endpoint"},{"type":"text","text":" and "},{"type":"codeVoice","code":"end_session_endpoint"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"front-channel and "},{"type":"codeVoice","code":"jwks_uri"},{"type":"text","text":" is public key material, so §21.3 rule 2 forbids synthesising"},{"type":"text","text":" "},{"type":"text","text":"an alias for any of them — sending a browser to an mTLS host raises a native"},{"type":"text","text":" "},{"type":"text","text":"certificate-chooser dialog most users cannot answer. "},{"type":"codeVoice","code":"issuer"},{"type":"text","text":" is not an endpoint and does"},{"type":"text","text":" "},{"type":"text","text":"not move either: §12.4 rule 3 still compares "},{"type":"codeVoice","code":"iss"},{"type":"text","text":" against it by exact string."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Every property is optional"}],"type":"strong"},{"text":", though the server’s schema marks them required. AXIAM","type":"text"},{"text":" ","type":"text"},{"text":"builds them from one path through a shared macro and so always publishes the complete set,","type":"text"},{"text":" ","type":"text"},{"text":"but RFC 8705 §5 permits an OP to alias fewer, and the shape of this member must never be","type":"text"},{"text":" ","type":"text"},{"text":"why a client stops working — the same principle rule 2 point 1 states for the object as a","type":"text"},{"text":" ","type":"text"},{"text":"whole, one level in. A ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" entry falls back to the top-level endpoint of the same name,","type":"text"},{"text":" ","type":"text"},{"text":"exactly as an absent object does.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MtlsEndpointAliases","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/mtlsendpointaliases"]}],"abstract":[{"type":"text","text":"RFC 8705 §5 "},{"type":"codeVoice","code":"mtls_endpoint_aliases"},{"type":"text","text":" — the seven endpoints re-based on the host that"},{"type":"text","text":" "},{"type":"text","text":"performs the mutual-TLS handshake (wire schema "},{"type":"codeVoice","code":"MtlsEndpointAliases"},{"type":"text","text":", contract 1.40; the"},{"type":"text","text":" "},{"type":"text","text":"seventh, CIBA’s "},{"type":"codeVoice","code":"backchannel_authentication_endpoint"},{"type":"text","text":", joined in contract 1.58)."}],"references":{"doc://AxiamSDK/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/AxiamSDK\/SQ","type":"unresolvable"},"doc://AxiamSDK/s16SendableMetatypeP":{"identifier":"doc:\/\/AxiamSDK\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://AxiamSDK/documentation/AxiamSDK/MtlsEndpointAliases/init(from:)":{"url":"\/documentation\/axiamsdk\/mtlsendpointaliases\/init(from:)","abstract":[],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MtlsEndpointAlia