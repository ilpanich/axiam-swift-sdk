"text","text":" when no credential is present, the JWT is malformed, the"},{"type":"text","text":" "},{"type":"text","text":"algorithm is not EdDSA, the signature is invalid, "},{"type":"codeVoice","code":"exp"},{"type":"text","text":" is absent\/non-numeric\/past,"},{"type":"text","text":" "},{"type":"codeVoice","code":"nbf"},{"type":"text","text":" is in the future, the token does not belong to the configured tenant, the tenant"},{"type":"text","text":" "},{"type":"text","text":"does not match the request’s "},{"type":"codeVoice","code":"X-Tenant-ID"},{"type":"text","text":", or a configured issuer\/audience does not"},{"type":"text","text":" "},{"type":"text","text":"match."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticate(_:)"},{"type":"text","text":" plus CONTRACT.md §10.1 "},{"type":"strong","inlineContent":[{"type":"text","text":"rule 9"}]},{"type":"text","text":" — the sender constraint"},{"type":"text","text":" "},{"type":"text","text":"(RFC 8705 §3 \/ RFC 7800, contract 1.15)."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"},{"inlineContent":[{"text":"This is the guard entry point for a resource server that accepts","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"certificate-bound"}],"type":"strong"},{"text":" access tokens. ","type":"text"},{"code":"presentedThumbprint","type":"codeVoice"},{"text":" is the RFC 8705 §3.1","type":"text"},{"text":" ","type":"text"},{"code":"x5t#S256","type":"codeVoice"},{"text":" of the client certificate on the current connection, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"text":"there is none; ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/certificateThumbprintS256(der:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"computes it from DER bytes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A separate method rather than a parameter on ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticate(_:)","isActive":true,"type":"reference"},{"text":" because the two","type":"text"},{"text":" ","type":"text"},{"text":"have different ","type":"text"},{"inlineContent":[{"type":"text","text":"inputs"}],"type":"emphasis"},{"text":": most integrations have no transport-level certificate to","type":"text"},{"text":" ","type":"text"},{"text":"offer, and folding the thumbprint in would force every caller to thread a ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"text":"they do not have — which reads as “no certificate” and rejects every bound token.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"An unbound token is still accepted"}]},{"type":"text","text":" here, with or without a certificate. Rule 9"},{"type":"text","text":" "},{"type":"text","text":"constrains tokens that claim a constraint; it does not make certificates mandatory."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"The thumbprint must come from the transport","type":"text"}]},{"type":"text","text":" — the TLS peer certificate, or a"},{"type":"text","text":" "},{"type":"text","text":"value a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"trusted"}]},{"type":"text","text":" terminating proxy forwarded over a channel your application"},{"type":"text","text":" "},{"type":"text","text":"controls. Never from a caller-settable request header: a forgeable input makes the"},{"type":"text","text":" "},{"type":"text","text":"whole mechanism decorative."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthError","isActive":true},{"type":"text","text":" on everything "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticate(_:)","isActive":true},{"type":"text","text":" throws, plus the three"},{"type":"text","text":" "},{"type":"text","text":"rejecting rows of "},{"code":"verifyCertificateBinding(_:presentedThumbprint:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"}]}],"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/axiamrequestauthenticator\/authenticatesenderconstrained(_:presentedthumbprint:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticateSenderConstrained(_:presentedThumbprint:)"},"kind":"symbol","metadata":{"title":"authenticateSenderConstrained(_:presentedThumbprint:)","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:8AxiamSDK0A20RequestAuthenticatorV29authenticateSenderConstrained_19presentedThumbprintAA0A4UserVAA0aC7ContextV_SSSgtYaKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticateSenderConstrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AxiamRequestContext","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"presentedThumbprint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamUser","preciseIdentifier":"s:8AxiamSDK0A4UserV","kind":"typeIdentifier"}],"role":"symbol"},"abstract":[{"type":"text","text":"Authenticate an inbound request, returning the verified identity."}],"schema