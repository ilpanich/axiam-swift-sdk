type":"strong"},{"text":" token — every token before §6.1 existed, and","type":"text"},{"text":" ","type":"text"},{"text":"every one a non-mTLS deployment will ever mint — verifies exactly as before. A","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"bound","type":"text"}],"type":"strong"},{"text":" token — notably a §6.1 device login’s token — is now refused at this","type":"text"},{"text":" ","type":"text"},{"text":"default entry point unless the caller threads through the evidence it holds.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Before contract 1.51 this method applied rules 1-8 only and never rule 9, so a","type":"text"},{"text":" ","type":"text"},{"text":"certificate-bound token lifted off a device and replayed as a bearer credential","type":"text"},{"text":" ","type":"text"},{"text":"was accepted here — the defect §10.1 rule 9 exists to close. Every route guard in","type":"text"},{"text":" ","type":"text"},{"text":"this SDK (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards"},{"text":", the §11 helpers, the §28 MCP guard) reaches this","type":"text"},{"text":" ","type":"text"},{"text":"method, so the fix is here rather than duplicated at each call site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A raw signature-only primitive ("},{"type":"codeVoice","code":"JwksVerifier\/verifySignatureOnlyUnchecked(token:)"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"is deliberately "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"type":"text","text":" a substitute for this method."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticate(_:presentedProofs:)"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/A