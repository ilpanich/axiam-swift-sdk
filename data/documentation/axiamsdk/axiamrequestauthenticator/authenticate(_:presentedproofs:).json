{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticate(_:presentedProofs:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"context"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK0A14RequestContextV","kind":"typeIdentifier","text":"AxiamRequestContext","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestContext"},{"kind":"text","text":", "},{"kind":"externalParam","text":"presentedProofs"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK15PresentedProofsV","kind":"typeIdentifier","text":"PresentedProofs","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PresentedProofs"},{"kind":"text","text":" = .none) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK0A4UserV","kind":"typeIdentifier","text":"AxiamUser","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applies the full §10.1 minimum local-verification set, "},{"type":"strong","inlineContent":[{"type":"text","text":"including rule 9"}]},{"type":"text","text":" "},{"type":"text","text":"(contract 1.51): a token carrying "},{"code":"cnf","type":"codeVoice"},{"type":"text","text":" is not a bearer token and MUST NOT be"},{"type":"text","text":" "},{"type":"text","text":"accepted as one. "},{"code":"presentedProofs","type":"codeVoice"},{"type":"text","text":" is what the caller proved on "},{"inlineContent":[{"text":"this","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"connection — a certificate the transport verified, a DPoP proof the caller"},{"type":"text","text":" "},{"type":"text","text":"itself verified, or both."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"presentedProofs","type":"codeVoice"},{"text":" defaults to ","type":"text"},{"code":".none","type":"codeVoice"},{"text":",","type":"text"}]},{"type":"text","text":" which is the correct value for the"},{"type":"text","text":" "},{"type":"text","text":"overwhelming majority of callers: this SDK ships no HTTP server of its own, so a"},{"type":"text","text":" "},{"type":"text","text":"caller with nothing to prove passes nothing. Rule 9’s own first row is “absent"},{"type":"text","text":" "},{"type":"codeVoice","code":"cnf"},{"type":"text","text":" → returns”, so an "},{"type":"strong","inlineContent":[{"text":"unbound","type":"text"}]},{"type":"text","text":" token — every token before §6.1 existed, and"},{"type":"text","text":" "},{"type":"text","text":"every one a non-mTLS deployment will ever mint — verifies exactly as before. A"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"bound"}]},{"type":"text","text":" token — notably a §6.1 device login’s token — is now refused at this"},{"type":"text","text":" "},{"type":"text","text":"default entry point unless the caller threads through the evidence it holds."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before contract 1.51 this method applied rules 1-8 only and never rule 9, so a"},{"type":"text","text":" "},{"type":"text","text":"certificate-bound token lifted off a device and replayed as a bearer credential"},{"type":"text","text":" "},{"type":"text","text":"was accepted here — the defect §10.1 rule 9 exists to close. Every route guard in"},{"type":"text","text":" "},{"type":"text","text":"this SDK ("},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards","type":"reference","isActive":true},{"type":"text","text":", the §11 helpers, the §28 MCP guard) reaches this"},{"type":"text","text":" "},{"type":"text","text":"method, so the fix is here rather than duplicated at each call site."}]},{"type":"paragraph","inlineContent":[{"text":"A raw signature-only primitive (","type":"text"},{"code":"JwksVerifier\/verifySignatureOnlyUnchecked(token:)","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"is deliberately ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" a substitute for this method.","type":"text"}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator"]]},"abstract":[{"type":"text","text":"Authenticate an inbound request, returning the verified identity."}],"metadata":{"role":"symbol","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV","text":"AxiamRequestContext"},{"text":", ","kind":"text"},{"text":"presentedProofs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PresentedProofs","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamUser","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A4UserV"}],"title":"authenticate(_:presentedProofs:)","externalID":"s:8AxiamSDK0A20RequestAuthenticatorV12authenticate_15presentedProofsAA0A4UserVAA0aC7ContextV_AA09PresentedG0VtYaKF","modules":[{"name":"AxiamSDK"}]},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamrequestauthenticator\/authenticate(_:presentedproofs:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamGuards":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards","abstract":[{"type":"text","text":"Declarative authorization helper factories (§11 of CONTRACT.md)."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamGuards","kind":"identifier"}],"navigatorTitle":[{"text":"AxiamGuards","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamguards","type":"topic","title":"AxiamGuards"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser":{"title":"AxiamUser","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamUser","kind":"identifier"}],"abstract":[{"text":"An authenticated AXIAM identity.","type":"text"}],"navigatorTitle":[{"text":"AxiamUser","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","url":"\/documentation\/axiamsdk\/axiamuser","kind":"symbol","type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/PresentedProofs":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PresentedProofs","kind":"identifier"}],"title":"PresentedProofs","url":"\/documentation\/axiamsdk\/presentedproofs","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PresentedProofs","kind":"symbol","navigatorTitle":[{"text":"PresentedProofs","kind":"identifier"}],"abstract":[{"type":"text","text":"What the caller proved about "},{"type":"strong","inlineContent":[{"type":"text","text":"this"}]},{"type":"text","text":" connection and "},{"type":"strong","inlineContent":[{"type":"text","text":"this"}]},{"type":"text","text":" request, for"},{"type":"text","text":" "},{"type":"codeVoice","code":"AxiamRequestAuthenticator\/verifyTokenBinding(_:proofs:)"},{