{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamrequestauthenticator\/authenticate(_:presentedproofs:)"]}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"context","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestContext","kind":"typeIdentifier","text":"AxiamRequestContext","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"presentedProofs"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PresentedProofs","kind":"typeIdentifier","text":"PresentedProofs","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV"},{"kind":"text","text":" = .none) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","kind":"typeIdentifier","text":"AxiamUser","preciseIdentifier":"s:8AxiamSDK0A4UserV"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Applies the full §10.1 minimum local-verification set, "},{"type":"strong","inlineContent":[{"text":"including rule 9","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"(contract 1.51): a token carrying "},{"code":"cnf","type":"codeVoice"},{"type":"text","text":" is not a bearer token and MUST NOT be"},{"type":"text","text":" "},{"type":"text","text":"accepted as one. "},{"code":"presentedProofs","type":"codeVoice"},{"type":"text","text":" is what the caller proved on "},{"type":"strong","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"connection — a certificate the transport verified, a DPoP proof the caller"},{"type":"text","text":" "},{"type":"text","text":"itself verified, or both."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"code":"presentedProofs","type":"codeVoice"},{"type":"text","text":" defaults to "},{"code":".none","type":"codeVoice"},{"type":"text","text":","}]},{"type":"text","text":" which is the correct value for the"},{"type":"text","text":" "},{"type":"text","text":"overwhelming majority of callers: this SDK ships no HTTP server of its own, so a"},{"type":"text","text":" "},{"type":"text","text":"caller with nothing to prove passes nothing. Rule 9’s own first row is “absent"},{"type":"text","text":" "},{"type":"codeVoice","code":"cnf"},{"type":"text","text":" → returns”, so an "},{"type":"strong","inlineContent":[{"text":"unbound","type":"text"}]},{"type":"text","text":" token — every token before §6.1 existed, and"},{"type":"text","text":" "},{"type":"text","text":"every one a non-mTLS deployment will ever mint — verifies exactly as before. A"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"bound"}]},{"type":"text","text":" token — notably a §6.1 device login’s token — is now refused at this"},{"type":"text","text":" "},{"type":"text","text":"default entry point unless the caller threads through the evidence it holds."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Before contract 1.51 this method applied rules 1-8 only and never rule 9, so a"},{"type":"text","text":" "},{"type":"text","text":"certificate-bound token lifted off a device and replayed as a bearer credential"},{"type":"text","text":" "},{"type":"text","text":"was accepted here — the defect §10.1 rule 9 exists to close. Every route guard in"},{"type":"text","text":" "},{"type":"text","text":"this SDK ("},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards","isActive":true},{"type":"text","text":", the §11 helpers, the §28 MCP guard) reaches this"},{"type":"text","text":" "},{"type":"text","text":"method, so the fix is here rather than duplicated at each call site."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A raw signature-only primitive ("},{"type":"codeVoice","code":"JwksVerifier\/verifySignatureOnlyUnchecked(token:)"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"is deliberately "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" a substitute for this method."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Authenticate an inbound request, returning the verified identity.","type":"text"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticate(_:presentedProofs:)","interfaceLanguage":"swift"},"metadata":{"externalID":"s:8AxiamSDK0A20RequestAuthenticatorV12authenticate_15presentedProofsAA0A4UserVAA0aC7ContextV_AA09PresentedG0VtYaKF","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AxiamRequestContext","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV"},{"text":", ","kind":"text"},{"text":"presentedProofs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PresentedProofs","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamUser","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A4UserV"}],"roleHeading":"Instance Method","title":"authenticate(_:presentedProofs:)","symbolKind":"method","modules":[{"name":"AxiamSDK"}]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamRequestContext":{"kind":"symbol","title":"AxiamRequestContext","role":"symbol","navigatorTitle":[{"text":"AxiamRequestContext","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamRequestContext","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestContext","abstract":[{"text":"A minimal, framework-agnostic view of an inbound request: its headers and cookies.","type":"text"}],"url":"\/documentation\/axiamsdk\/axiamrequestcontext","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/PresentedProofs":{"type":"topic","url":"\/documentation\/axiamsdk\/presentedproofs","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PresentedProofs","navigatorTitle":[{"kind":"identifier","text":"PresentedProofs"}],"kind":"symbol","title":"PresentedProofs","abstract":[{"text":"What the caller proved about ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"this"}]},{"text":" connection and ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"this"}]},{"text":" request, for","type":"text"},{"text":" ","type":"text"},{"code":"AxiamRequestAuthenticator\/verifyTokenBinding(_:proofs:)","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PresentedProofs"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamRequestAuthenticator":{"title":"AxiamRequestAuthenticator","abstract":[{"text":"Framework-agnostic resource-server guard (§10 of CONTRACT.md).","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamRequestAuthenticator","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamrequestauthenticator","navigatorTitle":[{"text":"AxiamRequestAuthenticator","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser":{"navigatorTitle":[{"text":"AxiamUser","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/axiamuser","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamUser","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","abstract":[{"type":"text","text":"An authenticated AXIAM identity."}],"title":"AxiamUser","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamRequestAuthenticator/authenticate(_:presentedProofs:)":{"title":"authenticate(_:presentedProofs:)","url":"\/documentation\/axiamsdk\/axiamrequestauthenticator\/authenticate(_:presentedproofs:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AxiamRequestContext","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV"},{"text":", ","kind":"text"},{"text":"presentedProofs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PresentedProofs","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamUser","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A4UserV"}],"type":"topic","role":"symbo