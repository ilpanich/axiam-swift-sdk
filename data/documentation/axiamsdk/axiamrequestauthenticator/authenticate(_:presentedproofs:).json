{"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticate(_:presentedProofs:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Authenticate an inbound request, returning the verified identity."}],"metadata":{"title":"authenticate(_:presentedProofs:)","role":"symbol","externalID":"s:8AxiamSDK0A20RequestAuthenticatorV12authenticate_15presentedProofsAA0A4UserVAA0aC7ContextV_AA09PresentedG0VtYaKF","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"AxiamRequestContext","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"presentedProofs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PresentedProofs","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"AxiamUser","preciseIdentifier":"s:8AxiamSDK0A4UserV"}]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamrequestauthenticator\/authenticate(_:presentedproofs:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"context","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"AxiamRequestContext","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestContext","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"presentedProofs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PresentedProofs","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PresentedProofs","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV","kind":"typeIdentifier"},{"text":" = .none) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamUser","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","preciseIdentifier":"s:8AxiamSDK0A4UserV","kind":"typeIdentifier"}]}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applies the full §10.1 minimum local-verification set, "},{"type":"strong","inlineContent":[{"text":"including rule 9","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"(contract 1.51): a token carrying "},{"type":"codeVoice","code":"cnf"},{"type":"text","text":" is not a bearer token and MUST NOT be"},{"type":"text","text":" "},{"type":"text","text":"accepted as one. "},{"type":"codeVoice","code":"presentedProofs"},{"type":"text","text":" is what the caller proved on "},{"type":"strong","inlineContent":[{"type":"text","text":"this"}]},{"type":"text","text":" "},{"type":"text","text":"connection — a certificate the transport verified, a DPoP proof the caller"},{"type":"text","text":" "},{"type":"text","text":"itself verified, or both."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"presentedProofs"},{"text":" defaults to ","type":"text"},{"type":"codeVoice","code":".none"},{"text":",","type":"text"}],"type":"strong"},{"type":"text","text":" which is the correct value for the"},{"type":"text","text":" "},{"type":"text","text":"overwhelming majority of callers: this SDK ships no HTTP server of its own, so a"},{"type":"text","text":" "},{"type":"text","text":"caller with nothing to prove passes nothing. Rule 9’s own first row is “absent"},{"type":"text","text":" "},{"type":"codeVoice","code":"cnf"},{"type":"text","text":" → returns”, so an "},{"inlineContent":[{"type":"text","text":"unbound"}],"type":"strong"},{"type":"text","text":" token — every token before §6.1 existed, and"},{"type":"text","text":" "},{"type":"text","text":"every one a non-mTLS deployment will ever mint — verifies exactly as before. A"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"bound"}],"type":"strong"},{"type":"text","text":" token — notably a §6.1 device login’s token — is now refused at this"},{"type":"text","text":" "},{"type":"text","text":"default entry point unless the caller threads through the evidence it holds."}]},{"type":"paragraph","inlineContent":[{"text":"Before contract 1.51 this method applied rules 1-8 only and never rule 9, so a","type":"text"},{"text":" ","type":"text"},{"text":"certificate-bound token lifted off a device and replayed as a bearer credential","type":"text"},{"text":" ","type":"text"},{"text":"was accepted here — the defect §10.1 rule 9 exists to close. Every route guard in","type":"text"},{"text":" ","type":"text"},{"text":"this SDK (","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards","isActive":true},{"text":", the §11 helpers, the §28 MCP guard) reaches this","type":"text"},{"text":" ","type":"text"},{"text":"method, so the fix is here rather than duplicated at each call site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A raw signature-only primitive ("},{"type":"codeVoice","code":"JwksVerifier\/verifySignatureOnlyUnchecked(token:)"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"is deliberately "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" a substitute for this method."}]}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/PresentedProofs":{"title":"PresentedProofs","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PresentedProofs","kind":"identifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/presentedproofs","abstract":[{"type":"text","text":"What the caller proved about "},{"type":"strong","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" connection and "},{"type":"strong","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" request, for"},{"type":"text","text":" "},{"type":"codeVoice","code":"AxiamRequestAuthenticator\/verifyTokenBinding(_:proofs:)"},{"type":"text","text":"."}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PresentedProofs","navigatorTitle":[{"text":"PresentedProofs","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamRequestContext":{"url":"\/documentation\/axiamsdk\/axiamrequestcontext","navigatorTitle":[{"text":"AxiamRequestContext","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestContext","kind":"symbol","title":"AxiamRequestContext","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamRequestContext","kind":"identifier"}],"type":"topic","abstract":[{"text":"A minimal, framework-agnostic view of an inbound request: its headers and cookies.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamRequestAuthenticator/authenticate(_:presentedProofs:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8AxiamSDK0A14RequestContextV","kind":"typeIdentifier","text":"AxiamRequestContext"},{"kind":"text","text":", "},{"kind":"externalParam","text":"presentedProofs"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK15PresentedProofsV","kind":"typeIdentifier","text":"PresentedProofs"},{"kind":"text","text":") "},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK0A4UserV","text":"AxiamUser","kind":"typeIdentifier"}],"url":"\/documentation\/axiamsdk\/axiamrequestauthenticator\/authenticate(_:presentedproofs:)","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticate(_:presentedProofs:)","abstract":[{"text":"Authenticate an inbound request, returning the verified identity.","type":"text"}],"role":"symbol","title":"authenticate(_:presentedProofs:)","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamGuards":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamGuards"}],"url":"\/documentation\/axiamsdk\/axiamguards","navigatorTitle":[{"kind":"identifier","text":"AxiamGuards"}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards","title":"AxiamGuards","abstract":[{"text":"Declarative authorization helper factories (§11 of CONTRACT.md).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamRequestAuthenticator":{"role":"symbol","url":"\/documentation\/axiamsdk\/axiamrequestauthenticator","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamRequestAuthenticator"}],"title":"AxiamRequestAuthenticator","navigatorTitle":[{"kind":"identifier","text":"AxiamRequestAuthenticator"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator","abstract":[{"text":"Framework-agnostic resource-server guard (§10 of CONTRACT.md).","type":"text"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"abs