{"kind":"symbol","abstract":[{"type":"text","text":"Authenticate an inbound request, returning the verified identity."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"context"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestContext","kind":"typeIdentifier","text":"AxiamRequestContext","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"presentedProofs"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PresentedProofs","kind":"typeIdentifier","text":"PresentedProofs","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV"},{"kind":"text","text":" = .none) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","kind":"typeIdentifier","text":"AxiamUser","preciseIdentifier":"s:8AxiamSDK0A4UserV"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applies the full §10.1 minimum local-verification set, "},{"type":"strong","inlineContent":[{"text":"including rule 9","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"(contract 1.51): a token carrying "},{"type":"codeVoice","code":"cnf"},{"type":"text","text":" is not a bearer token and MUST NOT be"},{"type":"text","text":" "},{"type":"text","text":"accepted as one. "},{"type":"codeVoice","code":"presentedProofs"},{"type":"text","text":" is what the caller proved on "},{"type":"strong","inlineContent":[{"type":"text","text":"this"}]},{"type":"text","text":" "},{"type":"text","text":"connection — a certificate the transport verified, a DPoP proof the caller"},{"type":"text","text":" "},{"type":"text","text":"itself verified, or both."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"presentedProofs"},{"type":"text","text":" defaults to "},{"type":"codeVoice","code":".none"},{"type":"text","text":","}]},{"type":"text","text":" which is the correct value for the"},{"type":"text","text":" "},{"type":"text","text":"overwhelming majority of callers: this SDK ships no HTTP server of its own, so a"},{"type":"text","text":" "},{"type":"text","text":"caller with nothing to prove passes nothing. Rule 9’s own first row is “absent"},{"type":"text","text":" "},{"code":"cnf","type":"codeVoice"},{"type":"text","text":" → returns”, so an "},{"type":"strong","inlineContent":[{"type":"text","text":"unbound"}]},{"type":"text","text":" token — every token before §6.1 existed, and"},{"type":"text","text":" "},{"type":"text","text":"every one a non-mTLS deployment will ever mint — verifies exactly as before. A"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"bound","type":"text"}]},{"type":"text","text":" token — notably a §6.1 device login’s token — is now refused at this"},{"type":"text","text":" "},{"type":"text","text":"default entry point unless the caller threads through the evidence it holds."}]},{"type":"paragraph","inlineContent":[{"text":"Before contract 1.51 this method applied rules 1-8 only and never rule 9, so a","type":"text"},{"text":" ","type":"text"},{"text":"certificate-bound token lifted off a device and replayed as a bearer credential","type":"text"},{"text":" ","type":"text"},{"text":"was accepted here — the defect §10.1 rule 9 exists to close. Every route guard in","type":"text"},{"text":" ","type":"text"},{"text":"this SDK (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards"},{"text":", the §11 helpers, the §28 MCP guard) reaches this","type":"text"},{"text":" ","type":"text"},{"text":"method, so the fix is here rather than duplicated at each call site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A raw signature-only primitive (","type":"text"},{"code":"JwksVerifier\/verifySignatureOnlyUnchecked(token:)","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"is deliberately ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" a substitute for this method.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamrequestauthenticator\/authenticate(_:presentedproofs:)"]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AxiamRequestContext","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV"},{"text":", ","kind":"text"},{"text":"presentedProofs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PresentedProofs","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamUser","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A4UserV"}],"externalID":"s:8AxiamSDK0A20RequestAuthenticatorV12authenticate_15presentedProofsAA0A4UserVAA0aC7ContextV_AA09PresentedG0VtYaKF","role":"symbol","modules":[{"name":"AxiamSDK"}],"title":"authenticate(_:presentedProofs:)"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticate(_:presentedProofs:)"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PresentedProofs":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PresentedProofs"}],"url":"\/documentation\/axiamsdk\/presentedproofs","type":"topic","title":"PresentedProofs","abstract":[{"type":"text","text":"What the caller proved about "},{"type":"strong","inlineContent":[{"type":"text","text":"this"}]},{"type":"text","text":" connection and "},{"type":"strong","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" request, for"},{"type":"text","text":" "},{"type":"codeVoice","code":"AxiamRequestAuthenticator\/verifyTokenBinding(_:proofs:)"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"PresentedProofs"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PresentedProofs"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamRequestAuthenticator":{"abstract":[{"text":"Framework-agnostic resource-server guard (§10 of CONTRACT.md).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamRequestAuthenticator"}],"title":"AxiamRequestAuthenticator","kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/axiamrequestauthenticator","navigatorTitle":[{"kind":"identifier","text":"AxiamRequestAuthenticator"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser":{"navigatorTitle":[{"text":"AxiamUser","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamUser","kind":"identifier"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"An authe