{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"symbol","title":"authenticate(_:presentedProofs:)","externalID":"s:8AxiamSDK0A20RequestAuthenticatorV12authenticate_15presentedProofsAA0A4UserVAA0aC7ContextV_AA09PresentedG0VtYaKF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AxiamRequestContext","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"presentedProofs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PresentedProofs","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamUser","preciseIdentifier":"s:8AxiamSDK0A4UserV","kind":"typeIdentifier"}],"modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"context","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestContext","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV","text":"AxiamRequestContext","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"presentedProofs","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PresentedProofs","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV","text":"PresentedProofs","kind":"typeIdentifier"},{"text":" = .none) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","preciseIdentifier":"s:8AxiamSDK0A4UserV","text":"AxiamUser","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applies the full §10.1 minimum local-verification set, "},{"type":"strong","inlineContent":[{"text":"including rule 9","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"(contract 1.51): a token carrying "},{"type":"codeVoice","code":"cnf"},{"type":"text","text":" is not a bearer token and MUST NOT be"},{"type":"text","text":" "},{"type":"text","text":"accepted as one. "},{"type":"codeVoice","code":"presentedProofs"},{"type":"text","text":" is what the caller proved on "},{"type":"strong","inlineContent":[{"type":"text","text":"this"}]},{"type":"text","text":" "},{"type":"text","text":"connection — a certificate the transport verified, a DPoP proof the caller"},{"type":"text","text":" "},{"type":"text","text":"itself verified, or both."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"presentedProofs"},{"type":"text","text":" defaults to "},{"type":"codeVoice","code":".none"},{"type":"text","text":","}],"type":"strong"},{"type":"text","text":" which is the correct value for the"},{"type":"text","text":" "},{"type":"text","text":"overwhelming majority of callers: this SDK ships no HTTP server of its own, so a"},{"type":"text","text":" "},{"type":"text","text":"caller with nothing to prove passes nothing. Rule 9’s own first row is “absent"},{"type":"text","text":" "},{"type":"codeVoice","code":"cnf"},{"type":"text","text":" → returns”, so an "},{"inlineContent":[{"text":"unbound","type":"text"}],"type":"strong"},{"type":"text","text":" token — every token before §6.1 existed, and"},{"type":"text","text":" "},{"type":"text","text":"every one a non-mTLS deployment will ever mint — verifies exactly as before. A"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"bound"}],"type":"strong"},{"type":"text","text":" token — notably a §6.1 device login’s token — is now refused at this"},{"type":"text","text":" "},{"type":"text","text":"default entry point unless the caller threads through the evidence it holds."}]},{"type":"paragraph","inlineContent":[{"text":"Before contract 1.51 this method applied rules 1-8 only and never rule 9, so a","type":"text"},{"text":" ","type":"text"},{"text":"certificate-bound token lifted off a device and replayed as a bearer credential","type":"text"},{"text":" ","type":"text"},{"text":"was accepted here — the defect §10.1 rule 9 exists to close. Every route guard in","type":"text"},{"text":" ","type":"text"},{"text":"this SDK (","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards","isActive":true,"type":"reference"},{"text":", the §11 helpers, the §28 MCP guard) reaches this","type":"text"},{"text":" ","type":"text"},{"text":"method, so the fix is here rather than duplicated at each call site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A raw signature-only primitive ("},{"code":"JwksVerifier\/verifySignatureOnlyUnchecked(token:)","type":"codeVoice"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"is deliberately "},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"type":"text","text":" a substitute for this method."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticate(_:presentedProofs:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Authenticate an inbound request, returning the verified identity."}],"sections":[],"variants":[