{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"AxiamRequestContext","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"presentedProofs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PresentedProofs","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"AxiamUser","preciseIdentifier":"s:8AxiamSDK0A4UserV"}],"modules":[{"name":"AxiamSDK"}],"role":"symbol","title":"authenticate(_:presentedProofs:)","roleHeading":"Instance Method","externalID":"s:8AxiamSDK0A20RequestAuthenticatorV12authenticate_15presentedProofsAA0A4UserVAA0aC7ContextV_AA09PresentedG0VtYaKF"},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator\/authenticate(_:presentedProofs:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"context","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"AxiamRequestContext","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestContext","preciseIdentifier":"s:8AxiamSDK0A14RequestContextV"},{"text":", ","kind":"text"},{"text":"presentedProofs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PresentedProofs","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PresentedProofs","preciseIdentifier":"s:8AxiamSDK15PresentedProofsV"},{"text":" = .none) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AxiamUser","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","preciseIdentifier":"s:8AxiamSDK0A4UserV"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applies the full §10.1 minimum local-verification set, "},{"inlineContent":[{"text":"including rule 9","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"(contract 1.51): a token carrying "},{"type":"codeVoice","code":"cnf"},{"type":"text","text":" is not a bearer token and MUST NOT be"},{"type":"text","text":" "},{"type":"text","text":"accepted as one. "},{"type":"codeVoice","code":"presentedProofs"},{"type":"text","text":" is what the caller proved on "},{"inlineContent":[{"type":"text","text":"this"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"connection — a certificate the transport verified, a DPoP proof the caller"},{"type":"text","text":" "},{"type":"text","text":"itself verified, or both."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"presentedProofs"},{"type":"text","text":" defaults to "},{"type":"codeVoice","code":".none"},{"type":"text","text":","}]},{"type":"text","text":" which is the correct value for the"},{"type":"text","text":" "},{"type":"text","text":"overwhelming majority of callers: this SDK ships no HTTP server of its own, so a"},{"type":"text","text":" "},{"type":"text","text":"caller with nothing to prove passes nothing. Rule 9’s own first row is “absent"},{"type":"text","text":" "},{"type":"codeVoice","code":"cnf"},{"type":"text","text":" → returns”, so an "},{"type":"strong","inlineContent":[{"text":"unbound","type":"text"}]},{"type":"text","text":" token — every token before §6.1 existed, and"},{"type":"text","text":" "},{"type":"text","text":"every one a non-mTLS deployment will ever mint — verifies exactly as before. A"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"bound","type":"text"}]},{"type":"text","text":" token — notably a §6.1 device login’s token — is now refused at this"},{"type":"text","text":" "},{"type":"text","text":"default entry point unless the caller threads through the evidence it holds."}]},{"type":"paragraph","inlineContent":[{"text":"Before contract 1.51 this method applied rules 1-8 only and never rule 9, so a","type":"text"},{"text":" ","type":"text"},{"text":"certificate-bound token lifted off a device and replayed as a bearer credential","type":"text"},{"text":" ","type":"text"},{"text":"was accepted here — the defect §10.1 rule 9 exists to close. Every route guard in","type":"text"},{"text":" ","type":"text"},{"text":"this SDK (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards"},{"text":", the §11 helpers, the §28 MCP guard) reaches this","type":"text"},{"text":" ","type":"text"},{"text":"method, so the fix is here rather than duplicated at each call site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A raw signature-only primitive ("},{"type":"codeVoice","code":"JwksVerifier\/verifySignatureOnlyUnchecked(token:)"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"is deliberately "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" a substitute for this method."}]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamrequestauthenticator\/authenticate(_:presentedproofs:)"]}],"abstract":[{"type":"text","text":"Authenticate an inbound request, returning the verified identity."}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser":{"role":"symbol","navigatorTitle":[{"text":"AxiamUser","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","url":"\/documentation\/axiamsdk\/axiamuser","title":"AxiamUser","abstract":[{"type":"text","text":"An authenticated AXIAM identity."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamUser","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamRequestAuthenticator":{"role":"symbol","navigatorTitle":[{"text":"AxiamRequestAuthenticator","kind":"identifier"}],"title":"AxiamRequestAuthenticator","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestAuthenticator","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamrequestauthenticator","type":"topic","abstract":[{"type":"text","text":"Framework-agnostic resource-server guard (§10 of CONTRACT.md)."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamRequestAuthenticator","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamGuards":{"type":"topic","abstract":[{"type":"text","text":"Declarative authorization helper factories (§11 of CONTRACT.md)."}],"url":"\/documentation\/axiamsdk\/axiamguards","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamGuards","kind":"identifier"}],"navigatorTitle":[{"text":"AxiamGuards","kind":"identifier"}],"role":"symbol","title":"AxiamGuards"},"doc://AxiamSDK/documentation/AxiamSDK/PresentedProofs":{"url":"\/documentation\/axiamsdk\/presentedproofs","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PresentedProofs","kind":"identifier"}],"title":"PresentedProofs","abstract":[{"type":"text","text":"What the caller proved about "},{"type":"strong","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" connection and "},{"type":"strong","inlineContent":[{"type":"text","text":"this"}]},{"type":"text","text":" request, for"},{"type":"text","text":" "},{"code":"AxiamRequestAuthenticator\/verifyTokenBinding(_:proofs:)","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"PresentedProofs","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PresentedProofs"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamRequestContext":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamRequestContext","url":"\/documentation\/axiamsdk\/axiamrequestcontext","abstract":[{"type":"text","text":"A minimal, framework-agnostic view of an inbound request: its headers and cookies."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamRequestContext","kind":"identifier"}],"navigatorTitle":[{"text":"AxiamRequestContext","kind":"identifier"}],"type":"topic","role":"symbol","title":"AxiamRequestContext","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamRequestAuthenticator/authenticate(_:presentedProofs:)":{"url":"\/documentation\/axiamsdk\/axiamrequestauthenticator\/authenticate(_:presentedproofs:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8AxiamSDK0A14RequestContextV","kind":"typeIdentifier","text":"Axiam