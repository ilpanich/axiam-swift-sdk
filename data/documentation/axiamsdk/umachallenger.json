{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"sections":[],"metadata":{"modules":[{"name":"AxiamSDK"}],"role":"symbol","title":"UmaChallenger","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UmaChallenger"}],"navigatorTitle":[{"kind":"identifier","text":"UmaChallenger"}],"roleHeading":"Structure","symbolKind":"struct","externalID":"s:8AxiamSDK13UmaChallengerV"},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/init(realm:asURI:pat:)"]},{"title":"Instance Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/asURI","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/pat","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/realm"]}],"abstract":[{"type":"text","text":"A configured "},{"code":"WWW-Authenticate: UMA","type":"codeVoice"},{"type":"text","text":" challenge emitter (CONTRACT.md §20.3, emit half)."}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/s8SendableP"]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UmaChallenger","kind":"identifier"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hand one to "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards\/requireAccess(_:resource:scope:umaChallenge:)","isActive":true},{"type":"text","text":" and a denial stops"},{"type":"text","text":" "},{"type":"text","text":"being a bare 403: the guard mints a fresh permission ticket for the pair the caller lacked and"},{"type":"text","text":" "},{"type":"text","text":"attaches it to the thrown "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthzError","isActive":true},{"type":"text","text":", so the framework adapter can return it as a header and"},{"type":"text","text":" "},{"type":"text","text":"a UMA-aware client knows where to go for authority instead of only being told “no”."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Opt-in, and deliberately so."}],"type":"strong"},{"type":"text","text":" Emitting a challenge means minting a credential — a wire call"},{"type":"text","text":" "},{"type":"text","text":"to the Protection API, and a live ticket, produced on a path the caller did not explicitly"},{"type":"text","text":" "},{"type":"text","text":"request. A guard that did that on every denial by default would turn each unauthorized request"},{"type":"text","text":" "},{"type":"text","text":"into a Protection API call, which is a denial-of-service amplifier pointed at your own"},{"type":"text","text":" "},{"type":"text","text":"authorization server. So it happens only where an application asked for it."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Failure is not escalation."}]},{"type":"text","text":" If minting fails — the PAT expired, the Protection API is down,"},{"type":"text","text":" "},{"type":"text","text":"the resource declares none of the requested scopes — the denial still surfaces as an ordinary"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthzError"},{"type":"text","text":" without a challenge. A caller who was going to be refused is refused either way;"},{"type":"text","text":" "},{"type":"text","text":"letting a Protection API outage turn a deny into a 503 would hand the outage a second"},{"type":"text","text":" "},{"type":"text","text":"consequence, and letting it turn into an allow would be a security bug."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/umachallenger"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger","navigatorTitle":[{"text":"UmaChallenger","kind":"identifier"}],"title":"UmaChallenger","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UmaChallenger","kind":"identifier"}],"abstract":[{"text":"A configured ","type":"text"},{"code":"WWW-Authenticate: UMA","type":"codeVoice"},{"text":" challenge emitter (CONTRACT.md §20.3, emit half).","type":"text"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/umachallenger","type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AuthzError":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"AuthzError","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthzError","role":"symbol","abstract":[{"type":"text","text":"Authorization failure (§2). Carries a "},{"type":"codeVoice","code":"message"},{"type":"text","text":" and, when the server provided them,"},{"type":"text","text":" "},{"type":"text","text":"the denied "},{"type":"codeVoice","code":"action"},{"type":"text","text":" and "},{"type":"codeVoice","code":"resourceID"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"AuthzError","kind":"identifier"}],"type":"topic","title":"AuthzError","url":"\/documentation\/axiamsdk\/authzerror"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/pat":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/pat","kind":"symbol","abstract":[{"type":"text","text":"A Protection API Token: a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"client-credentials"}]},{"type":"text","text":" token carrying the "},{"type":"codeVoice","code":"uma_protection"},{"type":"text","text":" scope"},{"type":"text","text":" "},{"type":"text","text":"(§20.2 rule 1). A user token cannot stand in — a minted ticket is bound to the "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" "},{"type":"text","text":"that minted it."}],"title":"pat","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"pat"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">"}],"type":"topic","role":"symbol","url":"\/documentation\/axiamsdk\/umachallenger\/pat"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/realm":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"realm"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"role":"symbol","title":"realm","abstract":[{"text":"The protection realm named in the header.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/realm","url":"\/documentation\/axiamsdk\/umachallenger\/realm"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamGuards/requireAccess(_:resource:scope:umaChallenge:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards\/requireAccess(_:resource:scope:umaChallenge:)","url":"\/documentation\/axiamsdk\/axiamguards\/requireaccess(_:resource:scope:umachallenge:)","title":"requireAccess(_:resource:scope:umaChallenge:)","type":"topic","abstract":[{"type":"codeVoice","code":"require_access(action, resource[, scope])"},{"type":"text","text":" (§11): the "},{"type":"strong","inlineContent":[{"type":"text","text":"authenticated caller"}]},{"type":"text","text":" must pass"},{"type":"text","text":" "},{"type":"text","text":"an AXIAM authorization check. "},{"type":"codeVoice","code":"subject_id"},{"type":"text","text":" is the end user’s id (§11.2 rule 2), not the"},{"type":"text","text":" "},{"type":"text","text":"application’s service-account session."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requireAccess"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"resource"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"umaChallenge"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UmaChallenger","preciseIdentifier":"s:8AxiamSDK13UmaChallengerV"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"AxiamGuardHandler","preciseIdentifier":"s:8AxiamSDK0A12GuardHandlera"}]},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/init(realm:asURI:pat:)":{"type":"topic","role":"symbol","url":"\/documentation\/axiamsdk\/umachallenger\/init(realm:asuri:pat:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"realm"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"asURI"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"pat"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier","text":"Sensitive"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">)"}],"kind":"symbol","abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/init(realm:asURI:pat:)","title":"init(realm:asURI:pat:)"},"doc://AxiamSDK/s8SendableP":{"identifier":"doc:\/\/AxiamSDK\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/umaDiscover()":{"kind":"symbol","title":"umaDiscover()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"umaDiscover","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"Uma2Configuration","preciseIdentifier":"s:8AxiamSDK17Uma2ConfigurationV"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaDiscover()","role":"symbol","type":"topic","abstract":[{"code":"GET \/.well-known\/uma2-configuration","type":"codeVoice"},{"type":"text","text":" (§20.1) — fetch the UMA discovery document."}],"url":"\/documentation\/axiamsdk\/axiamclient\/umadiscover()"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/asURI":{"kind":"symbol","title":"asURI","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"asURI","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/asURI","role":"symbol","type":"topic","abstract":[{"type":"text","text":"The authorization server the caller should redeem the ticket at — normally this"},{"type":"text","text":" "},{"type":"text","text":"deployment’s issuer, read from "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaDiscover()","isActive":true,"type":"reference"},{"type":"text","text":" rather than concatenated by"},{"type":"text","text":" "},{"type":"text","text":"hand, for the same reason §12.3 rule 6 gives."}],"url":"\/documentation\/axiamsdk\/umachallenger\/asuri"}}}