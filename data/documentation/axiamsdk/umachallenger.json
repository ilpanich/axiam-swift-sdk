ract":[{"text":"A Protection API Token: a ","type":"text"},{"inlineContent":[{"text":"client-credentials","type":"text"}],"type":"emphasis"},{"text":" token carrying the ","type":"text"},{"code":"uma_protection","type":"codeVoice"},{"text":" scope","type":"text"},{"text":" ","type":"text"},{"text":"(§20.2 rule 1). A user token cannot stand in — a minted ticket is bound to the ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"that minted it.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/asURI":{"kind":"symbol","abstract":[{"type":"text","text":"The authorization server the caller should redeem the ticket at — normally this"},{"type":"text","text":" "},{"type":"text","text":"deployment’s issuer, read from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaDiscover()"},{"type":"text","text":" rather than concatenated by"},{"type":"text","text":" "},{"type":"text","text":"hand, for the same reason §12.3 rule 6 gives."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/asURI","type":"topic","title":"asURI","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"asURI"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"url":"\/documentation\/axiamsdk\/umachallenger\/asuri"},"doc://AxiamSDK/documentation/AxiamSDK/AuthzError":{"title":"AuthzError","navigatorTitle":[{"kind":"identifier","text":"AuthzError"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthzError","url":"\/documentation\/axiamsdk\/authzerror","type":"topic","abstract":[{"text":"Authorization failure (§2). Carries a ","type":"text"},{"code":"message","type":"codeVoice"},{"text":" and, when the server provided them,","type":"text"},{"text":" ","type":"text"},{"text":"the denied ","type":"text"},{"code":"action","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"resourceID","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthzError"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/realm":{"type":"topic","role":"symbol","url":"\/documentation\/axiamsdk\/umachallenger\/realm","kind":"symbol","abstract":[{"type":"text","text":"The protection realm named in the header."}],"title":"realm","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/realm","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"realm"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/umaDiscover()":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaDiscover()","url":"\/documentation\/axiamsdk\/axiamclient\/umadiscover()","abstract":[{"code":"GET \/.well-known\/uma2-configuration","type":"codeVoice"},{"text":" (§20.1) — fetch the UMA discovery document.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"umaDiscover","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Uma2Configuration","preciseIdentifier":"s:8AxiamSDK17Uma2ConfigurationV"}],"type":"topic","role":"symbol","title":"umaDiscover()","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger":{"identifie