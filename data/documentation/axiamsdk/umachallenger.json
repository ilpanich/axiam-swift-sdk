 (§11.2 rule 2), not the","type":"text"},{"text":" ","type":"text"},{"text":"application’s service-account session.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamguards\/requireaccess(_:resource:scope:umachallenge:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards\/requireAccess(_:resource:scope:umaChallenge:)"}}}