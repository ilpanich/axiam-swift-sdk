","url":"\/documentation\/axiamsdk\/umachallenger\/pat","role":"symbol","abstract":[{"type":"text","text":"A Protection API Token: a "},{"inlineContent":[{"text":"client-credentials","type":"text"}],"type":"emphasis"},{"type":"text","text":" token carrying the "},{"type":"codeVoice","code":"uma_protection"},{"type":"text","text":" scope"},{"type":"text","text":" "},{"type":"text","text":"(§20.2 rule 1). A user token cannot stand in — a minted ticket is bound to the "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" "},{"type":"text","text":"that minted it."}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/realm":{"title":"realm","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"realm","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/realm","kind":"symbol","url":"\/documentation\/axiamsdk\/umachallenger\/realm","abstract":[{"type":"text","text":"The protection realm named in the header."}]},"doc://AxiamSDK/documentation/AxiamSDK/AuthzError":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"AuthzError"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthzError"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthzError","url":"\/documentation\/axiamsdk\/authzerror","abstract":[{"type":"text","text":"Authorization failure (§2). Carries a "},{"code":"message","type":"codeVoice"},{"type":"text","text":" and, when the server provided them,"},{"type":"text","text":" "},{"type":"text","text":"the denied "},{"code":"action","type":"codeVoice"},{"type":"text","text":" and "},{"code":"resourceID","type":"codeVoice"},{"type":"text","text":"."}],"title":"AuthzError"},"doc://AxiamSDK/s8SendableP":{"identifier":"doc:\/\/AxiamSDK\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"}}}