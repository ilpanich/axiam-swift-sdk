nd, when the server provided them,","type":"text"},{"text":" ","type":"text"},{"text":"the denied ","type":"text"},{"code":"action","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"resourceID","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger","navigatorTitle":[{"text":"UmaChallenger","kind":"identifier"}],"title":"UmaChallenger","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UmaChallenger","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/umachallenger","abstract":[{"text":"A configured ","type":"text"},{"code":"WWW-Authenticate: UMA","type":"codeVoice"},{"text":" challenge emitter (CONTRACT.md §20.3, emit half).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/asURI":{"url":"\/documentation\/axiamsdk\/umachallenger\/asuri","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/asURI","abstract":[{"type":"text","text":"The authorization server the caller should redeem the ticket at — normally this"},{"type":"text","text":" "},{"type":"text","text":"deployment’s issuer, read from "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaDiscover()","type":"reference","isActive":true},{"type":"text","text":" rather than concatenated by"},{"type":"text","text":" "},{"type":"text","text":"hand, for the same reason §12.3 rule 6 gives."}],"role":"symbol","kind":"symbol","title":"asURI","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind"