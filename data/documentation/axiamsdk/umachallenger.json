{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"s:8AxiamSDK13UmaChallengerV","roleHeading":"Structure","navigatorTitle":[{"text":"UmaChallenger","kind":"identifier"}],"modules":[{"name":"AxiamSDK"}],"role":"symbol","title":"UmaChallenger","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UmaChallenger","kind":"identifier"}]},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/init(realm:asURI:pat:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/asURI","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/pat","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/realm"],"generated":true}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger","interfaceLanguage":"swift"},"abstract":[{"text":"A configured ","type":"text"},{"type":"codeVoice","code":"WWW-Authenticate: UMA"},{"text":" challenge emitter (CONTRACT.md §20.3, emit half).","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UmaChallenger"}]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Hand one to ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards\/requireAccess(_:resource:scope:umaChallenge:)","isActive":true,"type":"reference"},{"text":" and a denial stops","type":"text"},{"text":" ","type":"text"},{"text":"being a bare 403: the guard mints a fresh permission ticket for the pair the caller lacked and","type":"text"},{"text":" ","type":"text"},{"text":"attaches it to the thrown ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthzError","isActive":true,"type":"reference"},{"text":", so the framework adapter can return it as a header and","type":"text"},{"text":" ","type":"text"},{"text":"a UMA-aware client knows where to go for authority instead of only being told “no”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Opt-in, and deliberately so.","type":"text"}],"type":"strong"},{"text":" Emitting a challenge means minting a credential — a wire call","type":"text"},{"text":" ","type":"text"},{"text":"to the Protection API, and a live ticket, produced on a path the caller did not explicitly","type":"text"},{"text":" ","type":"text"},{"text":"request. A guard that did that on every denial by default would turn each unauthorized request","type":"text"},{"text":" ","type":"text"},{"text":"into a Protection API call, which is a denial-of-service amplifier pointed at your own","type":"text"},{"text":" ","type":"text"},{"text":"authorization server. So it happens only where an application asked for it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Failure is not escalation.","type":"text"}]},{"text":" If minting fails — the PAT expired, the Protection API is down,","type":"text"},{"text":" ","type":"text"},{"text":"the resource declares none of the requested scopes — the denial still surfaces as an ordinary","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthzError"},{"text":" without a challenge. A caller who was going to be refused is refused either way;","type":"text"},{"text":" ","type":"text"},{"text":"letting a Protection API outage turn a deny into a 503 would hand the outage a second","type":"text"},{"text":" ","type":"text"},{"text":"consequence, and letting it turn into an allow would be a security bug.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/umachallenger"]}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UmaChallenger"}],"kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A configured "},{"type":"codeVoice","code":"WWW-Authenticate: UMA"},{"type":"text","text":" challenge emitter (CONTRACT.md §20.3, emit half)."}],"title":"UmaChallenger","navigatorTitle":[{"kind":"identifier","text":"UmaChallenger"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger","url":"\/documentation\/axiamsdk\/umachallenger"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamGuards/requireAccess(_:resource:scope:umaChallenge:)":{"kind":"symbol","url":"\/documentation\/axiamsdk\/axiamguards\/requireaccess(_:resource:scope:umachallenge:)","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards\/requireAccess(_:resource:scope:umaChallenge:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requireAccess","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"resource","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"umaChallenge","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UmaChallenger","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13UmaChallengerV"},{"text":"?) -> ","kind":"text"},{"text":"AxiamGuardHandler","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK0A12GuardHandlera"}],"abstract":[{"type":"codeVoice","code":"require_access(action, resource[, scope])"},{"type":"text","text":" (§11): the "},{"type":"strong","inlineContent":[{"type":"text","text":"authenticated caller"}]},{"type":"text","text":" must pass"},{"type":"text","text":" "},{"type":"text","text":"an AXIAM authorization check. "},{"type":"codeVoice","code":"subject_id"},{"type":"text","text":" is the end user’s id (§11.2 rule 2), not the"},{"type":"text","text":" "},{"type":"text","text":"application’s service-account session."}],"title":"requireAccess(_:resource:scope:umaChallenge:)"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/init(realm:asURI:pat:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"realm","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"asURI","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"pat","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","preciseIdentifier":"s:8AxiamSDK9SensitiveV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"kind":"symbol","role":"symbol","abstract":[],"title":"init(realm:asURI:pat:)","type":"topic","url":"\/documentation\/axiamsdk\/umachallenger\/init(realm:asuri:pat:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/init(realm:asURI:pat:)"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/pat":{"kind":"symbol","url":"\/documentation\/axiamsdk\/umachallenger\/pat","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/pat","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pat","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A Protection API Token: a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"client-credentials"}]},{"type":"text","text":" token carrying the "},{"type":"codeVoice","code":"uma_protection"},{"type":"text","text":" scope"},{"type":"text","text":" "},{"type":"text","text":"(§20.2 rule 1). A user token cannot stand in — a minted ticket is bound to the "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" "},{"type":"text","text":"that minted it."}],"title":"pat"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/realm":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"realm"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"kind":"symbol","role":"symbol","type":"topic","title":"realm","abstract":[{"text":"The protection realm named in the header.","type":"text"}],"url":"\/documentation\/axiamsdk\/umachallenger\/realm","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/realm"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient/umaDiscover()":{"kind":"symbol","url":"\/documentation\/axiamsdk\/axiamclient\/umadiscover()","role":"symbol","identi