{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"A configured "},{"type":"codeVoice","code":"WWW-Authenticate: UMA"},{"type":"text","text":" challenge emitter (CONTRACT.md §20.3, emit half)."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableMetatypeP"],"title":"Conforms To"}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UmaChallenger","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"AxiamSDK"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"UmaChallenger"}],"externalID":"s:8AxiamSDK13UmaChallengerV","role":"symbol","title":"UmaChallenger"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"kind":"symbol","sections":[],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/init(realm:asURI:pat:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/asURI","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/pat","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/realm"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/umachallenger"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UmaChallenger"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Hand one to ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards\/requireAccess(_:resource:scope:umaChallenge:)","isActive":true},{"text":" and a denial stops","type":"text"},{"text":" ","type":"text"},{"text":"being a bare 403: the guard mints a fresh permission ticket for the pair the caller lacked and","type":"text"},{"text":" ","type":"text"},{"text":"attaches it to the thrown ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthzError","isActive":true},{"text":", so the framework adapter can return it as a header and","type":"text"},{"text":" ","type":"text"},{"text":"a UMA-aware client knows where to go for authority instead of only being told “no”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Opt-in, and deliberately so."}],"type":"strong"},{"text":" Emitting a challenge means minting a credential — a wire call","type":"text"},{"text":" ","type":"text"},{"text":"to the Protection API, and a live ticket, produced on a path the caller did not explicitly","type":"text"},{"text":" ","type":"text"},{"text":"request. A guard that did that on every denial by default would turn each unauthorized request","type":"text"},{"text":" ","type":"text"},{"text":"into a Protection API call, which is a denial-of-service amplifier pointed at your own","type":"text"},{"text":" ","type":"text"},{"text":"authorization server. So it happens only where an application asked for it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Failure is not escalation.","type":"text"}],"type":"strong"},{"text":" If minting fails — the PAT expired, the Protection API is down,","type":"text"},{"text":" ","type":"text"},{"text":"the resource declares none of the requested scopes — the denial still surfaces as an ordinary","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthzError","type":"reference"},{"text":" without a challenge. A caller who was going to be refused is refused either way;","type":"text"},{"text":" ","type":"text"},{"text":"letting a Protection API outage turn a deny into a 503 would hand the outage a second","type":"text"},{"text":" ","type":"text"},{"text":"consequence, and letting it turn into an allow would be a security bug.","type":"text"}]}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AuthzError":{"abstract":[{"type":"text","text":"Authorization failure (§2). Carries a "},{"type":"codeVoice","code":"message"},{"type":"text","text":" and, when the server provided them,"},{"type":"text","text":" "},{"type":"text","text":"the denied "},{"type":"codeVoice","code":"action"},{"type":"text","text":" and "},{"type":"codeVoice","code":"resourceID"},{"type":"text","text":"."}],"title":"AuthzError","kind":"symbol","type":"topic","navigatorTitle":[{"text":"AuthzError","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/authzerror","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthzError","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AuthzError","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/asURI":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"asURI"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/asURI","abstract":[{"text":"The authorization server the caller should redeem the ticket at — normally this","type":"text"},{"text":" ","type":"text"},{"text":"deployment’s issuer, read from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaDiscover()","type":"reference"},{"text":" rather than concatenated by","type":"text"},{"text":" ","type":"text"},{"text":"hand, for the same reason §12.3 rule 6 gives.","type":"text"}],"url":"\/documentation\/axiamsdk\/umachallenger\/asuri","title":"asURI"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/pat":{"abstract":[{"type":"text","text":"A Protection API Token: a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"client-credentials"}]},{"type":"text","text":" token carrying the "},{"type":"codeVoice","code":"uma_protection"},{"type":"text","text":" scope"},{"type":"text","text":" "},{"type":"text","text":"(§20.2 rule 1). A user token cannot stand in — a minted ticket is bound to the "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" "},{"type":"text","text":"that minted it."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/pat","title":"pat","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pat","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">","kind":"text"}],"type":"topic","url":"\/documentation\/axiamsdk\/umachallenger\/pat"},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/init(realm:asURI:pat:)":{"title":"init(realm:asURI:pat:)","kind":"symbol","url":"\/documentation\/axiamsdk\/umachallenger\/init(realm:asuri:pat:)","abstract":[],"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"realm","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"asURI","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"pat","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sensitive","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SensitiveV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">)","kind":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/init(realm:asURI:pat:)"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/UmaChallenger/realm":{"type":"topic","url":"\/documentation\/axiamsdk\/umachallenger\/realm","abstract":[{"text":"The protection realm named in the header.","type":"text"}],"title":"realm","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"realm","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/realm","kind":"symbol","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamGuards/requireAccess(_:resource:scope:umaChallenge:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuards\/requireAccess(_:resource:scope:umaChallenge:)","title":"requireAccess(_:resource:scope:umaChallenge:)","type":"topic","url":"\/documentation\/axiamsdk\/axiamguards\/requireaccess(_:resource:scope:umachallenge:)","abstract":[{"code":"require_access(action, resource[, scope])","type":"codeVoice"},{"text":" (§11): the ","type":"text"},{"inlineContent":[{"text":"authenticated caller","type":"text"}],"type":"strong"},{"text":" must pass","type":"text"},{"text":" ","type":"text"},{"text":"an AXIAM authorization check. ","type":"text"},{"code":"subject_id","type":"codeVoice"},{"text":" is the end user’s id (§11.2 rule 2), not the","type":"text"},{"text":" ","type":"text"},{"text":"application’s service-