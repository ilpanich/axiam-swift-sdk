ext"},{"text":" ","type":"text"},{"text":"deployment’s issuer, read from ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/umaDiscover()","isActive":true,"type":"reference"},{"text":" rather than concatenated by","type":"text"},{"text":" ","type":"text"},{"text":"hand, for the same reason §12.3 rule 6 gives.","type":"text"}],"title":"asURI","type":"topic","url":"\/documentation\/axiamsdk\/umachallenger\/asuri","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UmaChallenger\/asURI"},"doc://AxiamSDK/s8SendableP":{"identifier":"doc:\/\/AxiamSDK\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"}}}