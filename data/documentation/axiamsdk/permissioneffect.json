{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/permissioneffect"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"open"}]},{"text":" enum. A value this SDK’s copy of the spec does not list decodes to ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there","type":"text"},{"text":" ","type":"text"},{"text":"fails the WHOLE response, so one field of one record would take down the page it was on,","type":"text"},{"text":" ","type":"text"},{"text":"including the records the caller did ask for.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is never written: "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"type":"codeVoice","code":"\"\""},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}]}]}],"abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"type":"strong","inlineContent":[{"type":"text","text":"and beats every allow"}]},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"type":"text","text":"adding a deny rule can never widen access, and can never be undone by"},{"type":"text","text":" "},{"type":"text","text":"adding allows"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}],"metadata":{"symbolKind":"enum","navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"role":"symbol","roleHeading":"Enumeration","title":"PermissionEffect","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK16PermissionEffectO"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"kind":"symbol","relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP"],"kind":"relationships","title":"Conforms To"}],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/allow","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/deny","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/unknown"],"title":"Enumeration Cases"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/init(from:)-1ui3y","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/init(rawValue:)"],"title":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/encode(to:)"],"title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/RawRepresentable-Implementations"],"title":"Default Implementations"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://AxiamSDK/SE":{"title":"Swift.Encodable","type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/SE"},"doc://AxiamSDK/documentation/AxiamSDK/Pe