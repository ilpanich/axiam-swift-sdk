{"metadata":{"modules":[{"name":"AxiamSDK"}],"symbolKind":"enum","externalID":"s:8AxiamSDK21CibaRequestSigningAlgO","roleHeading":"Enumeration","role":"symbol","title":"CibaRequestSigningAlg","navigatorTitle":[{"text":"CibaRequestSigningAlg","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CibaRequestSigningAlg","kind":"identifier"}]},"abstract":[{"text":"The JWS algorithm a CIBA client signs its authentication requests with (CIBA Core §4","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"backchannel_authentication_request_signing_alg"},{"text":", §7.1.1). Exactly the three algorithms","type":"text"},{"text":" ","type":"text"},{"text":"AXIAM verifies on any client-signed JWT (","type":"text"},{"type":"codeVoice","code":"axiam_oauth2::jose::PERMITTED_ALGORITHMS"},{"text":"): FAPI","type":"text"},{"text":" ","type":"text"},{"text":"2.0 §5.3.1.1’s list. A registration naming anything else — ","type":"text"},{"type":"codeVoice","code":"RS256"},{"text":", ","type":"text"},{"type":"codeVoice","code":"HS256"},{"text":", ","type":"text"},{"type":"codeVoice","code":"none"},{"text":" — is","type":"text"},{"text":" ","type":"text"},{"text":"refused rather than stored, so no row can hold an algorithm the verifier would not honour","type":"text"},{"text":" ","type":"text"},{"text":"(D-61).","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CibaRequestSigningAlg","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"strong","inlineContent":[{"type":"text","text":"open"}]},{"type":"text","text":" enum. A value this SDK’s copy of the spec does not list decodes to "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" "},{"