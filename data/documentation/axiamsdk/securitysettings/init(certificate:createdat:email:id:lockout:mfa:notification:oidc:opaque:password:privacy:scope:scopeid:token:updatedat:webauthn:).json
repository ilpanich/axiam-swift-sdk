text":", ","kind":"text"},{"text":"notification","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"NotificationPolicy","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK18NotificationPolicyV"},{"text":", ","kind":"text"},{"text":"oidc","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OidcPolicy","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK10OidcPolicyV"},{"text":", ","kind":"text"},{"text":"opaque","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OpaquePolicy","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12OpaquePolicyV"},{"text":", ","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PasswordPolicy","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK14PasswordPolicyV"},{"text":", ","kind":"text"},{"text":"privacy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PrivacyPolicy","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13PrivacyPolicyV"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SettingsScope","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13SettingsScopeO"},{"text":", ","kind":"text"},{"text":"scopeID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"token","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TokenPolicy","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK11TokenPolicyV"},{"text":", ","kind":"text"},{"text":"updatedAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"webauthn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"WebauthnPolicy","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK14WebauthnPolicyV"},{"text":")","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SecuritySettings\/init(certificate:createdAt:email:id:lockout:mfa:notification:oidc:opaque:password:privacy:scope:scopeID:token:updatedAt:webauthn:)","abstract":[],"title":"init(certificate:createdAt:email:id:lockout:mfa:notification:oidc:opaque:password:privacy:scope:scopeID:token:updatedAt:webauthn:)"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy":{"navigatorTitle":[{"text":"OidcPolicy","kind":"identifier"}],"type":"topic","title":"OidcPolicy","abstract":[{"type":"text","text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8; T21.4). Settings that are not"},{"type":"text","text":" "},{"type":"text","text":"password rules, here because this is the org-baseline-plus-tenant-override surface every"},{"type":"text","text":" "},{"type":"text","text":"other per-tenant control lives on. They are not all of the same kind as each other, and"},{"type":"text","text":" "},{"type":"text","text":"which is which is the whole of what ["},{"type":"codeVoice","code":"validate_tenant_override"},{"type":"text","text":"] and"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"clamp_overrides_to_org"},{"type":"text","text":"] read, so it is set out rather than inferred. "},{"type":"strong","inlineContent":[{"text":"Ordered","type":"text"}]},{"type":"text","text":" — a"},{"type":"text","text":" "},{"type":"text","text":"tenant may be stricter than its organization and never more permissive: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"type":"text","text":"], validated "},{"type":"strong","inlineContent":[{"text":"disable-only","type":"text"}]},{"type":"text","text":" — the mirror image of"},{"type":"text","text":" "},{"type":"codeVoice","code":"mfa_enforced"},{"type":"text","text":", because releasing personal data is the less-restrictive direction, so a"},{"type":"text","text":" "},{"type":"text","text":"tenant can turn its organization’s decision off but never on. * ["},{"type":"codeVoice","code":"Self::saml_idp_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"type":"strong","inlineContent":[{"type":"text","text":"disable-only"}]},{"type":"text","text":" exactly like ["},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"type":"text","text":"] (D-20): a tenant"},{"type":"text","text":" "},{"type":"text","text":"may turn its organization’s "},{"type":"codeVoice","code":"true"},{"type":"text","text":" off and never its "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on. * ["},{"type":"codeVoice","code":"Self::ssf_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"type":"strong","inlineContent":[{"type":"text","text":"disable-only"}]},{"type":"text","text":" the same way (D-45). * ["},{"type":"codeVoice","code":"Self::dynamic_registration"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ladder "},{"type":"codeVoice","code":"disabled"},{"type":"text","text":" → "},{"type":"codeVoice","code":"initial_access_token"},{"type":"text","text":" → "},{"type":"codeVoice","code":"anonymous"},{"type":"text","text":": a tenant may move down it and"},{"type":"text","text":" "},{"type":"text","text":"never up. * ["},{"type":"codeVoice","code":"Self::dcr_max_clients"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::dcr_unused_client_ttl_days"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ordinary "},{"type":"codeVoice","code":"tenant <= org"},{"type":"text","text":" rule — with the wrinkle that "},{"type":"codeVoice","code":"0"},{"type":"text","text":" on the second means "},{"type":"emphasis","inlineContent":[{"text":"never sweep","type":"text"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which is the longest window of all and is handled by ["},{"type":"codeVoice","code":"dcr_ttl_strictness"},{"type":"text","text":"]. "},{"type":"strong","inlineContent":[{"text":"Not","type":"text"},{"text":" ","type":"text"},{"text":"ordered","type":"text"}]},{"type":"text","text":", therefore never validated against the baseline and never clamped: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::default_locale"},{"type":"text","text":"]. A language is a presentation preference; there is no sense in"},{"type":"text","text":" "},{"type":"text","text":"which Italian is stricter than French. * ["},{"type":"codeVoice","code":"Self::dcr_allowed_scopes"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::dcr_allowed_redirect_hosts"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::external_client_allowed_resources"},{"type":"text","text":"]. Each"},{"type":"text","text":" "},{"type":"text","text":"names per-tenant resources — "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" tenant’s MCP servers, "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" tenant’s callback hosts —"},{"type":"text","text":" "},{"type":"text","text":"and there is no sense in which one such list is stricter than another. A subset rule would"},{"type":"text","text":" "},{"type":"text","text":"force an organization to enumerate every tenant’s resource servers in its own baseline"},{"type":"text","text":" "},{"type":"text","text":"before any tenant could name one. The model’s rule is “a tenant may only be more"},{"type":"text","text":" "},{"type":"text","text":"restrictive”, which binds every field that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"has"}]},{"type":"text","text":" a restrictiveness; a field that has none"},{"type":"text","text":" "},{"type":"text","text":"cannot violate it. One cross-field interlock spans both groups and is checked on the"},{"type":"text","text":" "},{"type":"text","text":"resolved policy rather than on either input: see ["},{"type":"codeVoice","code":"validate_dcr_policy"},{"type":"text","text":"]."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","url":"\/documentation\/axiamsdk\/oidcpolicy","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OidcPolicy","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/WebauthnPolicy":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/WebauthnPolicy","title":"WebauthnPolicy","abstract":[{"type":"text","text":"WebAuthn ceremony policy. One field today. It is a struct rather than a bare field on"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"SecuritySettings","type":"codeVoice"},{"type":"text","text":"] so that the next WebAuthn control has an obvious home, and so the admin"},{"type":"text","text":" "},{"type":"text","text":"UI can group them. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"attestation"}]},{"type":"text","text":" policy is deliberately not here: it lives in"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"crate::models::webauthn_policy::WebauthnAttestationPolicy","type":"codeVoice"},{"type":"text","text":"], is tenant-only, and cannot"},{"type":"text","text":" "},{"type":"text","text":"join this model because AAGUID allow\/block lists have no “more restrictive than” ordering to"},{"type":"text","text":" "},{"type":"text","text":"validate an override against. User verification does, so it can."}],"role":"symbol","navigatorTitle":[{"text":"WebauthnPolicy","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/webauthnpolicy","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WebauthnPolicy","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/EmailVerificationPolicy":{"type":"topic","abstract":[{"text":"Email verification require