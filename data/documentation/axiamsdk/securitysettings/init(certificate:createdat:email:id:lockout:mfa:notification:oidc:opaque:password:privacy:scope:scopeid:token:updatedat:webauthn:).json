},{"text":"] is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" ordered, and no ordering is invented for it. A language","type":"text"},{"text":" ","type":"text"},{"text":"is a presentation preference; there is no sense in which Italian is stricter than French.","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"validate_tenant_override","type":"codeVoice"},{"text":"] therefore does not check it and [","type":"text"},{"code":"clamp_overrides_to_org","type":"codeVoice"},{"text":"]","type":"text"},{"text":" ","type":"text"},{"text":"never clears it. The model’s rule is “a tenant may only be more restrictive”, which binds","type":"text"},{"text":" ","type":"text"},{"text":"every field that ","type":"text"},{"inlineContent":[{"type":"text","text":"has"}],"type":"emphasis"},{"text":" a restrictiveness; a field that has none cannot violate it.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OidcPolicy"}]},"doc://AxiamSDK/documentation/AxiamSDK/SecuritySettings":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SecuritySettings"}],"navigatorTitle":[{"kind":"identifier","text":"SecuritySettings"}],"type":"topic","kind":"symbol","role":"symbol","title":"SecuritySettings","url":"\/documentation\/axiamsdk\/securitysettings","abstract":[{"type":"text","text":"Fully resolved security settings (all fields present)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SecuritySettings"},"doc://AxiamSDK/documentation/AxiamSDK/TokenPolicy":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TokenPolicy","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TokenPolicy","url":"\/documentation\/axiamsdk\/tokenpolicy","title":"TokenPolicy","abstract":[{"text":"Token lifetime configuration.","type":"text"}],"navigatorTitle":[{"text":"Tok