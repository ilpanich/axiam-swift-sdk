t never on. *"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"Self::default_locale","type":"codeVoice"},{"type":"text","text":"] is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" ordered, and no ordering is invented for it. A language"},{"type":"text","text":" "},{"type":"text","text":"is a presentation preference; there is no sense in which Italian is stricter than French."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"validate_tenant_override","type":"codeVoice"},{"type":"text","text":"] therefore does not check it and ["},{"code":"clamp_overrides_to_org","type":"codeVoice"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"never clears it. The model’s rule is “a tenant may only be more restrictive”, which binds"},{"type":"text","text":" "},{"type":"text","text":"every field that "},{"type":"emphasis","inlineContent":[{"text":"has","type":"text"}]},{"type":"text","text":" a restrictiveness; a field that has none cannot violate it."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","title":"OidcPolicy","role":"symbol","kind":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/MfaPolicy":{"kind":"symbol","abstract":[{"text":"Multi-factor authentication policy.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MfaPolicy","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"MfaPolicy","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/MfaPolicy","title":"MfaPolicy","url":"\/documentation\/axiamsdk\/mfapolicy"},"doc://AxiamSDK/documentation/AxiamSDK/PasswordPolicy":{"type":"topic","navigatorTitle":[{"text":"PasswordPolicy","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PasswordPolicy","abstract":[{"text":"Password complexity and history requirements.","type":"text"}],"fragments":[