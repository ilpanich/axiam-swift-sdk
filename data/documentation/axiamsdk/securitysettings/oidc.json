{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SecuritySettings\/oidc"},"abstract":[{"type":"text","text":"The server’s "},{"code":"oidc","type":"codeVoice"},{"type":"text","text":" field."}],"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oidc","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK10OidcPolicyV","text":"OidcPolicy","kind":"typeIdentifier"}],"role":"symbol","externalID":"s:8AxiamSDK16SecuritySettingsV4oidcAA10OidcPolicyVvp","modules":[{"name":"AxiamSDK"}],"title":"oidc","roleHeading":"Instance Property","symbolKind":"property"},"kind":"symbol","variants":[{"paths":["\/documentation\/axiamsdk\/securitysettings\/oidc"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SecuritySettings"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"oidc"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK10OidcPolicyV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","text":"OidcPolicy"}]}],"kind":"declarations"}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/SecuritySettings":{"abstract":[{"text":"Fully resolved security settings (all fields present).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SecuritySettings","navigatorTitle":[{"text":"SecuritySettings","kind":"identifier"}],"title":"SecuritySettings","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SecuritySettings","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/securitysettings"},"doc://AxiamSDK/documentation/AxiamSDK/SecuritySettings/oidc":{"abstract":[{"type":"text","text":"The server’s "},{"type":"codeVoice","code":"oidc"},{"type":"text","text":" field."}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"oidc"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK10OidcPolicyV","kind":"typeIdentifier","text":"OidcPolicy"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SecuritySettings\/oidc","kind":"symbol","title":"oidc","url":"\/documentation\/axiamsdk\/securitysettings\/oidc","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","role":"collection","type":"topic","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy":{"navigatorTitle":[{"kind":"identifier","text":"OidcPolicy"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OidcPolicy"}],"url":"\/documentation\/axiamsdk\/oidcpolicy","abstract":[{"text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8). Two settings that are not password","type":"text"},{"text":" ","type":"text"},{"text":"rules, and are here because this is the org-baseline-plus-tenant-override surface every","type":"text"},{"text":" ","type":"text"},{"text":"other per-tenant control lives on. They are also the two settings in this model that are","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" of the same kind as each other, so it is worth saying which is which: *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::sensitive_scopes_enabled","type":"codeVoice"},{"type":"text","text":"] "},{"type":"strong","inlineContent":[{"type":"text","text":"is"}]},{"type":"text","text":" ordered. Releasing personal data is the"},{"type":"text","text":" "},{"type":"text","text":"less-restrictive direction, so it is validated disable-only — the mirror image of"},{"type":"text","text":" "},{"code":"mfa_enforced","type":"codeVoice"},{"type":"text","text":" — and a tenant can turn its organization’s decision off but never on. *"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"Self::default_locale","type":"codeVoice"},{"type":"text","text":"] is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" ordered, and no ordering is invented for it. A language"},{"type":"text","text":" "},{"type":"text","text":"is a presentation preference; there is no sense in which Italian is stricter than French."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"validate_tenant_override","type":"codeVoice"},{"type":"text","text":"] therefore does not check it and ["},{"code":"clamp_overrides_to_org","type":"codeVoice"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"never clears it. The model’s rule is “a tenant may only be more restrictive”, which binds"},{"type":"text","text":" "},{"type":"text","text":"every field that "},{"type":"emphasis","inlineContent":[{"text":"has","type":"text"}]},{"type":"text","text":" a restrictiveness; a field that has none cannot violate it."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","title":"OidcPolicy","role":"symbol","kind":"symbol","type":"topic"}}}