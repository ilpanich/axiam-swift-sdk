t"}],"kind":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/SecuritySettings":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SecuritySettings"}],"navigatorTitle":[{"kind":"identifier","text":"SecuritySettings"}],"type":"topic","kind":"symbol","role":"symbol","title":"SecuritySettings","url":"\/documentation\/axiamsdk\/securitysettings","abstract":[{"type":"text","text":"Fully resolved security settings (all fields present)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SecuritySettings"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OidcPolicy"}],"type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","url":"\/documentation\/axiamsdk\/oidcpolicy","title":"OidcPolicy","abstract":[{"type":"text","text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8). Two settings that are not password"},{"type":"text","text":" "},{"type":"text","text":"rules, and are here because this is the org-baseline-plus-tenant-override surface every"},{"type":"text","text":" "},{"type":"text","text":"other per-tenant control lives on. They are also the two settings in this model that are"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" of the same kind as each other, so it is worth saying which is which: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"Self::sensitive_scopes_enabled","type":"codeVoice"},{"type":"text","text":"] "},{"type":"strong","inlineContent":[{"text":"is","type":"text"}]},{"type":"text","text":" ordered. Releasing personal data is the"},{"type":"text","text":" "},{"type":"text","text":"less-restrictive direction, so it is validated disable-only — the mirror image of"},{"text":" ","type":"text"},{"code":"mfa_enforced","type":"codeVoice"},{"text":" — and a tenant can turn its organization’s decision off but never on. *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::default_locale","type":"codeVoice"},{"text":"] is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" ordered, and no ordering is invented for it. A language","type":"text"},{"text":" ","type":"text"},{"text":"is a presentation preference; there is no sense in which Italian is stricter than French.","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"validate_tenant_override","type":"codeVoice"},{"text":"] therefore does not check it and [","type":"text"},{"code":"clamp_overrides_to_org","type":"codeVoice"},{"text":"]","type":"text"},{"text":" ","type":"text"},{"text":"never clears it. The model’s rule is “a tenant may only be more restrictive”, which binds","type":"text"},{"text":" ","type":"text"},{"text":"every field that ","type":"text"},{"inlineContent":[{"type":"text","text":"has"}],"type":"emphasis"},{"text":" a restrictiveness; a field that has none cannot violate it.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OidcPolicy"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"}}}