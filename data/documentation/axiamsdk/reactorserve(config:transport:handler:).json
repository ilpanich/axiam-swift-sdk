{"abstract":[{"type":"text","text":"Consume, verify, dispatch, sign, publish — until the transport is done."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reactorServe","kind":"identifier"},{"text":"(","kind":"text"},{"text":"config","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK13ReactorConfigV","text":"ReactorConfig","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorConfig"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK16ReactorTransportP","text":"ReactorTransport","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorTransport"},{"text":", ","kind":"text"},{"text":"handler","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK14ReactorHandlera","text":"ReactorHandler","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorHandler"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"For each delivery, in this order (§22.3): refuse ","type":"text"},{"code":"key_version","type":"codeVoice"},{"text":" below 2; verify","type":"text"},{"text":" ","type":"text"},{"text":"the MAC; check freshness in BOTH directions; check the nonce against a","type":"text"},{"text":" ","type":"text"},{"text":"seen-set held for this call’s whole lifetime. Only then is the handler","type":"text"},{"text":" ","type":"text"},{"text":"invoked.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Four rules from §22.10, all of them observable:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"It declares no topology","type":"text"}]},{"text":" (§22.1). The transport is not even given the","type":"text"},{"text":" ","type":"text"},{"text":"vocabulary to.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"It fails closed on its own errors."}],"type":"strong"},{"text":" A handler that throws, or a body the","type":"text"},{"text":" ","type":"text"},{"text":"runtime cannot verify, produces NO REPLY — letting the server’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"failure_policy"},{"text":" decide. A runtime that answered ","type":"text"},{"type":"codeVoice","code":"allow"},{"text":" for a handler that","type":"text"},{"text":" ","type":"text"},{"text":"threw would have overridden the operator’s ","type":"text"},{"type":"codeVoice","code":"fail_closed"},{"text":" setting from","type":"text"},{"text":" ","type":"text"},{"text":"inside the library.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"It does not filter a patch","type":"text"}]},{"type":"text","text":" (§22.4 rule 1)."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"It honours "},{"type":"codeVoice","code":"timeout_ms"}],"type":"strong"},{"type":"text","text":" by abandoning work whose window has closed"},{"type":"text","text":" "},{"type":"text","text":"rather than replying late."}],"type":"paragraph"}]}]},{"name":"Throws","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only what the "},{"type":"emphasis","inlineContent":[{"text":"transport","type":"text"}]},{"type":"text","text":" throws. A handler’s failure is caught and"},{"type":"text","text":" "},{"type":"text","text":"turned into an abstention, because that is what rule 2 requires; a"},{"type":"text","text":" "},{"type":"text","text":"transport’s is not, because a broker that has gone away is not something to"},{"type":"text","text":" "},{"type":"text","text":"keep looping on."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/reactorserve(config:transport:handler:)"]}],"metadata":{"symbolKind":"func","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reactorServe","kind":"identifier"},{"text":"(","kind":"text"},{"text":"config","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ReactorConfig","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13ReactorConfigV"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"ReactorTransport","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16ReactorTransportP"},{"text":", ","kind":"text"},{"text":"handler","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ReactorHandler","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK14ReactorHandlera"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"modules":[{"name":"AxiamSDK"}],"roleHeading":"Function","title":"reactorServe(config:transport:handler:)","externalID":"s:8AxiamSDK12reactorServe6config9transport7handleryAA13ReactorConfigV_AA0H9Transport_pAA0H8DecisionOSgAA0H5EventVYaYbKXEtYaKF"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/reactorServe(config:transport:handler:)"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/ReactorHandler":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorHandler","kind":"symbol","abstract":[{"type":"text","text":"One function from a verified event to one answer 