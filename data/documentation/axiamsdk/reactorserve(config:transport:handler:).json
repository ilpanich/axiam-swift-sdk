},{"type":"text","text":" "},{"type":"text","text":"invoked."}],"type":"paragraph"},{"inlineContent":[{"text":"Four rules from §22.10, all of them observable:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"It declares no topology"}],"type":"strong"},{"text":" (§22.1). The transport is not even given the","type":"text"},{"text":" ","type":"text"},{"text":"vocabulary to.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"It fails closed on its own errors.","type":"text"}],"type":"strong"},{"type":"text","text":" A handler that throws, or a body the"},{"type":"text","text":" "},{"type":"text","text":"runtime cannot verify, produces NO REPLY — letting the server’s"},{"type":"text","text":" "},{"code":"failure_policy","type":"codeVoice"},{"type":"text","text":" decide. A runtime that answered "},{"code":"allow","type":"codeVoice"},{"type":"text","text":" for a handler that"},{"type":"text","text":" "},{"type":"text","text":"threw would have overridden the operator’s "},{"code":"fail_closed","type":"codeVoice"},{"type":"text","text":" setting from"},{"type":"text","text":" "},{"type":"text","text":"inside the library."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"It does not filter a patch","type":"text"}],"type":"strong"},{"text":" (§22.4 rule 1).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"It honours "},{"type":"codeVoice","code":"timeout_ms"}],"type":"strong"},{"type":"text","text":" by abandoning work whose window has closed"},{"type":"text","text":" "},{"type":"text","text":"rather than replying late."}]}]}],"type":"orderedList"},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"text":"only what the ","type":"text"},{"inlineContent":[{"text":"transport","type":"text"}],"type":"emphasis"},{"text":" throws. A