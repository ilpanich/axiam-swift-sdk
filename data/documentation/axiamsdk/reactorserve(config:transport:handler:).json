},{"type":"text","text":" "},{"type":"text","text":"threw would have overridden the operator’s "},{"code":"fail_closed","type":"codeVoice"},{"type":"text","text":" setting from"},{"type":"text","text":" "},{"type":"text","text":"inside the library."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"It does not filter a patch"}],"type":"strong"},{"text":" (§22.4 rule 1).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"It honours ","type":"text"},{"code":"timeout_ms","type":"codeVoice"}]},{"type":"text","text":" by abandoning work whose window has closed"},{"type":"text","text":" "},{"type":"text","text":"rather than replying late."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only what the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"transport"}]},{"type":"text","text":" throws. A handler’s failure is caught and"},{"type":"text","text":" "},{"type":"text","text":"turned into an abstention, because that is what rule 2 requires; a"},{"type":"text","text":" "},{"type":"text","text":"transport’s is not, because a broker that has gone away is not something to"},{"type":"text","text":" "},{"type":"text","text":"keep looping on."}]}],"style":"note","name":"Throws"}]}],"abstract":[{"type":"text","text":"Consume, verify, dispatch, sign, publish — until the transport is done."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/reactorserve(config:transport:handler:)"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://AxiamSDK/documentation/AxiamSDK/ReactorConfig":{"title":"ReactorConfig","navigatorTitle":[{"text":"ReactorConfig","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorConfig"