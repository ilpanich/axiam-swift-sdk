ontent":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"It declares no topology"}]},{"type":"text","text":" (§22.1). The transport is not even given the"},{"type":"text","text":" "},{"type":"text","text":"vocabulary to."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"It fails closed on its own errors.","type":"text"}]},{"type":"text","text":" A handler that throws, or a body the"},{"type":"text","text":" "},{"type":"text","text":"runtime cannot verify, produces NO REPLY — letting the server’s"},{"type":"text","text":" "},{"code":"failure_policy","type":"codeVoice"},{"type":"text","text":" decide. A runtime that answered "},{"code":"allow","type":"codeVoice"},{"type":"text","text":" for a handler that"},{"type":"text","text":" "},{"type":"text","text":"threw would have overridden the operator’s "},{"code":"fail_closed","type":"codeVoice"},{"type":"text","text":" setting from"},{"type":"text","text":" "},{"type":"text","text":"inside the library."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"It does not filter a patch"}]},{"text":" (§22.4 rule 1).","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"It honours "},{"code":"timeout_ms","type":"codeVoice"}],"type":"strong"},{"text":" by abandoning work whose window has closed","type":"text"},{"text":" ","type":"text"},{"text":"rather than replying late.","type":"text"}],"type":"paragraph"}]}]},{"type":"aside","name":"Throws","content":[{"inlineContent":[{"type":"text","text":"only what the "},{"type":"emphasis","inlineContent":[{"text":"transport","type":"text"}]},{"type":"text","text":" throws. A handler’s failure is caught and"},{"type":"text","text":" "},{"type":"text","text":"turned into an abstention, because that is what rule 2 requires; a"},{"type":"text","text":" "},{"type":"text","text":"transport’s is not, because a broker that has gone away is not something to"},{"type":"text","text":" "},{"type":"text","text":"keep looping on."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/reactorserve(config:transport:handler:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/ReactorConfig":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorConfig","title":"ReactorConfig","url":"\/documentation\/axiamsdk\/reactorconfig","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ReactorConfig","kind":"identifier"}],"abstract":[{"text":"What ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/reactorServe(config:transport:handler:)","isActive":true,"type":"reference"},{"text":" needs to run.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"ReactorConfig","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ReactorEvent":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ReactorEvent"}],"title":"ReactorEvent","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorEvent","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A delivery that passed every §22.3 check."}],"url":"\/documentation\/axiamsdk\/reactorevent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReactorEvent"}]},"doc://AxiamSDK/documentation/AxiamSDK/ReactorAnswer":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReactorAnswer"}],"navigatorTitle":[{"kind":"identifier","text":"ReactorAnswer"}],"role":"symbol","abstract":[{"type":"text","text":"A handler’s answer, or ABSTENTION."}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/reactoranswer","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorAnswer","title":"Reactor