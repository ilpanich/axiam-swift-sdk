{"metadata":{"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ke2"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ksf"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9KsfParamsV","kind":"typeIdentifier","text":"KsfParams"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"externalID":"s:8AxiamSDK13LoginExchangeC6finish8password3ke23ksfS2S_SSAA9KsfParamsVtKF","role":"symbol","modules":[{"name":"AxiamSDK"}],"title":"finish(password:ke2:ksf:)"},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/loginexchange\/finish(password:ke2:ksf:)"]}],"abstract":[{"type":"text","text":"Opens the envelope, producing "},{"type":"codeVoice","code":"KE3"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange\/finish(password:ke2:ksf:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ke2"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ksf"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9KsfParamsV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams","kind":"typeIdentifier","text":"KsfParams"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"languages":["swift"]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"A failure here is the "},{"inlineContent":[{"type":"text","text":"whole"}],"type":"strong"},{"type":"text","text":" of the client’s authentication check, and covers both"},{"type":"text","text":" "},{"type":"text","text":"halves of the mutual authentication: the envelope only opens under the right password, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"KE2"},{"type":"text","text":"’s MAC only verifies if the server actually holds the record. Nothing may be sent"},{"type":"text","text":" "},{"type":"text","text":"afterwards (§23.4 rule 7)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Whether the caller is "},{"inlineContent":[{"type":"text","text":"finished"}],"type":"emphasis"},{"type":"text","text":" is a separate question, and one this type deliberately"},{"type":"text","text":" "},{"type":"text","text":"does not answer: under an "},{"code":"optional","type":"codeVoice"},{"type":"text","text":" tenant a failure here is the ordinary case for an"},{"type":"text","text":" "},{"type":"text","text":"account that has no registration record yet, and §23.4 rule 7 requires a retry over"},{"type":"text","text":" "},{"code":"POST \/auth\/login","type":"codeVoice"},{"type":"text","text":". That branch needs the "},{"code":"mode","type":"codeVoice"},{"type":"text","text":" field from the "},{"code":"login\/start","type":"codeVoice"},{"type":"text","text":" response, so"},{"type":"text","text":" "},{"type":"text","text":"it lives in "},{"code":"AxiamClient.loginOpaque","type":"codeVoice"},{"type":"text","text":" where the response is; the error raised here is the"},{"type":"text","text":" "},{"type":"text","text":"same one either way."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That case is an "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true},{"type":"text","text":", unlike every other refusal in this package. The"},{"type":"text","text":" "},{"type":"text","text":"distinction is the point: a wrong password, an account that does not exist and a server"},{"type":"text","text":" "},{"type":"text","text":"that does not hold the record are indistinguishable by design and are all authentication"},{"type":"text","text":" "},{"type":"text","text":"failures, whereas a key-stretching function this build cannot perform is a configuration"},{"type":"text","text":" "},{"type":"text","text":"problem, and reporting it as “invalid password” would send an operator looking in the wrong"},{"type":"text","text":" "},{"type":"text","text":"place."}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"type":"text","text":" when the envelope does not open or "},{"type":"codeVoice","code":"KE2"},{"type":"text","text":" does not verify."}]}],"type":"aside"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},{"type":"text","text":" if the exchange is already spent, or the"},{"type":"text","text":" "},{"type":"text","text":"key-stretching function is one this SDK cannot ask for."}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/LoginExchange/finish(password:ke2:ksf:)":{"kind":"symbol","url":"\/documentation\/axiamsdk\/loginexchange\/finish(password:ke2:ksf:)","title":"finish(password:ke2:ksf:)","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Opens the envelope, producing "},{"type":"codeVoice","code":"KE3"},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ke2"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ksf"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"KsfParams","preciseIdentifier":"s:8AxiamSDK9KsfParamsV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange\/finish(password:ke2:ksf:)"},"doc://AxiamSDK/documentation/AxiamSDK/LoginExchange":{"title":"LoginExchange","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange","navigatorTitle":[{"kind":"identifier","text":"LoginExchange"}],"abstract":[{"type":"text","text":"One in-flight login (CONTRACT.md §23)."}],"url":"\/documentation\/axiamsdk\/loginexchange","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LoginExchange"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/KsfParams":{"type":"topic","title":"KsfParams","abstract":[{"type":"text","text":"The key-stretching function and cost a "},{"type":"codeVoice","code":"\/start"},{"type":"text","text":" response names (CONTRACT.md §23.4)."}],"url":"\/documentation\/axiamsdk\/ksfparams","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KsfParams"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KsfParams"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/network(_:)":{"title":"AxiamError.network(_:)","url":"\/documentation\/axiamsdk\/axiamerror\/network(_:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"network"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8AxiamSDK12NetworkErrorV","kind":"typeIdentifier","text":"NetworkError"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Transport-level failure: connection refused, timeout, TLS error, DNS failure,"},{"type":"text","text":" "},{"type":"text","text":"malformed request, server (5xx) error."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/auth(_:)":{"kind":"symbol","abstract":[{"text":"Authentication failure: wrong credentials, expired session, MFA failure,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"or a 401 on the refresh call itself."}],"type":"topic","url":"\/documentation\/axiamsdk\/axiamerror\/auth(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"auth"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8AxiamSDK9AuthErrorV","kind":"typeIdentifier","text":"AuthError"},{"kind":"text","text":")"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","role":"symbol","title":"AxiamError.auth(_:)"}}}