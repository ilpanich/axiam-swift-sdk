{"sections":[],"metadata":{"externalID":"s:8AxiamSDK13LoginExchangeC6finish8password3ke23ksfS2S_SSAA9KsfParamsVtKF","symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"ke2","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"ksf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"KsfParams","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9KsfParamsV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"role":"symbol","title":"finish(password:ke2:ksf:)"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ke2"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ksf"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9KsfParamsV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams","kind":"typeIdentifier","text":"KsfParams"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"A failure here is the ","type":"text"},{"inlineContent":[{"type":"text","text":"whole"}],"type":"strong"},{"text":" of the client’s authentication check, and covers both","type":"text"},{"text":" ","type":"text"},{"text":"halves of the mutual authentication: the envelope only opens under the right password, and","type":"text"},{"text":" ","type":"text"},{"code":"KE2","type":"codeVoice"},{"text":"’s MAC only verifies if the server actually holds the record. Nothing may be sent","type":"text"},{"text":" ","type":"text"},{"text":"afterwards (§23.4 rule 7).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Whether the caller is "},{"type":"emphasis","inlineContent":[{"text":"finished","type":"text"}]},{"type":"text","text":" is a separate question, and one this type deliberately"},{"type":"text","text":" "},{"type":"text","text":"does not answer: under an "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" tenant a failure here is the ordinary case for an"},{"type":"text","text":" "},{"type":"text","text":"account that has no registration record yet, and §23.4 rule 7 requires a retry over"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/auth\/login"},{"type":"text","text":". That branch needs the "},{"type":"codeVoice","code":"mode"},{"type":"text","text":" field from the "},{"type":"codeVoice","code":"login\/start"},{"type":"text","text":" response, so"},{"type":"text","text":" "},{"type":"text","text":"it lives in "},{"type":"codeVoice","code":"AxiamClient.loginOpaque"},{"type":"text","text":" where the response is; the error raised here is the"},{"type":"text","text":" "},{"type":"text","text":"same one either way."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That case is an "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true},{"type":"text","text":", unlike every other refusal in this package. The"},{"type":"text","text":" "},{"type":"text","text":"distinction is the point: a wrong password, an account that does not exist and a server"},{"type":"text","text":" "},{"type":"text","text":"that does not hold the record are indistinguishable by design and are all authentication"},{"type":"text","text":" "},{"type":"text","text":"failures, whereas a key-stretching function this build cannot perform is a configuration"},{"type":"text","text":" "},{"type":"text","text":"problem, and reporting it as “invalid password” would send an operator looking in the wrong"},{"type":"text","text":" "},{"type":"text","text":"place."}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"text":" when the envelope does not open or ","type":"text"},{"code":"KE2","type":"codeVoice"},{"text":" does not verify.","type":"text"}]}],"type":"aside"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","type":"reference","isActive":true},{"text":" if the exchange is already spent, or the","type":"text"},{"text":" ","type":"text"},{"text":"key-stretching function is one this SDK cannot ask for.","type":"text"}]}],"type":"aside"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange\/finish(password:ke2:ksf:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"paths":["\/documentation\/axiamsdk\/loginexchange\/finish(password:ke2:ksf:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange"]]},"abstract":[{"type":"text","text":"Opens the envelope, producing "},{"code":"KE3","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/auth(_:)":{"title":"AxiamError.auth(_:)","abstract":[{"type":"text","text":"Authentication failure: wrong credentials, expired session, MFA failure,"},{"type":"text","text":" "},{"type":"text","text":"or a 401 on the refresh call itself."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"auth"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9AuthErrorV","text":"AuthError"},{"kind":"text","text":")"}],"url":"\/documentation\/axiamsdk\/axiamerror\/auth(_:)","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/LoginExchange":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange","type":"topic","abstract":[{"type":"text","text":"One in-flight login (CONTRACT.md §23)."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LoginExchange"}],"url":"\/documentation\/axiamsdk\/loginexchange","navigatorTitle":[{"kind":"identifier","text":"LoginExchange"}],"role":"symbol","title":"LoginExchange"},"doc://AxiamSDK/documentation/AxiamSDK/LoginExchange/finish(password:ke2:ksf:)":{"title":"finish(password:ke2:ksf:)","abstract":[{"type":"text","text":"Opens the envelope, producing "},{"type":"codeVoice","code":"KE3"},{"type":"text","text":"."}],"type":"topic","iden