{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/loginexchange\/finish(password:ke2:ksf:)"]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange\/finish(password:ke2:ksf:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ke2"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ksf"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9KsfParamsV","text":"KsfParams","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A failure here is the "},{"type":"strong","inlineContent":[{"text":"whole","type":"text"}]},{"type":"text","text":" of the client’s authentication check, and covers both"},{"type":"text","text":" "},{"type":"text","text":"halves of the mutual authentication: the envelope only opens under the right password, and"},{"type":"text","text":" "},{"code":"KE2","type":"codeVoice"},{"type":"text","text":"’s MAC only verifies if the server actually holds the record. Nothing may be sent"},{"type":"text","text":" "},{"type":"text","text":"afterwards (§23.4 rule 7)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Whether the caller is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"finished"}]},{"type":"text","text":" is a separate question, and one this type deliberately"},{"type":"text","text":" "},{"type":"text","text":"does not answer: under an "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" tenant a failure here is the ordinary case for an"},{"type":"text","text":" "},{"type":"text","text":"account that has no registration record yet, and §23.4 rule 7 requires a retry over"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/auth\/login"},{"type":"text","text":". That branch needs the "},{"type":"codeVoice","code":"mode"},{"type":"text","text":" field from the "},{"type":"codeVoice","code":"login\/start"},{"type":"text","text":" response, so"},{"type":"text","text":" "},{"type":"text","text":"it lives in "},{"type":"codeVoice","code":"AxiamClient.loginOpaque"},{"type":"text","text":" where the response is; the error raised here is the"},{"type":"text","text":" "},{"type":"text","text":"same one either way."}],"type":"paragraph"},{"inlineContent":[{"text":"That case is an ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"text":", unlike every other refusal in this package. The","type":"text"},{"text":" ","type":"text"},{"text":"distinction is the point: a wrong password, an account that does not exist and a server","type":"text"},{"text":" ","type":"text"},{"text":"that does not hold the record are indistinguishable by design and are all authentication","type":"text"},{"text":" ","type":"text"},{"text":"failures, whereas a key-stretching function this build cannot perform is a configuration","type":"text"},{"text":" ","type":"text"},{"text":"problem, and reporting it as “invalid password” would send an operator looking in the wrong","type":"text"},{"text":" ","type":"text"},{"text":"place.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"type":"text","text":" when the envelope does not open or "},{"type":"codeVoice","code":"KE2"},{"type":"text","text":" does not verify."}]}],"type":"aside","style":"note","name":"Throws"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","type":"reference"},{"text":" if the exchange is already spent, or the","type":"text"},{"text":" ","type":"text"},{"text":"key-stretching function is one this SDK cannot ask for.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Throws"}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"Opens the envelope, producing "},{"code":"KE3","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Method","title":"finish(password:ke2:ksf:)","externalID":"s:8AxiamSDK13LoginExchangeC6finish8password3ke23ksfS2S_SSAA9KsfParamsVtKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"ke2","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"ksf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"KsfParams","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9KsfParamsV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"symbolKind":"method","role":"symbol"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/auth(_:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"topic","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"auth","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AuthError","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9AuthErrorV"},{"text":")","kind":"text"}],"role":"symbol","title":"AxiamError.auth(_:)","url":"\/documentation\/axiamsdk\/axiamerror\/auth(_:)","abstract":[{"text":"Authentication failure: wrong credentials, expired session, MFA failure,","type":"text"},{"text":" ","type":"text"},{"text":"or a 401 on the refresh call itself.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/network(_:)":{"url":"\/documentation\/axiamsdk\/axiamerror\/network(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"network","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NetworkError","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12NetworkErrorV"},{"text":")","kind":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","role":"symbol","abstract":[{"type":"text","text":"Transport-level failure: connection refused, timeout, TLS error, DNS failure,"},{"type":"text","text":" "},{"type":"text","text":"malformed request, server (5xx) error."}],"title":"AxiamError.network(_:)"},"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/doc