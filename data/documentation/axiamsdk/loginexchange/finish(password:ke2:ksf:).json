{"abstract":[{"text":"Opens the envelope, producing ","type":"text"},{"type":"codeVoice","code":"KE3"},{"text":".","type":"text"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/loginexchange\/finish(password:ke2:ksf:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"ke2","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"ksf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"KsfParams","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9KsfParamsV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A failure here is the ","type":"text"},{"inlineContent":[{"type":"text","text":"whole"}],"type":"strong"},{"text":" of the client’s authentication check, and covers both","type":"text"},{"text":" ","type":"text"},{"text":"halves of the mutual authentication: the envelope only opens under the right password, and","type":"text"},{"text":" ","type":"text"},{"code":"KE2","type":"codeVoice"},{"text":"’s MAC only verifies if the server actually holds the record. Nothing may be sent","type":"text"},{"text":" ","type":"text"},{"text":"afterwards (§23.4 rule 7).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether the caller is "},{"inlineContent":[{"type":"text","text":"finished"}],"type":"emphasis"},{"type":"text","text":" is a separate question, and one this type deliberately"},{"type":"text","text":" "},{"type":"text","text":"does not answer: under an "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" tenant a failure here is the ordinary case for an"},{"type":"text","text":" "},{"type":"text","text":"account that has no registration record yet, and §23.4 rule 7 requires a retry over"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/auth\/login"},{"type":"text","text":". That branch needs the "},{"type":"codeVoice","code":"mode"},{"type":"text","text":" field from the "},{"type":"codeVoice","code":"login\/start"},{"type":"text","text":" response, so"},{"type":"text","text":" "},{"type":"text","text":"it lives in "},{"type":"codeVoice","code":"AxiamClient.loginOpaque"},{"type":"text","text":" where the response is; the error raised here is the"},{"type":"text","text":" "},{"type":"text","text":"same one either way."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That case is an "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true,"type":"reference"},{"type":"text","text":", unlike every other refusal in this package. The"},{"type":"text","text":" "},{"type":"text","text":"distinction is the point: a wrong password, an account that does not exist and a server"},{"type":"text","text":" "},{"type":"text","text":"that does not hold the record are indistinguishable by design and are all authentication"},{"type":"text","text":" "},{"type":"text","text":"failures, whereas a key-stretching function this build cannot perform is a configuration"},{"type":"text","text":" "},{"type":"text","text":"problem, and reporting it as “invalid password” would send an operator looking in the wrong"},{"type":"text","text":" "},{"type":"text","text":"place."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"text":" when the envelope does not open or ","type":"text"},{"type":"codeVoice","code":"KE2"},{"text":" does not verify.","type":"text"}]}],"type":"aside","name":"Throws"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","type":"reference"},{"type":"text","text":" if the exchange is already spent, or the"},{"type":"text","text":" "},{"type":"text","text":"key-stretching function is one this SDK cannot ask for."}],"type":"paragraph"}],"type":"aside","name":"Throws"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange\/finish(password:ke2:ksf:)"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange"]]},"metadata":{"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"ke2","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"ksf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"KsfParams","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9KsfParamsV"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"title":"finish(password:ke2:ksf:)","modules":[{"name":