{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange"]]},"sections":[],"metadata":{"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"ke2","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"ksf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"KsfParams","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9KsfParamsV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"externalID":"s:8AxiamSDK13LoginExchangeC6finish8password3ke23ksfS2S_SSAA9KsfParamsVtKF","role":"symbol","modules":[{"name":"AxiamSDK"}],"symbolKind":"method","title":"finish(password:ke2:ksf:)"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange\/finish(password:ke2:ksf:)"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"ke2","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"ksf","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK9KsfParamsV","text":"KsfParams","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}]}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A failure here is the "},{"type":"strong","inlineContent":[{"type":"text","text":"whole"}]},{"type":"text","text":" of the client’s authentication check, and covers both"},{"type":"text","text":" "},{"type":"text","text":"halves of the mutual authentication: the envelope only opens under the right password, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"KE2"},{"type":"text","text":"’s MAC only verifies if the server actually holds the record. Nothing may be sent"},{"type":"text","text":" "},{"type":"text","text":"afterwards (§23.4 rule 7)."}],"type":"paragraph"},{"inlineContent":[{"text":"Whether the caller is ","type":"text"},{"inlineContent":[{"type":"text","text":"finished"}],"type":"emphasis"},{"text":" is a separate question, and one this type deliberately","type":"text"},{"text":" ","type":"text"},{"text":"does not answer: under an ","type":"text"},{"code":"optional","type":"codeVoice"},{"text":" tenant a failure here is the ordinary case for an","type":"text"},{"text":" ","type":"text"},{"text":"account that has no registration record yet, and §23.4 rule 7 requires a retry over","type":"text"},{"text":" ","type":"text"},{"code":"POST \/auth\/login","type":"codeVoice"},{"text":". That branch needs the ","type":"text"},{"code":"mode","type":"codeVoice"},{"text":" field from the ","type":"text"},{"code":"login\/start","type":"codeVoice"},{"text":" response, so","type":"text"},{"text":" ","type":"text"},{"text":"it lives in ","type":"text"},{"code":"AxiamClient.loginOpaque","type":"codeVoice"},{"text":" where the response is; the error raised here is the","type":"text"},{"text":" ","type":"text"},{"text":"same one either way.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That case is an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference"},{"text":", unlike every other refusal in this package. The","type":"text"},{"text":" ","type":"text"},{"text":"distinction is the point: a wrong password, an account that does not exist and a server","type":"text"},{"text":" ","type":"text"},{"text":"that does not hold the record are indistinguishable by design and are all authentication","type":"text"},{"text":" ","type":"text"},{"text":"failures, whereas a key-stretching function this build cannot perform is a configuration","type":"text"},{"text":" ","type":"text"},{"text":"problem, and reporting it as “invalid password” would send an operator looking in the wrong","type":"text"},{"text":" ","type":"text"},{"text":"place.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"type":"text","text":" when the envelope does not open or "},{"type":"codeVoice","code":"KE2"},{"type":"text","text":" does not verify."}],"type":"paragraph"}],"type":"aside","name":"Throws"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","type":"reference"},{"type":"text","text":" if the exchange is already spent, or the"},{"type":"text","text":" "},{"type":"text","text":"key-stretching function is one this SDK cannot ask for."}]}],"type":"aside","name":"Throws"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/axiamsdk\/loginexchange\/finish(password:ke2:ksf:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Opens 