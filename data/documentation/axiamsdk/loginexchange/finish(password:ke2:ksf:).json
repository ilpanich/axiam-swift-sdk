{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange\/finish(password:ke2:ksf:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ke2"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ksf"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams","kind":"typeIdentifier","text":"KsfParams","preciseIdentifier":"s:8AxiamSDK9KsfParamsV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"A failure here is the ","type":"text"},{"inlineContent":[{"text":"whole","type":"text"}],"type":"strong"},{"text":" of the client’s authentication check, and covers both","type":"text"},{"text":" ","type":"text"},{"text":"halves of the mutual authentication: the envelope only opens under the right password, and","type":"text"},{"text":" ","type":"text"},{"code":"KE2","type":"codeVoice"},{"text":"’s MAC only verifies if the server actually holds the record. Nothing may be sent","type":"text"},{"text":" ","type":"text"},{"text":"afterwards (§23.4 rule 7).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Whether the caller is "},{"inlineContent":[{"type":"text","text":"finished"}],"type":"emphasis"},{"type":"text","text":" is a separate question, and one this type deliberately"},{"type":"text","text":" "},{"type":"text","text":"does not answer: under an "},{"code":"optional","type":"codeVoice"},{"type":"text","text":" tenant a failure here is the ordinary case for an"},{"type":"text","text":" "},{"type":"text","text":"account that has no registration record yet, and §23.4 rule 7 requires a retry over"},{"type":"text","text":" "},{"code":"POST \/auth\/login","type":"codeVoice"},{"type":"text","text":". That branch needs the "},{"code":"mode","type":"codeVoice"},{"type":"text","text":" field from the "},{"code":"login\/start","type":"codeVoice"},{"type":"text","text":" response, so"},{"type":"text","text":" "},{"type":"text","text":"it lives in "},{"code":"AxiamClient.loginOpaque","type":"codeVoice"},{"type":"text","text":" where the response is; the error raised here is the"},{"type":"text","text":" "},{"type":"text","text":"same one either way."}],"type":"paragraph"},{"inlineContent":[{"text":"That case is an ","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true},{"text":", unlike every other refusal in this package. The","type":"text"},{"text":" ","type":"text"},{"text":"distinction is the point: a wrong password, an account that does not exist and a server","type":"text"},{"text":" ","type":"text"},{"text":"that does not hold the record are indistinguishable by design and are all authentication","type":"text"},{"text":" ","type":"text"},{"text":"failures, whereas a key-stretching function this build cannot perform is a configuration","type":"text"},{"text":" ","type":"text"},{"text":"problem, and reporting it as “invalid password” would send an operator looking in the wrong","type":"text"},{"text":" ","type":"text"},{"text":"place.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)"},{"type":"text","text":" when the envelope does not open or "},{"code":"KE2","type":"codeVoice"},{"type":"text","text":" does not verify."}],"type":"paragraph"}],"name":"Throws","type":"aside"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","type":"reference"},{"type":"text","text":" if the exchange is already spent, or the"},{"type":"text","text":" "},{"type":"text","text":"key-stretching function is one this SDK cannot ask for."}],"type":"paragraph"}],"name":"Throws","type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/loginexchange\/finish(password:ke2:ksf:)"]}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ke2"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ksf"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"KsfParams","preciseIdentifier":"s:8AxiamSDK9KsfParamsV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"title":"finish(password:ke2:ksf:)","roleHeading":"Instance Method","externalID":"s:8AxiamSDK13LoginExchangeC6finish8password3ke23ksfS2S_SSAA9KsfParamsVtKF","symbolKind":"method","modules":[{"name":"AxiamSDK"}],"role":"symbol"},"kind":"symbol","sections":[],"abstract":[{"text":"Opens the envelope, producing ","type":"text"},{"type":"codeVoice","code":"KE3"},{"text