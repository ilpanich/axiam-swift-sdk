xt":", ","kind":"text"},{"text":"ksf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"KsfParams","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams","preciseIdentifier":"s:8AxiamSDK9KsfParamsV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"A failure here is the ","type":"text"},{"inlineContent":[{"text":"whole","type":"text"}],"type":"strong"},{"text":" of the client’s authentication check, and covers both","type":"text"},{"text":" ","type":"text"},{"text":"halves of the mutual authentication: the envelope only opens under the right password, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"KE2"},{"text":"’s MAC only verifies if the server actually holds the record. Nothing may be sent","type":"text"},{"text":" ","type":"text"},{"text":"afterwards (§23.4 rule 7).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Whether the caller is ","type":"text"},{"inlineContent":[{"type":"text","text":"finished"}],"type":"emphasis"},{"text":" is a separate question, and one this type deliberately","type":"text"},{"text":" ","type":"text"},{"text":"does not answer: under an ","type":"text"},{"code":"optional","type":"codeVoice"},{"text":" tenant a failure here is the ordinary case for an","type":"text"},{"text":" ","type":"text"},{"text":"account that has no registration record yet, and §23.4 rule 7 requires a retry over","type":"text"},{"text":" ","type":"text"},{"code":"POST \/auth\/login","type":"codeVoice"},{"text":". That branch needs the ","type":"text"},{"code":"mode","type":"codeVoice"},{"text":" field from the ","type":"text"},{"code":"login\/start","type":"codeVoice"},{"text":" response, so","type":"text"},{"text":" ","type":"text"},{"text":"it lives in ","type":"text"},{"code":"AxiamClient.loginOpaque","type":"codeVoice"},{"text":" where the response is; the error raised here is the","type":"text"},{"text":" ","type":"text"},{"text":"same one either way.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That case is an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference"},{"text":", unlike every other refusal in this package. The","type":"text"},{"text":" ","type":"text"},{"text":"distinction is the point: a wrong password, an account that does not exist and a server","type":"text"},{"text":" ","type":"text"},{"text":"that does not hold the record are indistinguishable by design and are all authentication","type":"text"},{"text":" ","type":"text"},{"text":"failures, whereas a key-stretching function this build cannot perform is a configuration","type":"text"},{"text":" ","type":"text"},{"text":"problem, and reporting it as “invalid password” would send an operator looking in the wrong","type":"text"},{"text":" ","type":"text"},{"text":"place.","type":"text"}],"type":"paragraph"},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true},{"type":"text","text":" when the envelope does not open or "},{"code":"KE2","type":"codeVoice"},{"type":"text","text":" does not verify."}],"type":"paragraph"}]},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","isActive":true,"type":"reference"},{"text":" if the exchange is already spent, or the","type":"text"},{"text":" ","type":"text"},{"text":"key-stretching function is one this SDK cannot ask for.","type":"text"}],"type":"paragraph"}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/LoginExchange":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange","navigatorTitle":[{"text":"LoginExchange","kind":"identifier"}],"title":"LoginExchange","abstract":[{"text":"One in-flight login (CONTRACT.md §23).","type":"text"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/loginexchange","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoginExchange","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/KsfParams":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams","navigatorTitle":[{"text":"KsfParams","kind":"identifier"}],"title":"KsfParams","abstract":[{"text":"The key-stretching function and cost a ","type":"text"},{"code":"\/start","type":"codeVoice"},{"text":" response names (CONTRACT.md §23.4).","type":"text"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/ksfparams","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KsfParams","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamError/auth(_:)":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","title":"AxiamError.auth(_:)","abstract":[{"text":"Authentication failure: wrong credentials, expired session, MFA failure,","type":"text"},{"text":" ","type":"text"},{"text":"or a 401 on the refresh call itself.","type":"text"}],"kind":"symbol","url":"