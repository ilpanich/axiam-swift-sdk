{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"(","kind":"text"},{"text":"password","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"ke2","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"ksf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"KsfParams","preciseIdentifier":"s:8AxiamSDK9KsfParamsV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"symbolKind":"method","externalID":"s:8AxiamSDK13LoginExchangeC6finish8password3ke23ksfS2S_SSAA9KsfParamsVtKF","modules":[{"name":"AxiamSDK"}],"role":"symbol","title":"finish(password:ke2:ksf:)","roleHeading":"Instance Method"},"kind":"symbol","variants":[{"paths":["\/documentation\/axiamsdk\/loginexchange\/finish(password:ke2:ksf:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ke2"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"ksf"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"KsfParams","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams","preciseIdentifier":"s:8AxiamSDK9KsfParamsV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"A failure here is the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"whole"}]},{"text":" of the client’s authentication check, and covers both","type":"text"},{"text":" ","type":"text"},{"text":"halves of the mutual authentication: the envelope only opens under the right password, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"KE2"},{"text":"’s MAC only verifies if the server actually holds the record. Nothing may be sent","type":"text"},{"text":" ","type":"text"},{"text":"afterwards (§23.4 rule 7).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Whether the caller is ","type":"text"},{"inlineContent":[{"type":"text","text":"finished"}],"type":"emphasis"},{"text":" is a separate question, and one this type deliberately","type":"text"},{"text":" ","type":"text"},{"text":"does not answer: under an ","type":"text"},{"type":"codeVoice","code":"optional"},{"text":" tenant a failure here is the ordinary case for an","type":"text"},{"text":" ","type":"text"},{"text":"account that has no registration record yet, and §23.4 rule 7 requires a retry over","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"POST \/auth\/login"},{"text":". That branch needs the ","type":"text"},{"type":"codeVoice","code":"mode"},{"text":" field from the ","type":"text"},{"type":"codeVoice","code":"login\/start"},{"text":" response, so","type":"text"},{"text":" ","type":"text"},{"text":"it lives in ","type":"text"},{"type":"codeVoice","code":"AxiamClient.loginOpaque"},{"text":" where the response is; the error raised here is the","type":"text"},{"text":" ","type":"text"},{"text":"same one either way.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That case is an ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","type":"reference","isActive":true},{"text":", unlike every other refusal in this package. The","type":"text"},{"text":" ","type":"text"},{"text":"distinction is the point: a wrong password, an account that does not exist and a server","type":"text"},{"text":" ","type":"text"},{"text":"that does not hold the record are indistinguishable by design and are all authentication","type":"text"},{"text":" ","type":"text"},{"text":"failures, whereas a key-stretching function this build cannot perform is a configuration","type":"text"},{"text":" ","type":"text"},{"text":"problem, and reporting it as “invalid password” would send an operator looking in the wrong","type":"text"},{"text":" ","type":"text"},{"text":"place.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/auth(_:)","isActive":true,"type":"reference"},{"text":" when the envelope does not open or ","type":"text"},{"code":"KE2","type":"codeVoice"},{"text":" does not verify.","type":"text"}]}],"type":"aside"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamError\/network(_:)","isActive":true},{"text":" if the exchange is already spent, or the","type":"text"},{"text":" ","type":"text"},{"text":"key-stretching function is one this SDK cannot ask for.","type":"text"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange\/finish(password:ke2:k