ype":"text"},{"text":" ","type":"text"},{"text":"way a directory group reaches an AXIAM group.","type":"text"}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"type":"codeVoice","code":"admins"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"axiam_directory::dn"},{"text":"), so ","type":"text"},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}],"title":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","url":"\/documentation\/axiamsdk\/groupmapping","kind":"symbol","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig":{"title":"DirectoryConfig","abstract":[{"text":"A tenant’s directory configuration, as stored and as read back. Carries no secret: see the","type":"text"},{"text":" ","type":"text"},{"text":"module documentation.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectoryConfig","kind":"identifier"}],"navigatorTitle":[{"text":"DirectoryConfig","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/directoryconfig","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"}}}