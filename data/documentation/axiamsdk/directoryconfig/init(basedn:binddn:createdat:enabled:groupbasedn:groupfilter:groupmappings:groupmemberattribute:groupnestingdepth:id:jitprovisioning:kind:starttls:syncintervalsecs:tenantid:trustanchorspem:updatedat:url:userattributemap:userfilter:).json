ibuteMapV","text":"UserAttributeMap","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"userFilter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(baseDn:bindDn:createdAt:enabled:groupBaseDn:groupFilter:groupMappings:groupMemberAttribute:groupNestingDepth:id:jitProvisioning:kind:startTLS:syncIntervalSecs:tenantID:trustAnchorsPEM:updatedAt:url:userAttributeMap:userFilter:)","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig\/init(baseDn:bindDn:createdAt:enabled:groupBaseDn:groupFilter:groupMappings:groupMemberAttribute:groupNestingDepth:id:jitProvisioning:kind:startTLS:syncIntervalSecs:tenantID:trustAnchorsPEM:updatedAt:url:userAttributeMap:userFilter:)"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"url":"\/documentation\/axiamsdk\/groupmapping","kind":"symbol","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"title":"GroupMapping","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryKind":{"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DirectoryKind"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind","title":"DirectoryKind","url":"\/documentation\/axiamsdk\/directorykind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectoryKind"}],"abstract":[{"type":"text","text":"Which kind of directory server a configuration points at. It drives "},{"type":"strong","inlineContent":[{"type":"text","text":"defaults only"}]},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"external-id attribute, the group-membership strategy and the change attribute the sync job"},{"type":"text","text":" "},{"type":"text","text":"reads. Every one of them is still an explicit, editable field of the configuration (or, for"},{"type":"text","text":" "},{"type":"text","text":"the strategy and change attribute, derived from this value at the point of use); nothing"},{"type":"text","text":" "},{"type":"text","text":"about the kind changes what is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"allowed"}]},{"type":"text","text":"."}]},"doc://AxiamSDK/documentation/AxiamSDK/UserAttributeMap":{"abstract":[{"type":"text","text":"Which directory attribute feeds each AXIAM user field."}],"kind":"symbol","title":"UserAttributeMap","type":"topic","navigatorTitle":[{"text":"UserAttributeMap","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/userattributemap","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserAttributeMap","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UserAttributeMap","kind":"identifier"}]}}}