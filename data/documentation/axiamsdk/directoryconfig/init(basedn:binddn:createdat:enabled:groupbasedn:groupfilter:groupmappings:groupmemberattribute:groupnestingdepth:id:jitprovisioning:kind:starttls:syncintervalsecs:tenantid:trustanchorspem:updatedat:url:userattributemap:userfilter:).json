d":"identifier","text":"DirectoryConfig"}],"title":"DirectoryConfig"},"doc://AxiamSDK/documentation/AxiamSDK/UserAttributeMap":{"navigatorTitle":[{"kind":"identifier","text":"UserAttributeMap"}],"url":"\/documentation\/axiamsdk\/userattributemap","title":"UserAttributeMap","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UserAttributeMap"}],"kind":"symbol","abstract":[{"text":"Which directory attribute feeds each AXIAM user field.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserAttributeMap"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"role":"symbol","url":"\/documentation\/axiamsdk\/groupmapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","type":"topic","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"text":"way a directory group reaches an AXIAM group.","type":"text"}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"title":"GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryKind":{"role":"symbol","abstract":[{"text":"Which kind of directory server a configuration points at. It drives ","type":"text"},{"inlineContent":[{"type":"text","text":"defaults only"}],"type":"strong"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"external-id attribute, the group-membership strategy and the change attribute the sync job","type":"text"},{"text":" ","type":"text"},{"text":"reads. Every one of them is still an explicit, editable field of the configuration (or, for","type":"text"},{"text":" ","type":"text"},{"text":"the strategy and change attribute, derived from this value at the point of use); nothing","type":"text"},{"text":" ","type":"text"},{"text":"about the kind changes what is ","type":"text"},{"inlineContent":[{"text":"allowed","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"url":"\/documentation\/axiamsdk\/directorykind","title":"DirectoryKind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectoryKind"}],"navigatorTitle":[{"kind":"identifier","text":"DirectoryKind"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig/init(baseDn:bindDn:createdAt:enabled:groupBaseDn:groupFilter:groupMappings:groupMemberAttribute:groupNestingDepth:id:jitProvisioning:kind:startTLS:syncIntervalSecs: