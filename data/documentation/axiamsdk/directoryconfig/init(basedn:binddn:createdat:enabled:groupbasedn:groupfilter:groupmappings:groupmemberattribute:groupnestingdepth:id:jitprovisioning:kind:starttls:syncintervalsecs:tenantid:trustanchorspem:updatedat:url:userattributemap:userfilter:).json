xt":"startTLS"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"syncIntervalSecs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenantID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"trustAnchorsPEM"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"updatedAt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"url"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"userAttributeMap"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UserAttributeMap","preciseIdentifier":"s:8AxiamSDK16UserAttributeMapV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"userFilter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":")"}]},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"type":"strong","inlineContent":[{"text":"The table is the only","type":"text"},{"text":" ","type":"text"},{"text":"way a directory group reaches an AXIAM group.","type":"text"}]},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"axiam_directory::dn","type":"codeVoice"},{"text":"), so ","type":"text"},{"code":"CN=Staff, OU=Groups","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cn=staff,ou=groups","type":"codeVoice"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"url":"\/documentation\/axiamsdk\/groupmapping","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","title":"GroupMapping","role":"symbol","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryKind":{"abstract":[{"type":"text","text":"Which kind of directory server a configuration points at. It drives "},{"type":"strong","inlineContent":[{"text":"defaults only","type":"text"}]},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"external-id attribute, the group-membership strategy and the change attribute the sync job","type":"text"},{"text":" ","type":"text"},{"text":"reads. Every one of them is still an explicit, editable field of the configuration (or, for","type":"text"},{"text":" ","type":"text"},{"text":"the strategy and change attribute, derived from this value at the point of use); nothing","type":"text"},{"text":" ","type":"text"},{"text":"about the kind changes what is ","type":"text"},{"inlineContent":[{"text":"allowed","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"url":"\/documentation\/axiamsdk\/directorykind","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind","title":"DirectoryKind","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectoryKind"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectoryKind"}]}}}