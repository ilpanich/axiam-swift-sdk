{"sections":[],"abstract":[{"text":"The group-mapping table (D-30): which directory groups put a user into which AXIAM","type":"text"},{"text":" ","type":"text"},{"text":"groups. Empty means no directory group maps to anything, and a sign-in then removes","type":"text"},{"text":" ","type":"text"},{"text":"every directory-sourced membership the user held.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"symbolKind":"property","modules":[{"name":"AxiamSDK"}],"role":"symbol","roleHeading":"Instance Property","title":"groupMappings","externalID":"s:8AxiamSDK15DirectoryConfigV13groupMappingsSayAA12GroupMappingVGvp"},"variants":[{"paths":["\/documentation\/axiamsdk\/directoryconfig\/groupmappings"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig\/groupMappings","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8AxiamSDK12GroupMappingV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","kind":"typeIdentifier","text":"GroupMapping"},{"kind":"text","text":"]"}],"platforms":["Linux"],"languages":["swift"]}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"abstract":[{"text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its","type":"text"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"inlineContent":[{"text":"The table is the only","type":"text"},{"text":" ","type":"text"},{"text":"way a directory group reaches an AXIAM group.","type":"text"}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"type":"codeVoice","code":"admins"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"axiam_directory::dn"},{"text":"), so ","type":"text"},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}],"title":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","url":"\/documentation\/axiamsdk\/groupmapping","kind":"symbol","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig":{"title":"DirectoryConfig","abstract":[{"text":"A tenant’s directory configuration, as stored and as read back. Carries no secret: see the","type":"text"},{"text":" ","type":"text"},{"text":"module documentation.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectoryConfig","kind":"identifier"}],"navigatorTitle":[{"text":"DirectoryConfig","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/directoryconfig","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig/groupMappings":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","title":"groupMappings","kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig\/groupMappings","url":"\/documentation\/axiamsdk\/directoryconfig\/groupmappings","abstract":[{"type":"text","text":"The group-mapping table (D-30): which directory groups put a user into which AXIAM"},{"type":"text","text":" "},{"type":"text","text":"groups. Empty means no directory group maps to anything, and a sign-in then removes"},{"type":"text","text":" "},{"type":"text","text":"every directory-sourced membership the user held."}]}}}