{"abstract":[{"type":"text","text":"The group-mapping table (D-30): which directory groups put a user into which AXIAM"},{"type":"text","text":" "},{"type":"text","text":"groups. Empty means no directory group maps to anything, and a sign-in then removes"},{"type":"text","text":" "},{"type":"text","text":"every directory-sourced membership the user held."}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig\/groupMappings","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK12GroupMappingV","text":"GroupMapping","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"groupMappings","role":"symbol","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK15DirectoryConfigV13groupMappingsSayAA12GroupMappingVGvp","roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig"]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/directoryconfig\/groupmappings"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK12GroupMappingV","text":"GroupMapping","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]}],"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"role":"symbol","url":"\/documentation\/axiamsdk\/groupmapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","type":"topic","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"text":"way a directory group reaches an AXIAM group.","type":"text"}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"title":"GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig/groupMappings":{"type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8AxiamSDK12GroupMappingV","kind":"typeIdentifier","text":"GroupMapping"},{"kind":"text","text":"]"}],"role":"symbol","title":"groupMappings","url":"\/documentation\/axiamsdk\/directoryconfig\/groupmappings","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig\/groupMappings","kind":"symbol","abstract":[{"text":"The group-mapping table (D-30): which directory groups put a user into which AXIAM","type":"text"},{"text":" ","type":"text"},{"text":"groups. Empty means no directory group maps to anything, and a sign-in then removes","type":"text"},{"text":" ","type":"text"},{"text":"every directory-sourced membership the user held.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig","url":"\/documentation\/axiamsdk\/directoryconfig","type":"topic","abstract":[{"type":"text","text":"A tenant’s directory configuration, as stored and as read back. Carries no secret: see the"},{"type":"text","text":" "},{"type":"text","text":"module documentation."}],"navigatorTitle":[{"kind":"identifier","text":"DirectoryConfig"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectoryConfig"}],"title":"DirectoryConfig"}}}