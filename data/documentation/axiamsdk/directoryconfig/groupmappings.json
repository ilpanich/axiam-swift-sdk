{"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/directoryconfig\/groupmappings"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The group-mapping table (D-30): which directory groups put a user into which AXIAM"},{"type":"text","text":" "},{"type":"text","text":"groups. Empty means no directory group maps to anything, and a sign-in then removes"},{"type":"text","text":" "},{"type":"text","text":"every directory-sourced membership the user held."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"GroupMapping","preciseIdentifier":"s:8AxiamSDK12GroupMappingV"},{"kind":"text","text":"]"}],"title":"groupMappings","symbolKind":"property","externalID":"s:8AxiamSDK15DirectoryConfigV13groupMappingsSayAA12GroupMappingVGvp"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK12GroupMappingV","text":"GroupMapping","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},{"text":"]","kind":"text"}]}],"kind":"declarations"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig\/groupMappings","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}],"abstract":[{"text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its","type":"text"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"kind":"symbol","title":"GroupMapping","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/groupmapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig/groupMappings":{"title":"groupMappings","role":"symbol","abstract":[{"type":"text","text":"The group-mapping table (D-30): which directory groups put a user into which AXIAM"},{"type":"text","text":" "},{"type":"text","text":"groups. Empty means no directory group maps to anything, and a sign-in then removes"},{"type":"text","text":" "},{"type":"text","text":"every directory-sourced membership the user held."}],"url":"\/documentation\/axiamsdk\/directoryconfig\/groupmappings","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"GroupMapping","preciseIdentifier":"s:8AxiamSDK12GroupMappingV"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig\/groupMappings","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig":{"navigatorTitle":[{"kind":"identifier","text":"DirectoryConfig"}],"title":"DirectoryConfig","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectoryConfig"}],"role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig","abstract":[{"type":"text","text":"A tenant’s directory configuration, as stored and as read back. Carries no secret: see the"},{"type":"text","text":" "},{"type":"text","text":"module documentation."}],"url":"\/documentation\/axiamsdk\/directoryconfig","kind":"symbol"}}}