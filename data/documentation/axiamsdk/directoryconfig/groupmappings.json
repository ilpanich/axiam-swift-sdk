{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/directoryconfig\/groupmappings"]}],"metadata":{"modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK15DirectoryConfigV13groupMappingsSayAA12GroupMappingVGvp","symbolKind":"property","roleHeading":"Instance Property","role":"symbol","title":"groupMappings","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV"},{"text":"]","kind":"text"}]},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","text":"GroupMapping","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV"},{"text":"]","kind":"text"}],"languages":["swift"]}]}],"abstract":[{"text":"The group-mapping table (D-30): which directory groups put a user into which AXIAM","type":"text"},{"text":" ","type":"text"},{"text":"groups. Empty means no directory group maps to anything, and a sign-in then removes","type":"text"},{"text":" ","type":"text"},{"text":"every directory-sourced membership the user held.","type":"text"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig\/groupMappings","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"type":"strong","inlineContent":[{"text":"The table is the only","type":"text"},{"text":" ","type":"text"},{"text":"way a directory group reaches an AXIAM group.","type":"text"}]},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"axiam_directory::dn","type":"codeVoice"},{"text":"), so ","type":"text"},{"code":"CN=Staff, OU=Groups","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cn=staff,ou=groups","type":"codeVoice"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"url":"\/documentation\/axiamsdk\/groupmapping","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","title":"GroupMapping","role":"symbol","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig/groupMappings":{"abstract":[{"text":"The group-mapping table (D-30): which directory groups put a user into which AXIAM","type":"text"},{"text":" ","type":"text"},{"text":"groups. Empty means no directory group maps to anything, and a sign-in then removes","type":"text"},{"text":" ","type":"text"},{"text":"every directory-sourced membership the user held.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV"},{"text":"]","kind":"text"}],"title":"groupMappings","role":"symbol","url":"\/documentation\/axiamsdk\/directoryconfig\/groupmappings","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig\/groupMappings"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig","url":"\/documentation\/axiamsdk\/directoryconfig","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectoryConfig","kind":"identifier"}],"navigatorTitle":[{"text":"DirectoryConfig","kind":"identifier"}],"abstract":[{"text":"A tenant’s directory configuration, as stored and as read back. Carries no secret: see the","type":"text"},{"text":" ","type":"text"},{"text":"module documentation.","type":"text"}],"kind":"symbol","type":"topic","title":"DirectoryConfig"}}}