{"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8AxiamSDK12GroupMappingV","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","text":"GroupMapping"},{"kind":"text","text":"]"}]}],"kind":"declarations"}],"variants":[{"paths":["\/documentation\/axiamsdk\/directoryconfig\/groupmappings"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig"]]},"abstract":[{"type":"text","text":"The group-mapping table (D-30): which directory groups put a user into which AXIAM"},{"type":"text","text":" "},{"type":"text","text":"groups. Empty means no directory group maps to anything, and a sign-in then removes"},{"type":"text","text":" "},{"type":"text","text":"every directory-sourced membership the user held."}],"sections":[],"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8AxiamSDK12GroupMappingV","kind":"typeIdentifier","text":"GroupMapping"},{"kind":"text","text":"]"}],"symbolKind":"property","externalID":"s:8AxiamSDK15DirectoryConfigV13groupMappingsSayAA12GroupMappingVGvp","roleHeading":"Instance Property","title":"groupMappings","modules":[{"name":"AxiamSDK"}]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig\/groupMappings","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig":{"type":"topic","url":"\/documentation\/axiamsdk\/directoryconfig","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectoryConfig"}],"kind":"symbol","abstract":[{"type":"text","text":"A tenant’s directory configuration, as stored and as read back. Carries no secret: see the"},{"type":"text","text":" "},{"type":"text","text":"module documentation."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectoryConfig"}],"title":"DirectoryConfig","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryConfig/groupMappings":{"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"GroupMapping","preciseIdentifier":"s:8AxiamSDK12GroupMappingV"},{"kind":"text","text":"]"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryConfig\/groupMappings","abstract":[{"type":"text","text":"The group-mapping table (D-30): which directory groups put a user into which AXIAM"},{"type":"text","text":" "},{"type":"text","text":"groups. Empty means no directory group maps to anything, and a sign-in then removes"},{"type":"text","text":" "},{"type":"text","text":"every directory-sourced membership the user held."}],"url":"\/documentation\/axiamsdk\/directoryconfig\/groupmappings","title":"groupMappings","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"url":"\/documentation\/axiamsdk\/groupmapping","kind":"symbol","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"title":"GroupMapping","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]}}}