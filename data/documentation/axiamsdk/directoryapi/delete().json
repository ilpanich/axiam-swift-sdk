{"sections":[],"kind":"symbol","metadata":{"roleHeading":"Instance Method","externalID":"s:8AxiamSDK12DirectoryApiV6deleteyyYaKF","modules":[{"name":"AxiamSDK"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"delete"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"title":"delete()","role":"symbol"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"delete"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Deleting stops the directory, and only that"}],"type":"strong"},{"type":"text","text":" (§30.3 rule 5): directory accounts can"},{"type":"text","text":" "},{"type":"text","text":"no longer sign in with a password – there is no fallback to a local hash – and the"},{"type":"text","text":" "},{"type":"text","text":"sync stops. Sessions, refresh tokens and passkeys those accounts already hold keep"},{"type":"text","text":" "},{"type":"text","text":"working until they expire or the accounts are deactivated. There is no unlink: a linked"},{"type":"text","text":" "},{"type":"text","text":"account stays a directory account."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/directoryapi\/delete()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi\/delete()"},"abstract":[{"code":"DEL