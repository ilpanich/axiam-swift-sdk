{"kind":"symbol","abstract":[{"type":"codeVoice","code":"DELETE \/api\/v1\/tenants\/{tenant_id}\/directory"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"delete"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Deleting stops the directory, and only that","type":"text"}]},{"type":"text","text":" (§30.3 rule 5): directory accounts can"},{"type":"text","text":" "},{"type":"text","text":"no longer sign in with a password – there is no fallback to a local hash – and the"},{"type":"text","text":" "},{"type":"text","text":"sync stops. Sessions, refresh tokens and passkeys those accounts already hold keep"},{"type":"text","text":" "},{"type":"text","text":"working until they expire or the accounts are deactivated. There is no unlink: a linked"},{"type":"text","text":" "},{"type":"text","text":"account stays a directory account."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/axiamsdk\/directoryapi\/delete()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"method","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"delete"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"externalID":"s:8AxiamSDK12DirectoryApiV6deleteyyYaKF","role":"symbol","modules":[{"name":"AxiamSDK"}],"title":"delete()"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi\/delete()"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryApi/delete()":{"abstract":[{"code":"DELETE \/api\/v1\/tenants\/{tenant_id}\/directory","type":"codeVoice"}],"title":"delete()","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"delete"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"url":"\/documentation\/axiamsdk\/directoryapi\/delete()","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi\/delete()"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryApi":{"abstract":[{"type":"text","text":"A tenant’s LDAP \/ Active Directory identity source (CONTRACT §30): the one configuration,"},{"type":"text","text":" "},{"type":"text","text":"the explicit act that links an existing local account to its directory entry, and a"},{"type":"text","text":" "},{"type":"text","text":"read-only view of the sync job. Signing in needs nothing new – a directory account calls"},{"type":"text","text":" "},{"type":"text","text":"the same §1 "},{"code":"login","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectoryApi","kind":"identifier"}],"navigatorTitle":[{"text":"DirectoryApi","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/directoryapi","role":"symbol","title":"DirectoryApi"}}}