{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi"]]},"abstract":[{"code":"DELETE \/api\/v1\/tenants\/{tenant_id}\/directory","type":"codeVoice"}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"delete","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deleting stops the directory, and only that"}]},{"type":"text","text":" (§30.3 rule 5): directory accounts can"},{"type":"text","text":" "},{"type":"text","text":"no longer sign in with a password – there is no fallback to a local hash – and the"},{"type":"text","text":" "},{"type":"text","text":"sync stops. Sessions, refresh tokens and passkeys those accounts already hold keep"},{"type":"text","text":" "},{"type":"text","text":"working until they expire or the accounts are deactivated. There is no unlink: a linked"},{"type":"text","text":" "},{"type":"text","text":"account stays a directory account."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/axiamsdk\/directoryapi\/delete()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi\/delete()"},"metadata":{"externalID":"s:8AxiamSDK12DirectoryApiV6deleteyyYaKF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"delete","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","k