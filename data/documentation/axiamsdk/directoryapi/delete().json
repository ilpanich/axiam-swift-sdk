{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"delete"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Deleting stops the directory, and only that","type":"text"}],"type":"strong"},{"type":"text","text":" (§30.3 rule 5): directory accounts can"},{"type":"text","text":" "},{"type":"text","text":"no longer sign in with a password – there is no fallback to a local hash – and the"},{"type":"text","text":" "},{"type":"text","text":"sync stops. Sessions, refresh tokens and passkeys those accounts already hold keep"},{"type":"text","text":" "},{"type":"text","text":"working until they expire or the accounts are deactivated. There is no unlink: a linked"},{"type":"text","text":" "},{"type":"text","text":"account stays a directory account."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi\/delete()","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/axiamsdk\/directoryapi\/delete()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"metadata":{"roleHeading":"Instance Method","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"delete","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"symbolKind":"method","role":"symbol","externalID":"s:8AxiamSDK12DirectoryApiV6deleteyyYaKF","title":"delete()"},"abstract":[{"type":"codeVoice","code":"DELETE \/api\/v1\/tenants\/{tenant_id}\/directory"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryApi/delete()":{"url":"\/documentation\/axiamsdk\/directoryapi\/delete()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"delete"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi\/delete()","role":"symbol","abstract":[{"code":"DELETE \/api\/v1\/tenants\/{tenant_id}\/directory","type":"codeVoice"}],"title":"delete()"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryApi":{"title":"DirectoryApi","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryApi","abstract":[{"text":"A tenant’s LDAP \/ Active Directory identity source (CONTRACT §30): the one configuration,","type":"text"},{"text":" ","type":"text"},{"text":"the explicit act that links an existing local account to its directory entry, and a","type":"text"},{"text":" ","type":"text"},{"text":"read-only view of the sync job. Signing in needs nothing new – a directory account calls","type":"text"},{"text":" ","type":"text"},{"text":"the same §1 ","type":"text"},{"code":"login","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/axiamsdk\/directoryapi","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectoryApi","kind":"identifier"}],"navigatorTitle":[{"text":"DirectoryApi","