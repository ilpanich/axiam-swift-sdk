for the desktop MCP clients, whose callbacks are on"},{"type":"text","text":" "},{"type":"text","text":"loopback and therefore can never share a host with a "},{"type":"codeVoice","code":"https:\/\/"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"docs\/admin\/client-id-metadata-documents.md"},{"type":"text","text":" says so and says why."}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/restrictSameDomain":{"kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy\/restrictsamedomain","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/restrictSameDomain","abstract":[{"text":"Require every ","type":"text"},{"code":"redirect_uris","type":"codeVoice"},{"text":" host in the document to equal the host of the ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"URL itself. ","type":"text"},{"inlineContent":[{"text":"On by default","type":"text"}],"type":"strong"},{"text":", because the document says who the client is and a","type":"text"},{"text":" ","type":"text"},{"text":"redirect to somewhere else is the one thing a stolen or mirrored document would want to","type":"text"},{"text":" ","type":"text"},{"text":"change. It is turned ","type":"text"},{"inlineContent":[{"type":"text","text":"off"}],"type":"strong"},{"text":" for the desktop MCP clients, whose callbacks are on","type":"text"},{"text":" ","type":"text"},{"text":"loopback and therefore can never share a host with a ","type":"text"},{"code":"https:\/\/","type":"codeVoice"},{"text":" ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"docs\/admin\/client-id-metadata-documents.md","type":"codeVoice"},{"text":" says so and says why.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"restrictSameDomain"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"title":"restrictSameDomain","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy":{"navigatorTitle":[{"text":"CimdPolicy","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CimdPolicy","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy","title":"CimdPolicy","abstract":[{"type":"text","text":"Whether, and on what terms, a "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" that is a URL is resolved by fetching the document"},{"type":"text","text":" "},{"type":"text","text":"it names (T21.5, "},{"type":"codeVoice","code":"draft-ietf-oauth-client-id-metadata-document"},{"type":"text","text":"). # Why this is one nested"},{"type":"text","text":" "},{"type":"text","text":"policy rather than nine fields Every field here is a term of a single decision — "},{"type":"emphasis","inlineContent":[{"type":"text","text":"do we"},{"type":"text","text":" "},{"type":"text","text":"fetch a stranger’s URL and make a client out of what comes back"}]},{"type":"text","text":" — and none of them means"},{"type":"text","text":" "},{"type":"text","text":"anything without ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"]. A tenant that states a CIMD posture states all of it; a"},{"type":"text","text":" "},{"type":"text","text":"tenant that states none inherits its organization’s whole posture rather than half of one,"},{"type":"text","text":" "},{"type":"text","text":"which is the only merge that cannot produce a combination neither party wrote. # The two"},{"type":"text","text":" "},{"type":"text","text":"fields that can widen, and the seven that cannot ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::allow_http"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"are "},{"type":"strong","inlineContent":[{"type":"text","text":"ordered"}]},{"type":"text","text":": a tenant may turn either off but never on, exactly as"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"type":"emphasis","inlineContent":[{"type":"text","text":"this tenant’s"}]},{"type":"text","text":" "},{"type":"text","text":"domains or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"this tenant’s"}]},{"type":"text","text":" bounds, and there is no sense in which one tenant’s list of"},{"type":"text","text":" "},{"type":"text","text":"trusted publishers is stricter than another’s — the same argument ["},{"type":"codeVoice","code":"OidcPolicy"},{"type":"text","text":"] already"},{"type":"text","text":" "},{"type":"text","text":"makes for "},{"type":"codeVoice","code":"dcr_allowed_redirect_hosts"},{"type":"text","text":". # Every bound here is a security control"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::max_metadata_bytes"},{"type":"text","text":"], ["},{"type":"codeVoice","code":"Self::min_cache_secs"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::max_cache_secs"},{"type":"text","text":"] are not"},{"type":"text","text":" "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}]},"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"}}}