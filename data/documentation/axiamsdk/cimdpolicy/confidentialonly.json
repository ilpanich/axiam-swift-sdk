{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:8AxiamSDK10CimdPolicyV16confidentialOnlySbSgvp","roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"confidentialOnly","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"confidentialOnly","symbolKind":"property","role":"symbol"},"abstract":[{"type":"text","text":"Refuse a document whose "},{"code":"token_endpoint_auth_method","type":"codeVoice"},{"type":"text","text":" is "},{"code":"none","type":"codeVoice"},{"type":"text","text":". Off by default, because"},{"type":"text","text":" "},{"code":"none","type":"codeVoice"},{"type":"text","text":" is what every MCP desktop client is. A tenant that turns it on accepts only"},{"type":"text","text":" "},{"code":"private_key_jwt","type":"codeVoice"},{"type":"text","text":" documents, which is the posture for a deployment whose CIMD clients"},{"type":"text","text":" "},{"type":"text","text":"are servers rather than desktops."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"confidentialOnly","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/confidentialOnly"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy"]]},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/cimdpolicy\/confidentialonly"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/confidentialOnly":{"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/confidentialOnly","abstract":[{"type":"text","text":"Refuse a document whose "},{"code":"token_endpoint_auth_method","type":"codeVoice"},{"type":"text","text":" is "},{"code":"none","type":"codeVoice"},{"text":". Off by default, because","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"none"},{"type":"text","text":" is what every MCP desktop client is. A tenant that turns it on accepts only"},{"text":" ","type":"text"},{"code":"private_key_jwt","type":"codeVoice"},{"text":" documents, which is the posture for a deployment whose CIMD clients","type":"text"},{"text":" ","type":"text"},{"text":"are servers rather than desktops.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"confidentialOnly","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"title":"confidentialOnly","role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy\/confidentialonly"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"CimdPolicy"}],"abstract":[{"text":"Whether, and on what terms, a ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" that is a URL is resolved by fetching the document","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it names (T21.5, "},{"type":"codeVoice","code":"draft-ietf-oauth-client-id-metadata-document"},{"type":"text","text":"). # Why this is one nested"},{"type":"text","text":" "},{"type":"text","text":"policy rather than nine fields Every field here is a term of a single decision — "},{"inlineContent":[{"type":"text","text":"do we"},{"type":"text","text":" "},{"type":"text","text":"fetch a stranger’s URL and make a client out of what comes back"}],"type":"emphasis"},{"type":"text","text":" — and none of them means"},{"type":"text","text":" "},{"type":"text","text":"anything without ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"]. A tenant that states a CIMD posture states all of it; a"},{"type":"text","text":" "},{"type":"text","text":"tenant that states none inherits its organization’s whole posture rather than half of one,"},{"type":"text","text":" "},{"type":"text","text":"which is the only merge that cannot produce a combination neither party wrote. # The two"},{"type":"text","text":" "},{"type":"text","text":"fields that can widen, and the seven that cannot ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::allow_http"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"are "},{"inlineContent":[{"type":"text","text":"ordered"}],"type":"strong"},{"type":"text","text":": a tenant may turn either off but never on, exactly as"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"inlineContent":[{"type":"text","text":"this tenant’s"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"domains or "},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"type":"text","text":" bounds, and there is no sense in which one tenant’s list of"},{"type":"text","text":" "},{"type":"text","text":"trusted publishers is stricter than another’s — the same argument ["},{"type":"codeVoice","code":"OidcPolicy"},{"type":"text","text":"] already"},{"type":"text","text":" "},{"type":"text","text":"makes for "},{"type":"codeVoice","code":"dcr_allowed_redirect_hosts"},{"type":"text","text":". # Every bound here is a security control"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::max_metadata_bytes"},{"type":"text","text":"], ["},{"type":"codeVoice","code":"Self::min_cache_secs"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::max_cache_secs"},{"type":"text","text":"] are not"},{"type":"text","text":" "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CimdPolicy"}],"kind":"symbol","title":"CimdPolicy","url":"\/documentation\/axiamsdk\/cimdpolicy","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy"}}}