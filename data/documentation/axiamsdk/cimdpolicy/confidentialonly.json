{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/confidentialOnly"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"confidentialOnly","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"]}],"kind":"declarations"}],"variants":[{"paths":["\/documentation\/axiamsdk\/cimdpolicy\/confidentialonly"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy"]]},"metadata":{"symbolKind":"property","role":"symbol","externalID":"s:8AxiamSDK10CimdPolicyV16confidentialOnlySbSgvp","roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"confidentialOnly"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?"}],"title":"confidentialOnly"},"abstract":[{"text":"Refuse a document whose ","type":"text"},{"code":"token_endpoint_auth_method","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"none","type":"codeVoice"},{"text":". Off by default, because","type":"text"},{"text":" ","type":"text"},{"code":"none","type":"codeVoice"},{"text":" is what every MCP desktop client is. A tenant that turns it on accepts only","type":"text"},{"text":" ","type":"text"},{"code":"private_key_jwt","type":"codeVoice"},{"text":" documents, which is the posture for a deployment whose CIMD clients","type":"text"},{"text":" ","type":"text"},{"text":"are servers rather than desktops.","type":"text"}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy":{"navigatorTitle":[{"text":"CimdPolicy","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CimdPolicy","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy","title":"CimdPolicy","abstract":[{"type":"text","text":"Whether, and on what terms, a "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" that is a URL is resolved by fetching the document"},{"type":"text","text":" "},{"type":"text","text":"it names (T21.5, "},{"type":"codeVoice","code":"draft-ietf-oauth-client-id-metadata-document"},{"type":"text","text":"). # Why this is one nested"},{"type":"text","text":" "},{"type":"text","text":"policy rather than nine fields Every field here is a term of a single decision — "},{"type":"emphasis","inlineContent":[{"type":"text","text":"do we"},{"type":"text","text":" "},{"type":"text","text":"fetch a stranger’s URL and make a client out of what comes back"}]},{"type":"text","text":" — and none of them means"},{"type":"text","text":" "},{"type":"text","text":"anything without ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"]. A tenant that states a CIMD posture states all of it; a"},{"type":"text","text":" "},{"type":"text","text":"tenant that states none inherits its organization’s whole posture rather than half of one,"},{"type":"text","text":" "},{"type":"text","text":"which is the only merge that cannot produce a combination neither party wrote. # The two"},{"type":"text","text":" "},{"type":"text","text":"fields that can widen, and the seven that cannot ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::allow_http"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"are "},{"type":"strong","inlineContent":[{"type":"text","text":"ordered"}]},{"type":"text","text":": a tenant may turn either off but never on, exactly as"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"type":"emphasis","inlineContent":[{"type":"text","text":"this tenant’s"}]},{"type":"text","text":" "},{"type":"text","text":"domains or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"this tenant’s"}]},{"type":"text","text":" bounds, and there is no sense in which one tenant’s list of"},{"type":"text","text":" "},{"type":"text","text":"trusted publishers is stricter than another’s — the same argument ["},{"type":"codeVoice","code":"OidcPolicy"},{"type":"text","text":"] already"},{"type":"text","text":" "},{"type":"text","text":"makes for "},{"type":"codeVoice","code":"dcr_allowed_redirect_hosts"},{"type":"text","text":". # Every bound here is a security control"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::max_metadata_bytes"},{"type":"text","text":"], ["},{"type":"codeVoice","code":"Self::min_cache_secs"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::max_cache_secs"},{"type":"text","text":"] are not"},{"type":"text","text":" "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/confidentialOnly":{"role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy\/confidentialonly","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/confidentialOnly","title":"confidentialOnly","abstract":[{"text":"