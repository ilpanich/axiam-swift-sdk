{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"s:8AxiamSDK10CimdPolicyV12minCacheSecsSiSgvp","roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"symbolKind":"property","title":"minCacheSecs","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minCacheSecs","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/minCacheSecs"},"abstract":[{"type":"text","text":"The floor under a document’s cache lifetime, in seconds. Clamped to"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"CIMD_MIN_CACHE_FLOOR_SECS"},{"type":"text","text":"]."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minCacheSecs","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["Linux"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/cimdpolicy\/mincachesecs"]}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy":{"title":"CimdPolicy","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy","role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CimdPolicy"}],"navigatorTitle":[{"kind":"identifier","text":"CimdPolicy"}],"abstract":[{"type":"text","text":"Whether, and on what terms, a "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":" that is a URL is resolved by fetching the document"},{"type":"text","text":" "},{"type":"text","text":"it names (T21.5, "},{"code":"draft-ietf-oauth-client-id-metadata-document","type":"codeVoice"},{"type":"text","text":"). # Why this is one nested"},{"type":"text","text":" "},{"type":"text","text":"policy rather than nine fields Every field here is a term of a single decision — "},{"type":"emphasis","inlineContent":[{"type":"text","text":"do we"},{"type":"text","text":" "},{"type":"text","text":"fetch a stranger’s URL and make a client out of what comes back"}]},{"type":"text","text":" — and none of them means"},{"type":"text","text":" "},{"type":"text","text":"anything without ["},{"code":"Self::enabled","type":"codeVoice"},{"type":"text","text":"]. A tenant that states a CIMD posture states all of it; a"},{"type":"text","text":" "},{"type":"text","text":"tenant that states none inherits its organization’s whole posture rather than half of one,"},{"type":"text","text":" "},{"type":"text","text":"which is the only merge that cannot produce a combination neither party wrote. # The two"},{"type":"text","text":" "},{"type":"text","text":"fields that can widen, and the seven that cannot ["},{"code":"Self::enabled","type":"codeVoice"},{"type":"text","text":"] and ["},{"code":"Self::allow_http","type":"codeVoice"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"are "},{"type":"strong","inlineContent":[{"type":"text","text":"ordered"}]},{"type":"text","text":": a tenant may turn either off but never on, exactly as"},{"type":"text","text":" "},{"code":"dynamic_registration","type":"codeVoice"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"type":"emphasis","inlineContent":[{"text":"this tenant’s","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"domains or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"this tenant’s"}]},{"type":"text","text":" bounds, and there is no sense in which one tenant’s list of"},{"type":"text","text":" "},{"type":"text","text":"trusted publishers is stricter than another’s — the same argument ["},{"code":"OidcPolicy","type":"codeVoice"},{"type":"text","text":"] already"},{"type":"text","text":" "},{"type":"text","text":"makes for "},{"code":"dcr_allowed_redirect_hosts","type":"codeVoice"},{"type":"text","text":". # Every bound here is a security control"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"Self::max_metadata_bytes","type":"codeVoice"},{"type":"text","text":"], ["},{"code":"Self::min_cache_secs","type":"codeVoice"},{"type":"text","text":"] and ["},{"code":"Self::max_cache_secs","type":"codeVoice"},{"type":"text","text":"] are not"},{"type":"text","text":" "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/minCacheSecs":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"minCacheSecs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"type":"topic","abstract":[{"text":"The floor under a document’s cache lifetime, in seconds. Clamped to","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"type":"codeVoice","code":"CIMD_MIN_CACHE_FLOOR_SECS"},{"text":"].","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/minCacheSecs","title":"minCacheSecs","url":"\/documentation\/axiamsdk\/cimdpolicy\/mincachesecs"}}}