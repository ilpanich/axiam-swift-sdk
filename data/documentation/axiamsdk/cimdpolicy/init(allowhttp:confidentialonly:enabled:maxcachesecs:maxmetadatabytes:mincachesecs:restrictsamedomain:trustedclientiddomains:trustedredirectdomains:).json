ion’s whole posture rather than half of one,","type":"text"},{"text":" ","type":"text"},{"text":"which is the only merge that cannot produce a combination neither party wrote. # The two","type":"text"},{"text":" ","type":"text"},{"text":"fields that can widen, and the seven that cannot [","type":"text"},{"code":"Self::enabled","type":"codeVoice"},{"text":"] and [","type":"text"},{"code":"Self::allow_http","type":"codeVoice"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"are "},{"inlineContent":[{"text":"ordered","type":"text"}],"type":"strong"},{"type":"text","text":": a tenant may turn either off but never on, exactly as"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"domains or ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"this tenant’s"}]},{"text":" bounds, and there is no sense in which one tenant’s list of","type":"text"},{"text":" ","type":"text"},{"text":"trusted publishers is stricter than another’s — the same argument [","type":"text"},{"code":"OidcPolicy","type":"codeVoice"},{"text":"] already","type":"text"},{"text":" ","type":"text"},{"text":"makes for ","type":"text"},{"code":"dcr_allowed_redirect_hosts","type":"codeVoice"},{"text":". # Every bound here is a security control","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::max_metadata_bytes","type":"codeVoice"},{"text":"], [","type":"text"},{"code":"Self::min_cache_secs","type":"codeVoice"},{"text":"] and [","type":"text"},{"code":"Self::max_cache_secs","type":"codeVoice"},{"text":"] are not","type":"text"},{"text":" ","type":"text"},{"text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the","type":"text"},{"text":" ","type":"text"},{"text":"floor under how often that read may be repeated, and the ceiling on how long its result may","type":"text"},{"text":" ","type":"text"},{"text":"be trusted. Each is clamped again in code against the three constants above, so a settings","type":"text"},{"text":" ","type":"text"},{"text":"row written by hand cannot lift them.","type":"text"}],"navigatorTitle":[{"text":"CimdPolicy","kind":"identifier"}],"title":"CimdPolicy","type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/init(allowHttp:confidentialOnly:enabled:maxCacheSecs:maxMetadataBytes:minCacheSecs:restrictSameDomain:trustedClientIDDomains:trustedRedirectDomains:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/init(allowHttp:confidentialOnly:enabled:maxCacheSecs:maxMetadataBytes:minCacheSecs:restrictSameDomain:trustedClientIDDomains:trustedRedirectDomains:)","kind":"symbol","role":"symbol","title":"init(allowHttp:confidentialOnly:enabled:maxCacheSecs:maxMetadataBytes:minCacheSecs:restrictSameDomain:trustedClientIDDomains:trustedRedirectDomains:)","url":"\/documentation\/axiamsdk\/cimdpolicy\/init(allowhttp:confidentialonly:enabled:maxcachesecs:maxmetadatabytes:mincachesecs:restrictsamedomain:trustedclientiddomains:trustedredirectdomains:)","type":"topic","abstract":[],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"allowHttp"},{"kind":"text","text":": "},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"confidentialOnly"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"enabled"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"maxCacheSecs"},{"kind":"text","text":": "},{"text":"Int","kind":"typeIdentifier","precis