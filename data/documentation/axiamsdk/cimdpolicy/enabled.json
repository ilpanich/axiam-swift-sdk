dder. Everything else names ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"this tenant’s","type":"text"}]},{"text":" ","type":"text"},{"text":"domains or ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"this tenant’s"}]},{"text":" bounds, and there is no sense in which one tenant’s list of","type":"text"},{"text":" ","type":"text"},{"text":"trusted publishers is stricter than another’s — the same argument [","type":"text"},{"code":"OidcPolicy","type":"codeVoice"},{"text":"] already","type":"text"},{"text":" ","type":"text"},{"text":"makes for ","type":"text"},{"code":"dcr_allowed_redirect_hosts","type":"codeVoice"},{"text":". # Every bound here is a security control","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::max_metadata_bytes","type":"codeVoice"},{"text":"], [","type":"text"},{"code":"Self::min_cache_secs","type":"codeVoice"},{"text":"] and [","type":"text"},{"code":"Self::max_cache_secs","type":"codeVoice"},{"text":"] are not","type":"text"},{"text":" ","type":"text"},{"text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the","type":"text"},{"text":" ","type":"text"},{"text":"floor under how often that read may be repeated, and the ceiling on how long its result may","type":"text"},{"text":" ","type":"text"},{"text":"be trusted. Each is clamped again in code against the three constants above, so a settings","type":"text"},{"text":" ","type":"text"},{"text":"row written by hand cannot lift them.","type":"text"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CimdPolicy"}],"navigatorTitle":[{"kind":"identifier","text":"CimdPolicy"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/enabled":{"kind":"symbol","abstract":[{"inlineContent":[{"text":"Off unles