{"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trustedRedirectDomains","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]?","kind":"text"}]}]}],"abstract":[{"type":"text","text":"The hosts a document’s "},{"type":"codeVoice","code":"redirect_uris"},{"type":"text","text":" may point at, as globs. The loopback hosts"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"127.0.0.1"},{"type":"text","text":", "},{"type":"codeVoice","code":"[::1]"},{"type":"text","text":", "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":") are always allowed, because RFC 8252 §7.3 is how"},{"type":"text","text":" "},{"type":"text","text":"every desktop MCP client receives its callback — so an empty list is not a refusal of"},{"type":"text","text":" "},{"type":"text","text":"everything, it is “loopback only”, which is exactly the Claude Code and VS Code profile."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/trustedRedirectDomains","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/cimdpolicy\/trustedredirectdomains"]}],"metadata":{"role":"symbol","roleHeading":"Instance Property","externalID":"s:8AxiamSDK10CimdPolicyV22trustedRedirectDomainsSaySSGSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trustedRedirectDomains","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]?","kind":"text"}],"symbolKind":"property","modules":[{"name":"AxiamSDK"}],"title":"trustedRedirectDomains"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/trustedRedirectDomains":{"title":"trustedRedirectDomains","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/trustedRedirectDomains","abstract":[{"text":"The hosts a document’s ","type":"text"},{"code":"redirect_uris","type":"codeVoice"},{"text":" may point at, as globs. The loopback hosts","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"127.0.0.1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"[::1]","type":"codeVoice"},{"text":", ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":") are always allowed, because RFC 8252 §7.3 is how","type":"text"},{"text":" ","type":"text"},{"text":"every desktop MCP client receives its callback — so an empty list is not a refusal of","type":"text"},{"text":" ","type":"text"},{"text":"everything, it is “loopback only”, which is exactly the Claude Code and VS Code profile.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trustedRedirectDomains","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"type":"topic","url":"\/documentation\/axiamsdk\/cimdpolicy\/trustedredirectdomains"},"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy":{"navigatorTitle":[{"text":"CimdPolicy","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CimdPolicy","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy","title":"CimdPolicy","abstract":[{"type":"text","text":"Whether, and on what terms, a "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" that is a URL is resolved by fetching the document"},{"type":"text","text":" "},{"type":"text","text":"it names (T21.5, "},{"type":"codeVoice","code":"draft-ietf-oauth-client-id-metadata-document"},{"type":"text","text":"). # Why this is one nested"},{"type":"text","text":" "},{"type":"text","text":"policy rather than nine fields Every field here is a term of a single decision — "},{"type":"emphasis","inlineContent":[{"type":"text","text":"do we"},{"type":"text","text":" "},{"type":"text","text":"fetch a stranger’s URL and make a client out of what comes back"}]},{"type":"text","text":" — and none of them means"},{"type":"text","text":" "},{"type":"text","text":"anything without ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"]. A tenant that states a CIMD posture states all of it; a"},{"type":"text","text":" "},{"type":"text","text":"tenant that states none inherits its organization’s whole posture rather than half of one,"},{"type":"text","text":" "},{"type":"text","text":"which is the only merge that cannot produce a combination neither party wrote. # The two"},{"type":"text","text":" "},{"type":"text","text":"fields that can widen, and the seven that cannot ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::allow_http"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"are "},{"type":"strong","inlineContent":[{"type":"text","text":"ordered"}]},{"type":"text","text":": a tenant may turn either off but never on, exactly as"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"type":"emphasis","inlineContent":[{"type":"text","text":"this tenant’s"}]},{"type":"text","text":" "},{"type":"text","text":"domains or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"this tenant’s"}]},{"type":"text","text":" bounds, and there is no sense in which one tenant’s list of"},{"type":"text","text":" "},{"type":"text","text":"trusted publishers is stricter than another’s — the same argument ["},{"type":"codeVoice","code":"OidcPolicy"},{"type":"text","text":"] already"},{"type":"text","text":" "},{"type":"text","text":"makes for "},{"type":"codeVoice","code":"dcr_allowed_redirect_hosts"},{"type":"text","text":". # Every bound here is a security control"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::max_metadata_bytes"},{"type":"text","text":"], ["},{"type":"codeVoice","code":"Self::min_cache_secs"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::max_cache_secs"},{"type":"text","text":"] are not"},{"type":"text","text":" "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}]}}}