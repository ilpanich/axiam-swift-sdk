{"abstract":[{"type":"text","text":"The ceiling on a document’s cache lifetime, in seconds. Clamped to"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"CIMD_MAX_CACHE_CEILING_SECS"},{"type":"text","text":"]."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/cimdpolicy\/maxcachesecs"]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxCacheSecs"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"}],"sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/maxCacheSecs","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"AxiamSDK"}],"title":"maxCacheSecs","symbolKind":"property","externalID":"s:8AxiamSDK10CimdPolicyV12maxCacheSecsSiSgvp","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxCacheSecs","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CimdPolicy"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy","url":"\/documentation\/axiamsdk\/cimdpolicy","kind":"symbol","type":"topic","title":"CimdPolicy","abstract":[{"text":"Whether, and on what terms, a ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":" that is a URL is resolved by fetching the document","type":"text"},{"text":" ","type":"text"},{"text":"it names (T21.5, ","type":"text"},{"type":"codeVoice","code":"draft-ietf-oauth-client-id-metadata-document"},{"text":"). # Why this is one nested","type":"text"},{"text":" ","type":"text"},{"text":"policy rather than nine fields Every field here is a term of a single decision — ","type":"text"},{"inlineContent":[{"text":"do we","type":"text"},{"text":" ","type":"text"},{"text":"fetch a stranger’s URL and make a client out of what comes back","type":"text"}],"type":"emphasis"},{"text":" — and none of them means","type":"text"},{"text":" ","type":"text"},{"text":"anything without [","type":"text"},{"type":"codeVoice","code":"Self::enabled"},{"text":"]. A tenant that states a CIMD posture states all of it; a","type":"text"},{"text":" ","type":"text"},{"text":"tenant that states none inherits its organization’s whole posture rather than half of one,","type":"text"},{"text":" ","type":"text"},{"text":"which is the only merge that cannot produce a combination neither party wrote. # The two","type":"text"},{"text":" ","type":"text"},{"text":"fields that can widen, and the seven that cannot [","type":"text"},{"type":"codeVoice","code":"Self::enabled"},{"text":"] and [","type":"text"},{"type":"codeVoice","code":"Self::allow_http"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"are "},{"inlineContent":[{"text":"ordered","type":"text"}],"type":"strong"},{"type":"text","text":": a tenant may turn either off but never on, exactly as"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"domains or "},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"type":"text","text":" bounds, and there is no sense in which one tenant’s list of"},{"type":"text","text":" "},{"type":"text","text":"trusted publishers is stricter than another’s — the same argument ["},{"type":"codeVoice","code":"OidcPolicy"},{"type":"text","text":"] already"},{"type":"text","text":" "},{"type":"text","text":"makes for "},{"type":"codeVoice","code":"dcr_allowed_redirect_hosts"},{"type":"text","text":". # Every bound here is a security control"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::max_metadata_bytes"},{"type":"text","text":"], ["},{"type":"codeVoice","code":"Self::min_cache_secs"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::max_cache_secs"},{"type":"text","text":"] are not"},{"type":"text","text":" "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}],"navigatorTitle":[{"kind":"identifier","text":"CimdPolicy"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/maxCacheSecs":{"title":"maxCacheSecs","kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/cimdpolicy\/maxcachesecs","abstract":[{"type":"text","text":"The ceiling on a document’s cache lifetime, in seconds. Clamped to"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"CIMD_MAX_CACHE_CEILING_SECS"},{"type":"text","text":"]."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxCacheSecs","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/maxCacheSecs","role":"symbol"}}}