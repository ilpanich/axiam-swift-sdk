{"abstract":[{"type":"text","text":"The range of Swift versions this SDK is built and tested against."}],"topicSections":[{"title":"Type Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift"],"generated":true,"anchor":"Type-Properties"}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SupportedVersions"}],"symbolKind":"enum","navigatorTitle":[{"kind":"identifier","text":"SupportedVersions"}],"title":"SupportedVersions","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK17SupportedVersionsO","role":"symbol","roleHeading":"Enumeration"},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SupportedVersions"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"The floor enforces itself: SwiftPM reads "},{"type":"codeVoice","code":"swift-tools-version"},{"type":"text","text":" before it resolves"},{"type":"text","text":" "},{"type":"text","text":"anything, and an older toolchain refuses the package outright with a clear message."},{"type":"text","text":" "},{"type":"text","text":"Nothing enforces the upper end — a package resolves and builds on a newer toolchain"},{"type":"text","text":" "},{"type":"text","text":"whether or not anybody ever compiled it there, and the differences that matter"},{"type":"text","text":" "},{"type":"text","text":"(strict concurrency, "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" inference, isolation checking) are exactly the ones"},{"type":"text","text":" "},{"type":"text","text":"that surface as errors only once someone tries."}],"type":"paragraph"},{"inlineContent":[{"text":"These values name both ends, so a build script or a compatibility note can report the","type":"text"},{"text":" ","type":"text"},{"text":"range without hardcoding numbers that go stale.","type":"text"}],"type":"paragraph"},{"text":"One manifest, Swift 6 language mode","type":"heading","level":2,"anchor":"One-manifest-Swift-6-language-mode"},{"inlineContent":[{"type":"text","text":"The package ships a single "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" at tools-version 6.2, and every target in"},{"type":"text","text":" "},{"type":"text","text":"it is compiled in "},{"type":"strong","inlineContent":[{"type":"text","text":"Swift 6 language mode"}]},{"type":"text","text":" — full strict-concurrency checking as"},{"type":"text","text":" "},{"type":"text","text":"errors. Through 1.1.x the floor was 5.9 and a second, version-specific manifest"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Package@swift-6.0.swift"},{"type":"text","text":") carried the language mode for 6.x toolchains; with the"},{"type":"text","text":" "},{"type":"text","text":"floor at 6.2 every toolchain that can resolve the package reads the setting directly,"},{"type":"text","text":" "},{"type":"text","text":"so that file is gone."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"VersionPolicyTests"},{"type":"text","text":" asserts these values against the manifest and the CI matrix, so"},{"type":"text","text":" "},{"type":"text","text":"none of them can drift."}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/supportedversions"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/isSwiftSixLanguageMode":{"type":"topic","url":"\/documentation\/axiamsdk\/supportedversions\/isswiftsixlanguagemode","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isSwiftSixLanguageMode"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"title":"isSwiftSixLanguageMode","abstract":[{"type":"text","text":"Whether "},{"type":"strong","inlineContent":[{"type":"text","text":"this library"}]},{"type":"text","text":" was compiled in Swift 6 language mode."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/newestTestedSwift":{"title":"newestTestedSwift","url":"\/documentation\/axiamsdk\/supportedversions\/newesttestedswift","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The newest Swift version this SDK has a green build against."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"newestTestedSwift"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions":{"type":"topic","url":"\/documentation\/axiamsdk\/supportedvers