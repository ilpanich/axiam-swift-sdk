{"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SupportedVersions"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The floor enforces itself: SwiftPM reads "},{"type":"codeVoice","code":"swift-tools-version"},{"type":"text","text":" before it resolves"},{"type":"text","text":" "},{"type":"text","text":"anything, and an older toolchain refuses the package outright with a clear message."},{"type":"text","text":" "},{"type":"text","text":"Nothing enforces the upper end — a package declaring tools-version 5.9 resolves and"},{"type":"text","text":" "},{"type":"text","text":"builds on a Swift 6 toolchain whether or not anybody ever compiled it there, and the"},{"type":"text","text":" "},{"type":"text","text":"differences that matter (strict concurrency, "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" inference, isolation checking)"},{"type":"text","text":" "},{"type":"text","text":"are exactly the ones that surface as errors only once someone tries."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These values name both ends, so a build script or a compatibility note can report the"},{"type":"text","text":" "},{"type":"text","text":"range without hardcoding numbers that go stale."}],"type":"paragraph"},{"text":"Two manifests","anchor":"Two-manifests","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The package ships "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" (tools-version 5.9) "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"code":"Package@swift-6.0.swift","type":"codeVoice"},{"type":"text","text":" (tools-version 6.0). SwiftPM selects by toolchain, which is"},{"type":"text","text":" "},{"type":"text","text":"what lets the SDK keep a 5.9 floor while compiling its own targets in "},{"type":"strong","inlineContent":[{"type":"text","text":"Swift 6"},{"type":"text","text":" "},{"type":"text","text":"language mode"}]},{"type":"text","text":" wherever a 6.x toolchain is present — full strict-concurrency checking"},{"type":"text","text":" "},{"type":"text","text":"as errors, without dropping consumers still on 5.9."}],"type":"paragraph"},{"inlineContent":[{"code":"VersionPolicyTests","type":"codeVoice"},{"type":"text","text":" asserts these values against both manifests and the CI matrix, so"},{"type":"text","text":" "},{"type":"text","text":"none of them can drift."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"topicSections":[{"title":"Type Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/supportedversions"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK17SupportedVersionsO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SupportedVersions","kind":"identifier"}],"role":"symbol","title":"SupportedVersions","symbolKind":"enum","roleHeading":"Enumeration","navigatorTitle":[{"text":"SupportedVersions","kind":"identifier"}]},"abstract":[{"type":"text","text":"The range of Swift versions this SDK is built and tested against."}],"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/minimumSwiftToolsVersion":{"title":"minimumSwiftT