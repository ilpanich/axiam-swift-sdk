{"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/supportedversions"]}],"topicSections":[{"title":"Type Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SupportedVersions","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The floor enforces itself: SwiftPM reads ","type":"text"},{"code":"swift-tools-version","type":"codeVoice"},{"text":" before it resolves","type":"text"},{"text":" ","type":"text"},{"text":"anything, and an older toolchain refuses the package outright with a clear message.","type":"text"},{"text":" ","type":"text"},{"text":"Nothing enforces the upper end — a package declaring tools-version 5.9 resolves and","type":"text"},{"text":" ","type":"text"},{"text":"builds on a Swift 6 toolchain whether or not anybody ever compiled it there, and the","type":"text"},{"text":" ","type":"text"},{"text":"differences that matter (strict concurrency, ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" inference, isolation checking)","type":"text"},{"text":" ","type":"text"},{"text":"are exactly the ones that surface as errors only once someone tries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"These values name both ends, so a build script or a compatibility note can report the","type":"text"},{"text":" ","type":"text"},{"text":"range without hardcoding numbers that go stale.","type":"text"}]},{"type":"heading","level":2,"anchor":"Two-manifests","text":"Two manifests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package ships "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" (tools-version 5.9) "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Package@swift-6.0.swift"},{"type":"text","text":" (tools-version 6.0). SwiftPM selects by toolchain, which is"},{"type":"text","text":" "},{"type":"text","text":"what lets the SDK keep a 5.9 floor while compiling its own targets in "},{"type":"strong","inlineContent":[{"type":"text","text":"Swift 6"},{"type":"text","text":" "},{"type":"text","text":"language mode"}]},{"type":"text","text":" wherever a 6.x toolchain is present — full strict-concurrency checking"},{"type":"text","text":" "},{"type":"text","text":"as errors, without dropping consumers still on 5.9."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"VersionPolicyTests"},{"type":"text","text":" asserts these values against both manifests and the CI matrix, so"},{"type":"text","text":" "},{"type":"text","text":"none of them can drift."}]}]}],"sections":[],"metadata":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SupportedVersions","kind":"identifier"}],"modules":[{"name":"AxiamSDK"}],"roleHeading":"Enumeration","navigatorTitle":[{"text":"SupportedVersions","kind":"identifier"}],"symbolKind":"enum","title":"SupportedVersions","role":"symbol","externalID":"s:8AxiamSDK17SupportedVersionsO"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"abstract":[{"text":"The range of Swift versions this SDK is built and tested against.","type":"text"}],"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Sw