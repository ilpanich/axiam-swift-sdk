{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"text":"SupportedVersions","kind":"identifier"}],"symbolKind":"enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SupportedVersions","kind":"identifier"}],"title":"SupportedVersions","role":"symbol","externalID":"s:8AxiamSDK17SupportedVersionsO","roleHeading":"Enumeration"},"abstract":[{"text":"The range of Swift versions this SDK is built and tested against.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SupportedVersions","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"The floor enforces itself: SwiftPM reads "},{"type":"codeVoice","code":"swift-tools-version"},{"type":"text","text":" before it resolves"},{"type":"text","text":" "},{"type":"text","text":"anything, and an older toolchain refuses the package outright with a clear message."},{"type":"text","text":" "},{"type":"text","text":"Nothing enforces the upper end — a package declaring tools-version 5.9 resolves and"},{"type":"text","text":" "},{"type":"text","text":"builds on a Swift 6 toolchain whether or not anybody ever compiled it there, and the"},{"type":"text","text":" "},{"type":"text","text":"differences that matter (strict concurrency, "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" inference, isolation checking)"},{"type":"text","text":" "},{"type":"text","text":"are exactly the ones that surface as errors only once someone tries."}],"type":"paragraph"},{"inlineContent":[{"text":"These values name both ends, so a build script or a compatibility note can report the","type":"text"},{"text":" ","type":"text"},{"text":"range without hardcoding numbers that go stale.","type":"text"}],"type":"paragraph"},{"text":"Two manifests","type":"heading","anchor":"Two-manifests","level":2},{"inlineContent":[{"type":"text","text":"The package ships "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" (tools-version 5.9) "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Package@swift-6.0.swift"},{"type":"text","text":" (tools-version 6.0). SwiftPM selects by toolchain, which is"},{"type":"text","text":" "},{"type":"text","text":"what lets the SDK keep a 5.9 floor while compiling its own targets in "},{"type":"strong","inlineContent":[{"text":"Swift 6","type":"text"},{"text":" ","type":"text"},{"text":"language mode","type":"text"}]},{"type":"text","text":" wherever a 6.x toolchain is present — full strict-concurrency checking"},{"type":"text","text":" "},{"type":"text","text":"as errors, without dropping consumers still on 5.9."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"VersionPolicyTests"},{"text":" asserts these values against both manifests and the CI matrix, so","type":"text"},{"text":" ","type":"text"},{"text":"none of them can drift.","type":"text"}]}]}],"topicSections":[{"title":"Type Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/supportedversions"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/minimumSwiftToolsVersion":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion","title":"minimumSwiftToolsVersion","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSwiftToolsVersion","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"url":"\/documentation\/axiamsdk\/supportedversions\/minimumswifttoolsversion","abstract":[{"text":"The minimum Swift tools version required to resolve this package.","type":"text"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/newestTestedSwift":{"url":"\/documentation\/axiamsdk\/supportedversions\/newesttestedswift","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"newestTestedSwift","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"type":"topic","title":"newestTestedSwift","abstract":[{"text":"The newest Swift version this SDK has a green build against.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions":{"url":"\/documentation\/axiamsdk\/supportedversions","title":"SupportedVersions","navigatorTitle":[{"text":"SupportedVersions","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SupportedVersions","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The range of Swift versions this SDK is built and tested against."}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/isSwiftSixLanguageMode":{"url":"\/documentation\/axiamsdk\/supportedversions\/isswiftsixlanguagemode","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode","kind":"symbol","role":"symbol","title":"isSwiftSixLanguageMode","abstract":[{"type":"text","text":"Whether "},{"type":"strong","inlineContent":[{"type":"text","text":"this library"}]},{"type":"text","text":" was compiled in Swift 6 language mode."}],"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isSwiftSixLanguageMode"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]}}}