ortedversions\/minimumswifttoolsversion","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SupportedVersions"}],"navigatorTitle":[{"kind":"identifier","text":"SupportedVersions"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/supportedversions","role":"symbol","type":"topic","abstract":[{"type":"text","text":"The range of Swift versions this SDK is built and tested against."}],"title":"SupportedVersions"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"}}}