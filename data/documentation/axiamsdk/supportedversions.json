{"kind":"symbol","metadata":{"title":"SupportedVersions","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SupportedVersions"}],"roleHeading":"Enumeration","symbolKind":"enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SupportedVersions"}],"modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK17SupportedVersionsO"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SupportedVersions"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The floor enforces itself: SwiftPM reads ","type":"text"},{"code":"swift-tools-version","type":"codeVoice"},{"text":" before it resolves","type":"text"},{"text":" ","type":"text"},{"text":"anything, and an older toolchain refuses the package outright with a clear message.","type":"text"},{"text":" ","type":"text"},{"text":"Nothing enforces the upper end — a package declaring tools-version 5.9 resolves and","type":"text"},{"text":" ","type":"text"},{"text":"builds on a Swift 6 toolchain whether or not anybody ever compiled it there, and the","type":"text"},{"text":" ","type":"text"},{"text":"differences that matter (strict concurrency, ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" inference, isolation checking)","type":"text"},{"text":" ","type":"text"},{"text":"are exactly the ones that surface as errors only once someone tries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These values name both ends, so a build script or a compatibility note can report the"},{"type":"text","text":" "},{"type":"text","text":"range without hardcoding numbers that go stale."}]},{"type":"heading","anchor":"Two-manifests","level":2,"text":"Two manifests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package ships "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" (tools-version 5.9) "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Package@swift-6.0.swift"},{"type":"text","text":" (tools-version 6.0). SwiftPM selects by toolchain, which is"},{"type":"text","text":" "},{"type":"text","text":"what lets the SDK keep a 5.9 floor while compiling its own targets in "},{"type":"strong","inlineContent":[{"text":"Swift 6","type":"text"},{"text":" ","type":"text"},{"text":"language mode","type":"text"}]},{"type":"text","text":" wherever a 6.x toolchain is present — full strict-concurrency checking"},{"type":"text","text":" "},{"type":"text","text":"as errors, without dropping consumers still on 5.9."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"VersionPolicyTests"},{"text":" asserts these values against both manifests and the CI matrix, so","type":"text"},{"text":" ","type":"text"},{"text":"none of them can drift.","type":"text"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"The range of Swift versions this SDK is built and tested against."}],"topicSections":[{"title":"Type Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/supportedversions"]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/isSwiftSixLanguageMode":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode","title":"isSwiftSixLanguageMode","kind":"symbol","url":"\/documentation\/axiamsdk\/supportedversions\/isswiftsixlanguagemode","abstract":[{"type":"text","text":"Whether "},{"inlineContent":[{"text":"this library","type":"text"}],"type":"strong"},{"type":"text","text":" was compiled in Swift 6 language mode."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isSwiftSixLanguageMode","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/minimumSwiftToolsVersion":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion","url":"\/documentation\/axiamsdk\/supportedversions\/minimumswifttoolsversion","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSwiftToolsVersion"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The minimum Swift tools version required to resolve this package."}],"type":"topic","title":"minimumSwiftToolsVersion"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SupportedVersions"}],"title":"SupportedVersions","kind":"symbol","url":"\/documentation\/axiamsdk\/supportedversions","navigatorTitle":[{"kind":"identifier","text":"SupportedVersions"}],"abstract":[{"type":"text","text":"The range of Swift versions this SDK is built and tested against."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/newestTestedSwift":{"type":"topic","url":"\/documentation\/axiamsdk\/supportedversions\/newesttestedswift","abstract":[{"type":"text","text":"The newest Swift version this SDK has a green build against."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift","role":"symbol","kind":"symbol","title":"newestTestedSwift","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"newestTestedSwift"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}]}}}