{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"s:8AxiamSDK17SupportedVersionsO","symbolKind":"enum","roleHeading":"Enumeration","modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"kind":"identifier","text":"SupportedVersions"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SupportedVersions"}],"role":"symbol","title":"SupportedVersions"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SupportedVersions","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The floor enforces itself: SwiftPM reads "},{"type":"codeVoice","code":"swift-tools-version"},{"type":"text","text":" before it resolves"},{"type":"text","text":" "},{"type":"text","text":"anything, and an older toolchain refuses the package outright with a clear message."},{"type":"text","text":" "},{"type":"text","text":"Nothing enforces the upper end — a package resolves and builds on a newer toolchain"},{"type":"text","text":" "},{"type":"text","text":"whether or not anybody ever compiled it there, and the differences that matter"},{"type":"text","text":" "},{"type":"text","text":"(strict concurrency, "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" inference, isolation checking) are exactly the ones"},{"type":"text","text":" "},{"type":"text","text":"that surface as errors only once someone tries."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These values name both ends, so a build script or a compatibility note can report the"},{"type":"text","text":" "},{"type":"text","text":"range without hardcoding numbers that go stale."}],"type":"paragraph"},{"level":2,"anchor":"One-manifest-Swift-6-language-mode","type":"heading","text":"One manifest, Swift 6 language mode"},{"inlineContent":[{"type":"text","text":"The package ships a single "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" at tools-version 6.2, and every target in"},{"type":"text","text":" "},{"type":"text","text":"it is compiled in "},{"type":"strong","inlineContent":[{"text":"Swift 6 language mode","type":"text"}]},{"type":"text","text":" — full strict-concurrency checking as"},{"type":"text","text":" "},{"type":"text","text":"errors. Through 1.1.x the floor was 5.9 and a second, version-specific manifest"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Package@swift-6.0.swift"},{"type":"text","text":") carried the language mode for 6.x toolchains; with the"},{"type":"text","text":" "},{"type":"text","text":"floor at 6.2 every toolchain that can resolve the package reads the setting directly,"},{"type":"text","text":" "},{"type":"text","text":"so that file is gone."}],"type":"paragraph"},{"inlineContent":[{"code":"VersionPolicyTests","type":"codeVoice"},{"text":" asserts these values against the manifest and the CI matrix, so","type":"text"},{"text":" ","type":"text"},{"text":"none of them can drift.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"paths":["\/documentation\/axiamsdk\/supportedversions"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Type-Properties","generated":true,"title":"Type Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"abstract":[{"type":"text","text":"The range of Swift versions this SDK is built and tested against."}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions":{"type":"topic","abstract":[{"text":"The range of Swift versions this SDK is built and tested against.","type":"text"}],"role":"symbol","url":"\/documentation\/axiamsdk\/supportedversions","navigatorTitle":[{"kind":"identifier","text":"SupportedVersions"}],"title":"SupportedVersions","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SupportedVersions"}]},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/minimumSwiftToolsVersion":{"type":"topic","abstract":[{"text":"The minimum Swift tools version required to resolve this package.","type":"text"}],"role":"symbol","url":"\/documentation\/axiamsdk\/supportedversions\/minimumswifttoolsversion","title":"minimumSwiftToolsVersion","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSwiftToolsVersion","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/newestTestedSwift":{"title":"newestTestedSwift","url":"\/documentation\/axiamsdk\/supportedversions\/newesttestedswift","kind":"symbol","abstract":[{"text":"The newest Swift version this SDK has a green build against.","type":"text"}],"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"newestTestedSwift","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/isSwiftSixLanguageMode":{"abstract":[{"text":"Whether ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"this library"}]},{"text":" was compiled in Swift 6 language mode.","type":"text"}],"url":"\/documentation\/axiamsdk\/supportedversions\/isswiftsixlanguagemode","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode","role":"symbol","type":"topic","title":"isSwiftSixLanguageMode","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isSwiftSixLanguageMode","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]}}}