{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SupportedVersions"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The floor enforces itself: SwiftPM reads "},{"code":"swift-tools-version","type":"codeVoice"},{"type":"text","text":" before it resolves"},{"type":"text","text":" "},{"type":"text","text":"anything, and an older toolchain refuses the package outright with a clear message."},{"type":"text","text":" "},{"type":"text","text":"Nothing enforces the upper end — a package declaring tools-version 5.9 resolves and"},{"type":"text","text":" "},{"type":"text","text":"builds on a Swift 6 toolchain whether or not anybody ever compiled it there, and the"},{"type":"text","text":" "},{"type":"text","text":"differences that matter (strict concurrency, "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" inference, isolation checking)"},{"type":"text","text":" "},{"type":"text","text":"are exactly the ones that surface as errors only once someone tries."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These values name both ends, so a build script or a compatibility note can report the"},{"type":"text","text":" "},{"type":"text","text":"range without hardcoding numbers that go stale."}],"type":"paragraph"},{"anchor":"Two-manifests","type":"heading","text":"Two manifests","level":2},{"inlineContent":[{"type":"text","text":"The package ships "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" (tools-version 5.9) "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Package@swift-6.0.swift"},{"type":"text","text":" (tools-version 6.0). SwiftPM selects by toolchain, which is"},{"type":"text","text":" "},{"type":"text","text":"what lets the SDK keep a 5.9 floor while compiling its own targets in "},{"type":"strong","inlineContent":[{"text":"Swift 6","type":"text"},{"text":" ","type":"text"},{"text":"language mode","type":"text"}]},{"type":"text","text":" wherever a 6.x toolchain is present — full strict-concurrency checking"},{"type":"text","text":" "},{"type":"text","text":"as errors, without dropping consumers still on 5.9."}],"type":"paragraph"},{"inlineContent":[{"code":"VersionPolicyTests","type":"codeVoice"},{"text":" asserts these values against both manifests and the CI matrix, so","type":"text"},{"text":" ","type":"text"},{"text":"none of them can drift.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift"],"title":"Type Properties"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/supportedversions"]}],"metadata":{"navigatorTitle":[{"text":"SupportedVersions","kind":"identifier"}],"symbolKind":"enum","title":"SupportedVersions","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK17SupportedVersionsO","roleHeading":"Enumeration","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SupportedVersions","kind":"identifier"}]},"abstract":[{"type":"text","text":"The range of Swift versions this SDK is built and tested against."}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions":{"url":"\/documentation\/axiamsdk\/supportedversions","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SupportedVersions"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions","type":"topic","title":"SupportedVersions","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The range of Swift versions this SDK is built and tested against."}],"navigatorTitle":[{"text":"SupportedVersions","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/minimumSwiftToolsVersion":{"role":"symbol","url":"\/documentation\/axiamsdk\/supportedversions\/minimumswifttoolsversion","abstract":[{"text":"The minimum Swift tools version required to resolve this package.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/minimumSwiftToolsVersion","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSwiftToolsVersion","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"title":"minimumSwiftToolsVersion","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions/newestTestedSwift":{"title":"newestTestedSwift","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"newestTestedSwift","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The newest Swift version this SDK has a green build against."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/newestTestedSwift","url":"\/documentation\/axiamsdk\/supportedversions\/newesttestedswift","kind":"symbol","type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collectio