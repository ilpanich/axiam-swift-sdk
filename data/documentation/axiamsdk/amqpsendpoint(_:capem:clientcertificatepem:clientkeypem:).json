{"variants":[{"paths":["\/documentation\/axiamsdk\/amqpsendpoint(_:capem:clientcertificatepem:clientkeypem:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"amqpsEndpoint"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"url"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"caPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"clientCertificatePEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"clientKeyPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AmqpsEndpoint","text":"AmqpsEndpoint"}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"§22.11 rule 3 is why this is a public, tested function rather than a","type":"text"},{"text":" ","type":"text"},{"text":"paragraph.","type":"text"}]},{"type":"text","text":" §8b rule 7 cannot be satisfied by a runtime that never sees a URL"},{"type":"text","text":" "},{"type":"text","text":"— this SDK bundles no AMQP client — so the SDK hands the integrator the check"},{"type":"text","text":" "},{"type":"text","text":"instead. Documenting the requirement is precisely the failure contract 1.23"},{"type":"text","text":" "},{"type":"text","text":"was written to stop: three SDKs asserting "},{"type":"codeVoice","code":"amqps:\/\/"},{"type":"text","text":" in a doc comment above a"},{"type":"text","text":" "},{"type":"text","text":"call that accepted anything."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What it enforces:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The scheme MUST be "},{"type":"codeVoice","code":"amqps:\/\/"},{"type":"text","text":". Every other scheme is refused, "},{"type":"codeVoice","code":"amqp:\/\/"},{"type":"text","text":" "},{"type":"text","text":"included, and there is "},{"type":"strong","inlineContent":[{"type":"text","text":"no loopback exception"}]},{"type":"text","text":" (§8b rule 8): this applies"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":", "},{"type":"codeVoice","code":"127.0.0.1"},{"type":"text","text":" and "},{"type":"codeVoice","code":"::1"},{"type":"text","text":" exactly as to any other host. §6’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"http:\/\/localhost"},{"type":"text","text":" dev carve-out does not extend here, and the server has"},{"type":"text","text":" "},{"type":"text","text":"no plaintext listener for such an exception to reach."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A custom CA bundle is supported, because an in-cluster broker’s certificate"},{"type":"text","text":" "},{"type":"text","text":"is not issued by a public CA — the common case, and it exists so nobody has"},{"type":"text","text":" "},{"type":"text","text":"a legitimate reason to want rule 4 relaxed."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A client certificate and its key are required TOGETHER. Half a client","type":"text"},{"text":" ","type":"text"},{"text":"identity fails closed rather than connecting without the mutual half.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"There is no verification-skip option, under any name. It is the most"},{"type":"text","text":" "},{"type":"text","text":"reliably misused option in TLS: it appears in a dev compose file, it works,"},{"type":"text","text":" "},{"type":"text","text":"and it travels unchanged into production, where it turns TLS into an"},{"type":"text","text":" "},{"type":"text","text":"expensive no-op against precisely the attacker TLS exists to stop."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"There is no plaintext fallback. A failed "},{"code":"amqps:\/\/","type":"codeVoice"},{"type":"text","text":" connection is an error"},{"type":"text","text":" "},{"type":"text","text":"to surface, not a condition to work around — and this call offers no way to"},{"type":"text","text":" "},{"type":"text","text":"express one."}],"type":"paragraph"}]}],"type":"orderedList"}]}],"abstract":[{"type":"text","text":"Validate a broker URL and its TLS material against §8b rules 1–5."}],"metadata":{"externalID":"s:8AxiamSDK13amqpsEndpoint_5caPEM017clientCertificateF00g3KeyF0AA05AmqpsD0VSS_SSSgA2HtKF","roleHeading":"Function","symbolKind":"func","modules":[{"name":"AxiamSDK"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"amqpsEndpoint","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"caPEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"clientCertificatePEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"clientKeyPEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AmqpsEndpoint","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV"}],"title":"amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)"},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)"},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AmqpsEndpoint":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AmqpsEndpoint","url":"\/documentation\/axiamsdk\/amqpsendpoint","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmqpsEndpoint"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AmqpsEndpoint"}],"abstract":[{"type":"text","text":"A validated broker endpoint: everything a caller needs to open an "},{"code":"amqps:\/\/","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"connection, and nothing that could open a plaintext one."}],"type":"topic","title":"AmqpsEndpoint"},"doc://AxiamSDK/documentation/AxiamSDK/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"amqpsEndpoint"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"caPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientCertificatePEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientKeyPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV","text":"AmqpsEndpoint"}],"title":"amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","url":"\/documentation\/axiamsdk\/amqpsendpoint(_:capem:clientcertificatepem:clientkeypem:)","role":"symbol","abstract":[{"type":"text","text":"Validate a broker URL and its TLS material against §8b rules 1–5."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}