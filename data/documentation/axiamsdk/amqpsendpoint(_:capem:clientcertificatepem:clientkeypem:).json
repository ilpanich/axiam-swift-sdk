t":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"clientCertificatePEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"clientKeyPEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AmqpsEndpoint","text":"AmqpsEndpoint","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"inlineContent":[{"text":"§22.11 rule 3 is why this is a public, tested function rather than a","type":"text"},{"text":" ","type":"text"},{"text":"paragraph.","type":"text"}],"type":"strong"},{"text":" §8b rule 7 cannot be satisfied by a runtime that never sees a URL","type":"text"},{"text":" ","type":"text"},{"text":"— this SDK bundles no AMQP client — so the SDK hands the integrator the check","type":"text"},{"text":" ","type":"text"},{"text":"instead. Documenting the requirement is precisely the failure contract 1.23","type":"text"},{"text":" ","type":"text"},{"text":"was written to stop: three SDKs asserting ","type":"text"},{"code":"amqps:\/\/","type":"codeVoice"},{"text":" in a doc comment above a","type":"text"},{"text":" ","type":"text"},{"text":"call that accepted anything.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What it enforces:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The scheme MUST be ","type":"text"},{"code":"amqps:\/\/","type":"codeVoice"},{"text":". Every other scheme is refused, ","type":"text"},{"code":"amqp:\/\/","type":"codeVoice"},{"text":" ","type":"text"},{"text":"included, and there is ","type":"text"},{"inlineContent":[{"type":"text","text":"no loopback exception"}],"type":"strong"},{"text":" (§8b rule 8): this applies","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"127.0.0.1","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"::1","type":"codeVoice"},{"text":" exactly as to any other host. §6’s","type":"text"},{"text":" ","type":"text"},{"code":"http:\/\/localhost","type":"codeVoice"},{"text":" dev carve-out does not extend here, and the server has","type":"text"},{"text":" ","type":"text"},{"text":"no plaintext listener for such an exception to reach.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A custom CA bundle is supported, because an in-cluster broker’s certificate"},{"type":"text","text":" "},{"type":"text","text":"is not issued by a public CA — the common case, and it exists so nobody has"},{"type":"text","text":" "},{"type":"text","text":"a legitimate reason to want rule 4 relaxed."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A client certificate and its key are required TOGETHER. Half a client","type":"text"},{"text":" ","type":"text"},{"text":"identity fails closed rather than connecting without the mutual half.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"There is no verification-skip option, under any name. It is the most","type":"text"},{"text":" ","type":"text"},{"text":"reliably misused option in TLS: it appears in a dev compose file, it works,","type":"text"},{"text":" ","type":"text"},{"text":"and it travels unchanged into production, where it turns TLS into an","type":"text"},{"text":" ","type":"text"},{"text":"expensive no-op against precisely the attacker TLS exists to stop.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"There is no plaintext fallback. A failed ","type":"text"},{"code":"amqps:\/\/","type":"codeVoice"},{"text":" connection is an error","type":"text"},{"text":" ","type":"text"},{"text":"to surface, not a condition to work around — and this call offers no way to","type":"text"},{"text":" ","type":"text"},{"text":"express one.","type":"text"}]}]}],"type":"orderedList"}]}],"abstract":[{"type":"text","text":"Validate a broker URL and its TLS material against §8b rules 1–5."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","kind":"symbol","role":"symbol","type":"topic","title":"amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"amqpsEndpoint"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"caPEM"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientCertificatePEM"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientKeyPEM"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV","kind":"typeIdentifier","text":"AmqpsEndpoint"}],"abstract":[{"type":"text","text":"Validate a broker URL and its TLS material against §8b rules 1–5."}],"url":"\/documentation\/axiamsdk\/amqpsendpoint(_:capem:clientcertificatepem:clientkeypem:)"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AmqpsEndpoint":{"kind":"symbol","title":"AmqpsEndpoint","navigatorTitle":[{"text":"AmqpsEndpoint","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A validated broker endpoint: everything a caller needs to open an "},{"type":"codeVoice","code":"amqps:\/\/"},{"type":"text","text":" "},{"type":"text","text":"connection, and nothing that could open a plaintext one."}],"url":"\/documentation\/axiamsdk\/amqpsendpoint","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AmqpsEndpoint","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmqpsEndpoint","kind":"identifier"}]}}}