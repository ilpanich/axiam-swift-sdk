{"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/amqpsendpoint(_:capem:clientcertificatepem:clientkeypem:)"]}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"amqpsEndpoint","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"caPEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"clientCertificatePEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"clientKeyPEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AmqpsEndpoint","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV"}],"roleHeading":"Function","modules":[{"name":"AxiamSDK"}],"role":"symbol","title":"amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","externalID":"s:8AxiamSDK13amqpsEndpoint_5caPEM017clientCertificateF00g3KeyF0AA05AmqpsD0VSS_SSSgA2HtKF","symbolKind":"func"},"abstract":[{"text":"Validate a broker URL and its TLS material against §8b rules 1–5.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"amqpsEndpoint"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"url"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"caPEM"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"clientCertificatePEM"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"clientKeyPEM"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AmqpsEndpoint","kind":"typeIdentifier","text":"AmqpsEndpoint"}]}]},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"§22.11 rule 3 is why this is a public, tested function rather than a"},{"type":"text","text":" "},{"type":"text","text":"paragraph."}]},{"text":" §8b rule 7 cannot be satisfied by a runtime that never sees a URL","type":"text"},{"text":" ","type":"text"},{"text":"— this SDK bundles no AMQP client — so the SDK hands the integrator the check","type":"text"},{"text":" ","type":"text"},{"text":"instead. Documenting the requirement is precisely the failure contract 1.23","type":"text"},{"text":" ","type":"text"},{"text":"was written to stop: three SDKs asserting ","type":"text"},{"code":"amqps:\/\/","type":"codeVoice"},{"text":" in a doc comment above a","type":"text"},{"text":" ","type":"text"},{"text":"call that accepted anything.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What it enforces:"}]},{"items":[{"content":[{"inlineContent":[{"text":"The scheme MUST be ","type":"text"},{"code":"amqps:\/\/","type":"codeVoice"},{"text":". Every other scheme is refused, ","type":"text"},{"code":"amqp:\/\/","type":"codeVoice"},{"text":" ","type":"text"},{"text":"included, and there is ","type":"text"},{"inlineContent":[{"text":"no loopback exception","type":"text"}],"type":"strong"},{"text":" (§8b rule 8): this applies","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"127.0.0.1","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"::1","type":"codeVoice"},{"text":" exactly as to any other host. §6’s","type":"text"},{"text":" ","type":"text"},{"code":"http:\/\/localhost","type":"codeVoice"},{"text":" dev carve-out does not extend here, and the server has","type":"text"},{"text":" ","type":"text"},{"text":"no plaintext listener for such an exception to reach.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A custom CA bundle is supported, because an in-cluster broker’s certificate","type":"text"},{"text":" ","type":"text"},{"text":"is not issued by a public CA — the common case, and it exists so nobody has","type":"text"},{"text":" ","type":"text"},{"text":"a legitimate reason to want rule 4 relaxed.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A client certificate and its key are required TOGETHER. Half a client"},{"type":"text","text":" "},{"type":"text","text":"identity fails closed rather than connecting without the mutual half."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"There is no verification-skip option, under any name. It is the most"},{"type":"text","text":" "},{"type":"text","text":"reliably misused option in TLS: it appears in a dev compose file, it works,"},{"type":"text","text":" "},{"type":"text","text":"and it travels unchanged into production, where it turns TLS into an"},{"type":"text","text":" "},{"type":"text","text":"expensive no-op against precisely the attacker TLS exists to stop."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"There is no plaintext fallback. A failed ","type":"text"},{"type":"codeVoice","code":"amqps:\/\/"},{"text":" connection is an error","type":"text"},{"text":" ","type":"text"},{"text":"to surface, not a condition to work around — and this call offers no way to","type":"text"},{"text":" ","type":"text"},{"text":"express one.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AmqpsEndpoint":{"url":"\/documentation\/axiamsdk\/amqpsendpoint","title":"AmqpsEndpoint","navigatorTitle":[{"text":"AmqpsEndpoint","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmqpsEndpoint","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A validated broker endpoint: everything a caller needs to open an "},{"type":"codeVoice","code":"amqps:\/\/"},{"type":"text","text":" "},{"type":"text","text":"connection, and nothing that could open a plaintext one."}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AmqpsEndpoint"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)":{"role":"symbol","title":"amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","url":"\/documentation\/axiamsdk\/amqpsendpoint(_:capem:clientcertificatepem:clientkeypem:)","kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","abstract":[{"type":"text","text":"Validate a broker URL and its TLS material against §8b rules 1–5."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"amqpsEndpoint"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"caPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientCertificatePEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientKeyPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"AmqpsEndpoint","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV"}]}}}