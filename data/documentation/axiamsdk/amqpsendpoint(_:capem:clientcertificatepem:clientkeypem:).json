{"abstract":[{"type":"text","text":"Validate a broker URL and its TLS material against §8b rules 1–5."}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"amqpsEndpoint"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"caPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientCertificatePEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientKeyPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV","text":"AmqpsEndpoint"}],"symbolKind":"func","title":"amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK13amqpsEndpoint_5caPEM017clientCertificateF00g3KeyF0AA05AmqpsD0VSS_SSSgA2HtKF","role":"symbol","roleHeading":"Function"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"amqpsEndpoint","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"url","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"caPEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"clientCertificatePEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"clientKeyPEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AmqpsEndpoint","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AmqpsEndpoint"}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"§22.11 rule 3 is why this is a public, tested function rather than a","type":"text"},{"text":" ","type":"text"},{"text":"paragraph.","type":"text"}],"type":"strong"},{"type":"text","text":" §8b rule 7 cannot be satisfied by a runtime that never sees a URL"},{"type":"text","text":" "},{"type":"text","text":"— this SDK bundles no AMQP client — so the SDK hands the integrator the check"},{"type":"text","text":" "},{"type":"text","text":"instead. Documenting the requirement is precisely the failure contract 1.23"},{"type":"text","text":" "},{"type":"text","text":"was written to stop: three SDKs asserting "},{"type":"codeVoice","code":"amqps:\/\/"},{"type":"text","text":" in a doc comment above a"},{"type":"text","text":" "},{"type":"text","text":"call that accepted anything."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What it enforces:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The scheme MUST be ","type":"text"},{"type":"codeVoice","code":"amqps:\/\/"},{"text":". Every other scheme is refused, ","type":"text"},{"type":"codeVoice","code":"amqp:\/\/"},{"text":" ","type":"text"},{"text":"included, and there is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"no loopback exception"}]},{"text":" (§8b rule 8): this applies","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"localhost"},{"text":", ","type":"text"},{"type":"codeVoice","code":"127.0.0.1"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"::1"},{"text":" exactly as to any other host. §6’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"http:\/\/localhost"},{"text":" dev carve-out does not extend here, and the server has","type":"text"},{"text":" ","type":"text"},{"text":"no plaintext listener for such an exception to reach.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A custom CA bundle is supported, because an in-cluster broker’s certificate"},{"type":"text","text":" "},{"type":"text","text":"is not issued by a public CA — the common case, and it exists so nobody has"},{"type":"text","text":" "},{"type":"text","text":"a legitimate reason to want rule 4 relaxed."}]}]},{"content":[{"inlineContent":[{"text":"A client certificate and its key are required TOGETHER. Half a client","type":"text"},{"text":" ","type":"text"},{"text":"identity fails closed rather than connecting without the mutual half.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"There is no verification-skip option, under any name. It is the most","type":"text"},{"text":" ","type":"text"},{"text":"reliably misused option in TLS: it appears in a dev compose file, it works,","type":"text"},{"text":" ","type":"text"},{"text":"and it travels unchanged into production, where it turns TLS into an","type":"text"},{"text":" ","type":"text"},{"text":"expensive no-op against precisely the attacker TLS exists to stop.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"There is no plaintext fallback. A failed "},{"type":"codeVoice","code":"amqps:\/\/"},{"type":"text","text":" connection is an error"},{"type":"text","text":" "},{"type":"text","text":"to surface, not a condition to work around — and this call offers no way to"},{"type":"text","text":" "},{"type":"text","text":"express one."}]}]}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/amqpsendpoint(_:capem:clientcertificatepem:clientkeypem:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"amqpsEndpoint"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"caPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientCertificatePEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientKeyPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"AmqpsEndpoint","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/amqpsendpoint(_:capem:clientcertificatepem:clientkeypem:)","type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","title":"amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","abstract":[{"text":"Validate a broker URL and its TLS material against §8b rules 1–5.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/AmqpsEndpoint":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmqpsEndpoint"}],"kind":"symbol","role":"symbol","type":"topic","title":"AmqpsEndpoint","abstract":[{"text":"A validated broker endpoint: everything a caller needs to open an ","type":"text"},{"code":"amqps:\/\/","type":"codeVoice"},{"text":" ","type":"text"},{"text":"connection, and nothing that could open a plaintext one.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AmqpsEndpoint"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AmqpsEndpoint","url":"\/documentation\/axiamsdk\/amqpsendpoint"}}}