{"variants":[{"paths":["\/documentation\/axiamsdk\/amqpsendpoint(_:capem:clientcertificatepem:clientkeypem:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)"},"metadata":{"symbolKind":"func","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"amqpsEndpoint","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"caPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientCertificatePEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientKeyPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"AmqpsEndpoint","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV"}],"title":"amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","roleHeading":"Function","modules":[{"name":"AxiamSDK"}],"role":"symbol","externalID":"s:8AxiamSDK13amqpsEndpoint_5caPEM017clientCertificateF00g3KeyF0AA05AmqpsD0VSS_SSSgA2HtKF"},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Validate a broker URL and its TLS material against §8b rules 1–5."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"amqpsEndpoint"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"url"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"caPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"clientCertificatePEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"clientKeyPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"AmqpsEndpoint","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AmqpsEndpoint"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"inlineContent":[{"text":"§22.11 rule 3 is why this is a public, tested function rather than a","type":"text"},{"text":" ","type":"text"},{"text":"paragraph.","type":"text"}],"type":"strong"},{"text":" §8b rule 7 cannot be satisfied by a runtime that never sees a URL","type":"text"},{"text":" ","type":"text"},{"text":"— this SDK bundles no AMQP client — so the SDK hands the integrator the check","type":"text"},{"text":" ","type":"text"},{"text":"instead. Documenting the requirement is precisely the failure contract 1.23","type":"text"},{"text":" ","type":"text"},{"text":"was written to stop: three SDKs asserting ","type":"text"},{"code":"amqps:\/\/","type":"codeVoice"},{"text":" in a doc comment above a","type":"text"},{"text":" ","type":"text"},{"text":"call that accepted anything.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What it enforces:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The scheme MUST be ","type":"text"},{"code":"amqps:\/\/","type":"codeVoice"},{"text":". Every other scheme is refused, ","type":"text"},{"code":"amqp:\/\/","type":"codeVoice"},{"text":" ","type":"text"},{"text":"included, and there is ","type":"text"},{"inlineContent":[{"type":"text","text":"no loopback exception"}],"type":"strong"},{"text":" (§8b rule 8): this applies","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"127.0.0.1","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"::1","type":"codeVoice"},{"text":" exactly as to any other host. §6’s","type":"text"},{"text":" ","type":"text"},{"code":"http:\/\/localhost","type":"codeVoice"},{"text":" dev carve-out does not extend here, and the server has","type":"text"},{"text":" ","type":"text"},{"text":"no plaintext listener for such an exception to reach.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A custom CA bundle is supported, because an in-cluster broker’s certificate","type":"text"},{"text":" ","type":"text"},{"text":"is not issued by a public CA — the common case, and it exists so nobody has","type":"text"},{"text":" ","type":"text"},{"text":"a legitimate reason to want rule 4 relaxed.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A client certificate and its key are required TOGETHER. Half a client"},{"type":"text","text":" "},{"type":"text","text":"identity fails closed rather than connecting without the mutual half."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"There is no verification-skip option, under any name. It is the most"},{"type":"text","text":" "},{"type":"text","text":"reliably misused option in TLS: it appears in a dev compose file, it works,"},{"type":"text","text":" "},{"type":"text","text":"and it travels unchanged into production, where it turns TLS into an"},{"type":"text","text":" "},{"type":"text","text":"expensive no-op against precisely the attacker TLS exists to stop."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"There is no plaintext fallback. A failed "},{"type":"codeVoice","code":"amqps:\/\/"},{"type":"text","text":" connection is an error"},{"type":"text","text":" "},{"type":"text","text":"to surface, not a condition to work around — and this call offers no way to"},{"type":"text","text":" "},{"type":"text","text":"express one."}]}]}],"type":"orderedList"}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","role":"collection","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"url":"\/documentation\/axiamsdk","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AmqpsEndpoint":{"navigatorTitle":[{"kind":"identifier","text":"AmqpsEndpoint"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmqpsEndpoint"}],"abstract":[{"text":"A validated broker endpoint: everything a caller needs to open an ","type":"text"},{"type":"codeVoice","code":"amqps:\/\/"},{"text":" ","type":"text"},{"text":"connection, and nothing that could open a plaintext one.","type":"text"}],"url":"\/documentation\/axiamsdk\/amqpsendpoint","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AmqpsEndpoint","title":"AmqpsEndpoint"},"doc://AxiamSDK/documentation/AxiamSDK/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"amqpsEndpoint","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"caPEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"clientCertificatePEM","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clientKeyPEM"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"AmqpsEndpoint","preciseIdentifier":"s:8AxiamSDK13AmqpsEndpointV"}],"abstract":[{"text":"Validate a broker URL and its TLS material against §8b rules 1–5.","type":"text"}],"kind":"symbol","title":"amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)","role":"symbol","url":"\/documentation\/axiamsdk\/amqpsendpoint(_:capem:clientcertificatepem:clientkeypem:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/amqpsEndpoint(_:caPEM:clientCertificatePEM:clientKeyPEM:)"}}}