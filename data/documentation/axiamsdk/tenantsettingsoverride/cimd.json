xt":": ","kind":"text"},{"text":"CimdPolicy","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK10CimdPolicyV"},{"kind":"text","text":"?"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","title":"AxiamSDK","role":"collection","kind":"symbol","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy":{"role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CimdPolicy","kind":"identifier"}],"title":"CimdPolicy","navigatorTitle":[{"text":"CimdPolicy","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy","abstract":[{"text":"Whether, and on what terms, a ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" that is a URL is resolved by fetching the document","type":"text"},{"text":" ","type":"text"},{"text":"it names (T21.5, ","type":"text"},{"code":"draft-ietf-oauth-client-id-metadata-document","type":"codeVoice"},{"text":"). # Why this is one nested","type":"text"},{"text":" ","type":"text"},{"text":"policy rather than nine fields Every field here is a term of a single decision — ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"do we","type":"text"},{"text":" ","type":"text"},{"text":"fetch a stranger’s URL and make a client out of what comes back","type":"text"}]},{"text":" — and none of them means","type":"text"},{"text":" ","type":"text"},{"text":"anything without [","type":"text"},{"code":"Self::enabled","type":"codeVoice"},{"text":"]. A tenant that states a CIMD posture states all of it; a","type":"text"},{"text":" ","type":"text"},{"text":"tenant that states none inherits its organization’s whole posture rather than half of one,","type":"text"},{"text":" ","type":"text"},{"text":"which is the only merge that cannot produce a combination neither party wrote. # The two","type":"text"},{"text":" ","type":"text"},{"text":"fields that can widen, and the seven that cannot [","type":"text"},{"code":"Self::enabled","type":"codeVoice"},{"text":"] and [","type":"text"},{"code":"Self::allow_http","type":"codeVoice"},{"text":"]","type":"text"},{"text":" ","type":"text"},{"text":"are ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"ordered"}]},{"text":": a tenant may turn either off but never on, exactly as","type":"text"},{"text":" ","type":"text"},{"code":"dynamic_registration","type":"codeVoice"},{"text":" may only move down its ladder. Everything else names ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"this tenant’s"}]},{"text":" ","type":"text"},{"text":"domains or ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"this tenant’s","type":"text"}]},{"text":" bounds, and there is no sense in which one tenant’s list of","type":"text"},{"text":" ","type":"text"},{"text":"trusted publishers is stricter than another’s — the same argument [","type":"text"},{"code":"OidcPolicy","type":"codeVoice"},{"text":"] already","type":"text"},{"text":" ","type":"text"},{"text":"makes for ","type":"text"},{"code":"dcr_allowed_redirect_hosts","type":"codeVoice"},{"text":". # Every bound here is a security control","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::max_metadata_bytes","type":"codeVoice"},{"text":"], [","type":"text"},{"code":"Self::min_cache_secs","type":"codeVoice"},{"text":"] and [","type":"text"},{"code":"Self::max_cache_secs","type":"codeVoice"},{"text":"] are not","type":"text"},{"text":" ","type":"text"},{"text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the","type":"text"},{"text":" ","type":"text"},{"text":"floor under how often that read may be repeated, and the ceiling on how long its result may","type":"text"},{"text":" ","type":"text"},{"text":"be trusted. Each is clamped again in code against the three constants above, so a settings","type":"text"},{"text":" ","type":"text"},{"text":"row written by hand cannot lift them.","type":"text"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/TenantSettingsOverride":{"abstract":[{"text":"Partial tenant overrides. ","type":"text"},{"code":"None","type":"codeVoice"},{"text":" = inherit from org baseline.","type":"text"}],"type":"topic","title":"TenantSettingsOverride","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/tenantsettingsoverride","navigatorTitle":[{"kind":"identifier","text":"TenantSettingsOverride"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TenantSettingsOverride"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TenantSettingsOverride"}}}