n\/AxiamSDK\/ManagementOpaqueEnrollment\/encode(to:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7EncoderP","text":"Encoder","kind":"typeIdentifier"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","role":"collection","type":"topic","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementOpaqueEnrollment":{"url":"\/documentation\/axiamsdk\/managementopaqueenrollment","role":"symbol","abstract":[{"text":"The client-supplied half of an OPAQUE enrolment, as it appears inside registration \/","type":"text"},{"type":"text","text":" "},{"type":"text","text":"change-password \/ reset-completion \/ bootstrap request bodies. There is no standalone"},{"type":"text","text":" "},{"type":"codeVoice","code":"register\/finish"},{"type":"text","text":" endpoint, deliberately. A record can only be created at a moment when the"},{"type":"text","text":" "},{"type":"text","text":"plaintext password legitimately exists on the client, and every one of those moments is"},{"type":"text","text":" "},{"type":"text","text":"already an endpoint that takes a password. A free-standing finish would be an endpoint whose"},{"type":"text","text":" "},{"type":"text","text":"only job is to attach a credential to an account, which is a thing worth not having. Kept"},{"type":"text","text":" "},{"type":"text","text":"separate from ["},{"type":"codeVoice","code":"CreateOpaqueCredential"},{"type":"text","text":"] because the tenant, the user and the credential"},{"type":"text","text":" "},{"type":"text","