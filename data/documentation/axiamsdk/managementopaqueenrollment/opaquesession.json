uld enrol a"},{"type":"text","text":" "},{"type":"text","text":"record against somebody else’s account."}],"kind":"symbol","url":"\/documentation\/axiamsdk\/managementopaqueenrollment","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ManagementOpaqueEnrollment"}]}}}