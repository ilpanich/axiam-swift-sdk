g","kind":"typeIdentifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment\/registrationRecord","type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementOpaqueEnrollment":{"kind":"symbol","navigatorTitle":[{"text":"ManagementOpaqueEnrollment","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/managementopaqueenrollment","type":"topic","abstract":[{"text":"The client-supplied half of an OPAQUE enrolment, as it appears inside registration \/","type":"text"},{"text":" ","type":"text"},{"text":"change-password \/ reset-completion \/ bootstrap request bodies. There is no standalone","type":"text"},{"text":" ","type":"text"},{"code":"register\/finish","type":"codeVoice"},{"text":" endpoint, deliberately. A record can only be created at a moment when the","type":"text"},{"text":" ","type":"text"},{"text":"plaintext password legitimately exists on the client, and every one of those moments is","type":"text"},{"text":" ","type":"text"},{"text":"already an endpoint that takes a password. A free-standing finish would be an endpoint whose","type":"text"},{"text":" ","type":"text"},{"text":"only job is to attach a credential to an account, which is a thing worth not having. Kept","type":"text"},{"text":" ","type":"text"},{"text":"separate from [","type":"text"},{"code":"CreateOpaqueCredential","type":"codeVoice"},{"text":"] because the tenant, the user and the credential","type":"text"},{"text":" ","type":"text"},{"text":"identifier are all decided by the server — a client that could name them could enrol a","type":"text"},{"text":" ","type":"text"},{"text":"record against somebody else’s account.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagementOpaqueEnrollment","kind":"identifier"}],"title":"ManagementOpaqueEnrollment","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment","role":"symbol"}}}