ntation\/axiamsdk\/managementopaqueenrollment\/registrationrecord","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"registrationRecord"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"abstract":[{"text":"Lowercase-hex serialized RFC 9807 ","type":"text"},{"code":"RegistrationRecord","type":"codeVoice"},{"text":".","type":"text"}],"title":"registrationRecord","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementOpaqueEnrollment":{"role":"symbol","title":"ManagementOpaqueEnrollment","url":"\/documentation\/axiamsdk\/managementopaqueenrollment","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagementOpaqueEnrollment","kind":"identifier"}],"navigatorTitle":[{"text":"ManagementOpaqueEnrollment","kind":"identifier"}],"abstract":[{"text":"The client-supplied half of an OPAQUE enrolment, as it appears inside registration \/","type":"text"},{"text":" ","type":"text"},{"text":"change-password \/ reset-completion \/ bootstrap request bodies. There is no standalone","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"register\/finish"},{"text":" endpoint, deliberately. A record can only be created at a moment when the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"plaintext password legitimately exists on the client, and every one of those moments is"},{"type":"text","text":" "},{"type":"text","text":"already an endpoint that takes a password. A free-standing finish would be an endpoint whose"},{"type":"text","text":" "},{"type":"text","text":"only job is to attach a credential to an account, which is a thing worth not having. Kept"},{"type":"text","text":" "},{"type":"text","text":"separate from ["},{"type":"codeVoice","code":"CreateOpaqueCredential"},{"type":"text","text":"] because the tenant, the user and the credential"},{"type":"text","text":" "},{"text":"identifier ar