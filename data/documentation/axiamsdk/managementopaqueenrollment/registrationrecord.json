ord"},{"text":" ","kind":"text"},{"text":"registrationRecord","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"title":"registrationRecord","abstract":[{"text":"Lowercase-hex serialized RFC 9807 ","type":"text"},{"code":"RegistrationRecord","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment\/registrationRecord"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementOpaqueEnrollment":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment","type":"topic","url":"\/documentation\/axiamsdk\/managementopaqueenrollment","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagementOpaqueEnrollment","kind":"identifier"}],"abstract":[{"type":"text","text":"The client-supplied half of an OPAQUE enrolment, as it appears inside registration \/"},{"type":"text","text":" "},{"type":"text","text":"change-password \/ reset-completion \/ bootstrap request bodies. There is no standalone"},{"type":"text","text":" "},{"type":"codeVoice","code":"register\/finish"},{"type":"text","text":" endpoint, deliberately. A record can only be created at a moment when the"},{"type":"text","text":" "},{"type":"text","text":"plaintext password legitimately exists on the client, and every one of those moments is"},{"type":"text","text":" "},{"type":"text","text":"already an endpoint that takes a password. A free-standing finish would be an endpoint whose"},{"type":"text","text":" "},{"type":"text","text":"only job is to attach a credential to an account, which is a thing worth not having. Kept"},{"type":"text","text":" "},{"type":"text","text":"separate from ["},{"type":"codeVoice","code":"CreateOpaqueCredential"},{"type":"text","text":"] because the tenant, the user and the credential"},{"type":"text","text":" "},{"type":"text","text":"identifier are all decided by the server — a client that could name them could enrol a"},{"type":"text","text":" "},{"type":"text","text":"record against somebody else’s account."}],"navigatorTitle":[{"text":"ManagementOpaqueEnrollment","kind":"identifier"}],"role":"symbol","title":"ManagementOpaqueEnrollment"}}}