{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment\/registrationRecord"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/managementopaqueenrollment\/registrationrecord"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:8AxiamSDK26ManagementOpaqueEnrollmentV18registrationRecordSSvp","role":"symbol","title":"registrationRecord","symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"registrationRecord"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Property"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"registrationRecord","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"platforms":["Linux"]}]}],"abstract":[{"type":"text","text":"Lowercase-hex serialized RFC 9807 "},{"type":"codeVoice","code":"RegistrationRecord"},{"type":"text","text":"."}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/ManagementOpaqueEnrollment":{"navigatorTitle":[{"kind":"identifier","text":"ManagementOpaqueEnrollment"}],"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/managementopaqueenrollment","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagementOpaqueEnrollment"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment","abstract":[{"type":"text","text":"The client-supplied half of an OPAQUE enrolment, as it appears inside registration \/"},{"type":"text","text":" "},{"type":"text","text":"change-password \/ reset-completion \/ bootstrap request bodies. There is no standalone"},{"type":"text","text":" "},{"code":"register\/finish","type":"codeVoice"},{"type":"text","text":" endpoint, deliberately. A record can only be created at a moment when the"},{"type":"text","text":" "},{"type":"text","text":"plaintext password legitimately exists on the client, and every one of those moments is"},{"type":"text","text":" "},{"type":"text","text":"already an endpoint that takes a password. A free-standing finish would be an endpoint whose"},{"type":"text","text":" "},{"type":"text","text":"only job is to attach a credential to an account, which is a thing worth not having. Kept"},{"type":"text","text":" "},{"type":"text","text":"separate from ["},{"code":"CreateOpaqueCredential","type":"codeVoice"},{"type":"text","text":"] because the tenant, the user and the credential"},{"type":"text","text":" "},{"type":"text","text":"identifier are all decided by the server — a client that could name them could enrol a"},{"type":"text","text":" "},{"type":"text","text":"record against somebody else’s account."}],"title":"ManagementOpaqueEnrollment","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementOpaqueEnrollment/registrationRecord":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"registrationRecord"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment\/registrationRecord","url":"\/documentation\/axiamsdk\/managementopaqueenrollment\/registrationrecord","kind":"symbol","type":"topic","title":"registrationRecord","abstract":[{"type":"text","text":"Lowercase-hex serialized RFC 9807 "},{"code":"RegistrationRecord","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]}}}