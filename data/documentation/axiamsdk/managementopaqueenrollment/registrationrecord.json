{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment\/registrationRecord"},"abstract":[{"text":"Lowercase-hex serialized RFC 9807 ","type":"text"},{"code":"RegistrationRecord","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"registrationRecord","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"}],"metadata":{"title":"registrationRecord","roleHeading":"Instance Property","externalID":"s:8AxiamSDK26ManagementOpaqueEnrollmentV18registrationRecordSSvp","role":"symbol","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"registrationRecord","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"modules":[{"name":"AxiamSDK"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/managementopaqueenrollment\/registrationrecord"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/ManagementOpaqueEnrollment":{"title":"ManagementOpaqueEnrollment","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagementOpaqueEnrollment"}],"abstract":[{"type":"text","text":"The client-supplied half of an OPAQUE enrolment, as it appears inside registration \/"},{"type":"text","text":" "},{"type":"text","text":"change-password \/ reset-completion \/ bootstrap request bodies. There is no standalone"},{"type":"text","text":" "},{"type":"codeVoice","code":"register\/finish"},{"type":"text","text":" endpoint, deliberately. A record can only be created at a moment when the"},{"type":"text","text":" "},{"type":"text","text":"plaintext password legitimately exists on the client, and every one of those moments is"},{"type":"text","text":" "},{"type":"text","text":"already an endpoint that takes a password. A free-standing finish would be an endpoint whose"},{"type":"text","text":" "},{"type":"text","text":"only job is to attach a credential to an account, which is a thing worth not having. Kept"},{"type":"text","text":" "},{"type":"text","text":"separate from ["},{"type":"codeVoice","code":"CreateOpaqueCredential"},{"type":"text","text":"] because the tenant, the user and the credential"},{"type":"text","text":" "},{"type":"text","text":"identifier are all decided by the server — a client that could name them could enrol a"},{"type":"text","text":" "},{"type":"text","text":"record against somebody else’s account."}],"navigatorTitle":[{"kind":"identifier","text":"ManagementOpaqueEnrollment"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment","url":"\/documentation\/axiamsdk\/managementopaqueenrollment","kind":"symbol","type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementOpaqueEnrollment/registrationRecord":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment\/registrationRecord","title":"registrationRecord","abstract":[{"type":"text","text":"Lowercase-hex serialized RFC 9807 "},{"type":"codeVoice","code":"RegistrationRecord"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","url":"\/documentat