andalone"},{"type":"text","text":" "},{"type":"codeVoice","code":"register\/finish"},{"type":"text","text":" endpoint, deliberately. A record can only be created at a moment when the"},{"type":"text","text":" "},{"type":"text","text":"plaintext password legitimately exists on the client, and every one of those moments is"},{"type":"text","text":" "},{"type":"text","text":"already an endpoint that takes a password. A free-standing finish would be an endpoint whose"},{"type":"text","text":" "},{"type":"text","text":"only job is to attach a credential to an account, which is a thing worth not having. Kept"},{"type":"text","text":" "},{"type":"text","text":"separate from ["},{"type":"codeVoice","code":"CreateOpaqueCredential"},{"type":"text","text":"] because the tenant, the user and the credential"},{"type":"text","text":" "},{"type":"text","text":"identifier are all decided by the server — a client that could name them could enrol a"},{"type":"text","text":" "},{"type":"text","text":"record against somebody else’s account."}],"title":"ManagementOpaqueEnrollment","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagementOpaqueEnrollment"}],"navigatorTitle":[{"kind":"identifier","text":"ManagementOpaqueEnrollment"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment","kind":"symbol","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/ManagementOpaqueEnrollment/init(from:)":{"url":"\/documentation\/axiamsdk\/managementopaqueenrollment\/init(from:)","abstract":[],"title":"init(from:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/document