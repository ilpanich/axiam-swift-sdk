{"abstract":[{"type":"text","text":"The largest number of entries kept in the cache (§10.4 rule 2)."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/maxEntries"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxEntries"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The server bounds the document by its own revocation rate over one token lifetime, so","type":"text"},{"text":" ","type":"text"},{"text":"this is defence against a server that stops doing so — a cache with no ceiling is an","type":"text"},{"text":" ","type":"text"},{"text":"allocation an unauthenticated endpoint controls. Overflow drops the ","type":"text"},{"inlineContent":[{"type":"text","text":"whole"}],"type":"strong"},{"text":" set","type":"text"},{"text":" ","type":"text"},{"text":"rather than truncating it: a truncated set is a guard that admits some revoked","type":"text"},{"text":" ","type":"text"},{"text":"sessions and reports none, which is worse than a guard that admits all of them and","type":"text"},{"text":" ","type":"text"},{"text":"says the feed is unusable.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/revocationfeed\/maxentries"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"symbol","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK14RevocationFeedC10maxEntriesSivpZ","title":"maxEntries","roleHeading":"Type Property","symbolKind":"property","fragments":[{"kind":"keyword","text":"static"},{"kind":"text"