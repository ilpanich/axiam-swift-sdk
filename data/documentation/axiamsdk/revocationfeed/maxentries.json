{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed"]]},"abstract":[{"type":"text","text":"The largest number of entries kept in the cache (§10.4 rule 2)."}],"kind":"symbol","metadata":{"title":"maxEntries","role":"symbol","externalID":"s:8AxiamSDK14RevocationFeedC10maxEntriesSivpZ","modules":[{"name":"AxiamSDK"}],"symbolKind":"property","roleHeading":"Type Property","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxEntries","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxEntries","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"The server bounds the document by its own revocation rate over one token lifetime, so","type":"text"},{"text":" ","type":"text"},{"text":"this is defence against a server that stops doing so — a cache with no ceiling is an","type":"text"},{"text":" ","type":"text"},{"text":"allocation an unauthenticated endpoint controls. Overflow drops the ","type":"text"},{"type":"strong","inlineContent":[{"text":"whole","type":"text"}]},{"text":" set","type":"text"},{"text":" ","type":"text"},{"text":"rather than truncating it: a truncated set is a guard that admits some revoked","type":"text"},{"text":" ","type":"text"},{"text":"sessions and reports none, which is worse than a guard that admits all of them and","type":"text"},{"text":" ","type":"text"},{"text":"says the feed is unusable.","type