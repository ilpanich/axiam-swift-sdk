ial-grade; * the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"identifier":"Self::Dcr","type":"reference","isActive":true},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"identifier":"Self::Admin","overridingTitleInlineContent":[{"code":"Admin","type":"codeVoice"}],"overridingTitle":"Admin","type":"reference","isActive":true},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/RawRepresentable-Implementations":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/RawRepresentable-Implementations","kind":"article","url":"\/documentation\/axiamsdk\/managedby\/rawrepresentable-implementations","title":"RawRepresentable Implementations","type":"topic","role":"collectionGroup","abstract":[]},"Self::Dcr":{"identifier":"Self::Dcr","url":"Self::Dcr","title":"Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"type":"link"},"Self::Admin":{"identifier":"Self::Admin","url":"Self::Admin","title":"Admin","titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"type":"link"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk