idingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"overridingTitle":"Admin","type":"reference","identifier":"Self::Admin","isActive":true},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"code":"POST \/oauth2-clients","type":"codeVoice"},{"type":"text","text":" by somebody holding "},{"code":"oauth2_clients:create","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","title":"ManagedBy","navigatorTitle":[{"kind":"identifier","text":"ManagedBy"}]},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/RawRepresentable-Implementations":{"abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/RawRepresentable-Implementations","title":"RawRepresentable Implementations","type":"topic","url":"\/documentation\/axiamsdk\/managedby\/rawrepresentable-implementations","role":"collectionGroup","kind":"article"},"Self::Dcr":{"titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"title":"Dcr","url":"Self::Dcr","identifier":"Self::Dcr","type":"link"},"Self::Admin":{"titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"title":"Admin","url":"Self::Admin","identifier":"Self::Admin","type":"link"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/hashValue":{"title":"hashValue","abstract":[],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/hashValue","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"RawValue"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"fragments":[{"text":"var","kind":"keyword"},{"text":"