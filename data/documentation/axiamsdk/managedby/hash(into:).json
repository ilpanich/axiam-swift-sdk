},{"text":" rows, so an administrator’s client is never swept however","type":"text"},{"text":" ","type":"text"},{"text":"long it sits unused. ","type":"text"},{"overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"identifier":"Self::Admin","type":"reference","isActive":true},{"text":" is the serde default and therefore what every","type":"text"},{"text":" ","type":"text"},{"text":"row written before T21.4 decodes to, which is the truth: they were all created through ","type":"text"},{"code":"POST \/oauth2-clients","type":"codeVoice"},{"text":" by somebody holding ","type":"text"},{"code":"oauth2_clients:create","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"}}}