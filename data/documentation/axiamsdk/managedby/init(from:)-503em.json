used. ","type":"text"},{"overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"identifier":"Self::Admin","type":"reference","isActive":true},{"text":" is the serde default and therefore what every","type":"text"},{"text":" ","type":"text"},{"text":"row written before T21.4 decodes to, which is the truth: they were all created through ","type":"text"},{"code":"POST \/oauth2-clients","type":"codeVoice"},{"text":" by somebody holding ","type":"text"},{"code":"oauth2_clients:create","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/init(from:)-503em":{"type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"url":"\/documentation\/axiamsdk\/managedby\/init(from:)-503em","abstract":[{"text":"Decodes an unrecognised value to ","type":"text"},{"type":"codeVoice","code":".unknown"},{"text":" instead of throwing.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/init(from:)-503em","role":"symbol","title":"init(from:)","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","title":"AxiamSDK","role":"collection","kind":"symbol","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"Self::Admin":{"type":"link","url":"Self::Admin","identifier":"Self::Admin","titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"title":"Admin"},"Self::Dcr":{"type":"link","url":"Self::Dcr","identifier":"Self::Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"title":"Dcr"}}}