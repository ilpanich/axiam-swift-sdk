atever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"identifier":"Self::Dcr","type":"reference","isActive":true},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"identifier":"Self::Admin","overridingTitleInlineContent":[{"code":"Admin","type":"codeVoice"}],"overridingTitle":"Admin","type":"reference","isActive":true},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/init(from:)-v8j8":{"url":"\/documentation\/axiamsdk\/managedby\/init(from:)-v8j8","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/init(from:)-v8j8","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Decoder","preciseIdentifier":"s:s7DecoderP"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"title":"init(from:)","abstract":[],"type":"topic","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Decodable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":", and "},{"type":"codeVoice","code":"RawValue"},{"type":"text","text":" is "},{"type":"codeVoice","code":"String"},{"type":"text","text":"."}