}],"platforms":["Linux"],"languages":["swift"]}]}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"navigatorTitle":[{"kind":"identifier","text":"ManagedBy"}],"type":"topic","url":"\/documentation\/axiamsdk\/managedby","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagedBy"}],"title":"ManagedBy","abstract":[{"type":"text","text":"Who created a client registration (D5, T21.4). The discriminator that separates a"},{"type":"text","text":" "},{"type":"text","text":"registration an administrator made from one that arrived over an open endpoint. Three things"},{"type":"text","text":" "},{"type":"text","text":"read it and each would otherwise have to infer provenance from something that is not"},{"type":"text","text":" "},{"type":"text","text":"provenance: * "},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"type":"text","text":" refuses a FAPI profile on anything but"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"Self::Admin"},{"type":"text","text":" (I5) — a client nobody vetted cannot be financial-grade; * the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"isActive":true,"type":"reference","identifier":"Self::Dcr"},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"isActive":true,"overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"type":"reference","identifier":"Self::Admin"},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/init(from:)-v8j8":{"kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"title":"init(from:)","abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/init(from:)-v8j8","url":"\/documentation\/axiamsdk\/managedby\/init(from:)-v8j8","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Decodable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"RawValue"},{"type":"text","text":" is "},{"type":"codeVoice","code":"String"},{"type":"text","text":"."}]},"type":"topic"},"Self::Dcr":{"identifier":"Self::Dcr","type":"link","title":"Dcr","titleInlineContent":[{"code":"Dcr","type":"codeVoice"}],"url":"Self::Dcr"},"Self::Admin":{"titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"identifier":"Self::Admin","url":"Self::Admin","type":"link","