{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"encoder","kind":"internalParam"},{"text":": any ","kind":"text"},{"text":"Encoder","preciseIdentifier":"s:s7EncoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Decoding is lenient so one unrecognised value does not fail a whole response; writing is"},{"type":"text","text":" "},{"type":"text","text":"not, because the only spelling "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" has is the empty string. A read-modify-write"},{"type":"text","text":" "},{"type":"text","text":"of a record that carries one raises before any request (CONTRACT.md §34.2 P12.2,"},{"type":"text","text":" "},{"type":"text","text":"contract 1.60 A4)."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK9ManagedByO6encode2toys7Encoder_p_tKF","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Encoder","preciseIdentifier":"s:s7EncoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol","title":"encode(to:)","symbolKind":"method"},"abstract":[{"text":"Refuses ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":": a value this SDK could not name is never sent.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/managedby\/encode(to:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/encode(to:)"},"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/encode(to:)":{"kind":"symbol","url":"\/documentation\/axiamsdk\/managedby\/encode(to:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Encoder","preciseIdentifier":"s:s7EncoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"abstract":[{"type":"text","text":"Refuses "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":": a value this SDK could not name is never sent."}],"type":"topic","title":"encode(to:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/encode(to:)"},"Self::Admin":{"type":"link","identifier":"Self::Admin","title":"Admin","url":"Self::Admin","titleInlineContent":[{"code":"Admin","type":"codeVoice"}]},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagedBy","kind":"identifier"}],"role":"symbol","title":"ManagedBy","abstract":[{"type":"text","text":"Who created a client registration (D5, T21.4). The discriminator that separates a"},{"type":"text","text":" "},{"type":"text","text":"registration an administrator made from one that arrived over an open endpoint. Three things"},{"type":"text","text":" "},{"type":"text","text":"read it and each would otherwise have to infer provenance from something that is not"},{"type":"text","text":" "},{"type":"text","text":"provenance: * "},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"type":"text","text":" refuses a FAPI profile on anything but"},{"type":"text","text":" "},{"type":"reference","identifier":"Self::Admin","isActive":true},{"type":"text","text":" (I5) — a client nobody vetted cannot be financial-grade; * the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"type":"reference","identifier":"Self::Dcr","isActive":true},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"type":"reference","identifier":"Self::Admin","overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"isActive":true},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"url":"\/documentation\/axiamsdk\/managedby","navigatorTitle":[{"text":"ManagedBy","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","kind":"symbol"},"Self::Dcr":{"identifier":"Self::Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"title":"Dcr","url":"Self::Dcr","type":"link"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}