y parses a raw string","type":"text"},{"text":" ","type":"text"},{"text":"keeps its check. Only DECODING, where the alternative is failing a whole response, is","type":"text"},{"text":" ","type":"text"},{"text":"lenient.","type":"text"}]}],"kind":"content"}],"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/init(from:)":{"url":"\/documentation\/axiamsdk\/managedby\/init(from:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/init(from:)","abstract":[{"text":"Decodes an unrecognised value to ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" instead of throwing.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"init(from:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}]},"Self::Dcr":{"identifier":"Self::Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"title":"Dcr","url":"Self::Dcr","type":"link"},"Self::Admin":{"titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"type":"link","title":"Admin","url":"Self::Admin","identifier":"Self::Admin"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagedBy","kind":"identifier"}],"role":"symbol","title":"ManagedBy","abstract":[{"type":"text","text":"Who created a client registration (D5, T21.4). The discriminator that separates a"},{"type":"text","text":" "},{"type":"text","text":"registration an administrator made from one that arrived over an open endpoint. Three things"},{"type":"text","text":" "},{"type":"text","text":"read it and each would otherwise have to infer provenance from something that is not"},{"type":"text","text":" "},{"type":"text","text":"provenance: * "},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"type":"text","text":" refuses a FAPI profile on anything but"},{"type":"text","text":" "},{"type":"reference","identifier":"Self::Admin","isActive":true},{"type":"text","text":" (I5) — a client nobody vetted cannot be financial-grade; * the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"type":"reference","identifier":"Self::Dcr","isActive":true},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"type":"reference","identifier":"Self::Admin","overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"isActive":true},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"url":"\/documentation\/axiamsdk\/managedby","navigatorTitle":[{"text":"ManagedBy","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","kind":"symbol"}}}