:"text","text":"read it and each would otherwise have to infer provenance from something that is not"},{"type":"text","text":" "},{"type":"text","text":"provenance: * "},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"type":"text","text":" refuses a FAPI profile on anything but"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"Self::Admin"},{"type":"text","text":" (I5) — a client nobody vetted cannot be financial-grade; * the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"isActive":true,"type":"reference","identifier":"Self::Dcr"},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"isActive":true,"overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"type":"reference","identifier":"Self::Admin"},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy"},"Self::Dcr":{"title":"Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"identifier":"Self::Dcr","type":"link","url":"Self::Dcr"},"Self::Admin":{"type":"link","identifier":"Self::Admin","title":"Admin","titleInlineContent":[{"code":"Admin","type":"codeVoice"}],"url":"Self::Admin"},"doc://AxiamSDK/docume