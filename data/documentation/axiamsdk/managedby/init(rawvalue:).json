:"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","url":"\/documentation\/axiamsdk\/managedby","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagedBy"}],"abstract":[{"text":"Who created a client registration (D5, T21.4). The discriminator that separates a","type":"text"},{"text":" ","type":"text"},{"text":"registration an administrator made from one that arrived over an open endpoint. Three things","type":"text"},{"text":" ","type":"text"},{"text":"read it and each would otherwise have to infer provenance from something that is not","type":"text"},{"text":" ","type":"text"},{"text":"provenance: * ","type":"text"},{"code":"axiam_oauth2::fapi","type":"codeVoice"},{"text":" refuses a FAPI profile on anything but","type":"text"},{"text":" ","type":"text"},{"identifier":"Self::Admin","isActive":true,"type":"reference"},{"text":" (I5) — a client nobody vetted cannot be financial-grade; * the","type":"text"},{"text":" ","type":"text"},{"text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"type":"reference","identifier":"Self::Dcr","isActive":true},{"text":" rows, so an administrator’s client is never swept however","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"long it sits unused. "},{"overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"overridingTitle":"Admin","type":"reference","identifier":"Self::Admin","isActive":true},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"code":"POST \/oauth2-clients","type":"codeVoice"},{"type":"text","text":" by somebody holding "},{"code":"oauth2_clients:create","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","title":"ManagedBy","navigatorTitle":[{"kind":"identifier","text":"ManagedBy"}]},"Self::Dcr":{"identifier":"Self::Dcr","url":"Self::Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"type":"link","title":"Dcr"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"Self::Admin":{"identifier":"Self::Admin","url":"Self::Admin","titleInlineContent":[{"code":"Admin","type":"codeVoice"}],"type":"link","title":"Admin"}}}