type":"text"},{"type":"text","text":"deletes only "},{"type":"reference","isActive":true,"identifier":"Self::Dcr"},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"isActive":true,"type":"reference","overridingTitle":"Admin","identifier":"Self::Admin","overridingTitleInlineContent":[{"code":"Admin","type":"codeVoice"}]},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol"}}}