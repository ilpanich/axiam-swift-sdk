erences":{"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/Equatable-Implementations":{"role":"collectionGroup","url":"\/documentation\/axiamsdk\/managedby\/equatable-implementations","kind":"article","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/Equatable-Implementations","abstract":[],"type":"topic","title":"Equatable Implementations"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/!=(_:_:)":{"role":"symbol","url":"\/documentation\/axiamsdk\/managedby\/!=(_:_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/!=(_:_:)","abstract":[],"type":"topic","title":"!=(_:_:)"},"Self::Admin":{"titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"url":"Self::Admin","identifier":"Self::Admin","type":"link","title":"Admin"},"Self::Dcr":{"titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"url":"Self::Dcr","identifier":"Self::Dcr","type":"link","title":"Dcr"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagedBy"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ManagedBy"}],"url":"\/documentation\/axiamsdk\/managedby","title":"ManagedBy","abstract":[{"type":"text","text":"Who created a client registration (D5, T21.4). The discriminator that separates a"},{"type":"text","text":" "},{"type":"text","text":"registration an administrator made from one that arrived over an open endpoint. Three things"},{"type":"text","text":" "},{"type":"text","text":"read it and each would otherwise have to infer provenance from something that is not"},{"type":"text","text":" "},{"type":"text","text":"provenance: * "},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"type":"text","text":" refuses a FAPI profile on anything but"},{"type":"text","text":" "},{"identifier":"Self::Admin","type":"reference","isActive":true},{"type":"text","text":" (I5) — a client nobody vetted cannot be financial-grade; * the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"identifier":"Self::Dcr","type":"reference","isActive":true},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"identifier":"Self::Admin","overridingTitleInlineContent":[{"code":"Admin","type":"codeVoice"}],"overridingTitle":"Admin","type":"reference","isActive":true},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]}}}