{"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/unknown","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."}],"metadata":{"role":"symbol","symbolKind":"case","modules":[{"name":"AxiamSDK"}],"title":"ManagedBy.unknown","roleHeading":"Case","externalID":"s:8AxiamSDK9ManagedByO7unknownyA2CmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"unknown","kind":"identifier"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}],"languages":["swift"],"platforms":["Linux"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/managedby\/unknown"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy"]]},"sections":[],"references":{"Self::Dcr":{"title":"Dcr","type":"link","titleInlineContent":[{"code":"Dcr","type":"codeVoice"}],"url":"Self::Dcr","identifier":"Self::Dcr"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"Self::Admin":{"titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"identifier":"Self::Admin","title":"Admin","type":"link","url":"Self::Admin"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"navigatorTitle":[{"kind":"identifier","text":"ManagedBy"}],"type":"topic","url":"\/documentation\/axiamsdk\/managedby","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagedBy"}],"title":"ManagedBy","abstract":[{"type":"text","text":"Who created a client registration (D5, T21.4). The discriminator that separates a"},{"type":"text","text":" "},{"type":"text","text":"registration an administrator made from one that arrived over an open endpoint. Three things"},{"type":"text","text":" "},{"type":"text","text":"read it and each would otherwise have to infer provenance from something that is not"},{"type":"text","text":" "},{"type":"text","text":"provenance: * "},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"type":"text","text":" refuses a FAPI profile on anything but"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"Self::Admin"},{"type":"text","text":" (I5) — a client nobody vetted cannot be financial-grade; * the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"isActive":true,"type":"reference","identifier":"Self::Dcr"},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"isActive":true,"overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"type":"reference","identifier":"Self::Admin"},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/unknown":{"kind":"symbol","abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}],"type":"topic","url":"\/documentation\/axiamsdk\/managedby\/unknown","title":"ManagedBy.unknown","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/unknown"}}}