{"metadata":{"role":"collectionGroup","modules":[{"name":"AxiamSDK"}],"title":"Equatable Implementations","roleHeading":"API Collection"},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/Equatable-Implementations","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy"]]},"sections":[],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Operators","title":"Operators","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/!=(_:_:)"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/managedby\/equatable-implementations"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"navigatorTitle":[{"kind":"identifier","text":"ManagedBy"}],"type":"topic","url":"\/documentation\/axiamsdk\/managedby","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagedBy"}],"title":"ManagedBy","abstract":[{"type":"text","text":"Who created a client registration (D5, T21.4). The discriminator that separates a"},{"type":"text","text":" "},{"type":"text","text":"registration an administrator made from one that arrived over an open endpoint. Three things"},{"type":"text","text":" "},{"type":"text","text":"read it and each would otherwise have to infer provenance from something that is not"},{"type":"text","text":" "},{"type":"text","text":"provenance: * "},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"type":"text","text":" refuses a FAPI profile on anything but"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"Self::Admin"},{"type":"text","text":" (I5) — a client nobody vetted cannot be financial-grade; * the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"isActive":true,"type":"reference","identifier":"Self::Dcr"},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"isActive":true,"overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"type":"reference","identifier":"Self::Admin"},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy"},"Self::Admin":{"type":"link","identifier":"Self::Admin","titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"title":"Admin","url":"Self::Admin"},"Self::Dcr":{"identifier":"Self::Dcr","type":"link","title":"Dcr","titleInlineContent":[{"code":"Dcr","type":"codeVoice"}],"url":"Self::Dcr"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy/!=(_:_:)":{"title":"!=(_:_:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy\/!=(_:_:)","role":"symbol","url":"\/documentation\/axiamsdk\/managedby\/!=(_:_:)","kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"