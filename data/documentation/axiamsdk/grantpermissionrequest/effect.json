{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","kind":"typeIdentifier","text":"PermissionEffect"},{"kind":"text","text":"?"}],"languages":["swift"]}],"kind":"declarations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"title":"effect","externalID":"s:8AxiamSDK22GrantPermissionRequestV6effectAA0D6EffectOSgvp","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","text":"PermissionEffect"},{"kind":"text","text":"?"}],"symbolKind":"property","role":"symbol"},"abstract":[{"type":"text","text":"B1: "},{"type":"codeVoice","code":"\"allow\""},{"type":"text","text":" (the default) or "},{"type":"codeVoice","code":"\"deny\""},{"type":"text","text":". A deny grant "},{"inlineContent":[{"text":"overrides every allow","type":"text"}],"type":"strong"},{"type":"text","text":", at any"},{"type":"text","text":" "},{"type":"text","text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" for the precedence table and for why that trade"},{"type":"text","text":" "},{"type":"text","text":"was made. Omitting the field means "},{"type":"codeVoice","code":"\"allow\""},{"type":"text","text":", so every existing client keeps working"},{"type":"text","text":" "},{"type":"text","text":"unchanged and no migration is required."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/grantpermissionrequest\/effect"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"url":"\/documentation\/axiamsdk\/permissioneffect","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"title":"PermissionEffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"type":"strong","inlineContent":[{"type":"text","text":"and beats every allow"}]},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"type":"text","text":"adding a deny rule can never widen access, and can never be undone by"},{"type":"text","text":" "},{"type":"text","text":"adding allows"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}]},"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest/effect":{"url":"\/documentation\/axiamsdk\/grantpermissionrequest\/effect","title":"effect","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO"},{"kind":"text","text":"?"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect","type":"topic","abstract":[{"text":"B1: ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":" (the default) or ","type":"text"},{"code":"\"deny\"","type":"codeVoice"},{"text":". A deny grant ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"overrides every allow"}]},{"text":", at any","type":"text"},{"text":" ","type":"text"},{"text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"text":" for the precedence table and for why that trade","type":"text"},{"text":" ","type":"text"},{"text":"was made. Omitting the field means ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":", so every existing client keeps working","type":"text"},{"text":" ","type":"text"},{"text":"unchanged and no migration is required.","type":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest":{"type":"topic","abstract":[{"text":"The ","type":"text"},{"code":"GrantPermissionRequest","type":"codeVoice"},{"text":" schema.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"GrantPermissionRequest"}],"title":"GrantPermissionRequest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GrantPermissionRequest"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest","url":"\/documentation\/axiamsdk\/grantpermissionrequest","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}