{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"B1: "},{"type":"codeVoice","code":"\"allow\""},{"type":"text","text":" (the default) or "},{"type":"codeVoice","code":"\"deny\""},{"type":"text","text":". A deny grant "},{"type":"strong","inlineContent":[{"type":"text","text":"overrides every allow"}]},{"type":"text","text":", at any"},{"type":"text","text":" "},{"type":"text","text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" for the precedence table and for why that trade"},{"type":"text","text":" "},{"type":"text","text":"was made. Omitting the field means "},{"type":"codeVoice","code":"\"allow\""},{"type":"text","text":", so every existing client keeps working"},{"type":"text","text":" "},{"type":"text","text":"unchanged and no migration is required."}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest"]]},"metadata":{"title":"effect","externalID":"s:8AxiamSDK22GrantPermissionRequestV6effectAA0D6EffectOSgvp","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO"},{"kind":"text","text":"?"}],"symbolKind":"property","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Property"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/grantpermissionrequest\/effect"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","text":"PermissionEffect"},{"kind":"text","text":"?"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest":{"role":"symbol","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GrantPermissionRequest"},{"type":"text","text":" schema."}],"title":"GrantPermissionRequest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GrantPermissionRequest","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest","url":"\/documentation\/axiamsdk\/grantpermissionrequest","navigatorTitle":[{"text":"GrantPermissionRequest","kind":"identifier"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest/effect":{"abstract":[{"text":"B1: ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":" (the default) or ","type":"text"},{"code":"\"deny\"","type":"codeVoice"},{"text":". A deny grant ","type":"text"},{"inlineContent":[{"text":"overrides every allow","type":"text"}],"type":"strong"},{"text":", at any","type":"text"},{"text":" ","type":"text"},{"text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"text":" for the precedence table and for why that trade","type":"text"},{"text":" ","type":"text"},{"text":"was made. Omitting the field means ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":", so every existing client keeps working","type":"text"},{"text":" ","type":"text"},{"text":"unchanged and no migration is required.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect","title":"effect","type":"topic","url":"\/documentation\/axiamsdk\/grantpermissionrequest\/effect","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"effect","kind":"identifier"},{"text":": ","kind":"text"},{"text":"PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"title":"PermissionEffect","navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"kind":"symbol","abstract":[{"text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default","type":"text"},{"text":" ","type":"text"},{"text":"deny -> an [","type":"text"},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"text":"] grant permits -> a [","type":"text"},{"code":"PermissionEffect::Deny","type":"codeVoice"},{"text":"] grant","type":"text"},{"text":" ","type":"text"},{"text":"refuses, ","type":"text"},{"inlineContent":[{"type":"text","text":"and beats every allow"}],"type":"strong"},{"text":", wherever either sits in the resource hierarchy. Deny","type":"text"},{"text":" ","type":"text"},{"text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in","type":"text"},{"text":" ","type":"text"},{"text":"full in ","type":"text"},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"text":" §2.1. The short version: deny-override buys one","type":"text"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"type":"text","text":"adding a deny rule can never widen access, and can never be undone by"},{"type":"text","text":" "},{"type":"text","text":"adding allows"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"text":", both mean “allow”. No migration.","type":"text"}],"url":"\/documentation\/axiamsdk\/permissioneffect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"role":"symbol","type":"topic"}}}