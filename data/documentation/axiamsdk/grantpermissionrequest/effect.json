{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","text":"PermissionEffect"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["Linux"]}]}],"sections":[],"metadata":{"roleHeading":"Instance Property","title":"effect","modules":[{"name":"AxiamSDK"}],"symbolKind":"property","role":"symbol","externalID":"s:8AxiamSDK22GrantPermissionRequestV6effectAA0D6EffectOSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"effect","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","text":"PermissionEffect","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest"]]},"abstract":[{"type":"text","text":"B1: "},{"type":"codeVoice","code":"\"allow\""},{"type":"text","text":" (the default) or "},{"type":"codeVoice","code":"\"deny\""},{"type":"text","text":". A deny grant "},{"type":"strong","inlineContent":[{"type":"text","text":"overrides every allow"}]},{"type":"text","text":", at any"},{"type":"text","text":" "},{"type":"text","text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" for the precedence table and for why that trade"},{"type":"text","text":" "},{"type":"text","text":"was made. Omitting the field means "},{"type":"codeVoice","code":"\"allow\""},{"type":"text","text":", so every existing client keeps working"},{"type":"text","text":" "},{"type":"text","text":"unchanged and no migration is required."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/grantpermissionrequest\/effect"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"title":"PermissionEffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"type":"strong","inlineContent":[{"type":"text","text":"and beats every allow"}]},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}],"kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}],"navigatorTitle":[{"text":"PermissionEffect","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/permissioneffect","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"},"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest":{"abstract":[{"text":"The ","type":"text"},{"code":"GrantPermissionRequest","type":"codeVoice"},{"text":" schema.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GrantPermissionRequest","kind":"identifier"}],"title":"GrantPermissionRequest","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest","url":"\/documentation\/axiamsdk\/grantpermissionrequest","kind":"symbol","navigatorTitle":[{"text":"GrantPermissionRequest","kind":"identifier"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest/effect":{"url":"\/documentation\/axiamsdk\/grantpermissionrequest\/effect","type":"topic","abstract":[{"text":"B1: ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":" (the default) or ","type":"text"},{"code":"\"deny\"","type":"codeVoice"},{"text":". A deny grant ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"overrides every allow"}]},{"text":", at any","type":"text"},{"text":" ","type":"text"},{"text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"text":" for the precedence table and for why that trade","type":"text"},{"text":" ","type":"text"},{"text":"was made. Omitting the field means ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":", so every existing client keeps working","type":"text"},{"text":" ","type":"text"},{"text":"unchanged and no migration is required.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect","title":"effect","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO"},{"kind":"text","text":"?"}]}}}