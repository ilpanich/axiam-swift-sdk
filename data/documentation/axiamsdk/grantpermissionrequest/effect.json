{"abstract":[{"text":"B1: ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":" (the default) or ","type":"text"},{"code":"\"deny\"","type":"codeVoice"},{"text":". A deny grant ","type":"text"},{"inlineContent":[{"type":"text","text":"overrides every allow"}],"type":"strong"},{"type":"text","text":", at any"},{"type":"text","text":" "},{"type":"text","text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" for the precedence table and for why that trade"},{"type":"text","text":" "},{"type":"text","text":"was made. Omitting the field means "},{"type":"codeVoice","code":"\"allow\""},{"text":", so every existing client keeps working","type":"text"},{"text":" ","type":"text"},{"text":"unchanged and no migration is required.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","kind":"typeIdentifier","text":"PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest"]]},"metadata":{"role":"symbol","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Property","symbolKind":"property","title":"effect","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":