{"abstract":[{"type":"text","text":"B1: "},{"type":"codeVoice","code":"\"allow\""},{"type":"text","text":" (the default) or "},{"code":"\"deny\"","type":"codeVoice"},{"type":"text","text":". A deny grant "},{"type":"strong","inlineContent":[{"text":"overrides every allow","type":"text"}]},{"type":"text","text":", at any"},{"type":"text","text":" "},{"type":"text","text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins."},{"type":"text","text":" "},{"type":"text","text":"See "},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"type":"text","text":" for the precedence table and for why that trade"},{"type":"text","text":" "},{"type":"text","text":"was made. Omitting the field means "},{"code":"\"allow\"","type":"codeVoice"},{"type":"text","text":", so every existing client keeps working"},{"type":"text","text":" "},{"type":"text","text":"unchanged and no migration is required."}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect"},"sections":[],"metadata":{"externalID":"s:8AxiamSDK22GrantPermissionRequestV6effectAA0D6EffectOSgvp","symbolKind":"property","modules":[{"name":"AxiamSDK"}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"effect","kind":"identifier"},{"text":": ","kind":"text"},{"text":"PermissionEffect","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO"},{"text":"?","kind":"text"}],"title":"effect","roleHeading":"Instance Property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"effect","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PermissionEffect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO"},{"kind":"text","text":"?"}],"platforms":["Linux"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/grantpermissionrequest\/effect"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"url":"\/documentation\/axiamsdk\/permissioneffect","kind":"symbol","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"inlineContent":[{"type":"text","text":"and beats every allow"}],"type":"strong"},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}],"type":"strong"},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}],"title":"PermissionEffect","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest/effect":{"type":"topic","title":"effect","abstract":[{"type":"text","text":"B1: "},{"code":"\"allow\"","type":"codeVoice"},{"type":"text","text":" (the default) or "},{"code":"\"deny\"","type":"codeVoice"},{"type":"text","text":". A deny grant "},{"inlineContent":[{"type":"text","text":"overrides every allow"}],"type":"strong"},{"type":"text","text":", at any"},{"type":"text","text":" "},{"type":"text","text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins."},{"type":"text","text":" "},{"type":"text","text":"See "},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"type":"text","text":" for the precedence table and for why that trade"},{"type":"text","text":" "},{"type":"text","text":"was made. Omitting the field means "},{"code":"\"allow\"","type":"codeVoice"},{"type":"text","text":", so every existing client keeps working"},{"type":"text","text":" "},{"type":"text","text":"unchanged and no migration is required."}],"role":"symbol","url":"\/documentation\/axiamsdk\/grantpermissionrequest\/effect","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"effect","kind":"identifier"},{"text":": ","kind":"text"},{"text":"PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","kind":"ty