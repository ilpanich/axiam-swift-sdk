{"kind":"symbol","abstract":[{"text":"B1: ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":" (the default) or ","type":"text"},{"code":"\"deny\"","type":"codeVoice"},{"text":". A deny grant ","type":"text"},{"inlineContent":[{"text":"overrides every allow","type":"text"}],"type":"strong"},{"text":", at any","type":"text"},{"text":" ","type":"text"},{"text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"text":" for the precedence table and for why that trade","type":"text"},{"text":" ","type":"text"},{"text":"was made. Omitting the field means ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":", so every existing client keeps working","type":"text"},{"text":" ","type":"text"},{"text":"unchanged and no migration is required.","type":"text"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/grantpermissionrequest\/effect"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"effect","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","text":"PermissionEffect","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO"},{"text":"?","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect"},"metadata":{"roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"title":"effect","symbolKind":"property","externalID":"s:8AxiamSDK22GrantPermissionRequestV6effectAA0D6EffectOSgvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","text":"PermissionEffect"},{"kind":"text","text":"?"}],"role":"symbol"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest":{"abstract":[{"type":"text","text":"The "},{"code":"GrantPermissionRequest","type":"codeVoice"},{"type":"text","text":" schema."}],"title":"GrantPermissionRequest","navigatorTitle":[{"text":"GrantPermissionRequest","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"GrantPermissionRequest","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/grantpermissionrequest","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest/effect":{"kind":"symbol","url":"\/documentation\/axiamsdk\/grantpermissionrequest\/effect","abstract":[{"text":"B1: ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":" (the default) or ","type":"text"},{"code":"\"deny\"","type":"codeVoice"},{"text":". A deny grant ","type":"text"},{"inlineContent":[{"type":"text","text":"overrides every allow"}],"type":"strong"},{"text":", at any","type":"text"},{"text":" ","type":"text"},{"text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"text":" for the precedence table and for why that trade","type":"text"},{"text":" ","type":"text"},{"text":"was made. Omitting the field means ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":", so every existing client keeps working","type":"text"},{"text":" ","type":"text"},{"text":"unchanged and no migration is required.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","kind":"typeIdentifier","text":"PermissionEffect"},{"kind":"text","text":"?"}],"type":"topic","title":"effect","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"title":"PermissionEffect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"text":"] grant permits -> a [","type":"text"},{"code":"PermissionEffect::Deny","type":"codeVoice"},{"text":"] grant","type":"text"},{"text":" ","type":"text"},{"text":"refuses, ","type":"text"},{"inlineContent":[{"type":"text","text":"and beats every allow"}],"type":"strong"},{"text":", wherever either sits in the resource hierarchy. Deny","type":"text"},{"text":" ","type":"text"},{"text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"code":"effect","type":"codeVoice"},{"type":"text","text":", both mean “allow”. No migration."}],"url":"\/documentation\/axiamsdk\/permissioneffect","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"type":"topic"}}}