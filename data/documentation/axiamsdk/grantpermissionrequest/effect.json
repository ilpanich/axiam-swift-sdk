{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest"]]},"abstract":[{"type":"text","text":"B1: "},{"code":"\"allow\"","type":"codeVoice"},{"type":"text","text":" (the default) or "},{"code":"\"deny\"","type":"codeVoice"},{"type":"text","text":". A deny grant "},{"inlineContent":[{"type":"text","text":"overrides every allow"}],"type":"strong"},{"type":"text","text":", at any"},{"type":"text","text":" "},{"type":"text","text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins."},{"type":"text","text":" "},{"text":"See ","type":"text"},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"text":" for the precedence table and for why that trade","type":"text"},{"text":" ","type":"text"},{"text":"was made. Omitting the field means ","type":"text"},{"code":"\"allow\"","type":"codeVoice"},{"text":", so every existing client keeps working","type":"text"},{"text":" ","type":"text"},{"text":"unchanged and no migration is required.","type":"text"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/grantpermissionrequest\/effect"]}],"metadata":{"modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK22GrantPermissionRequestV6effectAA0D6EffectOSgvp","role":"symbol","title":"effect","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","kind":"typeIdentifier","text":"PermissionEffect"},{"kind":"text","text":"?"}],"roleHeading":"Instance Property","symbolKind":"property"},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"effect","kind":"identifier"},{"text":": ","kind":"text"},{"text":"PermissionEffect","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"},{"text":"?","kind":"text"}]}],"kind":"declarations"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"url":"\/documentation\/axiamsdk\/permissioneffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"inlineContent":[{"type":"text","text":"and beats every allow"}],"type":"strong"},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}],"type":"strong"},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"code":"effect","type":"codeVoice"},{"type":"text","text":", both mean “allow”. No migration."}],"navigatorTitle":[{"text":"PermissionEffect","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","title":"PermissionEffect","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest":{"type":"topic","url":"\/documentation\/axiamsdk\/grantpermissionrequest","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"GrantPermissionRequest"}],"title":"GrantPermissionRequest","kind":"symbol","abstract":[{"type":"text","text":"The "},{"code":"GrantPermissionRequest","type":"codeVoice"},{"text":" schema.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"GrantPermissionRequest"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest/effect":{"type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"effect","kind":"identifier"},{"text":": ","kind":"text"},{"text":"PermissionEffect","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO"},{"text":"?","kind":"text"}],"abstract":[{"text":"B1: ","type":"text"},{"type":"codeVoice","code":"\"allow\""},{"text":" (the default) or ","type":"text"},{"type":"codeVoice","code":"\"deny\""},{"text":". A deny grant ","type":"text"},{"inlineContent":[{"text":"overrides every allow","type":"text"}],"type":"strong"},{"text":", at any","type":"text"},{"text":" ","type":"text"},{"text":"depth of the resource hierarchy and at equal specificity — it is not most-specific-wins.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"text":" for the precedence table and for why that trade","type":"text"},{"text":" ","type":"text"},{"text":"was made. Omitting the field means ","type":"text"},{"type":"codeVoice","code":"\"allow\""},{"text":", so every existing client keeps working","type":"text"},{"text":" ","type":"text"},{"text":"unchanged and no migration is required.","type":"text"}],"kind":"symbol","title":"effect","url":"\/documentation\/axiamsdk\/grantpermissionrequest\/effect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/effect"}}}