\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest"]]},"sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/init(effect:permissionID:scopeIds:)","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest":{"role":"symbol","url":"\/documentation\/axiamsdk\/grantpermissionrequest","abstract":[{"type":"text","text":"The "},{"code":"GrantPermissionRequest","type":"codeVoice"},{"type":"text","text":" schema."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GrantPermissionRequest"}],"navigatorTitle":[{"kind":"identifier","text":"GrantPermissionRequest"}],"title":"GrantPermissionRequest","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GrantPermissionRequest/init(effect:permissionID:scopeIds:)":{"role":"symbol","type":"topic","abstract":[],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"effect"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","kind":"typeIdentifier","text":"PermissionEffect"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"permissionID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scopeIds"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]?)"}],"title":"init(effect:permissionID:scopeIds:)","url":"\/documentation\/axiamsdk\/grantpermissionrequest\/init(effect:permissionid:scopeids:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantPermissionRequest\/init(effect:permissionID:scopeIds:)","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] grant permits -> a ["},{"code":"PermissionEffect::Deny","type":"codeVoice"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"type":"strong","inlineContent":[{"type":"text","text":"and beats every allow"}]},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"adding allows"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"code":"effect","type":"codeVoice"},{"type":"text","text":", both mean “allow”. No migration."}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"PermissionEffect","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}],"title":"PermissionEffect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","url":"\/documentation\/axiamsdk\/permissioneffect"}}}