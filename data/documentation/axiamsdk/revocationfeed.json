{"metadata":{"navigatorTitle":[{"kind":"identifier","text":"RevocationFeed"}],"symbolKind":"class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RevocationFeed"}],"title":"RevocationFeed","modules":[{"name":"AxiamSDK"}],"roleHeading":"Class","externalID":"s:8AxiamSDK14RevocationFeedC","role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/effectivePollInterval","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/feedURL"],"title":"Instance Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/isRevoked(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/refresh()"],"title":"Instance Methods"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/defaultPollInterval","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/feedPath","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/maxEntries","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/minPollInterval"],"title":"Type Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/entry(for:)"],"title":"Type Methods"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/Actor-Implementations"],"title":"Default Implementations","generated":true}],"kind":"symbol","abstract":[{"text":"The optional session-revocation feed poller (CONTRACT.md §10.4, contract 1.44 — AXIAM","type":"text"},{"text":" ","type":"text"},{"text":"threats T-39 and T-143).","type":"text"}],"variants":[{"paths":["\/documentation\/axiamsdk\/revocationfeed"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/ScA","doc:\/\/AxiamSDK\/12_Concurrency8AnyActorP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RevocationFeed","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"What this narrows, and what it is not","anchor":"What-this-narrows-and-what-it-is-not","type":"heading"},{"inlineContent":[{"text":"An AXIAM access token is self-contained and valid for up to fifteen minutes, and this SDK","type":"text"},{"text":" ","type":"text"},{"text":"verifies it locally. A logout, a role removal or an account disable therefore does not","type":"text"},{"text":" ","type":"text"},{"text":"reach a token already in a caller’s hands until it expires — §10.2 records that, and the","type":"text"},{"text":" ","type":"text"},{"text":"documented answer has been “route the decision through gRPC introspection instead”, which","type":"text"},{"text":" ","type":"text"},{"text":"is correct and costs a round trip ","type":"text"},{"inlineContent":[{"type":"text","text":"per request"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A deployment may publish ","type":"text"},{"code":"GET \/oauth2\/revocations","type":"codeVoice"},{"text":": the base64url-unpadded SHA-256 of","type":"text"},{"text":" ","type":"text"},{"text":"every session id revoked within the last access-token lifetime. A guard that polls it","type":"text"},{"text":" ","type":"text"},{"text":"rejects a revoked session within ","type":"text"},{"type":"strong","inlineContent":[{"text":"one poll interval","type":"text"}]},{"text":" instead of one token lifetime, for","type":"text"},{"text":" ","type":"text"},{"text":"one cacheable fetch per interval.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is NOT a control, and every rule below follows from that:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Default off.","type":"text"}],"type":"strong"},{"type":"text","text":" Nothing polls unless a caller constructs one and attaches it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Never on the request path."}]},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed\/isRevoked(_:)"},{"text":" answers from the cached set and, at","type":"text"},{"text":" ","type":"text"},{"text":"most, refreshes a set the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"next"}]},{"text":" caller sees.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Never fail closed."}]},{"type":"text","text":" An unreachable feed, a non-"},{"code":"200","type":"codeVoice"},{"type":"text","text":", a body that does not parse, an"},{"type":"text","text":" "},{"code":"alg","type":"codeVoice"},{"type":"text","text":" this build does not know — every one of them behaves exactly as no feed at all."},{"type":"text","text":" "},{"type":"text","text":"Not as an empty list: an empty list asserts that nothing has been revoked, which is a"},{"type":"text","text":" "},{"type":"text","text":"guard that silently honours no revocations while appearing to honour them."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"It only ever rejects."}],"type":"strong"},{"text":" Every §10.1 rule runs first and still decides. The feed can","type":"text"},{"text":" ","type":"text"},{"text":"turn an accept into a reject and never the reverse.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"A token with no ","type":"text"},{"type":"codeVoice","code":"sid"},{"text":" is never matched.","type":"text"}]},{"type":"text","text":" There is no session behind a"},{"type":"text","text":" "},{"type":"text","text":"client-credentials token, an RPT or a token exchange, and hashing "},{"type":"codeVoice","code":"jti"},{"type":"text","text":" instead would"},{"type":"text","text":" "},{"type":"text","text":"match nothing while looking like it worked."}]}]}]},{"inlineContent":[{"text":"An ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":", so one instance can be shared across guards and they poll once between them","type":"text"},{"text":" ","type":"text"},{"text":"rather than once each. Callers do not build one directly: set","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/revocationFeedEnabled","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","type":"reference"},{"text":" wires it to the same transport","type":"text"},{"text":" ","type":"text"},{"text":"every other call already uses.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RevocationFeed"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/RevocationFeed/entry(for:)":{"type":"topic","url":"\/documentation\/axiamsdk\/revocationfeed\/entry(for:)","fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"entry","kind":"identifier"},{"kind":"text","text":"("},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"title":"entry(for:)","kind":"symbol","abstract":[{"text":"The feed entry for a ","type":"text"},{"type":"codeVoice","code":"sid"},{"type":"text","text":", as the server computes 