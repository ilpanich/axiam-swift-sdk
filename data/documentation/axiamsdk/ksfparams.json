{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/ksfparams"]}],"abstract":[{"type":"text","text":"The key-stretching function and cost a "},{"type":"codeVoice","code":"\/start"},{"type":"text","text":" response names (CONTRACT.md §23.4)."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/init(ksf:memoryKib:iterations:parallelism:logN:r:p:)"]},{"title":"Instance Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/iterations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/ksf","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/logN","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/memoryKib","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/p","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/parallelism","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/r"]},{"title":"Type Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/argon2id","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/scrypt"]},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/Equatable-Implementations"]}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/s8SendableP"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"metadata":{"modules":[{"name":"AxiamSDK"}],"symbolKind":"struct","title":"KsfParams","roleHeading":"Structure","role":"symbol","navigatorTitle":[{"text":"KsfParams","kind":"identifier"}],"externalID":"s:8AxiamSDK9KsfParamsV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KsfParams","kind":"identifier"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KsfParams","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The cost properties are optional on purpose: they arrive flat, and a field that does not apply","type":"text"},{"text":" ","type":"text"},{"text":"to the named function is ","type":"text"},{"inlineContent":[{"type":"text","text":"absent, not zero"}],"type":"strong"},{"text":". Reading a missing ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/memoryKib"},{"text":" as ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" would","type":"text"},{"text":" ","type":"text"},{"text":"stretch at the wrong cost and fail against a record that is perfectly good (§23.4 rule 5).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are never cached across exchanges and never defaulted locally. A credential enrolled"},{"type":"text","text":" "},{"type":"text","text":"under one cost keeps working after a tenant raises its policy, so a client that guessed would"},{"type":"text","text":" "},{"type":"text","text":"derive a different randomized password and report “invalid password” for one that is entirely"},{"type":"text","text":" "},{"type":"text","text":"correct (§23.4 rule 2)."}]},{"type":"heading","anchor":"This-is-where-Swift-stopped-needing-a-pbkdf2sha256-tenant","text":"This is where Swift stopped needing a `pbkdf2_sha256` tenant","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SRP client this replaces refused an "},{"code":"argon2id","type":"codeVoice"},{"type":"text","text":" tenant outright: Swift has no Argon2 that"},{"type":"text","text":" "},{"type":"text","text":"ships