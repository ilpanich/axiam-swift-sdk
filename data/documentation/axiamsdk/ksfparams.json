{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/ksfparams"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams"},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/init(ksf:memoryKib:iterations:parallelism:logN:r:p:)"],"title":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/iterations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/ksf","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/logN","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/memoryKib","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/p","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/parallelism","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/r"],"title":"Instance Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/argon2id","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/scrypt"],"title":"Type Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/Equatable-Implementations"],"title":"Default Implementations","generated":true}],"metadata":{"role":"symbol","navigatorTitle":[{"text":"KsfParams","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:8AxiamSDK9KsfParamsV","modules":[{"name":"AxiamSDK"}],"title":"KsfParams","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KsfParams","kind":"identifier"}],"symbolKind":"struct"},"kind":"symbol","abstract":[{"text":"The key-stretching function and cost a ","type":"text"},{"code":"\/start","type":"codeVoice"},{"text":" response names (CONTRACT.md §23.4).","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/s8SendableP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KsfParams","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The cost properties are optional on purpose: they arrive flat, and a field that does not apply"},{"type":"text","text":" "},{"type":"text","text":"to the named function is "},{"type":"strong","inlineContent":[{"text":"absent, not zero","type":"text"}]},{"type":"text","text":". Reading a missing "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/memoryKib"},{"type":"text","text":" as "},{"type":"codeVoice","code":"0"},{"type":"text","text":" would"},{"type":"text","text":" "},{"type":"text","text":"stretch at the wrong cost and fail against a record that is perfectly good (§23.4 rule 5)."}],"type":"paragraph"},{"inlineContent":[{"text":"These are never cached across exchanges and never defaulted locally. A credential enrolled","type":"text"},{"text":" ","type":"text"},{"text":"under one cost keeps working after a tenant raises its policy, so a client that guessed would","type":"text"},{"text":" ","type":"text"},{"text":"derive a different randomized password and report “invalid password” for one that is entirely","type":"text"},{"text":" ","type":"text"},{"text":"correct (§23.4 rule 2).","type":"text"}],"type":"paragraph"},{"text":"This is where Swift stopped needing a `pbkdf2_sha256` tenant","level":2,"anchor":"This-is-where-Swift-stopped-needing-a-pbkdf2sha256-tenant","type":"heading"},{"inlineContent":[{"type":"text","text":"The SRP client this replaces refused an "},{"code":"argon2id","type":"codeVoice"},{"type":"text","text":" tenant outright: Swift has no Argon2 that"},{"type":"text","text":" "},{"type":"text","text":"ships on every supported platform, and substituting PBKDF2 would have derived a different "},{"code":"x","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and surfaced as “invalid password”. AXIAM’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":" KDF was, for Swift, unreachable. The key"},{"type":"text","text":" "},{"type":"text","text":"stretching now happens inside "},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"type":"text","text":", so "},{"code":"argon2id","type":"codeVoice"},{"type":"text","text":" is no longer a Swift-shaped"},{"type":"text","text":" "},{"type":"text","text":"hole — and "},{"code":"pbkdf2_sha256","type":"codeVoice"},{"type":"text","text":" is not an OPAQUE key-stretching function at all."}],"type":"paragraph"}]}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/KsfParams/init(ksf:memoryKib:iterations:parallelism:logN:r:p:)":{"url":"\/documentation\/axiamsdk\/ksfparams\/init(ksf:memorykib:iterations:parallelism:logn:r:p:)","title":"init(ksf:memoryKib:iterations:parallelism:logN:r:p:)","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/init(ksf:memoryKib:iterations:parallelism:logN:r:p:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ksf","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"memoryKib","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"parallelism"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?, "},{"kind":"e