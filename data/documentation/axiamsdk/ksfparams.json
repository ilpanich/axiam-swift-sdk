{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KsfParams","kind":"identifier"}]}]},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cost properties are optional on purpose: they arrive flat, and a field that does not apply"},{"type":"text","text":" "},{"type":"text","text":"to the named function is "},{"type":"strong","inlineContent":[{"type":"text","text":"absent, not zero"}]},{"type":"text","text":". Reading a missing "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/memoryKib","isActive":true},{"type":"text","text":" as "},{"type":"codeVoice","code":"0"},{"type":"text","text":" would"},{"type":"text","text":" "},{"type":"text","text":"stretch at the wrong cost and fail against a record that is perfectly good (§23.4 rule 5)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are never cached across exchanges and never defaulted locally. A credential enrolled"},{"type":"text","text":" "},{"type":"text","text":"under one cost keeps working after a tenant raises its policy, so a client that guessed would"},{"type":"text","text":" "},{"type":"text","text":"derive a different randomized password and report “invalid password” for one that is entirely"},{"type":"text","text":" "},{"type":"text","text":"correct (§23.4 rule 2)."}]},{"type":"heading","anchor":"This-is-where-Swift-stopped-needing-a-pbkdf2sha256-tenant","text":"This is where Swift stopped needing a `pbkdf2_sha256` tenant","level":2},{"type":"paragraph","inlineContent":[{"text":"The SRP client this replaces refused an ","type":"text"},{"code":"argon2id","type":"codeVoice"},{"text":" tenant outright: Swift has no Argon2 that","type":"text"},{"text":" ","type":"text"},{"text":"ships on every supported platform, and substituting PBKDF2 would have derived a different ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and surfaced as “invalid password”. AXIAM’s ","type":"text"},{"inlineContent":[{"text":"default","type":"text"}],"type":"emphasis"},{"text":" KDF was, for Swift, unreachable. The key","type":"text"},{"text":" ","type":"text"},{"text":"stretching now happens inside ","type":"text"},{"code":"libaxiam_opaque_ffi","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"argon2id","type":"codeVoice"},{"text":" is no longer a Swift-shaped","type":"text"},{"text":" ","type":"text"},{"text":"hole — and ","type":"text"},{"code":"pbkdf2_sha256","type":"codeVoice"},{"text":" is not an OPAQUE key-stretching function at all.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"The key-stretching function and cost a ","type":"text"},{"type":"codeVoice","code":"\/start"},{"text":" response names (CONTRACT.md §23.4).","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/ksfparams"]}],"metadata":{"symbolKind":"struct","externalID":"s:8AxiamSDK9KsfParamsV","modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"text":"KsfParams","kind":"identifier"}],"role":"symbol","roleHeading":"Structure","title":"KsfParams","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"KsfParams","kind":"identifier"}]},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/init(ksf:memoryKib:iterations:parallelism:logN:r:p:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/iterations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/ksf","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/logN","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/memoryKib","doc:\/\/AxiamSDK\/documentation\/Axiam