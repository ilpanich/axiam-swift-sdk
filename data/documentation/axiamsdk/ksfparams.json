{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/ksfparams"]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/s8SendableP"],"kind":"relationships","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"abstract":[{"type":"text","text":"The key-stretching function and cost a "},{"code":"\/start","type":"codeVoice"},{"type":"text","text":" response names (CONTRACT.md §23.4)."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"KsfParams"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cost properties are optional on purpose: they arrive flat, and a field that does not apply"},{"type":"text","text":" "},{"type":"text","text":"to the named function is "},{"inlineContent":[{"text":"absent, not zero","type":"text"}],"type":"strong"},{"type":"text","text":". Reading a missing "},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/memoryKib","isActive":true},{"type":"text","text":" as "},{"code":"0","type":"codeVoice"},{"type":"text","text":" would"},{"type":"text","text":" "},{"type":"text","text":"stretch at the wrong cost and fail against a record that is perfectly good (§23.4 rule 5)."}]},{"type":"paragraph","inlineContent":[{"text":"These are never cached across exchanges and never defaulted locally. A credential enrolled","type":"text"},{"text":" ","type":"text"},{"text":"under one cost keeps working after a tenant raises its policy, so a client that guessed would","type":"text"},{"text":" ","type":"text"},{"text":"derive a different randomized password and report “invalid pas