[{"text":"The cost properties are optional on purpose: they arrive flat, and a field that does not apply","type":"text"},{"text":" ","type":"text"},{"text":"to the named function is ","type":"text"},{"inlineContent":[{"type":"text","text":"absent, not zero"}],"type":"strong"},{"text":". Reading a missing ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/memoryKib","type":"reference"},{"text":" as ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" would","type":"text"},{"text":" ","type":"text"},{"text":"stretch at the wrong cost and fail against a record that is perfectly good (§23.4 rule 5).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"These are never cached across exchanges and never defaulted locally. A credential enrolled","type":"text"},{"text":" ","type":"text"},{"text":"under one cost keeps working after a tenant raises its policy, so a client that guessed would","type":"text"},{"text":" ","type":"text"},{"text":"derive a different randomized password and report “invalid password” for one that is entirely","type":"text"},{"text":" ","type":"text"},{"text":"correct (§23.4 rule 2).","type":"text"}],"type":"paragraph"},{"level":2,"text":"This is where Swift stopped needing a `pbkdf2_sha256` tenant","anchor":"This-is-where-Swift-stopped-needing-a-pbkdf2sha256-tenant","type":"heading"},{"inlineContent":[{"text":"The SRP client this replaces refused an ","type":"text"},{"type":"codeVoice","code":"argon2id"},{"text":" tenant outright: Swift has no Argon2 that","type":"text"},{"text":" ","type":"text"},{"text":"ships on every supported platform, and substituting PBKDF2 would have derived a different ","type":"text"},{"type":"codeVoice","code":"x"},{"text":" ","type":"text"},{"text":"and surfaced as “invalid password”. AXIAM’s ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"text":" KDF was, for Swift, unreachable. The key","type":"text"},{"text":" ","type":"text"},{"text":"stretching now happens inside ","type":"text"},{"type":"codeVoice","code":"libaxiam_opaque_ffi"},{"text":", so ","type":"text"},{"type":"codeVoice","code":"argon2id"},{"text":" is no longer a Swift-shaped","type":"text"},{"text":" ","type":"text"},{"text":"hole — and ","type":"text"},{"type":"codeVoice","code":"pbkdf2_sha256"},{"text":" is not an OPAQUE key-stretching function at all.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KsfParams","kind":"identifier"}],"navigatorTitle":[{"text":"KsfParams","kind":"identifier"}],"role":"symbol","externalID":"s:8AxiamSDK9KsfParamsV","title":"KsfParams","roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"AxiamSDK"}]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/KsfParams/parallelism":{"role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams\/parallelism","url":"\/documentation\/axiamsdk\/ksfparams\/parallelism","kind":"symbol","title":"parallelism","abstract":[{"type":"text","text":"Argon2id’s lane count."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"parallelism"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/documentation/AxiamSDK/KsfParams":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/KsfParams","navigatorTitle":[{"kind":"identifier","text":"KsfParams"}],"url":"\/documentation\/axiamsdk\/ksfparams","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"KsfParams"}],"title":"KsfParams","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The key-stretching function and cost a "},{"type":"codeVoice","code":"\/start"},{"type":"text","text":" response names (CONTRACT.md §23.4)."}]},"doc://AxiamSDK