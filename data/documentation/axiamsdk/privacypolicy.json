kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"title":"deletionGracePeriodDays","kind":"symbol","abstract":[{"type":"text","text":"How long a requested account erasure stays cancellable before the purge runs, in days."},{"type":"text","text":" "},{"type":"text","text":"The window exists so an erasure triggered by mistake, or under coercion, can be undone —"},{"type":"text","text":" "},{"code":"POST \/api\/v1\/auth\/account\/delete\/cancel","type":"codeVoice"},{"type":"text","text":" works for exactly this long. It was fixed at"},{"type":"text","text":" "},{"type":"text","text":"30 days in the handler, which meant the “cancel a pending deletion” control in the admin"},{"type":"text","text":" "},{"type":"text","text":"UI referred to a duration no operator could see or change. Shorter is the more"},{"type":"text","text":" "},{"type":"text","text":"restrictive direction, so a tenant may lower it and not raise it: it is time spent"},{"type":"text","text":" "},{"type":"text","text":"holding data the subject has already asked to have erased, and GDPR Art. 17(1) asks for"},{"type":"text","text":" "},{"type":"text","text":"that to be “without undue delay”. The upper bound of 90 days is where Art. 12(3)’s"},{"type":"text","text":" "},{"type":"text","text":"one-month response deadline plus its two-month extension for complex cases runs out;"},{"type":"text","text":" "},{"type":"text","text":"anything past 30 wants a reason recorded."}],"url":"\/documentation\/axiamsdk\/privacypolicy\/deletiongraceperioddays","role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/init(deletionGracePeriodDays:)":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/init(deletionGracePeriodDays:)","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"deletionGracePeriodDays","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"title":"init(deletionGracePeriodDays:)","url":"\/documentation\/axiamsdk\/privacypolicy\/init(deletiongraceperioddays:)","type":"topic","abstract":[]},"doc://AxiamSDK/SE":{"title":"Swift.Encodable","type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/SE"},"doc://AxiamSDK/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/AxiamSDK\/s8SendableP","type":"unresolvable"},"doc://AxiamSDK/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/s16SendableMetatypeP"},"doc://AxiamSDK/Se":{"title":"Swift.Decodable","identifier":"doc:\/\/AxiamSDK\/Se","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}