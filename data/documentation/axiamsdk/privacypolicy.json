ier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy","abstract":[{"type":"text","text":"Data-retention rules that apply after a subject asks to be erased."}],"kind":"symbol","url":"\/documentation\/axiamsdk\/privacypolicy","title":"PrivacyPolicy"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/init(from:)":{"url":"\/documentation\/axiamsdk\/privacypolicy\/init(from:)","type":"topic","role":"symbol","abstract":[],"title":"init(from:)","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/init(from:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"text":"Decoder","preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/encode(to:)":{"title":"encode(to:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/encode(to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7EncoderP","text":"Encoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"url":"\/documentation\/axiamsdk\/privacypolicy\/encode(to:)","role":"symbol","kind":"symbol","abstract":[],"type":"topic"},"doc://AxiamSDK/SE":{"title":"Swift.Encodable","identifier":"doc:\/\/AxiamSDK\/SE","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/deletionGracePeriodDays":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deletionGracePeriodDays","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/deletionGracePeriodDays","abstract":[{"type":"text","text":"How long a requested account erasure stays cancellable before the purge runs, in days."},{"text":" ","type":"text"},{"text":"The window exists so an erasure triggered by mistake, or under coercion, can be undone —","type":"text"},{"text":" ","type":"text"},{"code":"POST \/api\/v1\/auth\/account\/delete\/cancel","type":"codeVoice"},{"text":" works for exactly this long. It was fixed at","type":"text"},{"text":" ","type":"text"},{"text":"30 days in the handler, which meant the “cancel a pending deletion” control in the admin","type":"text"},{"text":" ","type":"text"},{"text":"UI referred to a duration no operator could see or change. Shorter is the more","type":"text"},{"text":" ","type":"text"},{"text":"restrictive direction, so a tenant may lower it and not raise it: it is time spent","type":"text"},{"text":" ","type":"text"},{"text":"holding data the subject has already asked to have erased, and GDPR Art. 17(1) asks for","type":"text"},{"text":" ","type":"text"},{"text":"that to be “without undue delay”. The upper bound of 90 days is where Art. 12(3)’s","type":"text"},{"text":" ","type":"text"},{"text":"one-month response deadline plus its two-month extension for complex cases runs out;","type":"text"},{"text":" ","type":"text"},{"text":"anything past 30 wants a reason recorded.","type":"text"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/privacypolicy\/deletiongraceperioddays","title":"deletionGracePeriodDays"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/init(deletionGracePeriodDays:)":{"abstract":[],"role":"symbol","url":"\/documentation\/axiamsdk\/privacypolicy\/init(deletiongraceperioddays:)","type":"topic","kind":"symbol","title":"init(deletionGracePeriodDays:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/init(deletionGracePeriodDays:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"deletionGracePeriodDa