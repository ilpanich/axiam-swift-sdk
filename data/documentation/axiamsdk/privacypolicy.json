vacyPolicy","kind":"identifier"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/deletionGracePeriodDays":{"kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/deletionGracePeriodDays","abstract":[{"text":"How long a requested account erasure stays cancellable before the purge runs, in days.","type":"text"},{"text":" ","type":"text"},{"text":"The window exists so an erasure triggered by mistake, or under coercion, can be undone —","type":"text"},{"text":" ","type":"text"},{"code":"POST \/api\/v1\/auth\/account\/delete\/cancel","type":"codeVoice"},{"text":" works for exactly this long. It was fixed at","type":"text"},{"text":" ","type":"text"},{"text":"30 days in the handler, which meant the “cancel a pending deletion” control in the admin","type":"text"},{"text":" ","type":"text"},{"text":"UI referred to a duration no operator could see or change. Shorter is the more","type":"text"},{"text":" ","type":"text"},{"text":"restrictive direction, so a tenant may lower it and not raise it: it is time spent","type":"text"},{"text":" ","type":"text"},{"text":"holding data the subject has already asked to have erased, and GDPR Art. 17(1) asks for","type":"text"},{"text":" ","type":"text"},{"text":"that to be “without undue delay”. The upper bound of 90 days is where Art. 12(3)’s","type":"text"},{"text":" ","type":"text"},{"text":"one-month response deadline plus its two-month extension for complex cases runs out;","type":"text"},{"text":" ","type":"text"},{"text":"anything past 30 wants a reason recorded.","type":"text"}],"url":"\/documentation\/axiamsdk\/privacypolicy\/deletiongraceperioddays","title":"deletionGracePeriodDays","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"deletionGracePeriodDays"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]},"doc://AxiamSDK/documentation/AxiamSDK/Pri