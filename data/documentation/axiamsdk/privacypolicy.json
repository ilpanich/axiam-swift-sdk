","text":" "},{"code":"POST \/api\/v1\/auth\/account\/delete\/cancel","type":"codeVoice"},{"type":"text","text":" works for exactly this long. It was fixed at"},{"text":" ","type":"text"},{"text":"30 days in the handler, which meant the “cancel a pending deletion” control in the admin","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"UI referred to a duration no operator could see or change. Shorter is the more"},{"text":" ","type":"text"},{"text":"restrictive direction, so a tenant may lower it and not raise it: it is time spent","type":"text"},{"type":"text","text":" "},{"text":"holding data the subject has already asked to have erased, and GDPR Art. 17(1) asks for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that to be “without undue delay”. The upper bound of 90 days is where Art. 12(3)’s"},{"text":" ","type":"text"},{"type":"text","text":"one-month response deadline plus its two-month extension for complex cases runs out;"},{"text":" ","type":"text"},{"text":"anything past 30 wants a reason recorded.","type":"text"}],"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deletionGracePeriodDays","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy":{"url":"\/documentation\/axiamsdk\/privacypolicy","abstract":[{"text":"Data-retention rules that apply after a subject asks to be erased.","type":"text"}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PrivacyPolicy"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy","navigatorTitle":[{"kind":"identifier","text":"PrivacyPolicy"}],"kind":"symbol","title":"PrivacyPolicy"},"doc://AxiamSDK/SE":{"identifier":"doc:\/\/AxiamSDK\/SE","title":"Swift.Encodable","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK/Pri