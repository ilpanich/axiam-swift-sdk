act":[{"text":"Data-retention rules that apply after a subject asks to be erased.","type":"text"}],"url":"\/documentation\/axiamsdk\/privacypolicy","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy","title":"PrivacyPolicy","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/Se":{"identifier":"doc:\/\/AxiamSDK\/Se","title":"Swift.Decodable","type":"unresolvable"},"doc://AxiamSDK/SE":{"identifier":"doc:\/\/AxiamSDK\/SE","title":"Swift.Encodable","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/deletionGracePeriodDays":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/deletionGracePeriodDays","kind":"symbol","url":"\/documentation\/axiamsdk\/privacypolicy\/deletiongraceperioddays","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deletionGracePeriodDays","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"abstract":[{"text":"How long a requested account erasure stays cancellable before the purge runs, in days.","type":"text"},{"text":" ","type":"text"},{"text":"The window exists so an erasure triggered by mistake, or under coercion, can be undone —","type":"text"},{"text":" ","type":"text"},{"code":"POST \/api\/v1\/auth\/account\/delete\/cancel","type":"codeVoice"},{"text":" works for exactly this long. It was fixed at","type":"text"},{"text":" ","type":"text"},{"text":"30 days in the handler, which meant the “cancel a pending deletion” control in the admin","type":"text"},{"text":" ","type":"text"},{"text":"UI referred to a duration no operator could see or change. Shorter is the more","type":"text"},{"text":" ","type":"text"},{"text":"restrictive direction, so a tenant may lower it and not raise it: it is time spent","type":"text"},{"text":" ","type":"text"},{"text":"holding data the subject has already asked to have erased, and GDPR Art. 17(1) asks for","type":"text"},{"text":" ","type":"text"},{"text":"that to be “without undue delay”. The upper bound of 90 days is where Art. 12(3)’s","type":"text"},{"text":" ","type":"text"},{"text":"one-month response deadline plus its two-month extension for complex cases runs out;","type":"text"},{"text":" ","type":"text"},{"text":"anything past 30 wants a reason recorded.","type":"text"}],"title":"deletionGracePeriodDays","type":"topic"}}}