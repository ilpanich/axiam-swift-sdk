DK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/s16SendableMetatypeP"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/deletionGracePeriodDays":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/deletionGracePeriodDays","title":"deletionGracePeriodDays","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"How long a requested account erasure stays cancellable before the purge runs, in days."},{"type":"text","text":" "},{"type":"text","text":"The window exists so an erasure triggered by mistake, or under coercion, can be undone —"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/api\/v1\/auth\/account\/delete\/cancel"},{"type":"text","text":" works for exactly this long. It was fixed at"},{"type":"text","text":" "},{"type":"text","text":"30 days in the handler, which meant the “cancel a pending deletion” control in the admin"},{"type":"text","text":" "},{"type":"text","text":"UI referred to a duration no operator could see or change. Shorter is the more"},{"type":"text","text":" "},{"type":"text","text":"restrictive direction, so a tenant may lower it and not raise it: it is time spent"},{"type":"text","text":" "},{"type":"text","text":"holding data the subject has already asked to have erased, and GDPR Art. 17(1) asks for"},{"type":"text","text":" "},{"type":"text","text":"that to be “without undue delay”. The upper bound of 90 days is where Art. 12(3)’s"},{"type":"text","text":" "},{"type":"text","text":"one-month response deadline plus its two-month extension for complex cases runs out;"},{"type":"text","text":" "},{"type":"text","text":"anything past 30 wants a reason recorded."}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"deletionGracePeriodDays"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"url":"\/documentation\/axiamsdk\/privacypolicy\/deletiongraceperioddays"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy":{"title":"PrivacyPolicy","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy","navigatorTitle":[{"kind":"identifier","text":"PrivacyPolicy"}],"type":"topic","abstract":[{"type":"text","text":"Data-retention rules that apply after a subject asks to be erased."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PrivacyPolicy"}],"url":"\/documentation\/axiamsdk\/privacypolicy"},"doc://AxiamSDK/s8SendableP":{"identifier":"doc:\/\/AxiamSDK\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"}}}