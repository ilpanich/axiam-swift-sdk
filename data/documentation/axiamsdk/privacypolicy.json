eyword","text":"throws"}]},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/encode(to:)":{"abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/encode(to:)","url":"\/documentation\/axiamsdk\/privacypolicy\/encode(to:)","title":"encode(to:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"encode"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7EncoderP","kind":"typeIdentifier","text":"Encoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/deletionGracePeriodDays":{"abstract":[{"text":"How long a requested account erasure stays cancellable before the purge runs, in days.","type":"text"},{"text":" ","type":"text"},{"text":"The window exists so an erasure triggered by mistake, or under coercion, can be undone —","type":"text"},{"text":" ","type":"text"},{"code":"POST \/api\/v1\/auth\/account\/delete\/cancel","type":"codeVoice"},{"text":" works for exactly this long. It was fixed at","type":"text"},{"type":"text","text":" "},{"type":"text","text":"30 days in the handler, which meant the “cancel a pending deletion” control in the admin"},{"type":"text","text":" "},{"type":"text","text":"UI referred to a duration no operator could see or change. Shorter is the more"},{"type":"text","text":" "},{"type":"text","text":"restrictive direction, so a tenant may lower it and not raise it: it is time spent"},{"type":"text","text":" "},{"type":"text","text":"holding data the subject has already asked to have erased, and GDPR Art. 17(1) asks for"},{"type":"text","text":" "},{"type":"text","text":"that to be “without undue delay”. The upper bound of 90 days is where Art. 12(3)’s"},{"type":"text","text":" "},{"type":"text","text":"one-month response deadline plus its two-month extension for complex cases runs out;"},{"type":"text","text":" "},{"type":"text","text":"anything past 30 wants a reason recorded."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/deletionGracePeriodDays","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deletionGracePeriodDays","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/privacypolicy\/deletiongraceperioddays","title":"deletionGracePeriodDays","kind":"symbol"},"doc://AxiamSDK/s8SendableP":{"identifier":"doc:\/\/AxiamSDK\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]}}}