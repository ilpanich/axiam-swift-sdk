t the “cancel a pending deletion” control in the admin","type":"text"},{"text":" ","type":"text"},{"text":"UI referred to a duration no operator could see or change. Shorter is the more","type":"text"},{"text":" ","type":"text"},{"text":"restrictive direction, so a tenant may lower it and not raise it: it is time spent","type":"text"},{"text":" ","type":"text"},{"text":"holding data the subject has already asked to have erased, and GDPR Art. 17(1) asks for","type":"text"},{"text":" ","type":"text"},{"text":"that to be “without undue delay”. The upper bound of 90 days is where Art. 12(3)’s","type":"text"},{"text":" ","type":"text"},{"text":"one-month response deadline plus its two-month extension for complex cases runs out;","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"anything past 30 wants a reason recorded."}],"kind":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deletionGracePeriodDays","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"title":"deletionGracePeriodDays"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/init(from:)":{"url":"\/documentation\/axiamsdk\/privacypolicy\/init(from:)","type":"topic","title":"init(from:)","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/init(from:)","abstract":[]},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PrivacyPolicy","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/privacypolicy","role":"symbol","type":"topic","kind":"symbol","abstract