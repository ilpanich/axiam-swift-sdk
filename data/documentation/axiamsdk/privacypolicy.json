fier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy","abstract":[{"text":"Data-retention rules that apply after a subject asks to be erased.","type":"text"}],"navigatorTitle":[{"text":"PrivacyPolicy","kind":"identifier"}],"title":"PrivacyPolicy"},"doc://AxiamSDK/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/AxiamSDK\/s8SendableP"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/deletionGracePeriodDays":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/deletionGracePeriodDays","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deletionGracePeriodDays","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"deletionGracePeriodDays","abstract":[{"type":"text","text":"How long a requested account erasure stays cancellable before the purge runs, in days."},{"type":"text","text":" "},{"type":"text","text":"The window exists so an erasure triggered by mistake, or under coercion, can be undone —"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/api\/v1\/auth\/account\/delete\/cancel"},{"type":"text","text":" works for exactly this long. It was fixed at"},{"type":"text","text":" "},{"type":"text","text":"30 days in the handler, which meant the “cancel a pending deletion” control in the admin"},{"type":"text","text":" "},{"type":"text","text":"UI referred to a duration no operator could see or change. Shorter is the more"},{"type":"text","text":" "},{"type":"text","text":"restrictive direction, so a tenant may lower it and not raise it: it is time spent"},{"type":"text","text":" "},{"type":"text","text":"holding data the subject has already asked to have erased, and GDPR Art. 17(1) asks for"},{"type":"text","text":" "},{"type":"text","text":"that to be “without undue delay”. The upper bound of 90 days is where Art. 12(3)’s"},{"type":"text","text":" "},{"type":"text","text":"one-month response deadline plus its two-month extension for complex cases runs out;"},{"type":"text","text":" "},{"type":"text","text":"anything past 30 wants a reason recorded."}],"role":"symbol","url":"\/documentation\/axiamsdk\/privacypolicy\/deletiongraceperioddays","type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/init(from:)":{"type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"title":"init(from:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/init(from:)","kind":"symbol","url":"\/documentation\/axiamsdk\/privacypolicy\/init(from:)","abstract":[]},"doc://AxiamSDK/Se":{"type":"unresolvable","title":"Swift.Decodable","identifier":"doc:\/\/AxiamSDK\/Se"},"doc://AxiamSDK/SE":{"type":"unresolvable","title":"Swift.Encodable","identifier":"doc:\/\/AxiamSDK\/SE"},"doc://AxiamSDK/documentation/AxiamSDK/PrivacyPolicy/init(deletionGracePeriodDays:)":{"url":"\/documentation\/axiamsdk\/privacypolicy\/init(deletiongraceperioddays:)","kind":"symbol","title":"init(deletionGracePeriodDays:)","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PrivacyPolicy\/init(deletionGracePeriodDays:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"deletionGracePeriodDays"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s