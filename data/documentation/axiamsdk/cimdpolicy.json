ermit an "},{"type":"codeVoice","code":"http:\/\/"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"http:\/\/"},{"type":"text","text":" fetch. "},{"type":"strong","inlineContent":[{"type":"text","text":"Development only, and it does"},{"type":"text","text":" "},{"type":"text","text":"more than its name says."}]},{"type":"text","text":" AXIAM’s shared SSRF guard couples the scheme rule to the"},{"type":"text","text":" "},{"type":"text","text":"address rule — the same seam that lets an integration test point a fetch at a loopback"},{"type":"text","text":" "},{"type":"text","text":"mock server — so a tenant that allows "},{"type":"codeVoice","code":"http"},{"type":"text","text":" also allows the first hop to resolve to a"},{"text":" ","type":"text"},{"text":"private address. Redirect hops are validated strictly whatever this says, and a public","type":"text"},{"text":" ","type":"text"},{"text":"deployment that sets it has removed the control that makes ","type":"text"},{"code":"169.254.169.254","type":"codeVoice"},{"text":" ","type":"text"},{"text":"unreachable.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/allowHttp","type":"topic","url":"\/documentation\/axiamsdk\/cimdpolicy\/allowhttp","role":"symbol","kind":"symbol","title":"allowHttp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allowHttp","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/confidentialOnly":{"type":"topic","title":"confidentialOnly","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"confidentialOnly","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\