,"type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"*.com","type":"codeVoice"},{"text":"): both are the posture the empty list is refused for, spelled","type":"text"},{"text":" ","type":"text"},{"text":"differently, and a control with no second control behind it cannot have a one-character","type":"text"},{"text":" ","type":"text"},{"text":"bypass and still be the control. It is a floor and not a public-suffix check —","type":"text"},{"text":" ","type":"text"},{"code":"*.github.io","type":"codeVoice"},{"text":" passes, and trusting shared hosting stays the operator’s decision, bounded","type":"text"},{"text":" ","type":"text"},{"text":"by the per-tenant quota rather than by this field. ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" remains valid in","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"CimdPolicy::trusted_redirect_domains","type":"codeVoice"},{"text":"], whose entries are not fetch targets.","type":"text"}],"kind":"symbol","title":"trustedClientIDDomains","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/trustedClientIDDomains","url":"\/documentation\/axiamsdk\/cimdpolicy\/trustedclientiddomains","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"trustedClientIDDomains"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]?"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/minCacheSecs":{"role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy\/mincachesecs","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"minCacheSecs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?"}],"title":"minCacheSecs","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/minCacheSecs","abstract":[{"text":"The 