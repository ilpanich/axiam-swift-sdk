 "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/init(allowHttp:confidentialOnly:enabled:maxCacheSecs:maxMetadataBytes:minCacheSecs:restrictSameDomain:trustedClientIDDomains:trustedRedirectDomains:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/init(from:)"],"title":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/allowHttp","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/confidentialOnly","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/enabled","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/maxCacheSecs","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/maxMetadataBytes","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/minCacheSecs","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/restrictSameDomain","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/trustedClientIDDomains","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/trustedRedirectDomains"],"title":"Instance Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/encode(to:)"],"title":"Instance Methods"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/maxMetadataBytes":{"type":"topic","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxMetadataBytes","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?","kind":