":"text"},{"text":"policy rather than nine fields Every field here is a term of a single decision — ","type":"text"},{"inlineContent":[{"text":"do we","type":"text"},{"text":" ","type":"text"},{"text":"fetch a stranger’s URL and make a client out of what comes back","type":"text"}],"type":"emphasis"},{"text":" — and none of them means","type":"text"},{"text":" ","type":"text"},{"text":"anything without [","type":"text"},{"type":"codeVoice","code":"Self::enabled"},{"text":"]. A tenant that states a CIMD posture states all of it; a","type":"text"},{"text":" ","type":"text"},{"text":"tenant that states none inherits its organization’s whole posture rather than half of one,","type":"text"},{"text":" ","type":"text"},{"text":"which is the only merge that cannot produce a combination neither party wrote. # The two","type":"text"},{"text":" ","type":"text"},{"text":"fields that can widen, and the seven that cannot [","type":"text"},{"type":"codeVoice","code":"Self::enabled"},{"text":"] and [","type":"text"},{"type":"codeVoice","code":"Self::allow_http"},{"text":"]","type":"text"},{"text":" ","type":"text"},{"text":"are ","type":"text"},{"inlineContent":[{"type":"text","text":"ordered"}],"type":"strong"},{"text":": a tenant may turn either off but never on, exactly as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"dynamic_registration"},{"text":" may only move down its ladder. Everything else names ","type":"text"},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"domains or ","type":"text"},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"text":" bounds, and there is no sense in which one tenant’s list of","type":"text"},{"text":" ","type":"text"},{"text":"trusted publishers is stricter than another’s — the same argument [","type":"text"},{"type":"codeVoice","code":"OidcPolicy"},{"text":"] already","type":"text"},{"text":" ","type":"text"},{"text":"makes for ","type":"text"},{"type":"codeVoice","code":"dcr_allowed_redirect_hosts"},{"text":". # Every bound here is a security control","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"type":"codeVoice","code":"Self::max_metadata_bytes"},{"text":"], [","type":"text"},{"type":"codeVoice","code":"Self::min_cache_secs"},{"text":"] and [","type":"text"},{"type":"codeVoice","code":"Self::max_cache_secs"},{"text":"] are not","type":"text"},{"text":" ","type":"text"},{"text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the","type":"text"},{"text":" ","type":"text"},{"text":"floor under how often that read may be repeated, and the ceiling on how long its result may","type":"text"},{"text":" ","type":"text"},{"text":"be trusted. Each is clamped again in code against the three constants above, so a settings","type":"text"},{"text":" ","type":"text"},{"text":"row written by hand cannot lift them.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CimdPolicy"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/allowHttp":{"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allowHttp","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/allowHttp","abstract":[{"type":"text","text":"Permit an "},{"type":"codeVoice","code":"http:\/\/"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"http:\/\/"},{"type":"text","text":" fetch. "},{"inlineContent":[{"text":"Development only, and it does","type":"text"},{"text":" ","type":"text"},{"text":"more than its name says.","type":"text"}],"type":"strong"},{"type":"text","text":" AXIAM’s shared SSRF guard couples the scheme rule to the"},{"type":"text","text":" "},{"type":"text","text":"address rule — the same seam that lets an integration test point a fetch at a loopback"},{"type":"text","text":" "},{"type":"text","text":"mock server — so a tenant that allows "},{"type":"codeVoice","code":"http"},{"type":"text","text":" also allows the first hop to resolve to a"},{"type":"text","text":" "},{"type":"text","text":"private address. Redirect hops are validated strictly whatever this says, and a public"},{"type":"text","text":" "},{"type":"text","text":"deployment that sets it has removed the control that makes "},{"type":"codeVoice","code":"169.254.169.254"},{"type":"text","text":" "},{"type":"text","text":"unreachable."}],"url":"\/documentation\/axiamsdk\/cimdpolicy\/allowhttp","title":"allowHttp","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/confidentialOnly":{"role":"symbol","abstract":[{"text":"Refuse a document whose ","type":"text"},{"code":"token_endpoint_auth_method","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"none","type":"codeVoice"},{"text":". Off by default, because","type":"text"},{"text":" ","type":"text"},{"code":"none","type":"codeVoice"},{"text":" is what every MCP desktop client is. A tenant that turns it on accepts only","type":"text"},{"text":" ","type":"text"},{"code":"private_key_jwt","type":"codeVoice"},{"text":" documents, which is the posture for a deployment whose CIMD clients","type":"text"},{"text":" ","type":"text"},{"text":"are servers rather than desktops.","type":"text"}],"url":"\/documentation\/axiamsdk\/cimdpolicy\/confidentialonly","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/confidentialOnly","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"confidentialOnly"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"type":"topic","title":"confidentialOnly"},"d