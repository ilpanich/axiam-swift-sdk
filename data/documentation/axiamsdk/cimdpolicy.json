 to a","type":"text"},{"text":" ","type":"text"},{"text":"private address. Redirect hops are validated strictly whatever this says, and a public","type":"text"},{"text":" ","type":"text"},{"text":"deployment that sets it has removed the control that makes ","type":"text"},{"type":"codeVoice","code":"169.254.169.254"},{"text":" ","type":"text"},{"text":"unreachable.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/minCacheSecs":{"url":"\/documentation\/axiamsdk\/cimdpolicy\/mincachesecs","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minCacheSecs","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/minCacheSecs","kind":"symbol","role":"symbol","title":"minCacheSecs","abstract":[{"type":"text","text":"The floor under a document’s cache lifetime, in seconds. Clamped to"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"CIMD_MIN_CACHE_FLOOR_SECS"},{"type":"text","text":"]."}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/init(allowHttp:confidentialOnly:enabled:maxCacheSecs:maxMetadataBytes:minCacheSecs:restrictSameDomain:trustedClientIDDomains:trustedRedirectDomains:)":{"kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy\/init(allowhttp:confidentialonly:enabled:maxcachesecs:maxmetadatabytes:mincachesecs:restrictsamedomain:trustedclientiddomains:trustedredirectdomains:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/init(allowHttp:confidentialOnly:enabled:maxCacheSecs:maxMetadataBytes:minCacheSecs:restrictSameDomain:trustedClientIDDomains:trustedRedirectDomains:)","abstract":[],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"allowHttp","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"confidentialOnly","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"enabled","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"maxCacheSecs","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"maxMetadataBytes","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"minCacheSecs","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"restrictSameDomain","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"trustedClientIDDomains","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]?, ","kind":"text"},{"text":"trustedRedirectDomains","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]?)","kind":"text"}],"title":"init(allowHttp:confidentialOnly:enabled:maxCacheSecs:maxMetadataBytes:minCacheSecs:restrictSameDomain:trustedClientIDDomains:trustedRedirectDomains:)","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/trustedClientIDDomains":{"kind":"symbol","abstract":[{"text":"The hosts whose documents this tenant will fetch at all, as globs (","type":"text"},{"code":"mcp.example.com","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"*.example.com","type":"codeVoice"},{"text":" for every host under one domain). ","type":"text"},{"inlineContent":[{"type":"text","text":"An empty list resolves nothing"}],"type":"strong"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and enabling CIMD while it is empty is refused — see ["},{"code":"validate_cimd_policy","type":"codeVoice"},{"type":"text","text":"]. That is a"},{"text":" ","type":"text"},{"text":"deliberate departure from “a URL is a client identifier, so any URL will do”: the fetch","type":"text"},{"text":" ","type":"text"},{"text":"is triggered by an unauthenticated request naming the URL, so an unrestricted list is a","type":"text"},{"text":" ","type":"text"},{"text":"request-forgery primitive offered to strangers, bounded only by the SSRF guard’s address","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"rules. Naming the publishers a tenant actually fronts costs one settings field and"},{"type":"text","text":" "},{"type":"text","text":"removes the class. "},{"inlineContent":[{"type":"codeVoice","code":"*"},{"type":"text","text":" is refused here, and so is a wildcard over a whole top-level"},{"type":"text","text":" "},{"type":"text","text":"domain"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"*.com"},{"type":"text","text":"): both are the posture the empty list is refused for, spelled"},{"type":"text","text":" "},{"type":"text","text":"differently, and a control with no second control behind it cannot have a one-character"},{"type":"text","text":" "},{"type":"text","text":"bypass and still be the control. It is a floor and not a public-suffix check —"},{"type":"text","text":" "},{"type":"codeVoice","code":"*.github.io"},{"type":"text","text":" passes, and trusting shared hosting stays the operator’s decision, bounded"},{"type":"text","text":" "},{"type":"text","text":"by the per-tenant quota rather than by this field. "},{"type":"codeVoice","code":"*"},{"type":"text","text":" remains valid in"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"CimdPolicy::trusted_redirect_domains"},{"type":"text","text":"], whose entries are not fetch targets."}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trustedClientIDDomains","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/trustedClientIDDomains","title":"trustedClientIDDomains","url":"\/documentation\/axiamsdk\/cimdpolicy\/trustedclientiddomains"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/restrictSameDomain":{"kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy\/restrictsamedomain","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/restrictSameDomain","abstract":[{"text":"Require every ","type":"text"},{"code":"redirect_uris","type":"codeVoice"},{"text":" host in the document to equal the host of the ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"URL itself. ","type":"text"},{"inlineContent":[{"text":"On by default","type":"text"}],"type":"strong"},{"text":", because the document says who the client is and a","type":"text"},{"text":" ","type":"text"},{"text":"redirect to somewhere else is the one thing a stolen or mirrored document would want to","type":"text"},{"text":" ","type":"text"},{"text":"change. It is turned ","type":"text"},{"inlineContent":[{"type":"text","text":"off"}],"type":"strong"},{"text":" for the desktop MCP clients, whose callbacks are on","type":"text"},{"text":" ","type":"text"},{"text":"loopback and therefore can never share a host with a ","type":"text"},{"code":"https:\/\/","type":"codeVoice"},{"text":" ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"docs\/admin\/client-id-metadata-documents.md","type":"codeVoice"},{"text":" says so and says why.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"restrictSameDomain"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"title":"restrictSameDomain","type":"topic"},"doc://AxiamSDK/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/AxiamSDK\/s8SendableP"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/init(from:)":{"url":"\/documentation\/axiamsdk\/cimdpolicy\/init(from:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/init(from:)","role":"symbol","abstract":[],"title":"init(from:)"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy":{"navigatorTitle":[{"text":"CimdPolicy","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CimdPolicy","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy","title":"CimdPolicy","abstract":[{"type":"text","text":"Whether, and on what terms, a "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" that is a URL is resolved by fetching the document"},{"type":"te