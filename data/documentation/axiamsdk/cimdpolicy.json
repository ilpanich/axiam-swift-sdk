fier"},{"text":"?, ","kind":"text"},{"text":"restrictSameDomain","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"trustedClientIDDomains","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]?, ","kind":"text"},{"text":"trustedRedirectDomains","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]?)","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/allowHttp":{"abstract":[{"type":"text","text":"Permit an "},{"type":"codeVoice","code":"http:\/\/"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"http:\/\/"},{"type":"text","text":" fetch. "},{"type":"strong","inlineContent":[{"type":"text","text":"Development only, and it does"},{"type":"text","text":" "},{"type":"text","text":"more than its name says."}]},{"type":"text","text":" AXIAM’s shared SSRF guard couples the scheme rule to the"},{"type":"text","text":" "},{"type":"text","text":"address rule — the same seam that lets an integration test point a fetch at a loopback"},{"type":"text","text":" "},{"type":"text","text":"mock server — so a tenant that allows "},{"code":"http","type":"codeVoice"},{"type":"text","text":" also allows the first hop to resolve to a"},{"type":"text","text":" "},{"type":"text","text":"private address. Redirect hops are validated strictly whatever this says, and a public"},{"type":"text","text":" "},{"type":"text","text":"deployment that sets it has removed the control that makes "},{"type":"codeVoice","code":"169.254.169.254"},{"type":"text","text":" "},{"type":"text","text":"unreachable."}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/allowHttp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"allowHttp"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?"}],"title":"allowHttp","url":"\/documentation\/axiamsdk\/cimdpolicy\/allowhttp","kind":"symbol","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/confidentialOnly":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/confidentialOnly","kind":"symbol","abstract":[{"type":"text","text":"Refuse a document whose "},{"type":"codeVoice","code":"token_endpoint_auth_method"},{"type":"text","text":" is "},{"type":"codeVoice","code":"none"},{"type":"text","text":". Off by default, because"},{"type":"text","text":" "},{"type":"codeVoice","code":"none"},{"type":"text","text":" is what every MCP desktop client is. A tenant that turns it on accepts only"},{"type":"text","text":" "},{"type":"codeVoice","code":"private_key_jwt"},{"type":"text","text":" documents, which is the posture for a deployment whose CIMD clients"},{"type":"text","text":" "},{"type":"text","text":"are servers rather than desktops."}],"url":"\/documentation\/axiamsdk\/cimdpolicy\/confidentialonly","type":"topic","role":"symbol","title":"confidentialOnly","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"confidentialOnly","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/AxiamSDK\/s8SendableP","title":"Swift.Sendable"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/maxMetadataBytes":{"title":"maxMetadataBytes","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/maxMetadataBytes","role":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy\/maxmetadatabytes","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"maxMetadataBytes","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The hard cap on how many bytes of a document are read, before it is parsed. Clamped to"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"CIMD_MAX_METADATA_BYTES_CEILING"},{"type":"text","text":"]."}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/restrictSameDomain":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/restrictSameDomain","abstract":[{"text":"Require every ","type":"text"},{"code":"redirect_uris","type":"codeVoice"},{"text":" host in the document to equal the host of the ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"URL itself. ","type":"text"},{"inlineContent":[{"type":"text","text":"On by default"}],"type":"strong"},{"text":", because the document says who the client is and a","type":"text"},{"text":" ","type":"text"},{"text":"redirect to somewhere else is the one thing a stolen or mirrored document would want to","type":"text"},{"text":" ","type":"text"},{"text":"change. It is turned ","type":"text"},{"inlineContent":[{"type":"text","text":"off"}],"type":"strong"},{"text":" for the desktop MCP clients, whose callbacks are on","type":"text"},{"text":" ","type":"text"},{"text":"loopback and therefore can never share a host with a ","type":"text"},{"code":"https:\/\/","type":"codeVoice"},{"text":" ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"docs\/admin\/client-id-metadata-documents.md","type":"codeVoice"},{"text":" says so and says why.","type":"text"}],"type":"topic","url":"\/documentation\/axiamsdk\/cimdpolicy\/restrictsamedomain","role":"symbol","title":"restrictSameDomain","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restrictSameDomain","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/encode(to:)":{"kind":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy\/encode(to:)","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/encode(to:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Encoder","kind":"typeIdentifier","preciseIdentifier":"s:s7EncoderP"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"abstract":[],"title":"encode(to:)"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/enabled":{"abstract":[{"type":"strong","inlineContent":[{"text":"Off unless somebody turns it on","type":"text"}]},{"type":"text","text":" (I1). With this "},{"type":"codeVoice","code":"false"},{"type":"text","text":", a URL-shaped "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"exactly today’s unknown client: nothing is fetched, nothing is materialised, and the"},{"type":"text","text":" "},{"type":"text","text":"ordinary repository lookup answers as it always has."}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/enabled","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"enabled"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"title":"enabled","url":"\/documentation\/axiamsdk\/cimdpolicy\/enabled","kind":"symbol","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/maxCacheSecs":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/maxCacheSecs","url":"\/documentation\/axia