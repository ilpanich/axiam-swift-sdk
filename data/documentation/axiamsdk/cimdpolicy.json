iling on a read from an attacker-chosen URL, the","type":"text"},{"text":" ","type":"text"},{"text":"floor under how often that read may be repeated, and the ceiling on how long its result may","type":"text"},{"text":" ","type":"text"},{"text":"be trusted. Each is clamped again in code against the three constants above, so a settings","type":"text"},{"text":" ","type":"text"},{"text":"row written by hand cannot lift them.","type":"text"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/cimdpolicy","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CimdPolicy"}],"navigatorTitle":[{"kind":"identifier","text":"CimdPolicy"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/allowHttp":{"kind":"symbol","abstract":[{"text":"Permit an ","type":"text"},{"code":"http:\/\/","type":"codeVoice"},{"text":" ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" and an ","type":"text"},{"code":"http:\/\/","type":"codeVoice"},{"text":" fetch. ","type":"text"},{"inlineContent":[{"type":"text","text":"Development only, and it does"},{"type":"text","text":" "},{"type":"text","text":"more than its name says."}],"type":"strong"},{"text":" AXIAM’s shared SSRF guard couples the scheme rule to the","type":"text"},{"text":" ","type":"text"},{"text":"address rule — the same seam that lets an integration test point a fetch at a loopback","type":"text"},{"text":" ","type":"text"},{"text":"mock server — so a tenant that allows ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" also allows the first hop to resolve to a","type":"text"},{"text":" ","type":"text"},{"text":"private address. Redirect hops are validated strictly whatever this says, and a public","type":"text"},{"text":" ","type":"text"},{"text":"deployment that sets it has removed the control that makes ","type":"text"},{"code":"169.254.169.254","type":"codeVoice"},{"text":" ","type":"text"},{"text":"unreachable.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/allowHttp","url":"\/documentation\/axiamsdk\/cimdpolicy\/allowhttp","title":"allowHttp","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"allowHttp"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/maxMetadataBytes":{"kind":"symbol","abstract":[{"text":"The hard cap on how many bytes of a document are read, before it is parsed. Clamped to","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"CIMD_MAX_METADATA_BYTES_CEILING","type":"codeVoice"},{"text":"].","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/maxMetadataBytes","url":"\/documentation\/axiamsdk\/cimdpolicy\/maxmetadatabytes","title":"maxMetadataBytes","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxMetadataBytes","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/s8SendableP":{"identifier":"doc:\/\/AxiamSDK\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://AxiamSDK/SE":{"identifier":"doc:\/\/AxiamSDK\/SE","title":"Swift.Encodable","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/enabled":{"kind":"symbol","abstract":[{"inlineContent":[{"text":"Off unless somebody turns it on","type":"text"}],"type":"strong"},{"text":" (I1). With this ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", a URL-shaped ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"exactly today’s unknown client: nothing is fetched, nothing is materialised, and the","type":"text"},{"text":" ","type":"text"},{"text":"ordinary repository lookup answers as it always has.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/enabled","url":"\/documentation\/axiamsdk\/cimdpolicy\/enabled","title":"enabled","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/maxCacheSecs":{"kind":"symbol","abstract":[{"text":"The ceiling on a document’s cache lifetime, in seconds. Clamped to","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"CIMD_MAX_CACHE_CEILING_SECS","type":"codeVoice"},{"text":"].","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/maxCacheSecs","url":"\/documentation\/axiamsdk\/cimdpolicy\/maxcachesecs","title":"maxCacheSecs","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxCacheSecs","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/trustedClientIDDomains":{"kind":"symbol","abstract":[{"text":"The hosts whose documents this tenant will fetch at all, as globs (","type":"text"},{"code":"mcp.example.com","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"*.example.com","type":"codeVoice"},{"text":" for every host under one domain). ","type":"text"},{"inlineContent":[{"text":"An empty list resolves nothing","type":"text"}],"type":"strong"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and enabling CIMD while it is empty is refused — see [","type":"text"},{"code":"validate_cimd_policy","type":"codeVoice"},{"text":"]. That is a","type":"text"},{"text":" ","type":"text"},{"text":"deliberate departure from “a URL is a client identifier, so any URL will do”: the fetch","type":"text"},{"text":" ","type":"text"},{"text":"is triggered by an unauthenticated request naming the URL, so an unrestricted list is a","type":"text"},{"text":" ","type":"text"},{"text":"request-forgery primitive offered to strangers, bounded only by the SSRF guard’s address","type":"text"},{"text":" ","type":"text"},{"text":"rules. Naming the publishers a tenant actually fronts costs one settings field and","type":"text"},{"text":" ","type":"text"},{"text":"removes the class. ","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"*"},{"text":" is refused here, and so is a wildcard over a whole top-level","type":"text"},{"text":" ","type":"text"},{"text":"domain","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"*.com","type":"codeVoice"},{"text":"): both are the posture the empty list is refused for, spelled","type":"text"},{"text":" ","type":"text"},{"text":"differently, and a control with no second control behind it cannot have a one-character","type":"text"},{"text":" ","type":"text"},{"text":"bypass and still be the control. It is a floor and not a public-suffix check —","type":"text"},{"text":" ","type":"text"},{"code":"*.github.io","type":"codeVoice"},{"text":" passes, and trusting shared hosting stays the operator’s decision, bounded","type":"text"},{"text":" ","type":"text"},{"text":"by the per-tenant quota rather than by this field. ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" remains valid in","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"CimdPolicy::trusted_redirect_domains","type":"codeVoice"},{"text":"], whose entries are not fetch targets.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/trustedClientIDDomains","url":"\/documentation\/axiamsdk\/cimdpolicy\/trustedclientiddomains","title":"trustedClientI