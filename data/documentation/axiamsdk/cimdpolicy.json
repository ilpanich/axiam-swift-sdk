e":"codeVoice"},{"text":"). # Why this is one nested","type":"text"},{"text":" ","type":"text"},{"text":"policy rather than nine fields Every field here is a term of a single decision — ","type":"text"},{"inlineContent":[{"text":"do we","type":"text"},{"text":" ","type":"text"},{"text":"fetch a stranger’s URL and make a client out of what comes back","type":"text"}],"type":"emphasis"},{"text":" — and none of them means","type":"text"},{"text":" ","type":"text"},{"text":"anything without [","type":"text"},{"code":"Self::enabled","type":"codeVoice"},{"text":"]. A tenant that states a CIMD posture states all of it; a","type":"text"},{"text":" ","type":"text"},{"text":"tenant that states none inherits its organization’s whole posture rather than half of one,","type":"text"},{"text":" ","type":"text"},{"text":"which is the only merge that cannot produce a combination neither party wrote. # The two","type":"text"},{"text":" ","type":"text"},{"text":"fields that can widen, and the seven that cannot [","type":"text"},{"code":"Self::enabled","type":"codeVoice"},{"text":"] and [","type":"text"},{"code":"Self::allow_http","type":"codeVoice"},{"text":"]","type":"text"},{"text":" ","type":"text"},{"text":"are ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"ordered"}]},{"text":": a tenant may turn either off but never on, exactly as","type":"text"},{"text":" ","type":"text"},{"code":"dynamic_registration","type":"codeVoice"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"inlineContent":[{"type":"text","text":"this tenant’s"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"domains or "},{"inlineContent":[{"type":"text","text":"this tenant’s"}],"type":"emphasis"},{"type":"text","text":" bounds, and there is no sense in which one tenant’s list of"},{"type":"text","text":" "},{"type":"text","text":"trusted publishers is stricter than another’s — the same argument ["},{"code":"OidcPolicy","type":"codeVoice"},{"type":"text","text":"] already"},{"type":"text","text":" "},{"type":"text","text":"makes for "},{"code":"dcr_allowed_redirect_hosts","type":"codeVoice"},{"type":"text","text":". # Every bound here is a security control"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"Self::max_metadata_bytes","type":"codeVoice"},{"type":"text","text":"], ["},{"code":"Self::min_cache_secs","type":"codeVoice"},{"type":"text","text":"] and ["},{"code":"Self::max_cache_secs","type":"codeVoice"},{"type":"text","text":"] are not"},{"type":"text","text":" "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/s8SendableP"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CimdPolicy"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/cimdpolicy"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/encode(to:)":{"title":"encode(to:)","type":"topic","url":"\/documentation\/axiamsdk\/cimdpolicy\/encode(to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"kind":"text","text":"("},{"text":"to","kind":"externalParam"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7EncoderP","text":"Encoder","kind":"typeIdentifier"},{"kind":"text","text":") "},{"text":"throws","kind":"keyword"}],"role":"symbol","abstract":[],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/encode(to:)"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/init(from:)":{"role":"symbol","type":"topic","abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/init(from:)","url":"\/documentation\/axiamsdk\/cimdpolicy\/init(from:)","kind":"symbol","title":"init(from:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy/trustedClientIDDomains":{"type":"topic","title":"trustedClientIDDomains","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trustedClientIDDomains","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"abstract":[{"text":"The hosts whose documents this tenant will fetch at all, as globs (","type":"text"},{"code":"mcp.example.com","type":"codeVoice"},{"type":"text","text":", or"},{"type":"text","text":" "},{"code":"*.example.com","type":"codeVoice"},{"type":"text","text":" for every host under one domain). "},{"type":"strong","inlineContent":[{"type":"text","text":"An empty list resolves nothing"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and enabling CIMD while it is empty is refused — see ["},{"type":"codeVoice","code":"validate_cimd_policy"},{"type":"text","text":"]. That is a"},{"type":"text","text":" "},{"type":"text","text":"deliberate departure from “a URL is a client identifier, so any URL will do”: the fetch"},{"type":"text","text":" "},{"type":"text","text":"is triggered by an unauthenticated request naming the URL, so an unrestricted list is a"},{"type":"text","text":" "},{"type":"text","text":"request-forgery primitive offered to strangers, bounded only by the SSRF guard’s address"},{"type":"text","text":" "},{"type":"text","text":"rules. Naming the publishers a tenant actually fronts costs one settings field and"},{"type":"text","text":" "},{"type":"text","text":"removes the class. "},{"type":"strong","inlineContent":[{"code":"*","type":"codeVoice"},{"text":" is refused here, and so is a wildcard over a whole top-level","type":"text"},{"text":" ","type":"text"},{"text":"domain","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"*.com"},{"type":"text","text":"): both are the posture the empty list is refused for, spelled"},{"type":"text","text":" "},{"type":"text","text":"differently, and a control with no second control behind it cannot have a one-character"},{"type":"text","text":" "},{"type":"text","text":"bypass and still be the control. It is a floor and not a public-suffix check —"},{"type":"text","text":" "},{"code":"*.github.io","type":"codeVoice"},{"text":" passes, and trusting shared hosting stays the operator’s decision, bounded","type":"text"},{"text":" ","type":"text"},{"text":"by the per-tenant quota rather than by this field. ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" remains valid in","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"CimdPolicy::trusted_redirect_domains","type":"codeVoice"},{"type":"text","text":"], whose entries are not fetch targets."}],"url":"\/documentation\/axiamsdk\/cimdpolicy\/trustedclientiddomains","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy\/trustedClientIDDomains"},"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","