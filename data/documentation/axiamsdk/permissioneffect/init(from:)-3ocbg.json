,{"text":" ","type":"text"},{"text":"that send no ","type":"text"},{"type":"codeVoice","code":"effect"},{"text":", both mean “allow”. No migration.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}],"title":"PermissionEffect","navigatorTitle":[{"text":"PermissionEffect","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/permissioneffect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"}}}