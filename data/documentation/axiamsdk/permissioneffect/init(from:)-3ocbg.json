ons":[],"abstract":[{"text":"Inherited from ","type":"text"},{"code":"RawRepresentable.init(from:)","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/init(from:)-3ocbg"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/RawRepresentable-Implementations":{"type":"topic","kind":"article","title":"RawRepresentable Implementations","abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/RawRepresentable-Implementations","role":"collectionGroup","url":"\/documentation\/axiamsdk\/permissioneffect\/rawrepresentable-implementations"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/init(from:)-3ocbg":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol","type":"topic","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Decodable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Self","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"RawRepresentable","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"RawValue","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"String","type":"codeVoice"},{"text":".","type":"text"}]},"title":"init(from:)","abstract":[],"url":"\/documentation\/axiamsdk\/permissioneffect\/init(from:)-3ocbg","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/init(from:)-3ocbg"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"title":"PermissionEffect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"text":"] grant permits -> a [","type":"text"},{"code":"PermissionEffect::Deny","type":"codeVoice"},{"text":"] grant","type":"text"},{"text":" ","type":"text"},{"text":"refuses, ","type":"text"},{"inlineContent":[{"type":"text","text":"and beats every allow"}],"type":"strong"},{"text":", wherever either sits in the resource hierarchy. Deny","type":"text"},{"text":" ","type":"text"},{"text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"code":"effect","type":"codeVoice"},{"type":"text","text":", both mean “allow”. No migration."