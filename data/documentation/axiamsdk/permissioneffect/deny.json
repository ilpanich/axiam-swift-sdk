l in ","type":"text"},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"text":" §2.1. The short version: deny-override buys one","type":"text"},{"text":" ","type":"text"},{"text":"checkable property — ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"adding a deny rule can never widen access, and can never be undone by"},{"type":"text","text":" "},{"type":"text","text":"adding allows"}]},{"text":" — and most-specific-wins buys expressiveness at the cost of making “is X","type":"text"},{"text":" ","type":"text"},{"text":"denied?” unanswerable without enumerating every other rule that might out-specify it.","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"text":"] is the default, so data written before this existed, and clients","type":"text"},{"text":" ","type":"text"},{"text":"that send no ","type":"text"},{"type":"codeVoice","code":"effect"},{"text":", both mean “allow”. No migration.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}],"title":"PermissionEffect","url":"\/documentation\/axiamsdk\/permissioneffect","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/deny":{"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"deny"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/deny","url":"\/documentation\/axiamsdk\/permissioneffect\/deny","role":"symbol","abstract":[],"type":"topic","title":"PermissionEffect.deny"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","role":"collection","type":"topic","url":"\/documentation\/axiamsdk"}}}