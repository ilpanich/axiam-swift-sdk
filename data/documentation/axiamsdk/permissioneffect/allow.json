{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/allow","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/permissioneffect\/allow"]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"allow"}]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"]]},"metadata":{"role":"symbol","externalID":"s:8AxiamSDK16PermissionEffectO5allowyA2CmF","title":"PermissionEffect.allow","symbolKind":"case","modules":[{"name":"AxiamSDK"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"allow"}],"roleHeading":"Case"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/allow":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"allow"}],"abstract":[],"title":"PermissionEffect.allow","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/allow","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/permissioneffect\/allow"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"title":"PermissionEffect","navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"kind":"symbol","abstract":[{"text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default","type":"text"},{"text":" ","type":"text"},{"text":"deny -> an [","type":"text"},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"text":"] grant permits -> a [","type":"text"},{"code":"PermissionEffect::Deny","type":"codeVoice"},{"text":"] grant","type":"text"},{"text":" ","type":"text"},{"text":"refuses, ","type":"text"},{"inlineContent":[{"type":"text","text":"and beats every allow"}],"type":"strong"},{"text":", wherever either sits in the resource hierarchy. Deny","type":"text"},{"text":" ","type":"text"},{"text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in","type":"text"},{"text":" ","type":"text"},{"text":"full in ","type":"text"},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"text":" §2.1. The short version: deny-override buys one","type":"text"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"type":"text","text":"adding a deny rule can never widen access, and can never be undone by"},{"type":"text","text":" "},{"type":"text","text":"adding allows"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"text":", both mean “allow”. No migration.","type":"text"}],"url":"\/documentation\/axiamsdk\/permissioneffect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}