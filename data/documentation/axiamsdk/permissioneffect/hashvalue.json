e":"swift"},"sections":[],"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"type":"topic","kind":"symbol","role":"symbol","title":"PermissionEffect","url":"\/documentation\/axiamsdk\/permissioneffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"type":"strong","inlineContent":[{"type":"text","text":"and beats every allow"}]},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/RawRepresentable-Implementations":{"role":"collectionGroup","url":"\/documentation\/axiamsdk\/permissioneffect\/rawrepresentable-implementations","kind":"article","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/RawRepresentable-Implementations","abstract":[],"type":"topic","title":"RawRepresentable Implementations"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/hashValue":{"abstract":[],"url":"\/documentation\/axiamsdk\/permissioneffect\/hashvalue","title":"hashValue","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hashValue","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"RawValue","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/hashValue","type":"topic","kind":"symbol","role":"