},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"type":"text","text":"adding a deny rule can never widen access, and can never be undone by"},{"type":"text","text":" "},{"type":"text","text":"adding allows"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}]},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/!=(_:_:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/!=(_:_:)","title":"!=(_:_:)","type":"topic","url":"\/documentation\/axiamsdk\/permissioneffect\/!=(_:_:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"keyword","text":"borrowing"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"keyword","text":"borrowing"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[],"kind":"symbol","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstrac