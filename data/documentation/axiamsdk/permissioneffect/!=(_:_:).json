{"major":0,"minor":3,"patch":0},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/Equatable-Implementations":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/Equatable-Implementations","title":"Equatable Implementations","abstract":[],"kind":"article","type":"topic","url":"\/documentation\/axiamsdk\/permissioneffect\/equatable-implementations","role":"collectionGroup"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"url":"\/documentation\/axiamsdk\/permissioneffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"inlineContent":[{"type":"text","text":"and beats every allow"}],"type":"strong"},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}],"type":"strong"},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"code":"effect","type":"codeVoice"},{"type":"text","text":", both mean “allow”. No migration."}],"navigatorTitle":[{"text":"PermissionEffect","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","title":"PermissionEffect","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/!=(_:_:)":{"abstract":[],"role":"symbol","url":"\/documentation\/axiamsdk\/permissioneffect\/!=(_:_:)","title":"!=(_:_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/!=(_:_:)","type":"topic","kind":"symbol"}}}