t":" for a value that is not a case — so code that deliberately parses a raw string","type":"text"},{"text":" ","type":"text"},{"text":"keeps its check. Only DECODING, where the alternative is failing a whole response, is","type":"text"},{"text":" ","type":"text"},{"text":"lenient.","type":"text"}]}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"url":"\/documentation\/axiamsdk\/permissioneffect","kind":"symbol","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"inlineContent":[{"type":"text","text":"and beats every allow"}],"type":"strong"},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}],"type":"strong"},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}],"title":"PermissionEffect","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/init(from:)":{"abstract":[{"type":"text","text":"Decodes an unrecognised value to "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" instead of throwing."}],"title":"init(from:)","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/axiamsdk\/permissioneffect\/init(from:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/init(from:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]}}}