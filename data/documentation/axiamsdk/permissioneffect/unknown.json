{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"]]},"kind":"symbol","abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."}],"metadata":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknown","kind":"identifier"}],"role":"symbol","symbolKind":"case","roleHeading":"Case","title":"PermissionEffect.unknown","externalID":"s:8AxiamSDK16PermissionEffectO7unknownyA2CmF","modules":[{"name":"AxiamSDK"}]},"variants":[{"paths":["\/documentation\/axiamsdk\/permissioneffect\/unknown"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/unknown","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}],"platforms":["Linux"],"languages":["swift"]}]}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/unknown":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."}],"title":"PermissionEffect.unknown","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/unknown","url":"\/documentation\/axiamsdk\/permissioneffect\/unknown"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"title":"PermissionEffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"type":"strong","inlineContent":[{"type":"text","text":"and beats every allow"}]},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}],"kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}],"navigatorTitle":[{"text":"PermissionEffect","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/permissioneffect","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"}}}