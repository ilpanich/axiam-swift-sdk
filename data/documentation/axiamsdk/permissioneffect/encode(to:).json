deVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/RawRepresentable-Implementations":{"role":"collectionGroup","url":"\/documentation\/axiamsdk\/permissioneffect\/rawrepresentable-implementations","kind":"article","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/RawRepresentable-Implementations","abstract":[],"type":"topic","title":"RawRepresentable Implementations"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/encode(to:)":{"role":"symbol","url":"\/documentation\/axiamsdk\/permissioneffect\/encode(to:)","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/encode(to:)","abstract":[],"conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type"