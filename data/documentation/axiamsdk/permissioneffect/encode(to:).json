{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"]]},"abstract":[{"text":"Refuses ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":": a value this SDK could not name is never sent.","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/encode(to:)","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"encoder","kind":"internalParam"},{"text":": any ","kind":"text"},{"text":"Encoder","kind":"typeIdentifier","preciseIdentifier":"s:s7EncoderP"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoding is lenient so one unrecognised value does not fail a whole response; writing is"},{"type":"text","text":" "},{"type":"text","text":"not, because the only spelling "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" has is the empty string. A read-modify-write"},{"type":"text","text":" "},{"type":"text","text":"of a record that carries one raises before any request (CONTRACT.md §34.2 P12.2,"},{"type":"text","text":" "},{"type":"text","text":"contract 1.60 A4)."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/axiamsdk\/permissioneffect\/encode(to:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Method","role":"symbol","externalID":"s:8AxiamSDK16PermissionEffectO6encode2toys7Encoder_p_tKF","title":"encode(to:)","fragments":[{"text":"func","kind":"keyword"