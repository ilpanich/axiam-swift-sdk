override-design.md"},{"text":" §2.1. The short version: deny-override buys one","type":"text"},{"text":" ","type":"text"},{"text":"checkable property — ","type":"text"},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}]},{"text":" — and most-specific-wins buys expressiveness at the cost of making “is X","type":"text"},{"text":" ","type":"text"},{"text":"denied?” unanswerable without enumerating every other rule that might out-specify it.","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"text":"] is the default, so data written before this existed, and clients","type":"text"},{"text":" ","type":"text"},{"text":"that send no ","type":"text"},{"type":"codeVoice","code":"effect"},{"text":", both mean “allow”. No migration.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}],"title":"PermissionEffect","navigatorTitle":[{"text":"PermissionEffect","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/permissioneffect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}