xt","text":"keeps its check. Only DECODING, where the alternative is failing a whole response, is"},{"type":"text","text":" "},{"type":"text","text":"lenient."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/axiamsdk\/permissioneffect\/init(from:)-1ui3y"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","url":"\/documentation\/axiamsdk\/permissioneffect","kind":"symbol","type":"topic","title":"PermissionEffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"text":" ","type":"text"},{"text":"deny -> an [","type":"text"},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"text":"] grant permits -> a [","type":"text"},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"text":"] grant","type":"text"},{"text":" ","type":"text"},{"text":"refuses, ","type":"text"},{"type":"strong","inlineContent":[{"text":"and beats every allow","type":"text"}]},{"text":", wherever either sits in the resource hierarchy. Deny","type":"text"},{"text":" ","type":"text"},{"text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in","type":"text"},{"text":" ","type":"text"},{"text":"full in ","type":"text"},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"text":" §2.1. The short version: deny-override buys one","type":"text"},{"text":" ","type":"text"},{"text":"checkable property — ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"adding a deny rule can never widen access, and can never be undone by"},{"type":"text","text":" "},{"type":"text","text":"adding allows"}]},{"text":" — and most-specific-wins buys expressiveness at the cost of making “is X","type":"text"},{"text":" ","type":"text"},{"text":"denied?” unanswerable without enumerating every other rule that might out-specify it.","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"text":"] is the default, so data written before this existed, and clients","type":"text"},{"text":" ","type":"text"},{"text":"that send no ","type":"text"},{"type":"codeVoice","code":"effect"},{"text":", both mean “allow”. No migration.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/init(from:)-1ui3y":{"type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"url":"\/documentation\/axiamsdk\/permissioneffect\/init(from:)-1ui3y","abstract":[{"text":"Decodes an unrecognised value to ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" instead of throwing.","type":"text"}],"title":"init(from:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/init(from:)-1ui3y","role":"symbol","kind":"symbol"}}}