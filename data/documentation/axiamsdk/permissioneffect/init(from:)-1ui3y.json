{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"]]},"abstract":[{"text":"Decodes an unrecognised value to ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" instead of throwing.","type":"text"}],"kind":"symbol","metadata":{"roleHeading":"Initializer","modules":[{"name":"AxiamSDK"}],"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"symbolKind":"init","title":"init(from:)","externalID":"s:8AxiamSDK16PermissionEffectO4fromACs7Decoder_p_tKcfc"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"decoder"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The synthesised "},{"code":"RawRepresentable","type":"codeVoice"},{"type":"text","text":" initializer stays strict — "},{"code":"init(rawValue:)","type":"codeVoice"},{"type":"text","text":" is still"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for a value that is not a case — so code that deliberately parses a raw string"},{"type":"text","text":" "},{"type":"text","text":"keeps its check. Only DECODING, where the alternative is failing a whole response, is"},{"type":"text","text":" "},{"type":"text","text":"lenient."}]}]}],"variants":[{"paths":["\/documentation\/axiamsdk\/permissioneffect\/init(from:)-1ui3y"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/init(from:)-1ui3y","interfaceLanguage":"swift"},"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"title":"PermissionEffect","navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"kind":"symbol","abstract":[{"text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default","type":"text"},{"text":" ","type":"text"},{"text":"deny -> an [","type":"text"},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"text":"] grant permits -> a [","type":"text"},{"code":"PermissionEffect::Deny","type":"codeVoice"},{"text":"] grant","type":"text"},{"text":" ","type":"text"},{"text":"refuses, ","type":"text"},{"inlineContent":[{"type":"text","text":"and beats every allow"}],"type":"strong"},{"text":", wherever either sits in the resource hierarchy. Deny","type":"text"},{"text":" ","type":"text"},{"text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in","type":"text"},{"text":" ","type":"text"},{"text":"full in ","type":"text"},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"text":" §2.1. The short version: deny-override buys one","type":"text"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"type":"text","text":"adding a deny rule can never widen access, and can never be undone by"},{"type":"text","text":" "},{"type":"text","text":"adding allows"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"text":", both mean “allow”. No migration.","type":"text"}],"url":"\/documentation\/axiamsdk\/permissioneffect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect/init(from:)-1ui3y":{"abstract":[{"type":"text","text":"Decodes an unrecognised value to "},{"type":"codeVoice","code":".unknown"},{"text":" instead of throwing.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"from"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{"text":"throws","kind":"keyword"}],"title":"init(from:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect\/init(from:)-1ui3y","url":"\/documentation\/axiamsdk\/permissioneffect\/init(from:)-1ui3y"}}}