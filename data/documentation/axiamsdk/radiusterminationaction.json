{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadiusTerminationAction"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An "},{"inlineContent":[{"type":"text","text":"open"}],"type":"strong"},{"type":"text","text":" enum. A value this SDK’s copy of the spec does not list decodes to "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" "},{"type":"text","text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there"},{"type":"text","text":" "},{"type":"text","text":"fails the WHOLE response, so one field of one record would take down the page it was on,"},{"type":"text","text":" "},{"type":"text","text":"including the records the caller did ask for."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is never written: "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"type":"codeVoice","code":"\"\""},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RadiusTerminationAction","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RadiusTerminationAction\/default","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RadiusTerminationAction\/radiusRequest","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RadiusTerminationAction\/unknown"],"anchor":"Enumeration-Cases","generated":true},{"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RadiusTerminationAction\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RadiusTerminationAction\/init(rawValue:)"],"anchor":"Initializers","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RadiusTerminationAction\/encode(to:)"],"anchor":"Instance-Methods","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RadiusTerminationAction\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RadiusTerminationAction\/RawRepresentable-Implementations"],"anchor":"Default-Implementations","generated":true}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"RadiusTerminationAction","roleHeading":"Enumeration","externalID":"s:8AxiamSDK23RadiusTerminationActionO","symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadiusTerminationAction"}],"role":"symbol","modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"text":"RadiusTerminationAction","kind":"identifier"}]},"kind":"symbol","abstract":[{"code":"Termination-Action","type":"codeVoice"},{"text":" (RFC 2865 §5.29).","type":"text"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\