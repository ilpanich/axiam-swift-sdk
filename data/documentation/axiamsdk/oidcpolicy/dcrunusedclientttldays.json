lient_allowed_resources"},{"type":"text","text":"]. Each"},{"type":"text","text":" "},{"type":"text","text":"names per-tenant resources — "},{"type":"emphasis","inlineContent":[{"type":"text","text":"this"}]},{"type":"text","text":" tenant’s MCP servers, "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" tenant’s callback hosts —"},{"type":"text","text":" "},{"type":"text","text":"and there is no sense in which one such list is stricter than another. A subset rule would"},{"type":"text","text":" "},{"type":"text","text":"force an organization to enumerate every tenant’s resource servers in its own baseline"},{"type":"text","text":" "},{"type":"text","text":"before any tenant could name one. The model’s rule is “a tenant may only be more"},{"type":"text","text":" "},{"type":"text","text":"restrictive”, which binds every field that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"has"}]},{"type":"text","text":" a restrictiveness; a field that has none"},{"type":"text","text":" "},{"type":"text","text":"cannot violate it. One cross-field interlock spans both groups and is checked on the"},{"type":"text","text":" "},{"type":"text","text":"resolved policy rather than on either input: see ["},{"type":"codeVoice","code":"validate_dcr_policy"},{"type":"text","text":"]."}],"navigatorTitle":[{"kind":"identifier","text":"OidcPolicy"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","kind":"symbol","type":"topic","title":"OidcPolicy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OidcPolicy"}],"role":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy"}}}