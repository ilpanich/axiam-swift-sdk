text"},{"text":" ","type":"text"},{"text":"force an organization to enumerate every tenant’s resource servers in its own baseline","type":"text"},{"text":" ","type":"text"},{"text":"before any tenant could name one. The model’s rule is “a tenant may only be more","type":"text"},{"text":" ","type":"text"},{"text":"restrictive”, which binds every field that ","type":"text"},{"inlineContent":[{"type":"text","text":"has"}],"type":"emphasis"},{"text":" a restrictiveness; a field that has none","type":"text"},{"text":" ","type":"text"},{"text":"cannot violate it. One cross-field interlock spans both groups and is checked on the","type":"text"},{"text":" ","type":"text"},{"text":"resolved policy rather than on either input: see [","type":"text"},{"type":"codeVoice","code":"validate_dcr_policy"},{"text":"].","type":"text"}],"title":"OidcPolicy","url":"\/documentation\/axiamsdk\/oidcpolicy"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}