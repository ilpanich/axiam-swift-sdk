on\/axiamsdk\/oidcpolicy","abstract":[{"text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8). Two settings that are not password","type":"text"},{"text":" ","type":"text"},{"text":"rules, and are here because this is the org-baseline-plus-tenant-override surface every","type":"text"},{"text":" ","type":"text"},{"text":"other per-tenant control lives on. They are also the two settings in this model that are","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" of the same kind as each other, so it is worth saying which is which: *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::sensitive_scopes_enabled","type":"codeVoice"},{"type":"text","text":"] "},{"type":"strong","inlineContent":[{"type":"text","text":"is"}]},{"type":"text","text":" ordered. Releasing personal data is the"},{"type":"text","text":" "},{"type":"text","text":"less-restrictive direction, so it is validated disable-only — the mirror image of"},{"type":"text","text":" "},{"code":"mfa_enforced","type":"codeVoice"},{"type":"text","text":" — and a tenant can turn its organization’s decision off but never on. *"},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"Self::default_locale","type":"codeVoice"},{"type":"text","text":"] is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" ordered, and no ordering is invented for it. A language"},{"type":"text","text":" "},{"type":"text","text":"is a presentation preference; there is no sense in which Italian is stricter than French."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"validate_tenant_override","type":"codeVoice"},{"type":"text","text":"] therefore does not check it and ["},{"code":"clamp_overrides_to_org","type":"codeVoice"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"never clears it. The model’s rule is “a tenant may only be more restrictive”, which binds"},{"type":"text","text":" "},{"type":"text","text":"every field that "},{"type":"emphasis","inlineContent":[{"text":"has","type":"text"}]},{"type":"text","text":" a restrictiveness; a field that has none cannot violate it."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","title":"OidcPolicy","role":"symbol","kind":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/init(defaultLocale:sensitiveScopesEnabled:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/init(defaultLocale:sensitiveScopesEnabled:)","kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy\/init(defaultlocale:sensitivescopesenabled:)","type":"topic","title":"init(defaultLocale:sensitiveScopesEnabled:)","abstract":[],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"defaultLocale"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"sensitiveScopesEnabled"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":")"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","role":"collection","type":"topic","url":"\/documentation\/axiamsdk"}}}