elds that can widen, and the seven that cannot [","type":"text"},{"type":"codeVoice","code":"Self::enabled"},{"text":"] and [","type":"text"},{"type":"codeVoice","code":"Self::allow_http"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"are "},{"inlineContent":[{"text":"ordered","type":"text"}],"type":"strong"},{"type":"text","text":": a tenant may turn either off but never on, exactly as"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"domains or "},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"type":"text","text":" bounds, and there is no sense in which one tenant’s list of"},{"type":"text","text":" "},{"type":"text","text":"trusted publishers is stricter than another’s — the same argument ["},{"type":"codeVoice","code":"OidcPolicy"},{"type":"text","text":"] already"},{"type":"text","text":" "},{"type":"text","text":"makes for "},{"type":"codeVoice","code":"dcr_allowed_redirect_hosts"},{"type":"text","text":". # Every bound here is a security control"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::max_metadata_bytes"},{"type":"text","text":"], ["},{"type":"codeVoice","code":"Self::min_cache_secs"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::max_cache_secs"},{"type":"text","text":"] are not"},{"type":"text","text":" "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}],"navigatorTitle":[{"kind":"identifier","text":"CimdPolicy"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/cimd":{"kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/cimd","url":"\/documentation\/axiamsdk\/oidcpolicy\/cimd","title":"cimd","role":"symbol","abstract":[{"type":"text","text":"T21.5 — whether a URL-shaped "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" is resolved by fetching the document it names,"},{"type":"text","text":" "},{"type":"text","text":"and on what terms. See ["},{"type":"codeVoice","code":"CimdPolicy"},{"type":"text","text":"]; off unless somebody turns it on (I1). Nested, and"},{"type":"text","text":" "},{"type":"text","text":"therefore inherited or overridden "},{"type":"strong","inlineContent":[{"type":"text","text":"whole"}]},{"type":"text","text":": the fields are terms of one decision, and a"},{"type":"text","text":" "},{"type":"text","text":"half-merged posture is one neither the organization nor the tenant wrote."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cimd","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CimdPolicy","preciseIdentifier":"s:8AxiamSDK10CimdPolicyV"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy":{"navigatorTitle":[{"text":"OidcPolicy","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OidcPolicy","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","abstract":[{"text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8; T21.4). Settings that are not","type":"text"},{"text":" ","type":"text"},{"text":"password rules, here because this is the org-baseline-plus-tenant-override surface every","type":"text"},{"text":" ","type":"text"},{"text":"other per-tenant control lives on. They are not all of the same kind as each other, and","type":"text"},{"text":" ","type":"text"},{"text":"which is which is the whole of what [","type":"text"},{"type":"codeVoice","code":"validate_tenant_override"},{"text":"] and","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"clamp_overrides_to_org","type":"codeVoice"},{"text":"] read, so it is set out rather than inferred. ","type":"text"},{"inlineContent":[{"text":"Ordered","type":"text"}],"type":"strong"},{"text":" — a","type":"text"},{"text":" ","type":"text"},{"text":"tenant may be stricter than its organization and never more permissive: *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::sensitive_scopes_enabled","type":"codeVoice"},{"text":"], validated ","type":"text"},{"inlineContent":[{"text":"disable-only","type":"text"}],"type":"strong"},{"text":" — the mirror image of","type":"text"},{"text":" ","type":"text"},{"code":"mfa_enforced","type":"codeVoice"},{"text":", because releasing personal data is the less-restrictive direction, so a","type":"text"},{"text":" ","type":"text"},{"text":"tenant can turn its organization’s decision off but never on. *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dynamic_registration","type":"codeVoice"},{"text":"], on the ladder ","type":"text"},{"code":"disabled","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"initial_access_token","type":"codeVoice"},{"text":" →","type":"text"},{"text":" ","type":"text"},{"code":"anonymous","type":"codeVoice"},{"text":": a tenant may move down it and never up. * [","type":"text"},{"code":"Self::dcr_max_clients","type":"codeVoice"},{"text":"] and","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_unused_client_ttl_days","type":"codeVoice"},{"text":"], on the ordinary ","type":"text"},{"code":"tenant <= org","type":"codeVoice"},{"text":" rule — with the","type":"text"},{"text":" ","type":"text"},{"text":"wrinkle that ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" on the second means ","type":"text"},{"inlineContent":[{"type":"text","text":"never sweep"}],"type":"emphasis"},{"text":", which is the longest window of all and","type":"text"},{"text":" ","type":"text"},{"text":"is handled by [","type":"text"},{"code":"dcr_ttl_strictness","type":"codeVoice"},{"text":"]. ","type":"text"},{"inlineContent":[{"type":"text","text":"Not ordered"}],"type":"strong"},{"text":", therefore never validated against the","type":"text"},{"text":" ","type":"text"},{"text":"baseline and never clamped: * [","type":"text"},{"code":"Self::default_locale","type":"codeVoice"},{"text":"]. A language is a presentation","type":"text"},{"text":" ","type":"text"},{"text":"preference; there is no sense in which Italian is stricter than French. *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_allowed_scopes","type":"codeVoice"},{"text":"], [","type":"text"},{"code":"Self::dcr_allowed_redirect_hosts","type":"codeVoice"},{"text":"] and","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::external_client_allowed_resources","type":"codeVoice"},{"text":"]. Each names per-tenant resources — ","type":"text"},{"inlineContent":[{"text":"this","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"tenant’s MCP servers, ","type":"text"},{"inlineContent":[{"type":"text","text":"this"}],"type":"emphasis"},{"text":" tenant’s callback hosts — and there is no sense in which one","type":"text"},{"text":" ","type":"text"},{"text":"such list is stricter than another. A subset rule would force an organization to enumerate","type":"text"},{"text":" ","type":"text"},{"text":"every tenant’s resource servers in its own baseline before any tenant could name one. The","type":"text"},{"text":" ","type":"text"},{"text":"model’s rule is “a tenant may only be more restrictive”, which binds every field that ","type":"text"},{"inlineContent":[{"text":"has","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"a restrictiveness; a field that has none cannot violate it. One cross-field interlock spans","type":"text"},{"text":" ","type":"text"},{"text":"both groups and is checked on the resolved policy rather than on either input: see","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"validate_dcr_policy","type":"codeVoice"},{"text":"].","type":"text"}],"title":"OidcPolicy","kind":"symbol"}}}