tforms":["Linux"],"languages":["swift"]}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/CimdPolicy":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"CimdPolicy"}],"abstract":[{"text":"Whether, and on what terms, a ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" that is a URL is resolved by fetching the document","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it names (T21.5, "},{"type":"codeVoice","code":"draft-ietf-oauth-client-id-metadata-document"},{"type":"text","text":"). # Why this is one nested"},{"type":"text","text":" "},{"type":"text","text":"policy rather than nine fields Every field here is a term of a single decision — "},{"inlineContent":[{"type":"text","text":"do we"},{"type":"text","text":" "},{"type":"text","text":"fetch a stranger’s URL and make a client out of what comes back"}],"type":"emphasis"},{"type":"text","text":" — and none of them means"},{"type":"text","text":" "},{"type":"text","text":"anything without ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"]. A tenant that states a CIMD posture states all of it; a"},{"type":"text","text":" "},{"type":"text","text":"tenant that states none inherits its organization’s whole posture rather than half of one,"},{"type":"text","text":" "},{"type":"text","text":"which is the only merge that cannot produce a combination neither party wrote. # The two"},{"type":"text","text":" "},{"type":"text","text":"fields that can widen, and the seven that cannot ["},{"type":"codeVoice","code":"Self::enabled"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::allow_http"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"are "},{"inlineContent":[{"type":"text","text":"ordered"}],"type":"strong"},{"type":"text","text":": a tenant may turn either off but never on, exactly as"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"inlineContent":[{"type":"text","text":"this tenant’s"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"domains or "},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"type":"text","text":" bounds, and there is no sense in which one tenant’s list of"},{"type":"text","text":" "},{"type":"text","text":"trusted publishers is stricter than another’s — the same argument ["},{"type":"codeVoice","code":"OidcPolicy"},{"type":"text","text":"] already"},{"type":"text","text":" "},{"type":"text","text":"makes for "},{"type":"codeVoice","code":"dcr_allowed_redirect_hosts"},{"type":"text","text":". # Every bound here is a security control"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::max_metadata_bytes"},{"type":"text","text":"], ["},{"type":"codeVoice","code":"Self::min_cache_secs"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::max_cache_secs"},{"type":"text","text":"] are not"},{"type":"text","text":" "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CimdPolicy"}],"kind":"symbol","title":"CimdPolicy","url":"\/documentation\/axiamsdk\/cimdpolicy","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CimdPolicy"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy":{"abstract":[{"text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8; T21.4). Settings that are not","type":"text"},{"text":" ","type":"text"},{"text":"password rules, here because this is the org-baseline-plus-tenant-override surface every","type":"text"},{"text":" ","type":"text"},{"text":"other per-tenant control lives on. They are not all of the same kind as each other, and","type":"text"},{"text":" ","type":"text"},{"text":"which is which is the whole of what [","type":"text"},{"type":"codeVoice","code":"validate_tenant_override"},{"text":"] and","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"type":"codeVoice","code":"clamp_overrides_to_org"},{"type":"text","text":"] read, so it is set out rather than inferred. "},{"inlineContent":[{"text":"Ordered","type":"text"}],"type":"strong"},{"type":"text","text":" — a"},{"type":"text","text":" "},{"type":"text","text":"tenant may be stricter than its organization and never more permissive: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"type":"text","text":"], validated "},{"type":"strong","inlineContent":[{"text":"disable-only","type":"text"}]},{"type":"text","text":" — the mirror image of"},{"type":"text","text":" "},{"type":"codeVoice","code":"mfa_enforced"},{"type":"text","text":", because releasing personal data is the less-restrictive direction, so a"},{"type":"text","text":" "},{"type":"text","text":"tenant can turn its organization’s decision off but never on. * ["},{"type":"codeVoice","code":"Self::saml_idp_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"type":"strong","inlineContent":[{"type":"text","text":"disable-only"}]},{"type":"text","text":" exactly like ["},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"type":"text","text":"] (D-20): a tenant"},{"type":"text","text":" "},{"type":"text","text":"may turn its organization’s "},{"type":"codeVoice","code":"true"},{"type":"text","text":" off and never its "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on. * ["},{"type":"codeVoice","code":"Self::ssf_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"type":"strong","inlineContent":[{"type":"text","text":"disable-only"}]},{"type":"text","text":" the same way (D-45). * ["},{"type":"codeVoice","code":"Self::dynamic_registration"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ladder "},{"type":"codeVoice","code":"disabled"},{"type":"text","text":" → "},{"type":"codeVoice","code":"initial_access_token"},{"type":"text","text":" → "},{"type":"codeVoice","code":"anonymous"},{"type":"text","text":": a tenant may move down it and"},{"type":"text","text":" "},{"type":"text","text":"never up. * ["},{"type":"codeVoice","code":"Self::dcr_max_clients"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::dcr_unused_client_ttl_days"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ordinary "},{"type":"codeVoice","code":"tenant <= org"},{"type":"text","text":" rule — with the wrinkle that "},{"type":"codeVoice","code":"0"},{"type":"text","text":" on the second means "},{"type":"emphasis","inlineContent":[{"text":"never sweep","type":"text"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which is the longest window of all and is handled by ["},{"type":"codeVoice","code":"dcr_ttl_strictness"},{"type":"text","text":"]. "},{"type":"strong","inlineContent":[{"type":"text","text":"Not"},{"type":"text","text":" "},{"type":"text","text":"ordered"}]},{"type":"text","text":", therefore never validated against the baseline and never clamped: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::default_locale"},{"type":"text","text":"]. A language is a presentation preference; there is no sense in"},{"type":"text","text":" "},{"type":"text","text":"which Italian is stricter than French. * ["},{"type":"codeVoice","code":"Self::dcr_allowed_scopes"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::dcr_allowed_redirect_hosts"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::external_client_allowed_resources"},{"type":"text","text":"]. Each"},{"type":"text","text":" "},{"type":"text","text":"names per-tenant resources — "},{"type":"emphasis","inlineContent":[{"type":"text","text":"this"}]},{"type":"text","text":" tenant’s MCP servers, "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" tenant’s callback hosts —"},{"type":"text","text":" "},{"type":"text","text":"and there is no sense in which one such list is stricter than another. A subset rule would"},{"type":"text","text":" "},{"type":"text","text":"force an organization to enumerate every tenant’s resource servers in its own baseline"},{"type":"text","text":" "},{"type":"text","text":"before any tenant could name one. The model’s rule is “a tenant may only be more"},{"type":"text","text":" "},{"type":"text","text":"restrictive”, which binds every field that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"has"}]},{"type":"text","text":" a restrictiveness; a field that has none"},{"type":"text","text":" "},{"type":"text","text":"cannot violate it. One cross-field interlock spans both groups and is checked on the"},{"type":"text","text":" "},{"type":"text","text":"resolved policy rather than on either input: see ["},{"type":"codeVoice","code":"validate_dcr_policy"},{"type":"text","text":"]."}],"navigatorTitle":[{"kind":"identifier","text":"OidcPolicy"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","kind":"symbol","type":"topic","title":"OidcPolicy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OidcPolicy"}],"role":"symbol","url":"\/documentation\/axiamsdk\/oidcpolicy"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/cimd":{"type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy\/cimd","title":"cimd","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"T21.5 — whether a URL-shaped "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" is resolved by fetching the document it names,"},{"text":" ","type":"text"},{"text":"and on what terms. See [","type":"text"},{"code":"CimdPolicy","type":"codeVoice"},{"text":"]; off unless somebody turns it on (I1). Nested, and","type":"text"},{"text":" ","type":"text"},{"text":"therefore inherited or overridden ","type":"text"},{"inlineContent":[{"type":"text","text":"whole"}],"type":"strong"},{"text":": the fields are terms of one decision, and a","type":"text"},{"text":" ","type":"text"},{"text":"half-merged posture is one neither the organization nor the tenant wrote.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/cimd","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"cimd"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK10CimdPolicyV","kind":"typeIdentifier","text":"CimdPolicy"},{"kind":"text","text":"?"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}