text","text":" "},{"type":"codeVoice","code":"dynamic_registration"},{"type":"text","text":" may only move down its ladder. Everything else names "},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"domains or "},{"inlineContent":[{"text":"this tenant’s","type":"text"}],"type":"emphasis"},{"type":"text","text":" bounds, and there is no sense in which one tenant’s list of"},{"type":"text","text":" "},{"type":"text","text":"trusted publishers is stricter than another’s — the same argument ["},{"type":"codeVoice","code":"OidcPolicy"},{"type":"text","text":"] already"},{"type":"text","text":" "},{"type":"text","text":"makes for "},{"type":"codeVoice","code":"dcr_allowed_redirect_hosts"},{"type":"text","text":". # Every bound here is a security control"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::max_metadata_bytes"},{"type":"text","text":"], ["},{"type":"codeVoice","code":"Self::min_cache_secs"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::max_cache_secs"},{"type":"text","text":"] are not"},{"type":"text","text":" "},{"type":"text","text":"tuning knobs. They are, respectively, the ceiling on a read from an attacker-chosen URL, the"},{"type":"text","text":" "},{"type":"text","text":"floor under how often that read may be repeated, and the ceiling on how long its result may"},{"type":"text","text":" "},{"type":"text","text":"be trusted. Each is clamped again in code against the three constants above, so a settings"},{"type":"text","text":" "},{"type":"text","text":"row written by hand cannot lift them."}],"navigatorTitle":[{"kind":"identifier","text":"CimdPolicy"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy":{"navigatorTitle":[{"text":"OidcPolicy","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/oidcpolicy","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","ki