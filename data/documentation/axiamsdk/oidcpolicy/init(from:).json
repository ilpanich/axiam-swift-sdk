{"kind":"symbol","variants":[{"paths":["\/documentation\/axiamsdk\/oidcpolicy\/init(from:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"decoder","kind":"internalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"Decodable.init(from:)"},{"type":"text","text":"."}],"metadata":{"role":"symbol","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"externalID":"s:8AxiamSDK10OidcPolicyV4fromACs7Decoder_p_tKcfc","title":"init(from:)","modules":[{"name":"AxiamSDK"}],"symbolKind":"init"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/init(from:)"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy":{"url":"\/documentation\/axiamsdk\/oidcpolicy","abstract":[{"text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8; T21.4). Settings that are not","type":"text"},{"text":" ","type":"text"},{"text":"password rules, here because this is the org-baseline-plus-tenant-override surface every","type":"text"},{"text":" ","type":"text"},{"text":"other per-tenant control lives on. They are not all of the same kind as each other, and","type":"text"},{"text":" ","type":"text"},{"text":"which is which is the whole of what [","type":"text"},{"code":"validate_tenant_override","type":"codeVoice"},{"text":"] and","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"clamp_overrides_to_org","type":"codeVoice"},{"text":"] read, so it is set out rather than inferred. ","type":"text"},{"inlineContent":[{"type":"text","text":"Ordered"}],"type":"strong"},{"text":" — a","type":"text"},{"text":" ","type":"text"},{"text":"tenant may be stricter than its organization and never more permissive: *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::sensitive_scopes_enabled","type":"codeVoice"},{"text":"], validated ","type":"text"},{"inlineContent":[{"type":"text","text":"disable-only"}],"type":"strong"},{"text":" — the mirror image of","type":"text"},{"text":" ","type":"text"},{"code":"mfa_enforced","type":"codeVoice"},{"text":", because releasing personal data is the less-restrictive direction, so a","type":"text"},{"text":" ","type":"text"},{"text":"tenant can turn its organization’s decision off but never on. * [","type":"text"},{"code":"Self::saml_idp_enabled","type":"codeVoice"},{"text":"],","type":"text"},{"text":" ","type":"text"},{"text":"validated ","type":"text"},{"inlineContent":[{"text":"disable-only","type":"text"}],"type":"strong"},{"text":" exactly like [","type":"text"},{"code":"Self::sensitive_scopes_enabled","type":"codeVoice"},{"text":"] (D-20): a tenant","type":"text"},{"text":" ","type":"text"},{"text":"may turn its organization’s ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" off and never its ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" on. * [","type":"text"},{"code":"Self::ssf_enabled","type":"codeVoice"},{"text":"],","type":"text"},{"text":" ","type":"text"},{"text":"validated ","type":"text"},{"inlineContent":[{"text":"disable-only","type":"text"}],"type":"strong"},{"text":" the same way (D-45). * [","type":"text"},{"code":"Self::dynamic_registration","type":"codeVoice"},{"text":"], on the","type":"text"},{"text":" ","type":"text"},{"text":"ladder ","type":"text"},{"code":"disabled","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"initial_access_token","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"anonymous","type":"codeVoice"},{"text":": a tenant may move down it and","type":"text"},{"text":" ","type":"text"},{"text":"never up. * [","type":"text"},{"code":"Self::dcr_max_clients","type":"codeVoice"},{"text":"] and [","type":"text"},{"code":"Self::dcr_unused_client_ttl_days","type":"codeVoice"},{"text":"], on the","type":"text"},{"text":" ","type":"text"},{"text":"ordinary ","type":"text"},{"code":"tenant <= org","type":"codeVoice"},{"text":" rule — with the wrinkle that ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" on the second means ","type":"text"},{"inlineContent":[{"text":"never sweep","type":"text"}],"type":"emphasis"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which is the longest window of all and is handled by [","type":"text"},{"code":"dcr_ttl_strictness","type":"codeVoice"},{"text":"]. ","type":"text"},{"inlineContent":[{"text":"Not","type":"text"},{"text":" ","type":"text"},{"text":"ordered","type":"text"}],"type":"strong"},{"text":", therefore never validated against the baseline and never clamped: *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::default_locale","type":"codeVoice"},{"text":"]. A language is a presentation preference; there is no sense in","type":"text"},{"text":" ","type":"text"},{"text":"which Italian is stricter than French. * [","type":"text"},{"code":"Self::dcr_allowed_scopes","type":"codeVoice"},{"text":"],","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_allowed_redirect_hosts","type":"codeVoice"},{"text":"] and [","type":"text"},{"code":"Self::external_client_allowed_resources","type":"codeVoice"},{"text":"]. Each","type":"text"},{"text":" ","type":"text"},{"text":"names per-tenant resources — ","type":"text"},{"inlineContent":[{"type":"text","text":"this"}],"type":"emphasis"},{"text":" tenant’s MCP servers, ","type":"text"},{"inlineContent":[{"type":"text","text":"this"}],"type":"emphasis"},{"text":" tenant’s callback hosts —","type":"text"},{"text":" ","type":"text"},{"text":"and there is no sense in which one such list is stricter than another. A subset rule would","type":"text"},{"text":" ","type":"text"},{"text":"force an organization to enumerate every tenant’s resource servers in its own baseline","type":"text"},{"text":" ","type":"text"},{"text":"before any tenant could name one. The model’s rule is “a tenant may only be more","type":"text"},{"text":" ","type":"text"},{"text":"restrictive”, which binds every field that ","type":"text"},{"inlineContent":[{"text":"has","type":"text"}],"type":"emphasis"},{"text":" a restrictiveness; a field that has none","type":"text"},{"text":" ","type":"text"},{"text":"cannot violate it. One cross-field interlock spans both groups and is checked on the","type":"text"},{"text":" ","type":"text"},{"text":"resolved policy rather than on either input: see [","type":"text"},{"code":"validate_dcr_policy","type":"codeVoice"},{"text":"].","type":"text"}],"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"OidcPolicy"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OidcPolicy"}],"title":"OidcPolicy","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc