text":"disable-only"}],"type":"strong"},{"text":" — the mirror image of","type":"text"},{"text":" ","type":"text"},{"code":"mfa_enforced","type":"codeVoice"},{"text":", because releasing personal data is the less-restrictive direction, so a","type":"text"},{"text":" ","type":"text"},{"text":"tenant can turn its organization’s decision off but never on. *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dynamic_registration","type":"codeVoice"},{"text":"], on the ladder ","type":"text"},{"code":"disabled","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"initial_access_token","type":"codeVoice"},{"text":" →","type":"text"},{"text":" ","type":"text"},{"code":"anonymous","type":"codeVoice"},{"text":": a tenant may move down it and never up. * [","type":"text"},{"code":"Self::dcr_max_clients","type":"codeVoice"},{"text":"] and","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_unused_client_ttl_days","type":"codeVoice"},{"text":"], on the ordinary ","type":"text"},{"code":"tenant <= org","type":"codeVoice"},{"text":" rule — with the","type":"text"},{"text":" ","type":"text"},{"text":"wrinkle that ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" on the second means ","type":"text"},{"inlineContent":[{"type":"text","text":"never sweep"}],"type":"emphasis"},{"text":", which is the longest window of all and","type":"text"},{"text":" ","type":"text"},{"text":"is handled by [","type":"text"},{"code":"dcr_ttl_strictness","type":"codeVoice"},{"text":"]. ","type":"text"},{"inlineContent":[{"text":"Not ordered","type":"text"}],"type":"strong"},{"text":", therefore never validated against the","type":"text"},{"text":" ","type":"text"},{"text":"baseline and never clamped: * [","type":"text"},{"code":"Self::default_locale","type":"codeVoice"},{"text":"]. A language is a presentation","type":"text"},{"text":" ","type":"text"},{"text":"preference; there is no sense in which Italian is stricter than French. *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::dcr_allowed_scopes","type":"codeVoice"},{"text":"], [","type":"text"},{"code":"Self::dcr_allowed_redirect_hosts","type":"codeVoice"},{"text":"] and","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::external_client_allowed_resources","type":"codeVoice"},{"text":"]. Each names per-tenant resources — ","type":"text"},{"inlineContent":[{"text":"this","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"tenant’s MCP servers, ","type":"text"},{"inlineContent":[{"text":"this","type":"text"}],"type":"emphasis"},{"text":" tenant’s callback hosts — and there is no sense in which one","type":"text"},{"text":" ","type":"text"},{"text":"such list is stricter than another. A subset rule would force an organization to enumerate","type":"text"},{"text":" ","type":"text"},{"text":"every tenant’s resource servers in its own baseline before any tenant could name one. The","type":"text"},{"text":" ","type":"text"},{"text":"model’s rule is “a tenant may only be more restrictive”, which binds every field that ","type":"text"},{"inlineContent":[{"text":"has","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"a restrictiveness; a field that has none cannot violate it. One cross-field interlock spans","type":"text"},{"text":" ","type":"text"},{"text":"both groups and is checked on the resolved policy rather than on either input: see","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"validate_dcr_policy","type":"codeVoice"},{"text":"].","type":"text"}],"type":"topic","title":"OidcPolicy"}}}