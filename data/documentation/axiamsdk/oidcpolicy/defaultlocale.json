t"},{"code":"mfa_enforced","type":"codeVoice"},{"text":" — and a tenant can turn its organization’s decision off but never on. *","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"Self::default_locale","type":"codeVoice"},{"text":"] is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" ordered, and no ordering is invented for it. A language","type":"text"},{"text":" ","type":"text"},{"text":"is a presentation preference; there is no sense in which Italian is stricter than French.","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"code":"validate_tenant_override","type":"codeVoice"},{"text":"] therefore does not check it and [","type":"text"},{"code":"clamp_overrides_to_org","type":"codeVoice"},{"text":"]","type":"text"},{"text":" ","type":"text"},{"text":"never clears it. The model’s rule is “a tenant may only be more restrictive”, which binds","type":"text"},{"text":" ","type":"text"},{"text":"every field that ","type":"text"},{"inlineContent":[{"type":"text","text":"has"}],"type":"emphasis"},{"text":" a restrictiveness; a field that has none cannot violate it.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OidcPolicy"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/defaultLocale":{"title":"defaultLocale","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLocale"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/O