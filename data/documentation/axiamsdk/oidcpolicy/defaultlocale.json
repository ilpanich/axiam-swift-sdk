{"metadata":{"externalID":"s:8AxiamSDK10OidcPolicyV13defaultLocaleSSSgvp","title":"defaultLocale","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLocale","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"role":"symbol","symbolKind":"property"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/defaultLocale","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The BCP 47 tag the sign-in page falls back to when the relying party’s "},{"type":"codeVoice","code":"ui_locales"},{"type":"text","text":" "},{"type":"text","text":"selects nothing (W5’s chain, plan §4.6). "},{"type":"codeVoice","code":"None"},{"type":"text","text":" means “no tenant preference”, which"},{"type":"text","text":" "},{"type":"text","text":"lands on the deployment default ("},{"type":"codeVoice","code":"en"},{"type":"text","text":") — the behaviour every deployment had before this"},{"type":"text","text":" "},{"type":"text","text":"field existed. A tag this build does not ship also lands there: the parse is exact"},{"type":"text","text":" "},{"type":"text","text":"rather than a language lookup, so a stored "},{"type":"codeVoice","code":"fr-CA"},{"type":"text","text":" reads as “somebody wrote something"},{"type":"text","text":" "},{"type":"text","text":"this binary does not ship” rather than as a guess at French. Stored as a string rather"},{"type":"text","text":" "},{"type":"text","text":"than as the "},{"type":"codeVoice","code":"Locale"},{"type":"text","text":" enum because that enum lives in "},{"type":"codeVoice","code":"axiam-oauth2"},{"type":"text","text":", four layers above"},{"type":"text","text":" "},{"type":"text","text":"this crate, and the crate layering points inward."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLocale"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/oidcpolicy\/defaultlocale"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy":{"url":"\/documentation\/axiamsdk\/oidcpolicy","navigatorTitle":[{"text":"OidcPolicy","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OidcPolicy","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","role":"symbol","abstract":[{"type":"text","text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8; T21.4). Settings that are not"},{"type":"text","text":" "},{"type":"text","text":"password rules, here because this is the org-baseline-plus-tenant-override surface every"},{"type":"text","text":" "},{"type":"text","text":"other per-tenant control lives on. They are not all of the same kind as each other, and"},{"type":"text","text":" "},{"type":"text","text":"which is which is the whole of what ["},{"type":"codeVoice","code":"validate_tenant_override"},{"type":"text","text":"] and"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"clamp_overrides_to_org"},{"type":"text","text":"] read, so it is set out rather than inferred. "},{"inlineContent":[{"text":"Ordered","type":"text"}],"type":"strong"},{"type":"text","text":" — a"},{"type":"text","text":" "},{"type":"text","text":"tenant may be stricter than its organization and never more permissive: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"type":"text","text":"], validated "},{"inlineContent":[{"type":"text","text":"disable-only"}],"type":"strong"},{"type":"text","text":" — the mirror image of"},{"type":"text","text":" "},{"type":"codeVoice","code":"mfa_enforced"},{"type":"text","text":", because releasing personal data is the less-restrictive direction, so a"},{"type":"text","text":" "},{"type":"text","text":"tenant can turn its organization’s decision off but never on. * ["},{"type":"codeVoice","code":"Self::saml_idp_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"inlineContent":[{"type":"text","text":"disable-only"}],"type":"strong"},{"type":"text","text":" exactly like ["},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"type":"text","text":"] (D-20): a tenant"},{"type":"text","text":" "},{"type":"text","text":"may turn its organization’s "},{"type":"codeVoice","code":"true"},{"type":"text","text":" off and never its "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on. * ["},{"type":"codeVoice","code":"Self::ssf_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"inlineContent":[{"text":"disable-only","type":"text"}],"type":"strong"},{"type":"text","text":" the same way (D-45). * ["},{"type":"codeVoice","code":"Self::dynamic_registration"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ladder "},{"type":"codeVoice","code":"disabled"},{"type":"text","text":" → "},{"type":"codeVoice","code":"initial_access_token"},{"type":"text","text":" → "},{"type":"codeVoice","code":"anonymous"},{"type":"text","text":": a tenant may move down it and"},{"type":"text","text":" "},{"type":"text","text":"never up. * ["},{"type":"codeVoice","code":"Self::dcr_max_clients"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::dcr_unused_client_ttl_days"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ordinary "},{"type":"codeVoice","code":"tenant <= org"},{"type":"text","text":" rule — with the wrinkle that "},{"type":"codeVoice","code":"0"},{"type":"text","text":" on the second means "},{"inlineContent":[{"text":"never sweep","type":"text"}],"type":"emphasis"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which is the longest window of all and is handled by ["},{"type":"codeVoice","code":"dcr_ttl_strictness"},{"type":"text","text":"]. "},{"inlineContent":[{"type":"text","text":"Not"},{"type":"text","text":" "},{"type":"text","text":"ordered"}],"type":"strong"},{"type":"text","text":", therefore never validated against the baseline and never clamped: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::default_locale"},{"type":"text","text":"]. A language is a presentation preference; there is no sense in"},{"type":"text","text":" "},{"type":"text","text":"which Italian is stricter than French. * ["},{"type":"codeVoice","code":"Self::dcr_allowed_scopes"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::dcr_allowed_redirect_hosts"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::external_client_allowed_resources"},{"type":"text","text":"]. Each"},{"type":"text","text":" "},{"type":"text","text":"names per-tenant resources — "},{"inlineContent":[{"text":"this","type":"text"}],"type":"emphasis"},{"type":"text","text":" tenant’s MCP servers, "},{"inlineContent":[{"text":"this","type":"text"}],"type":"emphasis"},{"type":"text","text":" tenant’s callback hosts —"},{"type":"text","text":" "},{"type":"text","text":"and there is no sense in which one such list is stricter than another. A subset rule would"},{"type":"text","text":" "},{"type":"text","text":"force an organization to enumerate every tenant’s resource servers in its own baseline"},{"type":"text","text":" "},{"type":"text","text":"before any tenant could name one. The model’s rule is “a tenant may only be more"},{"type":"text","text":" "},{"type":"text","text":"restrictive”, which binds every field that "},{"inlineContent":[{"type":"text","text":"has"}],"type":"emphasis"},{"type":"text","text":" a restrictiveness; a field that has none"},{"type":"text","text":" "},{"type":"text","text":"cannot violate it. One cross-field interlock spans both groups and is checked on the"},{"type":"text","text":" "},{"type":"text","text":"resolved policy rather than on either input: see ["},{"type":"codeVoice","code":"validate_dcr_policy"},{"type":"text","text":"]."}],"title":"OidcPolicy"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/defaultLocale":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The BCP 47 tag the sign-in page falls back to when the relying party’s "},{"type":"codeVoice","code":"ui_locales"},{"type":"text","text":" "},{"type":"text","text":"selects nothing (W5’s chain, plan §4.6). "},{"type":"codeVoice","code":"None"},{"type":"text","text":" means “no tenant preference”, which"},{"text":" ","type":"text"},{"text":"lands on the deployment default (","type":"text"},{"code":"en","type":"codeVoice"},{"text":") — the behaviour every deployment had before this","type":"text"},{"text":" ","type":"text"},{"text":"field existed. A tag this build does not ship also lands there: the parse is exact","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"rather than a language lookup, so a stored "},{"type":"codeVoice","code":"fr-CA"},{"type":"text","text":" reads as “somebody wrote something"},{"type":"text","text":" "},{"type":"text","text":"this binary does not ship” rather than as a guess at French. Stored as a string rather"},{"type":"text","text":" "},{"type":"text","text":"than as the "},{"code":"Locale","type":"codeVoice"},{"text":" enum because that enum lives in ","type":"text"},{"code":"axiam-oauth2","type":"codeVoice"},{"text":", four layers above","type":"text"},{"text":" ","type":"text"},{"text":"this crate, and the crate layering points inward.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLocale"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"title":"defaultLocale","url":"\/documentation\/axiamsdk\/oidcpolicy\/defaultlocale","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/defaultLocale"},"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"}}}