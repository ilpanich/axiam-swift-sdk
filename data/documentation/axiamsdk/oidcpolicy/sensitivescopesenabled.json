ated ","type":"text"},{"inlineContent":[{"text":"disable-only","type":"text"}],"type":"strong"},{"text":" — the mirror image of","type":"text"},{"text":" ","type":"text"},{"code":"mfa_enforced","type":"codeVoice"},{"text":", because releasing personal data is the less-restrictive direction, so a","type":"text"},{"text":" ","type":"text"},{"text":"tenant can turn its organization’s decision off but never on. * [","type":"text"},{"code":"Self::saml_idp_enabled","type":"codeVoice"},{"text":"],","type":"text"},{"text":" ","type":"text"},{"text":"validated ","type":"text"},{"inlineContent":[{"text":"disable-only","type":"text"}],"type":"strong"},{"text":" exactly like [","type":"text"},{"code":"Self::sensitive_scopes_enabled","type":"codeVoice"},{"text":"] (D-20): a tenant","type":"text"},{"text":" ","type":"text"},{"text":"may turn its organization’s ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" off and never its ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" on. * [","type":"text"},{"code":"Self::ssf_enabled","type":"codeVoice"},{"text":"],","type":"text"},{"text":" ","type":"text"},{"text":"validated ","type":"text"},{"inlineContent":[{"type":"text","text":"disable-only"}],"type":"strong"},{"text":" the same way (D-45). * [","type":"text"},{"code":"Self::dynamic_registration","type":"codeVoice"},{"text":"], on the","type":"text"},{"text":" ","type":"text"},{"text":"ladder ","type":"text"},{"code":"disabled","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"initial_access_token","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"anonymous","type":"codeVoice"},{"text":": a tenant may move down it and","type":"text"},{"text":" ","type":"text"},{"text":"never up. * [","type":"text"},{"code":"Self::dcr_max_clients","type":"codeVoice"},{"text":"] and [","type":"text"},{"code":"Self::dcr_unused_client_ttl_days","type":"codeVoice"},{"text":"], on the","type":"text"},{"text":" ","type":"text"},{"text":"ordinary ","type":"text"},{"