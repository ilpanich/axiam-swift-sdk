{"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveScopesEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/sensitiveScopesEnabled","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"address"},{"type":"text","text":" and "},{"type":"codeVoice","code":"phone"},{"type":"text","text":" may be registered on a client, requested at the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint, and released at UserInfo (X7 G8). "},{"type":"strong","inlineContent":[{"type":"text","text":"Off unless an organization"},{"type":"text","text":" "},{"type":"text","text":"turns it on."}]},{"type":"text","text":" The two scopes release a postal address and a telephone number —"},{"type":"text","text":" "},{"type":"text","text":"categories of personal data AXIAM has no other use for — so the deployment that has"},{"type":"text","text":" "},{"type":"text","text":"never thought about them releases nothing, and the operator who has thought about them"},{"type":"text","text":" "},{"type":"text","text":"says so once, at the organization level, where the lawful basis for holding the data was"},{"type":"text","text":" "},{"type":"text","text":"decided. The switch is a "},{"type":"emphasis","inlineContent":[{"text":"capability","type":"text"}]},{"type":"text","text":", not a grant: with it on, a client still has to"},{"type":"text","text":" "},{"type":"text","text":"register the scope, the request still has to ask for it, and the user still has to have"},{"type":"text","text":" "},{"type":"text","text":"consented. It is the first of four gates, and it is the only one an operator can close"},{"type":"text","text":" "},{"type":"text","text":"for everybody at once."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy"]]},"kind":"symbol","metadata":{"modules":[{"name":"AxiamSDK"}],"title":"sensitiveScopesEnabled","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveScopesEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"role":"symbol","roleHeading":"Instance Property","externalID":"s:8AxiamSDK10OidcPolicyV22sensitiveScopesEnabledSbvp","symbolKind":"property"},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/axiamsdk\/oidcpolicy\/sensitivescopesenabled"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy":{"navigatorTitle":[{"text":"OidcPolicy","kind":"identifier"}],"type":"topic","title":"OidcPolicy","abstract":[{"type":"text","text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8; T21.4). Settings that are not"},{"type":"text","text":" "},{"type":"text","text":"password rules, here because this is the org-baseline-plus-tenant-override surface every"},{"type":"text","text":" "},{"type":"text","text":"other per-tenant control lives on. They are not all of the same kind as each other, and"},{"type":"text","text":" "},{"type":"text","text":"which is which is the whole of what ["},{"type":"codeVoice","code":"validate_tenant_override"},{"type":"text","text":"] and"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"clamp_overrides_to_org"},{"type":"text","text":"] read, so it is set out rather than inferred. "},{"type":"strong","inlineContent":[{"text":"Ordered","type":"text"}]},{"type":"text","text":" — a"},{"type":"text","text":" "},{"type":"text","text":"tenant may be stricter than its organization and never more permissive: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"type":"text","text":"], validated "},{"type":"strong","inlineContent":[{"text":"disable-only","type":"text"}]},{"type":"text","text":" — the mirror image of"},{"type":"text","text":" "},{"type":"codeVoice","code":"mfa_enforced"},{"type":"text","text":", because releasing personal data is the less-restrictive direction, so a"},{"type":"text","text":" "},{"type":"text","text":"tenant can turn its organization’s decision off but never on. * ["},{"type":"codeVoice","code":"Self::saml_idp_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"type":"strong","inlineContent":[{"type":"text","text":"disable-only"}]},{"type":"text","text":" exactly like ["},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"type":"text","text":"] (D-20): a tenant"},{"type":"text","text":" "},{"type":"text","text":"may turn its organization’s "},{"type":"codeVoice","code":"true"},{"type":"text","text":" off and never its "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on. * ["},{"type":"codeVoice","code":"Self::ssf_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"type":"strong","inlineContent":[{"type":"text","text":"disable-only"}]},{"type":"text","text":" the same way (D-45). * ["},{"type":"codeVoice","code":"Self::dynamic_registration"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ladder "},{"type":"codeVoice","code":"disabled"},{"type":"text","text":" → "},{"type":"codeVoice","code":"initial_access_token"},{"type":"text","text":" → "},{"type":"codeVoice","code":"anonymous"},{"type":"text","text":": a tenant may move down it and"},{"type":"text","text":" "},{"type":"text","text":"never up. * ["},{"type":"codeVoice","code":"Self::dcr_max_clients"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::dcr_unused_client_ttl_days"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ordinary "},{"type":"codeVoice","code":"tenant <= org"},{"type":"text","text":" rule — with the wrinkle that "},{"type":"codeVoice","code":"0"},{"type":"text","text":" on the second means "},{"type":"emphasis","inlineContent":[{"text":"never sweep","type":"text"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which is the longest window of all and is handled by ["},{"type":"codeVoice","code":"dcr_ttl_strictness"},{"type":"text","text":"]. "},{"type":"strong","inlineContent":[{"text":"Not","type":"text"},{"text":" ","type":"text"},{"text":"ordered","type":"text"}]},{"type":"text","text":", therefore never validated against the baseline and never clamped: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::default_locale"},{"type":"text","text":"]. A language is a presentation preference; there is no sense in"},{"type":"text","text":" "},{"type":"text","text":"which Italian is stricter than French. * ["},{"type":"codeVoice","code":"Self::dcr_allowed_scopes"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::dcr_allowed_redirect_hosts"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::external_client_allowed_resources"},{"type":"text","text":"]. Each"},{"type":"text","text":" "},{"type":"text","text":"names per-tenant resources — "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" tenant’s MCP servers, "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" tenant’s callback hosts —"},{"type":"text","text":" "},{"type":"text","text":"and there is no sense in which one such list is stricter than another. A subset rule would"},{"type":"text","text":" "},{"type":"text","text":"force an organization to enumerate every tenant’s resource servers in its own baseline"},{"type":"text","text":" "},{"type":"text","text":"before any tenant could name one. The model’s rule is “a tenant may only be more"},{"type":"text","text":" "},{"type":"text","text":"restrictive”, which binds every field that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"has"}]},{"type":"text","text":" a restrictiveness; a field that has none"},{"type":"text","text":" "},{"type":"text","text":"cannot violate it. One cross-field interlock spans both groups and is checked on the"},{"type":"text","text":" "},{"type":"text","text":"resolved policy rather than on either input: see ["},{"type":"codeVoice","code":"validate_dcr_policy"},{"type":"text","text":"]."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","url":"\/documentation\/axiamsdk\/oidcpolicy","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OidcPolicy","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/sensitiveScopesEnabled":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Whether "},{"code":"address","type":"codeVoice"},{"type":"text","text":" and "},{"code":"phone","type":"codeVoice"},{"type":"text","text":" may be registered on a client, requested at the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint, and released at UserInfo (X7 G8). "},{"type":"strong","inlineContent":[{"type":"text","text":"Off unless an organization"},{"type":"text","text":" "},{"type":"text","text":"turns it on."}]},{"type":"text","text":" The two scopes release a postal address and a telephone number —"},{"type":"text","text":" "},{"type":"text","text":"categories of personal data AXIAM has no other use for — so the deployment that has"},{"type":"text","text":" "},{"type":"text","text":"never thought about them releases nothing, and the operator who has thought about them"},{"type":"text","text":" "},{"type":"text","text":"says so once, at the organization level, where the lawful basis for holding the data was"},{"type":"text","text":" "},{"type":"text","text":"decided. The switch is a "},{"type":"emphasis","inlineContent":[{"text":"capability","type":"text"}]},{"type":"text","text":", not a grant: with it on, a client still has to"},{"type":"text","text":" "},{"type":"text","text":"register the scope, the request still has to ask for it, and the user still has to have"},{"type":"text","text":" "},{"type":"text","text":"consented. It is the first of four gates, and it is the only one an operator can close"},{"type":"text","text":" "},{"type":"text","text":"for everybody at once."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/sensitiveScopesEnabled","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveScopesEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/sensitivescopesenabled","title":"sensitiveScopesEnabled"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"}}}