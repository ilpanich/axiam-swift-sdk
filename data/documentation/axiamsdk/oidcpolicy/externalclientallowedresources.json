{"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/externalClientAllowedResources","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"externalClientAllowedResources"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]?"}],"platforms":["Linux"],"languages":["swift"]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"AxiamSDK"}],"symbolKind":"property","title":"externalClientAllowedResources","role":"symbol","roleHeading":"Instance Property","externalID":"s:8AxiamSDK10OidcPolicyV30externalClientAllowedResourcesSaySSGSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"externalClientAllowedResources","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]?","kind":"text"}]},"abstract":[{"type":"strong","inlineContent":[{"type":"text","text":"D3"}]},{"type":"text","text":" — the audiences an externally registered client may address. The single most"},{"type":"text","text":" "},{"type":"text","text":"important field on this policy, and the reason the settings handler refuses"},{"type":"text","text":" "},{"type":"codeVoice","code":"dynamic_registration: anonymous"},{"type":"text","text":" while it is empty. A client an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"registered cannot declare its own "},{"type":"codeVoice","code":"allowed_resources"},{"type":"text","text":"; it inherits this list verbatim,"},{"type":"text","text":" "},{"type":"text","text":"so what a stranger can mint a token "},{"inlineContent":[{"text":"for","type":"text"}],"type":"emphasis"},{"type":"text","text":" is a decision the tenant took in advance"},{"type":"text","text":" "},{"type":"text","text":"rather than one the registration request makes. Empty means an externally registered"},{"type":"text","text":" "},{"type":"text","text":"client can obtain only today’s "},{"code":"axiam:user","type":"codeVoice"},{"type":"text","text":" tokens — which AXIAM’s own APIs accept. That"},{"type":"text","text":" "},{"type":"text","text":"is why the interlock exists: the empty list is not a safe default for an "},{"inlineContent":[{"type":"text","text":"open"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"registration endpoint, it is the most dangerous one. Shared with T5 (CIMD), which"},{"type":"text","text":" "},{"type":"text","text":"inherits the same list for the same reason."}],"variants":[{"paths":["\/documentation\/axiamsdk\/oidcpolicy\/externalclientallowedresources"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy":{"navigatorTitle":[{"text":"OidcPolicy","kind":"identifier"}],"type":"topic","title":"OidcPolicy","abstract":[{"type":"text","text":"OpenID Connect surface controls (X7 G8, plan §4.6\/§4.8; T21.4). Settings that are not"},{"type":"text","text":" "},{"type":"text","text":"password rules, here because this is the org-baseline-plus-tenant-override surface every"},{"type":"text","text":" "},{"type":"text","text":"other per-tenant control lives on. They are not all of the same kind as each other, and"},{"type":"text","text":" "},{"type":"text","text":"which is which is the whole of what ["},{"type":"codeVoice","code":"validate_tenant_override"},{"type":"text","text":"] and"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"clamp_overrides_to_org"},{"type":"text","text":"] read, so it is set out rather than inferred. "},{"type":"strong","inlineContent":[{"text":"Ordered","type":"text"}]},{"type":"text","text":" — a"},{"type":"text","text":" "},{"type":"text","text":"tenant may be stricter than its organization and never more permissive: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"type":"text","text":"], validated "},{"type":"strong","inlineContent":[{"text":"disable-only","type":"text"}]},{"type":"text","text":" — the mirror image of"},{"type":"text","text":" "},{"type":"codeVoice","code":"mfa_enforced"},{"type":"text","text":", because releasing personal data is the less-restrictive direction, so a"},{"type":"text","text":" "},{"type":"text","text":"tenant can turn its organization’s decision off but never on. * ["},{"type":"codeVoice","code":"Self::saml_idp_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"type":"strong","inlineContent":[{"type":"text","text":"disable-only"}]},{"type":"text","text":" exactly like ["},{"type":"codeVoice","code":"Self::sensitive_scopes_enabled"},{"type":"text","text":"] (D-20): a tenant"},{"type":"text","text":" "},{"type":"text","text":"may turn its organization’s "},{"type":"codeVoice","code":"true"},{"type":"text","text":" off and never its "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on. * ["},{"type":"codeVoice","code":"Self::ssf_enabled"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"validated "},{"type":"strong","inlineContent":[{"type":"text","text":"disable-only"}]},{"type":"text","text":" the same way (D-45). * ["},{"type":"codeVoice","code":"Self::dynamic_registration"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ladder "},{"type":"codeVoice","code":"disabled"},{"type":"text","text":" → "},{"type":"codeVoice","code":"initial_access_token"},{"type":"text","text":" → "},{"type":"codeVoice","code":"anonymous"},{"type":"text","text":": a tenant may move down it and"},{"type":"text","text":" "},{"type":"text","text":"never up. * ["},{"type":"codeVoice","code":"Self::dcr_max_clients"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::dcr_unused_client_ttl_days"},{"type":"text","text":"], on the"},{"type":"text","text":" "},{"type":"text","text":"ordinary "},{"type":"codeVoice","code":"tenant <= org"},{"type":"text","text":" rule — with the wrinkle that "},{"type":"codeVoice","code":"0"},{"type":"text","text":" on the second means "},{"type":"emphasis","inlineContent":[{"text":"never sweep","type":"text"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which is the longest window of all and is handled by ["},{"type":"codeVoice","code":"dcr_ttl_strictness"},{"type":"text","text":"]. "},{"type":"strong","inlineContent":[{"text":"Not","type":"text"},{"text":" ","type":"text"},{"text":"ordered","type":"text"}]},{"type":"text","text":", therefore never validated against the baseline and never clamped: *"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::default_locale"},{"type":"text","text":"]. A language is a presentation preference; there is no sense in"},{"type":"text","text":" "},{"type":"text","text":"which Italian is stricter than French. * ["},{"type":"codeVoice","code":"Self::dcr_allowed_scopes"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"Self::dcr_allowed_redirect_hosts"},{"type":"text","text":"] and ["},{"type":"codeVoice","code":"Self::external_client_allowed_resources"},{"type":"text","text":"]. Each"},{"type":"text","text":" "},{"type":"text","text":"names per-tenant resources — "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" tenant’s MCP servers, "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" tenant’s callback hosts —"},{"type":"text","text":" "},{"type":"text","text":"and there is no sense in which one such list is stricter than another. A subset rule would"},{"type":"text","text":" "},{"type":"text","text":"force an organization to enumerate every tenant’s resource servers in its own baseline"},{"type":"text","text":" "},{"type":"text","text":"before any tenant could name one. The model’s rule is “a tenant may only be more"},{"type":"text","text":" "},{"type":"text","text":"restrictive”, which binds every field that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"has"}]},{"type":"text","text":" a restrictiveness; a field that has none"},{"type":"text","text":" "},{"type":"text","text":"cannot violate it. One cross-field interlock spans both groups and is checked on the"},{"type":"text","text":" "},{"type":"text","text":"resolved policy rather than on either input: see ["},{"type":"codeVoice","code":"validate_dcr_policy"},{"type":"text","text":"]."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy","url":"\/documentation\/axiamsdk\/oidcpolicy","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OidcPolicy","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/OidcPolicy/externalClientAllowedResources":{"role":"symbol","type":"topic","abstract":[{"type":"strong","inlineContent":[{"text":"D3","type":"text"}]},{"type":"text","text":" — the audiences an externally registered client may address. The single most"},{"type":"text","text":" "},{"type":"text","text":"important field on this policy, and the reason the settings handler refuses"},{"type":"text","text":" "},{"code":"dynamic_registration: anonymous","type":"codeVoice"},{"type":"text","text":" while it is empty. A client an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"registered cannot declare its own "},{"code":"allowed_resources","type":"codeVoice"},{"type":"text","text":"; it inherits this list verbatim,"},{"type":"text","text":" "},{"type":"text","text":"so what a stranger can mint a token "},{"type":"emphasis","inlineContent":[{"type":"text","text":"for"}]},{"type":"text","text":" is a decision the tenant took in advance"},{"type":"text","text":" "},{"type":"text","text":"rather than one the registration request makes. Empty means an externally registered"},{"type":"text","text":" "},{"type":"text","text":"client can obtain only today’s "},{"code":"axiam:user","type":"codeVoice"},{"type":"text","text":" tokens — which AXIAM’s own APIs accept. That"},{"type":"text","text":" "},{"type":"text","text":"is why the interlock exists: the empty list is not a safe default for an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"open"}]},{"type":"text","text":" "},{"type":"text","text":"registration endpoint, it is the most dangerous one. Shared with T5 (CIMD), which"},{"type":"text","text":" "},{"type":"text","text":"inherits the same list for the same reason."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OidcPolicy\/externalClientAllowedResources","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"externalClientAllowedResources"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]?"}],"url":"\/documentation\/axiamsdk\/oidcpolicy\/externalclientallowedresources","title":"externalClientAllowedResources"}}}