":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"class"},{"type":"text","text":" rather than a "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" for exactly that reason: the release has to happen when the"},{"type":"text","text":" "},{"type":"text","text":"last reference goes, and value semantics would either copy the handle or fight the copy. The"},{"type":"text","text":" "},{"type":"text","text":"release is a closure captured at construction rather than an overridden method, so "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" "},{"type":"text","text":"never dispatches into a subclass whose own storage has already been torn down."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Class","title":"OpaqueExchange","symbolKind":"class","modules":[{"name":"AxiamSDK"}],"role":"symbol","navigatorTitle":[{"text":"OpaqueExchange","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpaqueExchange","kind":"identifier"}],"externalID":"s:8AxiamSDK14OpaqueExchangeC"},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/RegistrationExchange":{"abstract":[{"type":"text","text":"One in-flight enrolment (CONTRACT.md §23)."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RegistrationExchange","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RegistrationExchange","url":"\/documentation\/axiamsdk\/registrationexchange","navigatorTitle":[{"text":"RegistrationExchange","kind":"identifier"}],"type":"topic","title":"RegistrationExchange"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol