{"relationshipsSections":[{"type":"inheritedBy","kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RegistrationExchange"],"title":"Inherited By"}],"metadata":{"symbolKind":"class","navigatorTitle":[{"text":"OpaqueExchange","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpaqueExchange","kind":"identifier"}],"roleHeading":"Class","title":"OpaqueExchange","externalID":"s:8AxiamSDK14OpaqueExchangeC","role":"symbol","modules":[{"name":"AxiamSDK"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpaqueExchange","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The handle is "},{"inlineContent":[{"text":"single-use","type":"text"}],"type":"strong"},{"type":"text","text":": the library consumes it in "},{"code":"finish","type":"codeVoice"},{"type":"text","text":" whether that succeeds or"},{"type":"text","text":" "},{"type":"text","text":"fails. This class takes it out of a one-shot slot, so a second "},{"code":"finish","type":"codeVoice"},{"type":"text","text":" throws rather than"},{"type":"text","text":" "},{"type":"text","text":"handing a dangling pointer across the ABI."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"deinit"},{"type":"text","text":" releases an exchange the caller abandoned — a login started and never completed."},{"type":"text","text":" "},{"type":"text","text":"Swift’s refcounting makes that prompt rather than eventual, which is the one place its object"},{"type":"text","text":" "},{"type":"text","text":"model is kinder here than a tracing GC’s."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"class"},{"type":"text","text":" rather than a "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" for exactly that reason: the release has to happen when the"},{"type":"text","text":" "},{"type":"text","text":"last reference goes, and value semantics would either copy the handle or fight the copy. The"},{"type":"text","text":" "},{"type":"text","text":"release is a closure captured at construction rather than an overridden method, so "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" "},{"type":"text","text":"never dispatches into a subclass whose own storage has already been torn down."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/axiamsdk\/opaqueexchange"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"One in-flight OPAQUE exchange, owning a native state handle."}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange\/close()"],"title":"Instance Methods"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/RegistrationExchange":{"role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RegistrationExchange","kind":"identifier"}],"abstract":[{"text":"One in-flight enrolment (CONTRACT.md §23).","type":"text"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/registrationexchange","title":"RegistrationExchange","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RegistrationExchange","navigatorTitle":[{"text":"RegistrationExchange","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/LoginExchange":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"LoginExchange"}],"abstr