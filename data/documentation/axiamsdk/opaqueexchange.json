{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/opaqueexchange"]}],"abstract":[{"text":"One in-flight OPAQUE exchange, owning a native state handle.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"relationshipsSections":[{"title":"Inherited By","type":"inheritedBy","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RegistrationExchange"],"kind":"relationships"}],"metadata":{"externalID":"s:8AxiamSDK14OpaqueExchangeC","title":"OpaqueExchange","modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"kind":"identifier","text":"OpaqueExchange"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OpaqueExchange"}],"role":"symbol","symbolKind":"class","roleHeading":"Class"},"topicSections":[{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange\/close()"]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OpaqueExchange"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The handle is "},{"type":"strong","inlineContent":[{"type":"text","text":"single-use"}]},{"type":"text","text":": the library consumes it in "},{"code":"finish","type":"codeVoice"},{"type":"text","text":" whether that succeeds or"},{"type":"text","text":" "},{"type":"text","text":"fails. This class takes it out of a one-shot slot, so a second "},{"code":"finish","type":"codeVoice"},{"type":"text","text":" throws rather than"},{"type":"text","text":" "},{"type":"text","text":"handing a dangling pointer across the ABI."}]},{"type":"paragraph","inlineContent":[{"code":"deinit","type":"codeVoice"},{"type":"text","text":" releases an exchange the caller abandoned — a login started and never completed."},{"type":"text","text":" "},{"type":"text","text":"Swift’s refcounting makes that prompt rather than eventual, which is the one place its object"},{"type":"text","text":" "},{"type":"text","text":"model is kinder here than a tracing GC’s."}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"class"},{"text":" rather than a ","type":"text"},{"type":"codeVoice","code":"struct"},{"text":" for exactly that reason: the release has to happen when the","type":"text"},{"text":" ","type":"text"},{"text":"last reference goes, and value semantics would either copy the handle or fight the copy. The","type":"text"},{"text":" ","type":"text"},{"text":"release is a closure captured at construction rather than an overridden method, so ","type":"text"},{"type":"codeVoice","code":"deinit"},{"text":" ","type":"text"},{"text":"never dispatches into a subclass whose own storage has already been torn down.","type":"text"}]}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OpaqueExchange":{"url":"\/documentation\/axiamsdk\/opaqueexchange","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpaqueExchange","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"OpaqueExchange","kind":"identifier"}],"title":"OpaqueExchange","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange","type":"topic","role":"symbol","abstract":[{"type":"text","text":"One in-flight OPAQUE exchange, owning a native state handle."}]},"doc://AxiamSDK/documentation/AxiamSDK/RegistrationExchange":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RegistrationExchange","url":"\/documentation\/axiamsdk\/registrationexchange","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RegistrationExchange","kind":"identifier"}],"title":"RegistrationExchange","role":"symbol","navigatorTitle":[{"text":"RegistrationExchange","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"One in-flight enrolment (CONTRACT.md §23)."}]},"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/OpaqueExchange/close()":{"url":"\/documentation\/axiamsdk\/opaqueexchange\/close()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"close"},{"kind":"text","text":"()"}],"kind":"symbol","title":"close()","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange\/close()","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Releases the exchange if it was never finished."}]},"doc://AxiamSDK/documentation/AxiamSDK/LoginExchange":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange","url":"\/documentation\/axiamsdk\/loginexchange","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LoginExchange"}],"title":"LoginExchange","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LoginExchange"}],"type":"topic","abstract":[{"type":"text","text":"One in-flight login (CONTRACT.md §23)."}]}}}