{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/opaqueexchange"]}],"relationshipsSections":[{"title":"Inherited By","kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RegistrationExchange"],"type":"inheritedBy"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange","interfaceLanguage":"swift"},"abstract":[{"text":"One in-flight OPAQUE exchange, owning a native state handle.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OpaqueExchange"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The handle is "},{"inlineContent":[{"text":"single-use","type":"text"}],"type":"strong"},{"type":"text","text":": the library consumes it in "},{"type":"codeVoice","code":"finish"},{"type":"text","text":" whether that succeeds or"},{"type":"text","text":" "},{"type":"text","text":"fails. This class takes it out of a one-shot slot, so a second "},{"type":"codeVoice","code":"finish"},{"type":"text","text":" throws rather than"},{"type":"text","text":" "},{"type":"text","text":"handing a dangling pointer across the ABI."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"deinit"},{"type":"text","text":" releases an exchange the caller abandoned — a login started and never completed."},{"type":"text","text":" "},{"type":"text","text":"Swift’s refcounting makes that prompt rather than eventual, which is the one place its object"},{"type":"text","text":" "},{"type":"text","text":"model is kinder here than a tracing GC’s."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"class"},{"type":"text","text":" rather than a "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" for exactly that reason: the release has to happen when the"},{"type":"text","text":" "},{"type":"text","text":"last reference goes, and value semantics would either copy the handle or fight the copy. The"},{"type":"text","text":" "},{"type":"text","text":"release is a closure captured at construction rather than an overridden method, so "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" "},{"type":"text","text":"never dispatches into a subclass whose own storage has already been torn down."}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"topicSections":[{"title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange\/close()"]}],"metadata":{"modules":[{"name":"AxiamSDK"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OpaqueExchange"}],"title":"OpaqueExchange","symbolKind":"class","navigatorTitle":[{"kind":"identifier","text":"OpaqueExchange"}],"roleHeading":"Class","externalID":"s:8AxiamSDK14OpaqueExchangeC"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/OpaqueExchange":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange","navigatorTitle":[{"kind":"identifier","text":"OpaqueExchange"}],"abstract":[{"type":"text","text":"One in-flight OPAQUE exchange, owning a native state handle."}],"url":"\/documentation\/axiamsdk\/opaqueexchange","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OpaqueExchange"}],"role":"symbol","title":"OpaqueExchange","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"ty