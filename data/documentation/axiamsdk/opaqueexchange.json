:"codeVoice"},{"text":" releases an exchange the caller abandoned — a login started and never completed.","type":"text"},{"text":" ","type":"text"},{"text":"Swift’s refcounting makes that prompt rather than eventual, which is the one place its object","type":"text"},{"text":" ","type":"text"},{"text":"model is kinder here than a tracing GC’s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"class"},{"type":"text","text":" rather than a "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" for exactly that reason: the release has to happen when the"},{"type":"text","text":" "},{"type":"text","text":"last reference goes, and value semantics would either copy the handle or fight the copy. The"},{"type":"text","text":" "},{"type":"text","text":"release is a closure captured at construction rather than an overridden method, so "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" "},{"type":"text","text":"never dispatches into a subclass whose own storage has already been torn down."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange\/close()"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OpaqueExchange":{"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OpaqueExchange"}],"role":"symbol","navigatorTitle":[{"text":"OpaqueExchange","kind":"identifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/opaqueexchange","title":"OpaqueExchange","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueExchange","abstract":[{"text":"One in-flight OPAQUE exchange, owning a native state handle.","type":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/LoginExchange":{"title":"LoginExchange","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/LoginExchange","navigatorTitle":[{"kind":"identifier","text":"L