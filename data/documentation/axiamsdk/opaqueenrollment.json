{"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"opaque"},{"text":" object CONTRACT.md §23 defines: a registration record and the server-issued","type":"text"},{"text":" ","type":"text"},{"text":"session handle that identifies the exchange it came from.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/s8SendableP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OpaqueEnrollment"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The server cannot build this — it never sees the plaintext — so any request that ","type":"text"},{"inlineContent":[{"type":"text","text":"sets"}],"type":"strong"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"password has to carry it: ","type":"text"},{"type":"codeVoice","code":"POST \/api\/v1\/users"},{"text":", ","type":"text"},{"type":"codeVoice","code":"\/auth\/password\/change"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\/auth\/reset\/confirm"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"\/admin\/bootstrap"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note what is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" here. The SRP enrolment this replaces carried a salt, a group and a full set","type":"text"},{"text":" ","type":"text"},{"text":"of KDF costs, and required the account’s canonical username — passing an email produced a","type":"text"},{"text":" ","type":"text"},{"text":"verifier no login could ever satisfy, and renaming a user invalidated their verifier outright.","type":"text"},{"text":" ","type":"text"},{"text":"A record binds to a credential identifier the server chooses, and the key-stretching parameters","type":"text"},{"text":" ","type":"text"},{"text":"are the server’s, so there is nothing here a caller can get wrong.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/opaqueenrollment"]}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/init(opaque_session:registration_record:)"],"title":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/opaque_session","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/registration_record"],"title":"Instance Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/Equatable-Implementations"],"generated":true,"title":"Default Implementations"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"externalID":"s:8AxiamSDK16OpaqueEnrollmentV","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OpaqueEnrollment"}],"modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"kind":"identifier","text":"OpaqueEnrollment"}],"roleHeading":"Structure","symbolKind":"struct","title":"OpaqueEnrollment"},"references":{"doc://AxiamSDK/SE":{"title":"Swift.Encodable","identifier":"doc:\/\/AxiamSDK\/SE","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"