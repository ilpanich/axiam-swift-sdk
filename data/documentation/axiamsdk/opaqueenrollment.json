{"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"opaque"},{"type":"text","text":" object CONTRACT.md §23 defines: a registration record and the server-issued"},{"type":"text","text":" "},{"type":"text","text":"session handle that identifies the exchange it came from."}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/opaqueenrollment"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/init(opaque_session:registration_record:)"]},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/opaque_session","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/registration_record"],"title":"Instance Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/Equatable-Implementations"],"title":"Default Implementations","generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpaqueEnrollment","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The server cannot build this — it never sees the plaintext — so any request that "},{"inlineContent":[{"text":"sets","type":"text"}],"type":"strong"},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"password has to carry it: "},{"type":"codeVoice","code":"POST \/api\/v1\/users"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/auth\/password\/change"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"\/auth\/reset\/confirm"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/admin\/bootstrap"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Note what is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" here. The SRP enrolment this replaces carried a salt, a group and a full set","type":"text"},{"text":" ","type":"text"},{"text":"of KDF costs, and required the account’s canonical username — passing an email produced a","type":"text"},{"text":" ","type":"text"},{"text":"verifier no login could ever satisfy, and renaming a user invalidated their verifier outright.","type":"text"},{"text":" ","type":"text"},{"text":"A record binds to a credential identifier the server chooses, and the key-stretching parameters","type":"text"},{"text":" ","type":"text"},{"text":"are the server’s, so there is nothing here a caller can get wrong.","type":"text"}]}],"kind":"content"}],"metadata":{"modules":[{"name":"AxiamSDK"}],"title":"OpaqueEnrollment","roleHeading":"Structure","role":"symbol","externalID":"s:8AxiamSDK16OpaqueEnrollmentV","navigatorTitle":[{"text":"OpaqueEnrollment","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpaqueEnrollment","kind":"identifier"}],"symbolKind":"struct"},"relationshipsSections":[{"identifiers":["doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/s8SendableP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"references":{"doc://AxiamSDK/SQ":{"identifier":"doc:\/\/AxiamSDK\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://AxiamSDK/documentation/AxiamSDK/OpaqueEnrollment/registration_record":{"abstract":[{"type":"text","text":"The hex "},{"type":"codeVoice","code":"RegistrationRecord"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"registration_recor