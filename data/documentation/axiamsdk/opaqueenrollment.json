ntent","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The server cannot build this — it never sees the plaintext — so any request that "},{"type":"strong","inlineContent":[{"text":"sets","type":"text"}]},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"password has to carry it: "},{"type":"codeVoice","code":"POST \/api\/v1\/users"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/auth\/password\/change"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"\/auth\/reset\/confirm"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/admin\/bootstrap"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Note what is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" here. The SRP enrolment this replaces carried a salt, a group and a full set","type":"text"},{"text":" ","type":"text"},{"text":"of KDF costs, and required the account’s canonical username — passing an email produced a","type":"text"},{"text":" ","type":"text"},{"text":"verifier no login could ever satisfy, and renaming a user invalidated their verifier outright.","type":"text"},{"text":" ","type":"text"},{"text":"A record binds to a credential identifier the server chooses, and the key-stretching parameters","type":"text"},{"text":" ","type":"text"},{"text":"are the server’s, so there is nothing here a caller can get wrong.","type":"text"}]}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OpaqueEnrollment/registration_record":{"abstract":[{"type":"text","text":"The hex "},{"type":"codeVoice","code":"RegistrationRecord"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/registration_record","role":"symbol","title":"registration_record","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":"