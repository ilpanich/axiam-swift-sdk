{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/opaqueenrollment"]}],"abstract":[{"text":"The ","type":"text"},{"code":"opaque","type":"codeVoice"},{"text":" object CONTRACT.md §23 defines: a registration record and the server-issued","type":"text"},{"text":" ","type":"text"},{"text":"session handle that identifies the exchange it came from.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment","interfaceLanguage":"swift"},"metadata":{"externalID":"s:8AxiamSDK16OpaqueEnrollmentV","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OpaqueEnrollment"}],"modules":[{"name":"AxiamSDK"}],"roleHeading":"Structure","symbolKind":"struct","title":"OpaqueEnrollment","navigatorTitle":[{"kind":"identifier","text":"OpaqueEnrollment"}]},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/init(opaque_session:registration_record:)"],"title":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/opaque_session","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/registration_record"]},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/Equatable-Implementations"]}],"sections":[],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/s8SendableP"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OpaqueEnrollment"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The server cannot build this — it never sees the plaintext — so any request that "},{"type":"strong","inlineContent":[{"type":"text","text":"sets"}]},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"password has to carry it: "},{"type":"codeVoice","code":"POST \/api\/v1\/users"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/auth\/password\/change"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"\/auth\/reset\/confirm"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/admin\/bootstrap"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Note what is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" here. The SRP enrolment this replaces carried a salt, a group and a full set","type":"text"},{"text":" ","type":"text"},{"text":"of KDF costs, and required the account’s canonical username — passing an email produced a","type":"text"},{"text":" ","type":"text"},{"text":"verifier no login could ever satisfy, and renaming a user invalidated their verifier outright.","type":"text"},{"text":" ","type":"text"},{"text":"A record binds to a credential identifier the server chooses, and the key-stretching parameters","type":"text"},{"text":" ","type":"text"},{"text":"are the server’s, so there is nothing here a caller can get wrong.","type":"text"}]}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OpaqueEnrollment/registration_record":{"role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OpaqueEnrollment\/registration_record","abstract":[{"text":"The hex ","type":"text"},{"code":"RegistrationRecord","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","title":"registration_record","url":"\/documentation\/axiamsdk\/opaqueenrollment\/