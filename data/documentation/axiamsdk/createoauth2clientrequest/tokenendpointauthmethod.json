,"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/clientauthmethod","title":"ClientAuthMethod","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming)."},{"type":"text","text":" "},{"type":"text","text":"Only the methods AXIAM actually implements are representable. "},{"code":"None","type":"codeVoice"},{"type":"text","text":" — the public-client"},{"type":"text","text":" "},{"type":"text","text":"value — was deliberately absent until T21.2: adding it before the rest of the server"},{"type":"text","text":" "},{"type":"text","text":"understood one would have let an operator register a client whose authentication is silently"},{"type":"text","text":" "},{"type":"text","text":"skipped. The server understands one now ("},{"code":"token.rs","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"authenticate_client_credential","type":"codeVoice"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"an arm that accepts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"no"}]},{"type":"text","text":" credential and refuses a presented one, the authorization endpoint"},{"type":"text","text":" "},{"type":"text","text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside"},{"type":"text","text":" "},{"type":"text","text":"any grant or binding that contradicts it), so the variant exists — and only that arm may"},{"type":"text","text":" "},{"type":"text","text":"ever treat a missing credential as success."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest":{"role":"symbol","url":"\/documentation\/axiamsdk\/createoauth2clientrequest","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest","type":"topic","abstract":[{"type":"text","text":"The "},{"code":"CreateOAuth2ClientRequest","type":"codeVoice"},{"type":"text","text":" schema."}],"navigatorTitle":[{"text":"CreateOAuth2ClientRequest","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CreateOAuth2ClientRequest","kind":"identifier"}],"title":"CreateOAuth2ClientRequest"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/tokenEndpointAuthMethod":{"title":"tokenEndpointAuthMethod","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tokenEndpointAuthMethod","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ClientAuthMethod","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16ClientAuthMethodO"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/tokenEndpointAuthMethod","kind":"symbol","url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/tokenendpointauthmethod","abstract":[{"type":"text","text":"X5.1 — how this client authenticates at the token endpoint (RFC 8705 §2). Defaults to"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_secret_post"},{"type":"text","text":"."}]}}}