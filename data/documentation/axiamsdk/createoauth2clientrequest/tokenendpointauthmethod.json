ntity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"role":"symbol","url":"\/documentation\/axiamsdk\/clientauthmethod","abstract":[{"text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming).","type":"text"},{"text":" ","type":"text"},{"text":"Only the methods AXIAM actually implements are representable. ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" — the public-client","type":"text"},{"text":" ","type":"text"},{"text":"value — was deliberately absent until T21.2: adding it before the rest of the server","type":"text"},{"text":" ","type":"text"},{"text":"understood one would have let an operator register a client whose authentication is silently","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The server understands one now (","type":"text"},{"type":"codeVoice","code":"token.rs"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"authenticate_client_credential"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"an arm that accepts ","type":"text"},{"inlineContent":[{"type":"text","text":"no"}],"type":"emphasis"},{"text":" credential and refuses a presented one, the authorization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"title":"ClientAuthMethod","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest":{"title":"CreateOAuth2ClientRequest","url":"\/documentation\/axiamsdk\/createoauth2clientrequest","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest","navigatorTitle":[{"text":"CreateOAuth2ClientRequest","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CreateOAuth2ClientRequest","kind":"identifier"}],"role":"symbol","abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"CreateOAuth2ClientRequest"},{"text":" schema.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/tokenEndpointAuthMethod":{"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"tokenEndpointAuthMethod","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ClientAuthMethod","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16ClientAuthMethodO"},{"text":"?","kind":"text"}],"url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/tokenendpointauthmethod","role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/tokenEndpointAuthMethod","title":"tokenEndpointAuthMethod","abstract":[{"type":"text","text":"X5.1 — how this client authenticates at the token endpoint (RFC 8705 §2). Defaults to"},{"type":"text","text":" "},{"code":"client_secret_post","type":"codeVoice"},{"type":"text","text":"."}]}}}