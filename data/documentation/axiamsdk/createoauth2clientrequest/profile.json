rivate_key_jwt","type":"codeVoice"},{"text":"), and at least one sender-constraining mechanism","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"tls_client_certificate_bound_access_tokens","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"dpop_bound_access_tokens","type":"codeVoice"},{"text":"). See the","type":"text"},{"text":" ","type":"text"},{"text":"FAPI operator guide.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"profile","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ClientProfile","preciseIdentifier":"s:8AxiamSDK13ClientProfileO","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"CreateOAuth2ClientRequest","kind":"identifier"}],"title":"CreateOAuth2ClientRequest","type":"topic","url":"\/documentation\/axiamsdk\/createoauth2clientrequest","abstract":[{"text":"The ","type":"text"},{"code":"CreateOAuth2ClientRequest","type":"codeVoice"},{"type":"text","text":" schema."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CreateOAuth2ClientRequest","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}],"url":"\/documentation\/axiamsdk\/clientprofile","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"S256","type":"codeVoice"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"nearly"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"change at all, because "},{"isActive":true,"identifier":"Self::Standard","type":"reference"},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","title":"ClientProfile","role":"symbol","kind":"symbol","type":"topic"},"Self::Standard":{"titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"identifier":"Self::Standard","type":"link","url":"Self::Standard","title":"Standard"}}}