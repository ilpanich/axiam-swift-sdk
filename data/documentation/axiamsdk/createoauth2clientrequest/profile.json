und_access_tokens","type":"codeVoice"},{"type":"text","text":"). See the"},{"type":"text","text":" "},{"type":"text","text":"FAPI operator guide."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"profile","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","text":"ClientProfile","preciseIdentifier":"s:8AxiamSDK13ClientProfileO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/profile":{"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"profile"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13ClientProfileO","text":"ClientProfile"},{"kind":"text","text":"?"}],"title":"profile","abstract":[{"type":"text","text":"X5.1 — the security posture this client is registered under. "},{"type":"codeVoice","code":"\"standard\""},{"type":"text","text":" (the default)"},{"type":"text","text":" "},{"type":"text","text":"is every AXIAM client that has ever existed. "},{"type":"codeVoice","code":"\"fapi2\""},{"type":"text","text":" turns on the whole FAPI 2.0"},{"type":"text","text":" "},{"type":"text","text":"constraint bundle at once, and the registration is refused unless it also sets"},{"type":"text","text":" "},{"type":"codeVoice","code":"require_par"},{"type":"text","text":", a strong "},{"code":"token_endpoint_auth_method","type":"codeVoice"},{"text":" (either mTLS method or","type":"text"},{"text":" ","type":"text"},{"code":"private_key_jwt","type":"codeVoice"},{"text":"), and at least one sender-constraining mechanism","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"tls_client_certificate_bound_access_tokens","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"dpop_bound_access_tokens","type":"codeVoice"},{"text":"). See the","type":"text"},{"text":" ","type":"text"},{"text":"FAPI operator guide.","type":"text"}],"url":"\/documentation\/axiamsdk\/createoauth2clientrequest\/profile","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/profile","kind":"symbol","type":"topic"},"Self::Standard":{"identifier":"Self::Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"type":"link","title":"Standard","url":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CreateOAuth2ClientRequest","kind":"identifier"}],"navigatorTitle":[{"text":"CreateOAuth2ClientRequest","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/createoauth2clientrequest","title":"CreateOAuth2ClientRequest","abstract":[{"text":"The ","type":"text"},{"code":"CreateOAuth2ClientRequest","type":"codeVoice"},{"text":" schema.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"title":"ClientProfile","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"nearly"}],"type":"emphasis"},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"url":"\/documentation\/axiamsdk\/clientprofile","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}]}}}