binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"type":"topic","title":"ClientAuthMethod"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CreateOAuth2ClientRequest"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest","url":"\/documentation\/axiamsdk\/createoauth2clientrequest","kind":"symbol","type":"topic","title":"CreateOAuth2ClientRequest","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"CreateOAuth2ClientRequest"},{"type":"text","text":" schema."}],"navigatorTitle":[{"kind":"identifier","text":"CreateOAuth2ClientRequest"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode":{"navigatorTitle":[{"kind":"identifier","text":"AuthnRequestParamsMode"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthnRequestParamsMode"}],"kind":"symbol","type":"topic","title":"AuthnRequestParamsMode","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","abstract":[{"text":"Whether this client’s authorization requests may carry OpenID Connect’s","type":"text"},{"text":" ","type":"text"},{"text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this","type":"text"},{"text":" ","type":"text"},{"text":"governs is ","type":"text"},{"code":"prompt","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"max_age"},{"type":"text","text":", "},{"type":"codeVoice","code":"acr_values"},{"type":"text","text":", "},{"type":"codeVoice","code":"claims"},{"type":"text","text":", "},{"type":"codeVoice","code":"id_token_hint"},{"type":"text","text":", "},{"type":"codeVoice","code":"login_hint"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"display"},{"type":"text","text":", "},{"type":"codeVoice","code":"ui_locales"},{"type":"text","text":" and "},{"type":"codeVoice","code":"claims_locales"},{"type":"text","text":". It is "},{"type":"strong","inlineContent":[{"type":"text","text":"one"}]},{"type":"text","text":" field rather than nine booleans"},{"type":"text","text":" "},{"type":"text","text":"for the same reason ["},{"type":"codeVoice","code":"ClientProfile"},{"type":"text","text":"] is one field rather than a dozen: a client that"},{"type":"text","text":" "},{"type":"text","text":"honours "},{"type":"codeVoice","code":"max_age"},{"type":"text","text":" but ignores "},{"type":"codeVoice","code":"prompt=none"},{"type":"text","text":" is not “mostly conformant”, it is a client a"},{"type":"text","text":" "},{"type":"text","text":"relying party cannot reason about. "},{"isActive":true,"identifier":"Self::Ignore","type":"reference"},{"text":" is the serde default and is","type":"text"},{"text":" ","type":"text"},{"text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by","type":"text"},{"text":" ","type":"text"},{"text":"the query deserialiser and never reach a decision. Every row written before schema v54","type":"text"},{"text":" ","type":"text"},{"text":"therefore decodes to the behaviour it already had.","type":"text"}]},"Self::Standard":{"title":"Standard","type":"link","identifier":"Self::Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"url":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/init(allowedResources:authnRequestParams:backchannelLogoutURI:browserSSO:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:jwks:jwksURI:name:postLogoutRedirectUris:prof