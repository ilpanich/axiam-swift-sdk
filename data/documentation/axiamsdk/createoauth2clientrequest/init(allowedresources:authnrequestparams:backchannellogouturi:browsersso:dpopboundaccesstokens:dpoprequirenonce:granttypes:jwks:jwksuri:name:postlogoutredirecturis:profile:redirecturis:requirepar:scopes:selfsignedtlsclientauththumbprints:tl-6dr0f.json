ion","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","kind":"symbol","role":"symbol","title":"AuthnRequestParamsMode","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","navigatorTitle":[{"text":"AuthnRequestParamsMode","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Whether this client’s authorization requests may carry OpenID Connect’s"},{"type":"text","text":" "},{"type":"text","text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this"},{"type":"text","text":" "},{"type":"text","text":"governs is "},{"type":"codeVoice","code":"prompt"},{"type":"text","text":", "},{"type":"codeVoice","code":"max_age"},{"type":"text","text":", "},{"type":"codeVoice","code":"acr_values"},{"type":"text","text":", "},{"type":"codeVoice","code":"claims"},{"type":"text","text":", "},{"type":"codeVoice","code":"id_token_hint"},{"type":"text","text":", "},{"type":"codeVoice","code":"login_hint"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"display"},{"type":"text","text":", "},{"type":"codeVoice","code":"ui_locales"},{"type":"text","text":" and "},{"type":"codeVoice","code":"claims_locales"},{"type":"text","text":". It is "},{"type":"strong","inlineContent":[{"type":"text","text":"one"}]},{"type":"text","text":" field rather than nine booleans"},{"type":"text","text":" "},{"type":"text","text":"for the same reason ["},{"type":"codeVoice","code":"ClientProfile"},{"type":"text","text":"] is one field rather than a dozen: a client that"},{"type":"text","text":" "},{"type":"text","text":"honours "},{"type":"codeVoice","code":"max_age"},{"type":"text","text":" but ignores "},{"type":"codeVoice","code":"prompt=none"},{"type":"text","text":" is not “mostly conformant”, it is a client a"},{"type":"text","text":" "},{"type":"text","text":"relying party cannot reason about. "},{"type":"reference","isActive":true,"identifier":"Self::Ignore"},{"type":"text","text":" is the serde default and is"},{"type":"text","text":" "},{"type":"text","text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by"},{"type":"text","text":" "},{"type":"text","text":"the query deserialiser and never reach a decision. Every row written before schema v54"},{"type":"text","text":" "},{"type":"text","text":"therefore decodes to the behaviour it already had."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AuthnRequestParamsMode","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","url":"\/documentation\/axiamsdk\/clientprofile","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}],"abstract":[{"type":"text","text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”."},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"type":"text","text":" "},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"type":"text","text":", mandatory strong client authentication, mandatory sender-constrained tokens,"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"type":"text","text":" "},{"text":"change at all, because ","type":"text"},{"isActive":true,"type":"reference","identifier":"Self::Standard"},{"text":" is the serde default and every row","type":"text"},{"type":"text","text":" "},{"text":"written before schema v38 decodes to it.","type":"text"}],"type":"topic","title":"ClientProfile","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}]},"Self::Ignore":{"title":"Ignore","url":"Self::Ignore","type":"link","titleInlineContent":[{"code":"Ignore","type":"codeVoice"}],"identifier":"Self::Ignore"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"CreateOAuth2ClientRequest"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"CreateOAuth2ClientRequest"}],"role":"symbol","url":"\/documentation\/axiamsdk\/createoauth2clientrequest","abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"CreateOAuth2ClientRequest"},{"type":"text","text":" schema."}],"title":"CreateOAuth2ClientRequest"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"abstract":[{"type":"text","text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming)."},{"type":"text","text":" "},{"type":"text","text":"Only the methods AXIAM actually implements are representable. "},{"type":"codeVoice","code":"None"},{"type":"text","text":" — the public-client"},{"type":"text","text":" "},{"type":"text","text":"value — was deliberately absent until T21.2: adding it before the rest of the server"},{"type":"text","text":" "},{"type":"text","text":"understood one would have let an operator register a client whose authentication is silently"},{"type":"text","text":" "},{"type":"text","text":"skipped. The server understands one now ("},{"type":"codeVoice","code":"token.rs"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"authenticate_client_credential"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"an arm that accepts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"no"}]},{"type":"text","text":" credential and refuses a presented one, the authorization endpoint"},{"type":"text","text":" "},{"type":"text","text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside"},{"type":"text","text":" "},{"type":"text","text":"any grant or binding that contradicts it), so the variant exists — and only that arm may"},{"type":"text","text":" "},{"type":"text","text":"ever treat a missing credential as success."}],"title":"ClientAuthMethod","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","role":"symbol","navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/clientauthmethod"},"Self::Standard":{"title":"Standard","url":"Self::Standard","type":"link","titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"identifier":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/init(allowedResources:authnRequestParams:backchannelLogoutURI:browserSSO:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:jwks:jwksURI:name:postLogoutRedirectUris:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClientAuthSubjectDn:tlsClientCertificateBoundAccessTokens:tok