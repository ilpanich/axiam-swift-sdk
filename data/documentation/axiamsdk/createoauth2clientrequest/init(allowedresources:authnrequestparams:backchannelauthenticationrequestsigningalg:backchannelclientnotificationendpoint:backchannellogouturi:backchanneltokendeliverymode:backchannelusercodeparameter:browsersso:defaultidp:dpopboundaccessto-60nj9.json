ng one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"isActive":true,"type":"reference","identifier":"Self::Standard"},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode":{"navigatorTitle":[{"kind":"identifier","text":"AuthnRequestParamsMode"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthnRequestParamsMode"}],"role":"symbol","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","title":"AuthnRequestParamsMode","abstract":[{"text":"Whether this client’s authorization requests may carry OpenID Connect’s","type":"text"},{"text":" ","type":"text"},{"text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this","type":"text"},{"text":" ","type":"text"},{"text":"governs is ","type":"text"},{"code":"prompt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"max_age","type":"codeVoice"},{"text":", ","type":"text"},{"code":"acr_values","type":"codeVoice"},{"text":", ","type":"text"},{"code":"claims","type":"codeVoice"},{"text":", ","type":"text"},{"code":"id_token_hint","type":"codeVoice"},{"text":", ","type":"text"},{"code":"login_hint","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"display","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ui_locales","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"claims_locales","type":"codeVoice"},{"text":". It is ","type":"text"},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"text":" field rather than nine booleans","type":"text"},{"text":" ","type":"text"},{"text":"for the same reason [","type":"text"},{"code":"ClientProfile","type":"codeVoice"},{"text":"] is one field rather than a dozen: a client that","type":"text"},{"text":" ","type":"text"},{"text":"honours ","type":"text"},{"code":"max_age","type":"codeVoice"},{"text":" but ignores ","type":"text"},{"code":"prompt=none","type":"codeVoice"},{"text":" is not “mostly conformant”, it is a client a","type":"text"},{"text":" ","type":"text"},{"text":"relying party cannot reason about. ","type":"text"},{"identifier":"Self::Ignore","isActive":true,"type":"reference"},{"text":" is the serde default and is","type":"text"},{"text":" ","type":"text"},{"text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by","type":"text"},{"text":" ","type":"text"},{"text":"the query deserialiser and never reach a decision. Every row written before schema v54","type":"text"},{"text":" ","type":"text"},{"text":"therefore decodes to the behaviour it already had.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CreateOAuth2ClientRequest"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest","title":"CreateOAuth2ClientRequest","url":"\/documentation\/axiamsdk\/createoauth2clientrequest","type":"topic","navigatorTitle":[{"kind":"identifier","text":"CreateOAuth2ClientRequest"}],"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"CreateOAuth2ClientRequest"},{"type":"text","text":" schema."}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"abstract":[{"text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming).","type":"text"},{"text":" ","type":"text"},{"text":"Only the methods AXIAM actually implements are representable. ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" — the public-client","type":"text"},{"text":" ","type":"text"},{"text":"value — was deliberately absent until T21.2: adding it before the rest of the server","type":"text"},{"text":" ","type":"text"},{"text":"understood one would have let an operator register a client whose authentication is silently","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The server understands one now (","type":"text"},{"type":"codeVoice","code":"token.rs"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"authenticate_client_credential"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"an arm that accepts ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"no","type":"text"}]},{"text":" credential and refuses a presented one, the authorization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"type":"topic","title":"ClientAuthMethod","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","url":"\/documentation\/axiamsdk\/clientauthmethod","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ClientAuthMethod"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientAuthMethod"}]},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest/init(allowedResources:authnRequestParams:backchannelAuthenticationRequestSigningAlg:backchannelCl