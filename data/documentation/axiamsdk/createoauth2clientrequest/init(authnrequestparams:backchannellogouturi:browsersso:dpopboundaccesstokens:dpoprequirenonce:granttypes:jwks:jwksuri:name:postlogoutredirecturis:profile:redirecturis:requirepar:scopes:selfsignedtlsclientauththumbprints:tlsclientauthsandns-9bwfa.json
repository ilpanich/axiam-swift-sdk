"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest\/init(authnRequestParams:backchannelLogoutURI:browserSSO:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:jwks:jwksURI:name:postLogoutRedirectUris:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClientAuthSubjectDn:tlsClientCertificateBoundAccessTokens:tokenEndpointAuthMethod:)","title":"init(authnRequestParams:backchannelLogoutURI:browserSSO:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:jwks:jwksURI:name:postLogoutRedirectUris:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClientAuthSubjectDn:tlsClientCertificateBoundAccessTokens:tokenEndpointAuthMethod:)","role":"symbol","abstract":[],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"CreateOAuth2ClientRequest","kind":"identifier"}],"title":"CreateOAuth2ClientRequest","type":"topic","url":"\/documentation\/axiamsdk\/createoauth2clientrequest","abstract":[{"text":"The ","type":"text"},{"code":"CreateOAuth2ClientRequest","type":"codeVoice"},{"type":"text","text":" schema."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CreateOAuth2ClientRequest","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode":{"url":"\/documentation\/axiamsdk\/authnrequestparamsmode","role":"symbol","abstract":[{"text":"Whether this client’s authorization requests may carry OpenID Connect’s","type":"text"},{"text":" ","type":"text"},{"text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this","type":"text"},{"text":" ","type":"text"},{"text":"governs is ","type":"text"},{"code":"prompt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"max_age","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"acr_values"},{"type":"text","text":", "},{"type":"codeVoice","code":"claims"},{"type":"text","text":", "},{"type":"codeVoice","code":"id_token_hint"},{"type":"text","text":", "},{"type":"codeVoice","code":"login_hint"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"display","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ui_locales","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"claims_locales","type":"codeVoice"},{"text":". It is ","type":"text"},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"text":" field rather than nine booleans","type":"text"},{"text":" ","type":"text"},{"text":"for the same reason [","type":"text"},{"code":"ClientProfile","type":"codeVoice"},{"text":"] is one field rather than a dozen: a client that","type":"text"},{"text":" ","type":"text"},{"text":"honours ","type":"text"},{"code":"max_age","type":"codeVoice"},{"text":" but ignores ","type":"text"},{"code":"prompt=none","type":"codeVoice"},{"text":" is not “mostly conformant”, it is a client a","type":"text"},{"text":" ","type":"text"},{"text":"relying party cannot reason about. ","type":"text"},{"identifier":"Self::Ignore","isActive":true,"type":"reference"},{"text":" is the serde default and is","type":"text"},{"text":" ","type":"text"},{"text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by","type":"text"},{"text":" ","type":"text"},{"text":"the query deserialiser and never reach a decision. Every row written before schema v54","type":"text"},{"text":" ","type":"text"},{"text":"therefore decodes to the behaviour it already had.","type":"text"}],"title":"AuthnRequestParamsMode","navigatorTitle":[{"kind":"identifier","text":"AuthnRequestParamsMode"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthnRequestParamsMode"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}],"url":"\/documentation\/axiamsdk\/clientprofile","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"S256","type":"codeVoice"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"nearly"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"change at all, because "},{"isActive":true,"identifier":"Self::Standard","type":"reference"},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","title":"ClientProfile","role":"symbol","kind":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"navigatorTitle":[{"kind":"identifier","text":"ClientAuthMethod"}],"abstract":[{"type":"text","text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming)."},{"type":"text","text":" "},{"type":"text","text":"Only the methods AXIAM actually implements are representable. There is deliberately no"},{"type":"text","text":" "},{"type":"codeVoice","code":"none"},{"type":"text","text":" variant: every AXIAM client is confidential today (see "},{"type":"codeVoice","code":"handle_authorization_code"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and adding a public-client value here before the rest of the server understands one would"},{"type":"text","text":" "},{"type":"text","text":"let an operator register a client whose authentication is silently skipped."}],"role":"symbol","title":"ClientAuthMethod","url":"\/documentation\/axiamsdk\/clientauthmethod","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientAuthMethod"}]},"Self::Ignore":{"url":"Self::Ignore","type":"link","identifier":"Self::Ignore","title":"Ignore","titleInlineContent":[{"code":"Ignore","type":"codeVoice"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","role":"collection","type":"topic","url":"\/documentation\/axiamsdk"},"Self::Standard":{"url":"Self::Standard","type":"link","identifier":"Self::Standard","title":"Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}]}}}