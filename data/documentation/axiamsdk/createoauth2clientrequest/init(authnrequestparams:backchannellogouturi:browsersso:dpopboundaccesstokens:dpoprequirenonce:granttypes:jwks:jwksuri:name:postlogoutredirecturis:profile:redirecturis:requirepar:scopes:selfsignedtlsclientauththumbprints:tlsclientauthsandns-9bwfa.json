t":" "},{"type":"text","text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this"},{"type":"text","text":" "},{"type":"text","text":"governs is "},{"type":"codeVoice","code":"prompt"},{"type":"text","text":", "},{"type":"codeVoice","code":"max_age"},{"type":"text","text":", "},{"type":"codeVoice","code":"acr_values"},{"type":"text","text":", "},{"type":"codeVoice","code":"claims"},{"type":"text","text":", "},{"type":"codeVoice","code":"id_token_hint"},{"type":"text","text":", "},{"type":"codeVoice","code":"login_hint"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"display"},{"type":"text","text":", "},{"code":"ui_locales","type":"codeVoice"},{"type":"text","text":" and "},{"code":"claims_locales","type":"codeVoice"},{"type":"text","text":". It is "},{"type":"strong","inlineContent":[{"text":"one","type":"text"}]},{"type":"text","text":" field rather than nine booleans"},{"type":"text","text":" "},{"type":"text","text":"for the same reason ["},{"code":"ClientProfile","type":"codeVoice"},{"text":"] is one field rather than a dozen: a client that","type":"text"},{"text":" ","type":"text"},{"text":"honours ","type":"text"},{"code":"max_age","type":"codeVoice"},{"text":" but ignores ","type":"text"},{"code":"prompt=none","type":"codeVoice"},{"text":" is not “mostly conformant”, it is a client a","type":"text"},{"text":" ","type":"text"},{"text":"relying party cannot reason about. ","type":"text"},{"identifier":"Self::Ignore","type":"reference","isActive":true},{"text":" is the serde default and is","type":"text"},{"text":" ","type":"text"},{"text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by","type":"text"},{"text":" ","type":"text"},{"text":"the query deserialiser and never reach a decision. Every row written before schema v54","type":"text"},{"text":" ","type":"text"},{"text":"therefore decodes to the behaviour it already had.","type":"text"}],"type":"topic","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","navigatorTitle":[{"kind":"identifier","text":"AuthnRequestParamsMode"}]},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"url":"\/documentation\/axiamsdk\/clientprofile","kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"type":"text","text":", mandatory strong client authentication, mandatory sender-constrained tokens,"},{"type":"text","text":" "},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"text":"written before schema v38 decodes to it.","type":"text"}],"title":"ClientProfile","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}]},"doc://AxiamSDK/documentation/AxiamSDK/CreateOAuth2ClientRequest":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CreateOAuth2ClientRequest"}],"type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CreateOAuth2ClientRequest","url":"\/documentation\/axiamsdk\/createoauth2clientrequest","title":"CreateOAuth2ClientRequest","abstract":[{"type":"text","text":"The "},{"code":"CreateOAuth2ClientRequest","type":"codeVoice"},{"type":"text","text":" schema."}],"navigatorTitle":[{"kind":"identifier","text":"CreateOAuth2ClientRequest"}]},"Self::Ignore":{"identifier":"Self::Ignore","url":"Self::Ignore","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Ignore"}],"title":"Ignore"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"title":"ClientAuthMethod","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","kind":"symbol","url":"\/documentation\/axiamsdk\/clientauthmethod","abstract":[{"type":"text","text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming)."},{"type":"text","text":" "},{"type":"text","text":"Only the methods AXIAM actually implements are representable. There is deliberately no"},{"type":"text","text":" "},{"type":"codeVoice","code":"none"},{"type":"text","text":" variant: every AXIAM client is confidential today (see "},{"type":"codeVoice","code":"handle_authorization_code"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and adding a public-client value here before the rest of the server understands one would"},{"type":"text","text":" "},{"type":"text","text":"let an operator register a client whose authentication is silently skipped."}]},"Self::Standard":{"ide