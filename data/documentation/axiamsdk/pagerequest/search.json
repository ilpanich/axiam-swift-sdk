{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"search","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Matched case-insensitively against the identifying fields of whatever is being"},{"type":"text","text":" "},{"type":"text","text":"listed — a name or username, plus the record id, so a UUID out of a log line can be"},{"type":"text","text":" "},{"type":"text","text":"pasted in as-is. Which fields exactly is the server’s business; "},{"type":"codeVoice","code":"Page.total"},{"type":"text","text":" then"},{"type":"text","text":" "},{"type":"text","text":"counts MATCHES rather than rows, which is what lets a pager built on it show a page"},{"type":"text","text":" "},{"type":"text","text":"count belonging to the result set it is paging."}],"type":"paragraph"},{"inlineContent":[{"text":"It lives here, beside ","type":"text"},{"type":"codeVoice","code":"offset"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"limit"},{"text":", rather than as an extra argument on each","type":"text"},{"text":" ","type":"text"},{"text":"of the twenty generated ","type":"text"},{"type":"codeVoice","code":"list"},{"text":" methods (§27.4 rule 4). That is what makes ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" ","type":"text"},{"text":"carry it, and so what makes a manual walk filter the WHOLE walk: one that sent the","type":"text"},{"text":" ","type":"text"},{"text":"term on its first request and dropped it on the second would return the matches","type":"text"},{"text":" ","type":"text"},{"text":"followed by the unfiltered tail, which reads as a server bug from the caller’s side.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Stored as the caller gave it; "},{"code":"queryPairs","type":"codeVoice"},{"type":"text","text":" is where it is normalised."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"search","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK11PageRequestV6searchSSSgvp","role":"symbol","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"search","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"symbolKind":"property"},"variants":[{"paths":["\/documentation\/axiamsdk\/pagerequest\/search"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest\/search","interfaceLanguage":"swift"},"abstract":[{"text":"A free-text filter applied by the SERVER, before ","type":"text"},{"code":"offset","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"limit","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for none.","type":"text"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/PageRequest/search":{"abstract":[{"text":"A free-text filter applied by the SERVER, before ","type":"text"},{"code":"offset","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"limit","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for none.","type":"text"}],"type":"topic","title":"search","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/pagerequest\/search","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"search","kind":"identifier"},{"text":": ","kind":"text"},{"text