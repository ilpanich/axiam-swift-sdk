e":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Stored as the caller gave it; ","type":"text"},{"code":"queryPairs","type":"codeVoice"},{"text":" is where it is normalised.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest\/search","interfaceLanguage":"swift"},"sections":[],"metadata":{"symbolKind":"property","externalID":"s:8AxiamSDK11PageRequestV6searchSSSgvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"search"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"modules":[{"name":"AxiamSDK"}],"role":"symbol","title":"search","roleHeading":"Instance Property"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/pagerequest\/search"]}],"abstract":[{"type":"text","text":"A free-text filter applied by the SERVER, before "},{"type":"codeVoice","code":"offset"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"limit"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for none."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PageRequest/search":{"type":"topic","url":"\/documentation\/axiamsdk\/pagerequest\/search","abstract":[{"type":"text","text":"A free-text filter applied by the SERVER, before "},{"type":"codeVoice","code":"offset"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"limit"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for none."}],"title":"search","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"search"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"ty