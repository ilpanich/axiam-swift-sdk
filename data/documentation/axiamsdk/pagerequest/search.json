e":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Stored as the caller gave it; "},{"code":"queryPairs","type":"codeVoice"},{"type":"text","text":" is where it is normalised."}],"type":"paragraph"}]}],"sections":[],"metadata":{"roleHeading":"Instance Property","title":"search","modules":[{"name":"AxiamSDK"}],"symbolKind":"property","role":"symbol","externalID":"s:8AxiamSDK11PageRequestV6searchSSSgvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"search"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest"]]},"abstract":[{"type":"text","text":"A free-text filter applied by the SERVER, before "},{"type":"codeVoice","code":"offset"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"limit"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for none."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/pagerequest\/search"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest\/search"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/PageRequest":{"kind":"symbol","abstract":[{"text":"One page’s worth of ","type":"text"},{"type":"codeVoice","code":"?offset="},{"text":"\/","type":"text"},{"type":"codeVoice","code":"?limit="},{"text":".","type":"text"}],"title":"PageRequest",