{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest\/search","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"search"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matched case-insensitively against the identifying fields of whatever is being"},{"type":"text","text":" "},{"type":"text","text":"listed — a name or username, plus the record id, so a UUID out of a log line can be"},{"type":"text","text":" "},{"type":"text","text":"pasted in as-is. Which fields exactly is the server’s business; "},{"type":"codeVoice","code":"Page.total"},{"type":"text","text":" then"},{"type":"text","text":" "},{"text":"counts MATCHES rather than rows, which is what lets a pager built on it show a page","type":"text"},{"text":" ","type":"text"},{"text":"count belonging to the result set it is paging.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It lives here, beside "},{"type":"codeVoice","code":"offset"},{"type":"text","text":" and "},{"code":"limit","type":"codeVoice"},{"text":", rather than as an extra argument on each","type":"text"},{"text":" ","type":"text"},{"text":"of the twenty generated ","type":"text"},{"code":"list","type":"codeVoice"},{"text":" methods (§27.4 rule 4). That is what makes ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"carry it, and so what makes a manual walk filter the WHOLE walk: one that sent the","type":"text"},{"text":" ","type":"text"},{"text":"term on its first request and dropped it on the second would return the matches","type":"text"},{"text":" ","type":"text"},{"text":"followed by the unfiltered tail, which reads as a server bug from the caller’s side.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stored as the caller gave it; "},{"type":"codeVoice","code":"queryPairs"},{"type":"text","text":" is where it is normalised."}]}]}],"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/pagerequest\/search"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:8AxiamSDK11PageRequestV6searchSSSgvp","roleHeading":"Instance Property","role":"symbol","title":"search","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"search","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"symbolKind":"property"},"abstract":[{"type":"text","text":"A free-text filter applied by the SERVER, before "},{"type":"codeVoice","code":"offset"},{"type":"text","text":"\/"},{"code":"limit","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for none.","type":"text"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/PageRequest":{"kind":"symbol","url":"\/documentation\/axiamsdk\/pagerequest","type":"topic","navigatorTitle":[{"text":"PageRequest","kind":"identifier"}],"title":"PageRequest","abstract":[{"type":"text","text":"One page’s worth of "},{"code":"?offset=","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"?limit=","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"PageRequest","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest"},"