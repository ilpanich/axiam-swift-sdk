{"abstract":[{"text":"A free-text filter applied by the SERVER, before ","type":"text"},{"code":"offset","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"limit","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for none.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"search"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Matched case-insensitively against the identifying fields of whatever is being","type":"text"},{"text":" ","type":"text"},{"text":"listed — a name or username, plus the record id, so a UUID out of a log line can be","type":"text"},{"text":" ","type":"text"},{"text":"pasted in as-is. Which fields exactly is the server’s business; ","type":"text"},{"type":"codeVoice","code":"Page.total"},{"text":" then","type":"text"},{"text":" ","type":"text"},{"text":"counts MATCHES rather than rows, which is what lets a pager built on it show a page","type":"text"},{"text":" ","type":"text"},{"text":"count belonging to the result set it is paging.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It lives here, beside "},{"code":"offset","type":"codeVoice"},{"type":"text","text":" and "},{"code":"limit","type":"codeVoice"},{"type":"text","text":", rather than as an extra argument on each"},{"type":"text","text":" "},{"type":"text","text":"of the twenty generated "},{"code":"list","type":"codeVoice"},{"type":"text","text":" methods (§27.4 rule 4). That is what makes "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"carry it, and so what makes a manual walk filter the WHOLE walk: one that sent the"},{"type":"text","text":" "},{"type":"text","text":"term on its first request and dropped it on the second would return the matches"},{"type":"text","text":" "},{"type":"text","text":"followed by the unfiltered tail, which reads as a server bug from the caller’s side."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stored as the caller gave it; "},{"code":"queryPairs","type":"codeVoice"},{"type":"text","text":" is where it is normalised."}]}]}],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"role":"symbol","externalID":"s:8AxiamSDK11PageRequestV6searchSSSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"search","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"search","symbolKind":"property"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/pagerequest\/search"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest\/search"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PageRequest/search":{"abstract":[{"text":"A free-text filter applied by the SERVER, before ","type":"text"},{"code":"offset","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"limit","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for none.","type":"text"}],"role":"symbol","url":"\/documentation\/axiamsdk\/pagerequest\/search","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"search"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdent