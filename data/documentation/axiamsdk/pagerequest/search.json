{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest"]]},"abstract":[{"type":"text","text":"A free-text filter applied by the SERVER, before "},{"type":"codeVoice","code":"offset"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"limit"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for none."}],"variants":[{"paths":["\/documentation\/axiamsdk\/pagerequest\/search"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest\/search"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"search"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Matched case-insensitively against the identifying fields of whatever is being","type":"text"},{"text":" ","type":"text"},{"text":"listed — a name or username, plus the record id, so a UUID out of a log line can be","type":"text"},{"text":" ","type":"text"},{"text":"pasted in as-is. Which fields exactly is the server’s business; ","type":"text"},{"type":"codeVoice","code":"Page.total"},{"text":" then","type":"text"},{"text":" ","type":"text"},{"text":"counts MATCHES rather than rows, which is what lets a pager built on it show a page","type":"text"},{"text":" ","type":"text"},{"text":"count belonging to the result set it is paging.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It lives here, beside ","type":"text"},{"code":"offset","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"limit","type":"codeVoice"},{"text":", rather than as an extra argument on each","type":"text"},{"text":" ","type":"text"},{"text":"of the twenty generated ","type":"text"},{"code":"list","type":"codeVoice"},{"text":" methods (§27.4 rule 4). That is what makes ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"carry it, and so what makes a manual walk filter the WHOLE walk: one that sent the","type":"text"},{"text":" ","type":"text"},{"text":"term on its first request and dropped it on the second would return the matches","type":"text"},{"text":" ","type":"text"},{"text":"followed by the unfiltered tail, which reads as a server bug from the caller’s side.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stored as the caller gave it; "},{"type":"codeVoice","code":"queryPairs"},{"type":"text","text":" is where it is normalised."}]}],"kind":"content"}],"kind":"symbol","sections":[],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"symbolKind":"property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"search","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"externalID":"s:8AxiamSDK11PageRequestV6searchSSSgvp","title":"search"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PageRequest/search":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PageRequest\/search","abstract":[{"text":"A free-text filter applied by the SERVER, before ","type":"text"},{"code":"offset","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"limit","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for none.","type":"text"}],"url":"\/documentation\/axiamsdk\/pagerequest\/search","title":"search","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text"