ype":"text"},{"type":"codeVoice","code":"effect"},{"text":", both mean “allow”. No migration.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}],"title":"PermissionEffect","url":"\/documentation\/axiamsdk\/permissioneffect","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","role":"collection","type":"topic","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResolvedPermissionGrant"}],"url":"\/documentation\/axiamsdk\/resolvedpermissiongrant","abstract":[{"type":"text","text":"A permission grant with its scopes resolved. A superset of ["},{"code":"PermissionGrant","type":"codeVoice"},{"type":"text","text":"]: "},{"code":"scope_ids","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is still present and still authoritative, so a client written before "},{"code":"scopes","type":"codeVoice"},{"type":"text","text":" existed is"},{"type":"text","text":" "},{"type":"text","text":"unaffected."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant","title":"ResolvedPermissionGrant","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ResolvedPermissionGrant"}],"role":"symbol","type":"topic"}}}