{"abstract":[{"type":"text","text":"Whether the grant permits or refuses."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant\/effect"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","text":"PermissionEffect"}],"languages":["swift"],"platforms":["Linux"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/resolvedpermissiongrant\/effect"]}],"metadata":{"title":"effect","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"effect","kind":"identifier"},{"text":": ","kind":"text"},{"text":"PermissionEffect","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO"}],"externalID":"s:8AxiamSDK23ResolvedPermissionGrantV6effectAA0D6EffectOvp","roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"symbolKind":"property","role":"symbol"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant":{"url":"\/documentation\/axiamsdk\/resolvedpermissiongrant","abstract":[{"type":"text","text":"A permission grant with its scopes resolved. A superset of ["},{"code":"PermissionGrant","type":"codeVoice"},{"type":"text","text":"]: "},{"code":"scope_ids","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is still present and still authoritative, so a client written before "},{"code":"scopes","type":"codeVoice"},{"type":"text","text":" existed is"},{"type":"text","text":" "},{"type":"text","text":"unaffected."}],"title":"ResolvedPermissionGrant","navigatorTitle":[{"kind":"identifier","text":"ResolvedPermissionGrant"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResolvedPermissionGrant"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"title":"PermissionEffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"type":"strong","inlineContent":[{"type":"text","text":"and beats every allow"}]},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}],"kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}],"navigatorTitle":[{"text":"PermissionEffect","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/permissioneffect","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant/effect":{"abstract":[{"type":"text","text":"Whether the grant permits or refuses."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant\/effect","kind":"symbol","title":"effect","role":"symbol","url":"\/documentation\/axiamsdk\/resolvedpermissiongrant\/effect","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"effect"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","kind":"typeIdentifier","text":"PermissionEffect"}],"type":"topic"}}}