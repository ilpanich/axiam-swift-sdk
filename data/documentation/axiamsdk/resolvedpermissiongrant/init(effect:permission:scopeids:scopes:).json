tation\/AxiamSDK\/PermissionEffect","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"permission","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Permission","preciseIdentifier":"s:8AxiamSDK10PermissionV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Permission","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"scopeIds","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"scopes","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"GrantedScope","preciseIdentifier":"s:8AxiamSDK12GrantedScopeV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantedScope","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant":{"navigatorTitle":[{"kind":"identifier","text":"ResolvedPermissionGrant"}],"role":"symbol","abstract":[{"text":"A permission grant with its scopes resolved. A superset of [","type":"text"},{"code":"PermissionGrant","type":"codeVoice"},{"text":"]: ","type":"text"},{"code":"scope_ids","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is still present and still authoritative, so a client written before ","type":"text"},{"code":"scopes","type":"codeVoice"},{"text":" existed is","type":"text"},{"text":" ","type":"text"},{"text":"unaffected.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResolvedPermissionGrant"}],"title":"ResolvedPermissionGrant","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant","type":"topic","url":"\/documentation\/axiamsdk\/resolvedpermissiongrant"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"url":"\/documentation\/axiamsdk\/permissioneffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"inlineContent":[{"type":"text","text":"and beats every allow"}],"type":"strong"},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}],"type":"strong"},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"code":"effect","type":"codeVoice"},{"type":"text","text":", both mean “allow”. No migration."}],"navigatorTitle":[{"text":"PermissionEffect","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","title":"PermissionEffect","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant/init(effect:permission:scopeIds:scopes:)":{"title":"init(effect:permission:scopeIds:scopes:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"effect","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"permission","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Permission","preciseIdentifier":"s:8AxiamSDK10PermissionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"scopeIds","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"scopes","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"GrantedScope","preciseIdentifier":"s:8AxiamSDK12GrantedScopeV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant\/init(effect:permission:scopeIds:scopes:)","type":"topic","url":"\/documentation\/axiamsdk\/resolvedpermissiongrant\/init(effect:permission:scopeids:scopes:)","kind":"symbol","abstract":[],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/Permission":{"abstract":[{"text":"The ","type":"text"},{"code":"Permission","type":"codeVoice"},{"text":" schema.","type":"text"}],"navigatorTitle":[{"text":"Permission","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Permission"