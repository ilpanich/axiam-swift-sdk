":" ","type":"text"},{"text":"checkable property — ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"adding a deny rule can never widen access, and can never be undone by"},{"type":"text","text":" "},{"type":"text","text":"adding allows"}]},{"text":" — and most-specific-wins buys expressiveness at the cost of making “is X","type":"text"},{"text":" ","type":"text"},{"text":"denied?” unanswerable without enumerating every other rule that might out-specify it.","type":"text"},{"text":" ","type":"text"},{"text":"[","type":"text"},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"text":"] is the default, so data written before this existed, and clients","type":"text"},{"text":" ","type":"text"},{"text":"that send no ","type":"text"},{"type":"codeVoice","code":"effect"},{"text":", both mean “allow”. No migration.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant/init(effect:permission:scopeIds:scopes:)":{"title":"init(effect:permission:scopeIds:scopes:)","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant\/init(effect:permission:scopeIds:scopes:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"effect","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PermissionEffect","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO"},{"text":", ","kind":"text"},{"text":"permission","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK10PermissionV","kind":"typeIdentifier","text":"Permission"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scopeIds"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"preciseI