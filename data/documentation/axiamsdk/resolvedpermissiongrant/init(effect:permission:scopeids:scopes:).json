opes:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant\/init(effect:permission:scopeIds:scopes:)"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/Permission":{"title":"Permission","url":"\/documentation\/axiamsdk\/permission","navigatorTitle":[{"kind":"identifier","text":"Permission"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Permission","abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Permission"},{"text":" schema.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Permission"}]},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"url":"\/documentation\/axiamsdk\/permissioneffect","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"title":"PermissionEffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"type":"strong","inlineContent":[{"type":"text","text":"and beats every allow"}]},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"type":"text","text":"adding a deny rule can never widen access, and can never be undone by"},{"type":"text","text":" "},{"type":"text","text":"adding allows"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}]},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant":{"kind":"symbol","role":"symbol","title":"ResolvedPermissionGrant","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResolvedPermissionGrant","kind":"identifier"}],"abstract":[{"type":"text","text":"A permission grant with its scopes resolved. A superset of ["},{"type":"codeVoice","code":"PermissionGrant"},{"type":"text","text":"]: "},{"type":"codeVoice","code":"scope_ids"},{"type":"text","text":" "},{"type":"text","text":"is still present and still authoritative, so a client written before "},{"type":"codeVoice","code":"scopes"},{"type":"text","text":" existed is"},{"type":"text","text":" "},{"type":"text","text":"unaffected."}],"url":"\/documentation\/axiamsdk\/resolvedpermissiongrant","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant","type":"topic","navigatorTitle":[{"text":"ResolvedPermissionGrant","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/GrantedScope":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GrantedScope"}],"type":"topic","title":"GrantedScope","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantedScope","url":"\/documentation\/axiamsdk\/grantedscope","abstract":[{"type":"text","text":"A scope named by a grant, resolved to something a human can read."}],"navigatorTitle":[{"kind":"identifier","text":"GrantedScope"}]}}}