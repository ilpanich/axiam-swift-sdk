xternalParam","text":"permission"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Permission","preciseIdentifier":"s:8AxiamSDK10PermissionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scopeIds"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"GrantedScope","preciseIdentifier":"s:8AxiamSDK12GrantedScopeV"},{"kind":"text","text":"])"}],"role":"symbol","externalID":"s:8AxiamSDK23ResolvedPermissionGrantV6effect10permission8scopeIds6scopesAcA0D6EffectO_AA0D0VSaySSGSayAA12GrantedScopeVGtcfc","modules":[{"name":"AxiamSDK"}],"roleHeading":"Initializer","symbolKind":"init","title":"init(effect:permission:scopeIds:scopes:)"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"type":"topic","kind":"symbol","role":"symbol","title":"PermissionEffect","url":"\/documentation\/axiamsdk\/permissioneffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"type":"strong","inlineContent":[{"type":"text","text":"and beats every allow"}]},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResolvedPermissionGrant"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant","title":"ResolvedPermissionGrant","navigatorTitle":[{"kind":"identifier","text":"ResolvedPermissionGrant"}],"url":"\/documentation\/axiamsdk\/resolvedpermissiongrant","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A permission grant with its scopes resolved. A superset of ["},{"code":"PermissionGrant","type":"codeVoice"},{"type":"text","text":"]: "},{"code":"scope_ids","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is still present and still authoritative, so a client written before "},{"code":"scopes","type":"codeVoice"},{"type":"text","text":" existed is"},{"type":"text","text":" "},{"type":"text","text":"unaffected."}]},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant/init(effect:permission:scopeIds:scopes:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant\/init(effect:permission:scopeIds:scopes:)","abstract":[],"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"effect"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","text":"PermissionEffect","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"permission","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK10PermissionV","text":"Permission","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"scopeIds"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GrantedScopeV","text":"GrantedScope"},{"kind":"text","text":"])"}],"role":"symbol","title":"init(effect:permission:scopeIds:scopes:)","type":"topic","url":"\/documentation\/axiamsdk\/resolvedpermissiongrant\/init(effect:permission:scopeids:scopes:)"},"doc://AxiamSDK/documentation/AxiamSDK/Permission":{"title":"Permission","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Permission"}],"navigatorTitle":[{"kind":"identifier","text":"Permission"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Permission","kind":"symbol","url":"\/documentation\/axiamsdk\/permission","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Permission"},{"type":"text","text":" schema."}]},"doc://AxiamSDK/documentation/AxiamSDK/GrantedScope":{"type":"topic","title":"GrantedScope","iden