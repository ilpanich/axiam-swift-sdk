:" ","type":"text"},{"text":"is still present and still authoritative, so a client written before ","type":"text"},{"type":"codeVoice","code":"scopes"},{"text":" existed is","type":"text"},{"text":" ","type":"text"},{"text":"unaffected.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/resolvedpermissiongrant","navigatorTitle":[{"kind":"identifier","text":"ResolvedPermissionGrant"}],"title":"ResolvedPermissionGrant","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResolvedPermissionGrant"}]},"doc://AxiamSDK/documentation/AxiamSDK/GrantedScope":{"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GrantedScope"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantedScope","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GrantedScope"}],"title":"GrantedScope","abstract":[{"text":"A scope named by a grant, resolved to something a human can read.","type":"text"}],"url":"\/documentation\/axiamsdk\/grantedscope"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"title":"PermissionEffect","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] grant permits -> a ["},{"type":"codeVoice","code":"PermissionEffect::Deny"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"type":"strong","inlineContent":[{"text":"and beats every allow","type":"text"}]},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"type":"codeVoice","code":"effect"},{"type":"text","text":", both mean “allow”. No migration."}],"url":"\/documentation\/axiamsdk\/permissioneffect","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}]},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant/init(effect:permission:scopeIds:scopes:)":{"abstract":[],"kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/resolvedpermissiongrant\/init(effect:permission:scopeids:scopes:)","title":"init(effect:permission:scopeIds:scopes:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant\/init(effect:permission:scopeIds:scopes:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"effect","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"permission","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Permission","preciseIdentifier":"s:8AxiamSDK10PermissionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"scopeIds","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"scopes","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"GrantedScope","preciseIdentifier":"s:8AxiamSDK12GrantedScopeV","kind":"typeIdentifier"},{"text":"])","kind":"text"}]}}}