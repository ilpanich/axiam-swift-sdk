oc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect"},{"kind":"text","text":", "},{"kind":"externalParam","text":"permission"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK10PermissionV","kind":"typeIdentifier","text":"Permission","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Permission"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scopeIds"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8AxiamSDK12GrantedScopeV","kind":"typeIdentifier","text":"GrantedScope","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantedScope"},{"kind":"text","text":"])"}],"languages":["swift"],"platforms":["Linux"]}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] grant permits -> a ["},{"code":"PermissionEffect::Deny","type":"codeVoice"},{"type":"text","text":"] grant"},{"type":"text","text":" "},{"type":"text","text":"refuses, "},{"type":"strong","inlineContent":[{"type":"text","text":"and beats every allow"}]},{"type":"text","text":", wherever either sits in the resource hierarchy. Deny"},{"type":"text","text":" "},{"type":"text","text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"code":"claude_dev\/deny-override-design.md","type":"codeVoice"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"adding allows"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"code":"effect","type":"codeVoice"},{"type":"text","text":", both mean “allow”. No migration."}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"PermissionEffect","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"PermissionEffect","kind":"identifier"}],"title":"PermissionEffect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","url":"\/documentation\/axiamsdk\/permissioneffect"},"doc://AxiamSDK/documentation/AxiamSDK/GrantedScope":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GrantedScope","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/grantedscope","abstract":[{"type":"text","text":"A scope named by a grant, resolved to something a human can read."}],"type":"topic","title":"GrantedScope","navigatorTitle":[{"text":"GrantedScope","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GrantedScope"},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A permission grant with its scopes resolved. A superset of ["},{"type":"codeVoice","code":"PermissionGrant"},{"type":"text","text":"]: "},{"type":"codeVoice","code":"scope_ids"},{"type":"text","text":" "},{"type":"tex