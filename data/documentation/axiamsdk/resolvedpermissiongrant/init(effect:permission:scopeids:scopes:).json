:scopeIds:scopes:)":{"title":"init(effect:permission:scopeIds:scopes:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant\/init(effect:permission:scopeIds:scopes:)","abstract":[],"url":"\/documentation\/axiamsdk\/resolvedpermissiongrant\/init(effect:permission:scopeids:scopes:)","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"effect"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PermissionEffect","preciseIdentifier":"s:8AxiamSDK16PermissionEffectO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"permission"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Permission","preciseIdentifier":"s:8AxiamSDK10PermissionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scopeIds"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"scopes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"GrantedScope","preciseIdentifier":"s:8AxiamSDK12GrantedScopeV"},{"kind":"text","text":"])"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/PermissionEffect":{"title":"PermissionEffect","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PermissionEffect","navigatorTitle":[{"kind":"identifier","text":"PermissionEffect"}],"abstract":[{"type":"text","text":"Whether a grant permits an action or refuses it (B1, deny-override). # Precedence Default"},{"type":"text","text":" "},{"type":"text","text":"deny -> an ["},{"type":"codeVoice","code":"PermissionEffect::Allow"},{"text":"] grant permits -> a [","type":"text"},{"code":"PermissionEffect::Deny","type":"codeVoice"},{"text":"] grant","type":"text"},{"text":" ","type":"text"},{"text":"refuses, ","type":"text"},{"inlineContent":[{"type":"text","text":"and beats every allow"}],"type":"strong"},{"text":", wherever either sits in the resource hierarchy. Deny","type":"text"},{"text":" ","type":"text"},{"text":"wins; there is no most-specific-wins tie-break. That choice is deliberate and is argued in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"full in "},{"type":"codeVoice","code":"claude_dev\/deny-override-design.md"},{"type":"text","text":" §2.1. The short version: deny-override buys one"},{"type":"text","text":" "},{"type":"text","text":"checkable property — "},{"type":"strong","inlineContent":[{"text":"adding a deny rule can never widen access, and can never be undone by","type":"text"},{"text":" ","type":"text"},{"text":"adding allows","type":"text"}]},{"type":"text","text":" — and most-specific-wins buys expressiveness at the cost of making “is X"},{"type":"text","text":" "},{"type":"text","text":"denied?” unanswerable without enumerating every other rule that might out-specify it."},{"type":"text","text":" "},{"type":"text","text":"["},{"code":"PermissionEffect::Allow","type":"codeVoice"},{"type":"text","text":"] is the default, so data written before this existed, and clients"},{"type":"text","text":" "},{"type":"text","text":"that send no "},{"code":"effect","type":"codeVoice"},{"type":"text","text":", both mean “allow”. No migration."}],"url":"\/documentation\/axiamsdk\/permissioneffect","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionEffect"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/ResolvedPermissionGrant":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ResolvedPermissionGrant","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResolvedPermissionGrant","kind":"identifier"}],"navigatorTitle":[{"text":"ResolvedPermissionGrant","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/resolvedpermissiongrant","title":"ResolvedPermissionGrant","abstract":[{"text":"A permission grant with its scopes resolved. A superset of [","type":"text"},{"code":"PermissionGrant","type":"codeVoice"},{"text":"]: ","type":"text"},{"code":"scope_ids","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is still present and still authoritative, so a client written before ","type":"text"},{"code":"scopes","type":"codeVoice"},{"text":" existed is","type":"text"},{"text":" ","type":"text"},{"text":"unaffected.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}