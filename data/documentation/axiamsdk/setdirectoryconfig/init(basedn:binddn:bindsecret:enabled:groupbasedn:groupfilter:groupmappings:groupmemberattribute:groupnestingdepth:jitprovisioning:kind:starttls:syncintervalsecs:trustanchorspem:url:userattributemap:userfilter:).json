nts\/{tenant_id}\/directory","type":"codeVoice"},{"text":" — a ","type":"text"},{"inlineContent":[{"text":"replacement","type":"text"}],"type":"strong"},{"text":". Every ","type":"text"},{"code":"DirectoryConfig","type":"codeVoice"},{"text":" ","type":"text"},{"text":"member except ","type":"text"},{"code":"id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tenant_id","type":"codeVoice"},{"text":" and the two timestamps, plus the write-only ","type":"text"},{"code":"bind_secret","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"An omitted optional member is ","type":"text"},{"inlineContent":[{"type":"text","text":"reset to its default"}],"type":"strong"},{"text":", not kept.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"SetDirectoryConfig"}],"type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryKind":{"abstract":[{"type":"text","text":"Which kind of directory server a configuration points at. It drives "},{"type":"strong","inlineContent":[{"text":"defaults only","type":"text"}]},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"external-id attribute, the group-membership strategy and the change attribute the sync job","type":"text"},{"text":" ","type":"text"},{"text":"reads. Every one of them is still an explicit, editable field of the configuration (or, for","type":"text"},{"text":" ","type":"text"},{"text":"the strategy and change attribute, derived from this value at the point of use); nothing","type":"text"},{"text":" ","type":"text"},{"text":"about the kind changes what is ","type":"text"},{"inlineContent":[{"text":"allowed","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"url":"\/documentation\/axiamsdk\/directorykind","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind","title":"DirectoryKind","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectoryKind"}],"fragments":[{"kind":