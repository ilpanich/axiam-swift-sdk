o several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"title":"GroupMapping","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"url":"\/documentation\/axiamsdk\/sensitive","kind":"symbol","abstract":[{"text":"A wrapper for secret material (§7 of CONTRACT.md).","type":"text"}],"title":"Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryKind":{"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DirectoryKind"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind","title":"DirectoryKind","url":"\/documentation\/axiamsdk\/directorykind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectoryKind"}],"abstract":[{"type":"text","text":"Which kind of directory server a configuration points at. It drives "},{"type":"strong","inlineContent":[{"type":"text","text":"defaults only"}]},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"external-id attribute, the group-membership strategy and the change attribute the sync job"},{"type":"text","text":" "},{"type":"text","text":"reads. Ever