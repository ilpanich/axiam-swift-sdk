{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"DirectoryKind","preciseIdentifier":"s:8AxiamSDK13DirectoryKindO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"startTLS","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"syncIntervalSecs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"trustAnchorsPEM","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]?, ","kind":"text"},{"text":"url","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"userAttributeMap","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UserAttributeMap","preciseIdentifier":"s:8AxiamSDK16UserAttributeMapV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"userFilter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(baseDn:bindDn:bindSecret:enabled:groupBaseDn:groupFilter:groupMappings:groupMemberAttribute:groupNestingDepth:jitProvisioning:kind:startTLS:syncIntervalSecs:trustAnchorsPEM:url:userAttributeMap:userFilter:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig\/init(baseDn:bindDn:bindSecret:enabled:groupBaseDn:groupFilter:groupMappings:groupMemberAttribute:groupNestingDepth:jitProvisioning:kind:startTLS:syncIntervalSecs:trustAnchorsPEM:url:userAttributeMap:userFilter:)","abstract":[],"url":"\/documentation\/axiamsdk\/setdirectoryconfig\/init(basedn:binddn:bindsecret:enabled:groupbasedn:groupfilter:groupmappings:groupmemberattribute:groupnestingdepth:jitprovisioning:kind:starttls:syncintervalsecs:trustanchorspem:url:userattributemap:userfilter:)","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"title":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"url":"\/documentation\/axiamsdk\/groupmapping","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"url":"\/documentation\/axiamsdk\/sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","title":"Sensitive","role":"symbol","abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}]}}}