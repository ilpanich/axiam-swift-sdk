tation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"title":"Sensitive","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","url":"\/documentation\/axiamsdk\/sensitive","kind":"symbol","abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/SetDirectoryConfig":{"navigatorTitle":[{"kind":"identifier","text":"SetDirectoryConfig"}],"url":"\/documentation\/axiamsdk\/setdirectoryconfig","title":"SetDirectoryConfig","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SetDirectoryConfig"}],"abstract":[{"type":"codeVoice","code":"PUT \/api\/v1\/tenants\/{tenant_id}\/directory"},{"type":"text","text":" — a "},{"type":"strong","inlineContent":[{"type":"text","text":"replacement"}]},{"type":"text","text":". Every "},{"type":"codeVoice","code":"DirectoryConfig"},{"type":"text","text":" "},{"type":"text","text":"member except "},{"code":"id","type":"codeVoice"},{"type":"text","text":", "},{"code":"tenant_id","type":"codeVoice"},{"type":"text","text":" and the two timestamps, plus the write-only "},{"code":"bind_secret","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"An omitted optional member is "},{"type":"strong","inlineContent":[{"type":"text","text":"reset to its default"}]},{"type":"text","text":", not kept."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"role":"symbol","url":"\/documentation\/axiamsdk\/groupmapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","type":"topic","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"text":"way a directory group reaches an AXIAM group.","type":"text"}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"title":"GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/UserAttributeMap":{"navigatorTitle":[{"kind":"identifier","text":"UserAttributeMap"}],"url":"\/documentation\/axiamsdk\/userattributemap","title":"UserAttributeMap","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UserAttributeMap"}],"kind":"symbol","abstract":[{"text":"Which directory attribute feeds each AXIAM user field.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserAttributeMap"}}}