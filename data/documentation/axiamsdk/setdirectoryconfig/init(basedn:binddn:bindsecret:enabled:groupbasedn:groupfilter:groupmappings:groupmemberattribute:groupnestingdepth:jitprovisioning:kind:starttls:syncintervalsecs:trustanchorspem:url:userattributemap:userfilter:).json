rustAnchorsPEM"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"url"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"userAttributeMap"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK16UserAttributeMapV","kind":"typeIdentifier","text":"UserAttributeMap"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"userFilter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}],"type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/UserAttributeMap":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserAttributeMap","role":"symbol","url":"\/documentation\/axiamsdk\/userattributemap","navigatorTitle":[{"text":"UserAttributeMap","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UserAttributeMap","kind":"identifier"}],"title":"UserAttributeMap","kind":"symbol","abstract":[{"text":"Which directory attribute feeds each AXIAM user field.","type":"text"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/SetDirectoryConfig":{"title":"SetDirectoryConfig","abstract":[{"type":"codeVoice","code":"PUT \/api\/v1\/tenants\/{tenant_id}\/directory"},{"text":" — a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"replacement"}]},{"text":". Every ","type":"text"},{"type":"codeVoice","code":"DirectoryConfig"},{"text":" ","type":"text"},{"text":"member except ","type":"text"},{"type":"codeVoice","code":"id"},{"text":", ","type":"text"},{"type":"codeVoice","code":"tenant_id"},{"text":" and the two timestamps, plus the write-only ","type":"text"},{"type":"codeVoice","code":"bind_secret"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"An omitted optional member is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"reset to its default"}]},{"text":", not kept.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SetDirectoryConfig","kind":"identifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/setdirectoryconfig","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"SetDirectoryConfig","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryKind":{"title":"DirectoryKind","type":"topic","navigatorTitle":[{"text":"DirectoryKind","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/directorykind","role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectoryKind","kind":"identifier"}],"abstract":[{"text":"Which kind of directory server a configuration points at. It drives ","type":"text"},{"inlineContent":[{"text":"defaults only","type":"text"}],"type":"strong"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"external-id attribute, the group-membership strategy and the change attribute the sync job","type":"text"},{"text":" ","type":"text"},{"text":"reads. Every one of them is still an explicit, editable field of the configuration (or, for","type":"text"},{"text":" ","type":"text"},{"text":"the strategy and change attribute, derived from this value at the point of use); nothing","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"about the kind changes what is "},{"inlineContent":[{"text":"allowed","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}],"abstract":[{"text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its","type":"text"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"kind":"symbol","title":"GroupMapping","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/groupmapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"title":"Sensitive","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"url":"\/documentation\/axiamsdk\/sensitive","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive"}}}