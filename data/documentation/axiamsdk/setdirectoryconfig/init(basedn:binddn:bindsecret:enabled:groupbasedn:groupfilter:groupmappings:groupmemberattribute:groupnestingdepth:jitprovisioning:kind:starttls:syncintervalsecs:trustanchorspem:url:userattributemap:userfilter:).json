ymbol","navigatorTitle":[{"text":"SetDirectoryConfig","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SetDirectoryConfig","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryKind":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind","navigatorTitle":[{"text":"DirectoryKind","kind":"identifier"}],"kind":"symbol","title":"DirectoryKind","role":"symbol","abstract":[{"type":"text","text":"Which kind of directory server a configuration points at. It drives "},{"type":"strong","inlineContent":[{"text":"defaults only","type":"text"}]},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"external-id attribute, the group-membership strategy and the change attribute the sync job"},{"type":"text","text":" "},{"type":"text","text":"reads. Every one of them is still an explicit, editable field of the configuration (or, for"},{"type":"text","text":" "},{"type":"text","text":"the strategy and change attribute, derived from this value at the point of use); nothing"},{"type":"text","text":" "},{"type":"text","text":"about the kind changes what is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"allowed"}]},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/axiamsdk\/directorykind","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectoryKind","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/SetDirectoryConfig/init(baseDn:bindDn:bindSecret:enabled:groupBaseDn:groupFilter:groupMappings:groupMemberAttribute:groupNestingDepth:jitProvisioning:kind:startTLS:syncInter