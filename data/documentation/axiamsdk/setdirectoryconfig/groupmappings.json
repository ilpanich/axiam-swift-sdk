{"sections":[],"abstract":[{"type":"text","text":"At most 500; every "},{"type":"codeVoice","code":"group_id"},{"type":"text","text":" a group of the tenant. Default empty."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"property","modules":[{"name":"AxiamSDK"}],"role":"symbol","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","text":"GroupMapping"},{"kind":"text","text":"]?"}],"externalID":"s:8AxiamSDK18SetDirectoryConfigV13groupMappingsSayAA12GroupMappingVGSgvp","title":"groupMappings"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/setdirectoryconfig\/groupmappings"]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig\/groupMappings","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK12GroupMappingV","text":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/SetDirectoryConfig/groupMappings":{"abstract":[{"type":"text","text":"At most 500; every "},{"type":"codeVoice","code":"group_id"},{"text":" a group of the tenant. Default empty.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig\/groupMappings","title":"groupMappings","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK12GroupMappingV","text":"GroupMapping","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"url":"\/documentation\/axiamsdk\/setdirectoryconfig\/groupmappings"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"title":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"url":"\/documentation\/axiamsdk\/groupmapping","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/SetDirectoryConfig":{"type":"topic","abstract":[{"type":"codeVoice","code":"PUT \/api\/v1\/tenants\/{tenant_id}\/directory"},{"text":" — a ","type":"text"},{"inlineContent":[{"text":"replacement","type":"text"}],"type":"strong"},{"text":". Every ","type":"text"},{"type":"codeVoice","code":"DirectoryConfig"},{"type":"text","text":" "},{"type":"text","text":"member except "},{"type":"codeVoice","code":"id"},{"type":"text","text":", "},{"type":"codeVoice","code":"tenant_id"},{"text":" and the two timestamps, plus the write-only ","type":"text"},{"type":"codeVoice","code":"bind_secret"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"An omitted optional member is ","type":"text"},{"inlineContent":[{"text":"reset to its default","type":"text"}],"type":"strong"},{"text":", not kept.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig","url":"\/documentation\/axiamsdk\/setdirectoryconfig","title":"SetDirectoryConfig","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"SetDirectoryConfig","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SetDirectoryConfig","kind":"identifier"}]}}}