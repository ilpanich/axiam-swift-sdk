a member of it is put into. ","type":"text"},{"inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"axiam_directory::dn","type":"codeVoice"},{"text":"), so ","type":"text"},{"code":"CN=Staff, OU=Groups","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cn=staff,ou=groups","type":"codeVoice"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"title":"GroupMapping","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/SetDirectoryConfig":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SetDirectoryConfig"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig","title":"SetDirectoryConfig","url":"\/documentation\/axiamsdk\/setdirectoryconfig","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SetDirectoryConfig"}],"kind":"symbol","abstract":[{"code":"PUT \/api\/v1\/tenants\/{tenant_id}\/directory","type":"codeVoice"},{"text":" — a ","type":"text"},{"inlineContent":[{"text":"replacement","type":"text"}],"type":"strong"},{"text":". Every ","type":"text"},{"code":"DirectoryConfig","type":"codeVoice"},{"text":" ","type":"text"},{"text":"member except ","type":"text"},{"code":"id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tenant_id","type":"codeVoice"},{"text":" and the two timestamps, plus the write-only ","type":"text"},{"code":"bind_secret","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"An omitted optional member is ","type":"text"},{"inlineContent":[{"type":"text","text":"reset to its default"}],"type":"strong"},{"text":", not kept.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/SetDirectoryConfig/groupMappings":{"kind":"symbol","abstract":[{"text":"At most 500; every ","type":"text"},{"code":"group_id","type":"codeVoice"},{"text":" a group of the tenant. Default empty.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig\/groupMappings","role":"symbol","title":"groupMappings","url":"\/documentation\/axiamsdk\/setdirectoryconfig\/groupmappings","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8AxiamSDK12GroupMappingV","kind":"typeIdentifier","text":"GroupMapping"},{"kind":"text","text":"]?"}]}}}