{"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig\/groupMappings","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"At most 500; every "},{"type":"codeVoice","code":"group_id"},{"type":"text","text":" a group of the tenant. Default empty."}],"metadata":{"role":"symbol","symbolKind":"property","modules":[{"name":"AxiamSDK"}],"title":"groupMappings","roleHeading":"Instance Property","externalID":"s:8AxiamSDK18SetDirectoryConfigV13groupMappingsSayAA12GroupMappingVGSgvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","text":"GroupMapping"},{"kind":"text","text":"]?"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","preciseIdentifier":"s:8AxiamSDK12GroupMappingV"},{"kind":"text","text":"]?"}]}]}],"variants":[{"paths":["\/documentation\/axiamsdk\/setdirectoryconfig\/groupmappings"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/SetDirectoryConfig/groupMappings":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK12GroupMappingV","kind":"typeIdentifier","text":"GroupMapping"},{"kind":"text","text":"]?"}],"type":"topic","abstract":[{"type":"text","text":"At most 500; every "},{"type":"codeVoice","code":"group_id"},{"type":"text","text":" a group of the tenant. Default empty."}],"role":"symbol","title":"groupMappings","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig\/groupMappings","kind":"symbol","url":"\/documentation\/axiamsdk\/setdirectoryconfig\/groupmappings"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"abstract":[{"text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its","type":"text"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"inlineContent":[{"text":"The table is the only","type":"text"},{"text":" ","type":"text"},{"text":"way a directory group reaches an AXIAM group.","type":"text"}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"type":"codeVoice","code":"admins"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"axiam_directory::dn"},{"text":"), so ","type":"text"},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}],"title":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","url":"\/documentation\/axiamsdk\/groupmapping","kind":"symbol","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/SetDirectoryConfig":{"abstract":[{"type":"codeVoice","code":"PUT \/api\/v1\/tenants\/{tenant_id}\/directory"},{"text":" — a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"replacement"}]},{"text":". Every ","type":"text"},{"type":"codeVoice","code":"DirectoryConfig"},{"text":" ","type":"text"},{"text":"member except ","type":"text"},{"type":"codeVoice","code":"id"},{"text":", ","type":"text"},{"type":"codeVoice","code":"tenant_id"},{"text":" and the two timestamps, plus the write-only ","type":"text"},{"type":"codeVoice","code":"bind_secret"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"An omitted optional member is ","type":"text"},{"type":"strong","inlineContent":[{"text":"reset to its default","type":"text"}]},{"text":", not kept.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SetDirectoryConfig","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/axiamsdk\/setdirectoryconfig","title":"SetDirectoryConfig","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig","navigatorTitle":[{"text":"SetDirectoryConfig","kind":"identifier"}],"kind":"symbol"}}}