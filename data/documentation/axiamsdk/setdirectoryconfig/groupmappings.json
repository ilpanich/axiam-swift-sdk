{"sections":[],"metadata":{"role":"symbol","roleHeading":"Instance Property","symbolKind":"property","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"externalID":"s:8AxiamSDK18SetDirectoryConfigV13groupMappingsSayAA12GroupMappingVGSgvp","title":"groupMappings"},"abstract":[{"type":"text","text":"At most 500; every "},{"code":"group_id","type":"codeVoice"},{"type":"text","text":" a group of the tenant. Default empty."}],"variants":[{"paths":["\/documentation\/axiamsdk\/setdirectoryconfig\/groupmappings"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig\/groupMappings","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","text":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},{"kind":"text","text":"]?"}],"languages":["swift"],"platforms":["Linux"]}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig"]]},"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/SetDirectoryConfig":{"title":"SetDirectoryConfig","abstract":[{"type":"codeVoice","code":"PUT \/api\/v1\/tenants\/{tenant_id}\/directory"},{"text":" — a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"replacement"}]},{"text":". Every ","type":"text"},{"type":"codeVoice","code":"DirectoryConfig"},{"text":" ","type":"text"},{"text":"member except ","type":"text"},{"type":"codeVoice","code":"id"},{"text":", ","type":"text"},{"type":"codeVoice","code":"tenant_id"},{"text":" and the two timestamps, plus the write-only ","type":"text"},{"type":"codeVoice","code":"bind_secret"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"An omitted optional member is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"reset to its default"}]},{"text":", not kept.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SetDirectoryConfig","kind":"identifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/setdirectoryconfig","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"SetDirectoryConfig","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}],"abstract":[{"text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its","type":"text"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"kind":"symbol","title":"GroupMapping","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/groupmapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/SetDirectoryConfig/groupMappings":{"title":"groupMappings","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SetDirectoryConfig\/groupMappings","abstract":[{"text":"At most 500; every ","type":"text"},{"code":"group_id","type":"codeVoice"},{"text":" a group of the tenant. Default empty.","type":"text"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/setdirectoryconfig\/groupmappings","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"type":"topic","role":"symbol"}}}