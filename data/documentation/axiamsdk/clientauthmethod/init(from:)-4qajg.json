horization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"type":"topic","title":"ClientAuthMethod"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod/init(from:)-4qajg":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/init(from:)-4qajg","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"url":"\/documentation\/axiamsdk\/clientauthmethod\/init(from:)-4qajg","title":"init(from:)","abstract":[{"text":"Decodes an unrecognised value to ","type":"text"},{"type":"codeVoice","code":".unknown"},{"text":" instead of throwing.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"}}}