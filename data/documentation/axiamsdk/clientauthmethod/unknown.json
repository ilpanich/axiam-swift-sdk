DK/ClientAuthMethod":{"abstract":[{"text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming).","type":"text"},{"text":" ","type":"text"},{"text":"Only the methods AXIAM actually implements are representable. ","type":"text"},{"code":"None","type":"codeVoice"},{"text":" — the public-client","type":"text"},{"text":" ","type":"text"},{"text":"value — was deliberately absent until T21.2: adding it before the rest of the server","type":"text"},{"text":" ","type":"text"},{"text":"understood one would have let an operator register a client whose authentication is silently","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The server understands one now (","type":"text"},{"code":"token.rs","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"authenticate_client_credential","type":"codeVoice"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"an arm that accepts ","type":"text"},{"inlineContent":[{"text":"no","type":"text"}],"type":"emphasis"},{"text":" credential and refuses a presented one, the authorization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"kind":"symbol","title":"ClientAuthMethod","type":"topic","navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/clientauthmethod","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}]}}}