{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"symbolKind":"case","modules":[{"name":"AxiamSDK"}],"role":"symbol","roleHeading":"Case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}],"title":"ClientAuthMethod.unknown","externalID":"s:8AxiamSDK16ClientAuthMethodO7unknownyA2CmF"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/unknown"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}],"languages":["swift"]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/clientauthmethod\/unknown"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod"]]},"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/clientauthmethod","title":"ClientAuthMethod","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming)."},{"type":"text","text":" "},{"type":"text","text":"Only the methods AXIAM actually implements are representable. "},{"code":"None","type":"codeVoice"},{"type":"text","text":" — the public-client"},{"type":"text","text":" "},{"type":"text","text":"value — was deliberately absent until T21.2: adding it before the rest of the server"},{"type":"text","text":" "},{"type":"text","text":"understood one would have let an operator register a client whose authentication is silently"},{"type":"text","text":" "},{"type":"text","text":"skipped. The server understands one now ("},{"code":"token.rs","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"authenticate_client_credential","type":"codeVoice"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"an arm that accepts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"no"}]},{"type":"text","text":" credential and refuses a presented one, the authorization endpoint"},{"type":"text","text":" "},{"type":"text","text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside"},{"type":"text","text":" "},{"type":"text","text":"any grant or binding that contradicts it), so the variant exists — and only that arm may"},{"type":"text","text":" "},{"type":"text","text":"ever treat a missing credential as success."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod/unknown":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/unknown","url":"\/documentation\/axiamsdk\/clientauthmethod\/unknown","type":"topic","abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}],"title":"ClientAuthMethod.unknown"}}}