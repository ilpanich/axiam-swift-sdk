: adding it before the rest of the server","type":"text"},{"text":" ","type":"text"},{"text":"understood one would have let an operator register a client whose authentication is silently","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The server understands one now (","type":"text"},{"code":"token.rs","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"authenticate_client_credential","type":"codeVoice"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"an arm that accepts ","type":"text"},{"inlineContent":[{"type":"text","text":"no"}],"type":"emphasis"},{"text":" credential and refuses a presented one, the authorization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"type":"topic","title":"ClientAuthMethod"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod/none":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/none","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"none","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/clientauthmethod\/none","title":"ClientAuthMethod.none","abstract":[],"type":"topic","role":"symbol","kind":"symbol"}}}