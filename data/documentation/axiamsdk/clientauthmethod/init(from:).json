{"abstract":[{"type":"text","text":"Decodes an unrecognised value to "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" instead of throwing."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"decoder"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The synthesised "},{"code":"RawRepresentable","type":"codeVoice"},{"type":"text","text":" initializer stays strict — "},{"code":"init(rawValue:)","type":"codeVoice"},{"type":"text","text":" is still"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for a value that is not a case — so code that deliberately parses a raw string"},{"type":"text","text":" "},{"type":"text","text":"keeps its check. Only DECODING, where the alternative is failing a whole response, is"},{"type":"text","text":" "},{"type":"text","text":"lenient."}]}]}],"variants":[{"paths":["\/documentation\/axiamsdk\/clientauthmethod\/init(from:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"init","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"roleHeading":"Initializer","title":"init(from:)","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK16ClientAuthMethodO4fromACs7Decoder_p_tKcfc"},"hierarchy":{"paths":[["doc:\/