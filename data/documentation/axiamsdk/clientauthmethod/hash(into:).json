t":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"abstract":[{"type":"text","text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming)."},{"type":"text","text":" "},{"type":"text","text":"Only the methods AXIAM actually implements are representable. "},{"type":"codeVoice","code":"None"},{"type":"text","text":" — the public-client"},{"type":"text","text":" "},{"type":"text","text":"value — was deliberately absent until T21.2: adding it before the rest of the server"},{"type":"text","text":" "},{"type":"text","text":"understood one would have let an operator register a client whose authentication is silently"},{"type":"text","text":" "},{"type":"text","text":"skipped. The server understands one now ("},{"type":"codeVoice","code":"token.rs"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"authenticate_client_credential"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"an arm that accepts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"no"}]},{"type":"text","text":" credential and refuses a presented one, the authorization endpoint"},{"type":"text","text":" "},{"type":"text","text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside"},{"type":"text","text":" "},{"type":"text","text":"any grant or binding that contradicts it), so the variant exists — and only that arm may"},{"type":"text","text":" "},{"type":"text","text":"ever treat a missing credential as success."}],"title":"ClientAuthMethod","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","role":"symbol","navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/clientauthmethod"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}