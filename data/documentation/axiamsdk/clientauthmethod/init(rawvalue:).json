"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"rawValue"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":")"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod\/init(rawValue:)"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"role":"symbol","url":"\/documentation\/axiamsdk\/clientauthmethod","abstract":[{"text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming).","type":"text"},{"text":" ","type":"text"},{"text":"Only the methods AXIAM actually implements are representable. ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" — the public-client","type":"text"},{"text":" ","type":"text"},{"text":"value — was deliberately absent until T21.2: adding it before the rest of the server","type":"text"},{"text":" ","type":"text"},{"text":"understood one would have let an operator register a client whose authentication is silently","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The server understands one now (","type":"text"},{"type":"codeVoice","code":"token.rs"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"authenticate_client_credential"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"an arm that accepts ","type":"text"},{"inlineContent":[{"type":"text","text":"no"}],"type":"emphasis"},{"text":" credential and refuses a presented one, the authorization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","t