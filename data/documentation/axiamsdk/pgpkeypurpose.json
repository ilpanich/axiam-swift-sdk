{"abstract":[{"text":"The purpose of an OpenPGP key.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PgpKeyPurpose"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"inlineContent":[{"text":"open","type":"text"}],"type":"strong"},{"text":" enum. A value this SDK’s copy of the spec does not list decodes to ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there","type":"text"},{"text":" ","type":"text"},{"text":"fails the WHOLE response, so one field of one record would take down the page it was on,","type":"text"},{"text":" ","type":"text"},{"text":"including the records the caller did ask for.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is never written: "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"type":"codeVoice","code":"\"\""},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/pgpkeypurpose"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"roleHeading":"Enumeration","title":"PgpKeyPurpose","externalID":"s:8AxiamSDK13PgpKeyPurposeO","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PgpKeyPurpose","kind":"identifier"}],"symbolKind":"enum","navigatorTitle":[{"text":"PgpKeyPurpose","kind":"identifier"}],"role":"symbol"},"topicSections":[{"anchor":"Enumeration-Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/auditSigning","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/export","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/unknown"],"generated":true,"title":"Enumeration Cases"},{"anchor":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/init(rawValue:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/encode(to:)"],"generated":true,"title":"Instance Methods"},{"anchor":"Default-Implementati