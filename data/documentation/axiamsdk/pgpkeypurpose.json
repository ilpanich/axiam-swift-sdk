{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PgpKeyPurpose"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"An "},{"type":"strong","inlineContent":[{"text":"open","type":"text"}]},{"type":"text","text":" enum. A value this SDK’s copy of the spec does not list decodes to "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" "},{"type":"text","text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there"},{"type":"text","text":" "},{"type":"text","text":"fails the WHOLE response, so one field of one record would take down the page it was on,"},{"type":"text","text":" "},{"type":"text","text":"including the records the caller did ask for."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is never written: "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"type":"codeVoice","code":"\"\""},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"The purpose of an OpenPGP key."}],"sections":[],"metadata":{"navigatorTitle":[{"text":"PgpKeyPurpose","kind":"identifier"}],"role":"symbol","symbolKind":"enum","roleHeading":"Enumeration","externalID":"s:8AxiamSDK13PgpKeyPurposeO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PgpKeyPurpose","kind":"identifier"}],"title":"PgpKeyPurpose","modules":[{"name":"AxiamSDK"}]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/auditSigning","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/export","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/unknown"],"title":"Enumeration Cases"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/init(from:)-2c86c","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/init(rawValue:)"],"title":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/encode(to:)"],"title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PgpKeyPurpose\/RawRepresentable-Implementations"],"title":"Default Implementations"}],"variants":[{"paths":["\/documentation\/axiamsdk\/pgpkeypurpose"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP"],"title":"Conforms To"}],"hierarchy":{"paths