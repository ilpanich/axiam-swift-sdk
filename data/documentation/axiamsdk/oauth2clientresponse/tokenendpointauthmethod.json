xt","text":"any grant or binding that contradicts it), so the variant exists — and only that arm may"},{"type":"text","text":" "},{"type":"text","text":"ever treat a missing credential as success."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"title":"OAuth2ClientResponse","url":"\/documentation\/axiamsdk\/oauth2clientresponse","navigatorTitle":[{"kind":"identifier","text":"OAuth2ClientResponse"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","abstract":[{"text":"OAuth2 client response – omits client_secret_hash.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OAuth2ClientResponse"}]}}}