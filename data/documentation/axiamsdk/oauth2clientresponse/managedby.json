ry the FAPI profile, is always consent-gated, and is the"},{"type":"text","text":" "},{"type":"text","text":"only kind the unused-client sweeper touches. Read-only. There is no corresponding member"},{"type":"text","text":" "},{"type":"text","text":"on the update DTO: a registration’s provenance is a fact about how it came to exist, and"},{"type":"text","text":" "},{"type":"text","text":"a field that could be edited to "},{"type":"codeVoice","code":"admin"},{"type":"text","text":" would be a field that launders one."}],"url":"\/documentation\/axiamsdk\/oauth2clientresponse\/managedby","kind":"symbol"},"Self::Dcr":{"identifier":"Self::Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"title":"Dcr","type":"link","url":"Self::Dcr"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","navigatorTitle":[{"text":"OAuth2ClientResponse","kind":"identifier"}],"title":"OAuth2ClientResponse","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OAuth2ClientResponse","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/oauth2clientresponse","abstract":[{"text":"OAuth2 client response – omits client_secret_hash.","type":"text"}]},"Self::Admin":{"identifier":"Self::Admin","titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"title":"Admin","type":"link","url":"Self::Admin"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}