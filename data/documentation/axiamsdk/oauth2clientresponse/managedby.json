text":"registration an administrator made from one that arrived over an open endpoint. Three things","type":"text"},{"text":" ","type":"text"},{"text":"read it and each would otherwise have to infer provenance from something that is not","type":"text"},{"text":" ","type":"text"},{"text":"provenance: * ","type":"text"},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"text":" refuses a FAPI profile on anything but","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"Self::Admin"},{"text":" (I5) — a client nobody vetted cannot be financial-grade; * the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper","type":"text"},{"text":" ","type":"text"},{"text":"deletes only ","type":"text"},{"identifier":"Self::Dcr","type":"reference","isActive":true},{"text":" rows, so an administrator’s client is never swept however","type":"text"},{"text":" ","type":"text"},{"text":"long it sits unused. ","type":"text"},{"overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"identifier":"Self::Admin","type":"reference","isActive":true},{"text":" is the serde default and therefore what every","type":"text"},{"text":" ","type":"text"},{"text":"row written before T21.4 decodes to, which is the truth: they were all created through ","type":"text"},{"code":"POST \/oauth2-clients","type":"codeVoice"},{"text":" by somebody holding ","type":"text"},{"code":"oauth2_clients:create","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"Self::Dcr":{"url":"Self::Dcr","title":"Dcr","type":"link","identifier":"Self::Dcr","titleInlineContent":[{"code":"Dcr","type":"codeVoice"}]},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/managedBy":{"fragments":[{"kind":"keyword","text"