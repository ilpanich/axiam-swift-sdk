ield that launders one.","type":"text"}],"metadata":{"modules":[{"name":"AxiamSDK"}],"title":"managedBy","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"managedBy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ManagedBy","preciseIdentifier":"s:8AxiamSDK9ManagedByO","kind":"typeIdentifier"}],"roleHeading":"Instance Property","symbolKind":"property","role":"symbol","externalID":"s:8AxiamSDK20OAuth2ClientResponseV9managedByAA07ManagedG0Ovp"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/managedBy":{"url":"\/documentation\/axiamsdk\/oauth2clientresponse\/managedby","title":"managedBy","abstract":[{"text":"T21.4 \/ D5 — who created this registration: ","type":"text"},{"code":"admin","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dcr","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"cimd","type":"codeVoice"},{"text":". Echoed because an","type":"text"},{"text":" ","type":"text"},{"text":"operator auditing a tenant needs to answer “which of these did we create?” from this","type":"text"},{"text":" ","type":"text"},{"text":"endpoint rather than from the database, and because three behaviours hang off it: a","type":"text"},{"text":" ","type":"text"},{"text":"non-","type":"text"},{"code":"admin","type":"codeVoice"},{"text":" client may never carry the FAPI profile, is always consent-gated, and is the","type":"text"},{"text":" ","type":"text"},{"text":"only kind the unused-client sweeper touches. Read-only. There is no corresponding member","type":"text"},{"text":" ","type":"text"},{"text":"on the update DTO: a registration’s provenance is a fact about how it came to exist, and","type":"text"},{"text":" ","type":"text"},{"text":"a field that could be edited to ","type":"text"},{"code":"admin","type":"codeVoice"},{"text":" would be a field that launders one.","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc