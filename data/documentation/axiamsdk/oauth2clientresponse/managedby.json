{"abstract":[{"type":"text","text":"T21.4 \/ D5 — who created this registration: "},{"type":"codeVoice","code":"admin"},{"type":"text","text":", "},{"type":"codeVoice","code":"dcr"},{"type":"text","text":" or "},{"type":"codeVoice","code":"cimd"},{"type":"text","text":". Echoed because an"},{"type":"text","text":" "},{"type":"text","text":"operator auditing a tenant needs to answer “which of these did we create?” from this"},{"type":"text","text":" "},{"type":"text","text":"endpoint rather than from the database, and because three behaviours hang off it: a"},{"type":"text","text":" "},{"type":"text","text":"non-"},{"type":"codeVoice","code":"admin"},{"type":"text","text":" client may never carry the FAPI profile, is always consent-gated, and is the"},{"type":"text","text":" "},{"type":"text","text":"only kind the unused-client sweeper touches. Read-only. There is no corresponding member"},{"type":"text","text":" "},{"type":"text","text":"on the update DTO: a registration’s provenance is a fact about how it came to exist, and"},{"type":"text","text":" "},{"type":"text","text":"a field that could be edited to "},{"type":"codeVoice","code":"admin"},{"type":"text","text":" would be a field that launders one."}],"sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/managedBy","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/oauth2clientresponse\/managedby"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"managedBy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK9ManagedByO","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","kind":"typeIdentifier","text":"ManagedBy"}]}]}],"hierarchy":{"paths":[["doc:\/\