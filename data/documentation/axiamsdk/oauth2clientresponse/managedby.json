" ","type":"text"},{"identifier":"Self::Admin","isActive":true,"type":"reference"},{"text":" (I5) — a client nobody vetted cannot be financial-grade; * the","type":"text"},{"text":" ","type":"text"},{"text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party","type":"text"},{"text":" ","type":"text"},{"text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper","type":"text"},{"text":" ","type":"text"},{"text":"deletes only ","type":"text"},{"identifier":"Self::Dcr","isActive":true,"type":"reference"},{"text":" rows, so an administrator’s client is never swept however","type":"text"},{"text":" ","type":"text"},{"text":"long it sits unused. ","type":"text"},{"identifier":"Self::Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"overridingTitle":"Admin","isActive":true,"type":"reference"},{"text":" is the serde default and therefore what every","type":"text"},{"text":" ","type":"text"},{"text":"row written before T21.4 decodes to, which is the truth: they were all created through ","type":"text"},{"code":"POST \/oauth2-clients","type":"codeVoice"},{"text":" by somebody holding ","type":"text"},{"code":"oauth2_clients:create","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/axiamsdk\/managedby"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/managedBy":{"kind":"symbol","title":"managedBy","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"managedBy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ManagedBy","preciseIdentifier":"s:8AxiamSDK9ManagedByO","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"T21.4 \/ D5 — who created this registration: "},{"type":"codeVoice","code":"admin"},{"type":"text","text":", "},{"type":"codeVoice","code":"dcr"},{"type":"text","text":" or "},{"type":"codeVoice","code":"cimd"},{"text":". Echoed because an","type":"text"},{"text":" ","type":"text"},{"text":"operator auditing a tenant needs to answer “which of these did we create?” from this","type":"text"},{"text":" ","type":"text"},{"text":"endpoint rather than from the database, and because three behaviours hang off it: a","type":"text"},{"text":" ","type":"text"},{"text":"non-","type":"text"},{"code":"admin","type":"codeVoice"},{"text":" client may never carry the FAPI profile, is always consent-gated, and is the","type":"text"},{"text":" ","type":"text"},{"text":"only kind the unused-client sweeper touches. Read-only. There is no corresponding member","type":"text"},{"text":" ","type":"text"},{"text":"on the update DTO: a registration’s provenance is a fact about how it came to exist, and","type":"text"},{"text":" ","type":"text"},{"text":"a field that could be edited to ","type":"text"},{"code":"admin","type":"codeVoice"},{"text":" would be a field that launders one.","type":"text"}],"url":"\/documentation\/axiamsdk\/oauth2clientresponse\/managedby","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/managedBy","role":"symbol"},"Self::Dcr":{"url":"Self::Dcr","title":"Dcr","identifier":"Self::Dcr","titleInlineContent":[{"code":"Dcr","type":"codeVoice"}],"type":"link"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"kind":"symbol","title":"OAuth2ClientResponse","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OAuth2ClientResponse"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","navigatorTitle":[{"kind":"identifier","text":"OAuth2ClientResponse"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"OAuth2 client response – omits client_secret_hash."}],"url":"\/documentation\/axiamsdk\/oauth2clientresponse"}}}