xt"},{"isActive":true,"identifier":"Self::Admin","type":"reference"},{"text":" (I5) — a client nobody vetted cannot be financial-grade; * the","type":"text"},{"text":" ","type":"text"},{"text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party","type":"text"},{"text":" ","type":"text"},{"text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper","type":"text"},{"text":" ","type":"text"},{"text":"deletes only ","type":"text"},{"isActive":true,"identifier":"Self::Dcr","type":"reference"},{"text":" rows, so an administrator’s client is never swept however","type":"text"},{"text":" ","type":"text"},{"text":"long it sits unused. ","type":"text"},{"isActive":true,"overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"identifier":"Self::Admin","type":"reference"},{"text":" is the serde default and therefore what every","type":"text"},{"text":" ","type":"text"},{"text":"row written before T21.4 decodes to, which is the truth: they were all created through ","type":"text"},{"code":"POST \/oauth2-clients","type":"codeVoice"},{"text":" by somebody holding ","type":"text"},{"code":"oauth2_clients:create","type":"codeVoice"},{"text":".","type":"text"}],"title":"ManagedBy","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ManagedBy"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagedBy"}],"role":"symbol"},"Self::Admin":{"title":"Admin","url":"Self::Admin","identifier":"Self::Admin","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Admin"}]},"Self::Dcr":{"type":"link","title":"Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"url":"Self::Dcr","identifier":"Self::Dcr"}}}