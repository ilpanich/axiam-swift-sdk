text":"a field that could be edited to "},{"type":"codeVoice","code":"admin"},{"type":"text","text":" would be a field that launders one."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"managedBy","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","text":"ManagedBy","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9ManagedByO"}],"platforms":["Linux"],"languages":["swift"]}]}],"references":{"Self::Admin":{"type":"link","title":"Admin","titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"identifier":"Self::Admin","url":"Self::Admin"},"Self::Dcr":{"type":"link","title":"Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"identifier":"Self::Dcr","url":"Self::Dcr"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/managedBy":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"managedBy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ManagedBy","preciseIdentifier":"s:8AxiamSDK9ManagedByO","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"T21.4 \/ D5 — who created this registration: "},{"type":"codeVoice","code":"admin"},{"type":"text","text":", "},{"type":"codeVoice","code":"dcr"},{"type":"text","text":" or "},{"type":"codeVoice","code":"cimd"},{"type":"text","text":". Echoed because an"},{"type":"text","text":" "},{"type":"text","text":"operator auditing a tenant needs to answer “which of these did we create?” from this"},{"type":"text","text":" "},{"type":"text","text":"endpoint rather than from the database, and because three behaviours hang off it: a"},{"type":"text","text":" "},{"type":"text","text":"non-"},{"type":"codeVoice","code":"admin"},{"type":"text","text":" client may never carry the FAPI profile, is always consent-gated, and is the"},{"type":"text","text":" "},{"type":"text","text":"only kind the unused-client sweeper touches. Read-only. There is no corresponding member"},{"type":"text","text":" "},{"type":"text","text":"on the update DTO: a registration’s provenance is a fact about how it came to exist, and"},{"type":"text","text":" "},{"type":"text","text":"a field that could be edited to "},{"type":"codeVoice","code":"admin"},{"type":"text","text":" would be a field that launders one."}],"type":"topic","title":"managedBy","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/managedBy","role":"symbol","url":"\/documentation\/axiamsdk\/oauth2clientresponse\/managedby"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"type":"topic","url":"\/documentation\/axiamsdk\/oauth2clientresponse","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","navigatorTitle":[{"text":"OAuth2ClientResponse","kind":"identifier"}],"kind":"symbol","title":"OAuth2ClientResponse","abstract":[{"text":"OAuth2 client response – omits client_secret_hash.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OAuth2ClientResponse","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagedBy"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ManagedBy"}],"url":"\/documentation\/axiamsdk\/managedby","title":"ManagedBy","abstract":[{"type":"text","text":"Who created a client registration (D5, T21.4). The discriminator that separates a"},{"type":"text","text":" "},{"type":"text","text":"registration an administrator made from one that arrived over an open endpoint. Three things"},{"type":"text","text":" "},{"type":"text","text":"read it and each would otherwise have to infer provenance from something that is not"},{"type":"text","text":" "},{"type":"text","text":"provenance: * "},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"type":"text","text":" refuses a FAPI profile on anything but"},{"type":"text","text":" "},{"identifier":"Self::Admin","type":"reference","isActive":true},{"type":"text","text":" (I5) — a client nobody vetted cannot be financial-grade; * the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"identifier":"Self::Dcr","type":"reference","isActive":true},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"identifier":"Self::Admin","overridingTitleInlineContent":[{"code":"Admin","type":"codeVoice"}],"overridingTitle":"Admin","type":"reference","isActive":true},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","type":"topic","kind":"symbol"}}}