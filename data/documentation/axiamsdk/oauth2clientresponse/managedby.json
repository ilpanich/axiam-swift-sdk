nd because three behaviours hang off it: a","type":"text"},{"text":" ","type":"text"},{"text":"non-","type":"text"},{"code":"admin","type":"codeVoice"},{"text":" client may never carry the FAPI profile, is always consent-gated, and is the","type":"text"},{"text":" ","type":"text"},{"text":"only kind the unused-client sweeper touches. Read-only. There is no corresponding member","type":"text"},{"text":" ","type":"text"},{"text":"on the update DTO: a registration’s provenance is a fact about how it came to exist, and","type":"text"},{"text":" ","type":"text"},{"text":"a field that could be edited to ","type":"text"},{"code":"admin","type":"codeVoice"},{"text":" would be a field that launders one.","type":"text"}],"title":"managedBy","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/managedBy","url":"\/documentation\/axiamsdk\/oauth2clientresponse\/managedby","kind":"symbol","role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"navigatorTitle":[{"kind":"identifier","text":"OAuth2ClientResponse"}],"title":"OAuth2ClientResponse","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OAuth2ClientResponse"}],"role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","abstract":[{"text":"OAuth2 client response – omits client_secret_hash.","type":"text"}],"url":"\/documentation\/axiamsdk\/oauth2clientresponse","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","url":"\/documentation\/axiamsdk\/managedby","type":"topic","navigatorTitle":[{"text":"ManagedBy","kind":"identifier"}],"title":"ManagedBy","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagedBy","kind":"identifier"}],"abstract":[{"text":"Who created a client registration (D5, T21.4). The discriminator that separates a","type":"text"},{"text":" ","type":"text"},{"text":"registration an administrator made from one that arrived over an open endpoint. Three things","type":"text"},{"text":" ","type":"text"},{"text":"read it and each would otherwise have to infer provenance from something that is not","type":"text"},{"type":"text","text":" "},{"text":"provenance: * ","type":"text"},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"type":"text","text":" refuses a FAPI profile on anything but"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"Self::Admin"},{"text":" (I5) — a client nobody vetted cannot be financial-grade; * the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"text":" ","type":"text"},{"text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"deletes only "},{"type":"reference","isActive":true,"identifier":"Self::Dcr"},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"isActive":true,"type":"reference","overridingTitle":"Admin","identifier":"Self::Admin","overridingTitleInlineContent":[{"code":"Admin","type":"codeVoice"}]},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol"}}}