kind":"externalParam","text":"updatedAt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}],"role":"symbol","title":"init(allowedResources:authnRequestParams:backchannelAuthenticationRequestSigningAlg:backchannelClientNotificationEndpoint:backchannelTokenDeliveryMode:browserSSO:clientID:createdAt:defaultIdp:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:id:jwks:jwksURI:lastAuthorizedAt:managedBy:name:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tenantID:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClientAuthSubjectDn:tlsClientCertificateBoundAccessTokens:tokenEndpointAuthMethod:updatedAt:)","symbolKind":"init"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/oauth2clientresponse\/init(allowedresources:authnrequestparams:backchannelauthenticationrequestsigningalg:backchannelclientnotificationendpoint:backchanneltokendeliverymode:browsersso:clientid:createdat:defaultidp:dpopboundaccesstokens:dpoprequirenonce:granttype-6h9fp"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/init(allowedResources:authnRequestParams:backchannelAuthenticationRequestSigningAlg:backchannelClientNotificationEndpoint:backchannelTokenDeliveryMode:browserSSO:clientID:createdAt:defaultIdp:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:id:jwks:jwksURI:lastAuthorizedAt:managedBy:name:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tenantID:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClientAuthSubjectDn:tlsClientCertificateBoundAccessTokens:tokenEndpointAuthMethod:updatedAt:)"},"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/CibaRequestSigningAlg":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CibaRequestSigningAlg","kind":"identifier"}],"abstract":[{"type":"text","text":"The JWS algorithm a CIBA client signs its authentication requests with (CIBA Core §4"},{"type":"text","text":" "},{"type":"codeVoice","code":"backchannel_authentication_request_signing_alg"},{"type":"text","text":", §7.1.1). Exactly the three algorithms"},{"type":"text","text":" "},{"type":"text","text":"AXIAM verifies on any client-signed JWT ("},{"type":"codeVoice","code":"axiam_oauth2::jose::PERMITTED_ALGORITHMS"},{"type":"text","text":"): FAPI"},{"type":"text","text":" "},{"type":"text","text":"2.0 §5.3.1.1’s list. A registration naming anything else — "},{"type":"codeVoice","code":"RS256"},{"type":"text","text":", "},{"type":"codeVoice","code":"HS256"},{"type":"text","text":", "},{"type":"codeVoice","code":"none"},{"type":"text","text":" — is"},{"type":"text","text":" "},{"type":"text","text":"refused rather than stored, so no row can hold an algorithm the verifier would not honour"},{"type":"text","text":" "},{"type":"text","text":"(D-61)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaRequestSigningAlg","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/cibarequestsigningalg","type":"topic","title":"CibaRequestSigningAlg","navigatorTitle":[{"text":"CibaRequestSigningAlg","kind":"identifier"}]},"Self::Admin":{"url":"Self::Admin","identifier":"Self::Admin","title":"Admin","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Admin"}]},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"url":"\/documentation\/axiamsdk\/clientprofile","title":"ClientProfile","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"type":"topic","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"S256","type":"codeVoice"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"nearly","type":"text"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"isActive":true,"identifier":"Self::Standard","type":"reference"},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthnRequestParamsMode"}],"abstract":[{"text":"Whether this client’s authorization requests may carry OpenID Connect’s","type":"text"},{"text":" ","type":"text"},{"text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this","type":"text"},{"text":" ","type":"text"},{"text":"governs is ","type":"text"},{"code":"prompt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"max_age","type":"codeVoice"},{"text":", ","type":"text"},{"code":"acr_values","type":"codeVoice"},{"text":", ","type":"text"},{"code":"claims","type":"codeVoice"},{"text":", ","type":"text"},{"code":"id_token_hint","type":"codeVoice"},{"text":", ","type":"text"},{"code":"login_hint","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"display","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ui_locales","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"claims_locales","type":"codeVoice"},{"text":". It is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"one"}]},{"text":" field rather than nine booleans","type":"text"},{"text":" ","type":"text"},{"text":"for the same reason [","type":"text"},{"code":"ClientProfile","type":"codeVoice"},{"text":"] is one field rather than a dozen: a client that","type":"text"},{"text":" ","type":"text"},{"text":"honours ","type":"text"},{"code":"max_age","type":"codeVoice"},{"text":" but ignores ","type":"text"},{"code":"prompt=none","type":"codeVoice"},{"text":" is not “mostly conformant”, it is a client a","type":"text"},{"text":" ","type":"text"},{"text":"relying party cannot reason about. ","type":"text"},{"isActive":true,"identifier":"Self::Ignore","type":"reference"},{"text":" is the serde default and is","type":"text"},{"text":" ","type":"text"},{"text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by","type":"text"},{"text":" ","type":"text"},{"text":"the query deserialiser and never reach a decision. Every row written before schema v54","type":"text"},{"text":" ","type":"text"},{"text":"therefore decodes to the behaviour it already had.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","type":"topic","title":"AuthnRequestParamsMode","navigatorTitle":[{"kind":"identifier","text":"AuthnRequestParamsMode"}]},"Self::Standard":{"titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"url":"Self::Standard","type":"link","title":"Standard","identifier":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK/CibaDeliveryMode":{"navigatorTitle":[{"text":"CibaDeliveryMode","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaDeliveryMode","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CibaDeliveryMode","kind":"identifier"}],"title":"CibaDeliveryMode","abstract":[{"type":"text","text":"How a CIBA client learns that a request has been decided (CIBA Core §5). "},{"type":"codeVoice","code":"push"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"deliberately absent: AXIAM does not offer it, and the FAPI-CIBA profile forbids it — push"},{"type":"text","text":" "},{"type":"text","text":"delivers the tokens themselves to a client endpoint, which makes the notification endpoint a"},{"type":"text","text":" "},{"type":"text","text":"token sink."}],"role":"symbol","url":"\/documentation\/axiamsdk\/cibadeliverymode"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/clientauthmethod","title":"ClientAuthMethod","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming)."},{"type":"text","text":" "},{"type":"text","text":"Only the methods AXIAM actually implements are representable. "},{"code":"None","type":"codeVoice"},{"type":"text","text":" — the public-client"},{"type":"text","text":" "},{"type":"text","text":"value — was deliberately absent until T21.2: adding it before the rest of the server"},{"type":"text","text":" "},{"type":"text","text":"understood one would have let an operator register a client whose authentication is silently"},{"type":"text","text":" "},{"type":"text","text":"skipped. The server understands one now ("},{"code":"token.rs","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"authenticate_client_credential","type":"codeVoice"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"an arm that accepts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"no"}]},{"type":"text","text":" credential and refuses a presented one, the authorization endpoint"},{"type":"text","text":" "},{"type":"text","text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside"},{"type":"text","text":" "},{"type":"text","text":"any grant or binding that contradicts it), so the variant exists — and only that arm may"},{"type":"text","text":" "},{"type":"text","text":"ever treat a missing credential as success."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagedBy","kind":"identifier"}],"role":"symbol","title":"ManagedBy","abstract":[{"type":"text","text":"Who created a client registration (D5, T21.4). The discriminator that separates a"},{"type":"text","text":" "},{"type":"text","text":"registration an administrator made from one that arrived over an open endpoint. Three things"},{"type":"text","text":" "},{"type":"text","text":"read it and each would otherwise have to infer provenance from something that is not"},{"type":"text","text":" "},{"type":"text","text":"provenance: * "},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"type":"text","text":" refuses a FAPI profile on anything but"},{"type":"text","text":" "},{"type":"reference","identifier":"Self::Admin","isActive":true},{"type":"text","text":" (I5) — a client nobody vetted cannot be financial-grade; * the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"type":"reference","identifier":"Self::Dcr","isActive":true},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"type":"reference","identifier":"Self::Admin","overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"isActive":true},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"url":"\/documentation\/axiamsdk\/managedby","navigatorTitle":[{"text":"ManagedBy","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","kind":"symbol"},"Self::Dcr":{"title":"Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"url":"Self::Dcr","identifier":"Self::Dcr","type":"link"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/init(allowedResources:authnRequestParams:backchannelAuthenticationRequestSigningAlg:backchannelClientNotificationEndpoint:backchannelTokenDeliveryMode:browserSSO:clientID:createdAt:defaultIdp:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:id:jwks:jwksURI:lastAuthorizedAt:managedBy:name:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tenantID:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClientAuthSubjectDn:tlsClientCertificateBoundAccessTokens:tokenEndpointAuthMethod:updatedAt:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"