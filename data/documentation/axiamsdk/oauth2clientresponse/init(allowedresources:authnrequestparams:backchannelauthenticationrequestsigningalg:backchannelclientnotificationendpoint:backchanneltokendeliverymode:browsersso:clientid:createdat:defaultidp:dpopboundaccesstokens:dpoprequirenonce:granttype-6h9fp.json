amSDK/documentation/AxiamSDK/ClientAuthMethod":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","kind":"symbol","abstract":[{"type":"text","text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming)."},{"type":"text","text":" "},{"type":"text","text":"Only the methods AXIAM actually implements are representable. "},{"code":"None","type":"codeVoice"},{"type":"text","text":" — the public-client"},{"type":"text","text":" "},{"type":"text","text":"value — was deliberately absent until T21.2: adding it before the rest of the server"},{"type":"text","text":" "},{"type":"text","text":"understood one would have let an operator register a client whose authentication is silently"},{"type":"text","text":" "},{"type":"text","text":"skipped. The server understands one now ("},{"code":"token.rs","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"authenticate_client_credential","type":"codeVoice"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"an arm that accepts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"no"}]},{"type":"text","text":" credential and refuses a presented one, the authorization endpoint"},{"type":"text","text":" "},{"type":"text","text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside"},{"type":"text","text":" "},{"type":"text","text":"any grant or binding that contradicts it), so the variant exists — and only that arm may"},{"type":"text","text":" "},{"type":"text","text":"ever treat a missing credential as success."}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/clientauthmethod","role":"symbol","title":"ClientAuthMethod"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"navigatorTitle":[{"kind":"identifier","text":"ManagedBy"}],"type":"topic","url":"\/documentation\/axiamsdk\/managedby","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagedBy"}],"title":"ManagedBy","abstract":[{"type":"text","text":"Who created a client registration (D5, T21.4). The discriminator that separates a"},{"type":"text","text":" "},{"type":"text","text":"registration an administrator made from one that arrived over an open endpoint. Three things"},{"type":"text","text":" "},{"type":"text","text":"read it and each would otherwise have to infer provenance from something that is not"},{"type":"text","text":" "},{"type":"text","text":"provenance: * "},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"type":"text","text":" refuses a FAPI profile on anything but"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"Self::Admin"},{"type":"text","text":" (I5) — a client nobody vetted cannot be financial-grade; * the"},{"type":"text","text":" "},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"isActive":true,"type":"reference","identifier":"Self::Dcr"},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"type":"text","text":" "},{"type":"text","text":"long it sits unused. "},{"isActive":true,"overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"type":"reference","identifier":"Self::Admin"},{"type":"text","text":" is the serde default and therefore what every"},{"type":"text","text":" "},{"type":"text","text":"row written before T21.4 decodes to, which is the truth: they were all created through "},{"type":"codeVoice","code":"POST \/oauth2-clients"},{"type":"text","text":" by somebody holding "},{"type":"codeVoice","code":"oauth2_clients:create"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"url":"\/documentation\/axiamsdk\/clientprofile","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"type":"topic","title":"ClientProfile","role":"symbol","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"S256","type":"codeVoice"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"nearly"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","isActive":true,"type":"reference"},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}]}}}