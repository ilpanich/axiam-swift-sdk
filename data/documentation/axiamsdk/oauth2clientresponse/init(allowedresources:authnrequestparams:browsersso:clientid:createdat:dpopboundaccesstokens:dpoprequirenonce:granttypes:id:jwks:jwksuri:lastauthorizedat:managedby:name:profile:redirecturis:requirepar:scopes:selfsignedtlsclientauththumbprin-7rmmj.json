","kind":"text"},{"text":"tlsClientAuthSanDNS","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"tlsClientAuthSanURI","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"tlsClientAuthSubjectDn","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"tlsClientCertificateBoundAccessTokens","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tokenEndpointAuthMethod","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK16ClientAuthMethodO","text":"ClientAuthMethod","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"updatedAt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"Self::Ignore":{"identifier":"Self::Ignore","url":"Self::Ignore","titleInlineContent":[{"type":"codeVoice","code":"Ignore"}],"title":"Ignore","type":"link"},"Self::Standard":{"identifier":"Self::Standard","url":"Self::Standard","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"title":"Standard","type":"link"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"abstract":[{"text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming).","type":"text"},{"text":" ","type":"text"},{"text":"Only the methods AXIAM actually implements are representable. ","type":"text"},{"code":"None","type":"codeVoice"},{"text":" — the public-client","type":"text"},{"text":" ","type":"text"},{"text":"value — was deliberately absent until T21.2: adding it before the rest of the server","type":"text"},{"text":" ","type":"text"},{"text":"understood one would have let an operator register a client whose authentication is silently","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The server understands one now (","type":"text"},{"code":"token.rs","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"authenticate_client_credential","type":"codeVoice"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"an arm that accepts ","type":"text"},{"inlineContent":[{"text":"no","type":"text"}],"type":"emphasis"},{"text":" credential and refuses a presented one, the authorization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"type":"topic","title":"ClientAuthMethod","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/clientauthmethod","navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"role":"symbol","url":"\/documentation\/axiamsdk\/managedby","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagedBy","kind":"identifier"}],"title":"ManagedBy","navigatorTitle":[{"text":"ManagedBy","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","abstract":[{"text":"Who created a client registration (D5, T21.4). The discriminator that separates a","type":"text"},{"text":" ","type":"text"},{"text":"registration an administrator made from one that arrived over an open endpoint. Three things","type":"text"},{"text":" ","type":"text"},{"text":"read it and each would otherwise have to infer provenance from something that is not","type":"text"},{"text":" ","type":"text"},{"text":"provenance: * ","type":"text"},{"type":"codeVoice","code":"axiam_oauth2::fapi"},{"text":" refuses a FAPI profile on anything but","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"Self::Admin"},{"text":" (I5) — a client nobody vetted cannot be financial-grade; * the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper","type":"text"},{"text":" ","type":"text"},{"text":"deletes only ","type":"text"},{"identifier":"Self::Dcr","type":"reference","isActive":true},{"text":" rows, so an administrator’s client is never swept however","type":"text"},{"text":" ","type":"text"},{"text":"long it sits unused. ","type":"text"},{"overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"identifier":"Self::Admin","type":"reference","isActive":true},{"text":" is the serde default and therefore what every","type":"text"},{"text":" ","type":"text"},{"text":"row written before T21.4 decodes to, which is the truth: they were all created through ","type":"text"},{"code":"POST \/oauth2-clients","type":"codeVoice"},{"text":" by somebody holding ","type":"text"},{"code":"oauth2_clients:create","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"Self::Admin":{"identifier":"Self::Admin","url":"Self::Admin","titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"title":"Admin","type":"link"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"abstract":[{"type":"text","text":"OAuth2 client response – omits client_secret_hash."}],"type":"topic","title":"OAuth2ClientResponse","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/oauth2clientresponse","navigatorTitle":[{"text":"OAuth2ClientResponse","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OAuth2ClientResponse","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"text":" ","type":"text"},{"inlineContent":[{"text":"nearly","type":"text"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"type":"topic","title":"ClientProfile","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/clientprofile","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"}}}