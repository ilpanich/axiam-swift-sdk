t"},{"text":"profile","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK13ClientProfileO","text":"ClientProfile","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"X5.1 — the registered posture and mTLS credentials. Read-back matters: an operator"},{"type":"text","text":" "},{"type":"text","text":"auditing which clients are financial-grade should be able to answer it from this"},{"type":"text","text":" "},{"type":"text","text":"endpoint rather than from the database."}],"kind":"symbol","url":"\/documentation\/axiamsdk\/oauth2clientresponse\/profile","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/profile","type":"topic","role":"symbol","title":"profile"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","url":"\/documentation\/axiamsdk\/clientprofile","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}],"abstract":[{"type":"text","text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”."},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"type":"text","text":" "},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"type":"text","text":", mandatory strong client authentication, mandatory sender-constrained tokens,"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"type":"text","text":" "},{"text":"change at all, because ","type":"text"},{"isActive":true,"type":"reference","identifier":"Self::Standard"},{"text":" is the serde default and every row","type":"text"},{"type":"text","text":" "},{"text":"written before schema v38 decodes to it.","type":"text"}],"type":"topic","title":"ClientProfile","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}]},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","role":"symbol","type":"topic","title":"OAuth2ClientResponse","url":"\/documentation\/axiamsdk\/oauth2clientresponse","navigatorTitle":[{"text":"OAuth2ClientResponse","kind":"identifier"}],"abstract":[{"text":"OAuth2 client response – omits client_secret_hash.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"OAuth2ClientResponse","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","title":"AxiamSDK","kind":"symbol","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}