{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse"]]},"abstract":[{"type":"text","text":"X5.1 — the registered posture and mTLS credentials. Read-back matters: an operator"},{"type":"text","text":" "},{"type":"text","text":"auditing which clients are financial-grade should be able to answer it from this"},{"type":"text","text":" "},{"type":"text","text":"endpoint rather than from the database."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/oauth2clientresponse\/profile"]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"profile","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ClientProfile","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13ClientProfileO","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"}]}]}],"metadata":{"title":"profile","symbolKind":"property","externalID":"s:8AxiamSDK20OAuth2ClientResponseV7profileAA0D7ProfileOvp","roleHeading":"Instance Property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"profile","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ClientProfile","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13ClientProfileO"}],"modules":[{"name":"AxiamSDK"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/profile"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"Self::Standard":{"type":"link","title":"Standard","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"url":"Self::Standard","identifier":"Self::Standard"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/profile":{"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"profile","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK13ClientProfileO","text":"ClientProfile","kind":"typeIdentifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/profile","abstract":[{"type":"text","text":"X5.1 — the registered posture and mTLS credentials. Read-back matters: an operator"},{"type":"text","text":" "},{"type":"text","text":"auditing which clients are financial-grade should be able to answer it from this"},{"type":"text","text":" "},{"type":"text","text":"endpoint rather than from the database."}],"url":"\/documentation\/axiamsdk\/oauth2clientresponse\/profile","title":"profile","kind":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"navigatorTitle":[{"kind":"identifier","text":"OAuth2ClientResponse"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","type":"topic","title":"OAuth2ClientResponse","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OAuth2ClientResponse"}],"abstract":[{"type":"text","text":"OAuth2 client response – omits client_secret_hash."}],"kind":"symbol","url":"\/documentation\/axiamsdk\/oauth2clientresponse","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"title":"ClientProfile","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"nearly"}],"type":"emphasis"},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"url":"\/documentation\/axiamsdk\/clientprofile","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}]}}}