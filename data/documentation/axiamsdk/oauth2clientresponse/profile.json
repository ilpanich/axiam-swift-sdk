{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"X5.1 — the registered posture and mTLS credentials. Read-back matters: an operator"},{"type":"text","text":" "},{"type":"text","text":"auditing which clients are financial-grade should be able to answer it from this"},{"type":"text","text":" "},{"type":"text","text":"endpoint rather than from the database."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/profile"},"metadata":{"roleHeading":"Instance Property","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"profile"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK13ClientProfileO","kind":"typeIdentifier","text":"ClientProfile"}],"symbolKind":"property","externalID":"s:8AxiamSDK20OAuth2ClientResponseV7profileAA0D7ProfileOvp","modules":[{"name":"AxiamSDK"}],"title":"profile"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"profile","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ClientProfile","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK13ClientProfileO"}],"languages":["swift"]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/oauth2clientresponse\/profile"]}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OAuth2ClientResponse","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","title":"OAuth2ClientResponse","navigatorTitle":[{"text":"OAuth2ClientResponse","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/oauth2clientresponse","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"OAuth2 client response – omits client_secret_hash.","type":"text"}]},"Self::Standard":{"identifier":"Self::Standard","title":"Standard","url":"Self::Standard","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Standard"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/profile":{"abstract":[{"type":"text","text":"X5.1 — the registered posture and mTLS credentials. Read-back matters: an operator"},{"type":"text","text":" "},{"type":"text","text":"auditing which clients are financial-grade should be able to answer it from this"},{"type":"text","text":" "},{"type":"text","text":"endpoint rather than from the database."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/profile","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"profile","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK13ClientProfileO","text":"ClientProfile","kind":"typeIdentifier"}],"kind":"symbol","title":"profile","url":"\/documentation\/axiamsdk\/oauth2clientresponse\/profile","role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"url":"\/documentation\/axiamsdk\/clientprofile","kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"type":"text","text":", mandatory strong client authentication, mandatory sender-constrained tokens,"},{"type":"text","text":" "},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"text":"written before schema v38 decodes to it.","type":"text"}],"title":"ClientProfile","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}]}}}