":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nearly"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"title":"ClientProfile","type":"topic","url":"\/documentation\/axiamsdk\/clientprofile"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"type":"topic","title":"OAuth2ClientResponse","role":"symbol","abstract":[{"type":"text","text":"OAuth2 client response – omits client_secret_hash."}],"kind":"symbol","url":"\/documentation\/axiamsdk\/oauth2clientresponse","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OAuth2ClientResponse"}],"navigatorTitle":[{"kind":"identifier","text":"OAuth2ClientResponse"}]},"Self::Standard":{"titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"identifier":"Self::Standard","type":"link","url":"Self::Standard","title":"Standard"}}}