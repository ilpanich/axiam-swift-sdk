{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"profile","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ClientProfile","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","preciseIdentifier":"s:8AxiamSDK13ClientProfileO","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse"]]},"abstract":[{"type":"text","text":"X5.1 — the registered posture and mTLS credentials. Read-back matters: an operator"},{"type":"text","text":" "},{"type":"text","text":"auditing which clients are financial-grade should be able to answer it from this"},{"type":"text","text":" "},{"text":"endpoint rather than from the database.","type":"text"}],"kind":"symbol","metadata":{"title":"profile","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"profile"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ClientProfile","preciseIdentifier":"s:8AxiamSDK13ClientProfileO"}],"roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"symbolKind":"property","externalID":"s:8AxiamSDK20OAuth2ClientResponseV7profileAA0D7ProfileOvp"},"variants":[{"paths":["\/documentation\/axiamsdk\/oauth2clientresponse\/profile"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/profile"},"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/profile":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"profile","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ClientProfile","preciseIdentifier":"s:8AxiamSDK13ClientProfileO","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","abstract":[{"text":"X5.1 — the registered posture and mTLS credentials. Read-back matters: an operator","type":"text"},{"text":" ","type":"text"},{"text":"auditing which clients are financial-grade should be able to answer it from this","type":"text"},{"text":" ","type":"text"},{"text":"endpoint rather than from the database.","type":"text"}],"url":"\/documentation\/axiamsdk\/oauth2clientresponse\/profile","title":"profile","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/profile","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"kind":"symbol","url":"\/documentation\/axiamsdk\/clientprofile","type":"topic","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"title":"ClientProfile","abstract":[{"type":"text","text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”."},{"type":"text","text":" "},{"type":"text","text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"S256"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"nearly"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"isActive":true,"type":"reference","identifier":"Self::Standard"},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"kind":"symbol","title":"OAuth2ClientResponse","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OAuth2ClientResponse"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","navigatorTitle":[{"kind":"identifier","text":"OAuth2ClientResponse"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"OAuth2 client response – omits client_secret_hash."}],"url":"\/documentation\/axiamsdk\/oauth2clientresponse"},"Self::Standard":{"url":"Self::Standard","title":"Standard","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"identifier":"Self::Standard","type":"link"},"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"}}}