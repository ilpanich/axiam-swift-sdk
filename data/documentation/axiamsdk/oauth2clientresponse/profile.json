DK13ClientProfileO"}],"role":"symbol","abstract":[{"text":"X5.1 — the registered posture and mTLS credentials. Read-back matters: an operator","type":"text"},{"text":" ","type":"text"},{"text":"auditing which clients are financial-grade should be able to answer it from this","type":"text"},{"text":" ","type":"text"},{"text":"endpoint rather than from the database.","type":"text"}],"url":"\/documentation\/axiamsdk\/oauth2clientresponse\/profile","kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/profile"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"text":" ","type":"text"},{"inlineContent":[{"text":"nearly","type":"text"}],"type":"emphasis"},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"type":"topic","title":"ClientProfile","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/clientprofile","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"abstract":[{"type":"text","text":"OAuth2 client response – omits client_secret_hash."}],"type":"topic","title":"OAuth2ClientResponse","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/oauth2clientresponse","navigatorTitle":[{"text":"OAuth2ClientResponse","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OAuth2ClientResponse","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","title":"AxiamSDK","role":"collection","kind":"symbol","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"Self::Standard":{"titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"url":"Self::Standard","title":"Standard","identifier":"Self::Standard","type":"link"}}}