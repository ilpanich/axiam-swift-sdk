xt","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tlsClientAuthSanDNS"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"tlsClientAuthSanURI"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"tlsClientAuthSubjectDn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"tlsClientCertificateBoundAccessTokens"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tokenEndpointAuthMethod"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK16ClientAuthMethodO","text":"ClientAuthMethod"},{"kind":"text","text":", "},{"kind":"externalParam","text":"updatedAt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientAuthMethod"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/clientauthmethod","navigatorTitle":[{"kind":"identifier","text":"ClientAuthMethod"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","abstract":[{"text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming).","type":"text"},{"text":" ","type":"text"},{"text":"Only the methods AXIAM actually implements are representable. There is deliberately no","type":"text"},{"text":" ","type":"text"},{"code":"none","type":"codeVoice"},{"text":" variant: every AXIAM client is confidential today (see ","type":"text"},{"code":"handle_authorization_code","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and adding a public-client value here before the rest of the server understands one would"},{"type":"text","text":" "},{"type":"text","text":"let an operator register a client whose authentication is silently skipped."}],"title":"ClientAuthMethod","role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"title":"ClientProfile","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"nearly"}],"type":"emphasis"},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"url":"\/documentation\/axiamsdk\/clientprofile","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}]},"Self::Standard":{"title":"Standard","identifier":"Self::Standard","url":"Self::Standard","type":"link","titleInlineContent":[{"code":"Standard","type":"codeVoice"}]}}}