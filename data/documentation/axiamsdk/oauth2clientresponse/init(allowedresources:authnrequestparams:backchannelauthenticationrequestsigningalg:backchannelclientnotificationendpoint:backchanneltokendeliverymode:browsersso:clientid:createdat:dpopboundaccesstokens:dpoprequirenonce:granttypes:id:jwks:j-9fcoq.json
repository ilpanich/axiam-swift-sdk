:"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"tlsClientCertificateBoundAccessTokens","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tokenEndpointAuthMethod","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClientAuthMethod","preciseIdentifier":"s:8AxiamSDK16ClientAuthMethodO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"updatedAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"externalID":"s:_AA05AuthnijS0OAA04CibaimN0OSgSSSgAA04CibarS0OSgSbS2SS2bA5_SSA11_A11_A11_AA9ManagedByOSSAA0D7ProfileOA5_SbA5_A5_SSA11_A11_A11_SbAA0D10AuthMethodOSStcfc","title":"init(allowedResources:authnRequestParams:backchannelAuthenticationRequestSigningAlg:backchannelClientNotificationEndpoint:backchannelTokenDeliveryMode:browserSSO:clientID:createdAt:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:id:jwks:jwksURI:lastAuthorizedAt:managedBy:name:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tenantID:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClientAuthSubjectDn:tlsClientCertificateBoundAccessTokens:tokenEndpointAuthMethod:updatedAt:)","symbolKind":"init","roleHeading":"Initializer","modules":[{"name":"AxiamSDK"}]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/CibaRequestSigningAlg":{"title":"CibaRequestSigningAlg","abstract":[{"text":"The JWS algorithm a CIBA client signs its authentication requests with (CIBA Core §4","type":"text"},{"text":" ","type":"text"},{"code":"backchannel_authentication_request_signing_alg","type":"codeVoice"},{"text":", §7.1.1). Exactly the three algorithms","type":"text"},{"text":" ","type":"text"},{"text":"AXIAM verifies on any client-signed JWT (","type":"text"},{"code":"axiam_oauth2::jose::PERMITTED_ALGORITHMS","type":"codeVoice"},{"text":"): FAPI","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"2.0 §5.3.1.1’s list. A registration naming anything else — "},{"type":"codeVoice","code":"RS256"},{"type":"text","text":", "},{"type":"codeVoice","code":"HS256"},{"type":"text","text":", "},{"type":"codeVoice","code":"none"},{"type":"text","text":" — is"},{"type":"text","text":" "},{"type":"text","text":"refused rather than stored, so no row can hold an algorithm the verifier would not honour"},{"type":"text","text":" "},{"type":"text","text":"(D-61)."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CibaRequestSigningAlg","kind":"identifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/cibarequestsigningalg","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"CibaRequestSigningAlg","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaRequestSigningAlg"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"url":"\/documentation\/axiamsdk\/clientprofile","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","role":"symbol","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"kind":"symbol","type":"topic","title":"ClientProfile"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","navigatorTitle":[{"kind":"identifier","text":"ClientAuthMethod"}],"type":"topic","url":"\/documentation\/axiamsdk\/clientauthmethod","title":"ClientAuthMethod","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientAuthMethod"}],"role":"symbol","abstract":[{"type":"text","text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming)."},{"type":"text","text":" "},{"type":"text","text":"Only the methods AXIAM actually implements are representable. "},{"code":"None","type":"codeVoice"},{"type":"text","text":" — the public-client"},{"type":"text","text":" "},{"type":"text","text":"value — was deliberately absent until T21.2: adding it before the rest of the server"},{"type":"text","text":" "},{"type":"text","text":"understood one would have let an operator register a client whose authentication is silently"},{"type":"text","text":" "},{"type":"text","text":"skipped. The server understands one now ("},{"code":"token.rs","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"authenticate_client_credential","type":"codeVoice"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"an arm that accepts "},{"inlineContent":[{"type":"text","text":"no"}],"type":"emphasis"},{"type":"text","text":" credential and refuses a presented one, the authorization endpoint"},{"type":"text","text":" "},{"type":"text","text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside"},{"type":"text","text":" "},{"type":"text","text":"any grant or binding that contradicts it), so the variant exists — and only that arm may"},{"type":"text","text":" "},{"type":"text","text":"ever treat a missing credential as success."}]},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode":{"kind":"symbol","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","navigatorTitle":[{"text":"AuthnRequestParamsMode","kind":"identifier"}],"role":"symbol","title":"AuthnRequestParamsMode","type":"topic","abstract":[{"text":"Whether this client’s authorization requests may carry OpenID Connect’s","type":"text"},{"text":" ","type":"text"},{"text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this","type":"text"},{"text":" ","type":"text"},{"text":"governs is ","type":"text"},{"type":"codeVoice","code":"prompt"},{"text":", ","type":"text"},{"type":"codeVoice","code":"max_age"},{"text":", ","type":"text"},{"type":"codeVoice","code":"acr_values"},{"text":", ","type":"text"},{"type":"codeVoice","code":"claims"},{"text":", ","type":"text"},{"type":"codeVoice","code":"id_token_hint"},{"text":", ","type":"text"},{"type":"codeVoice","code":"login_hint"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"display"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ui_locales"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"claims_locales"},{"text":". It is ","type":"text"},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"text":" field rather than nine booleans","type":"text"},{"text":" ","type":"text"},{"text":"for the same reason [","type":"text"},{"type":"codeVoice","code":"ClientProfile"},{"text":"] is one field rather than a dozen: a client that","type":"text"},{"text":" ","type":"text"},{"text":"honours ","type":"text"},{"type":"codeVoice","code":"max_age"},{"text":" but ignores ","type":"text"},{"type":"codeVoice","code":"prompt=none"},{"text":" is not “mostly conformant”, it is a client a","type":"text"},{"text":" ","type":"text"},{"text":"relying party cannot reason about. ","type":"text"},{"isActive":true,"type":"reference","identifier":"Self::Ignore"},{"text":" is the serde default and is","type":"text"},{"text":" ","type":"text"},{"text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by","type":"text"},{"text":" ","type":"text"},{"text":"the query deserialiser and never reach a decision. Every row written before schema v54","type":"text"},{"text":" ","type":"text"},{"text":"therefore decodes to the behaviour it already had.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AuthnRequestParamsMode","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode"},"Self::Standard":{"type":"link","url":"Self::Standard","identifier":"Self::Standard","titleInlineContent":[{"type":"codeVoice","code":"Standard"}],"title":"Standard"},"doc://AxiamSDK/documentation/AxiamSDK/CibaDeliveryMode":{"role":"symbol","kind":"symbol","title":"CibaDeliveryMode","url":"\/documentation\/axiamsdk\/cibadeliverymode","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CibaDeliveryMode","kind":"identifier"}],"abstract":[{"type":"text","text":"How a CIBA client learns that a request has been decided (CIBA Core §5). "},{"type":"codeVoice","code":"push"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"deliberately absent: AXIAM does not offer it, and the FAPI-CIBA profile forbids it — push"},{"type":"text","text":" "},{"type":"text","text":"delivers the tokens themselves to a client endpoint, which makes the notification endpoint a"},{"type":"text","text":" "},{"type":"text","text":"token sink."}],"navigatorTitle":[{"text":"CibaDeliveryMode","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaDeliveryMode","type":"topic"},"Self::Ignore":{"type":"link","url":"Self::Ignore","identifier":"Self::Ignore","titleInlineContent":[{"type":"codeVoice","code":"Ignore"}],"title":"Ignore"},"Self::Admin":{"type":"link","url":"Self::Admin","identifier":"Self::Admin","titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"title":"Admin"},"Self::Dcr":{"type":"link","url":"Self::Dcr","identifier":"Self::Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}],"title":"Dcr"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/init(allowedResources:authnRequestParams:backchannelAuthenticationRequestSigningAlg:backchannelClientNotificationEndpoint:backchannelTokenDeliveryMode:browserSSO:clientID:createdAt:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:id:jwks:jwksURI:lastAuthorizedAt:managedBy:name:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tenantID:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClientAuthSubjectDn:tlsClientCertificateBoundAccessTokens:tokenEndpointAuthMethod:updatedAt:)":{"abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/init(allowedResources:authnRequestParams:backchannelAuthenticationRequestSigningAlg:backchannelClientNotificationEndpoint:backchannelTokenDeliveryMode:browserSSO:clientID:createdAt:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:id:jwks:jwksURI:lastAuthorizedAt:managedBy:name:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tenantID:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClientAuthSubjectDn:tlsClientCertificateBoundAccessTokens:tokenEndpointAuthMethod:updatedAt:)","