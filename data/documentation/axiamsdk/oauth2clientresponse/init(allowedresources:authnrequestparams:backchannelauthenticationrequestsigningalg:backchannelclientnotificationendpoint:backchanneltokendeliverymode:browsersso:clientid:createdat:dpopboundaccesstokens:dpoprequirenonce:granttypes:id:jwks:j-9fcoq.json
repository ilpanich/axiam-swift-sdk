String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tlsClientAuthSanDNS","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"tlsClientAuthSanURI","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"tlsClientAuthSubjectDn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"tlsClientCertificateBoundAccessTokens","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tokenEndpointAuthMethod","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClientAuthMethod","preciseIdentifier":"s:8AxiamSDK16ClientAuthMethodO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"updatedAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"externalID":"s:_AA05AuthnijS0OAA04CibaimN0OSgSSSgAA04CibarS0OSgSbS2SS2bA5_SSA11_A11_A11_AA9ManagedByOSSAA0D7ProfileOA5_SbA5_A5_SSA11_A11_A11_SbAA0D10AuthMethodOSStcfc","symbolKind":"init"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","url":"\/documentation\/axiamsdk\/clientprofile","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"text":", mandatory strong client authentication, mandatory sender-constrained tokens,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nearly"}]},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"type":"reference","identifier":"Self::Standard","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"kind":"symbol","type":"topic","title":"ClientProfile"},"Self::Admin":{"titleInlineContent":[{"code":"Admin","type":"codeVoice"}],"url":"Self::Admin","type":"link","identifier":"Self::Admin","title":"Admin"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"abstract":[{"text":"Who created a client registration (D5, T21.4). The discriminator that separates a","type":"text"},{"text":" ","type":"text"},{"text":"registration an administrator made from one that arrived over an open endpoint. Three things","type":"text"},{"text":" ","type":"text"},{"text":"read it and each would otherwise have to infer provenance from something that is not","type":"text"},{"text":" ","type":"text"},{"text":"provenance: * ","type":"text"},{"code":"axiam_oauth2::fapi","type":"codeVoice"},{"text":" refuses a FAPI profile on anything but","type":"text"},{"text":" ","type":"text"},{"identifier":"Self::Admin","isActive":true,"type":"reference"},{"text":" (I5) — a client nobody vetted cannot be financial-grade; * the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party"},{"type":"text","text":" "},{"type":"text","text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper"},{"type":"text","text":" "},{"type":"text","text":"deletes only "},{"isActive":true,"identifier":"Self::Dcr","type":"reference"},{"type":"text","text":" rows, so an administrator’s client is never swept however"},{"text":" ","type":"text"},{"text":"long it sits unused. ","type":"text"},{"identifier":"Self::Admin","isActive":true,"overridingTitle":"Admin","overridingTitleInlineContent":[{"code":"Admin","type":"codeVoice"}],"type":"reference"},{"text":" is the serde default and therefore what every","type":"text"},{"text":" ","type":"text"},{"text":"row written before T21.4 decodes to, which is the truth: they were all created through ","type":"text"},{"code":"POST \/oauth2-clients","type":"codeVoice"},{"text":" by somebody holding ","type":"text"},{"code":"oauth2_clients:create","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagedBy","kind":"identifier"}],"title":"ManagedBy","navigatorTitle":[{"text":"ManagedBy","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/managedby","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy"},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode":{"abstract":[{"type":"text","text":"Whether this client’s authorization requests may carry OpenID Connect’s"},{"type":"text","text":" "},{"type":"text","text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this"},{"type":"text","text":" "},{"type":"text","text":"governs is "},{"code":"prompt","type":"codeVoice"},{"type":"text","text":", "},{"code":"max_age","type":"codeVoice"},{"type":"text","text":", "},{"code":"acr_values","type":"codeVoice"},{"type":"text","text":", "},{"code":"claims","type":"codeVoice"},{"type":"text","text":", "},{"code":"id_token_hint","type":"codeVoice"},{"text":", ","type":"text"},{"code":"login_hint","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"display","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ui_locales","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"claims_locales","type":"codeVoice"},{"text":". It is ","type":"text"},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"text":" field rather than nine booleans","type":"text"},{"text":" ","type":"text"},{"text":"for the same reason [","type":"text"},{"code":"ClientProfile","type":"codeVoice"},{"text":"] is one field rather than a dozen: a client that","type":"text"},{"text":" ","type":"text"},{"text":"honours ","type":"text"},{"code":"max_age","type":"codeVoice"},{"text":" but ignores ","type":"text"},{"code":"prompt=none","type":"codeVoice"},{"text":" is not “mostly conformant”, it is a client a","type":"text"},{"text":" ","type":"text"},{"text":"relying party cannot reason about. ","type":"text"},{"identifier":"Self::Ignore","type":"reference","isActive":true},{"text":" is the serde default and is","type":"text"},{"text":" ","type":"text"},{"text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by","type":"text"},{"text":" ","type":"text"},{"text":"the query deserialiser and never reach a decision. Every row written before schema v54","type":"text"},{"text":" ","type":"text"},{"text":"therefore decodes to the behaviour it already had.","type":"text"}],"url":"\/documentation\/axiamsdk\/authnrequestparamsmode","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","title":"AuthnRequestParamsMode","role":"symbol","navigatorTitle":[{"text":"AuthnRequestParamsMode","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AuthnRequestParamsMode","kind":"identifier"}]},"Self::Standard":{"titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"url":"Self::Standard","type":"link","identifier":"Self::Standard","title":"Standard"},"Self::Dcr":{"titleInlineContent":[{"code":"Dcr","type":"codeVoice"}],"url":"Self::Dcr","type":"link","identifier":"Self::Dcr","title":"Dcr"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","url":"\/documentation\/axiamsdk\/clientauthmethod","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientAuthMethod"}],"navigatorTitle":[{"kind":"identifier","text":"ClientAuthMethod"}],"abstract":[{"text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming).","type":"text"},{"text":" ","type":"text"},{"text":"Only the methods AXIAM actually implements are representable. ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" — the public-client","type":"text"},{"text":" ","type":"text"},{"text":"value — was deliberately absent until T21.2: adding it before the rest of the server","type":"text"},{"text":" ","type":"text"},{"text":"understood one would have let an operator register a client whose authentication is silently","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The server understands one now (","type":"text"},{"type":"codeVoice","code":"token.rs"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"authenticate_client_credential"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"an arm that accepts ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"no","type":"text"}]},{"text":" credential and refuses a presented one, the authorization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"kind":"symbol","type":"topic","title":"ClientAuthMethod"},"doc://AxiamSDK/documentation/AxiamSDK/CibaDeliveryMode":{"abstract":[{"text":"How a CIBA client learns that a request has been decided (CIBA Core §5). ","type":"text"},{"type":"codeVoice","code":"push"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"deliberately absent: AXIAM does not offer it, and the FAPI-CIBA profile forbids it — push","type":"text"},{"text":" ","type":"text"},{"text":"delivers the tokens themselves to a client endpoint, which makes the notification endpoint a","type":"text"},{"text":" ","type":"text"},{"text":"token sink.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CibaDeliveryMode","kind":"identifier"}],"title":"CibaDeliveryMode","navigatorTitle":[{"text":"CibaDeliveryMode","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/cibadeliverymode","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaDeliveryMode"},"Self::Ignore":{"titleInlineContent":[{"code":"Ignore","type":"codeVoice"}],"url":"Self::Ignore","type":"link","identifier":"Self::Ignore","title":"Ignore"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamS