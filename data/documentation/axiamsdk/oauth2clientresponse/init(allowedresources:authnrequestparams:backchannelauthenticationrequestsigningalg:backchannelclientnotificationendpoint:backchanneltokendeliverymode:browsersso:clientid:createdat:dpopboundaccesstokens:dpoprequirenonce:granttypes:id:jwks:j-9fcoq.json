t":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK16ClientAuthMethodO","text":"ClientAuthMethod","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"updatedAt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"role":"symbol","url":"\/documentation\/axiamsdk\/clientauthmethod","abstract":[{"text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming).","type":"text"},{"text":" ","type":"text"},{"text":"Only the methods AXIAM actually implements are representable. ","type":"text"},{"type":"codeVoice","code":"None"},{"text":" — the public-client","type":"text"},{"text":" ","type":"text"},{"text":"value — was deliberately absent until T21.2: adding it before the rest of the server","type":"text"},{"text":" ","type":"text"},{"text":"understood one would have let an operator register a client whose authentication is silently","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The server understands one now (","type":"text"},{"type":"codeVoice","code":"token.rs"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"authenticate_client_credential"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"an arm that accepts ","type":"text"},{"inlineContent":[{"type":"text","text":"no"}],"type":"emphasis"},{"text":" credential and refuses a presented one, the authorization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}],"navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"title":"ClientAuthMethod","kind":"symbol"},"Self::Admin":{"identifier":"Self::Admin","title":"Admin","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"url":"Self::Admin"},"doc://AxiamSDK/documentation/AxiamSDK/CibaDeliveryMode":{"type":"topic","abstract":[{"type":"text","text":"How a CIBA client learns that a request has been decided (CIBA Core §5). "},{"type":"codeVoice","code":"push"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"deliberately absent: AXIAM does not offer it, and the FAPI-CIBA profile forbids it — push"},{"type":"text","text":" "},{"text":"delivers the tokens themselves to a client endpoint, which makes the notification endpoint a","type":"text"},{"text":" ","type":"text"},{"text":"token sink.","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaDeliveryMode","url":"\/documentation\/axiamsdk\/cibadeliverymode","title":"CibaDeliveryMode","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"CibaDeliveryMode","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CibaDeliveryMode"}]},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"type":"topic","title":"OAuth2ClientResponse","role":"symbol","abstract":[{"type":"text","text":"OAuth2 client response – omits client_secret_hash."}],"kind":"symbol","url":"\/documentation\/axiamsdk\/oauth2clientresponse","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OAuth2ClientResponse"}],"navigatorTitle":[{"kind":"identifier","text":"OAuth2ClientResponse"}]},"doc://AxiamSDK/documentation/AxiamSDK/CibaRequestSigningAlg":{"abstract":[{"text":"The JWS algorithm a CIBA client signs its authentication requests with (CIBA Core §4","type":"text"},{"text":" ","type":"text"},{"code":"backchannel_authentication_request_signing_alg","type":"codeVoice"},{"text":", §7.1.1). Exactly the three algorithms","type":"text"},{"text":" ","type":"text"},{"text":"AXIAM verifies on any client-signed JWT (","type":"text"},{"code":"axiam_oauth2::jose::PERMITTED_ALGORITHMS","type":"codeVoice"},{"text":"): FAPI","type":"text"},{"text":" ","type":"text"},{"text":"2.0 §5.3.1.1’s list. A registration naming anything else — ","type":"text"},{"code":"RS256","type":"codeVoice"},{"text":", ","type":"text"},{"code":"HS256","type":"codeVoice"},{"text":", ","type":"text"},{"code":"none","type":"codeVoice"},{"text":" — is","type":"text"},{"text":" ","type":"text"},{"text":"refused rather than stored, so no row can hold an algorithm the verifier would not honour","type":"text"},{"text":" ","type":"text"},{"text":"(D-61).","type":"text"}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CibaRequestSigningAlg","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/cibarequestsigningalg","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaRequestSigningAlg","navigatorTitle":[{"text":"CibaRequestSigningAlg","kind":"identifier"}],"title":"CibaRequestSigningAlg","role":"symbol","kind":"symbol"}}}