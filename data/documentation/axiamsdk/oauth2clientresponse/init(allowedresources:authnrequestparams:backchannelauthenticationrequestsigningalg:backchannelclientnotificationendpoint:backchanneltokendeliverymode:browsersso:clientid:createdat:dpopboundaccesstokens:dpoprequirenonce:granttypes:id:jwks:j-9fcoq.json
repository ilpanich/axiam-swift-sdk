rained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"url":"\/documentation\/axiamsdk\/clientprofile","title":"ClientProfile","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CibaRequestSigningAlg":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaRequestSigningAlg","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CibaRequestSigningAlg"}],"type":"topic","title":"CibaRequestSigningAlg","url":"\/documentation\/axiamsdk\/cibarequestsigningalg","abstract":[{"text":"The JWS algorithm a CIBA client signs its authentication requests with (CIBA Core §4","type":"text"},{"text":" ","type":"text"},{"code":"backchannel_authentication_request_signing_alg","type":"codeVoice"},{"text":", §7.1.1). Exactly the three algorithms","type":"text"},{"text":" ","type":"text"},{"text":"AXIAM verifies on any client-signed JWT (","type":"text"},{"code":"axiam_oauth2::jose::PERMITTED_ALGORITHMS","type":"codeVoice"},{"text":"): FAPI","type":"text"},{"text":" ","type":"text"},{"text":"2.0 §5.3.1.1’s list. A registration naming anything else — ","type":"text"},{"code":"RS256","type":"codeVoice"},{"text":", ","type":"text"},{"code":"HS256","type":"codeVoice"},{"text":", ","type":"text"},{"code":"none","type":"codeVoice"},{"text":" — is","type":"text"},{"text":" ","type":"text"},{"text":"refused rather than stored, so no row can hold an algorithm the verifier would not honour","type":"text"},{"text":" ","type":"text"},{"text":"(D-61).","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CibaRequestSigningAlg"}]},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode":{"abstract":[{"type":"text","text":"Whether this client’s authorization requests may carry OpenID Connect’s"},{"type":"text","text":" "},{"type":"text","text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this"},{"type":"text","text":" "},{"type":"text","text":"governs is "},{"type":"codeVoice","code":"prompt"},{"type":"text","text":", "},{"type":"codeVoice","code":"max_age"},{"type":"text","text":", "},{"type":"codeVoice","code":"acr_values"},{"type":"text","text":", "},{"type":"codeVoice","code":"claims"},{"type":"text","text":", "},{"type":"codeVoice","code":"id_token_hint"},{"type":"text","text":", "},{"type":"codeVoice","code":"login_hint"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"display"},{"type":"text","text":", "},{"type":"codeVoice","code":"ui_locales"},{"type":"text","text":" and "},{"type":"codeVoice","code":"claims_locales"},{"type":"text","text":". It is "},{"type":"strong","inlineContent":[{"text":"one","type":"text"}]},{"type":"text","text":" field rather than nine booleans"},{"type":"text","text":" "},{"type":"text","text":"for the same reason ["},{"type":"codeVoice","code":"ClientProfile"},{"type":"text","text":"] is one field rather than a dozen: a client that"},{"type":"text","text":" "},{"type":"text","text":"honours "},{"type":"codeVoice","code":"max_age"},{"type":"text","text":" but ignores "},{"type":"codeVoice","code":"prompt=none"},{"type":"text","text":" is not “mostly conformant”, it is a client a"},{"type":"text","text":" "},{"type":"text","text":"relying party cannot reason about. "},{"type":"reference","isActive":true,"identifier":"Self::Ignore"},{"type":"text","text":" is the serde default and is"},{"type":"text","text":" "},{"type":"text","text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by"},{"type":"text","text":" "},{"type":"text","text":"the query deserialiser and never reach a decision. Every row written before schema v54"},{"type":"text","text":" "},{"type":"text","text":"therefore decodes to the behaviour it already had."}],"title":"AuthnRequestParamsMode","kind":"symbol","type":"topic","navigatorTitle":[{"text":"AuthnRequestParamsMode","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AuthnRequestParamsMode","kind":"identifier"}]},"Self::Admin":{"titleInlineContent":[{"type":"codeVoice","code":"Admin"}],"url":"Self::Admin","type":"link","title":"Admin","identifier":"Self::Admin"},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","url":"\/documentation\/axiamsdk\/managedby","abstract":[{"text":"Who created a client registration (D5, T21.4). The discriminator that separates a","type":"text"},{"text":" ","type":"text"},{"text":"registration an administrator made from one that arrived over an open endpoint. Three things","type":"text"},{"text":" ","type":"text"},{"text":"read it and each would otherwise have to infer provenance from something that is not","type":"text"},{"text":" ","type":"text"},{"text":"provenance: * ","type":"text"},{"code":"axiam_oauth2::fapi","type":"codeVoice"},{"text":" refuses a FAPI profile on anything but","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"Self::Admin","type":"reference"},{"text":" (I5) — a client nobody vetted cannot be financial-grade; * the","type":"text"},{"text":" ","type":"text"},{"text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party","type":"text"},{"text":" ","type":"text"},{"text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper","type":"text"},{"text":" ","type":"text"},{"text":"deletes only ","type":"text"},{"isActive":true,"identifier":"Self::Dcr","type":"reference"},{"text":" rows, so an administrator’s client is never swept however","type":"text"},{"text":" ","type":"text"},{"text":"long it sits unused. ","type":"text"},{"isActive":true,"overridingTitle":"Admin","overridingTitleInlineContent":[{"type":"codeVoice","code":"Admin"}],"identifier":"Self::Admin","type":"reference"},{"text":" is the serde default and therefore what every","type":"text"},{"text":" ","type":"text"},{"text":"row written before T21.4 decodes to, which is the truth: they were all created through ","type":"text"},{"code":"POST \/oauth2-clients","type":"codeVoice"},{"text":" by somebody holding ","type":"text"},{"code":"oauth2_clients:create","type":"codeVoice"},{"text":".","type":"text"}],"title":"ManagedBy","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ManagedBy"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagedBy"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ClientAuthMethod":{"abstract":[{"text":"How a client proves its identity at the token endpoint (RFC 8705 §2, OIDC Core §9 naming).","type":"text"},{"text":" ","type":"text"},{"text":"Only the methods AXIAM actually implements are representable. ","type":"text"},{"code":"None","type":"codeVoice"},{"text":" — the public-client","type":"text"},{"text":" ","type":"text"},{"text":"value — was deliberately absent until T21.2: adding it before the rest of the server","type":"text"},{"text":" ","type":"text"},{"text":"understood one would have let an operator register a client whose authentication is silently","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The server understands one now (","type":"text"},{"code":"token.rs","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"authenticate_client_credential","type":"codeVoice"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"an arm that accepts ","type":"text"},{"inlineContent":[{"text":"no","type":"text"}],"type":"emphasis"},{"text":" credential and refuses a presented one, the authorization endpoint","type":"text"},{"text":" ","type":"text"},{"text":"derives its PKCE requirement from this enum, and the admin API refuses the method alongside","type":"text"},{"text":" ","type":"text"},{"text":"any grant or binding that contradicts it), so the variant exists — and only that arm may","type":"text"},{"text":" ","type":"text"},{"text":"ever treat a missing credential as success.","type":"text"}],"kind":"symbol","title":"ClientAuthMethod","type":"topic","navigatorTitle":[{"text":"ClientAuthMethod","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/clientauthmethod","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientAuthMethod","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientAuthMethod","kind":"identifier"}]},"Self::Standard":{"type":"link","identifier":"Self::Standard","url":"Self::Standard","title":"Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}]},"Self::Dcr":{"url":"Self::Dcr","identifier":"Self::Dcr","title":"Dcr","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}]},