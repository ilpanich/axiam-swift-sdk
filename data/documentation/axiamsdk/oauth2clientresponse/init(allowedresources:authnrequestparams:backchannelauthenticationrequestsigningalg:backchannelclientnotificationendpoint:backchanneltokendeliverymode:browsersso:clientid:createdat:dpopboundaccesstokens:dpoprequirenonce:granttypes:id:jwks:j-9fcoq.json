odeVoice"},{"text":", ","type":"text"},{"code":"acr_values","type":"codeVoice"},{"text":", ","type":"text"},{"code":"claims","type":"codeVoice"},{"text":", ","type":"text"},{"code":"id_token_hint","type":"codeVoice"},{"text":", ","type":"text"},{"code":"login_hint","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"display","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ui_locales","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"claims_locales","type":"codeVoice"},{"text":". It is ","type":"text"},{"inlineContent":[{"type":"text","text":"one"}],"type":"strong"},{"type":"text","text":" field rather than nine booleans"},{"type":"text","text":" "},{"type":"text","text":"for the same reason ["},{"type":"codeVoice","code":"ClientProfile"},{"type":"text","text":"] is one field rather than a dozen: a client that"},{"type":"text","text":" "},{"type":"text","text":"honours "},{"type":"codeVoice","code":"max_age"},{"type":"text","text":" but ignores "},{"type":"codeVoice","code":"prompt=none"},{"type":"text","text":" is not “mostly conformant”, it is a client a"},{"type":"text","text":" "},{"type":"text","text":"relying party cannot reason about. "},{"type":"reference","identifier":"Self::Ignore","isActive":true},{"type":"text","text":" is the serde default and is"},{"type":"text","text":" "},{"type":"text","text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by"},{"type":"text","text":" "},{"type":"text","text":"the query deserialiser and never reach a decision. Every row written before schema v54"},{"type":"text","text":" "},{"type":"text","text":"therefore decodes to the behaviour it already had."}],"type":"topic","kind":"symbol","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthnRequestParamsMode"}],"navigatorTitle":[{"kind":"identifier","text":"AuthnRequestParamsMode"}]},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","kind":"symbol","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"abstract":[{"type":"text","text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”."},{"type":"text","text":" "},{"type":"text","text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"S256","type":"codeVoice"},{"type":"text","text":", mandatory strong client authentication, mandatory sender-constrained tokens,"},{"type":"text","text":" "},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nearly"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"title":"ClientProfile","type":"topic","url":"\/documentation\/axiamsdk\/clientprofile"},"Self::Ignore":{"identifier":"Self::Ignore","title":"Ignore","type":"link","titleInlineContent":[{"code":"Ignore","type":"codeVoice"}],"url":"Self::Ignore"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"Self::Standard":{"title":"Standard","identifier":"Self::Standard","url":"Self::Standard","titleInlineContent":[{"code":"Standard","type":"codeVoice"}],"type":"link"},"Self::Dcr":{"identifier":"Self::Dcr","title":"Dcr","type":"link","url":"Self::Dcr","titleInlineContent":[{"type":"codeVoice","code":"Dcr"}]},"doc://AxiamSDK/documentation/AxiamSDK/ManagedBy":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagedBy","title":"ManagedBy","abstract":[{"text":"Who created a client registration (D5, T21.4). The discriminator that separates a","type":"text"},{"text":" ","type":"text"},{"text":"registration an administrator made from one that arrived over an open endpoint. Three things","type":"text"},{"text":" ","type":"text"},{"text":"read it and each would otherwise have to infer provenance from something that is not","type":"text"},{"text":" ","type":"text"},{"text":"provenance: * ","type":"text"},{"code":"axiam_oauth2::fapi","type":"codeVoice"},{"text":" refuses a FAPI profile on anything but","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"Self::Admin","type":"reference"},{"text":" (I5) — a client nobody vetted cannot be financial-grade; * the","type":"text"},{"text":" ","type":"text"},{"text":"authorization endpoint forces a consent hop for every other value (D4) — an unrelated party","type":"text"},{"text":" ","type":"text"},{"text":"gets a question put to the end user, whatever scopes it asked for; * the T21.4 sweeper","type":"text"},{"text":" ","type":"text"},{"text":"deletes only ","type":"text"},{"isActive":true,"identifier":"Self::Dcr","type":"reference"},{"text":" rows, so an administrator’s client is never swept however","type":"text"},{"text":" ","type":"text"},{"text":"long it sits unused. ","type":"text"},{"overridingTitleInlineContent":[{"code":"Admin","type":"codeVoice"}],"overridingTitle":"Admin","isActive":true,"identifier":"Self::Admin","type":"reference"},{"text":" is the serde default and therefore what every","type":"text"},{"text":" ","type":"text"},{"text":"row written before T21.4 decodes to, which is the truth: they were all created through ","type":"text"},{"code":"POST \/oauth2-clients","type":"codeVoice"},{"text":" by somebody holding ","type":"text"},{"type":"codeVoice","code":"oauth2_clients:create"},{"text":".","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/axiamsdk\/managedby","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ManagedBy","kind":"identifier"}],"navigatorTitle":[{"text":"ManagedBy","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/init(allowedResources:authnRequestParams:backchannelAuthenticationRequestSigningAlg:backchannelClientNotificationEndpoint:backchannelTokenDeliveryMode:browserSSO:clientID:createdAt:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:id:jwks:jwksURI:lastAuthorizedAt:managedBy:name:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tenantID:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClientAuthSubjectDn:tlsClientCertificateBoundAccessTokens:tokenEndpointAuthMethod:updatedAt:)":{"role":"symbol","title":"init(allowedResources:authnRequestParams:backchannelAuthenticationRequestSigningAlg:backchannelClientNotificationEndpoint:backchannelTokenDeliveryMode:browserSSO:clientID:createdAt:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:id:jwks:jwksURI:lastAuthorizedAt:managedBy:name:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tenantID:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClientAuthSubjectDn:tlsClientCertificateBoundAccessTokens:tokenEndpointA