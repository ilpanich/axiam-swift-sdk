raits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/oauth2clientresponse\/init(authnrequestparams:browsersso:clientid:createdat:dpopboundaccesstokens:dpoprequirenonce:granttypes:id:jwks:jwksuri:name:profile:redirecturis:requirepar:scopes:selfsignedtlsclientauththumbprints:tenantid:tlsclientauthsandns:tlsclientaut-7xk33"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OAuth2ClientResponse","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse","title":"OAuth2ClientResponse","navigatorTitle":[{"text":"OAuth2ClientResponse","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/oauth2clientresponse","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"OAuth2 client response – omits client_secret_hash.","type":"text"}]},"Self::Ignore":{"url":"Self::Ignore","title":"Ignore","identifier":"Self::Ignore","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Ignore"}]},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile":{"url":"\/documentation\/axiamsdk\/clientprofile","kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","abstract":[{"text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”.","type":"text"},{"text":" ","type":"text"},{"text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"S256"},{"type":"text","text":", mandatory strong client authentication, mandatory sender-constrained tokens,"},{"type":"text","text":" "},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"identifier":"Self::Standard","type":"reference","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"text":"written before schema v38 decodes to it.","type":"text"}],"title":"ClientProfile","navigatorTitle":[{"kind":"identifier","text":"ClientProfile"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientProfile"}]},"Self::Standard":{"url":"Self::Standard","title":"Standard","identifier":"Self::Standard","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Standard"}]},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthnRequestParamsMode"}],"title":"AuthnRequestParamsMode","abstract":[{"type":"text","text":"Whether this client’s authorization requests may carry OpenID Connect’s"},{"type":"text","text":" "},{"type":"text","text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this"},{"type":"text","text":" "},{"type":"text","text":"governs is "},{"type":"codeVoice","code":"prompt"},{"type":"text","text":", "},{"type":"codeVoice","code":"max_age"},{"type":"text","text":", "},{"type":"codeVoice","code":"acr_values"},{"type":"text","text":", "},{"type":"codeVoice","code":"claims"},{"type":"text","text":", "},{"type":"codeVoice","code":"id_token_hint"},{"type":"text","text":", "},{"type":"codeVoice","code":"login_hint"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"display"},{"type":"text","text":", "},{"code":"ui_locales","type":"codeVoice"},{"type":"text","text":" and "},{"code":"claims_locales","type":"codeVoice"},{"type":"text","text":". It is "},{"type":"strong","inlineContent":[{"text":"one","type":"text"}]},{"type":"text","text":" field rather than nine booleans"},{"type":"text","text":" "},{"type":"text","text":"for the same reason ["},{"code":"ClientProfile","type":"codeVoice"},{"text":"] is one field rather than a dozen: a client that","type":"text"},{"text":" ","type":"text"},{"text":"honours ","type":"text"},{"code":"max_age","type":"codeVoice"},{"text":" but ignores ","type":"text"},{"code":"prompt=none","type":"codeVoice"},{"text":" is not “mostly conformant”, it is a client a","type":"text"},{"text":" ","type":"text"},{"text":"relying party cannot reason about. ","type":"text"},{"identifier":"Self::Ignore","type":"reference","isActive":true},{"text":" is the serde default and is","type":"text"},{"text":" ","type":"text"},{"text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by","type":"text"},{"text":" ","type":"text"},{"text":"the query deserialiser and never reach a decision. Every row written before schema v54","type":"text"},{"text":" ","type":"text"},{"text":"therefore decodes to the behaviour it already had.","type":"text"}],"type":"topic","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","navigatorTitle":[{"kind":"identifier","text":"AuthnRequestParamsMode"}]},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/init(authnRequestParams:browserSSO:clientID:createdAt:dpopBoundAccessTokens:dpopRequireNonce:grantTypes:id:jwks:jwksURI:name:profile:redirectUris:requirePar:scopes:selfSignedTLSClientAuthThumbprints:tenantID:tlsClientAuthSanDNS:tlsClientAuthSanURI:tlsClie