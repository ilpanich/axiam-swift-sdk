{"metadata":{"modules":[{"name":"AxiamSDK"}],"title":"TenantKind","roleHeading":"Enumeration","symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TenantKind"}],"navigatorTitle":[{"kind":"identifier","text":"TenantKind"}],"externalID":"s:8AxiamSDK10TenantKindO","role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/tenantkind"]}],"abstract":[{"type":"text","text":"What a tenant "},{"type":"emphasis","inlineContent":[{"text":"is","type":"text"}]},{"type":"text","text":", as distinct from what state it is in. Reserved rather than inferred: an"},{"type":"text","text":" "},{"type":"text","text":"organization has exactly one tenant of kind ["},{"type":"codeVoice","code":"Self::Organization"},{"type":"text","text":"], enforced by a unique"},{"type":"text","text":" "},{"type":"text","text":"index rather than by convention. Deriving it from a magic slug or from “the oldest tenant”"},{"type":"text","text":" "},{"type":"text","text":"would make the organization scope something an operator could rename or delete by accident,"},{"type":"text","text":" "},{"type":"text","text":"and it is the scope the super-admin lives in."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TenantKind"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An "},{"type":"strong","inlineContent":[{"text":"open","type":"text"}]},{"type":"text","text":" enum. A value this SDK’s copy of the spec does not list decodes to "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" "},{"type":"text","text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there"},{"type":"text","text":" "},{"type":"text","text":"fails the WHOLE response, so one field of one record would take down the page it was on,"},{"type":"text","text":" "},{"type":"text","text":"including the records the caller did ask for."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"text","text":"carrying an unrecognised value back into an update is refused by the server rather than"},{"type":"text","text":" "},{"type":"text","text":"written as a spelling it never used. A "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" over these cases needs an "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TenantKind","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TenantKind\/organization","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TenantKind\/standard","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TenantKind\/unknown"]},{"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TenantKind\/init(from:)-v1lc","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TenantKind\/init(rawValue:)"]},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TenantKind\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/A