{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UserStatus","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"An ","type":"text"},{"inlineContent":[{"type":"text","text":"open"}],"type":"strong"},{"text":" enum. A value this SDK’s copy of the spec does not list decodes to ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there","type":"text"},{"text":" ","type":"text"},{"text":"fails the WHOLE response, so one field of one record would take down the page it was on,","type":"text"},{"text":" ","type":"text"},{"text":"including the records the caller did ask for.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is never written: "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"type":"codeVoice","code":"\"\""},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"UserStatus"},{"type":"text","text":" enumeration, as the server spells it."}],"variants":[{"paths":["\/documentation\/axiamsdk\/userstatus"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"enum","externalID":"s:8AxiamSDK10UserStatusO","modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"text":"UserStatus","kind":"identifier"}],"role":"symbol","roleHeading":"Enumeration","title":"UserStatus","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"UserStatus"}]},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/active","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/anonymized","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/deleted","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/inactive","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/locked","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/pendingVerification","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/unknown"],"generated":true,"title":"Enumeration Cases","anchor":"Enumeration-Cases"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/init(rawValue:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/encode(to:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserStatus\/RawRepresentable-Implementations"],"title":"Default Implementations","generated":true,"anch