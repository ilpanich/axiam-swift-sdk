{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeprovisionPolicy","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"An "},{"type":"strong","inlineContent":[{"text":"open","type":"text"}]},{"type":"text","text":" enum. A value this SDK’s copy of the spec does not list decodes to "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" "},{"type":"text","text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there"},{"type":"text","text":" "},{"type":"text","text":"fails the WHOLE response, so one field of one record would take down the page it was on,"},{"type":"text","text":" "},{"type":"text","text":"including the records the caller did ask for."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is never written: "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"type":"codeVoice","code":"\"\""},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"What happens downstream to a user who falls out of scope or is no longer active. Erasure"},{"type":"text","text":" "},{"type":"text","text":"always deletes, whatever this says."}],"variants":[{"paths":["\/documentation\/axiamsdk\/deprovisionpolicy"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"enum","externalID":"s:8AxiamSDK17DeprovisionPolicyO","modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"kind":"identifier","text":"DeprovisionPolicy"}],"role":"symbol","roleHeading":"Enumeration","title":"DeprovisionPolicy","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"DeprovisionPolicy","kind":"identifier"}]},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/deactivate","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/delete","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/unknown"],"anchor":"Enumeration-Cases","generated":true},{"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/init(rawValue:)"],"anchor":"Initializers","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/encode(to:)"],"anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/RawRepresentable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/Axiam