tract 1.60 A4) — never as "},{"type":"codeVoice","code":"\"\""},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/deprovisionpolicy"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Enumeration-Cases","title":"Enumeration Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/deactivate","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/delete","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/unknown"],"generated":true},{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/init(rawValue:)"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/encode(to:)"],"generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DeprovisionPolicy\/RawRepresentable-Implementations"],"anchor":"Default-Implementations","generated":true}],"metadata":{"externalID":"s:8AxiamSDK17DeprovisionPolicyO","roleHeading":"Enumeration","role":"symbol","title":"DeprovisionPolicy","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeprovisionPolicy","kind":"identifier"}],"symbolKind":"enum","navigatorTitle":[{"kind":"identifier","text":"DeprovisionPolicy"}]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/s12CaseIte