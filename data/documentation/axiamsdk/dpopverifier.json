{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"text":"DPoP proof verification — CONTRACT.md §21.7.2 (RFC 9449), contract 1.16.","type":"text"}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"DpopVerifier"}],"modules":[{"name":"AxiamSDK"}],"role":"symbol","roleHeading":"Enumeration","externalID":"s:8AxiamSDK12DpopVerifierO","title":"DpopVerifier","symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DpopVerifier"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DpopVerifier","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The resource-server half of DPoP: given the "},{"code":"DPoP","type":"codeVoice"},{"type":"text","text":" header a caller presented, decide"},{"type":"text","text":" "},{"type":"text","text":"whether it proves possession for "},{"inlineContent":[{"type":"text","text":"this"}],"type":"strong"},{"type":"text","text":" request and "},{"inlineContent":[{"text":"this","type":"text"}],"type":"strong"},{"type":"text","text":" access token, and return"},{"type":"text","text":" "},{"type":"text","text":"the key thumbprint that "},{"code":"AxiamRequestAuthenticator\/verifyTokenBinding(_:proofs:)","type":"codeVoice"},{"type":"text","text":" then"},{"type":"text","text":" "},{"type":"text","text":"matches against the token’s "},{"code":"cnf.jkt","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Why this lives in the SDK","anchor":"Why-this-lives-in-the-SDK","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"§21.7.2 is a ten-check list, and the contract is blunt about partial implementations:"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“Partial verification is worse than none, because it produces a guard that reports"},{"type":"text","text":" "},{"type":"text","text":"success.”"}]},{"type":"text","text":" Nine of the ten look optional until someone builds an attack out of the one"},{"type":"text","text":" "},{"type":"text","text":"that was skipped, so they belong in one audited place rather than in every application"},{"type":"text","text":" "},{"type":"text","text":"guarding an endpoint."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The two most often missing: "},{"type":"codeVoice","code":"typ"},{"type":"text","text":" — without pinning it to "},{"type":"codeVoice","code":"dpop+jwt"},{"type":"text","text":", any "},{"inlineContent":[{"type":"text","text":"other"}],"type":"emphasis"},{"type":"text","text":" JWT"},{"type":"text","text":" "},{"type":"text","text":"signed by the same key (an access token, an ID token) is replayable as a proof; and"},{"type":"text","text":" "},{"type":"codeVoice","code":"ath"},{"type":"text","text":" — without it, a proof captured on one request can be re-aimed at a different token"},{"type":"text","text":" "},{"type":"text","text":"held by the same key."}],"type":"paragraph"},{"text":"The algorithm comes from the key, never from the header","anchor":"The-algorithm-comes-from-the-key-never-from-the-header","level":2,"type":"heading"},{"inlineContent":[{"code":"alg: none","type":"codeVoice"},{"text":" and RSA-public-key-as-HMAC-secret are the same bug wearing different clothes:","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"the token told the verifier how to check the token"}],"type":"emphasis"},{"text":". This enum dispatches on the","type":"text"},{"text":" ","type":"text"},{"text":"embedded key’s own ","type":"text"},{"code":"kty","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"crv","type":"codeVoice"},{"text":", so an HMAC path is never reachable no matter what the","type":"text"},{"text":" ","type":"text"},{"text":"header says.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/dpopverifier"]}],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/Request"],"title":"Structures"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/iatLeeway"],"title":"Type Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/accessTokenHash(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/canonicalHtu(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/thumbprintS256(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/verifyProof(_:request:jtiStore:)"],"title":"Type Methods"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/DpopVerifier/iatLeeway":{"kind":"symbol","title":"iatLeeway","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"iatLeeway"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation12TimeIntervala","text":"TimeInterval"}],"type":"topic","abstract":[{"type":"text","text":"§21.7.2 check 7 — the "},{"type":"codeVoice","code":"iat"},{"text":" acceptance window, applied in ","type":"text"},{"inlineContent":[{"text":"both","type":"text"}],"type":"strong"},{"type":"text","text":" directions."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/iatLeeway","url":"\/documentation\/axiamsdk\/dpopverifier\/iatleeway"},"doc://AxiamSDK/documentation/AxiamSDK/DpopVerifier/Request":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Request","kind":"identifier"}],"title