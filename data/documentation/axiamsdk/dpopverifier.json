{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier"},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/Request"],"title":"Structures"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/iatLeeway"],"title":"Type Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/accessTokenHash(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/canonicalHtu(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/thumbprintS256(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/verifyProof(_:request:jtiStore:)"],"title":"Type Methods"}],"metadata":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DpopVerifier"}],"externalID":"s:8AxiamSDK12DpopVerifierO","modules":[{"name":"AxiamSDK"}],"role":"symbol","roleHeading":"Enumeration","title":"DpopVerifier","symbolKind":"enum","navigatorTitle":[{"kind":"identifier","text":"DpopVerifier"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DpopVerifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The resource-server half of DPoP: given the "},{"code":"DPoP","type":"codeVoice"},{"type":"text","text":" header a caller presented, decide"},{"type":"text","text":" "},{"type":"text","text":"whether it proves possession for "},{"type":"strong","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" request and "},{"type":"strong","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" access token, and return"},{"type":"text","text":" "},{"type":"text","text":"the key thumbprint that "},{"code":"AxiamRequestAuthenticator\/verifyTokenBinding(_:proofs:)","type":"codeVoice"},{"type":"text","text":" then"},{"type":"text","text":" "},{"type":"text","text":"matches against the token’s "},{"code":"cnf.jkt","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"Why this lives in the SDK","anchor":"Why-this-lives-in-the-SDK","level":2},{"type":"paragraph","inlineContent":[{"text":"§21.7.2 is a ten-check list, and the contract is blunt about partial implementations:","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"“Partial verification is worse than none, because it produces a guard that reports"},{"type":"text","text":" "},{"type":"text","text":"success.”"}]},{"text":" Nine of the ten look optional until someone builds an attack out of the one","type":"text"},{"text":" ","type":"text"},{"text":"that was skipped, so they belong in one audited place rather than in every application","type":"text"},{"text":" ","type":"text"},{"text":"guarding an endpoint.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The two most often missing: ","type":"text"},{"type":"codeVoice","code":"typ"},{"text":" — without pinning it to ","type":"text"},{"type":"codeVoice","code":"dpop+jwt"},{"text":", any ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"other","type":"text"}]},{"text":" JWT","type":"text"},{"text":" ","type":"text"},{"text":"signed by the same key (an access token, an ID token) is replayable as a proof; and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ath"},{"text":" — without it, a proof captured on one request can be re-aimed at a different token","type":"text"},{"text":" ","type":"text"},{"text":"held by the same key.","type":"text"}]},{"type":"heading","text":"The algorithm comes from the key, never from the header","anchor":"The-algorithm-comes-from-the-key-never-from-the-header","level":2},{"type":"paragraph","inlineContent":[{"code":"alg: none","type":"codeVoice"},{"type":"text","text":" and RSA-public-key-as-HMAC-secret are the same bug wearing different clothes:"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"the token told the verifier how to check the token"}],"type":"emphasis"},{"type":"text","text":". This enum dispatches on the"},{"type":"text","text":" "},{"type":"text","text":"embedded key’s own "},{"code":"kty","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"crv","type":"codeVoice"},{"type":"text","text":", so an HMAC path is never reachable no matter what the"},{"type":"text","text":" "},{"type":"text","text":"header says."}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/dpopverifier"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"DPoP proof verification — CONTRACT.md §21.7.2 (RFC 9449), contract 1.16.","type":"text"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/DpopVerifier/Request":{"url":"\/documentation\/axiamsdk\/dpopverifier\/request","abstract":[{"text":"What ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/verifyProof(_:request:jtiStore:)","isActive":true,"type":"reference"},{"text":" needs to know about the current request.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Request"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Request"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/Request","type":"topic","role":"symbol","title":"DpopVerifier.Request"},"doc://AxiamSDK/documentation/AxiamSDK/DpopVerifier/thumbprintS256(_:)":{"abstract":[{"type":"text","text":"Compute the RFC 7638 SHA-256 thumbprint of a JWK — the "},{"type":"codeVoice","code":"jkt"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"static","kind":"keywo