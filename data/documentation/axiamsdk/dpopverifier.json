{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"abstract":[{"type":"text","text":"DPoP proof verification — CONTRACT.md §21.7.2 (RFC 9449), contract 1.16."}],"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/dpopverifier"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:8AxiamSDK12DpopVerifierO","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DpopVerifier"}],"modules":[{"name":"AxiamSDK"}],"symbolKind":"enum","navigatorTitle":[{"kind":"identifier","text":"DpopVerifier"}],"role":"symbol","roleHeading":"Enumeration","title":"DpopVerifier"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DpopVerifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The resource-server half of DPoP: given the ","type":"text"},{"code":"DPoP","type":"codeVoice"},{"text":" header a caller presented, decide","type":"text"},{"text":" ","type":"text"},{"text":"whether it proves possession for ","type":"text"},{"inlineContent":[{"text":"this","type":"text"}],"type":"strong"},{"text":" request and ","type":"text"},{"inlineContent":[{"text":"this","type":"text"}],"type":"strong"},{"text":" access token, and return","type":"text"},{"text":" ","type":"text"},{"text":"the key thumbprint that ","type":"text"},{"code":"AxiamRequestAuthenticator\/verifyTokenBinding(_:proofs:)","type":"codeVoice"},{"text":" then","type":"text"},{"text":" ","type":"text"},{"text":"matches against the token’s ","type":"text"},{"code":"cnf.jkt","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Why-this-lives-in-the-SDK","text":"Why this lives in the SDK"},{"type":"paragraph","inlineContent":[{"text":"§21.7.2 is a ten-check list, and the contract is blunt about partial implementations:","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"“Partial verification is worse than none, because it produces a guard that reports"},{"type":"text","text":" "},{"type":"text","text":"success.”"}],"type":"emphasis"},{"text":" Nine of the ten look optional until someone builds an attack out of the one","type":"text"},{"text":" ","type":"text"},{"text":"that was skipped, so they belong in one audited place rather than in every application","type":"text"},{"text":" ","type":"text"},{"text":"guarding an endpoint.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The two most often missing: ","type":"text"},{"code":"typ","type":"codeVoice"},{"text":" — without pinning it to ","type":"text"},{"code":"dpop+jwt","type":"codeVoice"},{"text":", any ","type":"text"},{"inlineContent":[{"type":"text","text":"other"}],"type":"emphasis"},{"text":" JWT","type":"text"},{"text":" ","type":"text"},{"text":"signed by the same key (an access token, an ID token) is replayable as a proof; and","type":"text"},{"text":" ","type":"text"},{"code":"ath","type":"codeVoice"},{"text":" — without it, a proof captured on one request can be re-aimed at a different token","type":"text"},{"text":" ","type":"text"},{"text":"held by the same key.","type":"text"}]},{"type":"heading","level":2,"anchor":"The-algorithm-comes-from-the-key-never-from-the-header","text":"The algorithm comes from the key, never from the header"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"alg: none"},{"type":"text","text":" and RSA-public-key-as-HMAC-secret are the same bug wearing different clothes:"},{"type":"text","text":" "},{"inlineContent":[{"text":"the token told the verifier how to check the token","type":"text"}],"type":"emphasis"},{"type":"text","text":". This enum dispatches on the"},{"type":"text","text":" "},{"type":"text","text":"embedded key’s own "},{"type":"codeVoice","code":"kty"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"crv"},{"type":"text","text":", so an HMAC path is never reachable no matter what the"},{"type":"text","text":" "},{"type":"text","text":"header says."}]}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/Request"],"title":"Structures"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/iatLeeway"],"title":"Type Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/accessTokenHash(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/canonicalHtu(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/thumbprintS256(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/verifyProof(_:request:jtiStore:)"],"title":"Type Methods"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","kind":"symbol","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/DpopVerifier/verifyProof(_:request:jtiStore:)":{"title":"verifyProof(_:request:jtiStore:)","kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/dpopverifier\/verifyproof(_:request:jtistore:)","abstract":[{"type":"text","text":"Verify a DPoP proof against this request — all ten §21.7.2 checks."}],"fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"verifyProof"},{"kind":"text","text":"("},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"e