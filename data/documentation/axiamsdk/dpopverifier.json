{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/axiamsdk\/dpopverifier"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/Request"],"title":"Structures"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/iatLeeway"],"title":"Type Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/accessTokenHash(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/canonicalHtu(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/thumbprintS256(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/verifyProof(_:request:jtiStore:)"],"title":"Type Methods"}],"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DpopVerifier","kind":"identifier"}],"platforms":["Linux"]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The resource-server half of DPoP: given the "},{"type":"codeVoice","code":"DPoP"},{"type":"text","text":" header a caller presented, decide"},{"type":"text","text":" "},{"type":"text","text":"whether it proves possession for "},{"type":"strong","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" request and "},{"type":"strong","inlineContent":[{"type":"text","text":"this"}]},{"type":"text","text":" access token, and return"},{"type":"text","text":" "},{"type":"text","text":"the key thumbprint that "},{"type":"codeVoice","code":"AxiamRequestAuthenticator\/verifyTokenBinding(_:proofs:)"},{"type":"text","text":" then"},{"type":"text","text":" "},{"type":"text","text":"matches against the token’s "},{"type":"codeVoice","code":"cnf.jkt"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Why-this-lives-in-the-SDK","text":"Why this lives in the SDK"},{"type":"paragraph","inlineContent":[{"type":"text","text":"§21.7.2 is a ten-check list, and the contract is blunt about partial implementations:"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“Partial verification is worse than none, because it produces a guard that reports"},{"type":"text","text":" "},{"type":"text","text":"success.”"}]},{"type":"text","text":" Nine of the ten look optional until someone builds an attack out of the one"},{"type":"text","text":" "},{"type":"text","text":"that was skipped, so they belong in one audited place rather than in every application"},{"type":"text","text":" "},{"type":"text","text":"guarding an endpoint."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The two most often missing: "},{"code":"typ","type":"codeVoice"},{"type":"text","text":" — without pinning it to "},{"code":"dpop+jwt","type":"codeVoice"},{"type":"text","text":", any "},{"type":"emphasis","inlineContent":[{"text":"other","type":"text"}]},{"type":"text","text":" JWT"},{"type":"text","text":" "},{"type":"text","text":"signed by the same key (an access token, an ID token) is replayable as a proof; and"},{"type":"text","text":" "},{"code":"ath","type":"codeVoice"},{"type":"text","text":" — without it, a proof captured on one request can be re-aimed at a different token"},{"type":"text","text":" "},{"type":"text","text":"held by the same key."}]},{"type":"heading","level":2,"anchor":"The-algorithm-comes-from-the-key-never-from-the-header","text":"The algorithm comes from the key, never from the header"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"alg: none"},{"type":"text","text":" and RSA-public-key-as-HMAC-secret are the same bug wearing different clothes:"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"the token told the verifier how to check the token"}]},{"type":"text","text":". This enum dispatches on the"},{"type":"text","text":" "},{"type":"text","text":"embedded key’s own "},{"type":"codeVoice","code":"kty"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"crv"},{"type":"text","text":", so an HMAC path is never reachable no matter what the"},{"type":"text","text":" "},{"type":"text","text":"header says."}]}],"kind":"content"}],"metadata":{"modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DpopVerifier","kind":"identifier"}],"navigatorTitle":[{"text":"DpopVerifier","kind":"identifier"}],"role":"symbol","roleHeading":"Enumeration","title":"DpopVerifier","externalID":"s:8AxiamSDK12DpopVerifierO","symbolKind":"enum"},"abstract":[{"type":"text","text":"DPoP proof verification — CONTRACT.md §21.7.2 (RFC 9449), contract 1.16."}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/DpopVerifier/iatLeeway":{"abstract":[{"text":"§21.7.2 check 7 — the ","type":"text"},{"code":"iat","type":"codeVoice"},{"text":" acceptance window, applied in ","type":"text"},{"inlineContent":[{"text":"both","type":"text"}],"type":"strong"},{"text":" directions.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"iatLeeway"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TimeInterval","preciseIdentifier":"s:10Foundation12TimeIntervala"}],"url":"\/documentation\/axiamsdk\/dpopverifier\/iatleeway","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/iatLeeway","title":"iatLeeway","kind":"symbol","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{