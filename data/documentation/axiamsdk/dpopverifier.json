{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"text":"DPoP proof verification — CONTRACT.md §21.7.2 (RFC 9449), contract 1.16.","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/axiamsdk\/dpopverifier"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DpopVerifier"}],"navigatorTitle":[{"kind":"identifier","text":"DpopVerifier"}],"externalID":"s:8AxiamSDK12DpopVerifierO","symbolKind":"enum","roleHeading":"Enumeration","modules":[{"name":"AxiamSDK"}],"role":"symbol","title":"DpopVerifier"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DpopVerifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The resource-server half of DPoP: given the ","type":"text"},{"type":"codeVoice","code":"DPoP"},{"text":" header a caller presented, decide","type":"text"},{"text":" ","type":"text"},{"text":"whether it proves possession for ","type":"text"},{"inlineContent":[{"text":"this","type":"text"}],"type":"strong"},{"text":" request and ","type":"text"},{"inlineContent":[{"text":"this","type":"text"}],"type":"strong"},{"text":" access token, and return","type":"text"},{"text":" ","type":"text"},{"text":"the key thumbprint that ","type":"text"},{"type":"codeVoice","code":"AxiamRequestAuthenticator\/verifyTokenBinding(_:proofs:)"},{"text":" then","type":"text"},{"text":" ","type":"text"},{"text":"matches against the token’s ","type":"text"},{"type":"codeVoice","code":"cnf.jkt"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Why-this-lives-in-the-SDK","level":2,"text":"Why this lives in the SDK","type":"heading"},{"inlineContent":[{"text":"§21.7.2 is a ten-check list, and the contract is blunt about partial implementations:","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"“Partial verification is worse than none, because it produces a guard that reports"},{"type":"text","text":" "},{"type":"text","text":"success.”"}],"type":"emphasis"},{"text":" Nine of the ten look optional until someone builds an attack out of the one","type":"text"},{"text":" ","type":"text"},{"text":"that was skipped, so they belong in one audited place rather than in every application","type":"text"},{"text":" ","type":"text"},{"text":"guarding an endpoint.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The two most often missing: "},{"type":"codeVoice","code":"typ"},{"type":"text","text":" — without pinning it to "},{"type":"codeVoice","code":"dpop+jwt"},{"type":"text","text":", any "},{"type":"emphasis","inlineContent":[{"type":"text","text":"other"}]},{"type":"text","text":" JWT"},{"type":"text","text":" "},{"type":"text","text":"signed by the same key (an access token, an ID token) is replayable as a proof; and"},{"type":"text","text":" "},{"type":"codeVoice","code":"ath"},{"type":"text","text":" — without it, a proof captured on one request can be re-aimed at a different token"},{"type":"text","text":" "},{"type":"text","text":"held by the same key."}],"type":"paragraph"},{"anchor":"The-algorithm-comes-from-the-key-never-from-the-header","level":2,"text":"The algorithm comes from the key, never from the header","type":"heading"},{"inlineContent":[{"code":"alg: none","type":"codeVoice"},{"text":" and RSA-public-key-as-HMAC-secret are the same bug wearing different clothes:","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"the token told the verifier how to check the token"}],"type":"emphasis"},{"text":". This enum dispatches on the","type":"text"},{"text":" ","type":"text"},{"text":"embedded key’s own ","type":"text"},{"code":"kty","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"crv","type":"codeVoice"},{"text":", so an HMAC path is never reachable no matter what the","type":"text"},{"text":" ","type":"text"},{"text":"header says.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/Request"],"title":"Structures"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/iatLeeway"],"title":"Type Properties"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/accessTokenHash(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/canonicalHtu(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/thumbprintS256(_:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/verifyProof(_:request:jtiStore:)"],"title":"Type Methods"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/DpopVerifier/thumbprintS256(_:)":{"title":"thumbprintS256(_:)","abstract":[{"text":"Compute the RFC 7638 SHA-256 thumbprint of a JWK — the ","type":"text"},{"type":"codeVoice","code":"jkt"},{"text":".","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"thumbprintS256","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"]) ","kind":"text"},{"text":"throws","kind":"keyword"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"type":"topic","url":"\/documentation\/axiamsdk\/dpopverifier\/thumbprints256(_:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DpopVerifier\/thumbprintS256(_:)"},"doc://AxiamSDK/document