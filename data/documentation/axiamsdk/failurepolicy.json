{"sections":[],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableMetatypeP"]}],"metadata":{"role":"symbol","symbolKind":"enum","externalID":"s:8AxiamSDK13FailurePolicyO","roleHeading":"Enumeration","navigatorTitle":[{"kind":"identifier","text":"FailurePolicy"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FailurePolicy","kind":"identifier"}],"title":"FailurePolicy","modules":[{"name":"AxiamSDK"}]},"topicSections":[{"generated":true,"title":"Enumeration Cases","anchor":"Enumeration-Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/FailurePolicy\/failClosed","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/FailurePolicy\/failOpen","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/FailurePolicy\/unknown"]},{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/FailurePolicy\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/FailurePolicy\/init(rawValue:)"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/FailurePolicy\/encode(to:)"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/FailurePolicy\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/FailurePolicy\/RawRepresentable-Implementations"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FailurePolicy"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"An ","type":"text"},{"inlineContent":[{"text":"open","type":"text"}],"type":"strong"},{"text":" enum. A value this SDK’s copy of the spec does not list decodes to ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there","type":"text"},{"text":" ","type":"text"},{"text":"fails the WHOLE response, so one field of one record would take down the page it was on,","type":"text"},{"text":" ","type":"text"},{"text":"including the records the caller did ask for.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" is never written: "},{"code":"encode(to:)","type":"codeVoice"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"code":"\"\"","type":"codeVoice"},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" over these cases needs an "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/axiamsdk\/failurepolicy"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/doc