e":"text"},{"text":"clamped to the tenant’s current cap (design note §3.4) and ","type":"text"},{"code":"Idle-Timeout","type":"codeVoice"},{"text":" kept within it.","type":"text"}],"role":"symbol","url":"\/documentation\/axiamsdk\/networkreplyprofile"},"doc://AxiamSDK/documentation/AxiamSDK/NetworkApi":{"kind":"symbol","url":"\/documentation\/axiamsdk\/networkapi","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NetworkApi","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A tenant’s network segments and the RADIUS reply profile each owns (RADIUS Live profile): a"},{"type":"text","text":" "},{"type":"text","text":"segment is a node of the reserved \/network subtree of the resource tree (kind, VLAN,"},{"type":"text","text":" "},{"type":"text","text":"Filter-Id envelope, placement rank), and its profile is the typed "},{"type":"codeVoice","code":"axiam-radius-reply\/1"},{"text":" ","type":"text"},{"text":"record a decision renders. Every write is conditional on the ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" the caller read and","type":"text"},{"text":" ","type":"text"},{"text":"passes the server’s write gate. The tenant’s Session-Timeout cap is one more row of it","type":"text"},{"text":" ","type":"text"},{"text":"(get_policy, replace_policy): lowering it is always allowed, raising it is allowed and","type":"text"},{"text":" ","type":"text"},{"text":"audited. The decision route FreeRADIUS calls is not in this registry.","type":"text"}],"navigatorTitle":[{"text":"NetworkApi","kind":"identifier"}],"title":"NetworkApi","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkApi"}}}