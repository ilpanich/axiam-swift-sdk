stract":[{"type":"text","text":"A tenant’s network segments and the RADIUS reply profile each owns (RADIUS Live profile): a"},{"type":"text","text":" "},{"type":"text","text":"segment is a node of the reserved \/network subtree of the resource tree (kind, VLAN,"},{"type":"text","text":" "},{"type":"text","text":"Filter-Id envelope, placement rank), and its profile is the typed "},{"type":"codeVoice","code":"axiam-radius-reply\/1"},{"type":"text","text":" "},{"type":"text","text":"record a decision renders. Every write is conditional on the "},{"type":"codeVoice","code":"version"},{"type":"text","text":" the caller read and"},{"type":"text","text":" "},{"text":"passes the server’s write gate. The tenant’s Session-Timeout cap is one more row of it","type":"text"},{"text":" ","type":"text"},{"text":"(get_policy, replace_policy): lowering it is always allowed, raising it is allowed and","type":"text"},{"text":" ","type":"text"},{"text":"audited. The decision route FreeRADIUS calls is not in this registry.","type":"text"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/NetworkReplyProfile":{"kind":"symbol","abstract":[{"type":"text","text":"A segment’s reply profile as read: "},{"type":"strong","inlineContent":[{"type":"text","text":"the effective one"}]},{"type":"text","text":", with the "},{"code":"Session-Timeout","type":"codeVoice"},{"type":"text","text":" already"},{"type":"text","text":" "},{"type":"text","text":"clamped to the tenant’s current cap (design note §3.4) and "},{"code":"Idle-Timeout","type":"codeVoice"},{"type":"text","text":" kept within it."}],"navigatorTitle":[{"kind":"identifier","text":"NetworkReplyProfile"}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NetworkReplyProfile"}],"title":"NetworkReplyProfile","url":"\/documentation\/axiamsdk\/networkreplyprofile","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkReplyProfile"}}}