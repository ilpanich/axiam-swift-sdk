NetworkApi","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkApi","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A tenant’s network segments and the RADIUS reply profile each owns (RADIUS Live profile): a"},{"type":"text","text":" "},{"type":"text","text":"segment is a node of the reserved \/network subtree of the resource tree (kind, VLAN,"},{"type":"text","text":" "},{"type":"text","text":"Filter-Id envelope, placement rank), and its profile is the typed "},{"type":"codeVoice","code":"axiam-radius-reply\/1"},{"type":"text","text":" "},{"type":"text","text":"record a decision renders. Every write is conditional on the "},{"type":"codeVoice","code":"version"},{"type":"text","text":" the caller read and"},{"type":"text","text":" "},{"type":"text","text":"passes the server’s write gate. The tenant’s Session-Timeout cap is one more row of it"},{"type":"text","text":" "},{"type":"text","text":"(get_policy, replace_policy): lowering it is always allowed, raising it is allowed and"},{"type":"text","text":" "},{"type":"text","text":"audited. The decision route FreeRADIUS calls is not in this registry."}]},"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/NetworkApi/getPolicy()":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/NetworkApi\/getPolicy()","role":"symbol","url":"\/documentation\/axiamsdk\/networkapi\/getpolicy()","abstract":[{"code":"GET \/api\/v1\/network\/policy","type":"codeVoice"}],"kind":"symbol","type":"topic","title":"getPolicy()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"getPolicy","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyw