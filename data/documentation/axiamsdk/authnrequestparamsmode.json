{"variants":[{"paths":["\/documentation\/axiamsdk\/authnrequestparamsmode"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","interfaceLanguage":"swift"},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"AuthnRequestParamsMode"}],"role":"symbol","externalID":"s:8AxiamSDK22AuthnRequestParamsModeO","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthnRequestParamsMode"}],"title":"AuthnRequestParamsMode","symbolKind":"enum","modules":[{"name":"AxiamSDK"}],"roleHeading":"Enumeration"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthnRequestParamsMode"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"An ","type":"text"},{"inlineContent":[{"type":"text","text":"open"}],"type":"strong"},{"text":" enum. A value this SDK’s copy of the spec does not list decodes to ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there","type":"text"},{"text":" ","type":"text"},{"text":"fails the WHOLE response, so one field of one record would take down the page it was on,","type":"text"},{"text":" ","type":"text"},{"text":"including the records the caller did ask for.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"text","text":"carrying an unrecognised value back into an update is refused by the server rather than"},{"type":"text","text":" "},{"type":"text","text":"written as a spelling it never used. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Whether this client’s authorization requests may carry OpenID Connect’s"},{"type":"text","text":" "},{"type":"text","text":"authentication-request parameters, or whether they are ignored (X7.1). The bundle this"},{"type":"text","text":" "},{"type":"text","text":"governs is "},{"code":"prompt","type":"codeVoice"},{"type":"text","text":", "},{"code":"max_age","type":"codeVoice"},{"type":"text","text":", "},{"code":"acr_values","type":"codeVoice"},{"type":"text","text":", "},{"code":"claims","type":"codeVoice"},{"type":"text","text":", "},{"code":"id_token_hint","type":"codeVoice"},{"type":"text","text":", "},{"code":"login_hint","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"display","type":"codeVoice"},{"type":"text","text":", "},{"code":"ui_locales","type":"codeVoice"},{"type":"text","text":" and "},{"code":"claims_locales","type":"codeVoice"},{"type":"text","text":". It is "},{"inlineContent":[{"text":"one","type":"text"}],"type":"strong"},{"type":"text","text":" field rather than nine booleans"},{"type":"text","text":" "},{"type":"text","text":"for the same reason ["},{"code":"ClientProfile","type":"codeVoice"},{"type":"text","text":"] is one field rather than a dozen: a client that"},{"type":"text","text":" "},{"type":"text","text":"honours "},{"code":"max_age","type":"code