e":"topic","url":"\/documentation\/axiamsdk\/policyresponse\/mincertification","title":"minCertification","abstract":[{"text":"The server’s ","type":"text"},{"code":"min_certification","type":"codeVoice"},{"text":" field.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"minCertification"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CertificationLevel","preciseIdentifier":"s:8AxiamSDK18CertificationLevelO"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse\/minCertification","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/CertificationLevel":{"url":"\/documentation\/axiamsdk\/certificationlevel","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CertificationLevel","kind":"identifier"}],"abstract":[{"text":"FIDO certification level, as recorded in an MDS ","type":"text"},{"code":"statusReports","type":"codeVoice"},{"text":" entry’s ","type":"text"},{"code":"FIDO_CERTIFIED*","type":"codeVoice"},{"text":" ","type":"text"},{"text":"status. Variant order is significant: ","type":"text"},{"code":"derive(PartialOrd, Ord)","type":"codeVoice"},{"text":" gives ","type":"text"},{"code":"L1 < L1Plus < L2 < L2Plus < L3 < L3Plus","type":"codeVoice"},{"text":", which ","type":"text"},{"code":"WebauthnAttestationPolicy::evaluate","type":"codeVoice"},{"text":" (D8 step 9) relies on","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"directly for the "},{"type":"codeVoice","code":"min_certification"},{"text":" boundary check (","type":"text"},{"code":"entry_level >= policy_min","type":"codeVoice"},{"text":").","type":"text"}],"type":"topic","navigatorTitle":[{"text":"CertificationLevel","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CertificationLevel","role":"symbol","title":"CertificationLevel"},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PolicyResponse"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PolicyResponse"}],"title":"PolicyResponse","url":"\/documentation\/axiamsdk\/policyresponse","abstract":[{"type":"codeVoice","code":"GET"},{"type":"text","text":" response: the stored policy plus the unknown-AAGUID action it currently "},{"type":"emphasis","inlineContent":[{"text":"resolves to","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"unknown_aaguid"},{"type":"text","text":" is nullable, where "},{"type":"codeVoice","code":"null"},{"type":"text","text":" means “use this mode’s default” (deny under"},{"type":"text","text":" "},{"type":"codeVoice","code":"direct_required"},{"type":"text","text":", allow otherwise). A client that only saw the stored "},{"code":"null","type":"codeVoice"},{"text":" would have to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"re-derive that rule itself to display what the policy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}]}}}