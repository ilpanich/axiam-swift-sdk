text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}],"title":"PolicyResponse","type":"topic","url":"\/documentation\/axiamsdk\/policyresponse","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse","navigatorTitle":[{"text":"PolicyResponse","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"PolicyResponse","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/UnknownAaguidAction":{"title":"UnknownAaguidAction","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UnknownAaguidAction","navigatorTitle":[{"text":"UnknownAaguidAction","kind":"identifier"}],"abstract":[{"type":"text","text":"What to do with an AAGUID that has no MDS entry (i.e. FIDO Alliance has no metadata for it —"},{"type":"text","text":" "},{"type":"text","text":"not necessarily malicious, MDS coverage is incomplete for some legitimate authenticators)."}],"url":"\/documentation\/axiamsdk\/unknownaaguidaction","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"UnknownAaguidAction","kind":"identifier"}],"type":"topic"}}}