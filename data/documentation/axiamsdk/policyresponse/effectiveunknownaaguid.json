d","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnknownAaguidAction"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","title":"AxiamSDK","role":"collection","kind":"symbol","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse/effectiveUnknownAaguid":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"effectiveUnknownAaguid","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UnknownAaguidAction","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK19UnknownAaguidActionO"}],"title":"effectiveUnknownAaguid","abstract":[{"text":"The action actually applied to an AAGUID with no MDS metadata, with ","type":"text"},{"type":"codeVoice","code":"unknown_aaguid: null"},{"text":" resolved against ","type":"text"},{"type":"codeVoice","code":"mode"},{"text":". Read-only — ","type":"text"},{"type":"codeVoice","code":"PUT"},{"text":" ignores it.","type":"text"}],"kind":"symbol","url":"\/documentation\/axiamsdk\/policyresponse\/effectiveunknownaaguid","type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse\/effectiveUnknownAaguid"}}}