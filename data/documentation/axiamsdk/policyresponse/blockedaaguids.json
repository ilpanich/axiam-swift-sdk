ids","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse\/blockedAaguids"},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PolicyResponse"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse","abstract":[{"code":"GET","type":"codeVoice"},{"text":" response: the stored policy plus the unknown-AAGUID action it currently ","type":"text"},{"inlineContent":[{"text":"resolves to","type":"text"}],"type":"emphasis"},{"type":"text","text":"."},{"text":" ","type":"text"},{"code":"unknown_aaguid","type":"codeVoice"},{"type":"text","text":" is nullable, where "},{"code":"null","type":"codeVoice"},{"type":"text","text":" means “use this mode’s default” (deny under"},{"type":"text","text":" "},{"code":"direct_required","type":"codeVoice"},{"type":"text","text":", allow otherwise). A client that only saw the stored "},{"code":"null","type":"codeVoice"},{"type":"text","text":" would have to"},{"type":"text","text":" "},{"type":"text","text":"re-derive that rule itself to display what the policy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PolicyResponse","kind":"identifier"}],"title":"PolicyResponse","url":"\/documentation\/axiamsdk\/policyresponse","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","role":"collection","type":"topic","url":"\/documentation\/axiamsdk"}}}