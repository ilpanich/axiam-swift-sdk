Voice"},{"type":"text","text":" field."}],"kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockedAaguids"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]?"}],"url":"\/documentation\/axiamsdk\/policyresponse\/blockedaaguids","type":"topic","title":"blockedAaguids"},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PolicyResponse"}],"title":"PolicyResponse","url":"\/documentation\/axiamsdk\/policyresponse","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PolicyResponse"}],"abstract":[{"code":"GET","type":"codeVoice"},{"type":"text","text":" response: the stored policy plus the unknown-AAGUID action it currently "},{"inlineContent":[{"type":"text","text":"resolves to"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"code":"unknown_aaguid","type":"codeVoice"},{"type":"text","text":" is nullable, where "},{"code":"null","type":"codeVoice"},{"type":"text","text":" means “use this mode’s default” (deny under"},{"type":"text","text":" "},{"code":"direct_required","type":"codeVoice"},{"type":"text","text":", allow otherwise). A client that only saw the stored "},{"code":"null","type":"codeVoice"},{"type":"text","text":" would have to"},{"type":"text","text":" "},{"type":"text","text":"re-derive that rule itself to display what the policy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}]}}}