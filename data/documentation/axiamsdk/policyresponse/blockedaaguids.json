/policyresponse\/blockedaaguids","abstract":[{"type":"text","text":"The server’s "},{"type":"codeVoice","code":"blocked_aaguids"},{"type":"text","text":" field."}],"fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"blockedAaguids","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PolicyResponse"}],"type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse","url":"\/documentation\/axiamsdk\/policyresponse","title":"PolicyResponse","abstract":[{"code":"GET","type":"codeVoice"},{"type":"text","text":" response: the stored policy plus the unknown-AAGUID action it currently "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resolves to"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"code":"unknown_aaguid","type":"codeVoice"},{"type":"text","text":" is nullable, where "},{"code":"null","type":"codeVoice"},{"type":"text","text":" means “use this mode’s default” (deny under"},{"type":"text","text":" "},{"code":"direct_required","type":"codeVoice"},{"type":"text","text":", allow otherwise). A client that only saw the stored "},{"code":"null","type":"codeVoice"},{"type":"text","text":" would have to"},{"type":"text","text":" "},{"type":"text","text":"re-derive that rule itself to display what the policy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}],"navigatorTitle":[{"kind":"identifier","text":"PolicyResponse"}]}}}