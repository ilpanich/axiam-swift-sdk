 "},{"type":"text","text":"re-derive that rule itself to display what the policy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse"},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse/init(allowedAaguids:blockRevokedStatus:blockedAaguids:minCertification:mode:requireFidoCertified:unknownAaguid:effectiveUnknownAaguid:)":{"title":"init(allowedAaguids:blockRevokedStatus:blockedAaguids:minCertification:mode:requireFidoCertified:unknownAaguid:effectiveUnknownAaguid:)","kind":"symbol","url":"\/documentation\/axiamsdk\/policyresponse\/init(allowedaaguids:blockrevokedstatus:blockedaaguids:mincertification:mode:requirefidocertified:unknownaaguid:effectiveunknownaaguid:)","abstract":[],"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"allowedAaguids"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"blockRevokedStatus"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"blockedAaguids"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"minCertification"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CertificationLevel","preciseIdentifier":"s:8AxiamSDK18CertificationLevelO"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"mode"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AttestationMod