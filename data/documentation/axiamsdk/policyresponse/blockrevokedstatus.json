{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/policyresponse\/blockrevokedstatus"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse\/blockRevokedStatus","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockRevokedStatus"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"languages":["swift"]}]}],"abstract":[{"type":"text","text":"Deny registration if the MDS entry has ever reported "},{"code":"REVOKED","type":"codeVoice"},{"type":"text","text":" or any "},{"code":"*_COMPROMISE","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"status (sticky — D8 step 7)."}],"metadata":{"roleHeading":"Instance Property","title":"blockRevokedStatus","symbolKind":"property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockRevokedStatus","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"externalID":"s:8AxiamSDK14PolicyResponseV18blockRevokedStatusSbvp","modules":[{"name":"AxiamSDK"}]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse/blockRevokedStatus":{"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockRevokedStatus"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse\/blockRevokedStatus","url":"\/documentation\/axiamsdk\/policyresponse\/blockrevokedstatus","title":"blockRevokedStatus","abstract":[{"type":"text","text":"Deny registration if the MDS entry has ever reported "},{"code":"REVOKED","type":"codeVoice"},{"type":"text","text":" or any "},{"code":"*_COMPROMISE","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"status (sticky — D8 step 7)."}]},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PolicyResponse"}],"type":"topic","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse","url":"\/documentation\/axiamsdk\/policyresponse","title":"PolicyResponse","abstract":[{"code":"GET","type":"codeVoice"},{"type":"text","text":" response: the stored policy plus the unknown-AAGUID action it currently "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resolves to"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"code":"unknown_aaguid","type":"codeVoice"},{"type":"text","text":" is nullable, where "},{"code":"null","type":"codeVoice"},{"type":"text","text":" means “use this mode’s default” (deny under"},{"type":"text","text":" "},{"code":"direct_required","type":"codeVoice"},{"type":"text","text":", allow otherwise). A client that only saw the stored "},{"code":"null","type":"codeVoice"},{"type":"text","text":" would have to"},{"type":"text","text":" "},{"type":"text","text":"re-derive that rule itself to display what the policy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}],"navigatorTitle":[{"kind":"identifier","text":"PolicyResponse"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"}}}