bol","title":"blockRevokedStatus","url":"\/documentation\/axiamsdk\/policyresponse\/blockrevokedstatus","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockRevokedStatus"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse":{"url":"\/documentation\/axiamsdk\/policyresponse","role":"symbol","type":"topic","title":"PolicyResponse","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PolicyResponse","kind":"identifier"}],"navigatorTitle":[{"text":"PolicyResponse","kind":"identifier"}],"abstract":[{"code":"GET","type":"codeVoice"},{"text":" response: the stored policy plus the unknown-AAGUID action it currently ","type":"text"},{"inlineContent":[{"text":"resolves to","type":"text"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"unknown_aaguid"},{"type":"text","text":" is nullable, where "},{"type":"codeVoice","code":"null"},{"type":"text","text":" means “use this mode’s default” (deny under"},{"type":"text","text":" "},{"type":"codeVoice","code":"direct_required"},{"type":"text","text":", allow otherwise). A client that only saw the stored "},{"type":"codeVoice","code":"null"},{"type":"text","text":" would have to"},{"type":"text","text":" "},{"type":"text","text":"re-derive that rule itself to display what the policy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"