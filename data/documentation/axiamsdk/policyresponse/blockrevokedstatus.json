e","code":"GET"},{"type":"text","text":" response: the stored policy plus the unknown-AAGUID action it currently "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resolves to"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"unknown_aaguid"},{"type":"text","text":" is nullable, where "},{"type":"codeVoice","code":"null"},{"type":"text","text":" means “use this mode’s default” (deny under"},{"type":"text","text":" "},{"type":"codeVoice","code":"direct_required"},{"type":"text","text":", allow otherwise). A client that only saw the stored "},{"type":"codeVoice","code":"null"},{"type":"text","text":" would have to"},{"type":"text","text":" "},{"type":"text","text":"re-derive that rule itself to display what the policy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}]},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse/blockRevokedStatus":{"url":"\/documentation\/axiamsdk\/policyresponse\/blockrevokedstatus","type":"topic","abstract":[{"text":"Deny registration if the MDS entry has ever reported ","type":"text"},{"code":"REVOKED","type":"codeVoice"},{"text":" or any ","type":"text"},{"code":"*_COMPROMISE","type":"codeVoice"},{"text":" ","type":"text"},{"text":"status (sticky — D8 step 7).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse\/blockRevokedStatus","title":"blockRevokedStatus","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockRevokedStatus","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"}}}