GUID that has no MDS entry (i.e. FIDO Alliance has no metadata for it —"},{"type":"text","text":" "},{"type":"text","text":"not necessarily malicious, MDS coverage is incomplete for some legitimate authenticators)."}]},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse/unknownAaguid":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse\/unknownAaguid","abstract":[{"type":"text","text":"The server’s "},{"type":"codeVoice","code":"unknown_aaguid"},{"type":"text","text":" field."}],"url":"\/documentation\/axiamsdk\/policyresponse\/unknownaaguid","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknownAaguid"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK19UnknownAaguidActionO","text":"UnknownAaguidAction"},{"kind":"text","text":"?"}],"role":"symbol","title":"unknownAaguid","kind":"symbol"}}}