:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse\/mode"},"doc://AxiamSDK/documentation/AxiamSDK/AttestationMode":{"navigatorTitle":[{"kind":"identifier","text":"AttestationMode"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttestationMode","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AttestationMode"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"What attestation conveyance a registration ceremony requests, and whether the policy is"},{"type":"text","text":" "},{"type":"text","text":"enforced at all. "},{"code":"None","type":"codeVoice"},{"type":"text","text":" is the default and reproduces today’s behavior byte-for-byte:"},{"type":"text","text":" "},{"code":"evaluate","type":"codeVoice"},{"type":"text","text":" allows every registration unconditionally, with no MDS lookup (D8 step 1)."}],"title":"AttestationMode","kind":"symbol","url":"\/documentation\/axiamsdk\/attestationmode"},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse":{"type":"topic","title":"PolicyResponse","navigatorTitle":[{"text":"PolicyResponse","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse","url":"\/documentation\/axiamsdk\/policyresponse","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PolicyResponse","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"codeVoice","code":"GET"},{"type":"text","text":" response: the stored policy plus the unknown-AAGUID action it currently "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resolves to"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"unknown_aaguid"},{"type":"text","text":" is nullable, where "},{"type":"codeVoice","code":"null"},{"type":"text","text":" means “use this mode’s default” (deny under"},{"type":"text","text":" "},{"type":"codeVoice","code":"direct_required"},{"type":"text","text":", allow otherwise). A client that only saw the stored "},{"type":"codeVoice","code":"null"},{"type":"text","text":" would have to"},{"type":"text","text":" "},{"type":"text","text":"re-derive that rule itself to display what the policy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"}}}