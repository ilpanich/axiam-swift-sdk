xt":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Encoder","preciseIdentifier":"s:s7EncoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse\/encode(to:)","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/PolicyResponse":{"kind":"symbol","abstract":[{"type":"codeVoice","code":"GET"},{"type":"text","text":" response: the stored policy plus the unknown-AAGUID action it currently "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resolves to"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"unknown_aaguid"},{"type":"text","text":" is nullable, where "},{"type":"codeVoice","code":"null"},{"type":"text","text":" means “use this mode’s default” (deny under"},{"type":"text","text":" "},{"type":"codeVoice","code":"direct_required"},{"type":"text","text":", allow otherwise). A client that only saw the stored "},{"type":"codeVoice","code":"null"},{"type":"text","text":" would have to"},{"type":"text","text":" "},{"type":"text","text":"re-derive that rule itself to display what the policy actually does — and a security rule"},{"type":"text","text":" "},{"type":"text","text":"implemented twice is a security rule that will eventually disagree with itself. So the"},{"type":"text","text":" "},{"type":"text","text":"server resolves it once, here, and reports both: the admin’s stored intent and its effect."}],"title":"PolicyResponse","type":"topic","url":"\/documentation\/axiamsdk\/policyresponse","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/PolicyResponse","navigatorTitle":[{"text":"PolicyResponse","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"PolicyResponse","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","title":"AxiamSDK","abstract":[{"text":"T