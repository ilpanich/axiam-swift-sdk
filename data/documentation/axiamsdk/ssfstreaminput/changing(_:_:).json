{"abstract":[{"text":"The ","type":"text"},{"type":"strong","inlineContent":[{"text":"change-taking read-modify-write form","type":"text"}]},{"text":" for ","type":"text"},{"type":"codeVoice","code":"ssf.update_stream"},{"text":" (contract 1.62,","type":"text"},{"text":" ","type":"text"},{"text":"CONTRACT.md §32.2): ","type":"text"},{"type":"codeVoice","code":"(stream, changes) → body"},{"text":". Hand it the stream you read and a closure","type":"text"},{"text":" ","type":"text"},{"text":"that edits the copy; it returns the replacement body.","type":"text"}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"changing","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SsfStream","preciseIdentifier":"s:8AxiamSDK9SsfStreamV","kind":"typeIdentifier"},{"text":", (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SsfStreamInput","preciseIdentifier":"s:8AxiamSDK14SsfStreamInputV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"SsfStreamInput","preciseIdentifier":"s:8AxiamSDK14SsfStreamInputV","kind":"typeIdentifier"}],"title":"changing(_:_:)","extendedModule":"AxiamSDK","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK14SsfStreamInputV8changingyAcA0cD0V_yACzKXEtKFZ","role":"symbol","symbolKind":"method","roleHeading":"Type Method"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamInput"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/ssfstreaminput\/changing(_:_:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"changing"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"stream"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStream","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK9SsfStreamV","text":"SsfStream"},{"kind":"text","text":", "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"changes"},{"kind":"text","text":": ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamInput","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK14SsfStreamInputV","text":"SsfStreamInput"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamInput","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK14SsfStreamInputV","text":"SsfStreamInput"}]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"codeListing","code":["let stream = try await client.ssf.getStream(streamID: id)","let body = SsfStreamInput.changing(stream) { $0.eventsAllowed = [.sessionRevoked] }","_ = try await client.ssf.updateStream(streamID: id, body: body)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"What the body carries, and why each point is a rule rather than a convenience:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"eventsRequested","type":"codeVoice"},{"type":"text","text":", as read."}]},{"type":"text","text":" An update that omits it "},{"type":"emphasis","inlineContent":[{"text":"resets","type":"text"}]},{"type":"text","text":" the stream to every"},{"type":"text","text":" "},{"type":"text","text":"event of "},{"code":"eventsAllowed","type":"codeVoice"},{"type":"text","text":", widening what the receiver narrowed, and AXIAM then sends the"},{"type":"text","text":" "},{"type":"text","text":"receiver more events about the tenant’s users than it asked for. The read list goes back"},{"type":"text","text":" "},{"type":"text","text":"as it was; an "},{"code":"[]","type":"codeVoice"},{"type":"text","text":" (the receiver’s “none”) goes back as "},{"code":"[]","type":"codeVoice"},{"type":"text","text":" and is never omitted."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Cut to the new ceiling.","type":"text"}]},{"type":"text","text":" When "},{"type":"codeVoice","code":"changes"},{"type":"text","text":" lowers "},{"type":"codeVoice","code":"eventsAllowed"},{"type":"text","text":" and does not name"},{"type":"text","text":" "},{"type":"codeVoice","code":"eventsRequested"},{"type":"text","text":", the requested list becomes the entries of the read list that are in"},{"type":"text","text":" "},{"type":"text","text":"the new "},{"type":"codeVoice","code":"eventsAllowed"},{"type":"text","text":", in their order (a request outside the ceiling is "},{"type":"codeVoice","code":"400"},{"type":"text","text":"). An"},{"type":"text","text":" "},{"type":"codeVoice","code":"eventsRequested"},{"type":"text","text":" that "},{"type":"codeVoice","code":"changes"},{"type":"text","text":" sets to anything other than what was read — a list, "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" (absent: a reset) — is sent as given: the server judges it. Setting it to the"},{"type":"text","text":" "},{"type":"text","text":"very value that was read is the same as not naming it, and is cut like the rest. This"},{"type":"text","text":" "},{"type":"text","text":"differs from §32.2 read literally, which would send a value set to the one read as"},{"type":"text","text":" "},{"type":"text","text":"given (the server then answering "},{"type":"codeVoice","code":"400"},{"type":"text","text":" if it lies outside the new ceiling): here the"},{"type":"text","text":" "},{"type":"text","text":"cut is applied instead, which is benign. To send the read list uncut, build the body"},{"type":"text","text":" "},{"type":"text","text":"with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamInput\/init(copying:)"},{"type":"text","text":" and edit it yourself."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"expectedUpdatedAt"},{"text":", as read.","type":"text"}]},{"type":"text","text":" The "},{"type":"codeVoice","code":"updatedAt"},{"type":"text","text":" string of the stream you read, byte for"},{"type":"text","text":" "},{"type":"text","text":"byte — never parsed and rendered again, because the comparison is of the instant and a"},{"type":"text","text":" "},{"type":"text","text":"timestamp rounded to fewer fraction digits than the server stored does not match. The"},{"type":"text","text":" "},{"type":"text","text":"update then lands only on the version you read, and a write made since (the receiver’s"},{"type":"text","text":" "},{"type":"text","text":"own included) answers "},{"type":"codeVoice","code":"409"},{"type":"text","text":" ("},{"type":"codeVoice","code":"ConflictError"},{"type":"text","text":", never retried): read again and decide"},{"type":"text","text":" "},{"type":"text","text":"again. Setting it to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" in "},{"type":"codeVoice","code":"changes"},{"type":"text","text":" is “none”: the key is left out of the body and"},{"type":"text","text":" "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is never sent, which replaces whatever is stored."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The header.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"authorizationHeader"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"clearAuthorizationHeader"},{"text":" start ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" ","type":"text"},{"text":"(absent keeps the stored header, §32.2); set them in ","type":"text"},{"type":"codeVoice","code":"changes"},{"text":" when the update moves","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"endpointURL"},{"text":" to another origin (§32.3 rule 5).","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamInput\/init(copying:)"},{"type":"text","text":" is the plain converter, and the cut is the caller’s duty there."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamInput\/changing(_:_:)"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/SsfStream":{"abstract":[{"type":"text","text":"A registered SSF stream, as the management API returns it. "},{"inlineContent":[{"type":"text","text":"The push "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":" header"},{"type":"text","text":" "},{"type":"text","text":"is never returned"}],"type":"strong"},{"type":"text","text":"; "},{"type":"codeVoice","code":"authorization_header_set"},{"type":"text","text":" says whether one is stored."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SsfStream"}],"type":"topic","role":"symbol","url":"\/documentation\/axiamsdk\/ssfstream","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStream","title":"SsfStream","navigatorTitle":[{"kind":"identifier","text":"SsfStream"}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/SsfStreamInput":{"title":"SsfStreamInput","abstract":[{"code":"create_stream","type":"codeVoice"},{"type":"text","text":" and "},{"code":"update_stream","type":"codeVoice"},{"type":"text","text":" (a "},{"inlineContent":[{"type":"text","text":"replacement"}],"type":"strong"},{"type":"text","text":") body."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SsfStreamInput"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamInput","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SsfStreamInput"}],"role":"symbol","url":"\/documentation\/axiamsdk\/ssfstreaminput"},"doc://AxiamSDK/documentation/AxiamSDK/SsfStreamInput/changing(_:_:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamInput\/changing(_:_:)","url":"\/documentation\/axiamsdk\/ssfstreaminput\/changing(_:_:)","abstract":[{"type":"text","text":"The "},{"inlineContent":[{"type":"text","text":"change-taking read-modify-write form"}],"type":"strong"},{"type":"text","text":" for "},{"code":"ssf.update_stream","type":"codeVoice"},{"type":"text","text":" (contract 1.62,"},{"type":"text","text":" "},{"type":"text","text":"CONTRACT.md §32.2): "},{"type":"codeVoice","code":"(stream, changes) → body"},{"type":"text","text":". Hand it the stream you read and a closure"},{"type":"text","text":" "},{"type":"text","text":"that edits the copy; it returns the replacement body."}],"kind":"symbol","type":"topic","role":"symbol","title":"changing(_:_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"changing","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:8Axiam