{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SsfSubjectFormat","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"strong","inlineContent":[{"text":"open","type":"text"}]},{"type":"text","text":" enum. A value this SDK’s copy of the spec does not list decodes to "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" "},{"type":"text","text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there"},{"type":"text","text":" "},{"type":"text","text":"fails the WHOLE response, so one field of one record would take down the page it was on,"},{"type":"text","text":" "},{"type":"text","text":"including the records the caller did ask for."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" is never written: "},{"code":"encode(to:)","type":"codeVoice"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"code":"\"\"","type":"codeVoice"},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" over these cases needs an "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" arm."}]}]}],"abstract":[{"text":"Which RFC 9493 subject identifier names the user in the SETs of a stream (D-46).","type":"text"}],"variants":[{"paths":["\/documentation\/axiamsdk\/ssfsubjectformat"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"enum","externalID":"s:8AxiamSDK16SsfSubjectFormatO","modules":[{"name":"AxiamSDK"}],"navigatorTitle":[{"text":"SsfSubjectFormat","kind":"identifier"}],"role":"symbol","roleHeading":"Enumeration","title":"SsfSubjectFormat","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SsfSubjectFormat","kind":"identifier"}]},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/email","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/issSub","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/unknown"],"generated":true,"anchor":"Enumeration-Cases"},{"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/init(rawValue:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/encode(to:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/RawRepresentable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat"},"relationshipsSections":[{"kind":"relationships","title":"Confo