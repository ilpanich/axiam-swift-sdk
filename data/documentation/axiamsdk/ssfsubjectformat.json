odeVoice","code":".unknown"},{"type":"text","text":" is never written: "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"type":"codeVoice","code":"\"\""},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Which RFC 9493 subject identifier names the user in the SETs of a stream (D-46)."}],"sections":[],"metadata":{"symbolKind":"enum","externalID":"s:8AxiamSDK16SsfSubjectFormatO","roleHeading":"Enumeration","title":"SsfSubjectFormat","navigatorTitle":[{"text":"SsfSubjectFormat","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SsfSubjectFormat","kind":"identifier"}],"modules":[{"name":"AxiamSDK"}],"role":"symbol"},"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/email","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/issSub","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/unknown"],"title":"Enumeration Cases","generated":true,"anchor":"Enumeration-Cases"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/init(rawValue:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\/encode(to:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfSubjectFormat\