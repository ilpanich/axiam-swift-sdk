{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableMetatypeP"],"type":"conformsTo"}],"topicSections":[{"title":"Enumeration Cases","anchor":"Enumeration-Cases","generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RefreshReuseResponse\/refuse","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RefreshReuseResponse\/revokeSession","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RefreshReuseResponse\/unknown"]},{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RefreshReuseResponse\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RefreshReuseResponse\/init(rawValue:)"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RefreshReuseResponse\/encode(to:)"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RefreshReuseResponse\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RefreshReuseResponse\/RawRepresentable-Implementations"]}],"metadata":{"role":"symbol","title":"RefreshReuseResponse","navigatorTitle":[{"text":"RefreshReuseResponse","kind":"identifier"}],"roleHeading":"Enumeration","symbolKind":"enum","modules":[{"name":"AxiamSDK"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RefreshReuseResponse"}],"externalID":"s:8AxiamSDK20RefreshReuseResponseO"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RefreshReuseResponse"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"revoke_session"},{"text":" — the default (D-N2). The refusal also invalidates the session the","type":"text"},{"text":" ","type":"text"},{"text":"replayed token names (which publishes to the revocation feed) and revokes every refresh","type":"text"},{"text":" ","type":"text"},{"text":"token issued under that session — whichever client it was issued to, the console sign-in","type":"text"},{"text":" ","type":"text"},{"text":"included, with no back-channel logout sent — as the authorization-code replay path does for","type":"text"},{"text":" ","type":"text"},{"text":"a code (RFC 6749 §10.5; OAuth 2.0 Security BCP §4.14.2). Only a presentation by the token’s","type":"text"},{"text":" ","type":"text"},{"text":"own client, passing the token’s sender constraint, triggers it (#821). On a client with no","type":"text"},{"text":" ","type":"text"},{"text":"grace window the honest holder of a replayed token has nothing left to lose — its token is","type":"text"},{"text":" ","type":"text"},{"text":"already dead and it never received the successor — so the revocation costs it nothing and","type":"text"},{"text":" ","type":"text"},{"text":"costs whoever holds the successor everything. * ","type":"text"},{"type":"codeVoice","code":"refuse"},{"text":" — the 1.1.x behaviour: the","type":"text"},{"text":" ","type":"text"},{"text":"presentation is refused, marked on the session and audited, and nothing else is revoked.","type":"text"},{"text":" ","type":"text"},{"text":"Neither value changes what is ","type":"text"},{"inlineContent":[{"text":"accepted","type":"text"}],"type":"emphasis"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"fapi2"},{"text":" client’s presentation inside the grace","type":"text"},{"text":" ","type":"text"},{"text":"window is accepted and marked whatever this says (D-N4); a token revoked at logout is not a","type":"text"},{"text":" ","type":"text"},{"text":"replay and revokes nothing. This text is published as the schema’s description in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"sdks\/openapi.json"},{"text":", so it carries no rustdoc intra-doc links (F4-W1-08, #824).","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"An "},{"type":"strong","inlineContent":[{"text":"open","type":"text"}]},{"type":"text","text":" enum. A value this SDK’s copy of the spec does not list decodes to "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" "},{"type":"text","text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there"},{"type":"text","text":" "},{"type":"text","text":"fails the WHOLE response, so one field of one record would take down the page it was on,"},{"type":"text","text":" "},{"type":"text","text":"including the records the caller did ask for."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is never written: "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" refuses it locally, before any request, as a"},{"type":"text","text":" "},{"type":"text","text":"validation failure (CONTRACT.md §34.2 P12.2, contract 1.60 A4) — never as "},{"type":"codeVoice","code":"\"\""},{"type":"text","text":", never left"},{"type":"text","text":" "},{"type":"text","text":"to the server to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RefreshReuseResponse"},"abstract":[{"text":"What the token endpoint does when a refresh token that has already been rotated is presented","type":"text"},{"text":" ","type":"text"},{"text":"again and ","type":"text"},{"type":"strong","inlineContent":[{"text":"refused","type":"text"}]},{"text":" (G-C, #818 — the T-254 amendment). Two values, ordered by strictness:","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/refreshreuseresponse"]}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/RefreshReuseResponse/init(rawValue:)":{"title":"init(rawValue:)","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RefreshReuseResponse\/init(rawValue:)","url":"\/documentation\/axiamsdk\/refreshreuseresponse\/init(rawvalue:)","kind":"symbol","abstract":[],"fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"rawValue","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/RefreshReuseResponse/refuse":{"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refuse","kind":"identifier"}],"role":"symbol","title":"RefreshReuseResponse.refuse","url":"\/documentation\/axiamsdk\/refreshreuseresponse\/refuse","abstract":[],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/RefreshReuseResponse\/refuse","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/Refre