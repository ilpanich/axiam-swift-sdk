t":".","type":"text"}],"url":"\/documentation\/axiamsdk\/directorykind","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind","title":"DirectoryKind","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectoryKind"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectoryKind"}]},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"title":"Sensitive","role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"url":"\/documentation\/axiamsdk\/sensitive","abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}]},"doc://AxiamSDK/documentation/AxiamSDK/UpdateDirectoryConfig":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig","navigatorTitle":[{"text":"UpdateDirectoryConfig","kind":"identifier"}],"title":"UpdateDirectoryConfig","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateDirectoryConfig","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/updatedirectoryconfig","abstract":[{"type":"codeVoice","code":"PATCH \/api\/v1\/tenants\/{tenant_id}\/directory"},{"type":"text","text":" — a "},{"type":"strong","inlineContent":[{"text":"sparse","type":"text"}]},{"type":"text","text":" update. Every member optional:"},{"type":"text","text":" "},{"text":"absent leaves the stored value, and for the two nullable members an explicit ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" clears","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/UserAttributeMap":{"abstract":[{"text":"Which directory attribute feeds each AXIAM user field.","type":"text"}],"url":"\/documentation\/axiamsdk\/userattributemap","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserAttributeMap","title":"UserAttributeMap","role":"symbol","navigatorTitle":[{"text":"UserAttributeMap","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UserAttributeMap","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"type":"strong","inlineContent":[{"text":"The table is the only","type":"text"},{"text":" ","type":"text"},{"text":"way a directory group reaches an AXIAM group.","type":"text"}]},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"axiam_directory::dn","type":"codeVoice"},{"text":"), so ","type":"text"},{"code":"CN=Staff, OU=Groups","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cn=staff,ou=groups","type":"codeVoice"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"url":"\/documentation\/axiamsdk\/groupmapping","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","title":"GroupMapping","role":"symbol","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}]}}}