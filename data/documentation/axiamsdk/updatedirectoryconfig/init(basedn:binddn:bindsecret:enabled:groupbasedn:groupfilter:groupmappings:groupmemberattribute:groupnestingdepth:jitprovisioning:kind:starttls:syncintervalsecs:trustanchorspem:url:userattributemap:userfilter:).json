thing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"title":"GroupMapping","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryKind":{"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DirectoryKind"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind","title":"DirectoryKind","url":"\/documentation\/axiamsdk\/directorykind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectoryKind"}],"abstract":[{"type":"text","text":"Which kind of directory server a configuration points at. It drives "},{"type":"strong","inlineContent":[{"type":"text","text":"defaults only"}]},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"external-id attribute, the group-membership strategy and the change attribute the sync job"},{"type":"text","text":" "},{"type":"text","text":"reads. Every one of them is still an explicit, editable field of the configuration (or, for"},{"type":"text","text":" "},{"type":"text","text":"the strategy and change attribute, derived from this value at the point of use); nothing"},{"type":"text","text":" "},{"type":"text","text":"about the kind changes what is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"allowed"}]},{"type":"text","text":"."}]},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/UserAttributeMap":{"abstract":[{"type":"text","text":"Which directory attribute feeds each AXIAM user field."}],"kind":"symbol","title":"UserAttributeMap","type":"topic","navigatorTitle":[{"text":"UserAttributeMap","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/userattributemap","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UserAttributeMap","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UserAttributeMap","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/UpdateDirectoryConfig":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig","role":"symbol","navigatorTitle":[{"text":"UpdateDirectoryConfig","kind":"identifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/updatedirectoryconfig","title":"UpdateDirectoryConfig","abstract":[{"code":"PATCH \/api\/v1\/tenants\/{tenant_id}\/directory","type":"codeVoice"},{"text":" — a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"sparse"}]},{"text":" update. Every member optional:","type":"text"},{"text":" ","type":"text"},{"text":"absent leaves the stored value, and for the two nullable members an explicit ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" clears","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateDirectoryConfig","kind":"identif