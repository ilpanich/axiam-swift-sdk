nd compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"axiam_directory::dn"},{"text":"), so ","type":"text"},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}],"title":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","url":"\/documentation\/axiamsdk\/groupmapping","kind":"symbol","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryKind":{"title":"DirectoryKind","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectoryKind","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Which kind of directory server a configuration points at. It drives ","type":"text"},{"inlineContent":[{"text":"defaults only","type":"text"}],"type":"strong"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"external-id attribute, the group-membership strategy and the change attribute the sync job","type":"text"},{"text":" ","type":"text"},{"text":"reads. Every one of them is still an explicit, editable field of the configuration (or, for","type":"text"},{"text":" ","type":"text"},{"text":"the strategy and change attribute, derived from this value at the point of use); nothing","type":"text"},{"text":" ","type":"text"},{"text":"about the kind changes what is ","type":"text"},{"inlineContent":[{"text":"allowed","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind","url":"\/documentation\/axiamsdk\/directorykind","navigatorTitle":[{"text":"DirectoryKind","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/UpdateDirectoryConfig":{"role":"symbol","title":"UpdateDirectoryConfig","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateDirectoryConfig","kind":"identifier"}],"type":"topic","abstract":[{"code":"PATCH \/api\/v1\/tenants\/{tenant_id}\/directory","type":"codeVoice"},{"type":"text","text":" — a "},{"type":"strong","inlineContent":[{"type":"text","text":"sparse"}]},{"type":"text","text":" update. Every member optional:"},{"type":"text","text":" "},{"type":"text","text":"absent leaves the stored value, and for the two nullable members an explicit "},{"code":"null","type":"codeVoice"},{"type":"text","text":" clears"},{"type":"text","text":" "},{"type":"text","text":"it."}],"url":"\/documentation\/axiamsdk\/updatedirectoryconfig","kind":"symbol","navigatorTitle":[{"text":"UpdateDirectoryConfig","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/Sensitive":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Sensitive","abstract":[{"type":"text","text":"A wrapper for secret material (§7 of CONTRACT.md)."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/sensitive","role":"symbol","title":"Sens