cumentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/DirectoryKind":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/DirectoryKind","navigatorTitle":[{"text":"DirectoryKind","kind":"identifier"}],"kind":"symbol","title":"DirectoryKind","role":"symbol","abstract":[{"type":"text","text":"Which kind of directory server a configuration points at. It drives "},{"type":"strong","inlineContent":[{"text":"defaults only","type":"text"}]},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"external-id attribute, the group-membership strategy and the change attribute the sync job"},{"type":"text","text":" "},{"type":"text","text":"reads. Every one of them is still an explicit, editable field of the configuration (or, for"},{"type":"text","text":" "},{"type":"text","text":"the strategy and change attribute, derived from this value at the point of use); nothing"},{"type":"text","text":" "},{"type":"text","text":"about the kind changes what is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"allowed"}]},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/axiamsdk\/directorykind","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectoryKind","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"title":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"url":"\/documentation\/axiamsdk\/groupmapping","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/UpdateDirectoryConfig":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig","navigatorTitle":[{"text":"UpdateDirectoryConfig","kind":"identifier"}],"title":"UpdateDirectoryConfig","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateDirectoryConfig","kind":"identifier"}],"abstract":[{"type":"codeVoice","code":"PATCH \/api\/v1\/tenants\/{tenant_id}\/directory"},{"type":"text","text":" — a "},{"type":"strong","inlineContent":[{"type":"text","text":"sparse"}]},{"type":"text","text":" update. Every member optional:"},{"type":"text","text":" "},{"type":"text","text":"absent leaves the stored value, and for the two nullable members an explicit "},{"type":"codeVoice","code":"null"},{"type":"text","text":" clears"},{"type":"text","text":" "},{"type":"text","text":"it."}],"kind":"symbol","url":"\/documentation\/axiamsdk\/updatedirectoryconfig","type":"topic","role":"symbol"}}}