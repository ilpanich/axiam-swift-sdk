{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Replaces the whole table when present.","type":"text"}],"variants":[{"paths":["\/documentation\/axiamsdk\/updatedirectoryconfig\/groupmappings"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},{"text":"]?","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]}],"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV"},{"text":"]?","kind":"text"}],"roleHeading":"Instance Property","symbolKind":"property","role":"symbol","title":"groupMappings","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK21UpdateDirectoryConfigV13groupMappingsSayAA12GroupMappingVGSgvp"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig"]]},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig\/groupMappings","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/UpdateDirectoryConfig/groupMappings":{"kind":"symbol","url":"\/documentation\/axiamsdk\/updatedirectoryconfig\/groupmappings","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig\/groupMappings","title":"groupMappings","role":"symbol","type":"topic","abstract":[{"text":"Replaces the whole table when present.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","kind":"typeIdentifier"},{"text":"]?","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/UpdateDirectoryConfig":{"role":"symbol","url":"\/documentation\/axiamsdk\/updatedirectoryconfig","abstract":[{"code":"PATCH \/api\/v1\/tenants\/{tenant_id}\/directory","type":"codeVoice"},{"text":" — a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"sparse"}]},{"text":" update. Every member optional:","type":"text"},{"text":" ","type":"text"},{"text":"absent leaves the stored value, and for the two nullable members an explicit ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" clears","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"title":"UpdateDirectoryConfig","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateDirectoryConfig","kind":"identifier"}],"navigatorTitle":[{"text":"UpdateDirectoryConfig","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"role":"symbol","url":"\/documentation\/axiamsdk\/groupmapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","type":"topic","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"text":"way a directory group reaches an AXIAM group.","type":"text"}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"title":"GroupMapping"}}}