{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig"]]},"sections":[],"abstract":[{"text":"Replaces the whole table when present.","type":"text"}],"metadata":{"externalID":"s:8AxiamSDK21UpdateDirectoryConfigV13groupMappingsSayAA12GroupMappingVGSgvp","role":"symbol","symbolKind":"property","title":"groupMappings","roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","text":"GroupMapping"},{"kind":"text","text":"]?"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","kind":"typeIdentifier"},{"text":"]?","kind":"text"}]}]}],"variants":[{"paths":["\/documentation\/axiamsdk\/updatedirectoryconfig\/groupmappings"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig\/groupMappings","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/UpdateDirectoryConfig":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig","role":"symbol","navigatorTitle":[{"text":"UpdateDirectoryConfig","kind":"identifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/updatedirectoryconfig","title":"UpdateDirectoryConfig","abstract":[{"code":"PATCH \/api\/v1\/tenants\/{tenant_id}\/directory","type":"codeVoice"},{"text":" — a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"sparse"}]},{"text":" update. Every member optional:","type":"text"},{"text":" ","type":"text"},{"text":"absent leaves the stored value, and for the two nullable members an explicit ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" clears","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateDirectoryConfig","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/UpdateDirectoryConfig/groupMappings":{"url":"\/documentation\/axiamsdk\/updatedirectoryconfig\/groupmappings","role":"symbol","type":"topic","title":"groupMappings","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV"},{"text":"]?","kind":"text"}],"abstract":[{"type":"text","text":"Replaces the whole table when present."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig\/groupMappings"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}]},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"url":"\/documentation\/axiamsdk\/groupmapping","kind":"symbol","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"title":"GroupMapping","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","type":"topic"}}}