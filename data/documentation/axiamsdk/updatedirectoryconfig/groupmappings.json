{"abstract":[{"text":"Replaces the whole table when present.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/updatedirectoryconfig\/groupmappings"]}],"metadata":{"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV"},{"text":"]?","kind":"text"}],"title":"groupMappings","externalID":"s:8AxiamSDK21UpdateDirectoryConfigV13groupMappingsSayAA12GroupMappingVGSgvp","modules":[{"name":"AxiamSDK"}],"role":"symbol"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupMappings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GroupMapping","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},{"text":"]?","kind":"text"}]}]}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig\/groupMappings"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"kind":"symbol","url":"\/documentation\/axiamsdk\/groupmapping","type":"topic","navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"abstract":[{"text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its","type":"text"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"axiam_directory::dn","type":"codeVoice"},{"text":"), so ","type":"text"},{"code":"CN=Staff, OU=Groups","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cn=staff,ou=groups","type":"codeVoice"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"title":"GroupMapping","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/UpdateDirectoryConfig/groupMappings":{"title":"groupMappings","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK12GroupMappingV","text":"GroupMapping"},{"kind":"text","text":"]?"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig\/groupMappings","type":"topic","url":"\/documentation\/axiamsdk\/updatedirectoryconfig\/groupmappings","kind":"symbol","abstract":[{"type":"text","text":"Replaces the whole table when present."}]},"doc://AxiamSDK/documentation/AxiamSDK/UpdateDirectoryConfig":{"abstract":[{"code":"PATCH \/api\/v1\/tenants\/{tenant_id}\/directory","type":"codeVoice"},{"type":"text","text":" — a "},{"type":"strong","inlineContent":[{"type":"text","text":"sparse"}]},{"type":"text","text":" update. Every member optional:"},{"type":"text","text":" "},{"type":"text","text":"absent leaves the stored value, and for the two nullable members an explicit "},{"code":"null","type":"codeVoice"},{"type":"text","text":" clears"},{"type":"text","text":" "},{"type":"text","text":"it."}],"kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/updatedirectoryconfig","navigatorTitle":[{"kind":"identifier","text":"UpdateDirectoryConfig"}],"title":"UpdateDirectoryConfig","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UpdateDirectoryConfig"}]}}}