entifier","text":"UpdateDirectoryConfig"}],"url":"\/documentation\/axiamsdk\/updatedirectoryconfig","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UpdateDirectoryConfig"}],"abstract":[{"type":"codeVoice","code":"PATCH \/api\/v1\/tenants\/{tenant_id}\/directory"},{"text":" — a ","type":"text"},{"type":"strong","inlineContent":[{"text":"sparse","type":"text"}]},{"type":"text","text":" update. Every member optional:"},{"type":"text","text":" "},{"type":"text","text":"absent leaves the stored value, and for the two nullable members an explicit "},{"type":"codeVoice","code":"null"},{"type":"text","text":" clears"},{"type":"text","text":" "},{"type":"text","text":"it."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}],"abstract":[{"text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its","type":"text"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"kind":"symbol","title":"GroupMapping","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/groupmapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/UpdateDirectoryConfig/groupMappings":{"abstract":[{"type":"text","text":"Replaces the whole table when present."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/UpdateDirectoryConfig\/groupMappings","kind":"symbol","type":"topic","title":"groupMappings","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupMappings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"GroupMapping","preciseIdentifier":"s:8AxiamSDK12GroupMappingV"},{"kind":"text","text":"]?"}],"role":"symbol","url":"\/documentation\/axiamsdk\/updatedirectoryconfig\/groupmappings"}}}