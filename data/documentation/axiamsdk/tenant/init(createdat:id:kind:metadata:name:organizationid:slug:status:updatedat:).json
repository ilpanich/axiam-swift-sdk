dentifier","text":"Tenant"}],"title":"Tenant","abstract":[{"type":"text","text":"A tenant is an isolated context within an organization. Each tenant has its own set of"},{"type":"text","text":" "},{"type":"text","text":"users, roles, permissions, resources, certificates, and configuration. Tenants can represent"},{"type":"text","text":" "},{"type":"text","text":"environments (dev\/staging\/prod) or separate business contexts."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Tenant"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Tenant"},"doc://AxiamSDK/documentation/AxiamSDK/TenantStatus":{"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TenantStatus","role":"symbol","navigatorTitle":[{"text":"TenantStatus","kind":"identifier"}],"type":"topic","url":"\/documentation\/axiamsdk\/tenantstatus","title":"TenantStatus","abstract":[{"text":"Lifecycle status of a tenant. A ","type":"text"},{"type":"codeVoice","code":"Suspended"},{"text":" tenant remains stored and its data isolated, but","type":"text"},{"text":" ","type":"text"},{"text":"is treated as administratively disabled. New tenants are ","type":"text"},{"type":"codeVoice","code":"Active"},{"text":" by default.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TenantStatus","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/TenantKind":{"url":"\/documentation\/axiamsdk\/tenantkind","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TenantKind","kind":"identifier"}],"abstract":[{"type":"text","text":"What a tenant "},{"type":"emphasis","inlineContent":[{"type":"text","text":"is"}]},{"type":"text","text":", as distinct from what state it is in. Reserved rather than inferred: an"},{"type":"text","text":" "},{"type":"text","text":"organization has exactly one tenant of kind ["},{"type":"codeVoice","code":"Self::Organization"},{"type":"text","text":"], enforced by a unique"},{"type":"text","text":" "},{"type":"text","text":"index rather than by convention. Deriving it from a magic slug or from “the oldest tenant”"},{"type":"text","text":" "},{"type":"text","text":"would make the organization scope something an operator could rename or delete by accident,"},{"type":"text","text":" "},{"type":"text","text":"and it is the scope the super-admin lives in."}],"navigatorTitle":[{"text":"TenantKind","kind":"identifier"}],"type":"topic","kind":"symbol","title":"TenantKind","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TenantKind"}}}