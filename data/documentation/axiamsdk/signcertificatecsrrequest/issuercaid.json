{"type":"text","text":"Body of "},{"type":"codeVoice","code":"POST \/api\/v1\/certificates\/sign-csr"},{"type":"text","text":". No "},{"type":"codeVoice","code":"subject"},{"type":"text","text":" and no "},{"type":"codeVoice","code":"key_algorithm"},{"type":"text","text":": both are"},{"type":"text","text":" "},{"type":"text","text":"read out of the CSR, which is the only place they can be stated without the row and the"},{"type":"text","text":" "},{"type":"text","text":"certificate being able to disagree. No key is returned, so there is no key field anywhere on"},{"type":"text","text":" "},{"type":"text","text":"this exchange. The CSR’s common name meets the rules of "},{"type":"codeVoice","code":"subject"},{"type":"text","text":" on "},{"type":"codeVoice","code":"POST \/api\/v1\/certificates"},{"type":"text","text":" (printable, at most 64 characters) and is refused, not rewritten, when"},{"type":"text","text":" "},{"type":"text","text":"it does not. So does the value of every other attribute of the CSR’s subject, and a subject"},{"type":"text","text":" "},{"type":"text","text":"with more than one common name is refused."}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/signcertificatecsrrequest","role":"symbol","title":"SignCertificateCsrRequest","navigatorTitle":[{"text":"SignCertificateCsrRequest","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/SignCertificateCsrRequest/issuerCAID":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"issuerCAID","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"The server’s "},{"code":"issuer_ca_id","type":"codeVoice"},{"type":"text","text":" field."}],"role":"symbol","title":"issuerCAID","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SignCertificateCsrRequest\/issuerCAID","kind":"symbol","url":"\/documentation\/axiamsdk\/signcertificatecsrr