{"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"organizationLevel","role":"symbol","modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"externalID":"s:8AxiamSDK0A4UserV17organizationLevelSbvp","roleHeading":"Instance Property","symbolKind":"property"},"abstract":[{"type":"text","text":"Whether this is an "},{"type":"strong","inlineContent":[{"text":"organization-level","type":"text"}]},{"type":"text","text":" principal (CONTRACT.md §5.2)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Such a principal’s record lives in its organization’s reserved tenant, so its global"},{"type":"text","text":" "},{"type":"text","text":"grants apply in every tenant of that organization, and it can act on a different one"},{"type":"text","text":" "},{"type":"text","text":"by sending a different "},{"type":"codeVoice","code":"X-Axiam-Tenant"},{"type":"text","text":" on the next request — no re-login, because it"},{"type":"text","text":" "},{"type":"text","text":"already is a principal of every tenant there."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An ordinary tenant principal is a principal of exactly one tenant; the same header"},{"type":"text","text":" "},{"type":"text","text":"change produces a "},{"type":"codeVoice","code":"403"},{"type":"text","text":" for it. This flag is therefore what an application checks"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" offering a tenant switch, rather than discovering the answer from a failed"},{"type":"text","text":" "},{"type":"text","text":"request."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Derived, never asserted"}],"type":"strong"},{"text":" (§5.2 rule 2): resolved server-side from the caller’s own","type":"text"},{"text":" ","type":"text"},{"text":"tenant record, and never sent by this SDK. ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" when the login response omits it —","type":"text"},{"text":" ","type":"text"},{"text":"which is what a server older than contract 1.31 answers — and ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" on the guard","type":"text"},{"text":" ","type":"text"},{"text":"path, where this value is built from token claims that do not carry it. Both are the","type":"text"},{"text":" ","type":"text"},{"text":"safe direction: the application then offers no cross-tenant action.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Since contract 1.35 that reach can be narrowed per assignment, so this flag alone no"},{"type":"text","text":" "},{"type":"text","text":"longer decides what to offer: consult "},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/reachableTenantIDs","type":"reference"},{"type":"text","text":" as well (§5.2.3 rule 3)."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamuser\/organizationlevel"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser/reachableTenantIDs":{"abstract":[{"text":"The tenants this caller’s roles reach, when they are narrowed (§5.2.3).","type":"text"}],"title":"reachableTenantIDs","kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/reachableTenantIDs","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reachableTenantIDs","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"url":"\/documentation\/axiamsdk\/axiamuser\/reachabletenantids","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser":{"title":"AxiamUser","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","navigatorTitle":[{"text":"AxiamUser","kind":"identifier"}],"abstract":[{"type":"text","text":"An authenticated AXIAM identity."}],"url":"\/documentation\/axiamsdk\/axiamuser","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"AxiamUser","kind":"identifier"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser/organizationLevel":{"abstract":[{"text":"Whether this is an ","type":"text"},{"inlineContent":[{"text":"organization-level","type":"text"}],"type":"strong"},{"text":" principal (CONTRACT.md §5.2).","type":"text"}],"title":"organizationLevel","kind":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"url":"\/documentation\/axiamsdk\/axiamuser\/organizationlevel","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","title":"AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}