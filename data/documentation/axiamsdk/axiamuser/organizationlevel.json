{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamuser\/organizationlevel"]}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"organizationLevel"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Such a principal’s record lives in its organization’s reserved tenant, so its global"},{"type":"text","text":" "},{"type":"text","text":"grants apply in every tenant of that organization, and it can act on a different one"},{"type":"text","text":" "},{"type":"text","text":"by sending a different "},{"type":"codeVoice","code":"X-Axiam-Tenant"},{"type":"text","text":" on the next request — no re-login, because it"},{"type":"text","text":" "},{"type":"text","text":"already is a principal of every tenant there."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An ordinary tenant principal is a principal of exactly one tenant; the same header"},{"type":"text","text":" "},{"type":"text","text":"change produces a "},{"type":"codeVoice","code":"403"},{"type":"text","text":" for it. This flag is therefore what an application checks"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" offering a tenant switch, rather than discovering the answer from a failed"},{"type":"text","text":" "},{"type":"text","text":"request."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Derived, never asserted"}]},{"text":" (§5.2 rule 2): resolved server-side from the caller’s own","type":"text"},{"text":" ","type":"text"},{"text":"tenant record, and never sent by this SDK. ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" when the login response omits it —","type":"text"},{"text":" ","type":"text"},{"text":"which is what a server older than contract 1.31 answers — and ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" on the guard","type":"text"},{"text":" ","type":"text"},{"text":"path, where this value is built from token claims that do not carry it. Both are the","type":"text"},{"text":" ","type":"text"},{"text":"safe direction: the application then offers no cross-tenant action.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Since contract 1.35 that reach can be narrowed per assignment, so this flag alone no"},{"type":"text","text":" "},{"type":"text","text":"longer decides what to offer: consult "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/reachableTenantIDs"},{"type":"text","text":" as well (§5.2.3 rule 3)."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser"]]},"abstract":[{"type":"text","text":"Whether this is an "},{"type":"strong","inlineContent":[{"type":"text","text":"organization-level"}]},{"type":"text","text":" principal (CONTRACT.md §5.2)."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"AxiamSDK"}],"role":"symbol","externalID":"s:8AxiamSDK0A4UserV17organizationLevelSbvp","roleHeading":"Instance Property","title":"organizationLevel","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"organizationLevel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"symbolKind":"property"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser":{"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamUser","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","title":"AxiamUser","abstract":[{"type":"text","text":"An authenticated AXIAM identity."}],"type":"topic","url":"\/documentation\/axiamsdk\/axiamuser","navigatorTitle":[{"text":"AxiamUser","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","url":"\/documentation\/axiamsdk","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser/organizationLevel":{"title":"organizationLevel","role":"symbol","abstract":[{"type":"text","text":"Whether this is an "},{"type":"strong","inlineContent":[{"type":"text","text":"organization-level"}]},{"type":"text","text":" principal (CONTRACT.md §5.2)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel","url":"\/documentation\/axiamsdk\/axiamuser\/organizationlevel","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser/reachableTenantIDs":{"title":"reachableTenantIDs","role":"symbol","abstract":[{"type":"text","text":"The tenants this caller’s roles reach, when they are narrowed (§5.2.3)."}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/reachableTenantIDs","url":"\/documentation\/axiamsdk\/axiamuser\/reachabletenantids","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reachableTenantIDs","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]?","kind":"text"}]}}}