{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser"]]},"sections":[],"abstract":[{"type":"text","text":"Whether this is an "},{"type":"strong","inlineContent":[{"type":"text","text":"organization-level"}]},{"type":"text","text":" principal (CONTRACT.md §5.2)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Such a principal’s record lives in its organization’s reserved tenant, so its global","type":"text"},{"text":" ","type":"text"},{"text":"grants apply in every tenant of that organization, and it can act on a different one","type":"text"},{"text":" ","type":"text"},{"text":"by sending a different ","type":"text"},{"code":"X-Axiam-Tenant","type":"codeVoice"},{"text":" on the next request — no re-login, because it","type":"text"},{"text":" ","type":"text"},{"text":"already is a principal of every tenant there.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An ordinary tenant principal is a principal of exactly one tenant; the same header"},{"type":"text","text":" "},{"type":"text","text":"change produces a "},{"code":"403","type":"codeVoice"},{"type":"text","text":" for it. This flag is therefore what an application checks"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" offering a tenant switch, rather than discovering the answer from a failed"},{"type":"text","text":" "},{"type":"text","text":"request."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Derived, never asserted"}]},{"text":" (§5.2 rule 2): resolved server-side from the caller’s own","type":"text"},{"text":" ","type":"text"},{"text":"tenant record, and never sent by this SDK. ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" when the login response omits it —","type":"text"},{"text":" ","type":"text"},{"text":"which is what a server older than contract 1.31 answers — and ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" on the guard","type":"text"},{"text":" ","type":"text"},{"text":"path, where this value is built from token claims that do not carry it. Both are the","type":"text"},{"text":" ","type":"text"},{"text":"safe direction: the application then offers no cross-tenant action.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Since contract 1.35 that reach can be narrowed per assignment, so this flag alone no","type":"text"},{"text":" ","type":"text"},{"text":"longer decides what to offer: consult ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/reachableTenantIDs","type":"reference"},{"text":" as well (§5.2.3 rule 3).","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel"},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamuser\/organizationlevel"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"AxiamSDK"}],"symbolKind":"property","externalID":"s:8AxiamSDK0A4UserV17organizationLevelSbvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"roleHeading":"Instance Property","role":"symbol","title":"organizationLevel"},"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topi