{"metadata":{"externalID":"s:8AxiamSDK0A4UserV17organizationLevelSbvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"roleHeading":"Instance Property","title":"organizationLevel","symbolKind":"property","modules":[{"name":"AxiamSDK"}],"role":"symbol"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamuser\/organizationlevel"]}],"kind":"symbol","abstract":[{"type":"text","text":"Whether this is an "},{"inlineContent":[{"text":"organization-level","type":"text"}],"type":"strong"},{"type":"text","text":" principal (CONTRACT.md §5.2)."}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Such a principal’s record lives in its organization’s reserved tenant, so its global"},{"type":"text","text":" "},{"type":"text","text":"grants apply in every tenant of that organization, and it can act on a different one"},{"type":"text","text":" "},{"type":"text","text":"by sending a different "},{"type":"codeVoice","code":"X-Axiam-Tenant"},{"type":"text","text":" on the next request — no re-login, because it"},{"type":"text","text":" "},{"type":"text","text":"already is a principal of every tenant there."}]},{"type":"paragraph","inlineContent":[{"text":"An ordinary tenant principal is a principal of exactly one tenant; the same header","type":"text"},{"text":" ","type":"text"},{"text":"change produces a ","type":"text"},{"code":"403","type":"codeVoice"},{"text":" for it. This flag is therefore what an application checks","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"text":" offering a tenant switch, rather than discovering the answer from a failed","type":"text"},{"text":" ","type":"text"},{"text":"request.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Derived, never asserted"}]},{"text":" (§5.2 rule 2): resolved server-side from the caller’s own","type":"text"},{"text":" ","type":"text"},{"text":"tenant record, and never sent by this SDK. ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" when the login response omits it —","type":"text"},{"text":" ","type":"text"},{"text":"which is what a server older than contract 1.31 answers — and ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" on the guard","type":"text"},{"text":" ","type":"text"},{"text":"path, where this value is built from token claims that do not carry it. Both are the","type":"text"},{"text":" ","type":"text"},{"text":"safe direction: the application then offers no cross-tenant action.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since contract 1.35 that reach can be narrowed per assignment, so this flag alone no"},{"type":"text","text":" "},{"type":"text","text":"longer decides what to offer: consult "},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/reachableTenantIDs","isActive":true,"type":"reference"},{"type":"text","text":" as well (§5.2.3 rule 3)."}]}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser":{"r