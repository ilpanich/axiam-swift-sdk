{"abstract":[{"type":"text","text":"Whether this is an "},{"type":"strong","inlineContent":[{"text":"organization-level","type":"text"}]},{"type":"text","text":" principal (CONTRACT.md §5.2)."}],"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"symbolKind":"property","title":"organizationLevel","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK0A4UserV17organizationLevelSbvp","role":"symbol","roleHeading":"Instance Property"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"organizationLevel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Such a principal’s record lives in its organization’s reserved tenant, so its global"},{"type":"text","text":" "},{"type":"text","text":"grants apply in every tenant of that organization, and it can act on a different one"},{"type":"text","text":" "},{"type":"text","text":"by sending a different "},{"type":"codeVoice","code":"X-Axiam-Tenant"},{"type":"text","text":" on the next request — no re-login, because it"},{"type":"text","text":" "},{"type":"text","text":"already is a principal of every tenant there."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An ordinary tenant principal is a principal of exactly one tenant; the same header"},{"type":"text","text":" "},{"type":"text","text":"change produces a "},{"type":"codeVoice","code":"403"},{"type":"text","text":" for it. This flag is therefore what an application checks"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" offering a tenant switch, rather than discovering the answer from a failed"},{"type":"text","text":" "},{"type":"text","text":"request."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Derived, never asserted","type":"text"}]},{"type":"text","text":" (§5.2 rule 2): resolved server-side from the caller’s own"},{"type":"text","text":" "},{"type":"text","text":"tenant record, and never sent by this SDK. "},{"type":"codeVoice","code":"false"},{"type":"text","text":" when the login response omits it —"},{"type":"text","text":" "},{"type":"text","text":"which is what a server older than contract 1.31 answers — and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on the guard"},{"type":"text","text":" "},{"type":"text","text":"path, where this value is built from token claims that do not carry it. Both are the"},{"type":"text","text":" "},{"type":"text","text":"safe direction: the application then offers no cross-tenant action."}],"type":"paragraph"},{"inlineContent":[{"text":"Since contract 1.35 that reach can be narrowed per assignment, so this flag alone no","type":"text"},{"text":" ","type":"text"},{"text":"longer decides what to offer: consult ","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/reachableTenantIDs","isActive":true,"type":"reference"},{"text":" as well (§5.2.3 rule 3).","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamuser\/organizationlevel"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser/organizationLevel":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel","url":"\/documentation\/axiamsdk\/axiamuser\/organizationlevel","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"organizationLevel","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"organizationLevel","abstract":[{"type":"text","text":"Whether this is an "},{"type":"strong","inlineContent":[{"type":"text","text":"organization-level"}]},{"type":"text","text":" principal (CONTRACT.md §5.2)."}],"kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser":{"navigatorTitle":[{"text":"AxiamUser","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamUser","kind":"identifier"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"An authenticated AXIAM identity."}],"title":"AxiamUser","kind":"symbol","url":"\/documentation\/axiamsdk\/axiamuser"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamUser/reachableTenantIDs":{"kind":"symbol","abstract":[{"type":"text","text":"The tenants this caller’s roles reach, when they are narrowed (§5.2.3)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/reachableTenantIDs","title":"reachableTenantIDs","role":"symbol","url":"\/documentation\/axiamsdk\/axiamuser\/reachabletenantids","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"reachableTenantIDs"},{"kind":"text","tex