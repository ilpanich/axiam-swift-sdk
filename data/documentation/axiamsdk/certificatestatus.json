er state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"text","text":"carrying an unrecognised value back into an update is refused by the server rather than"},{"type":"text","text":" "},{"type":"text","text":"written as a spelling it never used. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/certificatestatus"]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CertificateStatus","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Status of a certificate in its lifecycle."}],"relationshipsSections":[{"identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"metadata":{"roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CertificateStatus","kind":"identifier"}],"modules":[{"name":"AxiamSDK"}],"symbolKind":"enum","externalID":"s:8AxiamSDK17CertificateStatusO","title":"CertificateStatus","role":"symbol","navigatorTitle":[{"text":"CertificateStatus","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/CertificateStatus":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"CertificateStatus","kind":"identifier"}],"title":"CertificateStatus","ty