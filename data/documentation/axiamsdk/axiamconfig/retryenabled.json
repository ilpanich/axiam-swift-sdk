{"kind":"symbol","sections":[],"abstract":[{"text":"Whether the §16 bounded read-only retry policy is active. ","type":"text"},{"inlineContent":[{"code":"true","type":"codeVoice"},{"text":" by default.","type":"text"}],"type":"strong"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"retryEnabled"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"There is deliberately no property for the attempt cap, the base delay or the delay cap:"},{"type":"text","text":" "},{"type":"text","text":"§16.1 permits "},{"type":"emphasis","inlineContent":[{"type":"text","text":"lowering"}]},{"type":"text","text":" the budget or disabling it, never raising it, and a caller who can"},{"type":"text","text":" "},{"type":"text","text":"raise them turns one client into the herd a backoff exists to prevent. Set "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"exactly one attempt — the right choice for a caller who owns their own retry layer and"},{"type":"text","text":" "},{"type":"text","text":"knows their own deadline."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/retryEnabled","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/axiamsdk\/axiamconfig\/retryenabled"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Property","title":"retryEnabled","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retryEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"precise