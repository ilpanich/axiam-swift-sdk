{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/retryEnabled"},"abstract":[{"text":"Whether the §16 bounded read-only retry policy is active. ","type":"text"},{"inlineContent":[{"code":"true","type":"codeVoice"},{"type":"text","text":" by default."}],"type":"strong"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"retryEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There is deliberately no property for the attempt cap, the base delay or the delay cap:"},{"type":"text","text":" "},{"type":"text","text":"§16.1 permits "},{"type":"emphasis","inlineContent":[{"text":"lowering","type":"text"}]},{"type":"text","text":" the budget or disabling it, never raising it, and a caller who can"},{"type":"text","text":" "},{"type":"text","text":"raise them turns one client into the herd a backoff exists to prevent. Set "},{"code":"false","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"exactly one attempt — the right choice for a caller who owns their own retry layer and"},{"type":"text","text":" "},{"type":"text","text":"knows their own deadline."}]}]}],"metadata":{"title":"retryEnabled","role":"symbol","symbolKind":"property","modules":[{"name":"AxiamSDK"}],"roleHeading":"Instance Property","externalID":"s:8AxiamSDK0A6ConfigV12retryEnabledSbvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":"