s silently."},{"type":"text","text":" "},{"type":"text","text":"Switch this on having read that, not because it looks like an easy win."}]}],"type":"aside"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/decisionMemoTtl"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamconfig\/decisionmemottl"]}],"kind":"symbol","sections":[],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"decisionMemoTtl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TimeInterval","preciseIdentifier":"s:10Foundation12TimeIntervala"},{"kind":"text","text":"?"}],"symbolKind":"property","role":"symbol","externalID":"s:8AxiamSDK0A6ConfigV15decisionMemoTtlSdSgvp","title":"decisionMemoTtl"},"abstract":[{"type":"text","text":"The §17 decision-memo TTL. "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"nil"},{"type":"text","text":" by default, which means disabled"}]},{"type":"text","text":" — not “cache for zero"},{"type":"text","text":" "},{"type":"text","text":"seconds”."}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"url":"\/documentation\/axiamsdk\/axiamclient","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamClient"}],"navigatorTitle":[{"kind":"identifier","text":"AxiamClient"}]},"doc://AxiamSDK/documentation/AxiamSDK/TelemetryEvent/configClamped(setting:requested:effective:contractReference:)":{"url":"\/documentation\/axiamsdk\/telemetryevent\/configclamped(setting:requested:effective:contractreference:)","fragmen