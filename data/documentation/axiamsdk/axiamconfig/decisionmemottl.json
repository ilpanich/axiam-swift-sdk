{"metadata":{"role":"symbol","externalID":"s:8AxiamSDK0A6ConfigV15decisionMemoTtlSdSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"decisionMemoTtl","kind":"identifier"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation12TimeIntervala"},{"text":"?","kind":"text"}],"modules":[{"name":"AxiamSDK"}],"symbolKind":"property","title":"decisionMemoTtl","roleHeading":"Instance Property"},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/decisionMemoTtl","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamconfig\/decisionmemottl"]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"decisionMemoTtl"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation12TimeIntervala","kind":"typeIdentifier","text":"TimeInterval"},{"kind":"text","text":"?"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A value above 5 s is "},{"inlineContent":[{"type":"text","text":"clamped"}],"type":"strong"},{"type":"text","text":" to 5 s rather than rejected (§17.1 rule 2), and the clamp"},{"type":"text","text":" "},{"type":"text","text":"is announced through the §19 "},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent\/configClamped(setting:requested:effective:contractReference:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"event rather than applied in silence."}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"inlineContent":[{"text":"Read-your-own-writes is not guaranteed.","type":"text"}],"type":"strong"},{"type":"text","text":" The staleness bound is the TTL in"},{"type":"text","text":" "},{"type":"text","text":"both directions: a grant revoked on the server can still read as allowed for up to the"},{"type":"text","text":" "},{"type":"text","text":"TTL, and a grant just "},{"inlineContent":[{"type":"text","text":"added"}],"type":"emphasis"},{"type":"text","text":" can still read as denied for up to the TTL. An admin UI that"},{"type":"text","text":" "},{"type":"text","text":"grants a role and immediately re-checks is the case that breaks, and it breaks silently."},{"type":"text","text":" "},{"type":"text","text":"Switch this on having read that, not because it looks like an easy win."}]}],"style":"important"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"The §17 decision-memo TTL. "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"nil"},{"type":"text","text":" by default, which means disabled"}]},{"type":"text","text":" — not “cache for zero"},{"type":"text","text":" "},{"type":"text","text":"seconds”."}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","url":"\/documentation\/axiamsdk\/axiamclient","kind":"symbol","abstract":[{"text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md).","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AxiamConfig":{"kind":"symbol","role":"symbol","title":"AxiamConfig","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamConfig","kind":"identifier"}],"abstract":[{