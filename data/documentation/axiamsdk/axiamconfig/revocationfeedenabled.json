{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"AxiamSDK"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"revocationFeedEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","externalID":"s:8AxiamSDK0A6ConfigV21revocationFeedEnabledSbvp","symbolKind":"property","roleHeading":"Instance Property","title":"revocationFeedEnabled"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"revocationFeedEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"inlineContent":[{"text":"Off by default","type":"text"}],"type":"strong"},{"text":", and that default is the whole point: a client built before","type":"text"},{"text":" ","type":"text"},{"text":"contract 1.44 fetches nothing and behaves byte-for-byte as it did. Turning it on lets","type":"text"},{"text":" ","type":"text"},{"text":"a guard reject a revoked session within one poll interval rather than one token","type":"text"},{"text":" ","type":"text"},{"text":"lifetime, for one cacheable fetch per interval — and it can only ever turn an accept","type":"text"},{"text":" ","type":"text"},{"text":"into a reject. A deployment that does not publish the feed is unaffected: an","type":"text"},{"text":" ","type":"text"},{"text":"unreachable or unusable document behaves exactly as no feed at all.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/revocationFeedEnabled","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documenta