{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/revocationFeedEnabled"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"revocationFeedEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Off by default"}]},{"type":"text","text":", and that default is the whole point: a client built before"},{"type":"text","text":" "},{"type":"text","text":"contract 1.44 fetches nothing and behaves byte-for-byte as it did. Turning it on lets"},{"type":"text","text":" "},{"type":"text","text":"a guard reject a revoked session within one poll interval rather than one token"},{"type":"text","text":" "},{"type":"text","text":"lifetime, for one cacheable fetch per interval — and it can only ever turn an accept"},{"type":"text","text":" "},{"type":"text","text":"into a reject. A deployment that does not publish the feed is unaffected: an"},{"type":"text","text":" "},{"type":"text","text":"unreachable or unusable document behaves exactly as no feed at all."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Instance Property","externalID":"s:8AxiamSDK0A6ConfigV21revocationFeedEnabledSbvp","symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"revocationFeedEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","modules":[{"name":"AxiamSDK"}],"title":"revocationFeedEnabled"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK