{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamconfig\/revocationfeedenabled"]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/revocationFeedEnabled","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"type":"text","text":"Whether to poll the CONTRACT.md §10.4 session-revocation feed (contract 1.44)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"revocationFeedEnabled"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Off by default"}]},{"type":"text","text":", and that default is the whole point: a client built before"},{"type":"text","text":" "},{"type":"text","text":"contract 1.44 fetches nothing and behaves byte-for-byte as it did. Turning it on lets"},{"type":"text","text":" "},{"type":"text","text":"a guard reject a revoked session within one poll interval rather than one token"},{"type":"text","text":" "},{"type":"text","text":"lifetime, for one cacheable fetch per interval — and it can only ever turn an accept"},{"type":"text","text":" "},{"type":"text","text":"into a reject. A deployment that does not publish the feed is unaffected: an"},{"type":"text","text":" "},{"type":"text","text":"unreachable or unusable document behaves exactly as no feed at all."}]}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig"]]},"metadata":{"modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK0A6ConfigV21revocationFeedEnabledSbvp","fragments":[{"text