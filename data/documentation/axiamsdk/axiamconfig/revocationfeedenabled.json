{"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"revocationFeedEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Off by default"}]},{"type":"text","text":", and that default is the whole point: a client built before"},{"type":"text","text":" "},{"type":"text","text":"contract 1.44 fetches nothing and behaves byte-for-byte as it did. Turning it on lets"},{"type":"text","text":" "},{"type":"text","text":"a guard reject a revoked session within one poll interval rather than one token"},{"type":"text","text":" "},{"type":"text","text":"lifetime, for one cacheable fetch per interval — and it can only ever turn an accept"},{"type":"text","text":" "},{"type":"text","text":"into a reject. A deployment that does not publish the feed is unaffected: an"},{"text":" ","type":"text"},{"text":"unreachable or unusable document behaves exactly as no feed at all.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig"]]},"sections":[],"metadata":{"title":"revocationFeedEnabled","externalID":"s:8AxiamSDK0A6ConfigV21revocationFeedEnabledSbvp","role":"symbol","symbolKind":"property","roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"revocationFeedEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/revocationFeedEnabled","interfaceLanguage":"swift"},"abstract":[{"text":"Whether to poll the CONTRACT.md §10.4 session-revocation feed (contract 1.44).","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/axiamconfig\/revocationfeedenabled"]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamConfig/revocationFeedEnabled":{"title":"revocationFeedEnabled","type":"topic","url":"\/documentation\/axiamsdk\/axiamconfig\/revocationfeedenabled","abstract":[{"text":"Whether to poll the CONTRACT.md §10.4 session-revocation feed (contract 1.44).","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"revocationFeedEnabled"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig\/revocationFeedEnabled","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"title":"AxiamClient","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","navigatorTitle":[{"text":"AxiamClient","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/axiamclient","type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxiamClient","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamConfig":{"navigatorTitle":[{"kind":"identifier","text":"AxiamConfig"}],"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/axiamconfig","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamConfig"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamConfig","abstract":[{"type":"text","text":"Immutable configuration for an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Axia