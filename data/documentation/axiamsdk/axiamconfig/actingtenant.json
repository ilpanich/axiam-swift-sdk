xt":" ","type":"text"},{"text":"(or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient\/actingTenant(_:)","type":"reference"},{"text":") has set a value. A ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":", never a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" ","type":"text"},{"text":"— the server parses the header as a UUID and silently ignores a value that does","type":"text"},{"text":" ","type":"text"},{"text":"not parse, so typing this as ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":" is what makes “refuse a non-UUID client-side,","type":"text"},{"text":" ","type":"text"},{"text":"before any wire call” (§5.2 rule 1) a property of the type rather than a runtime","type":"text"},{"text":" ","type":"text"},{"text":"check this SDK has to remember to perform.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaningful only for an organization-level principal — see"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamUser\/organizationLevel"},{"type":"text","text":". Set here, before any login exists to gate"},{"type":"text","text":" "},{"type":"text","text":"against, this value is sent as asked and the server’s "},{"type":"codeVoice","code":"403"},{"type":"text","text":" is the answer for a"},{"type":"text","text":" "},{"type":"text","text":"principal it does not fit (§5.2 rule 1: “gate it on what the SDK knows”). It is"},{"type":"text","text":" "},{"type":"text","text":"REST-only: this SDK ships no gRPC transport, so §5.2 rule 1 has nothing else to"},{"type":"text","text":" "},{"type":"text","text":"reach."}]}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/AxiamClient":{"type":"topic","abstract":[{"type":"text","text":"The AXIAM REST client (§1–§7, §9 of CONTRACT.md)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamClient","url