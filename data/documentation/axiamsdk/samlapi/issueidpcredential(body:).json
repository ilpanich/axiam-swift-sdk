 of service providers, the"},{"type":"text","text":" "},{"type":"text","text":"import of an SP’s metadata into a "},{"type":"emphasis","inlineContent":[{"text":"draft","type":"text"}]},{"type":"text","text":" registration (never a write), and the lifecycle of"},{"text":" ","type":"text"},{"text":"the IdP signing credential. The protocol itself – single sign-on, single logout, the IdP","type":"text"},{"text":" ","type":"text"},{"text":"metadata document – is browser and SP-to-IdP surface under \/saml\/v2\/{tenant_id}, an SP’s","type":"text"},{"text":" ","type":"text"},{"text":"own SAML library speaks to it, and it is not in this registry.","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlApi","kind":"identifier"}],"title":"SamlApi","kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/samlapi","navigatorTitle":[{"text":"SamlApi","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/SamlIdpCredential":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlIdpCredential","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SamlIdpCredential"}],"abstract":[{"text":"The tenant’s IdP signing credential, ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"public facts only"}]},{"text":". There is no key on it and no","type":"text"},{"text":" ","type":"text"},{"text":"field a key could be put in: the private key is generated by the server, sealed at rest,","type":"text"},{"text":" ","type":"text"},{"text":"never returned by any route and destroyed on retirement (D-21).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/samlidpcredential","role":"symbol","title":"SamlIdpCredential","navigatorTitle":[{"kind":"identifier","text":"SamlIdpCredential"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"Th