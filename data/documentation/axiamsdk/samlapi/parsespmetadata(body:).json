AxiamSDK\/ParseSamlSpMetadata","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ParseSamlSpMetadata","kind":"identifier"}],"navigatorTitle":[{"text":"ParseSamlSpMetadata","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/parsesamlspmetadata","title":"ParseSamlSpMetadata","kind":"symbol","type":"topic","abstract":[{"code":"POST …\/saml\/parse-sp-metadata","type":"codeVoice"},{"type":"text","text":" body: "},{"type":"strong","inlineContent":[{"text":"exactly one","type":"text"}]},{"type":"text","text":" of the two members."}]},"doc://AxiamSDK/documentation/AxiamSDK/SamlSpMetadataDraft":{"kind":"symbol","title":"SamlSpMetadataDraft","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlSpMetadataDraft","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlSpMetadataDraft","navigatorTitle":[{"text":"SamlSpMetadataDraft","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"text":"A parse of SP metadata: ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"a draft, not a registration"}]},{"text":". Nothing is stored until the caller","type":"text"},{"text":" ","type":"text"},{"text":"submits ","type":"text"},{"type":"codeVoice","code":"service_provider"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"create_service_provider"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"update_service_provider"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"nothing in it is trusted because it came from a document (D-41).","type":"text"}],"url":"\/documentation\/axiamsdk\/samlspmetadatadraft"},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi/parseSpMetadata(body:)":{"abstract":[{"code":"POST \/api\/v1\/tenants\/{tenant_id}\/saml\/parse-sp-metadata","type":"codeVoice"}],"kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/samlapi\/parsespmetadata(body:)","title":"parseSpMetadata(body