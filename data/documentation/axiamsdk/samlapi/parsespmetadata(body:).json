:[{"text":"A tenant’s SAML 2.0 identity provider (CONTRACT §29): the registry of service providers, the","type":"text"},{"text":" ","type":"text"},{"text":"import of an SP’s metadata into a ","type":"text"},{"inlineContent":[{"type":"text","text":"draft"}],"type":"emphasis"},{"text":" registration (never a write), and the lifecycle of","type":"text"},{"text":" ","type":"text"},{"text":"the IdP signing credential. The protocol itself – single sign-on, single logout, the IdP","type":"text"},{"text":" ","type":"text"},{"text":"metadata document – is browser and SP-to-IdP surface under \/saml\/v2\/{tenant_id}, an SP’s","type":"text"},{"text":" ","type":"text"},{"text":"own SAML library speaks to it, and it is not in this registry.","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/SamlSpMetadataDraft":{"type":"topic","url":"\/documentation\/axiamsdk\/samlspmetadatadraft","kind":"symbol","abstract":[{"type":"text","text":"A parse of SP metadata: "},{"type":"strong","inlineContent":[{"text":"a draft, not a registration","type":"text"}]},{"type":"text","text":". Nothing is stored until the caller"},{"type":"text","text":" "},{"type":"text","text":"submits "},{"type":"codeVoice","code":"service_provider"},{"type":"text","text":" to "},{"type":"codeVoice","code":"create_service_provider"},{"type":"text","text":" or "},{"type":"codeVoice","code":"update_service_provider"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"nothing in it is trusted because it came from a document (D-41)."}],"title":"SamlSpMetadataDraft","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlSpMetadataDraft","navigatorTitle":[{"kind":"identifier","text":"SamlSpMetadataDraft"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SamlSpMetadataDraft"}],"role":"symbol"}}}