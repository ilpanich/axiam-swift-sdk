xt"},{"text":"evaluated. ","type":"text"},{"code":"503","type":"codeVoice"},{"text":" in a server built without SAML.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/axiamsdk\/samlapi\/parsespmetadata(body:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi"]]},"kind":"symbol","identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/parseSpMetadata(body:)","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"parseSpMetadata"},{"kind":"text","text":"("},{"kind":"externalParam","text":"body"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK19ParseSamlSpMetadataV","kind":"typeIdentifier","text":"ParseSamlSpMetadata"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK19SamlSpMetadataDraftV","kind":"typeIdentifier","text":"SamlSpMetadataDraft"}],"symbolKind":"method","roleHeading":"Instance Method","title":"parseSpMetadata(body:)","externalID":"s:8AxiamSDK7SamlApiV15parseSpMetadata4bodyAA0cfG5DraftVAA05ParsecfG0V_tYaKF","modules":[{"name":"AxiamSDK"}],"role":"symbol"},"sections":[],"abstract":[{"code":"POST \/api\/v1\/tenants\/{tenant_id}\/saml\/parse-sp-metadata","type":"codeVoice"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/SamlApi/parseSpMetadata(body:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"parseSpMetadata","kind":"identifier"},{"text":"(","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK19ParseSamlSpMetadataV","text":"ParseSamlSpMetadata","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK19SamlSpMetadataDraftV","text":"SamlSpMetadataDraft","kind":"typeIdentifier"}],"type":"topic","abstract":[{"code":"POST \/api\/v1\/tenants\/{tenant_id}\/saml\/parse-sp-metadata","type":"codeVoice"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/parseSpMetadata(body:)","title":"parseSpMetadata(body:)","url":"\/documentation\/axiamsdk\/samlapi\/parsespmetadata(body:)"},"doc://AxiamSDK/documentation/AxiamSDK/SamlSpMetadataDraft":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlSpMetadataDraft","type":"topic","url":"\/documentation\/axiamsdk\/samlspmetadatadraft","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlSpMetadataDraft","kind":"identifier"}],"abstract":[{"text":"A parse of SP metadata: ","type":"text"},{"inlineContent":[{"text":"a draft, not a registration","type":"text"}],"type":"strong"},{"text":". Nothing is stored until the caller","type":"text"},{"text":" ","type":"text"},{"text":"submits ","type":"text"},{"type":"codeVoice","code":"service_provider"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"create_service_provider"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"update_service_provider"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"nothing in it is trusted because it came from a document (D-41).","type":"text"}],"navigatorTitle":[{"text":"SamlSpMetadataDraft","kind":"identifier"}],"role":"symbol","title":"SamlSpMetadataDraft"},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi":{"abstract":[{"type":"text","text":"A tenant’s SAML 2.0 identity provider (CONTRACT §29): the registry of service providers, the"},{"type":"text","text":" "},{"type":"text","text":"import of an SP’s metadata into a "},{"type":"emphasis","inlineContent":[{"text":"draft","type":"text"}]},{"type":"text","text":" registration (never a write), and the lifecycle of"},{"text":" ","type":"text"},{"text":"the IdP signing credential. The protocol itself – single sign-on, single logout, the IdP","type":"text"},{"text":" ","type":"text"},{"text":"metadata document – is browser and SP-to-IdP surface under \/saml\/v2\/{tenant_id}, an SP’s","type":"text"},{"text":" ","type":"text"},{"text":"own SAML library speaks to it, and it is not in this registry.","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlApi","kind":"identifier"}],"title":"SamlApi","kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/samlapi","navigatorTitle":[{"text":"SamlApi","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/ParseSamlSpMetadata":{"abstract":[{"type":"codeVoice","code":"POST …\/saml\/parse-sp-metadata"},{"type":"text","text":" body: "},{"type":"strong","inlineContent":[{"type":"text","text":"exactly one"}]},{"type":"text","text":" of the two members."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ParseSamlSpMetadata","kind":"identifier"}],"title":"ParseSamlSpMetadata","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ParseSamlSpMetadata","kind":"symbol","url":"\/documentation\/axiamsdk\/parsesamlspmetadata","navigatorTitle":[{"text":"ParseSamlSpMetadata","kind":"identifier"}],"type":"topic"}}}