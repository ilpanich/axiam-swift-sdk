tent":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"inlineContent":[{"text":"Parses and stores nothing","type":"text"}],"type":"strong"},{"text":" (§29.3 rule 6): the result is a draft to review and pass","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"createServiceProvider","type":"codeVoice"},{"text":". Exactly one of ","type":"text"},{"code":"metadataXml","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"metadataURL","type":"codeVoice"},{"text":" must be set","type":"text"},{"text":" ","type":"text"},{"text":"– build the body with ","type":"text"},{"code":"ParseSamlSpMetadata.fromURL(_:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".fromXML(_:)","type":"codeVoice"},{"text":"; both or","type":"text"},{"text":" ","type":"text"},{"text":"neither is refused locally, before any request. The metadata’s own signature is not","type":"text"},{"text":" ","type":"text"},{"text":"evaluated. ","type":"text"},{"code":"503","type":"codeVoice"},{"text":" in a server built without SAML.","type":"text"}],"type":"paragraph"}]}],"sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/parseSpMetadata(body:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi"]]},"abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/tenants\/{tenant_id}\/saml\/parse-sp-metadata"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/ParseSamlSpMetadata":{"role":"symbol","url":"\/documentation\/axiamsdk\/parsesamlspmetadata","abstract":[{"code":"POST …\/saml\/parse-sp-metadata","type":"codeVoice"},{"type":"text","text":" body: "},{"type":"strong","inlineContent":[{"text":"exactly one","type":"text"}]},{"type":"text","text":" of the two members."}],"title":"ParseSamlSpMetadata","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ParseSamlSpMetadata","kind":"identifier"}],"navigatorTitle":[{"text":"ParseSamlSpMetadata","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ParseSamlSpMetadata"},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi/parseSpMetadata(body:)":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/parseSpMetadata(body:)","abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/tenants\/{tenant_id}\/saml\/parse-sp-metadata"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"parseSpMetadata"},{"kind":"text","text":"("},{"kind":"externalParam","text":"body"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK19ParseSamlSpMetadataV","text":"ParseSamlSpMetadata"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK19SamlSpMetadataDraftV","text":"SamlSpMetadataDraft"}],"title":"parseSpMetadata(body:)","kind":"symbol","url":"\/documentation\/axiamsdk\/samlapi\/parsespmetadata(body:)","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/SamlSpMetadataDraft":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlSpMetadataDraft","kind":"identifier"}],"title":"SamlSpMetadataDraft","kind":"symbol","abstract":[{"text":"A parse of SP metadata: ","type":"text"},{"inlineContent":[{"type":"text","text":"a draft, not a registration"}],"type":"strong"},{"text":". Nothing is stored until the caller","type":"text"},{"text":" ","type":"text"},{"text":"submits ","type":"text"},{"code":"service_provider","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"create_service_provider","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"update_service_provider","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"nothing in it is trusted because it came from a document (D-41).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlSpMetadataDraft","url":"\/documentation\/axiamsdk\/samlspmetadatadraft","navigatorTitle":[{"text":"SamlSpMetadataDraft","kind":"identifier"}],"role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi":{"role":"symbol","abstract":[{"type":"text","text":"A tenant’s SAML 2.0 identity provider (CONTRACT §29): the registry of service providers, the"},{"type":"text","text":" "},{"type":"text","text":"import of an SP’s metadata into a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"draft"}]},{"type":"text","text":" registration (never a write), and the lifecycle of"},{"type":"text","text":" "},{"type":"text","text":"the IdP signing credential. The protocol itself – single sign-on, single logout, the IdP"},{"type":"text","text":" "},{"type":"text","text":"metadata document – is browser and SP-to-IdP surface under \/saml\/v2\/{tenant_id}, an SP’s"},{"type":"text","text":" "},{"type":"text","text":"own SAML library speaks to it, and it is not in this registry."}],"url":"\/documentation\/axiamsdk\/samlapi","title":"SamlApi","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SamlApi"}],"navigatorTitle":[{"kind":"identifier","text":"SamlApi"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi"}}}