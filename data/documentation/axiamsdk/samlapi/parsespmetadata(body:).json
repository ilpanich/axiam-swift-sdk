{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/parseSpMetadata(body:)"},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/samlapi\/parsespmetadata(body:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"code":"POST \/api\/v1\/tenants\/{tenant_id}\/saml\/parse-sp-metadata","type":"codeVoice"}],"metadata":{"role":"symbol","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK7SamlApiV15parseSpMetadata4bodyAA0cfG5DraftVAA05ParsecfG0V_tYaKF","title":"parseSpMetadata(body:)","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"parseSpMetadata"},{"kind":"text","text":"("},{"kind":"externalParam","text":"body"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK19ParseSamlSpMetadataV","kind":"typeIdentifier","text":"ParseSamlSpMetadata"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK19SamlSpMetadataDraftV","kind":"typeIdentifier","text":"SamlSpMetadataDraft"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"parseSpMetadata","kind":"identifier"},{"text":"(","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ParseSamlSpMetadata","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ParseSamlSpMetadata","preciseIdentifier":"s:8AxiamSDK19ParseSamlSpMetadataV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlSpMetadataDraft","text":"SamlSpMetadataDraft","preciseIdentifier":"s:8AxiamSDK19SamlSpMetadataDraftV","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The request body.","type":"text"}],"type":"paragraph"}],"name":"body"}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Parses and stores nothing"}]},{"type":"text","text":" (§29.3 rule 6): the result is a draft to review and pass"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"createServiceProvider"},{"type":"text","text":". Exactly one of "},{"type":"codeVoice","code":"metadataXml"},{"type":"text","text":" and "},{"type":"codeVoice","code":"metadataURL"},{"type":"text","text":" must be set"},{"type":"text","text":" "},{"type":"text","text":"– build the body with "},{"type":"codeVoice","code":"ParseSamlSpMetadata.fromURL(_:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":".fromXML(_:)"},{"type":"text","text":"; both or"},{"type":"text","text":" "},{"type":"text","text":"neither is refused locally, before any request. The metadata’s own signature is not"},{"type":"text","text":" "},{"type":"text","text":"evaluated. "},{"type":"codeVoice","code":"503"},{"type":"text","text":" in a server built without SAML."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi/parseSpMetadata(body:)":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/parseSpMetadata(body:)","kind":"symbol","title":"parseSpMetadata(body:)","type":"topic","abstract":[{"code":"POST \/api\/v1\/tenants\/{tenant_id}\/saml\/parse-sp-metadata","type":"codeVoice"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"parseSpMetadata"},{"kind":"text","text":"("},{"kind":"externalParam","text":"body"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8AxiamSDK19ParseSamlSpMetadataV","kind":"typeIdentifier","text":"ParseSamlSpMetadata"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:8AxiamSDK19SamlSpMetadataDraftV","kind":"typeIdentifier","text":"SamlSpMetadataDraft"}],"url":"\/documentation\/axiamsdk\/samlapi\/parsespmetadata(body:)"},"doc://AxiamSDK/documentation/AxiamSDK/ParseSamlSpMetadata":{"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ParseSamlSpMetadata","kind":"symbol","title":"ParseSamlSpMetadata","type":"topic","abstract":[{"code":"POST …\/saml\/parse-sp-metadata","type":"codeVoice"},{"text":" body: ","type":"text"},{"inlineContent":[{"type":"text","text":"exactly one"}],"type":"strong"},{"text":" of the two members.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseSamlSpMetadata"}],"url":"\/documentation\/axiamsdk\/parsesamlspmetadata","navigatorTitle":[{"kind":"identifier","text":"ParseSamlSpMetadata"}]},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi":{"url":"\/documentation\/axiamsdk\/samlapi","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SamlApi"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi","type":"topic","title":"SamlApi","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A tenant’s SAML 2.0 identity provider (CONTRACT §29): the registry of service providers, the"},{"type":"text","text":" "},{"type":"text","text":"import of an SP’s metadata into a "},{"type":"emphasis","inlineContent":[{"text":"draft","type":"text"}]},{"type":"text","text":" registration (never a write), and the lifecycle of"},{"type":"text","text":" "},{"type":"text","text":"the IdP signing credential. The protocol itself – single sign-on, single logout, the IdP"},{"type":"text","text":" "},{"type":"text","text":"metadata document – is browser and SP-to-IdP surface under \/saml\/v2\/{tenant_id}, an SP’s"},{"type":"text","text":" "},{"type":"text","text":"own SAML library speaks to it, and it is not in this registry."}],"navigatorTitle":[{"kind":"identifier","text":"SamlApi"}]},"doc://AxiamSDK/documentation/AxiamSDK/SamlSpMetadataDraft":{"navigatorTitle":[{"text":"SamlSpMetadataDraft","kind":"identifier"}],"type":"topic","title":"SamlSpMetadataDraft","abstract":[{"type":"text","text":"A parse of SP metadata: "},{"type":"strong","inlineContent":[{"type":"text","text":"a draft, not a registration"}]},{"type":"text","text":". Nothing is stored until the caller"},{"type":"text","text":" "},{"type":"text","text":"submits "},{"type":"codeVoice","code":"service_provider"},{"type":"text","text":" to "},{"type":"codeVoice","code":"create_service_provider"},{"type":"text","text":" or "},{"type":"codeVoice","code":"update_service_provider"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"nothing in it is trusted because it came from a document (D-41)."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlSpMetadataDraft","url":"\/documentation\/axiamsdk\/samlspmetadatadraft","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SamlSpMetadataDraft"}]}}}