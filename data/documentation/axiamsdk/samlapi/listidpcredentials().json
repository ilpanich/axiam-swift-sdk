he official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/SamlIdpCredential":{"type":"topic","navigatorTitle":[{"text":"SamlIdpCredential","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/samlidpcredential","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlIdpCredential","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The tenant’s IdP signing credential, "},{"type":"strong","inlineContent":[{"type":"text","text":"public facts only"}]},{"type":"text","text":". There is no key on it and no"},{"type":"text","text":" "},{"type":"text","text":"field a key could be put in: the private key is generated by the server, sealed at rest,"},{"type":"text","text":" "},{"type":"text","text":"never returned by any route and destroyed on retirement (D-21)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlIdpCredential","title":"SamlIdpCredential"},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi/listIdpCredentials()":{"url":"\/documentation\/axiamsdk\/samlapi\/listidpcredentials()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"listIdpCredentials"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"SamlIdpCredential","preciseIdentifier":"s:8AxiamSDK17SamlIdpCredentialV"},{"kind":"text","text":"]"}],"title":"listIdpCredentials()","type":"topic","abstract":[{"code":"GET \/api\/v1\/tenants\/{tenant_id}\/saml\/idp-credentials","type":"codeVoice"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/listIdpCredentials()","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi":{"url":"\/documentation\/axiamsdk\/samlapi","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SamlApi"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi","type":"topic","title":"SamlApi","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A tenant’s SAML 2.0 identity provider (CONTRACT §29): the registry of service providers, the"},{"type":"text","text":" "},{"type":"text","text":"import of an SP’s metadata into a "},{"type":"emphasis","inlineContent":[{"text":"draft","type":"text"}]},{"type":"text","text":" registration (never a write), and the lifecycle of"},{"type":"text","text":" "},{"type":"text","text":"the IdP signing credential. The protocol itself – single sign-on, single logout, the IdP"},{"type":"text","text":" "},{"type":"text","text":"metadata document – is browser and SP-to-IdP surface under \/saml\/v2\/{tenant_id}, an SP’s"},{"type":"text","text":" "},{"type":"text","text":"own SAML library speaks to it, and it is not in this registry."}],"navigatorTitle":[{"kind":"identifier","text":"SamlApi"}]}}}