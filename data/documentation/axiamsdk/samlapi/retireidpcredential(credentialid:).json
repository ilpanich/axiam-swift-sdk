:"AxiamSDK"}],"title":"retireIdpCredential(credentialID:)","roleHeading":"Instance Method","role":"symbol","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retireIdpCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"credentialID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"SamlIdpCredential","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17SamlIdpCredentialV"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi"]]},"sections":[],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/retireIdpCredential(credentialID:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/axiamsdk\/samlapi\/retireidpcredential(credentialid:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/SamlIdpCredential":{"type":"topic","navigatorTitle":[{"text":"SamlIdpCredential","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/samlidpcredential","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlIdpCredential","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The tenant’s IdP signing credential, "},{"type":"strong","inlineContent":[{"type":"text","text":"public facts only"}]},{"type":"text","text":". There is no key on it and no"},{"type":"text","text":" "},{"type":"text","text":"field a key could be put in: the private key is generated by the server, sealed at rest,"},{"type":"text","text":" "},{"type":"text","text":"never returned by any route and destroyed on retirement (D-21)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlIdpCredential","title":"SamlIdpCredential"},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi":{"url":"\/documentation\/axiamsdk\/samlapi","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SamlApi"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi","type":"topic","title":"SamlApi","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A tenant’s SAML 2.0 identity provider (CONTRACT §29): the registry of service providers, the"},{"type":"text","text":" "},{"type":"text","text":"import of an SP’s metadata into a "},{"type":"emphasis","inlineContent":[{"text":"draft","type":"text"}]},{"type":"text","text":" registration (never a write), and the lifecycle of"},{"type":"text","text":" "},{"type":"text","text":"the IdP signing credential. The protocol itself – single sign-on, single logout, the IdP"},{"type":"text","text":" "},{"type":"text","text":"metadata document – is browser and SP-to-IdP surface under \/saml\/v2\/{tenant_id}, an SP’s"},{"type":"text","text":" "},{"type":"text","text":"own SAML library speaks to it, and it is not in this registry."}],"navigatorTitle":[{"kind":"identifier","text":"SamlApi"}]},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi/retireIdpCredential(credentialID:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/retireIdpCredential(credentialID:)","url":"\/documentation\/axiamsdk\/samlapi\/retireidpcredential(credentialid:)","type":"topic","abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/tenants\/{tenant_id}\/saml\/idp-credentials\/{credential_id}\/retire