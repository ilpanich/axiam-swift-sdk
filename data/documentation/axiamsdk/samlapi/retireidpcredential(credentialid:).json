text":", wait until every SP has refreshed","type":"text"},{"text":" ","type":"text"},{"text":"the metadata, then promote.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/retireIdpCredential(credentialID:)"},"metadata":{"roleHeading":"Instance Method","role":"symbol","title":"retireIdpCredential(credentialID:)","symbolKind":"method","externalID":"s:8AxiamSDK7SamlApiV19retireIdpCredential12credentialIDAA0cfG0VSS_tYaKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retireIdpCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"credentialID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK17SamlIdpCredentialV","text":"SamlIdpCredential","kind":"typeIdentifier"}],"modules":[{"name":"AxiamSDK"}]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/SamlApi":{"navigatorTitle":[{"text":"SamlApi","kind":"identifier"}],"title":"SamlApi","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlApi","kind":"identifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi","abstract":[{"text":"A tenant’s SAML 2.0 identity provider (CONTRACT §29): the registry of service providers, the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"import of an SP’s metadata into a "},{"inlineContent":[{"type":"text","text":"draft"}],"type":"emphasis"},{"type":"text","text":" registration (never a write), and the lifecycle of"},{"type":"text","text":" "},{"type":"text","text":"the IdP signing credential. The protocol itself – single sign-on, single logout, the IdP"},{"type":"text","text":" "},{"type":"text","text":"metadata document – is browser and SP-to-IdP surface under \/saml\/v2\/{tenant_id}, an SP’s"},{"type":"text","text":" "},{"type":"text","text":"own SAML library speaks to it, and it is not in this registry."}],"url":"\/documentation\/axiamsdk\/samlapi","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/SamlIdpCredential":{"abstract":[{"type":"text","text":"The tenant’s IdP signing credential, "},{"type":"strong","inlineContent":[{"text":"public facts only","type":"text"}]},{"type":"text","text":". There is no key on it and no"},{"type":"text","text":" "},{"text":"field a key could be put in: the private key is generated by the server, sealed at rest,","type":"text"},{"text":" ","type":"text"},{"text":"never returned by any route and destroyed on retirement (D-21).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlIdpCredential","type":"topic","url":"\/documentation\/axiamsdk\/samlidpcredential","title":"SamlIdpCredential","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlIdpCredential","kind":"identifier"}],"navigatorTitle":[{"text":"SamlIdpCredential","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi/retireIdpCredential(credentialID:)":{"title":"retireIdpCredential(credentialID:)","type":"topic","url":"\/documentation\/axiamsdk\/samlapi\/retireidpcredential(credentialid:)","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retireIdpCredential","kind":"identifier"},{"text":"(","kind":"text"