xternalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"SamlIdpCredential","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17SamlIdpCredentialV"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/retireIdpCredential(credentialID:)","kind":"symbol","title":"retireIdpCredential(credentialID:)","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/SamlIdpCredential":{"type":"topic","abstract":[{"type":"text","text":"The tenant’s IdP signing credential, "},{"type":"strong","inlineContent":[{"type":"text","text":"public facts only"}]},{"type":"text","text":". There is no key on it and no"},{"type":"text","text":" "},{"type":"text","text":"field a key could be put in: the private key is generated by the server, sealed at rest,"},{"type":"text","text":" "},{"type":"text","text":"never returned by any route and destroyed on retirement (D-21)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlIdpCredential","kind":"symbol","url":"\/documentation\/axiamsdk\/samlidpcredential","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlIdpCredential","kind":"identifier"}],"navigatorTitle":[{"text":"SamlIdpCredential","kind":"identifier"}],"role":"symbol","title":"SamlIdpCredential"},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi":{"role":"symbol","type":"topic","navigatorTitle":[{"text":"SamlApi","kind":"identifier"}],"kind":"symbol","title":"SamlApi","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi","url":"\/documentation\/axiamsdk\/samlapi","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlApi","kind":"identifier"}],"abstract":[{"text":"A tenant’s SAML 2.0 identity provider (CONTRACT §29): the registry of service providers, the","type":"text"},{"text":" ","type":"text"},{"text":"import of an SP’s metadata into a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"draft","type":"text"}]},{"text":" registration (never a write), and the lifecycle of","type":"text"},{"text":" ","type":"text"},{"text":"the IdP signing credential. The protocol itself – single sign-on, single logout, the IdP","type":"text"},{"text":" ","type":"text"},{"text":"metadata document – is browser and SP-to-IdP surface under \/saml\/v2\/{tenant_id}, an SP’s","type":"text"},{"text":" ","type":"text"},{"text":"own SAML library speaks to it, and it is not in this registry.","type":"text"}]}}}