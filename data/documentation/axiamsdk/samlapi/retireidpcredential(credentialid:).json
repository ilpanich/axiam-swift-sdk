:"codeVoice","code":"{credential_id}"},{"text":" path parameter.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Retiring the ","type":"text"},{"code":"active","type":"codeVoice"},{"text":" credential with no successor stops SAML sign-on for the whole","type":"text"},{"text":" ","type":"text"},{"text":"tenant at once","type":"text"}]},{"type":"text","text":" (§29.3 rule 7) – it is the incident response to a leaked key. The key"},{"type":"text","text":" "},{"type":"text","text":"is destroyed. The safe rotation is: issue into "},{"type":"codeVoice","code":"next"},{"type":"text","text":", wait until every SP has refreshed"},{"type":"text","text":" "},{"type":"text","text":"the metadata, then promote."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/axiamsdk\/samlapi\/retireidpcredential(credentialid:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"url":"\/documentation\/axiamsdk","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"title":"AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi/retireIdpCredential(credentialID:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retireIdpCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"credentialID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"SamlIdpCredential","kind":"typeIdentifier","preciseIdentifier":"s:8AxiamSDK17SamlIdpCredentialV"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi\/retireIdpCredential(credentialID:)","title":"retireIdpCredential(credentialID:)","url":"\/documentation\/axiamsdk\/samlapi\/retireidpcredential(credentialid:)","type":"topic","kind":"symbol","abstract":[{"type":"codeVoice","code":"POST \/api\/v1\/tenants\/{tenant_id}\/saml\/idp-credentials\/{credential_id}\/retire"}]},"doc://AxiamSDK/documentation/AxiamSDK/SamlApi":{"abstract":[{"type":"text","text":"A tenant’s SAML 2.0 identity provider (CONTRACT §29): the registry of service providers, the"},{"type":"text","text":" "},{"type":"text","text":"import of an SP’s metadata into a "},{"type":"emphasis","inlineContent":[{"text":"draft","type":"text"}]},{"type":"text","text":" registration (never a write), and the lifecycle of"},{"type":"text","text":" "},{"type":"text","text":"the IdP signing credential. The protocol itself – single sign-on, single logout, the IdP"},{"type":"text","text":" "},{"type":"text","text":"metadata document – is browser and SP-to-IdP surface under \/saml\/v2\/{tenant_id}, an SP’s"},{"type":"text","text":" "},{"type":"text","text":"own SAML library speaks to it, and it is not in this registry."}],"kind":"symbol","role":"symbol","url":"\/documentation\/axiamsdk\/samlapi","navigatorTitle":[{"text":"SamlApi","kind":"identifier"}],"title":"SamlApi","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlApi","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/SamlIdpCredential":{"url":"\/documentation\/axiamsdk\/samlidpcredential","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamlIdpCredential","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"SamlIdpCredential","kind":"identifier"}],"title":"SamlIdpCredential","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlIdpCredential","type":"topic","role":"symbol","abstract":[{"text":"The tenant’s IdP signing credential, ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"public facts only"}]},{"text":". There is no key on it and no","type":"text"},{"text":" ","type":"text"},{"text":"field a key could be put in: the private key is generated by the server, sealed at rest,","type":"text"},{"text":" ","type":"text"},{"text":"never returned by any route and destroyed on retirement (D-21).","type":"text"}]}}}