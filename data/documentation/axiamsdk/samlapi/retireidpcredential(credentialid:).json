elf – single sign-on, single logout, the IdP"},{"type":"text","text":" "},{"type":"text","text":"metadata document – is browser and SP-to-IdP surface under \/saml\/v2\/{tenant_id}, an SP’s"},{"type":"text","text":" "},{"type":"text","text":"own SAML library speaks to it, and it is not in this registry."}],"url":"\/documentation\/axiamsdk\/samlapi","title":"SamlApi","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SamlApi"}],"navigatorTitle":[{"kind":"identifier","text":"SamlApi"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SamlApi"}}}