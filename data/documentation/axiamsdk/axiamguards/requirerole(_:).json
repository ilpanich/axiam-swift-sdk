 "},{"type":"text","text":"requested the "},{"type":"codeVoice","code":"roles"},{"type":"text","text":" scope and has it registered; register it on the client and request"},{"type":"text","text":" "},{"type":"text","text":"it, or every "},{"type":"codeVoice","code":"requireRole"},{"type":"text","text":" is a 403."}]}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/AxiamGuardHandler":{"navigatorTitle":[{"kind":"identifier","text":"AxiamGuardHandler"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AxiamGuardHandler","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxiamGuardHandler"}],"title":"AxiamGuardHandler","abstract":[{"type":"text","text":"A guard handler: given an inbound request context, return the authenticated user or throw."}],"url":"\/documentation\/axiamsdk\/axiamguardhandler","kind":"symbol","role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AuthzError":{"navigatorTitle":[{"kind":"identifier","text":"AuthzError"}],"url":"\/documentation\/axiamsdk\/authzerror","title":"AuthzError","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthzError"}],"kind":"symbol","abstract":[{"text":"Authorization failure (§2). Carries a ","type":"text"},{"type":"codeVoice","code":"message"},{"text":" and, when the server provided them,","type":"text"},{"text":" ","type":"text"},{"text":"the denied ","type":"text"},{"type":"codeVoice","code":"action"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"resourceID"},{"text":".","type":"text"}],"identifier":"doc:\/\/