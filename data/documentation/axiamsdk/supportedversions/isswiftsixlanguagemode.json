{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions"]]},"metadata":{"externalID":"s:8AxiamSDK17SupportedVersionsO22isSwiftSixLanguageModeSbvpZ","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isSwiftSixLanguageMode","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"title":"isSwiftSixLanguageMode","role":"symbol","symbolKind":"property","roleHeading":"Type Property","modules":[{"name":"AxiamSDK"}]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SupportedVersions\/isSwiftSixLanguageMode"},"abstract":[{"type":"text","text":"Whether "},{"type":"strong","inlineContent":[{"type":"text","text":"this library"}]},{"type":"text","text":" was compiled in Swift 6 language mode."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isSwiftSixLanguageMode","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"code":"true","type":"codeVoice"},{"type":"text","text":" when built by a 6.0+ toolchain, which selects "},{"code":"Package@swift-6.0.swift","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"its per-target language-mode setting. Reported rather than assumed, because the"},{"type":"text","text":" "},{"type":"text","text":"difference is invisible from the outside and decides whether the concurrency"},{"type":"text","text":" "},{"type":"text","text":"guarantees were checked or merely intended."}],"type":"paragraph"},{"inlineContent":[{"text":"This reads the ","type":"text"},{"inlineContent":[{"type":"text","text":"language mode"}],"type":"emphasis"},{"text":", not the toolchain: ","type":"text"},{"type":"codeVoice","code":"#if swift(>=6.0)"},{"text":" tests the","type":"text"},{"text":" ","type":"text"},{"text":"former and ","type":"text"},{"type":"codeVoice","code":"#if compiler(>=6.0)"},{"text":" the latter, and they genuinely differ in this","type":"text"},{"text":" ","type":"text"},{"text":"package. On a 6.x toolchain the library and the examples are built in Swift 6","type":"text"},{"text":" ","type":"text"},{"text":"mode while the test target is deliberately still built in Swift 5 mode — the","type":"text"},{"text":" ","type":"text"},{"text":"library and examples compile clean under full strict-concurrency checking and the","type":"text"},{"text":" ","type":"text"},{"text":"test harness does not, so scoping the mode to the targets that actually ship is","type":"text"},{"text":" ","type":"text"},{"text":"what makes the guarantee about the artifact you get rather than about a rewrite of","type":"text"},{"text":" ","type":"text"},{"text":"the test suite.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/supportedversions\/isswiftsixlanguagemode"]}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/SupportedVersions":{"type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SupportedVersions"}],"title":"SupportedVersions","role":"symbol","abstract":[{"type":"text","text":"The range of Swift versions this SDK is built and tested against."}],"navigatorTitle":[{"kind":"identifier","text":"SupportedVersions"}],"identifier":"doc:\