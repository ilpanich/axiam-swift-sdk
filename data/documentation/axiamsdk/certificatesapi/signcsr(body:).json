xiamSDK\/documentation\/AxiamSDK\/Certificate","role":"symbol","abstract":[{"type":"text","text":"A tenant-level certificate for users, services, or IoT devices. Certificates are signed by"},{"type":"text","text":" "},{"type":"text","text":"the organization’s CA. The private key is returned once on generation and never stored by"},{"type":"text","text":" "},{"type":"text","text":"AXIAM."}],"title":"Certificate"},"doc://AxiamSDK/documentation/AxiamSDK/CertificatesApi":{"url":"\/documentation\/axiamsdk\/certificatesapi","navigatorTitle":[{"kind":"identifier","text":"CertificatesApi"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CertificatesApi"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CertificatesApi","role":"symbol","abstract":[{"text":"End-entity X.509 certificates – the ones issued to users, services and IoT devices.","type":"text"}],"title":"CertificatesApi"},"doc://AxiamSDK/documentation/AxiamSDK/SignCertificateCsrRequest":{"url":"\/documentation\/axiamsdk\/signcertificatecsrrequest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SignCertificateCsrRequest"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SignCertificateCsrRequest"}],"title":"SignCertificateCsrRequest","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SignCertificateCsrRequest","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Body of "},{"type":"codeVoice","code":"POST \/api\/v1\/certificates\/sign-csr"},{"type":"text","text":". No "},{"type":"codeVoice","code":"subject"},{"type":"text","text":" and no "},{"type":"codeVoice","code":"key_algorithm"},{"type":"text","text":": both are"},{"type":"text","text":" "},{"type":"text","text":"read out of the CSR, which is the only place they can be stated without the row and the"},{"type":"text","text":" "},{"type":"text","text":"certificate being able to disagree. No key is returned, so there is no key field anywhere on"},{"type":"text","text":" "},{"type":"text","text":"this exchange. The CSR’s common name meets the rules of "},{"type":"codeVoice","code":"subject"},{"type":"text","text":" on "},{"type":"codeVoice","code":"POST \/api\/v1\/certificates"},{"type":"text","text":" (printable, at most 64 characters) and is refused, not rewritten, when"},{"type":"text","text":" "},{"type":"text","text":"it does not. So does the value of every other attribute of the CSR’s subject, and a subject"},{"type":"text","text":" "},{"type":"text","text":"with more than one common name is refused."}]}}}