{"kind":"symbol","relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP"],"kind":"relationships","type":"conformsTo"}],"abstract":[{"type":"text","text":"How a CIBA client learns that a request has been decided (CIBA Core §5). "},{"type":"codeVoice","code":"push"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"deliberately absent: AXIAM does not offer it, and the FAPI-CIBA profile forbids it — push"},{"type":"text","text":" "},{"type":"text","text":"delivers the tokens themselves to a client endpoint, which makes the notification endpoint a"},{"type":"text","text":" "},{"type":"text","text":"token sink."}],"metadata":{"role":"symbol","title":"CibaDeliveryMode","externalID":"s:8AxiamSDK16CibaDeliveryModeO","modules":[{"name":"AxiamSDK"}],"symbolKind":"enum","navigatorTitle":[{"kind":"identifier","text":"CibaDeliveryMode"}],"roleHeading":"Enumeration","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CibaDeliveryMode"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/cibadeliverymode"]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaDeliveryMode\/ping","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaDeliveryMode\/poll","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaDeliveryMode\/unknown"]},{"title":"Initializers","identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaDeliveryMode\/init(from:)-fq7f","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/CibaDeliveryMode\/init(rawValue:)"]},{"title":"Instance Methods","identifiers":["doc:\/\/AxiamSDK\/documentation\/A