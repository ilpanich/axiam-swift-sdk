{"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"An "},{"type":"strong","inlineContent":[{"text":"open","type":"text"}]},{"type":"text","text":" enum. A value this SDK’s copy of the spec does not list decodes to "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" "},{"type":"text","text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there"},{"type":"text","text":" "},{"type":"text","text":"fails the WHOLE response, so one field of one record would take down the page it was on,"},{"type":"text","text":" "},{"type":"text","text":"including the records the caller did ask for."}],"type":"paragraph"},{"inlineContent":[{"text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to","type":"text"},{"text":" ","type":"text"},{"text":"be first turns a new server state into a wrong one, and on this surface these values gate","type":"text"},{"text":" ","type":"text"},{"text":"access. ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":"’s own raw value is the empty string, which no server value is, so","type":"text"},{"text":" ","type":"text"},{"text":"carrying an unrecognised value back into an update is refused by the server rather than","type":"text"},{"text":" ","type":"text"},{"text":"written as a spelling it never used. A ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over these cases needs an ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" arm.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"metadata":{"modules":[{"name":"AxiamSDK"}],"role":"symbol","navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"