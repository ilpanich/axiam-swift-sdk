pe":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"type":"reference","isActive":true,"identifier":"Self::Standard"},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/clientprofile"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"inlineContent":[{"type":"text","text":"open"}],"type":"strong"},{"text":" enum. A value this SDK’s copy of the spec does not list decodes to ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there","type":"text"},{"text":" ","type":"text"},{"text":"fails the WHOLE response, so one field of one record would take down the page it was on,","type":"text"},{"text":" ","type":"text"},{"text":"including the records the caller did ask for.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN