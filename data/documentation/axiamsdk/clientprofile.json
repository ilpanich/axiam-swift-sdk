ion, mandatory sender-constrained tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather","type":"text"},{"text":" ","type":"text"},{"text":"than a dozen independent booleans means an operator cannot register a client that is","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"nearly","type":"text"}]},{"text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one","type":"text"},{"text":" ","type":"text"},{"text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour","type":"text"},{"text":" ","type":"text"},{"text":"change at all, because ","type":"text"},{"identifier":"Self::Standard","type":"reference","isActive":true},{"text":" is the serde default and every row","type":"text"},{"text":" ","type":"text"},{"text":"written before schema v38 decodes to it.","type":"text"}],"references":{"doc://AxiamSDK/SY":{"type":"unresolvable","title":"Swift.RawRepresentable","identifier":"doc:\/\/AxiamSDK\/SY"},"doc://AxiamSDK/SE":{"type":"unresolvable","title":"Swift.Encodable","identifier":"doc:\/\/AxiamSDK\/SE"},"doc://AxiamSDK/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/AxiamSDK\/s8SendableP"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/unknown":{"type":"topic","role":"symbol","url":"\/documentation\/axiamsdk\/clientprofile\/unknown","kind":"symbol","title":"ClientProfile.unknown","abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/unknown","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}]},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/RawRepresentable-Implementations":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientPr