{"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/fapi2","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/standard","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/unknown"],"title":"Enumeration Cases"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/init(from:)-757he","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/init(rawValue:)"],"title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/RawRepresentable-Implementations"],"title":"Default Implementations"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"Which security posture a client is registered under (X5.1). This is the FAPI “one switch”."},{"type":"text","text":" "},{"type":"text","text":"FAPI 2.0 is not a single feature but a bundle of constraints — mandatory PAR, mandatory PKCE"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"S256"},{"type":"text","text":", mandatory strong client authentication, mandatory sender-constrained tokens,"},{"type":"text","text":" "},{"type":"text","text":"and a refusal of every relaxation the base specs permit. Encoding them as one profile rather"},{"type":"text","text":" "},{"type":"text","text":"than a dozen independent booleans means an operator cannot register a client that is"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"nearly"}]},{"type":"text","text":" FAPI, and a reviewer can answer “is this client financial-grade?” by reading one"},{"type":"text","text":" "},{"type":"text","text":"field. The same philosophy as the rate-limit postures: ordinary clients see no behaviour"},{"type":"text","text":" "},{"type":"text","text":"change at all, because "},{"type":"reference","identifier":"Self::Standard","isActive":true},{"type":"text","text":" is the serde default and every row"},{"type":"text","text":" "},{"type":"text","text":"written before schema v38 decodes to it."}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP"],"title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"An "},{"inlineContent":[{"type":"text","text":"open"}],"type":"strong"},{"type":"text","text":" enum. A value this SDK’s copy of the spec does not list decodes to "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" "},{"type":"text","text":"rather than failing the response it arrived in (CONTRACT.md §27.11 rule 1). Throwing there"},{"type":"text","text":" "},{"type":"text","text":"fails the WHOLE response, so one field of one record would take down the page it was on,"},{"type":"text","text":" "},{"type":"text","text":"including the records the caller did ask for."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is never read as one of the KNOWN cases: reading a new value as whichever case happens to"},{"type":"text","text":" "},{"type":"text","text":"be first turns a new server state into a wrong one, and on this surface these values gate"},{"type":"text","text":" "},{"type":"text","text":"access. "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"’s own raw value is the empty string, which no server value is, so"},{"type":"text","text":" "},{"type":"text","text":"carrying an unrecognised value back into an update is refused by the server rather than"},{"type":"text","text":" "},{"type":"text","text":"written as a spelling it never used. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/axiamsdk\/clientprofile"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"enum","role":"symbol","title":"ClientProfile","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK13ClientProfileO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientProfile","kind":"identifier"}],"navigatorTitle":[{"text":"ClientProfile","kind":"identifier"}],"roleHeading":"Enumeration"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/Equatable-Implementations":{"title":"Equatable Implementations","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/Equatable-Implementations","kind":"article","abstract":[],"type":"topic","url":"\/documentation\/axiamsdk\/clientprofile\/equatable-implementations","role":"collectionGroup"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/standard":{"title":"ClientProfile.standard","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"standard"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/standard","kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/axiamsdk\/clientprofile\/standard","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ClientProfile/init(from:)-757he":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ClientProfile\/init(from:)-757he","url":"\/documentation\/axiamsdk\/clientprofil