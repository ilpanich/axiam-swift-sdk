{"metadata":{"roleHeading":"Instance Method","externalID":"s:8AxiamSDK13ReactorRouterV2on10eventNamed_ySS_AA0C8DecisionOSgAA0C5EventVYaYbKctKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"on","kind":"identifier"},{"text":"(","kind":"text"},{"text":"eventNamed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"ReactorHandler","preciseIdentifier":"s:8AxiamSDK14ReactorHandlera","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"modules":[{"name":"AxiamSDK"}],"symbolKind":"method","role":"symbol","title":"on(eventNamed:_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/reactorrouter\/on(eventnamed:_:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"on"},{"kind":"text","text":"("},{"kind":"externalParam","text":"eventNamed"},{"kind":"text","text":" "},{"kind":"internalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"handler"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"preciseIdentifier":"s:8AxiamSDK14ReactorHandlera","kind":"typeIdentifier","text":"ReactorHandler","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorHandler"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"name":"Throws","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorBindingError\/unknownEvent(_:)","type":"reference","isActive":true},{"text":" when the name is not in","type":"text"},{"text":" ","type":"text"},{"text":"the §22.5 registry — AT BIND TIME, not at dispatch time (rule 2).","type":"text"},{"text":" ","type":"text"},{"text":"Failing when the binding is written is the entire point: a typo that","type":"text"},{"text":" ","type":"text"},{"text":"survives to production is discovered as silence, and silence on a","type":"text"},{"text":" ","type":"text"},{"code":"fail_open","type":"codeVoice"},{"text":" event is indistinguishable from a healthy reactor with","type":"text"},{"text":" ","type":"text"},{"text":"nothing to say.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This is also how §22.7’s three hot-path operations are refused: they are","type":"text"},{"text":" ","type":"text"},{"text":"in no registry row, so they fail like any other unknown name. There is","type":"text"},{"text":" ","type":"text"},{"text":"deliberately no separate hot-path list to produce a more specific","type":"text"},{"text":" ","type":"text"},{"text":"message — that list would be a constant naming them, which §22.13’s","type":"text"},{"text":" ","type":"text"},{"text":"hot-path assertion forbids.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The strongly-typed "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/on(_:_:)"},{"type":"text","text":" above cannot reach this case at all,"},{"type":"text","text":" "},{"type":"text","text":"which is the better default: the compiler refuses the typo."}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/on(eventNamed:_:)"},"sections":[],"abstract":[{"text":"Bind by NAME, for a reactor whose event list is configuration rather than","type":"text"},{"text":" ","type":"text"},{"text":"source.","type":"text"}],"kind":"symbol","references":{"doc://AxiamSDK/documentation/AxiamSDK/ReactorRouter/on(eventNamed:_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"on","kind":"identifier"},{"text":"(","kind":"text"},{"text":"eventNamed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"ReactorHandler","preciseIdentifier":"s:8AxiamSDK14ReactorHandlera","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol","role":"symbol","type":"topic","title":"on(eventNamed:_:)","abstract":[{"text":"Bind by NAME, for a reactor whose event list is configuration rather than","type":"text"},{"text":" ","type":"text"},{"text":"source.","type":"text"}],"url":"\/documentation\/axiamsdk\/reactorrouter\/on(eventnamed:_:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/on(eventNamed:_:)"},"doc://AxiamSDK/documentation/AxiamSDK/ReactorBindingError/unknownEvent(_:)":{"url":"\/documentation\/axiamsdk\/reactorbindingerror\/unknownevent(_:)","kind":"symbol","abstract":[{"type":"text","text":"A name outside the §22.5 registry, refused AT BIND TIME."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorBindingError\/unknownEvent(_:)","type":"topic","role":"symbol","title":"ReactorBindingError.unknownEvent(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknownEvent","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK/ReactorHandler":{"title":"ReactorHandler","abstract":[{"text":"One function fr