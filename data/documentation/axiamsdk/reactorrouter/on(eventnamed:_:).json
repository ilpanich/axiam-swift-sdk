{"metadata":{"role":"symbol","title":"on(eventNamed:_:)","externalID":"s:8AxiamSDK13ReactorRouterV2on10eventNamed_ySS_AA0C8DecisionOSgAA0C5EventVYaYbKctKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"on","kind":"identifier"},{"text":"(","kind":"text"},{"text":"eventNamed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"ReactorHandler","preciseIdentifier":"s:8AxiamSDK14ReactorHandlera","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"AxiamSDK"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/reactorrouter\/on(eventnamed:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"on"},{"kind":"text","text":"("},{"kind":"externalParam","text":"eventNamed"},{"kind":"text","text":" "},{"kind":"internalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"handler"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"preciseIdentifier":"s:8AxiamSDK14ReactorHandlera","kind":"typeIdentifier","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorHandler","text":"ReactorHandler"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorBindingError\/unknownEvent(_:)","isActive":true},{"text":" when the name is not in","type":"text"},{"text":" ","type":"text"},{"text":"the §22.5 registry — AT BIND TIME, not at dispatch time (rule 2).","type":"text"},{"text":" ","type":"text"},{"text":"Failing when the binding is written is the entire point: a typo that","type":"text"},{"text":" ","type":"text"},{"text":"survives to production is discovered as silence, and silence on a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"fail_open"},{"text":" event is indistinguishable from a healthy reactor with","type":"text"},{"text":" ","type":"text"},{"text":"nothing to say.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is also how §22.7’s three hot-path operations are refused: they are"},{"type":"text","text":" "},{"type":"text","text":"in no registry row, so they fail like any other unknown name. There is"},{"type":"text","text":" "},{"type":"text","text":"deliberately no separate hot-path list to produce a more specific"},{"type":"text","text":" "},{"type":"text","text":"message — that list would be a constant naming them, which §22.13’s"},{"type":"text","text":" "},{"type":"text","text":"hot-path assertion forbids."}],"type":"paragraph"},{"inlineContent":[{"text":"The strongly-typed ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/on(_:_:)"},{"text":" above cannot reach this case at all,","type":"text"},{"text":" ","type":"text"},{"text":"which is the better default: the compiler refuses the typo.","type":"text"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/Reactor