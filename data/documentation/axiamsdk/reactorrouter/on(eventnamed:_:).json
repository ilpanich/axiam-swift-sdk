:" "},{"type":"text","text":"which is the better default: the compiler refuses the typo."}]}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ReactorRouter\/on(eventNamed:_:)","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/reactorServe(config:transport:handler:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/reactorServe(config:transport:handler:)","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reactorServe","kind":"identifier"},{"text":"(","kind":"text"},{"text":"config","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK13ReactorConfigV","text":"ReactorConfig","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK16ReactorTransportP","text":"ReactorTransport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"handler","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8AxiamSDK14ReactorHandlera","text":"ReactorHandler","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol","title":"reactorServe(config:transport:handler:)","url":"\/documentation\/axiamsdk\/reactorserve(config:transport:handler:)","abstract":[{"type":"text","text":"Consume, verify, dispatch, sign, publish — until the transport is done."}]},"doc://AxiamSDK/documentation/AxiamSDK/ReactorRouter/on(eventNamed:_:)":{"url":"\/documentation\/axiamsdk\/reactorrouter\/on(eventnamed:_:)","role":"symbol","abstract":[{"type":"text","text":"Bind by NAME, for a reactor whose event list is configuration rather than"},{"type":"text","text":" "},{"type":"text","text":"source."}],"kind":"symbol","title":"on(eventNamed:_:)","type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/Ax