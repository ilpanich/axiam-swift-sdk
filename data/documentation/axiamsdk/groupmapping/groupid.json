{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping\/groupID"},"kind":"symbol","abstract":[{"text":"The AXIAM group of the same tenant a member of that directory group is put into. Checked","type":"text"},{"text":" ","type":"text"},{"text":"to exist in the tenant when the configuration is written.","type":"text"}],"metadata":{"role":"symbol","symbolKind":"property","modules":[{"name":"AxiamSDK"}],"title":"groupID","roleHeading":"Instance Property","externalID":"s:8AxiamSDK12GroupMappingV7groupIDSSvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"groupID","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/groupmapping\/groupid"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"abstract":[{"text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its","type":"text"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"inlineContent":[{"text":"The table is the only","type":"text"},{"text":" ","type":"text"},{"text":"way a directory group reaches an AXIAM group.","type":"text"}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"type":"codeVoice","code":"admins"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"axiam_directory::dn"},{"text":"), so ","type":"text"},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}],"title":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","url":"\/documentation\/axiamsdk\/groupmapping","kind":"symbol","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping/groupID":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"type":"topic","abstract":[{"type":"text","text":"The AXIAM group of the same tenant a member of that directory group is put into. Checked"},{"type":"text","text":" "},{"type":"text","text":"to exist in the tenant when the configuration is written."}],"role":"symbol","title":"groupID","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping\/groupID","kind":"symbol","url":"\/documentation\/axiamsdk\/groupmapping\/groupid"}}}