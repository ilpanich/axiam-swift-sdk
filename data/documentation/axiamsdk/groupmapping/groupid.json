{"metadata":{"symbolKind":"property","externalID":"s:8AxiamSDK12GroupMappingV7groupIDSSvp","roleHeading":"Instance Property","modules":[{"name":"AxiamSDK"}],"role":"symbol","title":"groupID","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}]},"kind":"symbol","abstract":[{"type":"text","text":"The AXIAM group of the same tenant a member of that directory group is put into. Checked"},{"type":"text","text":" "},{"type":"text","text":"to exist in the tenant when the configuration is written."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping\/groupID","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/axiamsdk\/groupmapping\/groupid"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"languages":["swift"]}],"kind":"declarations"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"kind":"symbol","url":"\/documentation\/axiamsdk\/groupmapping","type":"topic","navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"abstract":[{"text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its","type":"text"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"axiam_directory::dn","type":"codeVoice"},{"text":"), so ","type":"text"},{"code":"CN=Staff, OU=Groups","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cn=staff,ou=groups","type":"codeVoice"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"title":"GroupMapping","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping/groupID":{"kind":"symbol","url":"\/documentation\/axiamsdk\/groupmapping\/groupid","type":"topic","title":"groupID","abstract":[{"type":"text","text":"The AXIAM group of the same tenant a member of that directory group is put into. Checked"},{"type":"text","text":" "},{"type":"text","text":"to exist in the tenant when the configuration is written."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\