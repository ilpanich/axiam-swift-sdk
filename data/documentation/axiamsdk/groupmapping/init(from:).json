{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Inherited from ","type":"text"},{"code":"Decodable.init(from:)","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/groupmapping\/init(from:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"decoder"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"languages":["swift"]}]}],"metadata":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"symbolKind":"init","roleHeading":"Initializer","role":"symbol","title":"init(from:)","modules":[{"name":"AxiamSDK"}],"externalID":"s:8AxiamSDK12GroupMappingV4fromACs7Decoder_p_tKcfc"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"]]},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping\/init(from:)"},"references":{"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"role":"symbol","url":"\/documentation\/axiamsdk\/groupmapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","type":"topic","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"text":"way a directory group reaches an AXIAM group.","type":"text"}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"title":"GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping/init(from:)":{"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping\/init(from:)","url":"\/documentation\/axiamsdk\/groupmapping\/init(from:)","role":"symbol","abstract":[],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"title":"init(from:)","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"role":"collection","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","title":"AxiamSDK","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"}}}