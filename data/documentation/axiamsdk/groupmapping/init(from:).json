{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"decoder"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}]}]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"text":"Inherited from ","type":"text"},{"type":"codeVoice","code":"Decodable.init(from:)"},{"text":".","type":"text"}],"metadata":{"roleHeading":"Initializer","title":"init(from:)","symbolKind":"init","role":"symbol","externalID":"s:8AxiamSDK12GroupMappingV4fromACs7Decoder_p_tKcfc","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"modules":[{"name":"AxiamSDK"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/groupmapping\/init(from:)"]}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping\/init(from:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping/init(from:)":{"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping\/init(from:)","title":"init(from:)","url":"\/documentation\/axiamsdk\/groupmapping\/init(from:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"abstract":[],"kind":"symbol","type":"topic","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroupMapping"}],"title":"GroupMapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"type":"text","text":" "},{"type":"text","text":"distinguished name, and the AXIAM group a member of it is put into. "},{"type":"strong","inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}]},{"type":"text","text":" There is no match by name, no prefix or"},{"type":"text","text":" "},{"type":"text","text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator"},{"type":"text","text":" "},{"type":"text","text":"who names a group "},{"type":"codeVoice","code":"admins"},{"type":"text","text":" gains nothing unless a tenant administrator mapped it here. The"},{"type":"text","text":" "},{"type":"text","text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"type":"text","text":" are the same row."},{"type":"text","text":" "},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"GroupMapping"}],"url":"\/documentation\/axiamsdk\/groupmapping","role":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"}}}