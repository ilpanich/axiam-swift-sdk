{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping\/encode(to:)"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"]]},"variants":[{"paths":["\/documentation\/axiamsdk\/groupmapping\/encode(to:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Method","role":"symbol","title":"encode(to:)","symbolKind":"method","externalID":"s:8AxiamSDK12GroupMappingV6encode2toys7Encoder_p_tKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:s7EncoderP","text":"Encoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"modules":[{"name":"AxiamSDK"}]},"kind":"symbol","abstract":[{"type":"text","text":"Inherited from "},{"code":"Encodable.encode(to:)","type":"codeVoice"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"encode"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"encoder"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7EncoderP","text":"Encoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}]}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"kind":"symbol","url":"\/documentation\/axiamsdk","role":"collection","title":"AxiamSDK","type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}],"abstract":[{"text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its","type":"text"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"inlineContent":[{"type":"text","text":"The table is the only"},{"type":"text","text":" "},{"type":"text","text":"way a directory group reaches an AXIAM group."}],"type":"strong"},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"axiam_directory::dn"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"CN=Staff, OU=Groups"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cn=staff,ou=groups"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as","type":"text"},{"text":" ","type":"text"},{"text":"redundant.","type":"text"}],"kind":"symbol","title":"GroupMapping","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"url":"\/documentation\/axiamsdk\/groupmapping","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping/encode(to:)":{"type":"topi