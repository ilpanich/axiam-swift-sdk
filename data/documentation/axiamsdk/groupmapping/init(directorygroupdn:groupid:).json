{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping\/init(directoryGroupDn:groupID:)"},"kind":"symbol","variants":[{"paths":["\/documentation\/axiamsdk\/groupmapping\/init(directorygroupdn:groupid:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"symbolKind":"init","roleHeading":"Initializer","externalID":"s:8AxiamSDK12GroupMappingV09directoryC2Dn7groupIDACSS_SStcfc","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"directoryGroupDn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"groupID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(directoryGroupDn:groupID:)","role":"symbol","modules":[{"name":"AxiamSDK"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"directoryGroupDn"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"groupID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}],"languages":["swift"]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping":{"abstract":[{"type":"text","text":"One row of the group-mapping table (G-3, T23.3.4, D-30): a directory group, named by its"},{"text":" ","type":"text"},{"text":"distinguished name, and the AXIAM group a member of it is put into. ","type":"text"},{"type":"strong","inlineContent":[{"text":"The table is the only","type":"text"},{"text":" ","type":"text"},{"text":"way a directory group reaches an AXIAM group.","type":"text"}]},{"text":" There is no match by name, no prefix or","type":"text"},{"text":" ","type":"text"},{"text":"wildcard, and no AXIAM group is ever created from a directory one: a directory administrator","type":"text"},{"text":" ","type":"text"},{"text":"who names a group ","type":"text"},{"code":"admins","type":"codeVoice"},{"text":" gains nothing unless a tenant administrator mapped it here. The","type":"text"},{"text":" ","type":"text"},{"text":"DN is stored as the administrator typed it and compared after RFC 4514 normalisation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"axiam_directory::dn","type":"codeVoice"},{"text":"), so ","type":"text"},{"code":"CN=Staff, OU=Groups","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cn=staff,ou=groups","type":"codeVoice"},{"text":" are the same row.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"One DN may map to several AXIAM groups; the same (DN, group) pair twice is refused as"},{"type":"text","text":" "},{"type":"text","text":"redundant."}],"url":"\/documentation\/axiamsdk\/groupmapping","type":"topic","kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping","title":"GroupMapping","role":"symbol","navigatorTitle":[{"text":"GroupMapping","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupMapping","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","abstract":[{"type":"text","text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management)."}],"url":"\/documentation\/axiamsdk","kind":"symbol","title":"AxiamSDK","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK"},"doc://AxiamSDK/documentation/AxiamSDK/GroupMapping/init(directoryGroupDn:groupID:)":{"abstract":[],"type":"topic","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"directoryGroupDn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"groupID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(directoryGroupDn:groupID:)","role":"symbol","url":"\/documentation\/axiamsdk\/groupmapping\/init(directorygroupdn:groupid:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/GroupMapping\/init(directoryGroupDn:groupID:)"}}}