r to refuse. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/axiamsdk\/attributesource"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"AttributeSource"}],"role":"symbol","title":"AttributeSource","symbolKind":"enum","modules":[{"name":"AxiamSDK"}],"roleHeading":"Enumeration","externalID":"s:8AxiamSDK15AttributeSourceO","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AttributeSource"}]},"kind":"symbol","references":{"doc://AxiamSDK/SH":{"identifier":"doc:\/\/AxiamSDK\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://AxiamSDK/documentation/AxiamSDK/AttributeSource/email":{"abstract":[],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"email","kind":"identifier"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/email","kind":"symbol","url":"\/documentation\/axiamsdk\/attributesource\/email","title":"AttributeSource.email","role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AttributeSource/unknown":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknown","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A value this SDK’s copy of the spec does not list; see the type’s summary.","type":"text"}],"role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/unknown","url":"\/documentation\/axiamsdk\/attributesource\/unknown","title":"AttributeSource.unknown","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/AttributeSource/init(rawValue:)":{"kind":"symbol","url":"\/documentation\/axiamsdk\/attributesource\/init(rawvalue:)","typ