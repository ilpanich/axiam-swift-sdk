{"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Where an attribute’s value comes from. Every variant has a real source today; a variant with"},{"type":"text","text":" "},{"type":"text","text":"none (a telephone number the OIDC "},{"type":"codeVoice","code":"phone"},{"type":"text","text":" scope gates behind its own consent, say) is"},{"type":"text","text":" "},{"type":"text","text":"deliberately absent rather than mapped to an empty value."}],"topicSections":[{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/displayName","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/email","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/familyName","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/givenName","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/groups","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/roles","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/unknown","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/username"],"title":"Enumeration Cases"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/init(from:)-28eiu","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/init(rawValue:)"],"title":"Initializers"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/encode(to:)"],"title":"Instance Methods"},{"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AttributeSource\/RawRepresentable-Implementations"],"title":"Default Implementations","generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamS