xt","text":", "},{"type":"codeVoice","code":"ui_locales"},{"type":"text","text":" and "},{"type":"codeVoice","code":"claims_locales"},{"type":"text","text":". It is "},{"type":"strong","inlineContent":[{"text":"one","type":"text"}]},{"type":"text","text":" field rather than nine booleans"},{"type":"text","text":" "},{"type":"text","text":"for the same reason ["},{"type":"codeVoice","code":"ClientProfile"},{"type":"text","text":"] is one field rather than a dozen: a client that"},{"type":"text","text":" "},{"type":"text","text":"honours "},{"type":"codeVoice","code":"max_age"},{"type":"text","text":" but ignores "},{"type":"codeVoice","code":"prompt=none"},{"type":"text","text":" is not “mostly conformant”, it is a client a"},{"type":"text","text":" "},{"type":"text","text":"relying party cannot reason about. "},{"type":"reference","isActive":true,"identifier":"Self::Ignore"},{"type":"text","text":" is the serde default and is"},{"type":"text","text":" "},{"type":"text","text":"exactly what AXIAM has always done — unknown authorization-request parameters are dropped by"},{"type":"text","text":" "},{"type":"text","text":"the query deserialiser and never reach a decision. Every row written before schema v54"},{"type":"text","text":" "},{"type":"text","text":"therefore decodes to the behaviour it already had."}],"title":"AuthnRequestParamsMode","kind":"symbol","type":"topic","navigatorTitle":[{"text":"AuthnRequestParamsMode","kind":"identifier"}],"role":"symbol","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/AuthnRequestParamsMode","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AuthnRequestParamsMode","kind":"identifier"}]},"doc://AxiamSDK/documentation/AxiamSDK/AuthnRequestParamsMode/unknown":{"url":"\/documentation\/axiamsdk\/authnrequestparamsmode\/unknown","abstract":[{"type":"text","text":"A value this SDK’s copy of the spec does not list; see the type’s summary."