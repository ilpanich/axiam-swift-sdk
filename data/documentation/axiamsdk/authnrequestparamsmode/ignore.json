pped by"},{"type":"text","text":" "},{"type":"text","text":"the query deserialiser and never reach a decision. Every row written before schema v54"},{"type":"text","text":" "},{"type":"text","text":"therefore decodes to the behaviour it already had."}],"type":"topic","kind":"symbol","url":"\/documentation\/axiamsdk\/authnrequestparamsmode","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthnRequestParamsMode"}],"navigatorTitle":[{"kind":"identifier","text":"AuthnRequestParamsMode"}]}}}