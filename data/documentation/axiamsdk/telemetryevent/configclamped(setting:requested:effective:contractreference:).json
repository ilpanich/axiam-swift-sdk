{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/telemetryevent\/configclamped(setting:requested:effective:contractreference:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent\/configClamped(setting:requested:effective:contractReference:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Emitted at client construction, once per caller-supplied setting the SDK clamped"},{"type":"text","text":" "},{"type":"text","text":"(§19.1, §19.2 rule 6)."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"configClamped","kind":"identifier"},{"text":"(","kind":"text"},{"text":"setting","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"requested","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"effective","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"contractReference","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["Linux"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"the configuration property’s name, e.g. "},{"type":"codeVoice","code":"decisionMemoTtl"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"setting"},{"content":[{"inlineContent":[{"type":"text","text":"the value the caller asked for, rendered."}],"type":"paragraph"}],"name":"requested"},{"content":[{"inlineContent":[{"text":"the value actually in force, rendered.","type":"text"}],"type":"paragraph"}],"name":"effective"},{"content":[{"inlineContent":[{"text":"the §-reference for the limit, e.g. ","type":"text"},{"code":"§17.1 rule 2","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"contractReference"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Clamping rather than rejecting is the right call — rejecting would fail construction for a"},{"type":"text","text":" "},{"type":"text","text":"caller whose configuration was merely optimistic, and honoring would let one client become"},{"type":"text","text":" "},{"type":"text","text":"the herd §16 exists to prevent. Doing it "},{"type":"strong","inlineContent":[{"text":"silently","type":"text"}]},{"type":"text","text":" is the part that is wrong: an"},{"type":"text","text":" "},{"type":"text","text":"operator who set a 60-second memo TTL believes their staleness bound is 60 seconds. It is"},{"type":"text","text":" "},{"type":"text","text":"five, and their revocation reasoning is off by a factor of twelve with nothing anywhere to"},{"type":"text","text":" "},{"type":"text","text":"say so."}],"type":"paragraph"},{"inlineContent":[{"text":"Not emitted for a value already within its limit: an event that fires when nothing","type":"text"},{"text":" ","type":"text"},{"text":"happened trains its reader to ignore it.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent"]]},"metadata":{"externalID":"s:8AxiamSDK14TelemetryEventO13configClampedyACSS_S3StcACmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"configClamped"},{"kind":"text","text":"("},{"kind":"externalParam","text":"setting"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind