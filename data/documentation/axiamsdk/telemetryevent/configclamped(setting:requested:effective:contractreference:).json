dentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"requested"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"effective"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"contractReference"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"setting","content":[{"type":"paragraph","inlineContent":[{"text":"The configuration property’s name, e.g. ","type":"text"},{"code":"decisionMemoTtl","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"requested","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value the caller asked for, rendered."}]}]},{"name":"effective","content":[{"inlineContent":[{"type":"text","text":"The value actually in force, rendered."}],"type":"paragraph"}]},{"name":"contractReference","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The §-reference for the limit, e.g. "},{"type":"codeVoice","code":"§17.1 rule 2"},{"type":"text","text":"."}]}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Clamping rather than rejecting is the right call — rejecting would fail construction for a"},{"type":"text","text":" "},{"type":"text","text":"caller whose configuration was merely optimistic, and honoring would let one client become"},{"type":"text","text":" "},{"type":"text","text":"the herd §16 exists to prevent. Doing it "},{"inlineContent":[{"text":"silently","type":"text"}],"type":"strong"},{"type":"text","text":" is the part that is wrong: an"},{"type":"text","text":" "},{"type":"text","text":"operator who set a 60-second memo TTL believes their staleness bound is 60 seconds. It is"},{"type":"text","text":" "},{"type":"text","text":"five, and their revocation reasoning is off by a factor of twelve with nothing anywhere to"},{"type":"text","text":" "},{"type":"text","text":"say so."}],"type":"paragraph"},{"inlineContent":[{"text":"Not emitted for a value already within its limit: an event that fires when nothing","type":"text"},{"text":" ","type":"text"},{"text":"happened trains its reader to ignore it.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent"]]},"references":{"doc://AxiamSDK/documentation/AxiamSDK/TelemetryEvent/configClamped(setting:requested:effective:contractReference:)":{"role":"symbol","kind":"symbol","title":"TelemetryEvent.configClamped(setting:requested:effective:contractReference:)","abstract":[{"type":"text","text":"Emitted at client construction, once per caller-supplied setting the SDK clamped"},{"type":"text","text":" "},{"type":"text","text":"(§19.1, §19.2 rule 6)."}],"type":"topic","url":"\/documentation\/axiamsdk\/telemetryevent\/configclamped(setting:requested:effective:contractreference:)","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent\/configClamped(setting:requested:effective:contractReference:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"configClamped"},{"kind":"text","text":"("},{"kind":"externalParam","text":"setting"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"requested"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"effective"},{"kind":"text","text":": "},{"kind":"typeIdentifier"