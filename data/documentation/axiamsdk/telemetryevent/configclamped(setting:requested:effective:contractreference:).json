,"inlineContent":[{"text":"silently","type":"text"}]},{"text":" is the part that is wrong: an","type":"text"},{"text":" ","type":"text"},{"text":"operator who set a 60-second memo TTL believes their staleness bound is 60 seconds. It is","type":"text"},{"text":" ","type":"text"},{"text":"five, and their revocation reasoning is off by a factor of twelve with nothing anywhere to","type":"text"},{"text":" ","type":"text"},{"text":"say so.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Not emitted for a value already within its limit: an event that fires when nothing","type":"text"},{"text":" ","type":"text"},{"text":"happened trains its reader to ignore it.","type":"text"}]}]}],"sections":[],"references":{"doc://AxiamSDK/documentation/AxiamSDK/TelemetryEvent/configClamped(setting:requested:effective:contractReference:)":{"abstract":[{"type":"text","text":"Emitted at client construction, once per caller-supplied setting the SDK clamped"},{"text":" ","type":"text"},{"text":"(§19.1, §19.2 rule 6).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent\/configClamped(setting:requested:effective:contractReference:)","title":"TelemetryEvent.configClamped(setting:requested:effective:contractReference:)","type":"topic","url":"\/documentation\/axiamsdk\/telemetryevent\/configclamped(setting:requested:effective:contractreference:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"configClamped","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"setting"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"requested","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"effective","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"Stri