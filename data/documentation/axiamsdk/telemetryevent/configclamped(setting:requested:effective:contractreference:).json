{"hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent"]]},"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent\/configClamped(setting:requested:effective:contractReference:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/axiamsdk\/telemetryevent\/configclamped(setting:requested:effective:contractreference:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","symbolKind":"case","externalID":"s:8AxiamSDK14TelemetryEventO13configClampedyACSS_S3StcACmF","roleHeading":"Case","modules":[{"name":"AxiamSDK"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"configClamped"},{"kind":"text","text":"("},{"kind":"externalParam","text":"setting"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"requested"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"effective"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"contractReference"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}],"title":"TelemetryEvent.configClamped(setting:requested:effective:contractReference:)"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"configClamped","kind":"identifier"},{"text":"(","kind":"text"},{"text":"setting","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"requested","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"effective","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"contractReference","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"setting","content":[{"type":"paragraph","inlineContent":[{"text":"the configuration property’s name, e.g. ","type":"text"},{"code":"decisionMemoTtl","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"requested","content":[{"inlineContent":[{"text":"the value the caller asked for, rendered.","type":"text"}],"type":"paragraph"}]},{"name":"effective","content":[{"inlineContent":[{"type":"text","text":"the value actually in force, rendered."}],"type":"paragraph"}]},{"name":"contractReference","content":[{"type":"paragraph","inlineContent":[{"text":"the §-reference for the limit, e.g. ","type":"text"},{"code":"§17.1 rule 2","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Clamping rather than rejecting is the right call — rejecting would fail construction for a"},{"type":"text","text":" "},{"type":"text","text":"caller whose configuration was merely optimistic, and honoring would let one client become"},{"type":"text","text":" "},{"type":"text","text":"the herd §16 exists to prevent. Doing it "},{"inlineContent":[{"text":"silently","type":"text"}],"type":"strong"},{"type":"text","text":" is the part that is wrong: an"},{"type":"text","text":" "},{"type":"text","text":"operator who set a 60-second memo TTL believes their staleness bound is 60 seconds. It is"},{"type":"text","text":" "},{"type":"text","text":"five, and their revocation reasoning is off by a factor of twelve with nothing anywhere to"},{"type":"text","text":" "},{"type":"text","text":"say so."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not emitted for a value already within its limit: an event that fires when nothing"},{"type":"text","text":" "},{"type":"text","text":"happened trains its reader to ignore it."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Emitted at client construction, once per caller-supplied setting the SDK clamped"},{"type":"text","text":" "},{"type":"text","text":"(§19.1, §19.2 rule 6)."}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/TelemetryEvent":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryEvent"}],"abstract":[{"type":"text","text":"A telemetry event (CONTRACT.md §19)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent","role":"symbol","kind":"symbol","url":"\/documentation\/axiamsdk\/telemetryevent","type":"topic","title":"TelemetryEvent","navigatorTitle":[{"kind":"identifier","text":"TelemetryEvent"}]},"doc://AxiamSDK/documentation/AxiamSDK/TelemetryEvent/configClamped(setting:requested:effective:contractReference:)":{"url":"\/documentation\/axiamsdk\/telemetryevent\/configclamped(setting:requested:effective:contractreference:)","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"configClamped","kind":"identifier"},{"text":"(","kind":"text"},{"text":"setting","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"requested","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"effective","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"contractReference","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent\/configClamped(setting:requested:effective:contractReference:)","title":"TelemetryEvent.configClamped(setting:requested:effective:contractReference:)","abstract":[{"text":"Emitted at client construction, once per caller-supplied setting the SDK clamped","type":"text"},{"text":" ","type":"text"},{"text":"(§19.1, §19.2 rule 6).","type":"text"}]},"doc://AxiamSDK/documentation/AxiamSDK":{"type":"topic","url":"\/documentation\/axiamsdk","role":"collection","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"kind":"symbol","title":"AxiamSDK"}}}