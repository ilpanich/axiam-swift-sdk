memo TTL believes their staleness bound is 60 seconds. It is","type":"text"},{"text":" ","type":"text"},{"text":"five, and their revocation reasoning is off by a factor of twelve with nothing anywhere to","type":"text"},{"text":" ","type":"text"},{"text":"say so.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Not emitted for a value already within its limit: an event that fires when nothing","type":"text"},{"text":" ","type":"text"},{"text":"happened trains its reader to ignore it.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent\/configClamped(setting:requested:effective:contractReference:)","interfaceLanguage":"swift"},"references":{"doc://AxiamSDK/documentation/AxiamSDK":{"abstract":[{"text":"The official Swift SDK for AXIAM (Access eXtended Identity and Authorization Management).","type":"text"}],"type":"topic","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK","title":"AxiamSDK","kind":"symbol","role":"collection","url":"\/documentation\/axiamsdk"},"doc://AxiamSDK/documentation/AxiamSDK/TelemetryEvent":{"navigatorTitle":[{"kind":"identifier","text":"TelemetryEvent"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryEvent"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A telemetry event (CONTRACT.md §19)."}],"title":"TelemetryEvent","kind":"symbol","url":"\/documentation\/axiamsdk\/telemetryevent"},"doc://AxiamSDK/documentation/AxiamSDK/TelemetryEvent/configClamped(setting:requested:effective:contractReference:)":{"abstract":[{"type":"text","text":"Emitted at client construction, once per caller-supplied setting the SDK clamped"},{"type":"text","text":" "},{"type":"text","text":"(§19.1, §19.2 rule 6)."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent\/configClamped(setting:requested:effective:co