xt":"configClamped","kind":"identifier"},{"text":"(","kind":"text"},{"text":"setting","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"requested","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"effective","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"contractReference","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"setting","content":[{"inlineContent":[{"type":"text","text":"the configuration property’s name, e.g. "},{"type":"codeVoice","code":"decisionMemoTtl"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"requested","content":[{"inlineContent":[{"text":"the value the caller asked for, rendered.","type":"text"}],"type":"paragraph"}]},{"name":"effective","content":[{"inlineContent":[{"text":"the value actually in force, rendered.","type":"text"}],"type":"paragraph"}]},{"name":"contractReference","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the §-reference for the limit, e.g. "},{"type":"codeVoice","code":"§17.1 rule 2"},{"type":"text","text":"."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Clamping rather than rejecting is the right call — rejecting would fail construction for a"},{"type":"text","text":" "},{"type":"text","text":"caller whose configuration was merely optimistic, and honoring would let one client become"},{"type":"text","text":" "},{"type":"text","text":"the herd §16 exists to prevent. Doing it "},{"type":"strong","inlineContent":[{"text":"silently","type":"text"}]},{"type":"text","text":" is the part that is wrong: an"},{"type":"text","text":" "},{"type":"text","text":"operator who set a 60-second memo TTL believes their staleness bound is 60 seconds. It is"},{"type":"text","text":" "},{"type":"text","text":"five, and their revocation reasoning is off by a factor of twelve with nothing anywhere to"},{"type":"text","text":" "},{"type":"text","text":"say so."}],"type":"paragraph"},{"inlineContent":[{"text":"Not emitted for a value already within its limit: an event that fires when nothing","type":"text"},{"text":" ","type":"text"},{"text":"happened trains its reader to ignore it.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://AxiamSDK/documentation/AxiamSDK/TelemetryEvent":{"navigatorTitle":[{"kind":"identifier","text":"TelemetryEvent"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryEvent"}],"url":"\/documentation\/axiamsdk\/telemetryevent","abstract":[{"text":"A telemetry event (CONTRACT.md §19).","type":"text"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/TelemetryEvent","title":"TelemetryEvent","role":"symbol","kind":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/TelemetryEvent/configClamped(setting:requested:effective:contractReference:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"configClamped"},{"kind":"text","text":"("},{"text":"setting","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"requested","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"effective","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"te