itch"},{"type":"text","text":" over these cases needs an "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" arm."}]}]}],"abstract":[{"type":"text","text":"A stream’s SSF status (SSF 1.0 §8.1.2), with AXIAM’s meaning pinned by D-51."}],"relationshipsSections":[{"identifiers":["doc:\/\/AxiamSDK\/s12CaseIterableP","doc:\/\/AxiamSDK\/Se","doc:\/\/AxiamSDK\/SE","doc:\/\/AxiamSDK\/SQ","doc:\/\/AxiamSDK\/SH","doc:\/\/AxiamSDK\/SY","doc:\/\/AxiamSDK\/s8SendableP","doc:\/\/AxiamSDK\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamStatus\/disabled","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamStatus\/enabled","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamStatus\/paused","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamStatus\/unknown"],"title":"Enumeration Cases","anchor":"Enumeration-Cases"},{"generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamStatus\/init(from:)","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamStatus\/init(rawValue:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamStatus\/encode(to:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamStatus\/Equatable-Implementations","doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/SsfStreamStatus\/RawRepresentable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AxiamSDK\/documentation\/AxiamSDK"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axiamsdk\/ssfstreamstatus"]}],"sections":[],"metadata":{"roleHeading":"Enumeration","fragments":[{"kind":"keyword","text":"enu