":"text"},{"code":"admin","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"dcr"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"cimd"},{"text":". Echoed because an","type":"text"},{"text":" ","type":"text"},{"text":"operator auditing a tenant needs to answer “which of these did we create?” from this","type":"text"},{"text":" ","type":"text"},{"text":"endpoint rather than from the database, and because three behaviours hang off it: a","type":"text"},{"text":" ","type":"text"},{"text":"non-","type":"text"},{"code":"admin","type":"codeVoice"},{"text":" client may never carry the FAPI profile, is always consent-gated, and is the","type":"text"},{"text":" ","type":"text"},{"text":"only kind the unused-client sweeper touches. Read-only. There is no corresponding member","type":"text"},{"text":" ","type":"text"},{"text":"on the update DTO: a registration’s provenance is a fact about how it came to exist, and","type":"text"},{"text":" ","type":"text"},{"text":"a field that could be edited to ","type":"text"},{"code":"admin","type":"codeVoice"},{"text":" would be a field that launders one.","type":"text"}],"title":"managedBy","identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth2ClientResponse\/managedBy","url":"\/documentation\/axiamsdk\/oauth2clientresponse\/managedby","kind":"symbol","role":"symbol","type":"topic"},"doc://AxiamSDK/documentation/AxiamSDK/OAuth2ClientResponse/grantTypes":{"type":"topic","role":"symbol","url":"\/documentation\/axiamsdk\/oauth2clientresponse\/granttypes","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"grantTypes","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"grantTypes","abstract":[{"type":"text","text":"The server’s "},{"type":"codeVoice","code":"grant_types"},{"type":"text","text":" field."}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/OAuth