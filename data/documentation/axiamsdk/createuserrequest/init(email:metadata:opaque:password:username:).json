ype":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"payload of a discriminated union)."}],"title":"ManagementJSON","kind":"symbol"},"doc://AxiamSDK/documentation/AxiamSDK/ManagementOpaqueEnrollment":{"navigatorTitle":[{"kind":"identifier","text":"ManagementOpaqueEnrollment"}],"role":"symbol","type":"topic","url":"\/documentation\/axiamsdk\/managementopaqueenrollment","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManagementOpaqueEnrollment"}],"identifier":"doc:\/\/AxiamSDK\/documentation\/AxiamSDK\/ManagementOpaqueEnrollment","abstract":[{"type":"text","text":"The client-supplied half of an OPAQUE enrolment, as it appears inside registration \/"},{"type":"text","text":" "},{"type":"text","text":"change-password \/ reset-completion \/ bootstrap request bodies. There is no standalone"},{"type":"text","text":" "},{"code":"register\/finish","type":"codeVoice"},{"type":"text","text":" endpoint, deliberately. A record can only be created at a moment when the"},{"type":"text","text":" "},{"type":"text","text":"plaintext password legitimately exists on the client, and every one of those moments is"},{"type":"text","text":" "},{"type":"text","text":"already an endpoint that takes a password. A free-standing finish would be an endpoint whose"},{"type":"text","text":" "},{"type":"text","text":"only job is to attach a credential to an account, which is a thing worth not having. Kept"},{"type":"text","text":" "},{"type":"text","text":"separate from ["},{"code":"CreateOpaqueCredential","type":"codeVoice"},{"type":"text","text":"] because the tenant, the user and the credential"},{"type":"text","text":" "},{"type":"text","text":"identifier are all decided by the server — a client that could name them could enrol a"},{"type":"text","text":" "},{"type":"text","text":"record against somebody else’s account."}],"title":"ManagementOpaqueEnrollment","kind":"symbol"},"doc://AxiamSDK/documentation/Axiam